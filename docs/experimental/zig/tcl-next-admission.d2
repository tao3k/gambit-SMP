direction: down
facts: "Same natural caller history\nentry kind / target / role / check / return facts"
preserve: "Source-preserving evidence\nkeep evaluator actions and results"
positive: "Qualified positive controls\nC-only object early ERROR\nor U EvalObjv natural reset"
refuse: "Empty / filtered / persistent U\nuncovered nested / suspended work\nkeep custody; refuse clean reuse"
normalize: "Explicit normalized future contract\nuniform entry gate / completion guard\nnon-destructive check API"
proof: "New proof obligations\nhandler priority + raw races + callback domain\nall early / normal / exceptional exits"
value: "Equal-capability modern C / Zig comparison\ncharge identity / activation / custody support\nno exclusive Zig retirement established"
facts -> preserve
preserve -> positive: "all premises"
preserve -> refuse: "missing premise"
facts -> normalize: "deliberate semantic change"
normalize -> proof
positive -> value
refuse -> value: "refused attempts still cost work"
proof -> value: "qualification still unresolved"
