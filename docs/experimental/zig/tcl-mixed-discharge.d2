direction: down
closure: "Binding + same-owner frontier\nold producers joined + actual owner idle"
history: "L -> C -> A validation\nRawHistoryDischargeReceipt\nretain generation / serial history"
pending: "PendingSettlementReceipt\nremaining old managed coverage"
raw: "Concurrent raw acceptance\nC-serialized serial / generation change"
final: "Final L,C,A revalidation\nboth receipts + every cut"
reset: "Only admitted residual managed state\nforce=0 reset + postcondition"
publish: "Same protected interval\nResetReceipt -> complete fresh epoch"
fail: "Raw / unknown / missing outcome / stale ticket\nno reset or clean publication\noriginal custodian retains responsibilities"
after: "Raw accepts after publication\nvalid next-evaluation obligation"
closure -> history
history -> pending
pending -> final
raw -> final: "before commit: invalidate"
final -> fail: "premise fails"
final -> reset: "all premises valid"
reset -> publish: "no callback / allocation / destructor"
raw -> after: "waited for C through commit"
publish -> after
