direction: right
classes: {
  actual: {style.fill: "#dbeafe"; style.stroke: "#2563eb"}
  proposed: {style.fill: "#ede9fe"; style.stroke: "#7c3aed"}
  open: {style.fill: "#ffedd5"; style.stroke: "#c2410c"}
}
base: "Actual source\nfull-copy movable + still sweep\nparallel STW source branch" {class: actual}
algorithm: "Algorithm modernization\nyoung / mature / barriers\nroots / concurrent major" {class: proposed}
c: "Fully funded modern C route\ngenerators + runtime + migration" {class: proposed}
zig: "Direct Zig reconstruction\ntyped support + runtime + migration" {class: proposed}
runtime: "Runtime-work condition\navoided mature work >\nbarrier / promotion / major / coordination" {class: open}
economics: "Language condition\ncomplete C versus Zig lifecycle cost\nsame admitted capability" {class: open}
gate: "Separate gates\ncorrectness / algorithm value\ntotal net / Zig increment" {class: open}
base -> algorithm
algorithm -> c -> economics
algorithm -> zig -> economics
algorithm -> runtime
runtime -> gate
economics -> gate
