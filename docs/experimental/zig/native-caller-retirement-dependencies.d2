config: "P1 / M8 shared configuration\nV10 configure rules + V11 regeneration/install\nCoherent header/script/profile manifest\nV12 bootstrap templates retained" {class: proposed}
infra: "P2 / M6-M7 native capabilities\nCanonical metadata + package effects\nTyped recipes + direct execution\nIndependent observer qualification" {class: gate}
config -> infra
ingress: "P3 ingress / M2-M5\nV1 compile-file object seam\nG7 inner static-false object; G10 two-object batch\nPreserve filtering, paths, failures and output jobs" {class: proposed}
infra -> ingress
objects: "P3 / M3 object slice\nOne request per C object\nExisting semantic-link and object barrier retained\nNative acceptance required" {class: proposed}
ingress -> objects
bundle: "P4 / M4 Darwin bundle slice\nG4/G11 object then bundle\nRuntime-C metadata / static object / exact aliases\nG5 ordinary and phase fallback separately covered" {class: proposed}
final_links: "P5 / M3-M5 executable slices\nV2 generic Gambit exe\nG8 dependency direct exe + G10 full-program stub\nDistinct recipes; G9 failure barrier preserved" {class: proposed}
objects -> bundle
objects -> final_links
closure: "P6 upstream caller closure\nG1/G2 runtime, loader, phi and parallel branches\nV3 module / V4 command-line / V5 auto-build subprocess\nNo inherited qualification across callers" {class: gate}
bundle -> closure
final_links -> closure
retire: "P7 retire qualified managed paths\nPer-caller E01-E32 evidence by obligation kind\nNo native gsc-obj / gambuild / eval / hidden retry\nAll M2-M8 gates currently OPEN" {class: gate}
closure -> retire
remain: "Residual owners and callers\nGambit semantic generation / GC / control / setup\nGerbil scheduling, phases, aliases and barriers\nV6 non-C / V9 legacy APIs / V12 bootstrap / external users" {class: retained}
retire -> remain
note: "DESIGN ONLY. Arrows are capability prerequisites, not whole-function deletion order.\nP4 and P5 can qualify independently after P3. No runtime or performance validation." {shape: text; style.font-size: 15}
