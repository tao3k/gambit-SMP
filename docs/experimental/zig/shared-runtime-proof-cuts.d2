direction: down
classes: {
  protocol: {style.fill: "#e6f2ff"}
  premise: {style.fill: "#fff0ce"}
  derive: {style.fill: "#eaf5e6"}
}
request: "Request enrollment cut\nFix contributors, required members and worker team\nFinal root slots not yet sealed" {class: protocol}
running: "Active member may still run before acknowledgement\nNew live values remain in local/frame custody\nAcknowledge with current complete descriptor" {class: protocol}
rootcut: "Final root cut\nAll relevant writers safe; descriptors stable\nCanonical root-entry union and pinned dependencies" {class: protocol}
partition: "Conditional root dispatch argument\nDisjoint worker intervals cover canonical index\nNo duplicate physical-slot writers" {class: derive}
reload: "Conditional reentry argument\nCompletion visibility + all-value reload\nInvalidate stale aliases before managed access" {class: derive}
reclaim: "Conditional resource-specific reclamation\nClose independent issuance; transfer child before dropping parent\nActual target users drained, including map/frame/ticket pins" {class: derive}
premises: "Still-open premises\nComplete roots / collector correctness / actual users\nPhysical memory ordering / all-exit effects\nMapped-frame location law" {class: premise}
limits: "Independent limitations\nSafety does not establish progress\nLLVM value does not establish Zig increment\nNo checked proof, model run or native witness" {class: premise}
request -> running
running -> rootcut
rootcut -> partition
rootcut -> reload
rootcut -> reclaim
premises -> rootcut: "required, not discharged here"
partition -> limits
reload -> limits
reclaim -> limits
