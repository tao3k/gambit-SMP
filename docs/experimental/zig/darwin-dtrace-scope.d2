direction: down
classes: {
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
  candidate: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  gap: {style.fill: "#FBE9E7"; style.stroke: "#A54A3B"}
}
source: "Source mapped only\nSDK + Apple consumer + XNU + project recipe\nNo live observer or calibration run" {class: gate}
eligibility: "ABI and loading qualification\nSelected arm64 / arm64e profile\nCallback and record layout controls" {class: gate}
visibility: "Visibility qualification\nDevice access / exact target and provider\nDeclared probe != enabled and firing probe\nZero matches or hidden control cannot pass" {class: gate}
source -> eligibility -> visibility
scopes: "Independent candidate scopes" {
  returns: "Failure returns\nExact probe result convention\nEmitter and attempt association\nPre-syscall libc failures still missing" {class: candidate}
  fd: "FD transitions\nSource recipe != actual kernel actions\nSpawn hooks carry limited failure facts\nES fd subset cannot complete graph" {class: candidate}
  bytes: "Bounded byte snapshots\nRequested / returned / captured lengths\nCopy faults, iovecs and mutation races\nSnapshot != kernel-consumed bytes" {class: candidate}
}
visibility -> scopes.returns
visibility -> scopes.fd
visibility -> scopes.bytes
health: "Per-scope fidelity and health gate\nPositive + negative controls / loss and drain\nIndependent ES generation join\nSeparate local fact from attributed claim" {class: gate}
scopes.returns -> health
scopes.fd -> health
scopes.bytes -> health
verdict: "Future verdict per scope\nQualified bounded claim OR unresolved\nNo platform-wide supported verdict\nAll runtime gates currently unrun" {class: gate}
health -> verdict
gaps: "Retained unresolved\nComplete spawn fd graph\nArbitrary kernel-consumed bytes\nProtected-tool visibility\nOriginal Scheme continuation delivery" {class: gap}
verdict -> gaps
