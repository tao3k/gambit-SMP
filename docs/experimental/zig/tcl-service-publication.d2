direction: down
binding: "BindingReceipt\ncorrect live provider image"
closure: "ProducerClosureReceipt\nold scopes / leases / ancestors joined"
ticket: "Exclusive owner BarrierTicket\nclosed ingress and stable target tree"
idle: "Borrowed OwnerIdleReceipt\nreal returns; not a cached Boolean"
pending: "PendingSettlementReceipt\nqualified thread-wide or new targeted path"
reset: "ResetReceipt\nrenew idle + non-forced clear-state postcondition"
publish: "EpochPublicationReceipt\nlifecycle revalidation + synchronized fresh descriptor"
next: "Next evaluation\nacquire fresh authority; stale request rejects"
invalid: "Reentry / callback-capable work / stale binding\ninvalidate receipts, retain custody, keep sealed" {style.fill: "#ffe2e2"}
binding -> ticket
closure -> ticket
ticket -> idle -> pending -> reset -> publish -> next
idle -> invalid: "new control entry"
reset -> invalid: "hook / allocation / release before publication"
