direction: down
classes: {
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
  candidate: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  evidence: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
}
platform: "Independent architecture identities\nHardware and kernel / consumer Mach-O subtype\nLoaded library and callback ABI / D record model\nObserved image ABI / exact probe emitter" {class: gate}
abi: "Eligibility unresolved\nSDK stub: x86_64 + arm64e\nNot proof of arm64 failure or arm64e usability\nNo forced subtype or untyped pointer workaround" {class: gate}
platform -> abi
collector: "Optional Darwin evidence collector" {
  direction: down
  boundary: "Apple ABI containment candidate\nTyped C callbacks + exact headers\nDirect Zig FFI needs separate qualification\nNo target process-control API" {class: candidate}
  decoder: "Revision-bound raw decoder\nProbe base differs from record address\nAllowlisted actions / bounded copies\nFaults, drops and queue loss retained" {class: candidate}
  frames: "Project-owned evidence frames\nLengths + bytes + schema + provenance\nNo libdtrace structs or borrowed pointers\nCapability verdicts and sealed health" {class: evidence}
  boundary -> decoder -> frames
}
abi -> collector.boundary
es: "Independent ES notification lane\nProcess and image generations\nSequence / muting / loss / drain\nCross-stream join remains conditional" {class: candidate}
evaluator: "Evidence evaluator\nOnly qualified scope and fidelity\nUnknown / incomplete / ambiguous retained\nNo automatic E-row or retirement pass" {class: evidence}
collector.frames -> evaluator
es -> evaluator
product: "Product architecture remains separate\nGambit: language and runtime authority\nZig: typed native requests and ownership\nMLIR: isolated compiler service\nBuilds do not require tracing privileges" {class: evidence}
evaluator -> product: "acceptance receipts only"
