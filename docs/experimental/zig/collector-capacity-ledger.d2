direction: down
classes: {
  actual: {style.fill: "#e8f1fb"; style.stroke: "#346a98"}
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  boundary: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "Copy / resume / still capacity: distinct ledgers\nSource constants and conditional algebra, no native footprint claim" {shape: text}
units: "GCA01--06 / source units\nM=131072 words / active half M/2\nF=8193 + SUBTYPED_BODY / doubled movable charge\n2u initial sections differs from independent W budget\nDesired section count differs from actual allocation" {class: actual}
title -> units: {style.opacity: 0}
extents: "GAL01 / actual ExtentLedger\nCount each SectionId once\nFrom/to halves are ranges in that same section\nLive copied prefix stays VM-owned" {class: proposed}
placement: "GAL02--05 / RolePlacement\nCopy arenas W / context stacks U / heap buffers\nDisjoint writable intervals / alignment / markers / fudge\nTail reuse only after worker borrowers settle" {class: proposed}
still: "GAL06 / StillQuota\nActual committed / uniquely deferred / outstanding grants\nConsume / refund / recount / rebase once\nNative malloc and body initialization remain separate" {class: proposed}
units -> extents
units -> placement
units -> still
peak: "GAL03 / phase peak and actual fit\nUnion actual SectionIds at each cut; then max over time\nFree-word total alone does not prove placement\nNo universal replacement by 2w or 2u+2w" {class: proposed}
extents -> peak
placement -> peak
actual: "GAL07--08 / publish actual capacity\nValidate actual growth / interval placements / quota\nReserve safe resume and error delivery\nMetadata / native allocator / foreign storage cost is explicit" {class: proposed}
peak -> actual
still -> actual
limits: "No double promises\nOne tail cannot fund overlapping buffers\nEmergency reserve is not another grant\nUnknown state retains actual heap / user obligations\nModern C and Zig need the same proof" {class: boundary}
actual -> limits
