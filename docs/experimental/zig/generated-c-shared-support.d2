direction: down
schema: "One Scheme schema and product generator\ntypes, operation cases, descriptors, origins"
shared: "Support funded once\nchecked sizes / IDs / native status\nallocation and local cleanup adapters\naccess / synchronization / diagnostics"
schema -> shared
policies: {
  label: "Distinct native policies: sharing does not erase protocols"
  roots: "RootRegistry\nstable cells / snapshot / transfer\nunlink waits for actual readers"
  log: "BarrierLog\nbounded reserve / no-GC commit\nepoch cut / drain / reset"
  release: "ReleaseCoordinator\naccept / cancel / owner wait\npayload + child credit + shutdown"
}
shared -> policies.roots
shared -> policies.log
shared -> policies.release
checks: "Independent obligations\nroot completeness / writer closure\natomic ordering / continuation / native effects\nnot proved by generated state tables"
policies -> checks
leaves: "Retained native C assets\nRC storage / string and TLS cleanup\npthread / close / readiness / admitted control"
checks -> leaves
