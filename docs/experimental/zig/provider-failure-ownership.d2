direction: down
owned: "Request/service owners\nContext / module / target machine / TargetData\nPublic output handles initially empty"
call: "Raw LLVM 21.1 emission\nModule DataLayout can change before error return\nOutput buffer is assigned independently of status"
adopt: "Adopt all returned owned outputs before propagation\nBuffer + any message tracked by normalization adapter\nSame rule in C and Zig"
status: "Inspect status and validate postconditions" {
  shape: diamond
}
failure: "Failure\nPreserve bounded diagnostic / fallback\nDispose produced output buffer and message\nNo unchanged-module or implicit-retry claim"
success: "Success\nTransfer accepted buffer to artifact owner\nDispose message and nontransferred request resources\nRuntime publication/lifetime remains separate"
result: "Normalized artifact or diagnostic\nC cleanup or Zig scope syntax expresses the same ownership law\nNo resource-law retirement or native qualification" {
  style.fill: "#fff0ce"
}
owned -> call
call -> adopt
adopt -> status
status -> failure: "failure / rejected result"
status -> success: "accepted success"
failure -> result
success -> result
