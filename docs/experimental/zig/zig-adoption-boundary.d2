direction: down
classes: {
  retained: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  contract: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
semantic: "Gerbil / Gambit semantic architecture\nConstruction programs, phases, lexical identity, effects\nCurrent instances, GC, continuations and runtime admission" {class: retained}
protocol: "Language-independent contracts\nSemantic products + native requests + compatibility\nNo MLIR handle or live Scheme heap pointer in service protocol" {class: contract}
semantic -> protocol
existing: "Viable existing route\nScheme factory -> Gambit native compilation\nExisting construction tools / separate compiler executable\nCan realize semantic staging without Zig" {class: retained}
zig: "Candidate Zig system subsystem\nTyped effective recipes / native artifact management\nIsolated service execution / diagnostics / distribution\nMore than replacing a compiler command" {class: proposed}
protocol -> existing: "baseline alternative"
protocol -> zig: "conditional adoption"
services: "Optional MLIR / LLVM services\nC++ implementation can remain private\nPinned service build; admitted passes and output protocol" {class: proposed}
existing -> services: "protocol"
zig -> services: "same protocol"
decision: "Adoption decision\nCompare identical semantic products and workloads\nCredit staging once; measure incremental engineering value\nCharge new toolchain, upgrades and migration" {class: contract}
existing -> decision
zig -> decision
limited: "Only command invocation / packaging needed\nNo established reason to require Zig" {class: retained}
broad: "Coherent maintained native/service subsystem needed\nZig may be a valuable implementation choice\nSemantic authority still stays with language core" {class: proposed}
decision -> limited
decision -> broad
note: "RESEARCH DECISION: retain Zig as a candidate, not a prerequisite.\nNative implementation language does not itself remove interface instantiation work." {shape: text; style.font-size: 15}
services -> note: {style.opacity: 0}
