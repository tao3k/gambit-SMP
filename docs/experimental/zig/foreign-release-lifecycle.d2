direction: down
classes: {
  source: {style.fill: "#e5f0ff"}
  design: {style.fill: "#e9f5e5"}
  unresolved: {style.fill: "#fff0d2"}
}
origins: "Actual release origins\nGC / explicit release / conversion rollback / shutdown\nDifferent result and execution contexts" {class: source}
claim: "Proposed ResourceId + unique release claim\nClose independent issuance; drain actual borrows\nWrapper flag alone cannot arbitrate all owners" {class: design}
custody: "Own native payload, callback image and action inputs\nTransfer use before dropping wrapper/creator custody\nManaged dependencies published before final root cut" {class: design}
run: "Qualified executor + effect interval\nReadClose / Wait / WriteClose / Wait / FinalRelease\nNo collector or metadata lock held across native code" {class: design}
result: "Record status AND payload disposition\nAlive-partial / freed / unknown\nError alone never authorizes retry or another free" {class: design}
finish: "Origin-preserving completion\nExplicit result/exception; rollback primary error\nGC/shutdown safe retention and diagnostics policy" {class: design}
limit: "Conditional closure only\nRaw aliases, custom effects, libraries and native ordering open\nNo independent worker profile qualified here" {class: unresolved}
origins -> claim
claim -> custody
custody -> run
run -> result
result -> finish
finish -> limit
