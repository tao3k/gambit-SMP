direction: down
scope: "Accepted Tcl/native source scope\nactual return required"
builtin: "Builtin interp cancel\nnot intercepted by a host wrapper"
host: "Epoch-bound native requests\npublish lease before pointer use"
external: "Untracked embedding / Tk / native module\nproducer closure remains open" {style.fill: "#ffe2e2"}
api: "Tcl_CancelEval\nshared pending record -> AsyncMark"
create: "TclCreateInterp / internal ChildCreate\nCancelInfo + owner token registration"
consume: "Owner async consumption\nVM / NRCommand / notifier / after wait"
callback: "CancelEvalProc -> target / descendant flags\nother eligible handlers can run effects"
fixtures: "Actual fixture producers\ntestasync / marklater / ThreadCancel\nnot proof they are loaded" {style.fill: "#fff0d8"}
wide: "Existing thread-wide settlement\nqualified context / effects / finite progress"
target: "Targeted settlement candidate\nnew Tcl integration required\nnot existing slot 237" {style.fill: "#fff0d8"}
scope -> builtin -> api
host -> api
external -> api: "must be covered or excluded" {style.stroke-dash: 4}
fixtures -> api: "ThreadCancel"
fixtures -> consume: "async marks"
create -> api: "registered target"
api -> consume -> callback
callback -> wide
api -> target: "only after source and sender closure" {style.stroke-dash: 4}
