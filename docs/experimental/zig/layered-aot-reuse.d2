direction: down
classes: {
  existing: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  contract: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
l0: "L0: qualified toolchain / runtime bundle\nSource + patches + VM/SMP/GC profile\nTarget ABI / SDK / tools / protocol generation" {class: existing}
l1: "L1: immutable generation product\nGenerated C OR resolved semantic export + FFI record\nSource / macro / import closure and effective assumptions" {class: proposed}
l2: "L2: module native product\nObject + required metadata / provenance\nHeaders / tool options / runtime ABI / service-pass identity" {class: proposed}
l3: "L3: composition and native link product\nOrdered members / aliases / initializers\nLinker / libraries / deployment configuration" {class: contract}
l4: "L4: published AOT closure\nMatched modules + dependencies + manifests\nFetch / verify / admit / load remains consumer work" {class: contract}
l0 -> l1: "compiler and target inputs"
l0 -> l2: "runtime / header dependency"
l1 -> l2: "member content and assumptions"
l2 -> l3: "ordered native members"
l0 -> l3: "runtime libraries"
l3 -> l4
outer: "Bazel owns outer action cache\nCurrent project action is a coarse tree artifact\nLogical layers are not already separate Bazel actions" {class: existing}
outer -> l1: "declared product boundary" {style.stroke-dash: 3}
outer -> l4: "reuse complete compatible outputs" {style.stroke-dash: 3}
inner: "Optional inner reuse\nMust survive sandbox and complete dependency checks\nPreprocessed-byte key still pays preprocessing\nLookup / proof / copying / locks can exceed avoided work" {class: contract}
inner -> l2: "admit only after net-cost argument" {style.stroke-dash: 3}
invalidate: "INVALIDATION\nSource / macro changes: affected generation and dependents\nRuntime protocol changes: all dependent native artifacts\nMLIR service changes: its outputs, not unrelated C outputs\nLink-only changes: affected link products, subject to option semantics" {class: contract}
l4 -> invalidate
note: "DESIGN ONLY: cold build, warm hit, delta build and AOT delivery are distinct.\nHistorical Bazel/native receipts constrain the design; no new timing run." {shape: text; style.font-size: 15}
invalidate -> note: {style.opacity: 0}
