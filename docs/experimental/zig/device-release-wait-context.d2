direction: down
classes: {
  policy: {style.fill: "#e4efff"}
  native: {style.fill: "#e8f5e6"}
  open: {style.fill: "#fff0d0"}
}
source: "Existing callers differ\nManaged condvar wait writes Scheme queues\nNative cleanup waits after partial close effects" {class: policy}
context: "Executor-owned WaitContext\nStable identity, owned buffers, capacity, wake endpoint\nDeclared clock / signal / library thread policy" {class: native}
frame: "Exclusive operation WaitFrame\nDevice / OS-handle borrow + interests + close stage\nNo raw managed values in native-only wait records" {class: native}
wake: "Preissued WakeLease\nPublish durable reason before notification\nRecheck predicate around sleep and wake consumption" {class: native}
return: "Ready / wake / deadline / interrupted / backend error\nNone alone proves task cancelled or resource released\nResume only the admitted close stage" {class: native}
close: "Close independent resolution and wake issuance\nReserved stop lease -> executor exit / successful join\nDrain waiters, wakers and readers before fd/buffer free" {class: native}
limit: "Still requires native refinement\nNo lost wake, stale fd, concurrent resize or late writer\nSource ready bit and language types are insufficient" {class: open}
source -> context
context -> frame
context -> wake
frame -> return
wake -> return
return -> close
close -> limit
