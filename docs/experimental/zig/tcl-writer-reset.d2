direction: down
title: "GUARD AUTHORITY AT THE REAL SOURCE POINT\nSource preservation and normalization are distinct"
title.shape: text
arm: "Arm durable guard before callback-capable work\nBind lifetime / policy / scope / entry identity"
sources: "Five named reset destinations\nPrivate body; TEOV; bytecode; child helper; parser\nPLUS trace whole-word restore and destructive checks"
request: "Typed transition request at actual source point\nDepth / force / subtree / mutation generation\nReserved before-and-after disposition record"
policy: "Which writer semantics?"
policy.shape: diamond
source: "SOURCE POLICY\nSame source predicate and bit effect now\nWhole trace snapshot is an actual writer\nMay clear newer bits or restore consumed bits"
owned: "OWNED DOMAIN\nAll writers use separate cancellation cell\nWhole contributor frontier must qualify\nApply all or retain custody / defer"
warning: "Deferred source-point clear can change later checks\nNever call this transparent equivalence\nNo waiting on active ancestors"
frontier: "Actual native + logical completion\nNRE scheduling / yield / in-function tail is insufficient\nRemaining cleanup, callbacks and children must close"
final: "Final guard settlement\nSeparate source-point effects from normalized cleanup\nNo pending installer / raw debt / live claim"
publish: "Reuse or next epoch only with matching receipts\nOtherwise retain custodian and keep reuse sealed"
arm -> sources -> request -> policy
policy -> source: "source snapshot / natural history"
policy -> owned: "explicit changed or restricted profile"
owned -> warning
source -> frontier
warning -> frontier
frontier -> final -> publish
warning.style.fill: "#FFF0E5"
owned.style.fill: "#DFEEFF"
publish.style.fill: "#E8F4E8"
