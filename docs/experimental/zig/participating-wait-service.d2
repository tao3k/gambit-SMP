direction: down
classes: {
  retained: {style.fill: "#e6f2ff"}
  proposal: {style.fill: "#eaf5e6"}
  unresolved: {style.fill: "#fff0ce"}
}
owned: "Existing owned BW1 caller\nVM wait queue != collector membership\nPreserve host / processor / VM / return origin" {class: retained}
publish: "Current wrapper\nFRAME_STORE_RA -> W_ALL\nPublish live runtime state" {class: retained}
interval: "C cached interval\ncondvars[] + devices + raw native dev pointers\nQueue unlock -> device_select -> relock -> last use\nNo relocation service inserted here without redesign" {class: retained}
request: "Other processor requests collective operation\nINTR_SYNC_OP + stack trip + select_abort\nSelected OS backend must preserve wakeup" {class: retained}
reload: "Return from select wrapper\nR_ALL + FRAME_FETCH_RA\nRequired queue/VM cleanup and lock ordering" {class: retained}
cut: "Legal Scheme service cut\nAll live roots published; no stale native aliases\nSafe locks + valid owner + permitted checkpoint" {class: proposal}
service: "interrupt-vector[0] -> sync-op wrapper\nRA / W_ALL -> service_sync_op\nCollective loop -> GC / resize -> reload" {class: retained}
gaps: "OU06 remains open\nVirtual methods / fdset resize / abort failures and races\nDisabled-interrupt callers' next checkpoint\nLock holders, fairness and full progress closure\nWakeup alone gives no latency bound" {class: unresolved}
owned -> publish
publish -> interval
request -> interval: "conditional abort / return"
interval -> reload
reload -> cut: "actual caller path must reach"
cut -> service
interval -> gaps: "movement / custody gate"
reload -> gaps: "checkpoint / lock gate"
service -> gaps: "no complete qualification yet"
