direction: down
classes: {
  retained: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
launch: "Launch attempt in current image\nCaller exec identity + thread + local ordinal\nPreparation / spawn API / fork-exec syscall\nStage and return convention must be explicit" {class: retained}
failed: "Failure supplement\nSetup may produce no spawn syscall\nFailed exec leaves current image\nSpawn-error pid output is not a child identity" {class: gate}
success: "Successful image transition\nES EXEC target identity and parent/fork lineage\nProgram/argv/env/cwd scoped to actual event\nSame PID may be a new execution" {class: retained}
launch -> failed: "failed return evidence"
launch -> success: "qualified success association"
channels: "Output channel evidence\nProcess + fd + open generation + endpoint\nQ0 attempted bytes / Q1 delivery / Q2 shell value\nQ3 tty presentation is a separate boundary" {class: proposed}
success -> channels
native_exit: "ES EXIT / native wait evidence\nRaw wait-format status and exec generation\nOriginal parent retains reaping ownership" {class: retained}
success -> native_exit
delivery: "Scheme delivery witness\nDevice/port/request association\nStatus-set -> return/raise -> caller branch\nOutput publication and link-barrier decision" {class: proposed}
native_exit -> delivery: "requires its own witness"
failed -> delivery: "OS error conversion / exception"
joined: "Evidence graph acceptance\nExplicit provenance and cross-stream keys\nNo missing bytes, ambiguous joins or lost events\nDerived records cannot impersonate original facts" {class: gate}
channels -> joined
delivery -> joined
scope: "Scope result or unresolved\nES exit cannot synthesize Scheme Delivery\nVisible diagnostics cannot reconstruct hidden query bytes\nClean ES counters cannot certify another stream" {class: gate}
joined -> scope
note: "DESIGN ONLY. Arrows name required associations, not events already observed.\nNo source hook, recorder, original-tool trace or performance run." {shape: text; style.font-size: 15}
scope -> note: {style.opacity: 0}
