direction: down
close: "Close independent admission\nkeep declared cleanup / hook / delivery\nservices alive for accepted work"
complete: "Cooperative completion\nfinite admitted descendants\nno self-wait or dependency cycle"
cancel: "Declared cancellation lane\nrequest lease + interpreter epoch\nacceptance is not completion"
close -> complete
close -> cancel
ack: "Owner observes quiescence\nnested scopes returned\ncancel/reset and deliveries reconciled"
complete -> ack
cancel -> ack
drain: "Drain remaining custody\noutcomes / background errors / command grace\nroot scanners / result bytes / image returns"
ack -> drain
retire: "Retire interpreter / runtime / module\nonly after each dependency receipt"
drain -> retire
stuck: "Unknown non-return / forbidden jump\nretain owned state; report incomplete\nno fabricated drain or thread kill"
cancel -> stuck
complete -> stuck
