direction: down
identity: "NextEvaluationIdentityReceipt\nactual first eligible target attempt\nforwarding roles + entry kind"
observe: "CancellationObservationReceipt\nraw cause + real check + returned ERROR\nsite / phase / control route"
invalid: "Empty OK / filtered OK / unrelated ERROR\nidentity can be known\nconsumption not proved"
consume: "NextEvaluationConsumptionReceipt\nrequired first-attempt preemption\nactual native / child / NRE completion"
residue: "Observed / consumed but U remains\nno raw neutrality or clean reuse"
neutral: "Raw-state neutrality evidence\nsource-conformant neutral state\nno pending / claimed / re-marked installer"
discharge: "RawHistoryDischargeReceipt\nconsumption AND neutrality\nplus producer / owner / tree closure"
commit: "Managed pending settlement\nfinal L,C,A validation / reset / publication"
identity -> observe: "actual attributed ERROR route"
identity -> invalid
observe -> consume: "complete causal and phase proof"
observe -> residue: "early error may leave U"
observe -> neutral: "separate proof: already neutral"
consume -> discharge: "consumption required"
residue -> neutral: "only qualified real neutralization / closure"
neutral -> discharge: "neutrality required"
discharge -> commit
