direction: down
classes: {
  semantic: {style.fill: "#e4f0ff"}
  native: {style.fill: "#e8f5e5"}
  limit: {style.fill: "#fff0cf"}
}
cut: "Request coordinator\nEnroll members M, contributors K and workers W\nSeal final roots and actual shards H after writers are safe" {class: semantic}
contributors: "Root sources K\nActive / parked / VM-global / retained carriers\nSource context is not worker scratch" {class: semantic}
workers: "Live GC workers W\nCopy/scan arenas, task claims and epoch pins\nCannot disappear during a collection" {class: native}
shards: "Heap and storage shards H\nOld stack/heap sections, still lists, queues, accounting\nNot equivalent to active contexts or worker count" {class: native}
strong: "Strong phase work service\nRoot tasks + graph scan / forwarding\nTrack queued, active and pending-to-publish work" {class: native}
weak: "Strong termination -> weak/wills phase\nPhase-specific termination and continuation movement\nRoot partition alone does not prove graph completion" {class: native}
cleanup: "Cleanup / resize / allocation-state rebinding\nForeign release effects + executor affinity + image pins\nUnknown callback effects block worker admission" {class: native}
resume: "Publish successful completion, reload, resume\nDrain worker / queue / return dependencies per resource\nPartial relocation failure never grants managed access" {class: native}
limit: "GWD01-GWD08 need refinement\nNo global processor_count -> worker_count substitution\nSame collector obligations in modern C and Zig" {class: limit}
cut -> contributors
cut -> workers
cut -> shards
contributors -> strong: "root source + map/storage lease"
workers -> strong: "exclusive scan scratch"
shards -> strong: "all owned storage covered"
strong -> weak
weak -> cleanup
cleanup -> resume
resume -> limit
