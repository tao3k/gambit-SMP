direction: down
build: "Stub-linked C facade\nUSE_TCL_STUBS + matching archive"
init: "Actual Tcl_InitStubs\ninterpreter table -> package data -> hooks"
private: "Internal table / reset slot 237\nsource and ABI qualification required"
receipt: "BindingReceipt\nprovider image + headers + captured entries\nimage lease through last return"
c: "Modern generated C\nopaque service capability"
zig: "Optional Zig\nsame opaque service capability"
service: "TclReuseService\nowner / producer / pending / reset contract"
nostubs: "No USE_TCL_STUBS\nversion-only macro path\nno private binding receipt" {style.fill: "#ffe2e2"}
failure: "Failure or global rebind\nnon-NULL old pointer is not admission" {style.fill: "#fff0d8"}
build -> init -> private -> receipt
init -> failure
build -> nostubs: "different build mode" {style.stroke-dash: 4}
receipt -> service
c -> service
zig -> service
