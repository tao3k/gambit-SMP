direction: down
classes: {
  retained: {style.fill: "#e6f2ff"}
  proposal: {style.fill: "#eaf5e6"}
  unresolved: {style.fill: "#fff0ce"}
}
plan: "Scheme-issued OwnedCallbackPlan\nTarget + live inputs + full effects + return origin\nExisting same host / processor / VM only" {class: proposal}
capture: "CS00-CS02: validate, capture, publish roots\nStable label proof OR updateable managed slot\nOC1: invocation carrier fixed before effects" {class: proposal}
rc: "Existing RC mechanism\nregister_rc(ps) -> ps.mem.rc_head\nmark_rc updates header.data only" {class: retained}
scan: "OU02: scan-domain closure\nInspected strong phase: mark_rc only on P0\nCandidate per-processor scanning needs refinement" {class: unresolved}
marker: "CS03: marker allocation may trigger GC\nReload target from admitted root/carrier\nInitialize marker before next allocation" {class: proposal}
shell: "CS04-CS07: Gambit C control region\nConverters -> call -> matching return frame\nWrong processor / repeated / outer unwind preserved" {class: retained}
close: "CS08-CS11: close in legal control region\nInvalidate marker, withdraw temporary roots\nRestore activation and any admitted binding change\nThen deliver result / correct nonlocal destination" {class: proposal}
native: "C-G / C-ZT / Zig native consumers\nSame runtime protocol and Scheme semantics\nZig local cleanup applies to ordinary returns" {class: proposal}
identity: "OU04 / OU05\nGlobal closure self is not invocation identity\nNo arm64 branch in this dynamic generator\nNo-switch binding; no foreign attach qualification" {class: unresolved}
plan -> capture
capture -> marker
capture -> rc: "only admitted RC cohort"
rc -> scan
scan -> marker: "root strategy requires closure"
marker -> shell
shell -> close
native -> shell: "supported managed boundary"
close -> native: "legal return only"
identity -> capture: "independent entry gates"
