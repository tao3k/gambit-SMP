direction: down
classes: {
  retained: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  contract: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
inputs: "Producer source / semantic products\nDeclared target-sensitive generation dependencies\nC source or versioned semantic export" {class: retained}
shared: "Referenced target / SDK / runtime contract\nHeader, ABI, GC/control generation and native dependencies\nChanges propagate to every stage that actually depends on them" {class: contract}
gcc: "GCC route inputs\nConfigured GCC/linker / mode flags\nPackage and C metadata / native resolver identity" {class: retained}
llvm: "MLIR provider inputs\nService executable and build dependencies\nDialect/plugin implementation + pipeline policy\nAccepted export encoding and output roles" {class: proposed}
cplan: "C plan key\nProducer + referenced native/profile inputs\nNo unrelated global LLVM version" {class: contract}
mplan: "Service plan key\nProducer + provider/dialect/policy + target/runtime inputs\nUpgrade invalidates affected outputs even with same pipeline name" {class: contract}
inputs -> cplan
inputs -> mplan
shared -> cplan
shared -> mplan
gcc -> cplan
llvm -> mplan
cproduct: "GCC-derived object / bundle / executable\nRetain original recipe and compatibility role" {class: retained}
mproduct: "MLIR-derived product, IF separately admitted\nC-ABI companion or complete Gambit protocol object\nInitial engineering contract does not enable lowering" {class: proposed}
cplan -> cproduct
mplan -> mproduct
consumer_links: "Dependent native links / consumers\nChanged selected objects or native libraries propagate\nCompatibility checks and scoped acceptance remain required" {class: contract}
cproduct -> consumer_links
mproduct -> consumer_links
note: "DESIGN ONLY. Edges represent dependency/invalidations, not automatic support.\nProvider-only upgrades may preserve independent C products when shared contracts stay unchanged.\nRuntime/dialect changes can require producer regeneration; parsing bytecode is not semantic compatibility.\nOld objects may remain stored, but cannot satisfy new request identities without the declared policy." {shape: text; style.font-size: 15}
consumer_links -> note: {style.opacity: 0}
