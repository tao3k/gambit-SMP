direction: down
identity: "Immutable target identity\nprovider + interpreter + token + OS owner generations"
managed: "Managed entry\nidentity + epoch + request coverage"
raw: "Raw Tcl_CancelEval\noriginal payload / flags / ownership"
generic: "Generic mark of cancel token\nunknown provenance debt"
record: "Tcl-owned state\nmanaged summary + raw serial / interference"
token: "Same registered cancel token\nready / mark serial\nlist position unchanged"
callback: "Normal owner callback\nA unlock -> C\nactual return scope"
barrier: "Targeted barrier\nactual owner idle + joined senders"
clean: "Managed-clean receipt\nold pending detached\nO(H) remaining-ready scan"
blocked: "Raw / unknown / busy\nno reset authority\nretain state and custody"
identity -> managed
managed -> record: "L -> C"
raw -> record: "C; raw activity blocks clean reuse"
record -> token: "attributed C -> A mark"
generic -> token: "A only; debt recorded"
token -> callback: "ordinary service only"
record -> barrier
identity -> barrier
barrier -> clean: "all premises valid"
barrier -> blocked: "any missing premise"
