direction: down
classes: {
  actual: {style.fill: "#e8f1fb"; style.stroke: "#346a98"}
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  gate: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "Target root service and collector work domain\nConditional design / no native qualification" {shape: text}
carrier: "TRA01--03 / target carrier + VM root registry\nPinned native RC headers; same live heap\nExact addresses of header.data, not copied values\nImmutable cell locations / kinds; mutable tagged contents" {class: proposed}
route: "TRA08 / one RC ownership authority\nRegister / ref / data / release / force cleanup\nMigrated cohort detached from legacy rc_head\nNo duplicate physical-cell relocation writer" {class: proposed}
route -> carrier
plan: "TRA05 / final epoch RootSeedPlan\nSnapshot after acknowledgements; pin actual cells\nAssign every canonical cell once before termination\nEach seed owner remains active until work published" {class: proposed}
carrier -> plan: "G snapshot / epoch handoff"
worker: "TRA04 / current CollectorWorkContext\nVM + epoch + phase + allocator / forwarding state\nQueue access and active / idle participation\nNever borrow retired source PSTATE" {class: proposed}
plan -> worker: "assigned seed batch"
trace: "TRA06 / qualified collector-owned trace adapter\nReuse tagged mark_array semantics\nRelocate and rewrite actual header.data\nPublish transitive heap work before seed completion" {class: proposed}
worker -> trace
legacy: "TR-S01--03 / current C collector mechanisms\nPSTATE-backed allocator; forwarding\nOrdered chunk publication; queue locks / signals\nReachability / weak / continuation / cleanup phases" {class: actual}
legacy -> trace: "reuse requires context extraction"
finish: "TRA07 / physical completion\nAll seed responsibility + derived work settled\nLater phases and real borrowers terminal\nReload relocated values before managed resume" {class: gate}
trace -> finish
limits: "Still unresolved\nHidden aliases / raw RC clients / exceptional exits\nIndependent worker context + termination refinement\nLLVM maps do not provide runtime registry / GC" {class: gate}
finish -> limits
