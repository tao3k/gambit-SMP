direction: down
title: "COROUTINE DEPTH IS RELATIVE TO THE CURRENT CALLER\nHandwritten source arithmetic; no native run"
title.shape: text
stage: "Creation at command depth d\nCanonical list stages root: +1\nExplicit discount: -1; initial aux = 0"
resume: "Resume suspended offset a\nSave current d in aux\nSwitch ExecEnv / frames; n := d + a"
active: "Active coroutine\nContext carries 4 frame fields\nCancellation flags remain interpreter-scoped"
yield: "Successful yield\nn := saved caller d\naux := previous active n - d\nLogical activation and resources remain live"
failed: "C stack position mismatch\nRepair possible splice reference, write ERROR\nNo successful yield depth swap"
root: "Terminal root NRCommand\nn := n - 1 before async / cancel / limit checks\nOrdinary d = 1 can expose n = 0"
cleanup: "Terminal exit still active at discounted depth\nDelete command and ExecEnv; release line table\nRestore caller environment; only then n := n + 1"
floor: "Older native trace at h >= 1\nOrdinary nested d >= h + 1\nIf offsets and callback pairing stay balanced:\nterminal d - 1 >= h, no zero-depth clear beneath it\nAll-history offset / pairing invariant remains unresolved"
stage -> resume -> active
active -> yield -> resume
active -> failed
active -> root -> cleanup -> floor
root.style.fill: "#DFEEFF"
cleanup.style.fill: "#FFF0E5"
floor.style.fill: "#FFF0E5"
