direction: down
classes: {
  source: {style.fill: "#e8f1fb"; style.stroke: "#346a98"}
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  gate: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "Receipt issuance and failure custody\nA timeout or response value does not dispose of roots" {shape: text}
source: "Preparing / source owns headers and root discovery\nR + target reservations + stable identities\nNo receipt has been issued" {class: source}
abort: "RTF01--02 / confirmed precommit abort\nSource keeps storage / roots / VM dependencies\nOnly private target resources may roll back" {class: gate}
permit: "Protected RootTransferPermit\nG serializes cancel versus commit claim\nCommitting wins: await actual mutation disposition" {class: proposed}
source -> abort: "preparation fails"
source -> permit: "all issuance conditions"
permit -> abort: "cancel wins before commit claim"
member: "MembershipCommitted / target owns storage\nHandoff owns prepared roots and held VM boundary\nStable completion publication before G consumption" {class: proposed}
permit -> member: "C commits bounded plan"
unknown: "RTF03--04 / unpublished or unknown mutation\nNo success receipt; do not free or resume\nResolve known facts OR retain real quarantine\nNo source-destructor rollback after commit" {class: gate}
member -> unknown: "publication / native disposition failure"
receipt: "RootTransferReceipt issued by runtime coordinator\nMatching identity + permit + membership commit\nTarget discovery publication + live dependency custody" {class: proposed}
member -> receipt: "all facts committed under authority"
consumer: "RTF05 / reply lost or task delivery fails\nResolve SAME TransferId / AttemptId\nTarget roots stay registered; existing work stays counted" {class: proposed}
receipt -> consumer
scope: "Scoped current use requires live leases\nReceipt is not VM / heap release authority\nReceipt is not old scan-facility retirement authority" {class: gate}
consumer -> scope
