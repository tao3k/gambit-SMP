direction: down
classes: {
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  gate: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "RC commit -> completion -> target root publication\nHeld terminal-epoch cut spans C and G / no nested gates" {shape: text}
enroll: "TPB01--02 / short G\nEnroll before close; reserve records / pins / R\nFinal roots and held boundary validated\nSerialize cancel versus Committing" {class: proposed}
commit: "TPB03 / short C\nBounded prepared nonfailing link mutation\nTarget owns committed storage\nNo callback / allocation / external exit" {class: proposed}
enroll -> commit
completion: "TPB04 / sole custody committer\nImmutable commit facts and list writes\nRelease-publish MemberCommitted\nPinned one-shot CompletionCell" {class: proposed}
commit -> completion: "C completed"
observe: "TPB05 / resolver\nAcquire matching completion before reading facts\nThen short G validates transaction / held cut\nClosingTransfers may finish enrolled descendants" {class: proposed}
completion -> observe: "release / acquire visibility edge"
publish: "TPB06 / single short G commit\nInstall prebuilt target registry + manifest\nRecord authoritative receipt / resolve handoff\nNo receipt issued before root publication" {class: proposed}
observe -> publish
next: "TPB07 / next collector request acquires G\nPin snapshot -> seal seeds -> scan / writeback\nRelease held boundary with valid future discovery\nResponse / notification debt settles separately" {class: proposed}
publish -> next
close: "TPB08 + TFL06--07 / close path\nReject new transfers; keep required GC alive\nWait outside gates for enrolled dispositions\nSuccessor route or no future heap users\nThen collector seal / physical drain / destroy" {class: gate}
enroll -> close: "close may race after enrollment"
publish -> close: "pending disposition resolves"
unknown: "TFL02--04 / unknown or interrupted commit\nNever infer source ownership from Pending\nRetain both possible storage deps + roots + VM\nKeep collection / resume held; no timeout rollback\nNo finite recovery / retention bound proved" {class: gate}
commit -> unknown: "unsupported interruption"
observe -> unknown: "unresolved identity / disposition"
