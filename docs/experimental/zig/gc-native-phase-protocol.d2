direction: right
classes: {
  proposed: {style.fill: "#ede9fe"; style.stroke: "#7c3aed"}
  open: {style.fill: "#ffedd5"; style.stroke: "#c2410c"}
}
run: "Running\ncurrent leases + barrier policy" {class: proposed}
cut: "Rendezvous\ncontexts / foreign carriers\nroot + store producers / workers" {class: proposed}
minor: "Minor evacuation\ncomplete roots + dirty sources\nforward / scan / promote" {class: proposed}
bind: "Minor close\nno stale young refs\nnew roots / leases / major work" {class: proposed}
mark: "Major concurrent marking\npublished nonmoving objects\ntyped logs + initialization" {class: proposed}
close: "Major closing cut\nack producers + drain logs/work\nweak / will dependencies" {class: proposed}
sweep: "Closed dead-set sweep\npage rights + owner release tasks" {class: proposed}
stop: "Retirement\nroot custody transfer\nlast code / payload / worker users" {class: proposed}
unknown: "Unknown native effect / missing root\nretain custody; no completion claim" {class: open}
run -> cut -> minor -> bind -> run
bind -> mark: "major start / resume"
mark -> cut: "minor interrupt"
mark -> close -> sweep -> run
close -> stop: "shutdown request"
cut -> unknown
close -> unknown
