direction: down
classes: {
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
  candidate: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  gap: {style.fill: "#FBE9E7"; style.stroke: "#A54A3B"}
}
deployment: "C0 or C1 deployment eligibility\nLink / launch / loaded library / callback ABI\nAll runtime qualification currently unrun" {class: gate}
abi: "Callback contract before probe evidence\nExact C prototypes and layout\nProbe base versus record address\nNULL record is completion, not normal abort\nHandler results use different constants" {class: gate}
deployment -> abi
admission: "Inspect recipe and library call path\nNo zero-match suppression\nNo wildcard introducing excluded provider\nUser probe creation may grab process internally" {class: gate}
abi -> admission
scopes: "Independent probe scopes" {
  allowed: "Conditional candidates\nP01 health / P02-P03 scalar syscalls\nP04 bounded snapshots / P05 failures\nEach target ABI needs its own controls" {class: candidate}
  excluded: "Excluded or deferred\nP07 user pid probes in strict L2\nP08 internal kernel fbt\nNo implicit attach or control as fallback" {class: gap}
  unresolved: "Witnesses still missing\nP06 full spawn fd transitions\nP09 protected-tool visibility\nP10 original Scheme delivery" {class: gap}
}
admission -> scopes.allowed
admission -> scopes.excluded
admission -> scopes.unresolved
seal: "Per-scope evidence admission\nFiring and fidelity + errors / loss / drain\nProcess-generation join if attribution required\nLocal facts retained without invented joins" {class: gate}
scopes.allowed -> seal
verdict: "Qualified scope OR explicit unresolved\nNo platform-wide support certificate\nNo automatic equivalence or retirement pass" {class: gate}
seal -> verdict
