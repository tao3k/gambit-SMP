direction: down
policy: "GateSpec selects semantics\nno silent policy fallback"
source: "ObservedSource\nexisting service/check sites"
ordered: "OrderedEntry\nsame dispatcher at new entry context"
first: "CancellationFirstEntry\nnew callback-free cancellation class"
fold: "Oldest ready -> callback unlocked\ncode/result fold -> rescan from head\nnew older marks regain priority"
context: "Qualified interp / code / result\nreentry and progress domain\nnew service timing is explicit"
priority: "Cancellation before arbitrary handlers\nchanges relative priority\nunrelated ready tokens remain"
reference: "Existing source checks / natural resets\nqualified evidence or refusal\nno new entry scheduling"
common: "Final C-serialized decision\npolicy-bound cause and outcome\nearly guard already armed"
policy -> source
policy -> ordered
policy -> first
source -> reference
ordered -> fold: "selection rule retained"
ordered -> context
first -> priority
fold -> common: "new entry policy only"
context -> common
priority -> common
