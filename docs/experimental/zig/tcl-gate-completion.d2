direction: down
armed: "Arm logical guard before readiness\nreserve durable NRE / outcome custody"
early: "Early readiness ERROR\nbytecode-return cleanup not registered"
body: "Admitted execution / rejection cleanup\nnormal / error / parse / compile exits"
finalize: "Finalizing\nactual caller post-return + NRE terminal\nchild / handler / coroutine grace"
check: "L -> C -> A validation\ncompleted contributors only\nno newer debt / pending installer"
deferred: "Deferred / suspended / unknown\nleave shared state intact\nno clean epoch publication"
settled: "Exactly-once guard settlement\nnatural-source or normalized basis\npolicy and generation retained"
receipts: "Same-policy receipts\nfinal reset / publication boundary\nowned outcomes delivered separately"
armed -> early
armed -> body
early -> finalize
body -> finalize
finalize -> deferred: "live or uncovered dependency"
finalize -> check: "qualified owner-safe frontier"
check -> deferred: "new raw / mixed contribution / stale cut"
check -> settled: "all premises valid"
settled -> receipts
deferred -> finalize: "retry after actual dependency return"
