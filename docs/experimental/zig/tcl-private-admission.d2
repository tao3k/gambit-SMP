direction: down
title: "PRIVATE ENTRY ADMISSION\nSource existence, actual caller, and legal contract are separate"
title.shape: text
decl: "Private declarations and stub slots\nExplicitly unsupported; public stubs match is insufficient"
core: "Actual committed producer\nTEOV enter / leave: four helper call expressions\nOrdinary command increment precedes dispatch"
zero: "Supplied private depth-zero trace\nBracket Ready ERROR -> non-force clear -> old U restore\nBody construction closed; actual caller still unidentified"
hook: "Actual storage / async / deletion callout edges\nNo concrete admitted force-reset hook identified"
admit: "Project-owned admission record\nExact source / ABI + owner / lifetime + command / record\nExecEnv + callback root + depth + effects / exits\nPer-caller resources and reset authority"
decision: "Qualified source profile and semantic producer closure?"
decision.shape: diamond
yes: "May enter managed adapter design\nStill requires completion and full acceptance\nNo current native qualification"
no: "Keep route unresolved or reject managed reuse\nRetain raw semantics and resource custody\nNever infer an existing native bug from a missing caller"
decl -> core
decl -> zero
decl -> hook
core -> admit
zero -> admit
hook -> admit
admit -> decision
decision -> yes: "closed obligations"
decision -> no: "unknown producer / contract"
core.style.fill: "#E8F4E8"
zero.style.fill: "#FFF0E5"
no.style.fill: "#FFF0E5"
