direction: down
demand: "Necessary demand before cost aggregation\nQ package resolver + B compile/link executor exist\nR RFD reconstruction and L LLVM adapter are proposals\nDo not add optional components to manufacture amortization"
components: {
  label: "Distinct consumers, not operation-count multipliers"
  r: "R: RFD\nExact arrays / frame laws\nNo child-runner use"
  q: "Q: package resolver\nQuery bytes / ordering / dependency meaning"
  b: "B: native executor\nRecipes / inherited terminal / output roles"
  l: "L: optional LLVM adapter\nProvider ownership / cohort / mutation policy"
}
envelope: "Shared SA01 / SA04 / SA05 where actually used\nEnvelope + diagnostic transport + allocation mechanics\nPer-component semantic validation and lifetimes remain"
runner: "Shared SA02 runner: Q + B\nL only for external-driver mode; R never\nC backend/libuv and Zig std support are alternatives\nOne backend/support event counted once"
cost: "Portfolio ledger SA01-SA09 / NC01-NC07\nUnique shared work + disjoint local work\nSubtract migration, coexistence, coordination and marginal support\nF/n allocates F; it does not create savings"
gate: "Positive only with justified bounds\nSavings lower bound > all incremental cost upper bounds\nCompare cheaper typed-Scheme topology independently\nNo positive bound established / no native tests" {
  style.fill: "#fff0ce"
}
demand -> components
components.r -> envelope
components.q -> envelope
components.b -> envelope
components.l -> envelope
components.q -> runner
components.b -> runner
components.l -> runner: "external-driver only"
envelope -> cost
runner -> cost
cost -> gate
