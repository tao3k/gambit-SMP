direction: down
raw: "Raw idle cancellation\nrequested target + coverage + entry contract"
reservation: "Host job reservation\nnot yet an actual entry"
natural: "Natural event / native caller\nmay evaluate the target first"
entry: "Source semantic entry under C\nfirst eligible target ordinal\nbefore callback-capable preparation"
alias: "Wrapper / internal forwarding\nsame evaluation identity"
child: "Later nested script callback\nnew child identity + causal parent"
command: "Internal command dispatch\ncommand step under current identity"
result: "First identity remains bound\nincluding empty / early ERROR attempts"
other: "Different interpreter on same owner\ncannot win requested-target debt"
raw -> entry
reservation -> entry: "only when actually invoked"
natural -> entry: "actual winner can be callback script"
entry -> alias
entry -> child
alias -> command
alias -> result
child -> result: "cannot replace parent first binding"
other -> result: "excluded by target identity"
