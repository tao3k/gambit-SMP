direction: down
title: "SIGNED DEPTH DEBT AND TAGGED AUX\nSource-based conditional equations; no native run"
title.shape: text
reserve: "Deferred NRCommand reservation\nMarkTailcall pushes callback without depth credit\nNext evaluator consumes reservation and increments once"
create: "Coroutine root creation\nCanonical root staging +1; explicit discount -1\nInitial suspended offset a = 0; root debt = 1"
resume: "Activate from current caller depth b\nn := b + a; active aux := b\nBind caller ExecEnv + restoration callback"
yield: "Successful yield after net signed change s\nn := b; suspended aux := a + s\nRetain coroutine and its root debt"
terminal: "Terminal root NRCommand retires\nBalanced root reaches n = b - 1\nAsync / cleanup can still execute"
exit: "Terminal cleanup -> caller environment restore\nCompensate +1; n = b\nIn-flight exit / caller callback still need actual return"
ordinary: "Ordinary nested command beneath trace h\nb >= h + 1, so b - 1 >= h\nOnly under balanced lease / offset / pairing premises"
rewind: "Direct DeleteCoroutine -> RewindCoroutine\nSchedules activation WITHOUT command increment\nIdle root-yield example: b=0, a=0\n0 -> -1 -> 0 is a conditional source path"
reserve -> create -> resume
resume -> yield -> resume
resume -> terminal -> exit
terminal -> ordinary
terminal -> rewind
ordinary.style.fill: "#E8F4E8"
rewind.style.fill: "#FFF0E5"
exit.style.fill: "#DFEEFF"
