direction: down
classes: {
  retained: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
original: "Original workload and tools\nUnmodified producer / shell / compiler / runtime\nOriginal parent/reaper and launch context\nNo wrapper, DYLD injection or debugger" {class: retained}
observer: "Independent native ES notification client\nEntitlement / privilege / TCC readiness required\nOutside target parent chain and process group\nNo AUTH response or target-side logging state" {class: proposed}
events: "Candidate successful-exec observations\nEXEC: counted raw argv/env; cwd when version allows\nEXIT: wait-format stat; FORK/exec audit identities\nSelect message version >= 4 for this profile" {class: proposed}
original -> events
observer -> events
coverage: "Q01-Q08 / completeness gate\nByte fidelity, physical cwd and path truncation\nAudit pid/pidversion; subscribe/mute/filter scope\nKernel counters + local transport + drain/fences" {class: gate}
events -> coverage
partial: "Potential scoped L2 evidence\nSuccessful exec-time launch state and termination\nNo claim of zero scheduling/system perturbation\nL3 uninstrumented acceptance still required" {class: gate}
coverage -> partial: "all required fields qualified"
unresolved: "U1-U10 remain explicit\nNo client/calibration/stream available today\nFailed exec/spawn errno; tty/query outputs\nScheme delivered status and barriers not in ES exit" {class: gate}
coverage -> unresolved: "missing coverage / unsupported boundary"
limits: "Alternative tools are partial evidence\neslogger: group suppression, unstable JSON, log limits\nexecsnoop: pr_psargs text; DTrace/SIP restrictions\nPolling: races; wrappers/debuggers: changed context" {class: retained}
limits -> unresolved
note: "DESIGN ONLY. SDK/API evidence establishes a candidate, not a working observer.\nNo tracing, permission change, implementation, native test or performance run." {shape: text; style.font-size: 15}
partial -> note: {style.opacity: 0}
unresolved -> note: {style.opacity: 0}
