direction: down
classes: {
  policy: {style.fill: "#e4efff"}
  native: {style.fill: "#e8f5e6"}
  open: {style.fill: "#fff0d0"}
}
external: "RSD01 Close external issuance\nNo new independent resource/task producer\nExisting creators and readers retain custody" {class: policy}
producers: "RSD02-RSD03 Quiesce and seal root producers\nInclude final-GC discovery and rollback tasks\nCount bounded descendants under existing parent credit" {class: native}
drain: "RSD04 Drain work and required users\nQueued, active, waiting, pending publication and readers\nKeep pumps, owner executors, clocks and libraries live" {class: native}
retained: "RSD05 Resolve or transfer retained state\nSurviving custodian retains real dependency closure\nUnknown disposition blocks dependent teardown" {class: open}
stop: "RSD06 Stop and join executor\nWithdraw ordinary wake resolution; use reserved stop pin\nJoin is thread exit, not task or resource success" {class: native}
physical: "RSD07 Free physical service after actual drain\nWaiters / late wakers / directory readers all gone\nThen wake fds, buffers, group and service storage" {class: native}
providers: "RSD08 Release library / image / runtime dependencies\nNo pending destructor, native return or retained use\nMemory epoch complete is not native release drained" {class: native}
open: "Conditional safety, not guaranteed termination\nFinite work + cooperative peers / owners + live executor\nEmpty queue or timeout alone cannot close this proof" {class: open}
external -> producers
producers -> drain
drain -> retained
retained -> stop: "no dependent work remains"
stop -> physical
physical -> providers
providers -> open
