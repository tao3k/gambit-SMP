direction: down
classes: {
  gambit: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
  runtime: {style.fill: "#E7F4E8"; style.stroke: "#397344"}
}
semantic: "Gambit semantic producer\nGVM -> HostGraph / FrameSpec / effects\nScheme identities, liveness and continuation authority" {class: gambit}
planner: "Proposed Zig common product engine\nOne host/point/frame layout and capability plan\nNew C emitter + runtime-aware MLIR/LLVM emitter\nRetire whole-old-emitter forwarding" {class: proposed}
semantic -> planner
cbuild: "C1 product\nNew C host renderer -> configured GCC\nRequired-tail capability; no plain-return fallback\nLocal ordinal -> private C CFG" {class: proposed}
nbuild: "N1 product\nRuntime-aware lowering -> LLVM native object\nSame target C ABI; required tail edges\nNo cpu.scm C packaging wrapper" {class: proposed}
planner -> cbuild
planner -> nbuild
module: "Declarative HostContract/1 module\nPer-host entries / points / symbolic runtime roles\nFrame descriptors / constants / fixups / init plan\nNo pc=0 query, public goto table or handler ordinals" {class: gate}
cbuild -> module
nbuild -> module
centry: "C1 host entry / exit\nvoid(ps), decode admitted pc and local ordinal\nReload GVM state, execute local CFG\nWrite back -> resolve -> required tail transfer" {class: gambit}
nentry: "N1 host entry / exit\nSame void(ps) target C convention\nDecode point, reload state, execute native CFG\nWrite back -> resolve -> required tail transfer" {class: gambit}
module -> centry: "resolved runtime binding"
module -> nentry: "resolved runtime binding"
centry -> nentry: "C1 -> N1: independent GCC exit + LLVM entry proof"
nentry -> centry: "N1 -> C1: independent LLVM exit + GCC entry proof"
shared: "One Gambit runtime and Scheme frame graph\nTail call preserves incoming continuation\nNon-tail call stores a Scheme return point\nGC sees actual roots/maps; captures can outlive hosts" {class: runtime}
centry -> shared
nentry -> shared
decision: "C/backend interface refactor, design only\nSelected cohort rebuilt; no C0 binary shim\n10 replacement paths / 12 edge receipts / 8 module cases\nImplementation and native qualification remain open" {class: gate}
shared -> decision
