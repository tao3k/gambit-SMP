direction: down
classes: {
  semantic: {style.fill: "#e6f2ff"}
  native: {style.fill: "#eaf5e6"}
  provider: {style.fill: "#eee9ff"}
  gate: {style.fill: "#fff0ce"}
}
scheme: "Gambit Scheme authority\nRootPlan / FrameSpec / effects / control\nForeignPlan / PointId / runtime roles" {class: semantic}
contract: "Shared runtime contract\nVM admission / execution / roots / request epochs\nWorker team / invocation origins / code last use" {class: semantic}
compiler: "Native compiler service process\nZig or matched modern C implementation\nPhysical products / provider sessions / byte custody" {class: native}
llvm: "LLVM / optional MLIR provider\nMachine lowering / admitted spill + relocation\nNo automatic Gambit park or membership handshake" {class: provider}
product: "Owned native product\nObject + maps + constants / fixups / roles\nSemantic / runtime / target / provider identity" {class: native}
sdk: "In-process runtime SDK\nValidate / bind / instantiate / enter\nCollector and continuation law stays Gambit-owned" {class: semantic}
lastuse: "Runtime final-use certificate\nExecution / scanner / continuation / map / native return\nThen provider or OS release" {class: gate}
raw: "Admitted raw-C control island\nAll crossed frames and matching origin\nNo foreign nonlocal jump across Zig frames" {class: gate}
scheme -> compiler
scheme -> contract
contract -> compiler: "required protocol and layout"
compiler -> llvm
llvm -> product
product -> sdk
contract -> sdk
sdk -> raw
sdk -> lastuse
cost: "Two distinct value conditions\nFull modernization vs current Gambit\nZig increment vs same-capability C-full\nReal C caller retirement; all residual costs" {class: gate}
compiler -> cost
contract -> cost
