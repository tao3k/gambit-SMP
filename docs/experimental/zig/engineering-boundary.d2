direction: down
classes: {
  existing: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  contract: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
gambit: "Gambit authority\nLanguage semantics and effective configuration\nSemantic module composition; GC / control / scheduler" {class: existing}
contracts: "Versioned native contracts\nConstruction data | runtime protocol | host interface\nImmutable semantic export; artifact role and identity" {class: contract}
zig: "Reusable Zig engineering layer\nTarget toolchains and dependencies\nService lifecycle / cancellation / native buffers\nBuild graph / cache inputs / diagnostics / artifacts" {class: proposed}
gambit -> contracts: "authoritative inputs and compatibility"
contracts -> zig: "explicit requests"
services: {
  label: "Independent native service bundles"
  style.font-size: 20
  c: "C compilation\nGambit-generated C" {class: existing}
  mlir: "MLIR AOT service\nPrivate dialects, passes, LLVM version\nSemantic algorithms remain substantial work" {class: proposed}
  future: "Future native services\nCandidate users of common engineering contract\nEach needs its own semantic adapter" {class: proposed}
}
zig -> services.c
zig -> services.mlir
zig -> services.future: "reuse opportunity" {style.stroke-dash: 3}
artifact: "Artifacts with provenance and compatibility descriptors\nGambit admits / links / loads / initializes\nService success is not runtime acceptance" {class: contract}
services.c -> artifact
services.mlir -> artifact
services.future -> artifact: {style.stroke-dash: 3}
cost: "Potential saving: repeated engineering adaptations\nIllustration only: m*n relationships -> m+n\nSemantic correctness and qualification matrix remain\nInitial contract and version migration add cost" {class: contract}
artifact -> cost
note: "DESIGN ONLY: isolates change; does not erase compiler complexity.\nNo measured engineering-hours or runtime speedup claim." {shape: text; style.font-size: 15}
cost -> note: {style.opacity: 0}
