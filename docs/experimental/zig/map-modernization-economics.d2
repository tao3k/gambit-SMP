direction: right
classes: {
  actual: {style.fill: "#dbeafe"; style.stroke: "#2563eb"}
  candidate: {style.fill: "#ede9fe"; style.stroke: "#7c3aed"}
  open: {style.fill: "#ffedd5"; style.stroke: "#c2410c"}
}
base: "Actual current Gambit\nworking control / GC\ncoupled C construction" {class: actual}
c: "Modern C reconstruction\nfund generator / service / integration\nnot an existing free baseline" {class: candidate}
zig: "Direct Zig reconstruction\nfund emitter / service / integration\nno modern-C prerequisite" {class: candidate}
ledger: "Three complete ledgers\nC versus current / Zig versus current\nZig versus costed C" {class: open}
admit: "Admit only with\nfull capability + actual retirement\npositive conservative net" {class: candidate}
open: "Unknown bounds stay unresolved\nretain scientific modernization goal\nselect carrier by complete evidence" {class: open}
base -> c -> ledger
base -> zig -> ledger
ledger -> admit: "justified bounds"
ledger -> open: "missing or refuted"
