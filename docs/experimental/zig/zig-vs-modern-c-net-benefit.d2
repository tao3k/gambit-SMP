direction: down
common: "Gambit Scheme + runtime authority\nSame ForeignPlan / HostGraph / FrameSpec\nSame capabilities, profiles, providers and semantic constraints"
alternatives: {
  label: "Equal-capability paired design"
  c: "B1-C: modern C subsystem\nScheme generation + static assertions + strict diagnostics\nOpaque/generated variants + allocator/cleanup APIs"
  z: "Z1: Zig native subsystem\nTyped private variants + native helper specialization\nOrdinary-return cleanup + native library reuse"
}
owners: "BC01-BC08 logical owners retained in both\nZero owner elimination from language choice alone"
local: "ZC01-ZC04: bounded candidate increments\nPC01: private product associations\nPC02: ordinary metadata resource relations"
excluded: "ZC05-ZC08: no independent credit\nC access / generic LLVM / cache slogans / no-GC multicore\nCharge actual adapters, control and upgrade work"
certificate: "TG4: actual support surface becomes unnecessary\nTG5: justified positive cost bound or accepted bounded tradeoff\nConsider best C counterdesign and adverse cases" {
  style.fill: "#fff0ce"
}
decision: "Current theoretical gate: not passed\nLocal mechanism support is not aggregate net benefit\nNo implementation or native small tests"
common -> alternatives.c
common -> alternatives.z
alternatives.c -> owners
alternatives.z -> owners
owners -> local
owners -> excluded
local -> certificate
excluded -> certificate: "exclude shared gains; include residual costs"
certificate -> decision
