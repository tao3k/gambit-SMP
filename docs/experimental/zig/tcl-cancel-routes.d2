direction: down
request: "Host epoch\nlease + monotone batching"
async: "Tcl pending record\nAsyncMark then owner callback"
flags: "Installed one-shot / persistent unwind\nnot an evaluation-return receipt"
bytecode: {
 label: "Bytecode route"
 poll: "Reached poll\nasync + cancellation check"
 exception: "gotError -> checkForCatch"
 bypass: "Persistent cancel: bypass catch target"
 cleanup: "abnormalReturn\noperand / aux / frame / stack cleanup"
 poll -> exception -> bypass -> cleanup
}
nre: {
 label: "Direct / command / NRE route"
 entry: "Readiness check and command dispatch"
 post: "Catch / Try callbacks\nbookkeeping and native traces possible"
 check: "Outer check reasserts only\nif cancellation has not reset"
 entry -> post -> check
}
gap: "Unresolved\ncompiled Try lowering + exact reset route\ncoherent source / installed library identity" {style.fill: "#fff0d8"}
return: "Actual scope return\nindependent result/options custody"
request -> async -> flags
flags -> bytecode.poll
flags -> nre.entry
bytecode.cleanup -> return
nre.check -> return
nre.post -> gap: "no blanket finally guarantee"
