direction: down
classes: {
  source: {style.fill: "#e5f0ff"}
  design: {style.fill: "#e9f5e5"}
  unresolved: {style.fill: "#fff0d2"}
}
consumers: "Ten source registration expressions\nFile/raw/process, TCP/UDP, directory, event queue\nOne existing shared device-cleanup adapter" {class: source}
policy: "Scheme/runtime owns policy\nEffects, origin errors, root/control and close semantics\nGenerated default C release adapters already reused" {class: source}
service: "One DeviceReleaseCoordinator\nIdentity/claim + users/drain + close stages + disposition\nModern C or Zig: same necessary full capability" {class: design}
leaves: "Reuse admitted OS / library / C leaves\nDevice close/release, SSL cleanup, native task references\nExplicit wait context replaces implicit PSTATE ownership" {class: design}
comparison: "Language increment after reuse\nC generated products + one failure funnel\nZig typed products + lexical ordinary rollback" {class: design}
retire: "Real retirement condition\nOld lifecycle authority and selected manual support gone\nA Zig wrapper over old authority adds a layer" {class: unresolved}
cost: "Net benefit remains unresolved\nOne shared body cannot earn ten-fold savings\nPrice migration, tool/ABI, effects and async drain support" {class: unresolved}
consumers -> service
policy -> service
service -> leaves
service -> comparison
comparison -> retire
retire -> cost
