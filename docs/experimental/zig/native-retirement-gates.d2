direction: down
classes: {
  source: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  contract: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
}
identity: "Pinned comparison context\nOld/new sources, model/profile and tools\nSame input bytes / env / cwd / names" {class: source}
ingress: "M2 / M5: correct typed ingress\nPreserve semantic filtering and presence\nDecode admitted subset; refuse lost boundaries" {class: proposed}
config: "M8: shared model\nBoth outputs derive from one rule graph\nGenerated header and artifact identities bound" {class: proposed}
identity -> ingress
identity -> config
resolve: "M6: one metadata/package resolver\nConditions / field order / query effects\nDiagnostic and failure transport contract" {class: proposed}
ingress -> resolve
config -> resolve
exec: "M3 / M4 / M7: direct execution\nDistinct object / bundle / executable recipes\nSource metadata / aliases / path roles retained\nNo nested native gsc or shell dispatch" {class: proposed}
resolve -> exec
gate: "E01-E32 acceptance obligations\nIndependent old/new process-boundary observations\nExact args, env, cwd, actions and failure status\nNative/runtime checks beyond argv equality" {class: contract}
exec -> gate
restriction: "Unsupported input\nExplicit profile rejection\nRestriction is not an equivalence pass" {class: contract}
ingress -> restriction
retire: "Retire qualified managed caller path\nEnumerate modes / platforms / input subset\nSource inventory proves old chain unreachable\nDelete shared helpers only after all callers covered" {class: proposed}
gate -> retire: "required evidence passes"
retain: "Retained owners\nGambit language / linker / GC / control / setup\nGerbil phases, aliases and semantic barrier\nConfigure probes; outer native/platform gates" {class: source}
retire -> retain
note: "DESIGN ONLY. Every M2-M8 gate remains OPEN.\nNo implementation, native acceptance or performance result is claimed." {shape: text; style.font-size: 15}
retain -> note: {style.opacity: 0}
