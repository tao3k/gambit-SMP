direction: down
outer: "Outer LibraryScope A\nowner + interpreter generation\nroot / marker frontier"
inner: "Nested eval / update / vwait\nchild scope B\nexplicit event causality"
outer -> inner
producer: "Child Scheme callback\nproduce rooted outcome O\nproducer remains custodian"
inner -> producer
offer: "Offer to declared target\nidentity + policy + payload roots\nnot nearest current catcher"
producer -> offer
sync: "Synchronous boundary\nTcl status/options OR host outcome\naccording to declared authority"
sink: "Durable event sink\naccept roots and resources\nbefore producer release"
offer -> sync
offer -> sink
settle: "Accepted / explicitly disposed\nreceipt changes custodian\nchild and parent claims may drain"
sync -> settle
sink -> settle
