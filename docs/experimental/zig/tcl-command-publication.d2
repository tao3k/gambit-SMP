direction: down
entry: "Owner-thread creation\nprotected proc / name\nbuilder hold before effects"
prepare: "Candidate prepared\nreuse RC + still vector\nroot and image custody"
create: "Tcl_CreateCommand\nmay delete old identity O\nnew candidate N remains held"
entry -> prepare -> create
fail: "Known pre-adoption NULL\nbuilder disposes N once\nold side effects are not rolled back"
adopt: "Token returned\nreconcile identity + generation\nand delete_seen before receipt"
create -> fail
create -> adopt
live: "Adopted command\npublication hold owns N\nbuilder drops its hold"
revoked: "Revoked / unknown outcome\nretained operation record\nno guessed release or success"
adopt -> live
adopt -> revoked
old: "Replacement reentry\nO and N have distinct users\nunknown recreate/trace behavior unqualified"
create -> old
old -> revoked
