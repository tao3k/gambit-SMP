direction: down
classes: {
  source: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
retained: "Retained Darwin / GCC configuration\nTRUST_C_TCO + ordinary C setjmp\nSingle host / inline jumps / lowlevel-exec disabled\nGenerated source/configuration; not installed binary proof" {class: source}
policy: "Header-derived host-exit policy\nCentralized / setjmp / trust / multiple-compiler inputs\nResolve per runtime and generated unit\nActual musttail attribute selection remains unknown" {class: source}
retained -> policy
h1: "H1: exclusive proper-tail exit\nRetained defaults imply this conditionally\ncall enters host directly\nOrdinary trampoline excluded" {class: source}
h0: "H0: ordinary host return\nExplicit centralized cohort selection\ncall runs existing trampoline\nHost writes pc/state then returns" {class: proposed}
h2: "H2: trip / unwind hybrid\nHost chain + bounded C-stack trip\nUnwind resumes trampoline\nSeparate deferred combination" {class: gate}
policy -> h1: "default deduction"
policy -> h0: "requires coherent rebuild"
policy -> h2: "other policy combination"
d1: "Proposed D1-H\nUniform target C host ABI: void(ps)\nC -> N and N -> C required tail edges\nSame Scheme labels / closures / frames\nNo private machine-register bridge required" {class: proposed}
d0: "Proposed D0\nC and native hosts return to dispatcher\nLocal native CFG stays direct\nScheme call/return uses Scheme frames\nNot a drop-in H1 host" {class: proposed}
h1 -> d1
h0 -> d0
deferred: "Deferred D1-R\nPrivate register ABI needs two-way bridges\nControl/code representation must be chosen\nExisting THUMB2 path is not Apple arm64 support" {class: gate}
d1 -> deferred: "independent capability extension"
admit: "Shared admission remains open\nEvery mixed Scheme tail cycle bounded in native stack\nContinuation / root maps / module lifetime compatible\nNo flag changes, implementation or performance run" {class: gate}
d0 -> admit
d1 -> admit
h2 -> admit: "not inherited silently"
