direction: down
classes: {
  retained: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  contract: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
caller: "Gerbil / Gambit process\nProduce semantic export + target/runtime requirements\nOwn and reap its direct executor child" {class: retained}
request: "Inert request / immutable input references\nNo Scheme heap address or MLIR handle\nSemantic version + approved lowering policy" {class: contract}
caller -> request
executor: "Zig executor process\nResolve recipe, capabilities, budgets and owned outputs\nOwn and reap native tool / service children\nDo not compete inside Gambit with its waitpid(-1) handler" {class: proposed}
request -> executor
service: "MLIR service child process\nOwn contexts, operations, dialects, passes and LLVM emission\nPinned C++ / native build; optional C API inside service\nVerifier / diagnostic / crash reproducer support" {class: proposed}
executor -> service
success: "Completed output role\nC-ABI companion OR full Gambit protocol code object\nExact export / pipeline / target / dependency identities" {class: contract}
service -> success: "successful native construction"
failure: "Unsupported / failure / cancellation request\nRetain diagnostics; do not publish success\nCancellation completion requires actual child/resource settlement" {class: contract}
service -> failure: "non-success"
publication: "Executor validates and publishes native product\nNo semantic instance or initializer result cached\nGambit receives real executor terminal status" {class: proposed}
success -> publication
admit: "Gambit consumes the result\nPreflight before mapping; original link/setup/init authority\nRuntime objects, GC, control and unload remain Gambit-owned" {class: retained}
publication -> admit
note: "Compiler-process isolation is not an OS security sandbox.\nThis design does not repair existing runtime GC/SMP or Darwin loader faults.\nProcess budgets, descendant cancellation and source/control correspondence still require qualification." {shape: text; style.font-size: 15}
admit -> note: {style.opacity: 0}
