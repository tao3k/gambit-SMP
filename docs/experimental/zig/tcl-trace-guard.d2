direction: down
title: "TRACE TO COMPLETION-GUARD HANDOFF\nDependencies point toward children; no backward wait edge"
title.shape: text
parent: "Parent evaluation guard / explicit native control owner\nOwns target lifetime and dispatcher dependency\nArmed before callback-capable preparation"
dispatcher: "Trace dispatch scope\nOwns active cursor / saved result / record leases\nInvokes trace frame"
trace: "Trace invocation scope\nPreparation -> original suppression set point\nOwns callback evaluation as a child"
child: "Callback evaluation finishes locally\nRetain target-wide cancellation custody in control ledger\nDo not wait for ancestor or publish target neutrality"
restore: "Trace source-point restore\nSourceSnapshot: record true cancellation write\nSeparatedCancellation: restore legacy only\nNo implicit guard reset or added async poll"
local: "Remaining trace cleanup -> actual trace return\nStep records / DString / final references"
outer: "Invoker finishes cursor / record / result-state cleanup\nActual dispatcher return witnessed by caller"
receipt: "TraceDispatchClosureReceipt\nRelease this dependency only\nNo parent-completion or native-image shortcut"
final: "Parent actually completes; final guard revalidates\nAll trace / native / raw / installer / resource obligations\nOnly then selected owned reset and next-epoch publication"
parent -> dispatcher -> trace -> child -> restore -> local -> outer -> receipt -> final
child.style.fill: "#FFF0E5"
restore.style.fill: "#DFEEFF"
receipt.style.fill: "#DFEEFF"
final.style.fill: "#E8F4E8"
