direction: down
unsafe: {
  label: "Rejected assumption: outer catcher protects Zig"
  c: "Outer C catcher"
  z: "Live Zig frame + native resources"
  cb: "C callback / existing SFUN"
  s: "Scheme callback may escape"
  c -> z -> cb -> s
  s -> c: "nonlocal transfer can skip Zig frame" {style.stroke: "#bb3030"; style.stroke-dash: 5}
}
selected: {
  label: "Selected design alternatives; independently qualified"
  ordinary: "Ordinary-return native service\nNo escaping managed transfer\nZig owns normal native resources"
  cextent: "C-controlled callback dynamic extent\nZig helper returns before escape is possible\nExplicit runtime/C cleanup owns unwind"
  stronger: "Deferred status-return callback capability\nABI + error channel + marker/root proof\nNo silent conversion of legal continuation escape"
}
question: "Per-edge control and lifetime plan\nDoes any legal transfer skip a live Zig frame?\nUnknown or unsupported -> reject selected route" {
  style.fill: "#fff0ce"
}
unsafe -> question
question -> selected.ordinary: "ordinary returns proved"
question -> selected.cextent: "retain Scheme/C control protocol"
question -> selected.stronger: "requires new contract and evidence"
