direction: right
classes: {
  semantic: {style.fill: "#dbeafe"; style.stroke: "#2563eb"}
  native: {style.fill: "#ede9fe"; style.stroke: "#7c3aed"}
  open: {style.fill: "#ffedd5"; style.stroke: "#c2410c"}
}
scheme: "Gambit Scheme compiler\nlanguage / effects / roots / control" {class: semantic}
native: "Proposed Zig native implementation" {
  class: native
  product: "Calls / frames / native products"
  gc: "Gambit managed heap + GC\nimplemented explicitly in Zig"
  vm: "VM / processors / owners\nOS / resources / modules"
  memory: "Native auxiliary storage\nallocator + explicit cleanup"
}
c: "Declared C-facing surface\nC ABI / headers / libraries / extensions" {class: native}
llvm: "Independent LLVM / MLIR provider" {class: native}
gate: "Open obligations\nGC / control / target / C surface\nactual retirement / full net cost" {class: open}
scheme -> native.product
native.product -> native.gc: "managed-object protocol"
native.product -> native.vm
native.gc -> native.vm: "scan / participation"
native.memory -> native.vm: "native ownership"
native -> c
native.product -> llvm
c -> gate
llvm -> gate
