direction: down
classes: {
  semantic: {style.fill: "#e4f0ff"}
  native: {style.fill: "#e8f5e5"}
  limit: {style.fill: "#fff0cf"}
}
inventory: "Independent operation / helper / ForeignPlan inventory\nEvery collecting, callback and control edge accounted\nUnknown effects stay outside admission" {class: semantic}
policy: "Scheme semantic completion\nLiveness + closure environment + continuation + effects\nSC01-SDC09 families are not whole-cohort coverage" {class: semantic}
plan: "Issued RootPlan / FrameSpec / PointId\nKind, slot order, link, live set and layout inputs\nProtect values before any allocating conversion" {class: semantic}
physical: "Physical backend construction\nFR explicit locations / separately admitted SP relocation\nC-full and Z-full obey the same contract" {class: native}
decode: "Pinned map and storage + actual decoder\nIFD/OFD, word packing, RETI expansion\nMapped frame coordinates have an exclusive owner" {class: native}
scan: "Final safe cut -> scan -> complete -> reload\nAll contributors included; root kinds and phases preserved\nNo stale native / SSA alias may cross reentry" {class: native}
open: "Still unresolved\nFull edge/caller census; liveness and layout refinement\nCollector correctness; all-exit effects; native qualification" {class: limit}
inventory -> policy
policy -> plan
plan -> physical
physical -> decode
inventory -> scan: "independent coverage obligation" {style.stroke-dash: 5}
decode -> scan
scan -> open
