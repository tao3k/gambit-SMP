direction: down
join: "Prepare storage; seal old epoch\njoin senders outside locks"
settle: "Owner L -> C -> A\nvalidate and settle managed pending\nrelease C / A provisionally"
raw: "Concurrent raw CancelEval\noriginal API remains callable"
change: "Raw obtains C before final commit\nserial / interference changes\nraw pending preserved"
final: "Final L -> C -> A\nrevalidate all target receipts"
block: "Changed / raw / unknown / busy\nno reset; remain sealed"
reset: "All premises valid\nforce=0 reset each target\ninspect both cancellation bits"
publish: "Same critical interval\nrelease-publish complete fresh descriptor\nthen unlock C / A / L"
after: "Raw obtains C after publication\nvalid raw next-script cancellation"
join -> settle
settle -> final
raw -> change
change -> final: "must be detected"
final -> block: "validation fails"
final -> reset: "validation succeeds"
reset -> publish: "no callback / allocation / destructor"
raw -> after: "waits for C while commit holds it"
publish -> after
