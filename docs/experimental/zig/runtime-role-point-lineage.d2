direction: down
classes: {
  semantic: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  physical: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
  runtime: {style.fill: "#E7F4E8"; style.stroke: "#397344"}
}
manifest: "Runtime-owned required-role manifest\n15 assignments observed in setup_kernel_handlers\nFull domain and per-role signatures still open" {class: runtime}
declare: "Scheme declaration at actual control anchor\nRole purpose + incoming state + effects\nContainer procedure entry is not the handler" {class: semantic}
manifest -> declare
preserve: "Scheme CFG transformations with lineage\nExternal roots survive dead-code removal\nRename / thread / merge / inline preserve anchors" {class: semantic}
declare -> preserve
private: "Poll / check split or clone\nFresh private anchor and PointId\nCopied comments do not duplicate role authority" {class: semantic}
preserve -> private
freeze: "Freeze graph revision\nExactly one compatible addressable PointId per required role\nPoint purpose and RETN / RETT / RETI requirement are distinct" {class: gate}
preserve -> freeze: "canonical exported anchor"
private -> freeze: "private control points, no extra role"
layout: "Zig common product plan\nPointId -> HostId + LocalOrdinal + FrameLayout\nNumbers are physical details, not semantic role identity" {class: physical}
freeze -> layout
binding: "Runtime image binding\nRole -> PointId -> resolved runtime label\nCode and metadata retained by existing lifetime owner" {class: runtime}
layout -> binding
deletion: "Retirement gate\nAll old role consumers migrated and qualified\nThen remove numeric binding / ordinal-prefix dependence\nPreserve unrelated historical frame and masking fixes" {class: gate}
binding -> deletion
