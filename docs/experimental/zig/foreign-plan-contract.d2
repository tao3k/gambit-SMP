direction: down
parse: "Gambit Scheme parser\nResolved types + converters + source identity\nCapture before c-interface-end clears registries"
plan: "Frozen ForeignPlan\nStable EntryId / conversion program / stage effects\nExplicit product owner; no mutable-list acknowledgement"
sem: "Scheme semantic completion\nHostGraph / FrameSpec / runtime roles\nRoots, errors, callbacks and foreign exits"
native: "Common native product subsystem\nB1: modern C or Z1: Zig candidate\nPhysical ABI, layout, symbols and artifact dependencies"
products: {
  label: "One planned product set"
  adapters: "New C / native adapters\nOrdered conversions + explicit module actions"
  islands: "Explicit C / C++ units\nOpaque bodies, macro closure, custom converters"
  service: "Ordinary-return services\nNative-owned requests and results\nLLVM / optional MLIR provider"
}
runtime: "Gambit runtime authority\nManaged objects / moving GC / continuation\nProcessor and VM ownership / matching foreign markers"
gate: "Admission per selected capability\nSource map is not native support\nCall-site census, control containment and net cost remain open" {
  style.fill: "#fff0ce"
}
parse -> plan
plan -> sem
plan -> native
sem -> native: "semantic obligations"
native -> products.adapters
native -> products.islands
native -> products.service
products.adapters -> runtime
products.islands -> runtime: "qualified control / ownership"
products.service -> runtime: "explicit completion + reacquire"
runtime -> gate
