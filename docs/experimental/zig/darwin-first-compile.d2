direction: down
classes: {
  existing: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  contract: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
start: "Actual macOS builder process begins\nExact runtime / driver / workload identity" {class: existing}
prefix: "Pre-first execution\nImports / phase code / expansion / context operations\nAllocation, GC and loading can contribute\nExisting samples do not provide an exclusive whole-window budget" {class: existing}
start -> prefix
native: "Already compiled compiler / transformer code\nNative provider reuse does not imply zero instantiation" {class: existing}
native -> prefix
constructor: "RESEARCH: immutable interface-construction program\nMay avoid repeated generic reading / expansion\nMust create fresh bindings and contexts under current imports\nNo validated saving yet" {class: proposed}
constructor -> prefix: "change required executed work" {style.stroke-dash: 3}
first: "First genuine compile log\nHistorical D1510 ceiling: <= 5 seconds\nNot a five-second sleep / cooldown\nDo not move the log or weaken the gate" {class: contract}
prefix -> first
later: "Subsequent compilation / native construction\nGeneration + C frontend / backend + link as required\nReferenced terminal compiler exec occurs after first log" {class: existing}
first -> later
zig: "Zig construction / MLIR consumer backend\nCan change later construction and product reuse\nDoes not automatically remove earlier expander execution" {class: proposed}
zig -> later: "separate cost boundary" {style.stroke-dash: 3}
rule: "ACCOUNT SEPARATELY\nTime to first real compile / complete build / complete tests\nImmutable code / fresh live instance\nC preprocessor expansion / Scheme macro execution" {class: contract}
later -> rule
note: "DESIGN ONLY: causal boundary from retained reports, not a new timing trace.\nThe full prefix is not attributed to GCC, dyld, GC or any single macro category." {shape: text; style.font-size: 15}
rule -> note: {style.opacity: 0}
