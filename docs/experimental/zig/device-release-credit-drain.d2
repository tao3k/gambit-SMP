direction: down
classes: {
  retained: {style.fill: "#e8f1fb"; style.stroke: "#346a98"}
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  gate: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "Shutdown: count work before publication, transfer real custody\nConservation argument under complete producer/user census" {shape: text}
root: "Close independent root issuance under L\nI retains already issued registrations / discovery\nIncludes free_still_objs AFTER final GC" {class: proposed}
reserve: "Live root permit or parent\nWSL05: reserve counted R + custodian + pins\nBEFORE child construction / parent completion" {class: proposed}
ledger: "J = R + Q + X + W + Y + H\nMove same identity under L\nCancel does not discard custody\nUnknown stays H with dependencies" {class: proposed}
root -> reserve: "issued permit may still produce"
reserve -> ledger: "construct / accept\nexecute / await / publish"
ledger -> reserve: "derive child BEFORE\nreleasing parent credit"
old: "Actual source frontier\nfree_still_objs calls release_foreign\ncleanup_rc then frees all remaining RC entries\nAddref alone does not survive this cleanup" {class: retained}
root -> old: "teardown is a real producer"
custody: "Required choice\nDrain before dependent old cleanup\nOR transfer actual payload/list/root/library custody\ninto an independent survivor" {class: gate}
old -> custody
ledger -> custody: "H / Y / actual storage dependencies"
cut: "CoreDrained cut\nRoot issuance closed; I and J empty\nN notification debts / issued wake work empty\nNo untransferred retained obligation" {class: proposed}
ledger -> cut: "only known terminal / valid transfer\nremoves credit"
custody -> cut: "independence must be established"
join: "Reserved stop lease -> final stop intent\nWaiter exits; stop debt settles; join\nDrain D and remaining lookup/writer/wait borrows" {class: proposed}
cut -> join
free: "Then free endpoint / records / code / libraries\nEmpty queue or final GC alone is insufficient" {class: gate}
join -> free
progress: "WST06 remains conditional\nFinite descendants + live actors + cooperative peers\nNo timeout / retained label implies successful drain" {class: gate}
cut -> progress: "safe zero does not imply eventual zero"
