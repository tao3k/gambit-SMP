direction: down
classes: {
  owner: {style.fill: "#e6f2ff"}
  gate: {style.fill: "#fff0ce"}
  root: {style.fill: "#eaf5e6"}
}
prepare: "Active context prepares outside gate\nIncoming values already rooted\nFrames / RA / native byte custody / root extent" {class: owner}
gate: "Short metadata admission gate\nSerializes park, request, entry and registry topology\nNo allocation, callback, wait or provider call" {class: gate}
request_first: "Request enrolls first\nContext remains required member; park cannot detach it\nFinal active roots arrive at its acknowledgement" {class: owner}
park_first: "Park commits first\nManaged execution permission withdrawn\nPublished VM root carrier remains" {class: root}
ticket: "Request fixes contributors / members / GC workers\nAll active members reach safe acknowledgement\nVM/global domains and parked carriers provide stable descriptors" {class: gate}
rootcut: "Final root cut after acknowledgements\nConstruct canonical location metadata outside gate\nPin stable entries or qualify mapped-frame relocation/accessors" {class: root}
scan: "Frozen scan and relocation\nAll mutators safe; live sealed worker team\nEvery distinct location updated; no unsafe duplicate writers" {class: root}
complete: "Publish terminal result and relocation epoch\nDrain writers before resumed root loads\nUnknown/failed relocation does not grant resume" {class: gate}
reentry: "Reentry admission outside ongoing collection\nExecution + membership + origin/code life\nReload moved values before conversion or Scheme work" {class: owner}
retain: "Unknown host mutation / failed join / missing worker\nRetain custody; block unsafe scan or reclamation\nNo timeout-as-success" {class: gate}
prepare -> gate
gate -> request_first: "request wins"
gate -> park_first: "park wins"
request_first -> ticket
park_first -> ticket
ticket -> rootcut: "descriptors complete and stable"
rootcut -> scan: "root-cut commit and scan grant"
scan -> complete
complete -> reentry
ticket -> retain: "cannot establish safe cut"
rootcut -> retain: "metadata / coverage failure"
scan -> retain: "incomplete / failed collection"
