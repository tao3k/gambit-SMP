direction: down
cohort: "RM00 actual cohort and caller census\nBaseline / candidate / installed ABI separate\nRC list owner + scanner applicability; supported VM modes"
issuer: "RM01 Scheme root/effect/origin extraction\nConverters + marker setup + exceptional/control paths"
roots: "RM02 root adapters and backing lifetime\nDiscover / update / reload / withdraw\nCurrent frame, RC and still mechanisms retained"
owned: "RM03 already-owned BW1 / nested callback\nWait progress, root/state reload and control custody"
vm: "RM04 explicit VM / processor facade\nConfigured selector, exclusivity and binding restoration\nVE05/VE06 only under separately supported profiles"
drain: "RM05 admission / request / reader / return drain\nNo late publisher or scanner into reclaimed storage"
compare: "RM06 equal-capability C / Zig comparison\nRB benefits and KC disjoint costs\nRetire RR old policy owners only after selected caller closure"
optional: "RM07 optional BW2 / external attachment\nNew membership + detached-root + reentry protocol\nIndependent demand and acceptance"
future: "RM08 collector / LLVM evolution\nSeparate algorithm, ABI, root/control and native qualification"
gate: "Design dependency order, not implementation authorization\nNo code retired / no native tests\nCorrectness and positive language net value remain separate" {
  style.fill: "#fff0ce"
}
cohort -> issuer
issuer -> roots
roots -> owned
owned -> vm
vm -> drain
drain -> compare
drain -> optional
compare -> future
optional -> future: "only for capabilities using this extension"
future -> gate
