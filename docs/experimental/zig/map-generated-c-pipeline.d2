direction: down
input: "Public map in _std\nboth arities, checks / force / mutable policy"
front: "Scheme front end\nnormalize -> closure/control lowering -> GVM\nframe/live/closed + target feedback"
complete: "Scheme semantic completion\nexplicit calls / roots / checks / exits\nlogical FrameSpec + PointId intents"
plan: "Scheme common native plan\nphysical frames + root maps + control\nModulePlan + object/store contracts"
input -> front
front -> complete
complete -> plan
early: "Optional early Scheme semantic export\nbefore normalization"
mlir: "Independent MLIR service\nScheme effects and control-aware passes"
input -> early
early -> mlir
mlir -> front: "validate result and recompute affected facts"
c: "Scheme C renderer\nhosts, descriptors, constants, imports\nno hidden semantic inference"
llvm: "Optional direct LLVM provider\nindependent control / relocation admission"
plan -> c
plan -> llvm
native: "C frontend + native linkage\nretained compilation work"
c -> native
binding: "Owned module instances\nregister code/maps -> native setup\nScheme initialization -> active"
native -> binding
llvm -> binding
runtime: "Modern managed runtime in C\nyoung / mature GC + independent workers\nRootRegistry / BarrierLog / ReleaseCoordinator\nScheme control + FFI participation"
binding -> runtime
goal: "Capability gates\nmeaning + sequential cost + pauses + scaling\nspace + FFI + provider change isolation"
runtime -> goal
