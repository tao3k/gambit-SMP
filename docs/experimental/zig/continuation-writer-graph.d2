direction: down
root: "Admitted root / frontier\nowner and epoch"
k: "Mature continuation k\nframe + denv"
frame: "Saved mature frames\nshared dynamic identity\nnormal / internal maps"
denv: "Mature denv\nenvironment nodes"
cell: "Mutable binding pair\nor descriptor cell"
root -> k
k -> frame
k -> denv
denv -> cell
thread: "Thread and denv caches\nindependent alias"
thread -> cell: "alias"
setters: "Frame / shell setter\nserializer / replay"
setters -> frame: "typed write"
param: "Parameter update\nor cache-writing read"
param -> cell: "managed write"
young: "Young object\nall boundary sources covered"
frame -> young: "slot edge"
cell -> young: "value edge"
outside: "Other mature source\nor native carrier"
outside -> young: "outside k's graph"
remember: "Remembered source set\nowner + slot + epoch"
frame -> remember: "record source"
cell -> remember: "record source"
outside -> remember: "admit or fallback"
cut: "Minor roots / dirty / new work\ntrace and fix young edges\nthen reclaim"
root -> cut
remember -> cut
young -> cut
