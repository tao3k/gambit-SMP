direction: down
classes: {
  actual: {style.fill: "#e8f1fb"; style.stroke: "#346a98"}
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  boundary: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "One layout for allocation checks and capacity views\nConditional bounds / no native or performance test" {shape: text}
source: "ACH02 / real check mechanisms\nCompiler threshold = 4096 words / includes cache planning\nRuntime F = 8193 + SUBTYPED_BODY\nCHECK_HEAP tests hp > limit / inspected m is unused\nNeither constant alone proves the full write bound B" {class: actual}
title -> source: {style.opacity: 0}
bound: "ACH01--03 / AllocationCheckSpec\nActual target / constructor span / materialization / alignment\nGrant [q,b), trigger L, qualified high-water excess B\nRequire L+B <= b; retained F needs B <= F and L <= b-F\nStrict greater-than includes the following burst" {class: proposed}
source -> bound
frontier: "IOP03 / ACH04--06 / distinct frontiers\nTentative capacity cursor is not initialized object storage\nCommit actual fields and object extents at safe endpoints\nObjects may use nominal trigger reserve before next check\nAt freeze: used reserve becomes object extent, not hidden space" {class: proposed}
bound -> frontier
layout: "SLM02--07 / classify actual bytes\nPrefix and suffix object runs / controls / sparse gaps\nAbandoned reservation / unused rights / remaining guards\nNo Scheme roots inferred from native metadata or raw gaps" {class: proposed}
frontier -> layout
slow: "ACH05 / replace actual whole-section slow paths\nContext interval limits / stack placement / handler roots\nNext grant or coherent GC/error resume\nNo implicit widening into another writer's interval" {class: proposed}
layout -> slow
ledger: "SAC01--07 / separate accounting views\nPhysical SectionId once / actual allocated extents once\nLive-after-GC differs from source occupancy and policy charge\nHandoff is not new Scheme allocation\nStill promises and native metadata remain separate costs" {class: proposed}
slow -> ledger
limits: "Economic and admission boundary\nGenerated C can share the same descriptions and helpers\nSparse/perobject metadata and unknown retention cost extra\nTarget B / exact counters / full caller domain unresolved\nZig-specific net saving needs a separate positive bound" {class: boundary}
ledger -> limits
