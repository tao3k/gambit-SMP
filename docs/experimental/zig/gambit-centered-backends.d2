direction: down
classes: {
  core: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
target: "Gambit-owned target/runtime profile\nRepresentation / primitives / calls / frames\nBackend capabilities feed frontend decisions\nPVM separation is bidirectional cooperation" {class: core}
front: "Gambit Scheme frontend\nBinding, declarations, effects and control\nExisting optimizer remains a core asset" {class: core}
target -> front
high: "BH: proposed high-level export\nResolved tree before normalization\nScheme dialect -> legal MLIR lowering\nPreserve higher-order optimization window" {class: proposed}
gvm: "Gambit GVM and current optimizations\nVersioned target and runtime requirements\nNo generated-C semantic recovery" {class: core}
front -> high
front -> gvm
routes: "Backend products" {
  c: "BC: mature portable C\nGenerated C + configured compiler\nReference / bootstrap / portability" {class: core}
  native: "BG: proposed compatible native route\nZig-implemented backend/provider\nGVM lowering -> native object\nNot an ordinary C ABI replacement" {class: proposed}
  semantic: "BH native object\nCustom Scheme/runtime lowering\nLLVM target infrastructure\nNo automatic pass legality" {class: proposed}
}
gvm -> routes.c
gvm -> routes.native
high -> routes.semantic
abi: "One admitted generated-code/runtime contract\nObjects, control points, tail calls and frames\nRoots, safepoints, modules and continuation ABI\nMixed deployment must be explicitly qualified" {class: gate}
routes.c -> abi
routes.native -> abi
routes.semantic -> abi
runtime: "One Gambit runtime and managed heap\nExisting GC, libraries and VM authority\nZig compiler has no managed GC requirement\nGenerated Scheme code still uses Gambit GC" {class: core}
abi -> runtime
services: "Separate native service interface\nValues / owned bytes / ordinary returns\nNo arbitrary raw Scheme-pointer retention\nDifferent from admitted Scheme backend code" {class: gate}
runtime -> services
