direction: down
request: "Accepted managed sequences\nold epoch + payload custodian"
closure: "Producer closure + actual owner idle\nstable same-owner tree / binding"
pending: "PendingSettlementReceipt\ncutoff + complete terminal coverage\nno future old installer"
reset: "ResetReceipt\nnon-forced clear-state postcondition"
epoch: "EpochPublicationReceipt\none fresh tree authority"
failure: "Failure / raw interference / unknown mark\nold admission sealed\nno partial publication"
owned: "Original custodian retains\nroots + marker + bytes + image leases\nactual cleanup and derived-work accounting"
raw: "Raw next-script obligation\nnever old-managed disposal"
request -> closure
closure -> pending: "core target settlement"
pending -> reset: "live ticket; final revalidation"
reset -> epoch: "same callback-free lock interval"
closure -> failure
pending -> failure
reset -> failure: "unexpected partial failure"
failure -> owned
raw -> failure: "blocks managed-clean reuse"
epoch -> owned: "retirement obligations remain"
