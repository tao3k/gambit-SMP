direction: down
classes: {
  source: {style.fill: "#e8f1fb"; style.stroke: "#346a98"}
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  gate: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "Root transfer: terminal epoch, membership, future discovery\nConditional same-VM design; not an existing Gambit receipt API" {shape: text}
reserve: "RTO01--02 / source custody + reserved R\nPin VM / source / target / facility before admission closure\nRequest exclusive boundary; no lock-held wait" {class: proposed}
old: "Actual collector phases / old admitted epoch\nStrong -> weak / wills -> continuation move\nCleanup foreign releases -> resize / prepare\nAll physical scanners and queue borrowers settle" {class: source}
reserve -> old: "allow old work to finish"
held: "RTO03--05 / contexts held before resume\nAll final acknowledgements / data writers safe\nBuild exact cell manifest outside G / C / L\nProtected RootTransferPermit; serialize cancel / Committing" {class: proposed}
old -> held: "terminal epoch; counter / barrier alone insufficient"
list: "RTO06 / short C\nBounded same-address RC membership commit\nTarget storage owns headers; source cleanup excluded" {class: proposed}
held -> list
pending: "Protected publication gap\nPrepared roots + target storage + VM pins + R remain\nNO new collection or managed resume\nFailed publication retains held dependencies" {class: gate}
list -> pending
publish: "RTO07 / short G\nPublish target contributor + exact root manifest\nRecord authoritative RootTransferReceipt\nConsume permit only after validated commit facts" {class: proposed}
pending -> publish: "reserved metadata / native ordering required"
next: "RTO08--09\nNext ticket discovers target cells / valid writer assignment\nResume reloads managed state; same AttemptId for task\nSeparate source / target / facility last-use cuts" {class: proposed}
publish -> next
blocked: "Required reconstruction\nDirect resize GC and all raw data/list writers obey same gate\nLLVM statepoint / join / list splice does not issue receipt" {class: gate}
held -> blocked: "omitted caller blocks qualification"
