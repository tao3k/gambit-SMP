direction: down
classes: {
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  boundary: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "Independent collector: root closure and stable termination\nProposed T-serialized metadata / payload scans outside T" {shape: text}
cut: "CWS01 / final safe cut\nBind U-K-S-W-P and actual roots\nPin heap / carrier / frame / facility\nSeal external root writers / producers" {class: proposed}
root: "CWS02--03 / RootMaterialize -> RootReady\nCanonical physical cells and structured frame writers\nInitialize still roots once per shard\nAll root / frame publication complete\nNo cross-worker queued scan before readiness" {class: proposed}
cut -> root
start: "CWS04 / TraceStart under T\nFreeze W; initialize phase state once\nActive permit covers private / claimed / unpublished work" {class: proposed}
root -> start
work: "CWS05--06 / scan outside T\nBuild ready chunk; publish handle under T\nIdle -> Active BEFORE removing Q under same T\nPrivate partial chunk / still chain remains Active" {class: proposed}
start -> work
idle: "CWS07 / quiesce under T\nLocal work / frame writes / publications settled\nRecheck authoritative queue in same transition\nThen relinquish Active" {class: proposed}
work -> idle
closed: "StrongClosed under T\nRootReady + external producers sealed\nNo seed tasks + A=0 + Q=0\nNo later activation / publication in this phase" {class: boundary}
idle -> closed: "representation invariant is a premise"
weak: "CWS08 / later phases still required\nNew weak / will producer domain and work accounting\nContinuation move / table cleanup / sweep effects\nHeap policy and owner-qualified callbacks" {class: proposed}
closed -> weak
terminal: "CWS09 / epoch result and resume\nCommon outcome + owner ResumeBindings + extent custody\nAcquire relocated values before managed use\nPhysical drain includes waiters / signals / resolvers" {class: proposed}
weak -> terminal
fault: "Worker fault / unknown moving state\nDo not drop Active on timeout\nRetain private work / roots / heap / facility\nNo finite recovery or retention bound proved" {class: boundary}
work -> fault
cost: "Proof boundary has a cost\nSerialized metadata queue may contend\nNo root-count speedup or Zig-only saving claimed" {class: boundary}
terminal -> cost
