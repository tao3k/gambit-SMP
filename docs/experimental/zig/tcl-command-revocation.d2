direction: down
enter: "Native callback entry\nclaim record; root before effects\nindependent marker / child scope"
revoke: "Delete hook\nclose publication; record revoke frontier\nreturn without self-wait"
enter -> revoke: "self-delete / nested delete"
live: "Already admitted users continue\ninvocations + pending outcomes\npre-frontier library scopes"
revoke -> live
drain: "Owner-side drain\nno builder / publication / queued users\nno invocation / scope / scan / log users"
live -> drain
root: "Root / carrier retirement\nGC writeback and scanner grace\nrelease native RC on owner"
drain -> root
bytes: "Independent result lease\nTcl custom free callback\nallocator + image survive last return"
enter -> bytes: "result transfer"
shutdown: "Final runtime / module release\ninterpreter deletion hooks completed\nall result callbacks returned"
root -> shutdown
bytes -> shutdown
