direction: down
classes: {
  actual: {style.fill: "#e8f1fb"; style.stroke: "#346a98"}
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  boundary: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "Still quota across GC / one current authority\nConditional cut and carry / not an executed accounting witness" {shape: text}
cut: "SCA01--02 / held RecountCut\nClose new independent claims and mutations\nPin participants / settle Claimed native effects\nNo gate held while waiting for actual owners" {class: proposed}
title -> cut: {style.opacity: 0}
stable: "SCA03 / stable traversal and admitted GC work\nExclude list writers / pin physical blocks before reading\nSettle relevant sweep/free/destructor dispositions\nLate revision validation cannot repair freed-memory reads" {class: proposed}
cut -> stable
image: "SCA04 / build prepared RecountImage outside H\nA: private + enrolled + detached pending-free blocks\nR: carried + new prepared Reserved grants / no storage\nCharge = distinct A words + distinct R demand\nDeferred actual words are already in A / no extra batch D" {class: proposed}
stable -> image
adopt: "SCA05 / short H adoption\nValidate held cut / revisions / known dispositions\nCommit image handle and carry membership\nSame GrantId / current ledger, not mint-epoch scalar" {class: proposed}
image -> adopt
publish: "SCA06 / H completion -> G publication\nHeld cut spans delivery and resume preparation\nBind actual accounting to common GC outcome\nThen reopen matching admissions / acquire before use" {class: proposed}
adopt -> publish
refund: "SCA07 / unused refund vs cut\nRefund first: image excludes the grant\nAdoption first: refund removes it from current image\nOne H authority serializes both orders" {class: proposed}
publish -> refund
consume: "SCA08--09 / consumption and actual free\nClaim before seal: settle known disposition before image\nSeal before claim: claim waits\nConsumed block replaces promise once\nDecref does not remove actual charge" {class: proposed}
refund -> consume
source: "SC-S01--03 / source credit\nDeferred allocation / native-failure refund\nSweep recounts live objects / processor reduction\nOutstanding asynchronous promises are new support" {class: actual}
stable -> source
unknown: "Unresolved disposition / no exact rebudget\nRetain real storage / roots / quota / VM / native users\nNo timeout refund or duplicate native operation\nNo bounded progress or retained-memory claim" {class: boundary}
consume -> unknown
