direction: down
title: "NESTED TRACE SUPPRESSION\nExact source scopes; design research only"
title.shape: text
a: "Outer TraceExecutionProc A\nSave legacy projection with prior I=0\nAt source boundary: I=1, A busy"
routes: "Callback script invokes more commands"
skipA: "Same active record A\nPer-record busy test skips callback body\nNot a global trace-off rule"
skipI: "Interpreter-wide / step dispatch\nTclCheckInterpTraces sees I=1\nDispatch suppressed for this interval"
b: "Different command direct trace B\nDirect loop has no interpreter I check\nB may enter; saves I=1 and sets B busy"
mutation: "Admitted cancellation operation\nInstall / consume / owned reset changes CancelCell\nTrace snapshots have no cancellation write authority"
exitB: "B restores its saved legacy projection\nI remains 1 while A is active\nCancelCell is untouched by this restore"
exitA: "A later restores its prior legacy projection\nI returns to 0 at the original source point\nOther admitted cleanup and actual return still required"
a -> routes
routes -> skipA
routes -> skipI
routes -> b -> mutation -> exitB -> exitA
skipA.style.fill: "#FFF0E5"
skipI.style.fill: "#FFF0E5"
mutation.style.fill: "#DFEEFF"
exitA.style.fill: "#E8F4E8"
