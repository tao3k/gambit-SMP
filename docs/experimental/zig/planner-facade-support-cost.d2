direction: down
scope: "Same necessary requests\nFrameSpec -> DescriptorDecision or Diagnostic\nPhysicalPlan -> OwnedArtifact or Diagnostic\nSame target, provider, transport and runtime obligations"
pair: {
  label: "Fair implementation controls"
  c: "C-G / C-ZT\nChecked builtins or reused helpers\nOpaque/generated results + one cleanup path\nC-ZT uses the same selected Zig driver"
  z: "Z1\nSelected standard helpers + private typed results\nOrdinary propagation and scope cleanup\nC-facing normalization and explicit owners retained"
}
possible: "Conditional project support savings\nPS01 checked primitive body / PS03 association\nPS04 propagation wiring / PS05 growth implementation\nNo duplicate credit per type, field or exit"
retained: "Necessary common work\nTarget layout laws / rich diagnostics and public statuses\nFailure outputs / resource transfer / session and GC-control\nIndependent runtime/provider qualification"
cost: "Incremental cost against the chosen control\nMigration + residual helper/facade work\nSelected Zig language / stdlib / C translation upgrades\nShared provider and Zig-driver work charged once"
gate: "Positive only with justified avoided-work bounds\nexceeding all differential costs\nSmall fixed-width C shim is a nonpositive countermodel\nTG5 open; no implementation or native tests" {
  style.fill: "#fff0ce"
}
scope -> pair.c
scope -> pair.z
pair.c -> possible
pair.z -> possible
pair.c -> retained
pair.z -> retained
possible -> gate
retained -> cost
cost -> gate
