direction: down
semantic: "Scheme semantic issuer\nForeignPlan effects + G3 live roots / control / return origin\nCurrent frame / object / GC protocols retained"
conditions: "Independent runtime conditions\nV VM live; E exclusive processor execution\nR discoverable/updateable roots; S backing storage live\nP collective participation\nNo single TLS/refcount/lease proves all five"
runtime: "One Gambit runtime contract\nRoot scope/store/load and native borrow rules\nConfigured VM selector + callback/control shell\nWait mode + admission/drain + scanner/reader lifetime"
roots: "Existing root mechanisms\nFrames / register writeback / RA / saved state\nRC data slot and actual scan cohort\nStill objects and VM-private cells\nReload moved values; do not scan arbitrary native payload"
adapters: {
  label: "Matched native implementation alternatives"
  c: "Modern C-G / C-ZT\nOpaque/generated operations + existing runtime primitives\nSame collector/member/control laws"
  z: "Zig\nPrivate typed products / propagation / native helpers\nSame root/runtime/control obligations\nRetain qualified C shell where needed"
}
targets: "Selected consumers\nAlready-owned callbacks and BW1 waits first\nNJS gateway and future LLVM products under same contract\nArbitrary attachment / BW2 / cross-VM switching separate"
gate: "Shared modernization versus language increment\nNo current defect/GC speedup inferred from TODO or source branch\nNo implementation, native tests or positive cost bound" {
  style.fill: "#fff0ce"
}
semantic -> conditions
conditions -> runtime
roots -> runtime
runtime -> adapters.c
runtime -> adapters.z
adapters.c -> targets
adapters.z -> targets
targets -> gate
