direction: down
classes: {
  semantic: {style.fill: "#e6f2ff"}
  native: {style.fill: "#eaf5e6"}
  provider: {style.fill: "#eee9ff"}
  gate: {style.fill: "#fff0ce"}
}
scheme: "Gambit semantic authority\nBindings / evaluation / effects / foreign plans\nImmutable identities, source and profile" {class: semantic}
high: "High semantic route\nPre-normalization closure / mutation / capture\nAdmitted higher-order / escape / lifetime analyses" {class: semantic}
gvm: "GVM + Scheme G3 completion\nHostGraph / FrameSpec / PointId\nRoots, checks, runtime roles and control explicit" {class: semantic}
plane: "Zig compiler/system service process (proposed)\nPhysical realization + provider sessions\nFFI/module products, resources, diagnostics, artifacts\nOne resolved profile; no duplicate semantic issuer" {class: native}
mlir: "Admitted MLIR service\nCustom semantics + lawful transforms\nC APIs / callbacks and bounded provider support" {class: provider}
llvm: "LLVM / target service\nMachine code, registers, objects, selected LTO/debug\nSame provider access available to modern C control" {class: provider}
product: "NativeProduct\nObject + constants/fixups + frame/root/role/debug maps\nProfile/version identity + module instance plan" {class: native}
runtime: "SharedRuntimeContract + in-process runtime SDK\nGambit values / continuations / roots / context / VM\nC or justified Zig mechanism implementations\nSeparate raw-C nonlocal-control island" {class: semantic}
controls: "Bmin = repair control\nC-full = same complete architecture in modern C\nZ-full = complete Zig-owned native plane\nNo implementation or adoption qualification" {class: gate}
scheme -> high
scheme -> gvm
high -> plane: "explicit semantic/control product"
gvm -> plane
plane -> mlir
mlir -> llvm: "admitted lowering + translation"
plane -> llvm: "direct LLVM route"
llvm -> product
product -> runtime: "validated bind / instantiate / retain"
runtime -> plane: "protocol / layout / effect requirements"
controls -> plane: "fair scope and cost comparisons"
