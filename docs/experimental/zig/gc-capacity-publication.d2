title: "GC public capacity result\nConditional publication / no native qualification" {shape: text}
selected: "GCO01 / freeze exact demand membership\nOperation + epoch + represented RequestIds\nChecked D and reserved records / credits / users" {class: proposed}
title -> selected: {style.opacity: 0}
policy: "GCU02--03 / source mechanisms\nTrace / weak / cleanup then heap policy\nActual section growth + still demand charge\nLater native allocation can still fail / refund" {class: actual}
selected -> policy
budget: "GCO02--03 / HeapBudgetDecision\nActual allocator revision / grant or deny / reserve\nPublish immutable decision under G\nThis is not terminal GC or resume success" {class: proposed}
policy -> budget
prepare: "GCO04 / owner preparation outside gates\nActual stack / heap intervals / fudge\nSafe error-delivery state + relocated roots\nReport real writes / failure, not just observation" {class: proposed}
budget -> prepare
outcome: "GCO05 / one protected G commit\nAll required phases / reports settled\nGCCapacityOutcome + prepared BatchResultMap\nGranted / safe denial / retained unknown" {class: proposed}
