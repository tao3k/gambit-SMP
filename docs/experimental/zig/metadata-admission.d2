direction: down
classes: {
  source: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
}
producer: "Gambit-owned metadata\nSemantic link combines LD / package records\nPreserve module order; do not invent CC aggregation" {class: source}
record: "Source-bound record\nUnit digest + field + ordinal + encoding\nLiteral string or when(predicate, string)" {class: proposed}
producer -> record
features: "Configured feature set\nKnown: unix windows gcc clang visualc cc\nSelected here: unix gcc\nDarwin is not a feature label" {class: source}
gate: "Validate canonical metadata\nand / or / not / when; exact arities and escapes\nSingle legacy metadata source or none\nReject unsupported syntax before effects" {class: gate}
record -> gate
features -> gate
refuse: "Managed rejection\nUnknown feature / malformed serialization\nNot silent false or legacy warning-and-ignore" {class: gate}
gate -> refuse: "unsupported"
select: "Select or suppress in record order\nTrace decision and feature identity\nDecode admitted payload words" {class: proposed}
gate -> select: "supported"
paths: "Search environment\nAmbient baseline; metadata then explicit paths\nPrepend each: last added has priority" {class: proposed}
select -> paths
queries: "Package actions\nMetadata then explicit requests\nFor each: cflags, then libs, even in obj\nBind outputs, diagnostics, status and dependencies" {class: proposed}
paths -> queries
failure: "Resolution failure\nThis retained profile has empty PKG_CONFIG\nDo not discover a substitute host tool\nNo compiler or successful HIT" {class: gate}
queries -> failure: "requested but unavailable / failed"
segments: "Mode-specific ordered segments\nCC = package + metadata + explicit\nPrelude = metadata + explicit\nTail = package + metadata + explicit" {class: proposed}
queries -> segments: "resolved or no package requests"
plan: "Sealed native plan\nPer-mode positions, source/path roles and effects\nRuntime loading / GC / control stay Gambit-owned" {class: proposed}
segments -> plan
note: "DESIGN ONLY. Typed metadata emission and parity checks remain open (M5-M8).\nExisting Darwin literal substitution still ends in eval; no legacy path is retired." {shape: text; style.font-size: 15}
plan -> note: {style.opacity: 0}
