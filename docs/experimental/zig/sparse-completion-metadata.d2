direction: down
classes: {
  actual: {style.fill: "#e8f1fb"; style.stroke: "#346a98"}
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  boundary: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "Sparse layout / static plan and actual completion\nShared contract for generated modern C and Zig" {shape: text}
static: "ABO01--02 / immutable AllocationPlan\nScheme semantic points / InitSpec / root and frame meaning\nTarget ordered costs / summaries / alignment / LayoutRecipes\nBound to actual emitted code and native profile" {class: proposed}
title -> static: {style.opacity: 0}
bind: "ABO03--04 / ActualSpanBinding\nReal section/reuse/half/interval and epoch\nExclusive writer / input roots / pending placement\nH heap rights, C root custody, G epoch/resume\nNo nested gates or callback/wait inside gates" {class: proposed}
static -> bind
write: "ABO05 / real producer stores\nDenseRun: qualified complete header/filler grammar\nSparseRun: actual object/gap recipe or explicit extents\nDirty box events have version and representation\nPartial/escaped effects keep explicit exceptions" {class: proposed}
bind -> write
commit: "ABO06 / prepared completion report\nWrites precede actual layout/root publication\nH -> C -> G gaps retain held writer/VM/user pins\nOne prevalidated commit handle, no perobject gate loop\nPlanId copy cannot issue completion authority" {class: proposed}
write -> commit
freeze: "ABO07 / next-GC freeze\nSettle actual writers / pending placements first\nUse committed object extents, including used trigger reserve\nRoot-driven trace into prefix and context suffix\nGaps and native plan fields are not Scheme roots" {class: proposed}
commit -> freeze
consume: "ABM08 / separate consumers\nSource locator / new destination-work scanner\nPhysical / allocated / live / policy / context counters\nDiagnostic walkers require actual sparse grammar" {class: proposed}
freeze -> consume
retire: "ABO08 / actual last-user retirement\nCode / plans / roots / layout / native / resolvers\nKnown private abort only reclaims proved top suffix\nUnknown effects never authorize timeout rollback\nObject-start index and retention costs remain explicit" {class: boundary}
consume -> retire
