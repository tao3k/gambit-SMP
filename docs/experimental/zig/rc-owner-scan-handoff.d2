direction: down
classes: {
  reuse: {style.fill: "#e6f2ff"}
  design: {style.fill: "#eaf5e6"}
  gap: {style.fill: "#fff0ce"}
}
register: "Existing same-owner RC allocation\nInitialize / register / publish valid data\nOne current custodian, same VM" {class: reuse}
active: "B1 candidate already scans each processor RC list\nmark_array updates header.data; payload bytes not traced\nRoot phases and native writer exclusion must compose" {class: reuse}
close: "Retirement closes new use\nReturn origins / mutators / scanner and queue borrowers\nMust establish quiescent handoff interval" {class: design}
join: "Join / donor completion" {shape: diamond}
transfer: "Existing successful candidate path\nSplice RC + still lists into survivor under MISC lock\nEmpty donor -> memory cleanup\nLock alone does not cover all native RC writers" {class: reuse}
receiver: "Successor custodian\nSame carrier address; updated managed data\nSurvivor GC enumerates list; legal native release" {class: reuse}
pending: "Failed / unconfirmed join\nStorage and pending-join record retained\nSmaller active count does not establish root coverage" {class: gap}
policy: "RQ03 design gate\nNo ordinary allocating resumption across missing custodian\nOR a complete drained-carrier scan/recovery protocol\nRecovery itself must preserve roots" {class: gap}
terminal: "VM cleanup needs all actual last users gone\ncleanup_rc ignores remaining native refcounts\nNative refcount is not a VM lifetime lease" {class: design}
register -> active
active -> close
close -> join
join -> transfer: "successful + all premises"
transfer -> receiver
join -> pending: "failure / unknown"
pending -> policy
policy -> receiver: "only after complete custody recovery"
receiver -> terminal
