direction: down
classes: {
  retained: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  contract: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
language: "Gerbil / Gambit semantic producers\nHigh-level facts / FFI / effects / control\nSemantic export and private runtime contract versions" {class: retained}
boundary: "Project-owned compiler request / result boundary\nExport version + required output role + target/runtime profile\nCapability check + approved pipeline identity\nNo MLIR handle or C++ type crosses this boundary" {class: contract}
language -> boundary
system: "Proposed Zig system implementation\nEffective native plan / provider selection\nNative resource, process, diagnostic and artifact ownership" {class: proposed}
boundary -> system
llvm: "Pinned MLIR / LLVM service\nDialect semantics + lowering policy + provider revision\nC++ / ODS / native extensions remain internal" {class: proposed}
system -> llvm
reuse: "UPSTREAM ENGINEERING REUSE\nPass / analysis management and conversion framework\nDiagnostics / IR tooling / failure reproduction\nLLVM target code-generation infrastructure" {class: proposed}
reuse -> llvm: "infrastructure under admitted semantics"
output: "Versioned result roles\nC-ABI companion OR full Gambit protocol object\nExact provider / dialect / policy / target identities" {class: contract}
llvm -> output
runtime: "Gambit compatibility and runtime admission\nFrames, roots, continuation and module semantics stay owned\nNo automatic general Scheme backend from C API access" {class: retained}
output -> runtime
upgrade: "Provider-only upgrade, IF export/output contracts stay compatible\nChange/requalify service and affected derived products\nUnrelated C route and semantic products need not regenerate solely for it\nRuntime/dialect changes have wider declared propagation" {class: contract}
runtime -> upgrade
note: "The dividend is reusable engineering and bounded change propagation.\nZig implements the project boundary; the boundary is defined by contracts.\nNo automatic semantic equivalence, startup speedup or upgrade-without-tests claim." {shape: text; style.font-size: 15}
upgrade -> note: {style.opacity: 0}
