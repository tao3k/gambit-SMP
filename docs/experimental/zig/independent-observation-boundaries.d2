direction: down
classes: {
  retained: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
}
inputs: "Pinned old/new context\nSources, generated profile, tools and runtime\nSame source bytes, visible paths, env and cwd" {class: retained}
old: "Old producer and driver\nB1 before transport / B2 Scheme child launch\nB3 package actions and tty diagnostics\nB4 after shell eval or direct native invoke" {class: retained}
new: "Managed candidate\nTyped intent + one resolver + direct executor\nRecord final tool/query child context\nDo not use new renderer as old-arm oracle" {class: proposed}
inputs -> old
inputs -> new
lanes: "Independent evidence lanes" {
  fixture: "L1 derived construction fixture\nPinned leaf-slot substitution and native recorder\nActual argv bytes after legacy shell parsing\nChanged tool profile; no original-native claim" {class: proposed}
  native: "L2 original native witness\nUnmodified driver + actual configured tools\nFull argv / env / cwd / status coverage required\nAcquisition capability still unqualified" {class: gate}
}
old -> lanes.fixture
old -> lanes.native
compare: "Independent comparison\nSource invariants + framed raw records\nExact leaf context and causal action order\nNegative controls must detect dropped/reordered facts" {class: gate}
lanes.fixture -> compare
lanes.native -> compare
new -> compare
runtime: "L3 uninstrumented native acceptance\nArtifacts / symbols / modules / FFI / GC / control\nNot exact argv evidence by itself" {class: retained}
inputs -> runtime
outcome: "Scoped outcome\nConstruction match / original-native match\nExpected rejection / mismatch / invalid / unresolved\nMissing coverage is never a pass" {class: gate}
compare -> outcome
runtime -> outcome
note: "DESIGN ONLY. No observer, fixture or native run was created.\nL1 plus L3 cannot replace missing L2 fields; no performance claim." {shape: text; style.font-size: 15}
outcome -> note: {style.opacity: 0}
