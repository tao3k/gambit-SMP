direction: down
classes: {
  retained: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  contract: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
producer: "Gerbil producer: already expanded module metadata\nEmit ordered interface-construction program\nDo not execute future consumer initialization" {class: proposed}
artifact: "REUSABLE artifact\nCode + symbolic imports + phase/effect contract\nSource origins + compatibility manifest\nNo previous context or initialized values" {class: proposed}
producer -> artifact
zig: "Zig: native build / packaging / compatibility\nGambit native compilation or optional MLIR service\nMLIR legality must preserve effects and identity" {class: proposed}
artifact -> zig: "compile / package ahead of launch"
loader: "Current Gerbil loader\nValidate code; consult current instance registry\nExisting cached instance retains its identity" {class: retained}
zig -> loader
current: "Current dependencies / phases / marks / parameters\nLive predicates and handlers can mutate bindings" {class: contract}
current -> loader
first: "When NEW instance is required\nFresh contexts, binding cells, retained mutable import records\nExecute ordered first-stage effects\nSource expansion cycle errors; publish only after expansion" {class: retained}
loader -> first: "instantiate code against current state"
second: "Finish module-body stage\nExpressions and deferred exports use resulting context\nReturn context-correct expanded syntax + atomic promise" {class: retained}
first -> second
runtime: "Gambit owns GC / control / rooted Scheme objects\nNo Zig arena lifetime for live context graphs" {class: retained}
runtime -> first: "runtime protocol" {style.stroke-dash: 3}
ceiling: "Benefit ceiling\nAvoid only replaced reading / generic interpretation\nRequired live effects remain; extra load / validation costs count\nNo supported seconds or speedup forecast" {class: contract}
second -> ceiling
note: "DESIGN ONLY. Sealed syntax is a handoff representation, not proof of completed effects.\nFallback must not replay partially executed initialization." {shape: text; style.font-size: 15}
ceiling -> note: {style.opacity: 0}
