direction: down
product: "Immutable module product\nmap + helpers + globals / constants / FFI\nsemantic points -> derived table positions"
prepare: "Prepared instance\nowned relocation storage / VM bindings\nno executable publication"
validate: "Validate target / layout / imports\nwhole admitted _std cohort"
relocate: "Relocate labels / constants / globals\nrecord concrete code and root readers"
register: "Registered\ncode/maps visible before executable entries"
setup: "Native setup complete\nsetup_mod success is a distinct event"
init: "Scheme initializing\nordered / reentrant / import-cycle policy"
active: "Active module instance"
product -> prepare
prepare -> validate
validate -> relocate
relocate -> register
register -> setup
setup -> init
init -> active
privatefail: "Failure before publication\nowner retains and frees unpublished state"
validate -> privatefail
relocate -> privatefail
retainedfail: "Failure after publication\nretain code / roots / readers\nwithdraw only at an acknowledged cut"
register -> retainedfail
setup -> retainedfail
effects: "Initialization failure / escape\nrecord partial external effects\nno universal rollback or blind retry"
init -> effects
users: "Actual users\nprocedures / captured frames / contexts\nforeign callbacks / tasks / scanning readers"
active -> users
retire: "Reject new entries -> settle transfers\nlast-user proof -> unregister -> free"
users -> retire
retainedfail -> retire
effects -> retire
