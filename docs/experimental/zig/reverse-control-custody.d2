direction: right
classes: {
  design: {style.fill: "#ede9fe"; style.stroke: "#7c3aed"}
  open: {style.fill: "#ffedd5"; style.stroke: "#c2410c"}
}
entry: "Entry\narity + wrapper + poll" {class: design}
loop: "Loop\noptional force / pair test" {class: design}
cons: "Complete pair\nread car / cons / read cdr\nno safepoint inside" {class: design}
check: "Post-cons check\norig / next / acc / control" {class: design}
service: "Slow service\nspill + hold roots / GC or rebase" {class: design}
resume: "Resume\nreload roots + allocation binding\nthen poll" {class: design}
terminal: "Terminal\nnull or bad initial / dotted tail" {class: design}
dispatch: "Disposition to outer dispatcher\nreturn or tail failure service" {class: design}
admit: "Required\nactual 3-word headroom\ncomplete maps + control ABI" {class: open}
entry -> loop
loop -> cons: "pair"
cons -> check
check -> resume: "fast"
check -> service: "slow"
service -> resume: "normal completion only"
resume -> loop
loop -> terminal: "non-pair"
terminal -> dispatch
service -> dispatch: "exception / control"
admit -> check: "conditional obligation"
