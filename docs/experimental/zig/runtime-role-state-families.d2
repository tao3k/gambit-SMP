direction: down
classes: {
  scheme: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  transition: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
  runtime: {style.fill: "#E7F4E8"; style.stroke: "#397344"}
}
manifest: "15 declared roles from setup_kernel_handlers\nActual body / post-thunk anchors, not C ordinals\nSource identity and exact signatures in research DSL" {class: scheme}
errors: "Call / conversion failures\nR01 sfun-conv-error; R02 cfun-conv-error\nR05 not-proc; R06 not-proc-glo; R07 wrong-nargs\nTyped scratch payload; original continuation retained" {class: transition}
internal: "Private internal checks and force\nR03 stack-limit; R04 heap-limit; R11 force\nIPRE -> all-register IFULL -> PUBLISHED" {class: runtime}
params: "Parameter adaptation\nR08 get-rest; R09 get-key; R10 get-key-rest\nCALL -> ARGPART; no collection until packaging" {class: transition}
markers: "Special continuation boundaries\nR12 return-to-c: marker frame / matching catcher\nR13 break: stack or heap caller frame\nR15 denv return: saved old-denv field + frame link" {class: runtime}
manifest -> errors
manifest -> internal
manifest -> params
manifest -> markers
ret: "R14 internal-return marker\nActual private RETI RA is stored in the expanded frame\nRestore registers / result carrier -> private point\nThe marker's label metadata is not the private map" {class: runtime}
internal -> ret
gates: "Common product and independent qualification\nNamed frame features + one FrameLayout\nRoots / bounds / exceptions / capture / host edges still open\nSource-traceable is not native-admitted" {class: scheme}
errors -> gates
ret -> gates
params -> gates
markers -> gates
