direction: down
classes: {
  retained: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  contract: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
existing: "EXISTING PATH" {
  direction: down
  style.fill: "#FAFBFC"
  style.stroke: "#B3BDC7"
  gerbil: "Gerbil compiler driver\nTools / option splits / platform branches\nPhase and Scheme semantics" {class: retained}
  gambit: "Gambit generation + native request\nModule/FFI/link semantics\nGAMBUILD environment parameters" {class: retained}
  shell: "Configured gambuild-C\nMetadata + pkg-config + flags\nMode defaults / command-template evaluation" {class: retained}
  native: "Configured native compiler / linker\nObjects, dynamic bundles, libraries" {class: retained}
  runtime: "Gambit mapping / setup / initialization\nVersion and size checks\nHandle retirement / GC / control" {class: retained}
  gerbil -> gambit
  gambit -> shell
  shell -> native
  native -> runtime
}
managed: "PROPOSED MANAGED SYSTEM PROFILE" {
  direction: down
  style.fill: "#FAFBFC"
  style.stroke: "#B3BDC7"
  core: "Gerbil / Gambit producers\nSemantic units, interfaces, phases, high-level IR\nRuntime/FFI/module meaning remains authoritative" {class: retained}
  request: "Project-owned data contracts\nSemantic product + native intent + compatibility\nOne authoritative configuration producer" {class: contract}
  zig: "Substantial Zig native subsystem\nReplace selected legacy reconstruction\nResolve requests / resources / artifacts / services\nNative algorithms, provider integration and diagnostics" {class: proposed}
  tools: "Native construction route\nConfigured GCC or other admitted toolchain\nPreserve C assets and target requirements" {class: proposed}
  mlir: "Optional separate MLIR / LLVM service\nPrivate C++ / ODS / pass implementation\nVersioned capabilities and result roles" {class: proposed}
  product: "Completed native outputs + manifest\nContent / target / protocol / pipeline identities\nNo live initialized Scheme context" {class: contract}
  runtime: "Gambit preflight + original runtime admission\nMapping, fixup and initialization\nGC / control / runtime retirement stay here" {class: retained}
  provider: "Optional Zig native providers / host adapters\nOrdinary-return C contract and native-owned data\nNo implicit Scheme heap / callback authority" {class: proposed}
  core -> request
  request -> zig
  zig -> tools
  zig -> mlir
  tools -> product
  mlir -> product
  product -> runtime
  provider -> runtime: "Gambit-owned adapter" {style.stroke-dash: 3}
}
note: "DESIGN ONLY. Contracts and work elimination are language-independent.\nZig adoption needs incremental value over the same architecture using existing tools.\nNo runtime repair or startup acceleration follows from changing the system language." {shape: text; style.font-size: 15}
existing.runtime -> note: {style.opacity: 0}
managed.runtime -> note: {style.opacity: 0}
