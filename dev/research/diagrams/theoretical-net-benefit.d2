direction: down
source: "Source correspondence\nExisting work + constraints + exact identities\nNo net-benefit conclusion from coverage alone"
theory: {
  label: "Theoretical argument before empirical work"
  goals: "Required capabilities + same-scope alternatives\nB0 / B1 modern C / Z1 Zig / provider choice"
  shared: "TB01-TB05 shared modernization\nRemoved work - added work\nCredible positive domain + semantic design"
  zig: "TB06 Zig increment over B1\nZig-specific avoided work - added ownership cost\nShared gains cannot be counted again"
  goals -> shared
  goals -> zig
}
gate: "Theory review gate\nCurrent: positive Zig increment remains open\nNo small empirical test authorized by this argument" {
  style.fill: "#fff0ce"
}
test: "Later scoped empirical test\nNamed falsifiable prediction + controls + fixed scope\nObserved parameter is not whole-system value"
adoption: "Later implementation and adoption qualification\nNative semantics + supported profiles + full observed costs\nRequired portfolio goals must be met"
revise: "Failed assumption or contrary evidence\nRevise theory and preserve prior record"
source -> theory.goals
theory.shared -> gate
theory.zig -> gate
gate -> test: "only after adequate theory + applicable authorization" {style.stroke-dash: 5}
test -> adoption: "independent qualification still required" {style.stroke-dash: 5}
test -> revise: "falsifies premise" {style.stroke-dash: 5}
revise -> theory.goals: "new argument revision" {style.stroke-dash: 5}
