direction: down
active: "Owned active entry\nVM/processor/roots/storage/participation established\nComplete transitive foreign effects"
mode: "Choose admitted wait mode" {
  shape: diamond
}
bw1: "BW1 current participating wait\nSave RA + W_ALL; keep valid member/return owner\nAbort/wakeup -> legal service path -> R_ALL + RA reload\nNo generic GC execution inside arbitrary lock wait"
prepare: "BW2 future preparation\nNative input copies + complete saved roots\nRoot carrier remains live and independently enumerable\nRequest/member transition must be acknowledged"
native: "Native-only phase\nNo Scheme data access or callbacks\nReserve original processor/return origin\nNot permission for another host to mutate it"
reentry: "Reentry pending\nValidate live VM and coherent processor/member authority\nService pending operations at legal safepoint\nReload roots/state; then allocating result conversion"
done: "Owned return or explicit failed-reentry custody\nNative cleanup survives errors/nonlocal control\nNo cached VM pointer reuse or automatic retry"
gate: "BW2 remains unimplemented / unresolved\nNo processor-count decrement or unlock shortcut\nExisting BW1 mechanisms retained; no native tests" {
  style.fill: "#fff0ce"
}
active -> mode
mode -> bw1: "supported existing scope"
mode -> prepare: "new demand / separate design"
prepare -> native
native -> reentry
bw1 -> done
reentry -> done
prepare -> gate
done -> gate
