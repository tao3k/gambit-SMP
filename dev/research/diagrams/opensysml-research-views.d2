direction: down
classes: {
  source: {style.fill: "#e6f2ff"}
  model: {style.fill: "#eaf5e6"}
  gate: {style.fill: "#fff0ce"}
}
source: "Source / profile / papers\nCurrent facts and constraints\nExact identities; proposals kept separate" {class: source}
model: "SysML v2 architecture draft\nOwners / interfaces / CT lifecycle\nFull C and Zig alternatives / analytic conditions" {class: model}
mapping: "Reviewed project-ID mapping\nModel digest / element / claim / scope\nProposed extraction; no adapter implemented" {class: model}
research: "Existing Scheme / ASCENT interface\nClaims / citations / dependencies / open gates\nHistorical witnesses retain evidence classes" {class: source}
views: "D2 and matrices\nReadable projections\nNo independent acceptance authority" {class: model}
formal: "Future qualified model analysis\nSelected constraints / schedules / refinements\nAssumptions, unsupported cases and budgets explicit" {class: gate}
native: "Separate future native qualification\nGC / ABI / nonlocal exits / concurrency / cost\nNo model pass can replace this evidence" {class: gate}
decision: "Two independent theory decisions\nTotal modernization vs B0\nZig increment vs equal-capability C-full\nBoth currently unresolved" {class: gate}
admission: "Later adoption / native release gate\nTheory closure plus independent native evidence\nNo execution authorized by this design" {class: gate}
source -> model: "constrains design"
model -> mapping
mapping -> research: "reviewed links only"
model -> views
model -> formal: "future qualification"
research -> decision: "premises / gaps / contradictions"
formal -> decision: "model-scoped results only"
decision -> admission: "theory is necessary"
native -> admission: "separate native evidence"
