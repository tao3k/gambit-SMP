direction: down
classes: {
  source: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
}
legacy: "Legacy inputs: distinct encodings" {
  config: "Generated .unix bindings\nKnown assignment and template references" {class: source}
  options: "Gambit string / LF-joined list\nMetadata payload / package result\nEarly split and glob, then final eval" {class: source}
  paths: "Legacy filenames\nEarly splitting before shell_quote\nEmpty / LF boundaries can be lost" {class: source}
  direct: "Gerbil direct-link LD strings\nSplit only literal spaces\nQuotes remain literal" {class: source}
}
proof: "Source-specific inert decoding gate\nEncoding ID + raw digest + provenance\nPreconditions, ordered words and presence\nNo shell execution to discover meaning" {class: gate}
legacy.config -> proof
legacy.options -> proof
legacy.paths -> proof
legacy.direct -> proof
reject: "Reject managed admission\nExpansion / glob / unsupported syntax\nLossy boundaries / unknown profile\nNo hidden fallback after effects" {class: gate}
proof -> reject: "outside selected subset"
producer: "New typed producer records\nLiteral argv / typed fields / source identity\nRicher paths are an explicit extension" {class: proposed}
plan: "One effective native plan\nExact argv + environment + cwd\nPer-mode order and tool/runtime identities\nDecoder changes invalidate dependent plans" {class: proposed}
proof -> plan: "admitted legacy subset"
producer -> plan
exec: "Direct native executor\nNo LF protocol / gambuild-C / shell eval\nGambit retains semantic and runtime authority" {class: proposed}
plan -> exec
note: "DESIGN ONLY: no decoder or native profile is implemented or qualified.\nA generic shlex parse does not model the old multi-stage behavior." {shape: text; style.font-size: 15}
exec -> note: {style.opacity: 0}
