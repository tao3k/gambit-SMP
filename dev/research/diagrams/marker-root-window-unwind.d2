direction: down
classes: {
  reuse: {style.fill: "#e6f2ff"}
  design: {style.fill: "#eaf5e6"}
  gap: {style.fill: "#fff0ce"}
}
entry: "RC-C7: static SFUN / direct run / enabled dynamic target\nSame host, processor, VM and return origin\nInputs and target have separate root contracts" {class: design}
select: "Choose actual target strategy" {shape: diamond}
scratch: "MP1 short saved0 window\nReservation established before catch region\nGC_SAVE1 -> marker allocation may GC\nNo overlapping clobber / reentry" {class: reuse}
rc: "MP2 retained target\nCapture invocation carrier before effects\nRegistered + scanned + live through last data read" {class: design}
install: "Normal constructor return\nReload current target -> initialize marker\nClear owned scratch before later converters / call\nCandidate clear-before-store requires no-GC gap" {class: reuse}
throw: "Constructor error / nonlocal transfer\nClear only acquired scratch; no undefined marker kill\nRestore previous catcher; rethrow original destination\nDirect run included, without inventing SFUN lease" {class: design}
nested: "A conversion / call can enter B\nA target already carried by live marker\nB can reuse saved0 if its own short window is admitted\nNested depth does not imply overlapping scratch" {class: design}
exit: "Close B then resume A, or propagate outer destination\nMarker / native resources / frame lease / catcher\nUse supported C control region; no Zig defer shortcut" {class: design}
gap: "RQ04 / RQ05 remain open\nActual scratch reservation and full effect closure\nBusy or overlapping slots need another admitted strategy\nTarget guard alone does not root all parameters" {class: gap}
entry -> select
select -> scratch: "direct managed target"
select -> rc: "existing retained target"
scratch -> install: "normal"
scratch -> throw: "allocation throw / error"
rc -> install: "reload same carrier"
install -> nested
nested -> exit
throw -> exit: "preserve control semantics"
scratch -> gap
nested -> gap
