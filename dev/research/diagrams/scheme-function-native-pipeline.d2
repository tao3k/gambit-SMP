direction: right
classes: {
  source: {style.fill: "#dbeafe"; style.stroke: "#2563eb"}
  design: {style.fill: "#ede9fe"; style.stroke: "#7c3aed"}
  open: {style.fill: "#ffedd5"; style.stroke: "#c2410c"}
}
input: "Real public reverse\nlist.scm 397-403" {class: source}
scheme: "Scheme expansion + normalization\nGVM + semantic lineage" {class: source}
complete: "Proposed semantic completion\ncontrol / roots / InitSpec / B" {class: design}
plan: "Common physical product\nframes / points / modules" {class: design}
zig: "Generated Zig hosts\nlocal loop + dispatch exits" {class: design}
modernc: "Equally modern C provider\nsame semantic contract" {class: design}
llvm: "Independent MLIR / LLVM\nearly semantic export" {class: design}
bind: "Runtime image + VM binding\nroot / link / initialize / publish" {class: design}
gate: "Unresolved admission\ncontrol / GC / users / net cost" {class: open}
input -> scheme -> complete -> plan
plan -> zig -> bind
plan -> modernc -> bind
scheme -> llvm: "before erased semantics"
llvm -> plan: "lawful runtime lowering"
bind -> gate
