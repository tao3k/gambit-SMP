direction: down
classes: {
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  boundary: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "Resize agreement is stage + role agreement\nDecisionObserved differs from ActionSettled" {shape: text}
guard: "GRB01 / common guard snapshot\nOld topology / allocator revision / target U / frozen W\nPublish NeedChildCollect; no independent branch" {class: proposed}
title -> guard: {style.opacity: 0}
child: "GRB02--03 / optional child GC\nOld context/root/storage cohort; parent admission\nChild ran: acquire common terminal outcome\nNo child: matching NoChildRequired stage\nQueued GC requests remain pending" {class: proposed}
guard -> child
prepare: "GRB05 / prepare native contexts and roots\nDesignated setup actors outside gates\nActual reports / rooted startup data / capacity\nAdvance only after required actions settle" {class: proposed}
child -> prepare: "known budget / valid continuation"
denied: "GRB04 / denial before topology commit\nOne coherent error path; designated hint rollback\nRetain actual post-GC heap / roots / resume state\nNever restore old relocated pointers" {class: boundary}
child -> denied: "known denial + safe delivery"
cut: "GRB06 / nonmoving membership cut\nPublish new topology and next role roster\nOld roles have explicit terminal/custody duties\nNo exited actor in future quorum" {class: proposed}
prepare -> cut
startup: "GRB07 / startup and retirement\nCreation / Scheme-ready / helper / join facts differ\nKeep actors required for startup GC\nUnknown or failed join retains real obligations" {class: proposed}
cut -> startup
result: "GRB08 / parent result publication\nActual topology + pending retirement disposition\nError after commit need not mean unchanged\nOnly represented resize request completes" {class: boundary}
startup -> result
stage: "Each checkpoint\nAcquire matching StageId + epoch + role action\nPerform outside G / T / C / L\nReport ActionSettled before coordinator advance\nNo timeout invents a departed participant" {class: boundary}
stage -> cut: "required protocol / no native proof"
