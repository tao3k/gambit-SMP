direction: down
classes: {
  retained: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  contract: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
artifact: "Independent artifact axis\nCompatible code may be available\nNo live context or completed initializer implied" {class: proposed}
request: "Current import hook / original registry rules\nReload flag and request aliases remain observable" {class: retained}
artifact -> request: "admitted representation"
cached: "Existing context HIT\nReturn original identity\nMay later demand its evaluation" {class: retained}
request -> cached: "original cache HIT"
source: "Uncached source attempt\nNormalize path; test active expansion path\nSet original dynamic parameters; resolve prelude" {class: retained}
request -> source: "no eligible HIT / reload"
cycle: "Active uncached path\nRaise Cyclic expansion\nNo new initializing placeholder" {class: contract}
source -> cycle: "cycle"
first: "Fresh context: first stage\nLive dispatch / imports / bindings / properties / phase execution\nKeep original ordering and lexical identity" {class: retained}
source -> first: "enter expansion"
second: "Second stage\nExpand expressions and deferred exports\nUse current context and original traversal" {class: retained}
first -> second
publish: "Expansion complete\nInstall current code + atomic promise\nThen original path/id registry puts and aliases" {class: retained}
second -> publish
failed: "Expansion exits exceptionally\nNo new source-context publication before registry writes\nPrior external effects and old reload entry remain\nNo whole-interface fallback replay" {class: contract}
first -> failed: "exception / escape" {style.stroke-dash: 3}
second -> failed: "exception / escape" {style.stroke-dash: 3}
pending: "Independent evaluation axis: pending\nContext exists; module body need not have run" {class: retained}
publish -> pending
cached -> pending: "only if still pending"
forcing: "Demand through original eval hook\nPrelude first; current ctx / phi 0\nOriginal promise mutex + dynamic-wind" {class: retained}
pending -> forcing
done: "Successful force determines value\nLater demand uses original memoization" {class: retained}
forcing -> done: "normal result"
exit: "Exception / nonlocal exit\nOriginal unwind and promise state remain\nLater demand follows that state\nNo new terminal cached-error policy" {class: contract}
forcing -> exit: "no successful-result write"
guard: "Continuation reentry into protected extent\nOriginal once guard raises\nNot equivalent to forbidding all later force calls" {class: contract}
forcing -> guard: "continuation reentry" {style.stroke-dash: 3}
note: "SOURCE-BOUND DESIGN, NOT A NEW LOADER IMPLEMENTATION.\nRegistry identity is path / ID / aliases; phase contexts are separate.\nRuntime demand cycles retain original promise behavior. No generic SCC executor or rollback." {shape: text; style.font-size: 15}
done -> note: {style.opacity: 0}
