direction: down
classes: {
  source: {style.fill: "#e8f1fb"; style.stroke: "#346a98"}
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  gate: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "RC payload handoff: storage, roots and release authority\nConditional design; no implementation or native qualification" {shape: text}
source: "Actual source / one source RC list\nTLS context + up to five RC strings\nOther RC products may carry Scheme data roots\nRaw device parent uses different native allocation" {class: source}
prepare: "RCO01--04 / source still owns storage\nCount R and pin target + source / HandoffRecord\nClose or route aliases; drain borrowers / scanners\nReserve nested closure and task capacity" {class: proposed}
source -> prepare
root: "Separate Gambit root cut\nProtected RootTransferPermit for actual data cells\nValid VM + scan / relocation writer law\nNo valid safe cut: rooted adoption remains unresolved" {class: gate}
prepare -> root: "managed-data cohort"
commit: "RCO05 / short CustodyGate C\nExclude source and target cleanup / all old back doors\nUnlink selected headers; insert target; record custody\nSame address + original deallocator provenance" {class: proposed}
prepare -> commit: "qualified native-only cohort"
root -> commit: "safe collector cut required"
linked: "ServiceLinked / target owns pending R\nTask not runnable before commit receipt\nKeep boundary / prepared roots until publication" {class: proposed}
commit -> linked
publish: "RCO06--08 / C unlock, then root publication G, then task L\nPublish target roots / issue RootTransferReceipt\nMove counted R to accepted task; notify / resolve\nReconstructed RC operations; known result or real retention" {class: proposed}
linked -> publish
old: "RCO09 / residual source cleanup_rc\nMay visit only residual source headers\nAdopted blocks and required nested users excluded" {class: gate}
publish -> old: "after committed receipt / cursor fence"
end: "Target free / survivor transfer\nAfter actual data, borrow, task, code and provider users\nA queue record or addref is not this lifetime law" {class: gate}
publish -> end
