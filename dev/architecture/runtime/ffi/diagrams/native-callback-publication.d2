direction: down
donor: "EntryHeld\nknown owner + donor roots\nbefore allocating / converting"
root: "Rooted\naccept precise extent\nretain carrier and module"
active: "CallbackActive\nmarker + independent child ledger"
cut: "Moving cut\nclose producers; end borrows\nrelease ack -> acquire coordinator"
scan: "GC owns locations\nroot gate; scan + writeback\nno competing managed access"
reload: "Resume / reenter\nacquire completion; reload\npermit before pending actions"
retire: "Retiring -> Retired\nclose entry; settle exits\ndrain scan / log / invocation users"
donor -> root -> active -> cut -> scan -> reload
reload -> active: "continued execution"
active -> retire: "return / propagated target"
wait: "BW1 participating wait\nC aliases forbid relocation\nreturn to legal service cut"
active -> wait -> cut
park: "Alternative Parked protocol\nfrozen roots; no heap borrow\nexplicit membership handoff"
active -> park -> reload
