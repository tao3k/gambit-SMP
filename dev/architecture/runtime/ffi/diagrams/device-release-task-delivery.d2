direction: down
classes: {
  policy: {style.fill: "#e4efff"}
  native: {style.fill: "#e8f5e6"}
  open: {style.fill: "#fff0d0"}
}
prepare: "Creator-owned preparation\nResource release authority + reserved task cell\nOwned inputs, origin policy and code/library pins" {class: policy}
commit: "Acceptance commit / AttemptId\nDefinite rejection with ownership OR accepted TaskId\nQuery same attempt before uncertain resubmission" {class: native}
notify: "Accepted coordinator custody\nWake failure does not undo acceptance\nCaller / observer cancellation cannot discard cleanup" {class: native}
execute: "Qualified executor claims task\nClose stage -> WaitContext -> next admitted stage\nChild task credit issued before parent credit returned" {class: native}
outcome: "Stable outcome + actual disposition\nFreed-with-error / alive-partial / unknown\nDo not replay an uncertain destructive call" {class: native}
deliver: "Observer result or coordinator-owned sink\nManaged result only after rooted reentry/reload\nReaders and dependency pins outlive notification" {class: native}
retain: "Retained partial / unknown ownership\nNot NativeReleaseDrained\nCannot release code, library or wait dependencies early" {class: open}
prepare -> commit
commit -> notify: "accepted"
commit -> prepare: "rejected: creator still owns" {style.stroke-dash: 5}
notify -> execute
execute -> outcome
outcome -> deliver: "known disposition"
outcome -> retain: "partial or unknown"
