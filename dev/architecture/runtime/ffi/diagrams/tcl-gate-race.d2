direction: down
prepare: "Prepare immutable message\ntarget lease / no C,A,L callouts"
publish: "Raw publish under C -> A\nacceptance / selection point"
entry: "Actual semantic entry\nidentity + early guard"
service: "Selected service outside locks\nrecord nested handler / child scopes"
decide: "Final C/A decision cut\nrevalidate every pending / installed cause"
reject: "Reject cancellation\nfreeze cause; no script body\nmaterialize diagnostics outside locks"
allow: "Allow body\nphase becomes active before unlock"
later: "Raw publishes after allow cut\nvalid active cancellation\nno instruction-free promise"
guard: "Actual native + logical completion\nowner-safe guard settlement"
prepare -> publish
entry -> service
service -> decide
publish -> decide: "wins before decision: include"
decide -> reject
reject -> guard
 decide -> allow
allow -> later
publish -> later: "loses C to allow decision"
later -> guard
