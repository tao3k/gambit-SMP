direction: down
contract: "Common Scheme / runtime contract\nroots + writers + control + custody"
c: "Modern generated C\nreuse carriers / trampoline / repairs"
zig: "Optional Zig provider\nsame obligations + boundary cost"
contract -> c
contract -> zig
saved: "Count saved work once\nmature graph visits + root-cell visits"
cost: "Charge added work\nbarriers / gates / reload / cleanup\nmajor work / copies / retained space"
common: "Same accounting for both providers\nretained existing costs cancel"
c -> common
zig -> common
common -> saved
common -> cost
decision: "Conditional value\nsaved time > added time\nspace and pause reported separately"
saved -> decision
cost -> decision
reject: "Unqualified edge\nunknown root / race / escaped borrow\nexpired marker / unsupported unwind"
contract -> reject
language: "Separate Zig decision\nactual removed support or admitted gain\nmust exceed extra provider burden"
decision -> language
reject -> language: "no correctness credit"
