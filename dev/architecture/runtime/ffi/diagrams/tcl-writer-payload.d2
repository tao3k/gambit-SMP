direction: down
title: "IMMUTABLE PAYLOAD CUSTODY\nProposed core protocol; no implementation"
title.shape: text
prep: "Preparer owns argument disposition\nTarget lifetime lease + immutable M bytes + NUL\nNo commit lock across conversion"
cut: "C / A publication cut\nRevalidate target/token; use reserved records\nAssign generation; swap slot and mark"
slot: "Pending slot retains payload\nLast publication wins\nRetained for possible reinstallation"
claim: "Owner installation claim\nAcquire payload lease before unlocking\nPer-target and descendant coverage"
diag: "Target diagnostic reference\nSeparate C / U contributor history\nChildren receive flags, not parent message"
output: "Check / output lease\nClear C before filter under chosen policy\nConstruct Tcl result outside commit locks"
retire: "Retirement custody\nDisplaced slot and other holders release separately\nNo callbacks or destructor under commit locks"
join: "Reclaim only after every holder releases\nTarget / callback / native frame / image joins\nStorage drain is not cancellation consumption"
failure: "Unpublished failure\nPreparer releases its payload\nRaw lookup failure does not consume argument"
prep -> cut
prep -> failure: "validation / preparation fails"
cut -> slot: "accepted; service owns disposition"
slot -> claim: "snapshot current pending"
claim -> diag
diag -> output
slot -> retire: "superseded or detached"
claim -> retire: "claim release"
output -> retire: "output release"
diag -> retire: "diagnostic replacement / deletion"
retire -> join
failure.style.fill: "#FFF0E5"
cut.style.fill: "#DFEEFF"
join.style.fill: "#E8F4E8"
