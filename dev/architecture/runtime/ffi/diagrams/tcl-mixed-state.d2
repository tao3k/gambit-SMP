direction: down
accept: "Raw accepts under C\nreplace pending message and flags"
select: "Async callback\nA claim / unlock -> C current-payload read"
installed: "Installed state\nC contributors + sticky U contributors\nlatest installed message source"
replace: "Later pending raw accept\nmay replace pending U\ndoes not clear installed U"
check: "Actual Tcl_Canceled check\nclear C before testing U-only filter"
error: "Returned ERROR at known site\nrecord actual control route"
filtered: "Returned OK with no U\nC may already be gone\nno idle-consumption witness"
reset: "Real source-defined reset\nremoves C / U contributions\nrecord the affected evaluation"
return: "Actual native/control return\nclose all future installers\nthen evaluate discharge eligibility"
accept -> select
accept -> replace
replace -> select: "last payload at callback read"
select -> installed
installed -> check
check -> error
check -> filtered
error -> reset: "if actual path schedules it"
filtered -> return: "idle debt remains unresolved"
reset -> return
