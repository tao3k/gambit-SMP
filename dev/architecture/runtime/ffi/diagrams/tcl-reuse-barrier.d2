direction: down
old: "Old epoch\nactual scopes + cancel authority"
seal: "Seal evaluation / child / cancel admission\nunder lifecycle lock"
returns: "All actual evaluation / event / callback\nand control-service scopes return"
senders: "Join published API-call leases\ninclude ancestor cancellation authority"
outcomes: "Own results/options + Scheme roots\nsettle callback-capable delivery"
drain: "Owner outside active async invocation\nqualified thread-wide pending drain"
derived: "Close finite derived work\naccount before parent settles"
reset: "Qualified owner-only reset service\nidle + zero nesting + clear-state postcondition"
publish: "Revalidate and publish next epoch\nsynchronized descriptor / stale handle rejects"
next: "Next evaluation\nonly fresh-epoch authority"
late: "Late old-epoch request\nreject or explicit old-epoch disposition" {style.fill: "#ffe2e2"}
fail: "Any missing predicate\nkeep sealed + custody; safe owner retirement\nno successful reuse receipt" {style.fill: "#fff0d8"}
old -> seal
seal -> returns
seal -> senders
returns -> outcomes
outcomes -> drain
senders -> drain
drain -> derived
derived -> reset
reset -> publish
publish -> next
seal -> late
drain -> fail: "unqualified / unbounded"
reset -> fail: "OK alone insufficient"
