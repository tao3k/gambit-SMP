direction: down
map: "Actual public map\npending procedure result / recursive work"
eval: "Procedure enters Tcl\n##tcltk-eval -> Tcl_Eval"
entry: "Actual Tcl callback\nscheme_call_cmd -> tcltk_call -> apply"
capture: "Composed Scheme callback\ncapture k; return string\noptional nested entry"
map -> eval -> entry -> capture
carrier: "Command lifetime\nRC data -> still vector -> proc\ncreate / invoke / delete"
carrier -> entry: "load rooted location"
roots: "Managed lifetime\nsaved k -> frames + denv\nall aliases need writer coverage"
capture -> roots
marker: "Native activation lifetime\n___call marker / origin / catcher"
entry -> marker
end: "Return / unwind\nmarker expires\nproposed custody must settle"
marker -> end
capture -> end
resume: "Later k resume\nScheme state may survive\nexpired C return must raise"
roots -> resume
end -> resume: "no C stack resurrection"
