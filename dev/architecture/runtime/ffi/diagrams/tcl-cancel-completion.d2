direction: down
close: "Close admission\nregister scope / child frontier"
send: "Publish request leases\nCancelEval API calls"
seal: "Seal further dispatch\nwait for published callers to return"
observe: "Owner async installation + checks\ncooperative evaluation / NRE return"
reset: "Internal flag reset may occur\nbefore outer evaluation return" {style.fill: "#fff0d8"}
snapshot: "Own result/options and Scheme outcome\nbefore reentry or deletion"
frontier: "Join actual scope returns\nclosed senders + durable outcome custody"
retire: "Terminal branch\nowner deletes interpreter + pending async"
reuse: "Reuse branch: unresolved\nqualified pending-handler / reset barrier" {style.fill: "#fff0d8"}
deliver: "Receiver accepts or explicit disposal\nroots transfer only with receipt"
derived: "Deletion / cleanup descendants settle\ncharge before parent decrement"
final: "Root / string / image / scanner grace\nfinal shutdown receipt"
close -> send
send -> seal
send -> observe
observe -> snapshot
reset -> observe: "ordering is route-specific" {style.stroke-dash: 4}
seal -> frontier
snapshot -> frontier
frontier -> retire
frontier -> reuse
snapshot -> deliver
retire -> derived
reuse -> derived: "only after qualification" {style.stroke-dash: 4}
derived -> final
deliver -> final
