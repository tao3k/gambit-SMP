direction: down
classes: {
  source: {style.fill: "#e5f0ff"}
  design: {style.fill: "#e9f5e5"}
  unresolved: {style.fill: "#fff0d2"}
}
source: "Source-backed operations\nDevice cleanup can wait and borrow PSTATE OS scratch\nRC unlink, SSL callbacks and native tasks have real users" {class: source}
guards: "FRA01-FRA09 independent admission evidence\nIdentity / effects / executor / progress / input lifetime\nFailure / reservation / origin semantics / shutdown" {class: design}
direct: "Direct GC-worker release\nBounded qualified native effects\nNo dependency on stopped mutator progress" {class: design}
defer: "Owned native post-epoch release\nExplicit timing redesign; pins and executor survive\nNo synchronous wait on an owner that must resume first" {class: design}
unknown: "Managed / unknown / nonlocal effects\nNo direct worker admission\nRetain or use a separately qualified route" {class: unresolved}
epoch: "MemoryEpochComplete\nRoots, movement and epoch-critical work safe\nDoes not report native resource closed" {class: design}
drain: "NativeReleaseDrained\nActual native effects and dependency disposition terminal\nScarce-resource retry may need this later frontier" {class: design}
source -> guards
guards -> direct: "all direct conditions"
guards -> defer: "known native owned deferral"
guards -> unknown: "missing or incompatible evidence"
direct -> epoch
defer -> epoch: "memory safety independent of retained payload"
direct -> drain: "direct outcome and dependencies terminal"
epoch -> drain: "deferred executor can progress after resume"
