direction: down
plan: "Scheme common native plan\nmodern generated C / optional Zig"
coordinator: "Lifecycle / ReleaseCoordinator\nowner generation + epoch + frontier"
eval: "Accepted EvalScopes\nparent / child / nested event returns"
requests: "In-flight API callers\nlease until call returns"
outcomes: "Durable result / options / Scheme roots\nproducer until receiver receipt"
retirement: "Owner-thread interpreter retirement\nnot while a callback is active"
tasks: "Derived deletion and release tasks\nregister before parent settles"
services: "RootRegistry + allocator + image support\nretained through last required use"
receipt: "Final receipt\nall selected users and descendants settled"
blocked: "Noncooperative native handler\nor unbounded async re-marking\nretain custody; no finite drain claim" {style.fill: "#ffe2e2"}
plan -> coordinator
coordinator -> eval
coordinator -> requests
coordinator -> outcomes
eval -> retirement
requests -> retirement: "sealed + zero leases"
outcomes -> retirement: "snapshot owned"
retirement -> tasks
tasks -> services: "depends on"
outcomes -> services: "depends on"
eval -> blocked {style.stroke-dash: 4}
services -> receipt: "grace completed"
tasks -> receipt: "settled"
outcomes -> receipt: "accepted or disposed"
