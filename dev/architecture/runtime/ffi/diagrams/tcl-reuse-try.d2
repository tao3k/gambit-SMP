direction: down
select: "TclCompileTryCmd\nstatic admission / fallback"
body: "Body only\nBODY; no Try range"
handlers: "Handlers only\nbody range + locals\nmatch / bindings / handler ranges"
finally: "Finally only\nbody range + operand result/options\nseparate finally range"
both: "Handlers and finally\nbody / binding / handler ranges\nlocals + shared finally range"
normal: "Ordinary path\nhandler / finally arbitration\n-during + RETURN_STK"
error: "Reported cancellation ERROR\npersistent unwind at checkForCatch"
exit: "Bypass catch target\nTcl abnormal stack/frame cleanup"
caveat: "Timing and path caveat\nprior finally effects can exist\nBREAK / CONTINUE can go directly to processCatch" {style.fill: "#fff0d8"}
select -> body
select -> handlers
select -> finally
select -> both
handlers -> normal
finally -> normal
both -> normal
body -> error
handlers -> error
finally -> error
both -> error
error -> exit
normal -> caveat: "not an all-instructions cancel guarantee"
