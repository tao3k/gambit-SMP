direction: down
scheme: "Scheme semantic completion\nEvalRoute + control/effect policy + native plan"
c: "Modern generated C\ncommon epoch / root / outcome services"
zig: "Optional Zig provider\nsame semantics and custody obligations"
facade: "One TclReuseService facade\nowner idleness / pending closure / reset receipt"
private: "Source-bound Tcl integration\nexisting internal reset slot\nlink/load/private ABI qualification still open" {style.fill: "#fff0d8"}
future: "Future supported public facility\nrequires actual upstream/vendor contract" {style.fill: "#fff0d8"}
stock: "Public-only direct Tcl_Eval\nreturn / ResetResult is not reset proof\nno cancelled-direct reuse admission" {style.fill: "#ffe2e2"}
identity: "Pinned source bytes verified\ninstalled correspondence not established"
core: "Gambit keeps\nScheme wind / continuation / GC roots\nnative activation validity"
scheme -> c
scheme -> zig
c -> facade
zig -> facade
facade -> private
facade -> future
facade -> stock: "capability missing"
identity -> private: "required evidence"
scheme -> core
