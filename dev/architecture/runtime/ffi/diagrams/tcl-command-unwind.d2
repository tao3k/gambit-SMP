direction: down
library: "LibraryScope\neval / event / create / delete\nowner + interpreter + roots live"
callback: "Scheme callback\nmay capture / nest / raise"
library -> callback
normal: "Normal or locally handled exit\nsettle marker / conversion roots\nreturn through Tcl cleanup"
callback -> normal
done: "Library returns\nowned result snapshot\nsettle scope and deferred releases"
normal -> done
jump: "Raw escape across Tcl frames\npost-call argv / NRE cleanup skipped\nouter catcher cannot establish closure"
callback -> jump
result: "Proposed typed result boundary\nTCL_ERROR may be caught\nwind timing / side effects need a new contract"
callback -> result
open: "General unchanged control semantics\nunresolved; no native admission\nZig defer does not close library frames"
jump -> open
result -> open
