direction: down
title: "RUNTIME COMPOSITION\nDesign view; no proof or runtime admission"
title.shape: text
execution: "Execution\nVM / context / participation"
gc: "GC\nscan / relocate / reclaim"
control: "Control\nframes / origins / resume"
ffi: "FFI\nborrow / callback / blocking"
interfaces: "Owned interfaces\nidentity + epoch + assumptions"
execution -> interfaces: "final root handoff"
control -> interfaces: "retained origin inventory"
ffi -> interfaces: "foreign root and last use"
interfaces -> gc: "scan and retirement conditions"
gc -> execution: "completion and reload"
