# Generated projection fragments; concurrent parent/child custody is not a single global automaton.
# Edge IDs resolve to complete effects/boundaries in atomic-refinement-map.org.
direction: down
ParentSettled: "Parent Settled"
PhaseClosed: "Phase Closed"
Undiscovered: "Undiscovered"
ClaimedUnready: "Claimed Unready"
Initialized: "Initialized"
QueuedRegion: "Queued Region"
ScanningParent: "Scanning Parent"
ChildAccepted: "Child Accepted"
RetainedFailure: "Retained Failure"
RetainedFailure.style.fill: "#FFE1D6"
LateRetained: "Late Retained"
LateRetained.style.fill: "#FFE1D6"
ParentSettled -> PhaseClosed: "phaseclose"
Undiscovered -> ClaimedUnready: "identity"
ClaimedUnready -> Initialized: "initialize"
Initialized -> QueuedRegion: "publish"
Initialized -> ScanningParent: "local"
QueuedRegion -> ScanningParent: "acquire"
ScanningParent -> ChildAccepted: "discover"
ChildAccepted -> ParentSettled: "settle"
ChildAccepted -> ClaimedUnready: "continueChild"
ScanningParent -> RetainedFailure: "unknown"
PhaseClosed -> LateRetained: "late"
