direction: down
classes: {
  semantic: {style.fill: "#e4f0ff"}
  native: {style.fill: "#e8f5e5"}
  limit: {style.fill: "#fff0cf"}
}
registration: "Independent issuer / registration\nTcl command, native function export, foreign destructor\nRegistration retains a future invocation right" {class: semantic}
lookup: "Protected identity resolution\nDirectory reader -> validate -> acquire use\nNo dereference-before-pin or identity-reuse gap" {class: native}
use: "Actual target-specific uses\nInvocation / native return / continuation\nMap decoder / finalizer / queue or library borrow" {class: native}
transfer: "Derived use transfer\nIssue child while parent still held\nKeep only the resources the child actually depends on" {class: native}
close: "Close independent issuance and public resolution\nTombstone directory; revoke external registrations\nUnknown raw-pointer issuers prevent early reclaim" {class: semantic}
drain: "Drain relevant uses and protected readers\nPending callback, destructor and scanner all accounted\nUnrelated VM users need not finish" {class: native}
free: "Free closed target after uses and readers drain\nProvider / OS release follows runtime last-use\nFailure or dependency cycle retains safe custody" {class: native}
limit: "Conditional PT05 refinement\nLocal normal paths traced; external ABI closure open\nRefcount, join and provider remove are insufficient alone" {class: limit}
registration -> lookup
lookup -> use
use -> transfer
transfer -> use: "preserve parent-to-child custody" {style.stroke-dash: 5}
registration -> close
close -> drain
use -> drain: "last target-specific use returned"
drain -> free
free -> limit
