direction: down
classes: {
  native: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  runtime: {style.fill: "#E7F4E8"; style.stroke: "#397344"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
contract: "RuntimeHelperContract\nGC / heap movement / stack rebase / reentry\nCollective / blocking / native allocation / nonlocal exit\nSource/profile closure and root/reload obligations" {class: native}
section: "heap_limit / stack_limit / stack-overflow undo\nSection, fp/hp, limits and frame state can change\nNo direct GC call is not a transitive leaf guarantee" {class: runtime}
collective: "garbage_collect / service_sync_op\nOP_NOOP can join a winning GC or resize\nProcessor-zero error can throw nonlocally" {class: runtime}
callback: "service_interrupts_pstate\nRegistered execute_fn callback effects need closure\nStatus-return API does not imply no reentry / no GC" {class: runtime}
foreign: "SFUN marker / throw_error\nAllocating marker with retained rooting TODO\nMatching catcher, roots and unwind lifetime" {class: runtime}
contract -> section
contract -> collective
contract -> callback
contract -> foreign
admission: "MLIR/LLVM lowering admission\nExplicit exceptional successors and moved-value reloads\nUnknown effects remain barriers\nMemory effects alone do not model Scheme continuation laws" {class: gate}
section -> admission
collective -> admission
callback -> admission
foreign -> admission
