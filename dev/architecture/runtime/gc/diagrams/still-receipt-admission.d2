direction: down
intent: { label: "Registered intent + capacity grant" }
native: { label: "Native call outside gate" }
rawGap: { label: "Raw result not published\nunknown custody retained" }
outcome: { label: "Immutable outcome slot\nrelease / acquire" }
gate: { label: "Domain gate\nsettle once + revisions" }
view: { label: "Snapshot compare + owner commit" }
retired: { label: "Sweep retirement + release permit" }
receipt: { label: "Replayable receipt + delivery" }
formal: { label: "SysML -> ASCENT\nQNT / Lean + source gaps" }
intent -> native: "register before enter"
native -> rawGap: "interrupted before ready"
native -> outcome: "cooperative capture"
outcome -> gate: "validate exact identity"
gate -> receipt: "apply once; replay"
gate -> view: "pending=0; same tuple"
gate -> retired: "scan and readers closed"
retired -> native: "release permit; unlock first"
rawGap -> view: "DENY admission"
formal -> gate: "refinement duty"
