direction: down
roots: { label: "Reserve invocation + physical budget\nprotect procedure / input roots" }
marker: { label: "Capture closure identity + original owner\nallocate marker, reload roots" }
private: { label: "Private backing + charge receipt\nknown layout, init lease" }
shell: { label: "Defaults before list admission\nright-aware scan / cleanup / pointer access" }
ready: { label: "Body complete + result rooted\nescrow still owns native right" }
commit: { label: "One canonical result / right commit\nquery by invocation generation" }
guard: { label: "Owner exit guard\nnormal / error / escaping continuation" }
park: { label: "Known stopped writer\nservice retains init duty and roots" }
gc: { label: "Stable root locations; collector relocates values\nreload before owner reentry" }
retain: { label: "Unknown stop / layout / allocation / commit\nretain exact debt; no replay or refund" }
dispose: { label: "Native borrowers drain -> disposal\nreaders / descendants -> metadata reclaim" }
formal: { label: "SysML authority -> ASCENT\nQNT histories + Lean conditional laws" }
roots -> marker: "root\nbefore\nallocation"
marker -> private: "owner\npermission"
private -> shell: "safe\nbefore\nshared"
shell -> ready: "unique\ninitializer"
ready -> commit: "root\nbefore\ncommit"
commit -> guard: "outcome\nseparate"
guard -> park: "precommit\nescape"
guard -> commit: "postcommit\nquery"
park -> gc: "no\nowner\nwait"
gc -> marker: "current\nroots\n/\nbinding"
guard -> retain: "unknown\nstop"
private -> retain: "unknown\nbacking"
commit -> dispose: "no\nraw\nrollback"
park -> dispose: "known\ndisposition\nonly"
formal -> shell: "source\nrefinement\nopen"
