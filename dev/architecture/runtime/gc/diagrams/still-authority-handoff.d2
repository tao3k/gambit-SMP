direction: down
open: { label: "Ingress open\npending grants + live writers" }
close: { label: "Close generation\nretain W + P + B debt" }
stop: { label: "WriteClosed or authenticated stop\nborrower drain + store integrity" }
unknown: { label: "Unknown raw writer / allocator\nGC cannot detach" }
domain: { label: "Canonical StillDomain\nroots + chain + ledger" }
prepare: { label: "Prepare receiver\nsource retains custody" }
commit: { label: "Commit owner generation\nno payload movement" }
query: { label: "Unknown reply\nquery canonical identity" }
scan: { label: "GC census by domain key\nscan + exact capacity" }
readers: { label: "Drain old PSTATE aliases\nkeep backing live" }
cleanup: { label: "Cleanup permit\nretire PSTATE, retain domain" }
open -> close: "linearized against grant admission"
close -> stop: "all authority accounted"
close -> unknown: "no closure evidence"
stop -> domain: "freeze links/accounting; root snapshot"
domain -> prepare: "receiver resources accepted"
prepare -> commit: "single canonical owner commit"
prepare -> domain: "reject: donor keeps domain"
commit -> query: "reply lost: keep both aliases"
query -> commit: "read existing commit; no second transfer"
domain -> scan: "GC may use frozen retained domain"
commit -> scan: "canonical key unchanged"
commit -> readers: "detach old alias"
readers -> cleanup: "old readers zero; commit known"
cleanup -> scan: "next GC still enumerates backing"
unknown -> stop: "requires real external closure evidence"
