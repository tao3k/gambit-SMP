direction: right
classes: {
  actual: {style.fill: "#dbeafe"; style.stroke: "#2563eb"}
  proposed: {style.fill: "#ede9fe"; style.stroke: "#7c3aed"}
  open: {style.fill: "#ffedd5"; style.stroke: "#c2410c"}
}
compiler: "Scheme semantics\nTraceSpec / roots / stores / safe points" {class: actual}
contexts: "Execution contexts\nlocal young allocation + Scheme frames" {class: proposed}
minor: "VM coordinated parallel minor\nroots + remembered source locations\ncomplete forwarding / promotion" {class: proposed}
mature: "Shared nonmoving mature / pinned\nconcurrent major marking candidate" {class: proposed}
roots: "VM root / foreign / continuation registry\nowner + scan epoch + code users" {class: proposed}
stores: "Unified typed store / publish protocol\nyoung edges + SATB + root writes" {class: proposed}
native: "Zig native auxiliary storage\nexplicit allocation / custody" {class: proposed}
gate: "Open qualification\nall writers / memory model / phases\nweak + FFI + net cost" {class: open}
compiler -> contexts
contexts -> minor -> mature
roots -> minor
stores -> minor: "remembered edges"
stores -> mature: "marking obligations"
roots -> mature
native -> roots: "native storage is not automatic root"
mature -> gate
