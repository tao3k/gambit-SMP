direction: down
n_token: { label: "Stable Tcl token / owner anchor" }
n_pin: { label: "Pin before data_rc or close" }
n_child: { label: "Canonical NativeActivation roots" }
n_park: { label: "Stop raw borrow / freeze full view" }
n_gc: { label: "GC update / context-ready / reload" }
n_run: { label: "Run marker and Scheme call" }
n_catch: { label: "Outer catcher / one cleanup claim" }
n_retire: { label: "Clear marker / count / root / status" }
n_delete: { label: "Delete hook closes and returns" }
n_drain: { label: "Last pin / payload release / token drain" }
n_startup: { label: "Startup / thread source transfer" }
n_token -> n_pin: "owner entry hook"
n_pin -> n_child: "pin wins"
n_pin -> n_delete: "delete wins"
n_delete -> n_drain: "no self wait"
n_child -> n_park: "GC closes"
n_park -> n_gc: "mapped and stopped"
n_gc -> n_child: "same call resumes"
n_child -> n_run: "root before allocation"
n_run -> n_catch: "normal or rethrow"
n_catch -> n_retire: "canonical progress"
n_retire -> n_drain: "result and last\npin"
n_delete -> n_token: "keep tombstone"
n_retire -> n_child: "unknown retains custody"
n_startup -> n_child: "before worker synchronization"
