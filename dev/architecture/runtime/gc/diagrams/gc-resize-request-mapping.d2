direction: down
classes: {
  actual: {style.fill: "#e8f1fb"; style.stroke: "#346a98"}
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  boundary: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "GC / resize: requests, selection and participants\nSource policy and proposed durable mapping are distinct" {shape: text}
requests: "CQM01 / durable RequestIds\nGC demand / resize thunk and target U count\nOrigin / ABI / rooted arguments / result custody" {class: proposed}
selection: "CWR01--04 / existing tree selection\nResize higher priority, noncombined\nGC combines arg0 by addition\nLosing requests persist; NOOP actors still help" {class: actual}
requests -> selection: "CQM02 frozen round / bound tie policy"
resize: "CQM04 / selected resize request\nOne thunk / target / origin\nOld context cohort until membership cut" {class: proposed}
gc: "CQM03 / selected GC membership set\nEach RequestId once; checked total demand\nOne authoritative CapacityOutcome required" {class: proposed}
selection -> resize: "OP_VM_RESIZE"
selection -> gc: "OP_GARBAGE_COLLECT"
child: "CQM06 / optional resize child GC\nSame parent admission / old U-K-S / frozen W\nDoes NOT consume queued GC RequestIds" {class: proposed}
resize -> child
actors: "CQM05 / P role map\nRoot owners / safe acknowledgers / W scanners\nStorage tasks / startup / retire / result consumers\nU, K, S, W, P and O are separate sets" {class: proposed}
child -> actors
gc -> actors
membership: "CQM07 / nonmoving membership cut\nPrepared dormant roots before Scheme startup\nKeep old helpers through startup GC\nRetiring contexts preserve actual custody / users" {class: proposed}
actors -> membership
result: "CQM08--09 / one result fan-out\nRequest completion differs from participant exit\nAcquire common outcome before branch / reload\nPending / Deferred / Unknown is never false-success" {class: boundary}
membership -> result
open: "CWR07 / source result-delivery gap\nOnly P0 assigns local overflow in vendor GC\nBarrier alone does not broadcast this result\nSemantic repair / ABI equivalence unresolved" {class: boundary}
open -> result: "requires independent qualification"
