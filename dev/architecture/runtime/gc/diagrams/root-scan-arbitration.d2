direction: down
enlist: { label: "Phase snapshot\nenlist root/view duty" }
ticket: { label: "Return ticket\nretain already-owed work" }
pending: { label: "Service-owned pending task\nepoch + attempt generation" }
owned: { label: "Worker claim + private scan\ncursor / copy frame / child credits" }
ready: { label: "Quiescent Ready record\nroot acknowledgement" }
drain: { label: "Drain descendants / weak phase\ncleanup + capacity + context prepare" }
seal: { label: "Whole-round ResumeSeal\nactive permit then reload" }
exit: { label: "Stopped + complete checkpoint\naccepted handoff; new generation" }
unknown: { label: "Unknown writer / transfer\nretain debt; refuse phase close" }
formal: { label: "SysML -> ASCENT\nQNT / Lean / source-order gaps" }
enlist -> pending: "publish\nduty\nbefore\nnotification"
ticket -> pending: "late\nowed\nclaim\nremains\nlegal"
pending -> owned: "claim under phase/task gate"
owned -> ready: "publish children before Ready"
ready -> drain: "RootAck\nalone\ncannot\nresume"
drain -> seal: "complete admitted round"
owned -> exit: "cooperative cut + source pins"
exit -> pending: "requeue exact continuation"
owned -> unknown: "ambiguous progress or stop"
unknown -> drain: "closure\ndenied"
ticket -> seal: "wait outside metadata gate"
formal -> seal: "conditional refinement only"
