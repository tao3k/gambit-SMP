direction: down
producer: { label: "Scheme generator / native constructor\nprofile + origin + result slot" }
reserve: { label: "Atomic vector budget reservation\nbefore native resource creation" }
roots: { label: "Instance dependency registration\nbefore first possible GC / escape" }
native: { label: "Native effect + conversion\nsame ticket; synchronous rollback" }
cut: { label: "Producer close + acquired ledger\nin-flight reservations remain charged" }
trace: { label: "Current-round dependency trace\nor counted pre-seal rescan" }
handoff: { label: "Accepted task custody\nthen wrapper retirement" }
run: { label: "Qualified executor / owner dispatch\nexplicit WaitContext + code pin" }
retire: { label: "Known disposition + readers/children drain\nphysical free then budget refund" }
reject: { label: "Unknown profile / rollback owner / roots\nreject deferral; retain known source custody" }
models: { label: "SysML -> ASCENT\nQNT + Lean conditional evidence" }
producer -> reserve: "shape and effect admission"
reserve -> roots: "capacity secured"
roots -> native: "rooted native arguments/results"
native -> cut: "wrapped and in-flight duties"
cut -> trace: "no unregistered producer"
trace -> handoff: "roots\ntraced\nbefore\ncleanup\nseal"
handoff -> run: "owner callback waits active permit"
run -> retire: "ACK alone insufficient"
native -> reject: "failed or unknown custody"
producer -> reject: "unknown external effects"
models -> handoff: "source\nand\nC-order\ngaps\nremain"
