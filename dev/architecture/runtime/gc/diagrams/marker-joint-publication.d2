direction: down
n_entry: { label: "Pre-backed input root + canonical operation\nexplicit proc / frozen closure origin" }
n_private: { label: "Reserve capacity -> native allocation\nraw private storage; no SCMOBJ edge" }
n_grant: { label: "Running epoch + domain authority\ngrant one publisher lease" }
n_body: { label: "Reload current rooted proc\nvalid header / body / count0" }
n_link: { label: "Write next + physical still head\nlease retains responsibility" }
n_root: { label: "Install reserved root entry\nnot independently snapshot-visible" }
n_commit: { label: "Canonical result + live credit commit\nrelease lease; root-backed delivery" }
n_closing: { label: "Close new enrollment / grants\ndrain exact active leases" }
n_frozen: { label: "Paired root / list / credit snapshot\nall domains setup before marking" }
n_failure: { label: "Known stop + exact journal\nlinked path rolls forward" }
n_debt: { label: "Unknown native allocation/free\nretain input root + quarantine credit" }
n_scan: { label: "Existing still CAS + typed scan\nstrong / weak / sweep / reconcile" }
n_formal: { label: "SysML -> ASCENT -> QNT / Lean\nsource and memory-order gaps open" }
n_entry -> n_private: "root\nbefore\nany\nsafepoint"
n_private -> n_grant: "no\nGC\nrequest\nunder\npermit"
n_grant -> n_body: "bounded\nnonallocating\nwrites"
n_body -> n_link: "initialized\nbefore\nlink"
n_link -> n_root: "permit\ncovers\nhalf\nstate"
n_root -> n_commit: "single\ncanonical\noutcome"
n_grant -> n_closing: "preexisting\npermits\nfinish"
n_closing -> n_frozen: "all\nwriters\nsettled"
n_commit -> n_frozen: "membership\npaired\nat\ncut"
n_frozen -> n_scan: "global\nsetup\ncompletion"
n_link -> n_failure: "owner\nfails\nmid-publication"
n_failure -> n_root: "qualified\nroll-forward"
n_private -> n_debt: "native\noutcome\nunknown"
n_debt -> n_frozen: "only\nstopped\nnative-only\ndebt"
n_failure -> n_closing: "unknown\nstop\nblocks\nfreeze"
n_scan -> n_grant: "next\nepoch\n+\nreload"
n_formal -> n_frozen: "conditional\nrefinement\nonly"
