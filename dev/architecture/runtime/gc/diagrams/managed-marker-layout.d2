direction: down
inputs: { label: "Root proc / frozen closure data\nbefore any safepoint" }
private: { label: "Reserve root / control capacity\nprivate typed body, refcount0" }
layout: { label: "Subtype candidate16\n2 SCMOBJ + 24 immutable raw bytes" }
commit: { label: "Bounded publication gate\nvalid list + root entry together" }
setup: { label: "Freeze all domains\nall still-list setup completes" }
trace: { label: "Root enumeration -> still CAS\nscan exactly two root slots" }
return: { label: "Checked route + activation key\noriginal-owner delivery claim" }
close: { label: "Logical close -> permitted proc clear\nkey / route unchanged" }
captured: { label: "Captured frame retains marker\nmetadata miss means Closed" }
sweep: { label: "Root/view/borrow drain\nGC reachability alone frees marker" }
reject: { label: "Raw vector / counter / serialization\nreplace or reject admission" }
formal: { label: "SysML -> ASCENT -> QNT / Lean\nsource and C-order gates open" }
inputs -> private: "protect\nbefore\nallocate"
layout -> private: "exact\nshape"
private -> commit: "body\ninitialized"
commit -> setup: "jointly\nvisible"
setup -> trace: "all-list\nbarrier\nfirst"
commit -> return: "typed\nrooted\nobject"
return -> close: "original\nexit\nguard"
close -> captured: "immutable\nkey\nsurvives"
trace -> captured: "frame\nroots\ntraced"
close -> sweep: "release\nis\nnot\nfree"
captured -> sweep: "actual\nheap\nreachability"
reject -> return: "no\nlegacy\nfallback"
reject -> layout: "no\nforged\nmutable\ntype"
formal -> setup: "conditional\nrefinement"
trace -> sweep: "strong/weak\ncompletion"
