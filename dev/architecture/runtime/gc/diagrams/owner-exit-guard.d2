direction: down
entry: { label: "Scheme emits typed entry / exit plan\nroots + stable owner record before marker" }
calls: { label: "___call trampoline and SFUN conversions\nScheme winding / error handlers may nest" }
packet: { label: "Capture actual native transport\noriginal owner + rooted destination" }
guard: { label: "Bounded no-callback guard\nstop writer, retain roots, transfer duty" }
close: { label: "Logical activation close\nexactly once; target excluded" }
catcher: { label: "Restore previous catcher before propagation\nkeep current GVM destination coordinate" }
bridge: { label: "Qualified CFUN/native bridge cleanup\nretain existing temporary/effect obligations" }
target: { label: "Matching ___call consumes destination\n___run returns code through original caller" }
service: { label: "Authorized root/heap writer\nphysical marker clear + deferred duty drain" }
result: { label: "Canonical committed result retained\nquery only; no rollback or replay" }
reject: { label: "Unknown managed stop / layout / legal unwind\nreject admission or fail-stop violated premise" }
formal: { label: "SysML -> ASCENT -> QNT / Lean\nsource and C-memory obligations open" }
entry -> calls: "guard\nencloses\nall\nphases"
calls -> packet: "actual\ncaught\ntransport"
packet -> guard: "nonmatching\nor\nerror"
guard -> close: "stable\ncustody\nfirst"
close -> catcher: "no\nstale\nfp\nrestore"
catcher -> bridge: "propagate\nexact\npacket"
bridge -> packet: "next\nabandoned\nboundary"
bridge -> target: "only\nafter\nbridge\nsettled"
close -> service: "physical\nclear\ndeferred"
guard -> result: "commit\nsurvives\nescape"
result -> target: "live\ntarget\nstill\nrequired"
guard -> reject: "unsafe\npremise"
entry -> reject: "reject\nbefore\nnative\nentry"
formal -> guard: "conditional\nmodel\nonly"
