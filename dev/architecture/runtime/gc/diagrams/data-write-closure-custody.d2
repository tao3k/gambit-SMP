n_endpoint: { label: "Last managed write / cleanup\nexception guard per activation" }
n_seal: { label: "DataWriteClosed\nall E writers + issued effects drained" }
n_prepare: { label: "Prepare independent VM roots\nnode / domain / code / ticket" }
n_accept: { label: "Canonical VM custody accepted\nlost ACK -> query, no replay" }
n_detach: { label: "Detach source physical chains\nzero source PSTATE pins" }
n_cleanup: { label: "Admitted PSTATE data cleanup\nhelper may continue on VM backing" }
n_joinOutcome: { label: "Exact join receipt\nsuccess / failed / unknown" }
n_freeze: { label: "Domain GC freeze\nall cohorts closed; native envelope separate" }
n_retain: { label: "Retain roots / domain / native envelope\nunknown effect refuses dependent GC" }
n_formal: { label: "SysML -> ASCENT -> QNT / Lean\nsource and C refinement open" }
