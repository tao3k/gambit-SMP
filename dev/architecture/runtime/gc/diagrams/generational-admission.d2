direction: down
classes: { candidate: { style.fill: "#e9f2ff" } }
scheme: { label: "Scheme semantics + FrameSpec"; class: candidate }
stores: { label: "Generated modern C: semantic stores"; class: candidate }
nursery: { label: "Context nurseries"; class: candidate }
remembered: { label: "BarrierLog / dirty source slots"; class: candidate }
domains: { label: "RootRegistry / final-value freeze"; class: candidate }
minor: { label: "VM-wide parallel minor epoch"; class: candidate }
mature: { label: "Nonmoving mature + pinned/still policies"; class: candidate }
major: { label: "Complete major / weak / wills"; class: candidate }
release: { label: "ReleaseCoordinator: native custody"; class: candidate }
ffi: { label: "Native callback storage lease / parked raw borrow"; class: candidate }
scheme -> stores: "generated contract"
stores -> nursery: "InitStore before publication"
stores -> remembered: "MutateStore / Bulk / CAS"
ffi -> domains: "RootWrite / park / reload"
remembered -> minor: "sealed dirty set or fallback"
domains -> minor: "root slots"
nursery -> minor: "young closure"
minor -> mature: "promote and rewrite all source slots"
mature -> major: "less frequent full tracing"
major -> release: "preaccepted native-only custody"
release -> ffi: "owner drain after pins released"
