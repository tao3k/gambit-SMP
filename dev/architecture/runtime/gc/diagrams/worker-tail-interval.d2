direction: down
classes: {
  actual: {style.fill: "#e8f1fb"; style.stroke: "#346a98"}
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  boundary: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "Worker tail -> context allocation rights\nVM retains section and copied prefix / conditional design only" {shape: text}
drain: "STL01 / STH01 / final epoch and actual users drained\nStrongClosed alone is insufficient\nFreeze old worker cursor / pin SectionId and active half\n[h0,h1) has M/2 words; p is actual next-free offset" {class: proposed}
title -> drain: {style.opacity: 0}
layout: "STL02--04 / typed segments inside one active half\n[h0,p) VM live prefix | [p,q) closure / alignment | [q,b) target grant | [b,h1) guards\nGrant: [q,b-F) ordinary allocation | [b-F,b) exclusive F-word overrun reserve\nCopied prefix keeps old chunk layout and VM ownership\nFORW closure / gaps are explicit segments, never guessed object headers" {class: proposed}
drain -> layout
fit: "STL02--07 / admit actual fit\nq satisfies object-start modulus and header/body residue\nb <= h1-z_end / b-q >= F+u_min / trigger <= b-F\nDisjoint from stack and all other writers\nNext GC uses SegmentLayout, not an arbitrary linear gap" {class: proposed}
layout -> fit
pending: "STH02--03 / WorkerOwned -> TransferPending under H\nDonor loses allocation rights before closure writes\nExclusive suffix writes outside gates\nUnknown writes retain pending owner and held VM cut" {class: proposed}
fit -> pending
grant: "STH04 / H commits IntervalGrant + layout + revision\nTarget/coordinator owns rights; VM still owns storage\nH -> G delivery gap stays held\nNo timeout return to donor / no whole-section free" {class: proposed}
pending -> grant
resume: "STH05--06 / G publishes actual ResumeBinding\nAcquire matching heap / stack / layout before use\nReplace whole-section prepare / sharing / occupancy paths\nNew suffix objects survive context cancellation\nRetire worker scratch only after real borrower drain" {class: proposed}
grant -> resume
boundary: "Benefit is conditional\nShort / borrowed / misaligned tails yield zero reuse\nAggregate free words do not prove placement or fewer sections\nC and Zig require the same parser / root / lifetime proof" {class: boundary}
resume -> boundary
