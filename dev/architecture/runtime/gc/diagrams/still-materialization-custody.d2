direction: down
allocate: { label: "Private block\nallocator ledger" }
shell: { label: "Valid ordinary shell\nnot user-visible" }
roots: { label: "Independent root domain\nphysical backing retained" }
lease: { label: "Managed epoch lease\npre-dirty + reload" }
store: { label: "Integral field stores\npending outcome retained" }
unknown: { label: "Unknown raw writer\nGC gate remains closed" }
stop: { label: "Authenticated stop\nall borrowers closed" }
abort: { label: "Abort semantic result\nretain actual valid slots" }
scan: { label: "GC scan / rewrite\nno live write lease" }
result: { label: "Complete result\nreceiver pin then source drop" }
allocate -> shell: "initialize before enrollment"
shell -> roots: "release publication / census"
roots -> lease: "acquire epoch"
lease -> store: "no GC inside lease"
store -> unknown: "missing closure"
unknown -> stop: "requires external evidence"
stop -> abort: "do not replay field"
abort -> scan: "guard cleared after closure"
store -> scan: "normal release between batches"
scan -> lease: "reload relocated handles"
store -> result: "all fields complete; release"
result -> scan: "root overlap"
allocate -> scan: "unenrolled block excluded; ledger retained"
