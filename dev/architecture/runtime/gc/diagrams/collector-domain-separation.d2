direction: down
classes: {
  semantic: {style.fill: "#e8f1fb"; style.stroke: "#346a98"}
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  boundary: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "CollectorWorkContext: explicit domains, not a copied PSTATE\nConditional design / 34 mem members classified / no native qualification" {shape: text}
contexts: "CWI01 / U MutatorContexts\nScheme registers / stacks / return / interrupt\nOwner-specific resume area and allocation buffer" {class: semantic}
roots: "CWI02 / K RootDomains\nActual tagged cells + structured continuation tasks\nTarget RC carriers / pending request arguments\nRoot owner differs from tracing worker" {class: semantic}
contexts -> roots: "final safe acknowledgements"
storage: "CWI03 / S HeapShards and extents\nPersistent still / RC / will custody and accounting\nVM owns live copied objects after worker retirement" {class: semantic}
workers: "CWI04 / W CollectorWorkers\nCopyArena + scan lease + current phase\nExplicit VM / allocator / queue access\nU=1, W>1 still requires CAS / locks" {class: proposed}
roots -> workers: "owner + worker adapter / canonical writer"
storage -> workers: "admitted shard tasks and allocation services"
roles: "CWI05--06 / P roles and O requests\nAcknowledger / startup / retirement / resolver\nRequest origin is not a worker or root count" {class: proposed}
roles -> workers: "frozen per-epoch role map"
epoch: "VM HeapEpoch + phase authority\nSeparate root plan / worker roster / heap budget\nForwarding + frame publication + termination\nNo implicit donor PSTATE / TLS access" {class: proposed}
workers -> epoch
resume: "CWS09 / two distinct handbacks\nPer-context fp / hp / limits / relocated roots\nCopied extents -> VM storage custody\nOnly scratch retires after physical borrower drain" {class: boundary}
epoch -> resume
limits: "Unresolved: transitive helpers / aliases / hooks\nSelection/result repair / allocator sharing and capacity\nNative memory order / progress / net benefit" {class: boundary}
resume -> limits
