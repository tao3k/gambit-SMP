direction: down
managed: { label: "Managed context\nexclusive write / participation permit" }
freeze: { label: "Safepoint spill + root coverage\nclose writers / raw borrowers" }
view: { label: "Publish canonical root view\ntransfer ack -> frozen-root duty" }
native: { label: "Pure native bytes / opaque IDs\nno Scheme payload access" }
scan: { label: "Independent worker scan lease\nwrite relocated canonical cells" }
request: { label: "Return / callback reentry request\nhonor owed scan; close new rounds" }
grant: { label: "Drain scan; validate latest epoch\ngrant active participation" }
reload: { label: "Reload roots / protect callback proc\nthen marker and Scheme execution" }
parent: { label: "Callback exit exports result\npublish fresh parent view" }
deny: { label: "Unknown writer / stale binding\nretain custody; refuse transfer" }
formal: { label: "SysML -> ASCENT\nQNT / Lean / native-order gap" }
managed -> freeze: "revoke ordinary writes"
freeze -> view: "phase-gated publication"
view -> native: "issue native permit"
view -> scan: "root duty remains live"
native -> request: "before first managed read"
scan -> grant: "completion epoch + cell updates"
request -> grant: "mutator / scan arbitration"
grant -> reload: "permit protects reload window"
reload -> managed: "ordinary return"
reload -> parent: "nested callback path"
parent -> view: "fresh revision; parent roots retained"
native -> deny: "unqualified managed access"
freeze -> deny: "writer / coverage gap"
formal -> grant: "conditional refinement only"
