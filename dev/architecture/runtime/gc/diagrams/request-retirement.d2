direction: down
vars: { d2-config: { theme-id: 0 } }
n_caller: { label: "Complete mapped caller roots" }
n_preflight: { label: "Checked fixed arena and capacity" }
n_fail: { label: "No-publication refusal; caller keeps roots" }
n_slot: { label: "Issued key and reserved VM escrow" }
n_accept: { label: "GC close arbitrates root acceptance" }
n_query: { label: "Pinned metadata query; exact key" }
n_exit: { label: "VM custody before exceptional exit" }
n_settle: { label: "Result/source ACK and reader drain" }
n_hole: { label: "Settled bit; earlier hole stays owned" }
n_prefix: { label: "Advance only over settled head" }
n_reuse: { label: "Reuse slot with new full key" }
n_limit: { label: "Exhaustion: refuse or sealed fresh domain" }
n_late: { label: "Late key rejected before dereference" }
n_caller -> n_preflight: "pre-effect complete view"
n_preflight -> n_fail: "size/capacity/OOM fail"
n_preflight -> n_slot: "reserve before publish"
n_slot -> n_accept: "source remains until\naccepted"
n_slot -> n_query: "lost return queries\nsame key"
n_slot -> n_exit: "exception retains reserved\nescrow"
n_accept -> n_settle: "independent source and\nresult ACK"
n_query -> n_settle: "current canonical status"
n_exit -> n_settle: "no callback wait\nunder lock"
n_settle -> n_hole: "compact only after\ndrain"
n_hole -> n_prefix: "cannot jump unresolved\nhead"
n_prefix -> n_reuse: "prefix excludes old\nkey"
n_reuse -> n_limit: "checked finite identity\nspace"
n_prefix -> n_late: "key-only delayed delivery"
n_limit -> n_late: "old generation never\nreopens"
