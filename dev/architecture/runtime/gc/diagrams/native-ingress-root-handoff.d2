direction: down
n_source: { label: "Registered handle / complete parent view" }
n_pin: { label: "Opaque ingress pin / source borrow" }
n_gate: { label: "GC close and native admission" }
n_child: { label: "Canonical child RootView acceptance" }
n_marker: { label: "Marker and conversion prefix" }
n_nested: { label: "Nested activation / Scheme execution" }
n_park: { label: "Stop raw access / freeze parent and child" }
n_gc: { label: "GC update / context seal / reload" }
n_exit: { label: "Result or error custody / cleanup" }
n_reclaim: { label: "Dispatch drain + pin/reader retirement" }
n_source -> n_pin: "source covers entry\nwindow"
n_pin -> n_gate: "claim or park"
n_gate -> n_child: "open validates identity"
n_gate -> n_park: "close wins"
n_child -> n_marker: "accept before allocate"
n_child -> n_source: "ack releases source\nduty"
n_marker -> n_nested: "typed arguments and\nroots"
n_nested -> n_park: "cooperative nested park"
n_park -> n_gc: "no raw borrow"
n_gc -> n_gate: "same activation reload"
n_nested -> n_exit: "normal or known\nfailure"
n_exit -> n_reclaim: "receiver accepts and\ndispatch drains"
n_exit -> n_child: "unknown keeps root\ncustody"
