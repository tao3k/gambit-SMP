direction: down
classes: {
  actual: {style.fill: "#e8f1fb"; style.stroke: "#346a98"}
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  boundary: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "AllocationCheckSpec / actual ordered span\nConditional source arithmetic / no analyzer or native execution" {shape: text}
entry: "ABR01--03 / actual assurance\nOne interval [q,b), cursor h <= trigger L\nWrite W / formed-address P / minima / provenance\nB = max(0,W,P), require L+B <= b\nGrant boundary differs from native allocation provenance" {class: proposed}
title -> entry: {style.opacity: 0}
pre: "ABC08 / dirty flush before predicate\nActual boxes and frame/root stores have real order\nCharge this side to the preceding assurance\nPending operation is not erased by a debt reset" {class: proposed}
entry -> pre
check: "AB-S03 / source check\nCompiler debt threshold 4096 / actual hp > L\nMacro m does not reserve runtime words\nFalse predicate or slow edge has its own continuation" {class: actual}
pre -> check
post: "ABC01--04 / selected post-check extent\n64-bit no-handles: pair 3 / allocated box 2 words\nVector n + 1 + 2*d for actual post-check box events\nIsolated dynamic small macro <= 255 words\nAdditional effects require additional bound" {class: proposed}
check -> post: "new qualified assurance"
slow: "ABC05--09 / probe and GC slow edge\nTentative hp address is not an initialized object\nHeap helper may rebase or request GC\nFinish capacity / complete roots / GC / reload\nThen instantiate pending body with new binding" {class: proposed}
check -> slow
layout: "ABO05--07 / actual completion and layout\nRecord initialized objects / typed holes / actual reserve use\nNo rewind over later objects / no whole-run over-rooting\nStatic plan is not an actual storage receipt" {class: proposed}
post -> layout
slow -> layout
limits: "Still unqualified\nAll CFG/cache/helper/native exits and exact target bounds\nNo universal B=4096 or B=255\nUnknown effects retain actual VM/layout custody" {class: boundary}
layout -> limits
