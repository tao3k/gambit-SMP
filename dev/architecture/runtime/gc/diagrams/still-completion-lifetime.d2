direction: down
policy: { label: "Qualified policy + preallocated intent" }
raw: { label: "Native call -> ready publication\nno escape; preemption allowed" }
unknown: { label: "Raw gap / dead-held gate\nretain custody; refuse handoff" }
txn: { label: "Gate transaction\nvalidate -> write -> commit -> unlock" }
restore: { label: "Stable result roots + VM binding\nrestore masks/cancel outside gate" }
replay: { label: "Known outcome / replay receipt" }
floor: { label: "ACK + producer closure\nadvance nonregressing replay floor" }
pins: { label: "Drain raw record pins\nreject old keys before lookup" }
reuse: { label: "Reuse record slot\npool backing remains reserved" }
formal: { label: "SysML -> ASCENT\nQNT / Lean; source gaps open" }
policy -> raw: "accept only after policy success"
raw -> unknown: "outcome unpublished on stop"
raw -> txn: "ready release / acquire"
txn -> unknown: "unexpected exit during gate"
txn -> restore: "commit then unlock"
restore -> replay: "may deliver pending cancellation"
replay -> floor: "explicit result-right retirement"
floor -> pins: "close new old-key lookups"
pins -> reuse: "existing readers + producers drained"
formal -> txn: "conditional refinement"
unknown -> floor: "DENY\nguessed\nsettlement\n/\nACK"
