direction: down
n_origin: { label: "Origin / effect / result manifest\nasync task or synchronous native call" }
n_producer: { label: "Close publisher admission\nretain header + wakeup tickets" }
n_entry: { label: "Close early native entry gate\nclaim before dequeue unlock" }
n_future: { label: "FutureEpochGate\nunstarted task; VM roots/resources held" }
n_active: { label: "Claimed / issued / running\nnot an unstarted future task" }
n_park: { label: "Complete or parked-current\nfrozen roots + native return identity" }
n_gc: { label: "Current data quiescence -> GC\nfuture execution not required" }
n_prepare: { label: "Whole-round result + context capacity\nowner binding + relocated root reload" }
n_nextEpoch: { label: "Publish fresh next epoch authority\nold seal stays immutable" }
n_claim: { label: "Atomic future claim / parked resume\nbefore marker allocation and Scheme" }
n_custody: { label: "VM task/root/native/code custody\ntransfer is not disposal" }
n_refuse: { label: "Unknown raw call / sync result / owner\nretain debt; refuse unsafe admission" }
n_formal: { label: "SysML -> ASCENT -> QNT / Lean\nsource and C memory gaps open" }
n_origin -> n_producer: "admitted\norigins\nonly"
n_producer -> n_entry: "publication\npostludes\ndrain"
n_entry -> n_future: "queued\nand\ninvocation\nexcluded"
n_entry -> n_active: "claim\nwon\nor\nalready\nissued"
n_active -> n_park: "no\nforced\ncompletion\nwait\ncycle"
n_future -> n_gc: "cannot\nexecute\nin\ncurrent\nepoch"
n_park -> n_gc: "qualified\nfrozen\ncurrent\nview"
n_gc -> n_prepare: "GC\nnotification\nalone\ninsufficient"
n_prepare -> n_nextEpoch: "all\nreadiness\nreceipts"
n_nextEpoch -> n_claim: "fresh\nmembership\nbefore\neffects"
n_custody -> n_future: "root/resource/code\naccepted\nbefore\ngate"
n_custody -> n_park: "native/root\nbacking\nretained"
n_custody -> n_claim: "reload\nstable\nroot\nhandles"
n_origin -> n_refuse: "unqualified\nsync\nor\nraw\ncontract"
n_active -> n_refuse: "unknown\ninvocation\nor\npark\nproof"
n_prepare -> n_refuse: "stale\ncontext\n/\nroots\n/\nbinding"
n_origin -> n_custody: "prepare\ncanonical\nbacking"
n_formal -> n_nextEpoch: "fresh\nauthorization\nproof"
