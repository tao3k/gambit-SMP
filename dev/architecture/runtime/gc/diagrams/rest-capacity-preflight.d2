direction: down
n_input: { label: "Evaluated target + arguments\ncomplete caller / native root view" }
n_plan: { label: "CallInputSpec + exact rest / stack demand\nno destructive argument movement" }
n_checks: { label: "All collecting checks while rooted\nfreeze/reload logical inputs" }
n_grant: { label: "Canonical noncollecting tryReserve\nactual heap/stack cursor windows" }
n_deny: { label: "Known deny / unresolved result\nkeep full roots; no argument replay" }
n_consume: { label: "Atomic unused-ticket -> active writer\nvalidate epoch/layout/serial/input/cursor" }
n_build: { label: "No-GC shuffle / full rest repair\nadvance initialized prefix only" }
n_frame: { label: "Complete mapped FrameReady\nclose active construction lease" }
n_gc: { label: "Cancel unused grants / settle active work\nGC flips layouts and root values" }
n_reissue: { label: "Round/context/binding/root reload\nnew ticket for unbuilt call only" }
n_body: { label: "Completed packet resumes same call\nfresh execution authority, no new rest ticket" }
n_custody: { label: "VM ticket + source/native/root custody\nunknown never means free" }
n_formal: { label: "SysML -> ASCENT -> QNT / Lean\nphysical C/source/ABI gaps open" }
n_input -> n_plan: "after evaluation, before POP/shuffle"
n_plan -> n_checks: "complete roots retained"
n_checks -> n_grant: "final noncollecting layout effect"
n_grant -> n_consume: "known unused grant, one\nwinner"
n_grant -> n_deny: "failure or response uncertainty"
n_consume -> n_build: "close cannot revoke active\nwriter"
n_build -> n_frame: "all fields and root\nmap complete"
n_frame -> n_gc: "lease closed before collector"
n_deny -> n_gc: "only settled arena result\nand full roots"
n_gc -> n_reissue: "old addresses and tickets\ninvalid"
n_reissue -> n_grant: "same logical inputs, no\nreevaluation"
n_frame -> n_body: "no GC path still\nneeds body contract"
n_reissue -> n_body: "already built packet, no\nreconstruction"
n_input -> n_custody: "reserve input/native/control lifetime"
n_custody -> n_grant: "canonical ticket identity and\ninterval owner"
n_custody -> n_deny: "lost ACK -> query,\nretain debt"
n_formal -> n_consume: "atomic cancel/enter and interval\nproof"
n_formal -> n_reissue: "stamp expiry and source\nboundaries"
