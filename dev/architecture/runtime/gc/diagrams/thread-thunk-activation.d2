direction: down
vars: { d2-config: { theme-id: 0 } }
n_origin: { label: "Caller root before resize GC" }
n_desc: { label: "VM bootstrap descriptor and leases" }
n_member: { label: "Membership and OS create" }
n_child: { label: "Child bind and sync loop" }
n_reload: { label: "Context ready and reload roots" }
n_main: { label: "Permanent module origin qualification" }
n_scope: { label: "NativeActivationScope accept" }
n_marker: { label: "Marker allocate and reload" }
n_catch: { label: "Call or rethrow to catcher" }
n_cleanup: { label: "One cleanup claim and settle" }
n_retire: { label: "Drain root readers and deliver status" }
n_unknown: { label: "Unknown result retains VM custody" }
n_origin -> n_desc: "register before possible\nGC"
n_desc -> n_member: "lease before publish"
n_member -> n_child: "child before creator\nreturn"
n_child -> n_reload: "no raw cache\nacross loop"
n_reload -> n_scope: "source overlap until\naccepted"
n_main -> n_scope: "other actual run\ncaller"
n_scope -> n_marker: "safe slots first"
n_marker -> n_catch: "unique marker ownership"
n_catch -> n_cleanup: "END_TRY restored"
n_cleanup -> n_retire: "settled clear and\ndrop"
n_member -> n_unknown: "lost result"
n_cleanup -> n_unknown: "unknown cleanup"
n_unknown -> n_desc: "same identity retained"
