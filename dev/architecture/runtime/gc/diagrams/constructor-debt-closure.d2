direction: down
reserve: { label: "Pre-backed ticket + dependency/result slots\nScheme/native inputs remain rooted" }
native: { label: "Native producer / exact staged resource duty\naccept, process creation, message consume" }
known: { label: "Captured native result escrow\nwrapper conversion may invoke GC" }
callback: { label: "Suspended callback / ancestor frames\nonly a fully covered stop cut qualifies" }
isolated: { label: "Native-only bounded outcome unknown\nno managed access / callback / hidden roots" }
freeze: { label: "Close managed publication authority\nfreeze epoch + root/custody view" }
scan: { label: "Independent bounded root scan\nnever acquire owner port mutex" }
seal: { label: "Whole-round gates + covered debt zero\nbusiness completion may remain pending" }
resume: { label: "Consume seal and reacquire runtime\nrestore roots / writer permission" }
result: { label: "Exact result-slot query or one conversion\nroot result before delivery / rollback" }
retain: { label: "Unknown GC-critical metadata\nretain custody; refuse this resume" }
refund: { label: "Known disposal + readers/children drain\nphysical backing release then ticket recycle" }
formal: { label: "SysML -> ASCENT -> QNT / Lean\nsource and C-memory gates open" }
reserve -> native: "reserve before irreversible effect"
native -> known: "capture exact output"
native -> callback: "real reentrant stop cut"
native -> isolated: "qualified native-only effects"
known -> freeze: "before\nwrapper\nallocation"
callback -> freeze: "all\nparent/callback\nroots"
isolated -> freeze: "bounded\nresource-only\nuncertainty"
freeze -> scan: "immutable complete view"
scan -> seal: "current-round\ntrace\nreceipt"
seal -> resume: "no GC -> owner-return edge"
resume -> result: "query / convert / preserve original error"
result -> refund: "known custody and disposition"
freeze -> retain: "unknown\nwriters\n/\nroots\n/\nlease"
result -> retain: "unknown\nmanaged\npublication"
formal -> seal: "conditional\nmodel\nonly"
