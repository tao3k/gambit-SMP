direction: down
classes: {
  source: {style.fill: "#e8f1fb"; style.stroke: "#346a98"}
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  gate: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "Still-object teardown is a counted producer\nPublic head empty is not discovery complete" {shape: text}
origins: "Actual origins\nGC sweep / explicit release / conversion rollback\nForeign still teardown / native group cleanup" {class: source}
close: "RPS01--02 / close independent births and exports\nKeep issued creator / finalizer / discovery permits\nSettle managed-owner work while VM is live" {class: proposed}
origins -> close
cursor: "RPS03 / before list detach\nKeep SourcePermit + private cursor / wrapper custody\nstill_objs = 0 does not remove this producer" {class: proposed}
close -> cursor
capture: "RPS04--05 / admitted effect profile\nCapture native data, payload, code and nested pins into R\nOR complete owner release\nOnly then invalidate / free wrapper" {class: proposed}
cursor -> capture
children: "Permitted reentry / derived registrations\nReserve child or producer credit BEFORE publication\nRevisit new admitted work before seal\nUnsupported effects remain outside cohort" {class: gate}
capture -> children: "if permitted by profile"
retained: "Slot exhaustion / exception / unknown alias\nRetain real wrapper / payload dependencies\nOR finish admitted owner release\nNo silent free / credit drop" {class: gate}
capture -> retained: "capture cannot complete"
seal: "RPS06 / producer seal\nIndependent births closed + all issued permits resolved\nPublic and private discovery exhausted / transferred\nGroup and wrapper triggers converge on ResourceId" {class: proposed}
capture -> seal: "known disposition / counted transfer"
children -> seal: "all derived obligations covered"
retained -> seal: "only after real disposition / independent transfer"
frontier: "RPS07 / separate cleanup cuts\nResidual RC membership safe before cleanup_rc\nTasks + callbacks + notifications + actual readers drain\nThen stop / join / OS / provider teardown" {class: gate}
seal -> frontier
