direction: down
vars: { d2-config: { theme-id: 0 } }
n_anchor: { label: "Resident fixed VM router outside GSTATE" }
n_setup: { label: "Checked fresh setup session" }
n_ready: { label: "Fully initialized Online VM" }
n_origin: { label: "Pre-admitted base or parent origin mailbox" }
n_bind: { label: "Reserve cell and authoritative locator" }
n_recover: { label: "Lost reply reads same journal" }
n_effect: { label: "Bound activation and rechecked user effect gate" }
n_close: { label: "Quiescing: status only for user requests" }
n_admin: { label: "Reserved administrative cleanup lane" }
n_settle: { label: "Child/source/result/GC readers drain" }
n_detach: { label: "Router detach; old pins retain storage" }
n_free: { label: "Physical GSTATE/VM cleanup" }
n_restart: { label: "Fresh session rejects old keys" }
n_late: { label: "Late token checked before VM dereference" }
n_anchor -> n_setup: "anchor outlives every\nsetup attempt"
n_setup -> n_ready: "complete staged construction"
n_ready -> n_origin: "bounded root/host entry\npermit"
n_origin -> n_bind: "one live serial\nper origin"
n_bind -> n_recover: "normal return may\nbe lost"
n_recover -> n_bind: "reuse locator; never\nre-reserve"
n_bind -> n_effect: "Bound before native\neffects"
n_ready -> n_close: "cleanup closes new\nuser effects"
n_close -> n_admin: "independent of W\nuser capacity"
n_effect -> n_settle: "exact source and\nresult settlement"
n_admin -> n_settle: "stop/result receipt required"
n_settle -> n_detach: "all debts known\nclosed"
n_detach -> n_free: "only after router\npins drain"
n_free -> n_restart: "anchor epoch is\nnot reset"
n_restart -> n_late: "old session/slot tag\nrejects"
n_anchor -> n_late: "stable gate before\nany VM read"
