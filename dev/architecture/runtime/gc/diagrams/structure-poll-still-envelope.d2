direction: down
poll: { label: "First structure POLL: save internal return" }
stack: { label: "Stack section assignment / pool / sharing" }
effects: { label: "Interrupt effects + exits + captures" }
frames: { label: "Recursive stack8 / heap frame7" }
gc: { label: "GC backing + readers + copy work" }
still: { label: "Still charge a+6; native allocation" }
init: { label: "refcount dec -> initialize; no GC ack" }
return: { label: "Rooted result; unwind recursive frames" }
pool: { label: "Stack undo: pool reuse, not free" }
free: { label: "Last alias + readers -> actual shrink/sweep free" }
hold: { label: "Failure / unknown: durable custody" }
peak: { label: "All actual backing phases; Qg omission vs late Qo" }
poll -> stack: "stack cause"
poll -> effects: "all slow returns"
stack -> gc: "GC requested"
effects -> frames: "bounded admitted continuation"
frames -> gc: "later POLL / frame copy"
gc -> frames: "fresh current binding"
frames -> still: "base case n=a"
still -> gc: "charge requests GC before allocation"
still -> init: "known successful pointer"
init -> return: "complete initialization"
return -> pool: "break undo"
pool -> free: "not enough without death/drain"
still -> hold: "known failure / unknown service"
gc -> hold: "forwarded incomplete work"
hold -> peak: "retained peak cost"
free -> peak: "late free retains history"
gc -> peak: "preaccepted omitted acquisition"
effects -> peak: "unknown budget forbids finite receipt"
