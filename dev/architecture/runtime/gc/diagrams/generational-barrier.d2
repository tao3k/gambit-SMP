direction: down
semantic: { label: "Scheme semantic StorePlan: proved\nelision / declared checkpoints" }
writeOp: { label: "Finite noncollecting store / bulk\n/ CAS" }
cards: { label: "Durable per-region dirty cards" }
hints: { label: "Bounded local hints + sticky\noverflow" }
cut: { label: "Same-epoch cut: all writers\nsettled / roots parked" }
capacity: { label: "Physical destination + copy-work\nreserve" }
pendingCopy: { label: "Forwarding visible: copy\ninitialization still owned" }
readyCopy: { label: "Ready payload + descendant scan +\nalias rewrite" }
complete: { label: "Epoch completion / dirty reset /\nsource reclaim\nReturn to writeOp:\nnext epoch" }
retry: { label: "Pre-forward failure: retain\noriginal stores and dirty\nstate\nReturn to writeOp: safe\ncheckpoint retry / error" }
quarantine: { label: "Post-forward unexpected failure:\nretain both spaces / debts" }
semantic -> writeOp: "plan"
writeOp -> cards: "mark"
writeOp -> hints: "hint"
cards -> cut: "bitmap"
hints -> cut: "hints"
cut -> capacity: "settle"
capacity -> pendingCopy: "accept"
capacity -> retry: "reject"
pendingCopy -> readyCopy: "ready"
pendingCopy -> quarantine: "hold"
readyCopy -> complete: "finish"
