direction: down
spans: { label: "Scheme spans and resume demands" }
plan: { label: "Backed copy fence plus future context suffix" }
guard: { label: "AllocationCheckSpec: allowance plus guard" }
copy: { label: "Copy stays outside guaranteed suffix" }
commit: { label: "Confirm ownership and current binding" }
resume: { label: "Context resumes under fresh assurance" }
peaks: { label: "Compare every phase with matched baseline" }
refund: { label: "Late surplus: refund only after known commit and drain" }
hold: { label: "Keep pending work and owned extents" }
spans -> plan: "place"
spans -> guard: "bound"
guard -> plan: "role demand"
plan -> copy: "preflight"
copy -> commit: "ready"
commit -> resume: "known"
plan -> hold: "refused/unknown"
commit -> hold: "unknown reply"
resume -> peaks: "observe"
copy -> refund: "opportunistic"
refund -> peaks: "preserve past peak"
commit -> refund: "known commit/drain"
