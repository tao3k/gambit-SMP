direction: down
vars: { d2-config: { theme-id: 0 } }
n_port: { label: "Preinstalled safe empty root port" }
n_source: { label: "Complete registered source frozen" }
n_intent: { label: "Immutable intent and source custody" }
n_claim: { label: "Ownership CAS may execute late" }
n_private: { label: "Private control fields and progress logs" }
n_locator: { label: "Exact locator; safe false payload" }
n_root: { label: "GC-aware current root admission" }
n_commit: { label: "Final release commit before native effect" }
n_exit: { label: "Owner exit observed: still unknown" }
n_stop: { label: "Data and control writers verifiably closed" }
n_help: { label: "Exclusive helper repairs private control only" }
n_gc: { label: "GC scans old view or canonical moved root" }
n_ack: { label: "Separate source/result/reader settlement" }
n_free: { label: "Recycle only exact owned support" }
n_port -> n_source: "no marker before\nroot coverage"
n_source -> n_intent: "bounded first origin\nadmission"
n_intent -> n_claim: "journal precedes possible\nCAS"
n_claim -> n_private: "exact header lease\nowns init"
n_private -> n_locator: "store and progress\nare separate"
n_locator -> n_root: "current source reload\nafter close"
n_root -> n_commit: "metadata and root\nreceipt required"
n_claim -> n_exit: "missing return or\ninterrupted owner"
n_private -> n_exit: "partial store outcome\nunknown"
n_exit -> n_stop: "observation is not\nstop proof"
n_stop -> n_help: "no old control\nor data writes"
n_help -> n_locator: "idempotent metadata; no\npayload replay"
n_source -> n_gc: "old source remains\nscanned"
n_root -> n_gc: "collector updates accepted\nroot"
n_commit -> n_ack: "commit is not\nfinal ACK"
n_gc -> n_ack: "physical scan view\nmust drain"
n_ack -> n_free: "checked lease and\nreader closure"
