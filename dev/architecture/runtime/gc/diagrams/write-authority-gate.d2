direction: down
vars: { d2-config: { theme-id: 0 } }
n_layout: { label: "VM fixed records initialized before exposure" }
n_prepare: { label: "Stable prepared actor candidate" }
n_cas: { label: "Single full-header handoff CAS" }
n_owner: { label: "New owner control and data permits live" }
n_close: { label: "Close CAS rejects later acquisitions" }
n_drain: { label: "Real last-use release; spent bits retained" }
n_next: { label: "Drained closed header; next checked generation" }
n_unknown: { label: "Unknown writer stays live; no forced release" }
n_future: { label: "Future generator catcher thread last-use adapters" }
n_layout -> n_prepare: "live VM storage\nrequired"
n_prepare -> n_cas: "candidate retained before\neffect"
n_cas -> n_owner: "no unaccounted reply\ngap"
n_owner -> n_close: "exact-generation close"
n_close -> n_drain: "existing permits survive"
n_drain -> n_next: "all roles drained"
n_next -> n_prepare: "helper can interrupt\nagain"
n_close -> n_unknown: "failed join or\nunknown store"
n_future -> n_drain: "not enabled in\nfirst patch"
