direction: down
classes: {
  actual: {style.fill: "#e8f1fb"; style.stroke: "#346a98"}
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  boundary: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "SegmentLayout / next GC with prefix and context objects\nStorage classification does not create reachability" {shape: text}
cut: "NGC01--02 / final roots and source layout cut\nPause/qualify all writers; settle pending constructors\nCommitted object runs / gaps / actual overrun objects\nSource(E): copied prefix + context suffix in the same half" {class: proposed}
title -> cut: {style.opacity: 0}
roots: "NGC05 / actual root cells\nRegisters / frames / saved / RC / still / globals / carriers\nFollow prefix <-> suffix and cross-context fields\nRelocate each distinct physical cell / do not root whole runs" {class: proposed}
cut -> roots
dest: "NGC03--04 / actual destination layout and one VM epoch\nOpposite half usable only after its old borrowers drain\nW copy arenas differ from U context resume areas\nPin source halves for forwarding and later phases" {class: proposed}
cut -> dest
copy: "NGC06 / trace -> copy -> copy-complete work\nRead actual old object header from a valid rooted base\nNew destination chunks use this epoch and valid grammar\nForwarding visibility alone does not prove body readiness" {class: proposed}
roots -> copy
dest -> copy
source: "IS-S14--16 / source mechanism\nRoot-directed mark_array / subtype scanning\nNew complete/partial destination chunk work\nNo unconditional old-prefix-as-root scan" {class: actual}
copy -> source
later: "NGC07--08 / complete all admitted phases and writes\nWeak / wills / continuation / cleanup / capacity / resume\nActual extents counted once; carried still quota separate\nNew root/layout binding precedes context resume" {class: proposed}
copy -> later
retire: "NGC09 / retire actual users before half reuse or shrink\nLive copied/new objects keep VM section ownership\nOld queues / diagnostics / native borrowers remain pins\nWorker scratch lifetime is not section lifetime" {class: proposed}
later -> retire
failed: "NGC10 / failure after forwarding\nRetain actual VM / roots / source and destination layout\nNo timeout restore of old hp / headers / half orientation\nNo finite recovery or positive net bound established" {class: boundary}
retire -> failed
