direction: down
n_caller: { label: "Scheme call preparation" }
n_root: { label: "Typed RootView / conversion prefix" }
n_gate: { label: "VM gate: roots, layout debt, ticket state" }
n_arena: { label: "Mutator layout adapter / existing allocator" }
n_active: { label: "Bounded argument shuffle / rest construction" }
n_park: { label: "Complete FrameSpec / parked roots" }
n_gc: { label: "GC exclusive scan / relocation" }
n_resume: { label: "Context seal / acquire reload" }
n_models: { label: "ASCENT needs -> QNT / Lean" }
n_unknown: { label: "Canonical arena/native escrow" }
n_caller -> n_root: "preserve evaluated inputs"
n_root -> n_gate: "register and publish"
n_gate -> n_arena: "layout operation pin"
n_arena -> n_gate: "known commit or\ndeny"
n_arena -> n_unknown: "unknown result retains\nduty"
n_gate -> n_active: "atomic enter before\nclose"
n_active -> n_park: "finish despite close"
n_gate -> n_park: "cancel unused then\nfreeze"
n_park -> n_gc: "zero debt and\nwriters"
n_gc -> n_resume: "publish relocation and\ncontext seal"
n_resume -> n_root: "reload same logical\ncall"
n_gate -> n_models: "component model obligations"
n_unknown -> n_park: "reconcile before freeze"
