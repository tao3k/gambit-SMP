direction: down
bound: { label: "Closed layout demand" }
region: { label: "Actual extent placement receipt" }
copy: { label: "Copy prefix and settle scan debt" }
offer: { label: "Freeze suffix and offer transfer" }
commit: { label: "One authoritative ownership commit" }
context: { label: "Context allocates committed suffix" }
pins: { label: "Local, queued and dequeued reader pins" }
retire: { label: "Retire old descriptor and close new readers" }
reset: { label: "Drain tokens then recycle metadata" }
hold: { label: "Retain custody and query unknown outcome" }
bound -> region: "place"
region -> copy: "accepted"
region -> hold: "partial/refused"
copy -> offer: "ready"
offer -> commit: "accepted"
commit -> context: "read back"
commit -> hold: "unknown ack"
copy -> pins: "borrow"
pins -> retire: "close ingress"
retire -> reset: "zero readers"
