direction: down
n_scheme: { label: "Scheme conversion / exception semantics\ntyped exit and cleanup plan" }
n_local: { label: "SFUN / CFUN local effects\nconversion + marker + result root" }
n_catcher: { label: "Restore exact own catcher\ninline reload; OOL caller ticket" }
n_reserve: { label: "Reserve outer receiver duty\nbefore source can close" }
n_ready: { label: "ActivationExitReady\nlocal effects closed" }
n_propagate: { label: "propagate / THROW / GVM dispatch\ncounted successor effects" }
n_borrow: { label: "Receiver + caller postlude closed\ncallback source pins checked separately" }
n_callback: { label: "Reserve cleanup child before exposure\nVM transfer keeps data debt" }
n_vm: { label: "VM custody and physical root/domain audit" }
n_cleanup: { label: "PSTATE data cleanup permit\nVM-independent child may remain" }
n_seal: { label: "DataWriteClosed / domain freeze\nadmission closed + current debt0\nfuture task retains custody" }
n_retain: { label: "Unknown target / callback / join\nretain roots and native envelope" }
n_formal: { label: "SysML -> ASCENT -> QNT / Lean\nsource and C profile gaps open" }
n_scheme -> n_local: "generate\nper\nexit\nvariant"
n_local -> n_catcher: "last\nlocal\neffects\nsettled"
n_catcher -> n_reserve: "exception\nor\nhandler\nroute"
n_reserve -> n_ready: "successor\ncounted\nfirst"
n_catcher -> n_ready: "normal\nno-error\nroute"
n_ready -> n_propagate: "successor\nowns\npending\neffects"
n_propagate -> n_borrow: "receiver\nand\ncaller\nfinish"
n_ready -> n_callback: "before\ndestructive\ncleanup"
n_callback -> n_vm: "independent\nroot/native\ncustody"
n_borrow -> n_cleanup: "original\n/\nreceiver\n/\ncaller\npins\nzero"
n_vm -> n_cleanup: "observed\nphysical\nacceptance"
n_callback -> n_seal: "drain\ncurrent\neffects\nor\nqualified\nfuture\ngate"
n_borrow -> n_seal: "all\ncurrent\npropagation\ndrained"
n_vm -> n_seal: "closed\nregistered\nroot\nview"
n_cleanup -> n_retain: "unknown\nnative\nenvelope"
n_propagate -> n_retain: "unknown\nlive\ntarget\nor\nresult"
n_formal -> n_reserve: "debt\npreservation"
n_formal -> n_seal: "conditional\nsource\nrefinement"
