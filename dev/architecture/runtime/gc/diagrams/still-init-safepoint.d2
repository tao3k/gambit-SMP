direction: down
roots: { label: "Activation-owned type/result roots" }
alloc: { label: "Known private allocation / linked still body" }
init: { label: "Initializer owns prefix; no GC ack or callback" }
request: { label: "GC request / trip / pending interrupt" }
publish: { label: "Complete body + result roots + required remembered coverage" }
gc: { label: "Fresh participant acknowledgement -> GC" }
callback: { label: "Deliver handler / nested callback with child root token" }
exit: { label: "Own-only cleanup; retain outer roots and captured state" }
unknown: { label: "Unknown result: full storage + roots + same operation" }
peak: { label: "All-phase backing, root and pending-record peak" }
roots -> alloc: "root before allocation"
alloc -> init: "pointer is not initialization receipt"
init -> publish: "finish original fill"
request -> init: "pending request does not force entry"
publish -> gc: "exact epoch + roots"
publish -> callback: "safe callback boundary"
gc -> callback: "after GC restore current roots"
callback -> exit: "child cleanup only"
exit -> roots: "parent survives"
roots -> unknown: "service result unknown"
unknown -> init: "resolve same ID; initializer continues"
unknown -> peak: "charge whole possible block"
init -> peak: "hold root/init metadata"
exit -> peak: "captured aliases delay free"
