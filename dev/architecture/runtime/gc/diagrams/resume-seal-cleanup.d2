direction: down
phases: { label: "Strong + weak frontier closed\nroot/view obligations retained" }
profile: { label: "Origin + effect + delay admission\nreserve native/root/code/wait budget" }
handoff: { label: "Canonical accepted release task\nsource -> service custody" }
cleanup: { label: "GC cleanup handback\nno wait for owner callback" }
prepare: { label: "Capacity outcome + context prepare\nresult / writer / binding checks" }
seal: { label: "WholeRoundResumeSeal\nactive permit then root reload" }
owner: { label: "Owner callback / native executor\nqualified activation + WaitContext" }
outcome: { label: "Known effects + storage disposition\nseparate native backing release" }
unknown: { label: "Unknown GC-critical state\nretain custody; refuse resume" }
isolated: { label: "Isolated native result unknown\nretain backing; no replay" }
formal: { label: "SysML -> ASCENT\nQNT / Lean / source-order gaps" }
profile -> handoff: "reserve before destructive detach"
phases -> handoff: "roots covered; no unseen edges"
handoff -> cleanup: "known accepted custody"
cleanup -> prepare: "critical debt settled"
prepare -> seal: "all current-round gates"
handoff -> owner: "native-only may run; managed waits seal"
seal -> owner: "callback permission after reload"
owner -> outcome: "publish actual disposition"
owner -> isolated: "lost isolated native outcome"
handoff -> unknown: "unknown acceptance or root transfer"
prepare -> unknown: "unknown capacity / binding / gate"
isolated -> cleanup: "allowed only under proved isolation"
outcome -> cleanup: "known completion also admissible"
formal -> seal: "conditional refinement only"
