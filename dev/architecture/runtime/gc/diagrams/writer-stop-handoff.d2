direction: down
vars: { d2-config: { theme-id: 0 } }
n_source: { label: "Registered frozen source and VM journal" }
n_entry: { label: "Race-safe writer admission" }
n_store: { label: "Physical write may precede progress" }
n_close: { label: "Close future data and control authority" }
n_funnel: { label: "Generated post-catcher exit and debt drain" }
n_stop: { label: "Exact generation data/control seals" }
n_helper: { label: "New helper generation; same canonical journal" }
n_unknown: { label: "Unknown stop: retain VM custody" }
n_gc: { label: "Independent scan of frozen source" }
n_reclaim: { label: "Result ACK and all readers drained" }
n_plan: { label: "modern-c source implementation action board" }
n_source -> n_entry: "roots precede native\neffect"
n_entry -> n_store: "permit owns in-flight\nstore"
n_store -> n_close: "exit may interrupt\nagain"
n_close -> n_funnel: "cooperative qualified route"
n_funnel -> n_stop: "actual no-future and\nno-inflight"
n_stop -> n_helper: "acquire exact seals\nbefore successor"
n_helper -> n_store: "helper can itself\nbe interrupted"
n_close -> n_unknown: "unverified stop or\nraw borrower"
n_unknown -> n_source: "preserve root slot\nand journal"
n_source -> n_gc: "no callback needed\nif frozen"
n_stop -> n_reclaim: "separate result and\nscan settlement"
n_gc -> n_reclaim: "scan pin must\ndrain"
n_plan -> n_funnel: "generator catcher thread\npatch chain"
