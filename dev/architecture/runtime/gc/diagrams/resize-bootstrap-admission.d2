direction: down
vars: { d2-config: { theme-id: 0 } }
n_rootView: { label: "Generated frame and full caller view" }
n_freeze: { label: "Freeze caller and stop raw borrows" }
n_gate: { label: "Register versus GC close" }
n_pending: { label: "Frozen caller retains late descriptor" }
n_reload: { label: "GC update and source reload" }
n_root: { label: "VM bootstrap root and child ledger" }
n_routing: { label: "Prepared routing; old GC membership" }
n_create: { label: "Per-child OS creation and binding" }
n_commit: { label: "All-ready generation commit" }
n_run: { label: "Post-sync reload to activation" }
n_abort: { label: "Partial failure; close and retain" }
n_drain: { label: "Exact no-child or stop; reader drain" }
n_retire: { label: "Cleanup exact child then retire root" }
n_rootView -> n_freeze: "reuse precise stack\nslots"
n_freeze -> n_gate: "single admission cut"
n_gate -> n_pending: "close wins"
n_pending -> n_reload: "no raw borrow\nwhile waiting"
n_reload -> n_gate: "same identity retry"
n_gate -> n_root: "register wins"
n_root -> n_routing: "root before routing"
n_routing -> n_create: "one attempt per\nchild"
n_create -> n_commit: "all requested ready"
n_commit -> n_run: "shared membership generation"
n_create -> n_abort: "known failure or\nunknown"
n_abort -> n_drain: "no bulk rollback"
n_drain -> n_retire: "only proven stopped\nchildren"
n_abort -> n_root: "unknown stays VM\nowned"
