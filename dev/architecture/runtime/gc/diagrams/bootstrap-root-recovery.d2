direction: down
vars: { d2-config: { theme-id: 0 } }
n_origin: { label: "Generated mapped origin and invocation key" }
n_ledger: { label: "Canonical record and immutable intent" }
n_close: { label: "GC close: frozen source remains" }
n_accept: { label: "One accepted descriptor root" }
n_query: { label: "Pinned status query; revalidate ACK" }
n_ack: { label: "One extra source lease ACK" }
n_pin: { label: "Old scanner/borrowers drain" }
n_restore: { label: "Restored binding and reload" }
n_exitGuard: { label: "VM escrow and close before exit" }
n_result: { label: "Terminal result accepted" }
n_fence: { label: "Drain readers; keep retired-key fence" }
n_late: { label: "Late retry rejected; no recreation" }
n_origin -> n_ledger: "reserve before possible\neffect"
n_ledger -> n_close: "close wins"
n_close -> n_ledger: "same key after\nreload"
n_ledger -> n_accept: "register wins"
n_accept -> n_query: "reply lost or\nstatus needed"
n_ledger -> n_query: "query pending or\nabsent"
n_query -> n_ack: "exact canonical custody"
n_ack -> n_pin: "logical is not\nphysical release"
n_origin -> n_restore: "same live invocation\nrestores"
n_restore -> n_query: "old source and\nnew pin differ"
n_origin -> n_exitGuard: "exception or native\nescape"
n_exitGuard -> n_query: "VM queries or\ncancels"
n_pin -> n_result: "separate result handoff"
n_result -> n_fence: "all lifetime gates"
n_fence -> n_late: "persistent rejection after\npurge"
