direction: down
classes: {
  actual: {style.fill: "#e8f1fb"; style.stroke: "#346a98"}
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  boundary: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "Still construction / four distinct cuts\nConditional design / no implementation or native qualification" {shape: text}
grant: "SCO01 / activated Reserved grant\nG batch authority -> pinned H claim\nEnrolled constructor / inputs / VM / native dependencies" {class: proposed}
title -> grant: {style.opacity: 0}
alloc: "SCO02 / Claimed -> native allocation outside gates\nKnown no-effect failure: UnusedRefunded\nUnknown effect: retain claim and custody / no retry" {class: proposed}
grant -> alloc
consumed: "SCO03 / credit consumption cut under H\nConsumed(AllocationId) + private actual block charge\nContainer / aligned base / deallocator known\nNot scan-visible or Scheme-visible yet" {class: proposed}
alloc -> consumed: "known storage"
profile: "SCI01--04 / subtype-specific initialization\nPrivateAtomicInit: no final GC ack until settled\nScanReadyConstruction: legal fields / metadata / roots\nForeign destructor arm has its own ownership cut" {class: proposed}
consumed -> profile
scan: "SCO04--05 / scan publication cut\nSafe stores -> actual C root/list membership -> G epoch\nConstruction lease spans all gaps\nAcquire / relocation / exact root writer required" {class: proposed}
profile -> scan
language: "SCO06 / language publication cut\nSemantic fields complete / actual rooted destination\nThen release construction rooting under GC protocol\nDropping still refcount is not freeing the block" {class: proposed}
scan -> language
free: "SCO07--08 / physical reclamation cut\nAll real readers / effects / constructors drained\nActual free settled -> remove actual charge once\nConsumed grant never becomes unused refund" {class: proposed}
language -> free
consumed -> free: "known private abort after user/effect exclusion"
source: "SCU02--05 / real caller evidence\nUTF-8 post-allocation error only decrements\nUDP successful result also decrements\nWeak metadata and foreign release fields matter" {class: actual}
profile -> source
held: "No guessed cleanup\nUnknown allocation / free / membership / arm retains owner\nForce cleanup must drain constructors and native users\nC and Zig owe the same runtime protocol" {class: boundary}
free -> held
