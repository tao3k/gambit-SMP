direction: down
n_entry: { label: "Real rest entry\nGET_REST / native callback envelope" }
n_lease: { label: "Reserve physical repair + root lease\nclose new relevant writers / borrowers" }
n_repair: { label: "CONS remaining args in order\nno collection or managed handler" }
n_packet: { label: "Initialize every vector slot\nproc + completed args packet" }
n_frame: { label: "Scheme helper full frame\nR0/proc/args + map + RA/W_ALL" }
n_offer: { label: "Publish exact rooted frame generation\nsource pins until canonical accept" }
n_acceptPark: { label: "VM accepts same park attempt\nscan / exit / resume arbitration" }
n_scan: { label: "Collector updates root cells\nrelease scan/readers + whole round" }
n_prepare: { label: "Context prepare + same owner bind\nreload relocated proc / vector" }
n_resumeCall: { label: "Fresh next epoch normal OR exit claim\nnargs=-1 / same native call" }
n_custody: { label: "Native stack/catcher/root/code custody\ntransfer is not disposal" }
n_refuse: { label: "Unknown write / capacity / dead frame\nretain source or canonical VM debt" }
n_formal: { label: "SysML -> ASCENT -> QNT / Lean\nsource and native-order gaps open" }
n_entry -> n_lease: "before destructive argument pops"
n_lease -> n_repair: "known physical budget and\nlocal roots"
n_repair -> n_packet: "all excess pairs completed"
n_packet -> n_frame: "no partial vector published"
n_frame -> n_offer: "last write and root\nspill complete"
n_offer -> n_acceptPark: "atomic accept, not ACK\ndelivery"
n_acceptPark -> n_scan: "acquire updateable complete view"
n_scan -> n_prepare: "whole-round readiness, not notification"
n_prepare -> n_resumeCall: "exclusive claim; no replay\nor re-CONS"
n_custody -> n_lease: "native/root/control budget retained"
n_custody -> n_acceptPark: "original catcher and result\ncontract"
n_custody -> n_resumeCall: "same native stack stays\nlive"
n_entry -> n_custody: "retain invocation envelope"
n_lease -> n_refuse: "unknown physical or effect\nproof"
n_offer -> n_refuse: "unknown acceptance -> same-key\nquery"
n_prepare -> n_refuse: "scan/owner/root readiness unknown"
n_formal -> n_frame: "construction and frame evidence"
n_formal -> n_resumeCall: "exclusive terminal claim and\nlineage"
