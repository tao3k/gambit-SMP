direction: down
legacy: { label: "Legacy counters\nL / D / VM charge / request phase" }
cut: { label: "Closed adoption cut\nvalid chain + settled native calls" }
intent: { label: "Allocation intent\nunbacked grant or private backing" }
domain: { label: "Canonical inventory\npublished / private / retired / grants" }
mark: { label: "Canonical mark service\nowner change preserves scan grant" }
sweep: { label: "Sweep / relink / logical retirement\nnew inventory revision" }
view: { label: "Revision-bound ledger view\nnot a payload capability" }
commit: { label: "Owner-generation commit\nshared admission gate" }
unknown: { label: "Unknown malloc/free outcome\nretain custody; no blind retry" }
release: { label: "Physical free acknowledgement\nremove charge once" }
pins: { label: "Old metadata pins / raw borrowers\ndifferent lifetime obligations" }
legacy -> cut: "scalars cannot reconstruct arbitrary cut"
cut -> domain: "one-time inventory adoption"
intent -> domain: "attach without double charge"
intent -> unknown: "outcome missing"
domain -> mark: "trace published admitted roots only"
mark -> sweep: "mark/worker closure before sweep"
sweep -> domain: "publish new revision"
domain -> view: "capture same root/inventory/ledger epoch"
view -> commit: "matching revision and no mutation grant"
sweep -> view: "invalidate prepared view"
commit -> mark: "mark authority unchanged"
sweep -> release: "retired charge retained until receipt"
release -> domain: "debit held backing once"
pins -> view: "pin immutable metadata only"
pins -> release: "raw borrow must close before free"
unknown -> cut: "block adoption until outcome/integrity known"
