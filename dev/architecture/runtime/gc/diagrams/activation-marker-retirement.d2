direction: down
entry: { label: "Typed marker + stable root admission\nactivation generation / transport identity" }
reserve: { label: "Queue / reserve return intent\nmetadata protection; revocable" }
arbiter: { label: "Original-owner activation arbiter\ncommit return OR close admission" }
returning: { label: "ReturnCommitted -> matching consume\nfresh legal return may use same marker" }
closed: { label: "Close reservations + accept backed duty\npublish Closed before C pop" }
view: { label: "Published / scanning root view\nphysical permit mutually exclusive" }
clear: { label: "Root + stopped writer + heap permit\nclear marker; reconcile only idempotent store" }
ledger: { label: "Managed root-pin release receipt\nnew cohort has no raw --" }
legacy: { label: "Legacy raw decrement unknown\nretain exact root and duty; never replay" }
gc: { label: "Root-domain tracing + actual heap reachability\ncaptured continuation may retain closed marker" }
retire: { label: "Object borrow / metadata readers separate\nrecord reuse after exact pin drain" }
formal: { label: "SysML -> ASCENT -> QNT / Lean\nsource / C-memory refinements open" }
entry -> reserve: "protect\nbefore\nlookup\nuse"
reserve -> arbiter: "intent\nis\nnot\njump\nright"
arbiter -> returning: "return\ncommits\nfirst"
returning -> arbiter: "consume\nbefore\nclose"
arbiter -> closed: "closing\ncommits\nfirst"
closed -> clear: "accepted\nduty"
view -> clear: "drain\nbefore\npermit"
clear -> ledger: "managed\nprofile"
clear -> legacy: "legacy\nprofile"
ledger -> gc: "release\nis\nnot\nfree"
legacy -> gc: "quarantine\nstrong\nroot"
gc -> retire: "real\nreachability\n/\nreaders"
reserve -> retire: "late\nreceipt\nread"
closed -> retire: "tombstone\nrejects\nlate\nreturn"
formal -> arbiter: "conditional\nmodel\nonly"
