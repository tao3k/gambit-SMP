direction: down
census: { label: "Closed nursery and stack extents" }
reserve: { label: "Physical destination plus resume reservation" }
copy: { label: "Unique claim, initialize, scan and rewrite" }
retained: { label: "Retain source/root/initialization custody" }
stage: { label: "Stage residual bitmap and seed or fallback" }
publish: { label: "Publish immutable next epoch descriptor" }
reset: { label: "Drain old bank readers then recycle" }
writers: { label: "Next epoch Scheme and FFI writers" }
census -> reserve: "bound"
reserve -> copy: "accepted"
reserve -> retained: "refused"
copy -> retained: "breach"
copy -> stage: "closed"
stage -> publish: "seeded"
publish -> reset: "acquired"
publish -> writers: "permit"
