direction: down
classes: {
  actual: {style.fill: "#e8f1fb"; style.stroke: "#346a98"}
  proposed: {style.fill: "#eee8fb"; style.stroke: "#7053a1"}
  gate: {style.fill: "#fff0d9"; style.stroke: "#ad7629"}
}
title: "GC / resize admission closure\nSource reference census is not dynamic caller qualification" {shape: text}
gc: "TGC01--03 / kernel + weak-table + bignum\nSaved generated C mirrors; still allocation\nDirect or late-bound public GC" {class: actual}
resize: "TGC04 / thread resize + native resize\nTGC06 / shutdown shrink\nDirect or GSTATE import" {class: actual}
request: "TAD01 / one public request authority\nVM / roots / argument / ABI / facility lease\nG admission; no lock-held wait\nDeferred is never false-success at old GC ABI" {class: proposed}
gc -> request
resize -> request
sync: "TGC05 + TAD02 / shared rendezvous\nInterrupt / processor error / start / fdset / actlog\nPreserve priority and GC argument combining\nRequest identity differs from participant identity" {class: actual}
request -> sync
scope: "TAD03 / selected parent operation scope\nGuard every private body / participant / phase\nNo external or generated bypass allowed" {class: proposed}
sync -> scope
rbody: "Admitted resize body\nPreserve count / thunk / error semantics" {class: proposed}
gbody: "Admitted collector body\nFinal roots / full phases / worker lifetime" {class: proposed}
scope -> rbody: "OP_VM_RESIZE"
scope -> gbody: "OP_GARBAGE_COLLECT"
rbody -> gbody: "TAD04 child scope / no gate reacquisition"
cut: "TAD06 / transfer cut and close\nOld parent / child work may finish\nHold new collect / root mutation / managed resume\nClosingTransfers preserves required GC\nFinal seal waits pending transfer resolution" {class: gate}
gbody -> cut: "terminal epoch / physical borrower drain"
open: "TGC07--08 / unresolved profile closure\nABI imports / macros / loaded clients / aliases\n58 native-symbol lines include noncalls\n55 managed-symbol lines include metadata / tests" {class: gate}
open -> scope: "must bind or exclude before qualification"
