direction: down
entry: { label: "structure entry: a actuals, p2" }
guard: { label: "Pair allocation then guard Bcross" }
complete: { label: "Completion grant: 3m+3, no GC" }
roots: { label: "Carrier and proc: complete rooted frames" }
collect: { label: "GC copy + future tail fence" }
commit: { label: "Ownership commit / readback" }
resume: { label: "Restore2, na=-1, heap0 -> POLL1" }
later: { label: "Frame8 per field, then small/still allocation" }
hold: { label: "Failure / unknown: retain roots and spaces" }
release: { label: "Last alias + reader drain -> region reuse/free" }
peak: { label: "All-phase physical maximum; Qg vs late Qo" }
entry -> guard: "admitted shape"
guard -> complete: "heap_limit requests GC"
complete -> roots: "finish unframed work"
roots -> collect: "GC admissible"
collect -> commit: "copy ready"
commit -> resume: "readback known"
resume -> later: "new PointId / poll rebind"
collect -> hold: "forwarded failure"
commit -> hold: "reply unknown"
hold -> commit: "resolve same operation"
resume -> release: "root detachment insufficient"
later -> release: "semantic death + leases"
collect -> peak: "preflight omission"
release -> peak: "late refund preserves history"
