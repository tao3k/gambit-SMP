direction: down
n_call: { label: "Same live native invocation\nTcl -> SFUN -> Scheme" }
n_close: { label: "Close new entry / nested admission\nexisting effects remain owed" }
n_drain: { label: "Safe point + complete init\ndrain relevant writes / borrows" }
n_spill: { label: "Materialize RA / frames / roots\nrevoke old mutator permit" }
n_offer: { label: "Offer updateable root view\nsource keeps backing pins" }
n_acceptPark: { label: "Canonical VM acceptance\nParticipatingParkReceipt" }
n_scan: { label: "Acquire scan claim\ncollector may update root cells" }
n_releaseScan: { label: "Release scan / root readers\nwhole-round result" }
n_prepare: { label: "Prepare context + same owner bind\nreload relocated roots" }
n_resumeCall: { label: "Fresh next-epoch resume claim\nsame native stack; starts stays1" }
n_custody: { label: "Native/root/code/result custody\ntransfer is not release" }
n_refuse: { label: "Unknown relevant write / dead frame\nretain debt; refuse unsafe receipt" }
n_formal: { label: "SysML -> ASCENT -> QNT / Lean\nsource and C-order gaps open" }
n_call -> n_close: "original stack and result\ncontract"
n_close -> n_drain: "close does not revoke\nissued work"
n_drain -> n_spill: "complete maps and census"
n_spill -> n_offer: "last write before publication"
n_offer -> n_acceptPark: "atomic accept; ACK may\nbe lost"
n_acceptPark -> n_scan: "acquire complete view"
n_scan -> n_releaseScan: "write back relocated roots"
n_releaseScan -> n_prepare: "round readiness, not notification"
n_prepare -> n_resumeCall: "exclusive claim before managed\naccess"
n_custody -> n_offer: "source pins before acceptance"
n_custody -> n_acceptPark: "VM control; native owner\nstill live"
n_custody -> n_resumeCall: "backing retained across GC"
n_call -> n_custody: "reserve roots/resources/code"
n_drain -> n_refuse: "unknown effect / borrow\n/ construction"
n_offer -> n_refuse: "unknown acceptance -> query,\nno replay"
n_prepare -> n_refuse: "dead/mismatched owner or stale\nroot"
n_formal -> n_acceptPark: "conditional receipt obligations"
n_formal -> n_resumeCall: "fresh authority + no\nreinvocation"
