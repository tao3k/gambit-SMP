direction: down
admit: { label: "Protect inputs + per-invocation record\nreserve result/root/right slots" }
freeze: { label: "Close managed writers and admission\npublish immutable descriptor set" }
scan: { label: "Collector owns root-cell relocation\ncurrent trace receipt + scan-pin drain" }
late: { label: "Late native-only result\nexact invocation generation; no managed edge" }
init: { label: "Known safe FOREIGN shell\nescrow retains native disposal authority" }
commit: { label: "Body ready + result rooted\ncanonical slot / ReleaseRight commit" }
nested: { label: "Child callback record before marker allocation\ncomplete parent chain, distinct result slot" }
reenter: { label: "Current whole-round seal + binding\nconsume view; reload relocated roots" }
deliver: { label: "Original owner / top live marker\nquery canonical result then deliver once" }
reclaim: { label: "Borrowers drain -> native disposal\nreaders/children drain -> record/ticket reuse" }
retain: { label: "Unknown stop / root / body / handoff\nretain custody; refuse this permission" }
formal: { label: "SysML -> ASCENT -> QNT / Lean\nsource and C-memory refinement open\nTask-local DSL; repository attestation unresolved" }
admit -> freeze: "root/procedure\nprotected\nbefore\npossible\nGC"
nested -> freeze: "ancestor\ndescriptors\nincluded"
freeze -> scan: "view\npublication\nis\nnot\ntrace\ncompletion"
late -> scan: "root\ntopology\nunchanged"
scan -> reenter: "trace current; no active scanner"
reenter -> init: "fresh root values / owner authority"
init -> freeze: "only\nwith\nknown\nstopped\nwriter\n/\nsafe\nshell"
init -> commit: "init\nowner"
commit -> deliver: "root\ncoverage\nprecedes\nownership\npublication"
nested -> deliver: "LIFO\nC-stack\nmarker\npermission"
late -> commit: "capture\nnative\nresult\nbefore\nconversion"
deliver -> reclaim: "ACK is not free"
init -> retain: "unknown\nprogress\nor\ninvalid\nshell"
reenter -> retain: "reject\nstale"
formal -> commit: "conditional\natomic\nabstraction\nonly"
