direction: down
n_intent: { label: "Immutable intent before link\nnode / old head / domain / root tickets" }
n_next: { label: "Private next = old head\nwrite may precede journal ACK" }
n_head: { label: "Atomic release head = node\nACK may still be absent" }
n_stop: { label: "Exact writer stop evidence\nlogical death / token change insufficient" }
n_classify: { label: "Stable exclusive domain\nold / node+next / unexpected head" }
n_recover: { label: "Reconstruct or confirm once\nno duplicate push / no native replay" }
n_root: { label: "Installed rooted result handle\npre-backed immutable DecisionEnvelope" }
n_decision: { label: "One canonical decision CAS\nresult + ticket role share authority" }
n_pending: { label: "Null before writer drain = Pending\nnonnull result is not GC permission" }
n_drain: { label: "Close original + every helper\nretain roots / data-write permit" }
n_gc: { label: "All data effects drained -> GC freeze\nmetadata-only reader may remain" }
n_refuse: { label: "Unknown stop / lock / structure\nretain custody; refuse freeze" }
n_formal: { label: "SysML -> ASCENT -> QNT / Lean\nC and platform refinements open" }
n_intent -> n_next: "known\npayload\nbefore\neffect"
n_next -> n_head: "next\nbefore\nhead\nrelease"
n_head -> n_stop: "interruption\n/\nmissing\nACK"
n_stop -> n_classify: "certified\nstop\n+\nlifetime"
n_classify -> n_recover: "old\nor\nexact\nnode\nhead"
n_classify -> n_refuse: "unexpected\nhead\n/\nlayout"
n_recover -> n_root: "finish\nexisting\noperation"
n_root -> n_decision: "prepare\nbefore\npublish"
n_decision -> n_pending: "query\nwithout\nreplay"
n_pending -> n_drain: "committed\nstill\nneeds\nclosure"
n_stop -> n_refuse: "unproven\n/\nfailed\njoin"
n_drain -> n_gc: "all\nlineages\n+\neffects"
n_drain -> n_refuse: "late\nwriter\nstill\npossible"
n_intent -> n_stop: "intent\nsurvives\nowner\nloss"
n_formal -> n_classify: "conditional\nrefinement"
n_formal -> n_decision: "single\noutcome\nauthority"
n_recover -> n_drain: "helper\nalso\nowes\nclosure"
n_pending -> n_refuse: "unsettled\nstop\nretains\ncustody"
