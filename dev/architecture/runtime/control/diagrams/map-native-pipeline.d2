direction: right
classes: {
  source: {style.fill: "#dbeafe"; style.stroke: "#2563eb"}
  proposal: {style.fill: "#ede9fe"; style.stroke: "#7c3aed"}
  open: {style.fill: "#ffedd5"; style.stroke: "#c2410c"}
}
src: "Real public map\nlist.scm 850-929\ncars / cdrs / apply" {class: source}
early: "Scheme semantic export\nclosure / call / capture / effects" {class: proposal}
gvm: "Normalize + GVM\nreuse lifting and frame/live analysis" {class: source}
complete: "Proposed semantic completion\ncall / return / roots / checks" {class: proposal}
product: "Common call/frame product service\nphysical maps / points / module" {class: proposal}
zig: "Zig hosts\nexplicit Scheme transfer state" {class: proposal}
c: "Costed modern C alternative\nsame capability obligations" {class: proposal}
llvm: "Independent MLIR / LLVM\nlegal high-level transformations" {class: proposal}
runtime: "Gambit runtime + binding\nGC / capture / restore / code users" {class: proposal}
gate: "Unresolved\nfull domain / native ABI / net cost" {class: open}
src -> early -> gvm -> complete -> product
early -> llvm -> product
product -> zig -> runtime
product -> c -> runtime
runtime -> gate
