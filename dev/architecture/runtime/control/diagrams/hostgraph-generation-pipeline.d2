direction: down
classes: {
  semantic: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  physical: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
  runtime: {style.fill: "#E7F4E8"; style.stroke: "#397344"}
}
profile: "G0: Scheme target negotiation\nImmutable profile + provider capability plan\nGVM argument/register/frame constraints" {class: semantic}
anchors: "G1-G2: Scheme compiler / GVM\nRole anchors -> explicit reachability roots\nPurify with identity / effect / poll preservation" {class: semantic}
profile -> anchors
complete: "G3: Scheme semantic host lowering\nExtract checks currently created during C scan\nCall/return plans; boxing and root obligations\nFrameSpec: live values + mandatory saved state" {class: semantic}
anchors -> complete
freeze: "G4: freeze HostGraph revision\nPoints / frames / effects / role bindings closed\nForeign control and setup/init plans explicit\nNo C label ordinals or runtime addresses" {class: gate}
complete -> freeze
plan: "G5: Zig common product planner\nHostId / point membership / local ordinals\nFrameLayout: alignment / maps / descriptor bytes\nOne realization for both emitters" {class: physical}
freeze -> plan
amend: "Needs a new collecting/control boundary?\nReturn amendment to Scheme\nNew revision + recomputed obligations\nBounded negotiation or reject" {class: gate}
plan -> amend: "cannot silently invent a point"
amend -> complete: "semantic changes"
c: "G6: new Zig C emitter -> configured GCC\nC1 host CFG / required-tail exits\nRetire whole legacy C dumper" {class: physical}
native: "G6: runtime-aware MLIR -> LLVM\nN1 host CFG / same target C ABI\nDirect object, no cpu.scm C packaging" {class: physical}
plan -> c
plan -> native
image: "Coherent image product\nCode + PointLayouts + FrameLayouts + RoleBindings\nIndependent ABI / root / decoder gates remain open" {class: gate}
c -> image
native -> image
bind: "G7: Gambit runtime materialization\nResolve PointId to anchored runtime labels\nExisting GC / continuation / VM lifetime owners\nNo private Zig GC or old-binary shim" {class: runtime}
image -> bind
