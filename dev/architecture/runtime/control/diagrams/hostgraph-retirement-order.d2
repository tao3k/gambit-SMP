direction: down
classes: {
  semantic: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  physical: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
  runtime: {style.fill: "#E7F4E8"; style.stroke: "#397344"}
}
h01: "H01: bind cohort / profile / domain\nNo unknown operation or runtime-control region" {class: semantic}
h02: "H02: explicit role anchors and lineage\nExternal-root and transformation rules" {class: semantic}
h03: "H03: Scheme semantic completion\nChecks / frame obligations / effects extracted from C scan" {class: semantic}
h04: "H04: frozen HostGraph\nNo hidden callback or C-only control metadata" {class: gate}
h05: "H05: Zig common physical plan\nOne frame packer and host/point layout" {class: physical}
h06: "H06: new C1 product\nReplace whole legacy C renderer\nC required-tail evidence" {class: physical}
h07: "H07: direct N1 product\nReplace native-through-C packaging\nLLVM and mixed-edge evidence" {class: physical}
h08: "H08: runtime binding / setup\nPer-host points and symbolic role binding\nNo pc=0 query or handwritten handler ordinals" {class: runtime}
h09: "H09: close kernel / foreign domain\nActual callers, wrappers, reentry and failure paths" {class: runtime}
h10: "H10: delete selected legacy coupling\nZero live old callers + independent qualification\nRebuilt cohort; historical receipts retained" {class: gate}
h01 -> h02
h01 -> h03
h02 -> h03
h03 -> h04
h04 -> h05
h05 -> h06
h05 -> h07
h06 -> h08
h07 -> h08
h03 -> h09
h08 -> h09
h06 -> h10
h07 -> h10
h08 -> h10
h09 -> h10
