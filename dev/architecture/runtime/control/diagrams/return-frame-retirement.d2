direction: down
source: "RF source caller inventory\nBounded _t-c-1 / _t-c-2 / _t-c-3 inspection\nNormal / task / internal + CFUN all-live and stack adjustment"
extract: "Scheme G3 extraction\nPreserve logical roots and mandatory saved-state roles\nRemove hidden physical choices from semantic production"
profile: "Profile / decoder correspondence\nActual extent, link + 1, chunk order and inline budget\nGenerator/runtime register parameters admitted"
plan: "One RFD plan and both output adapters\nCounts / label descriptors / outline maps consume decisions\nNo descriptor policy recomputation"
native: "Independent root / capture / frame admission\nInput domain and negative controls defined\nDesign only: no native evidence supplied"
route: "RF01-RF04 selected-route retirement condition\nEvery selected consumer migrated and absent-old-call evidence\nSame condition for C-G, C-ZT and Zig" {
  style.fill: "#e8f2ff"
}
keep: "Global deletion remains separately blocked\nCFUN / legacy C callers and portable reference still exist\nRF05 semantic laws and RF07 runtime scanner retained\nNo code actually retired" {
  style.fill: "#fff0ce"
}
source -> extract
source -> profile
extract -> plan
profile -> plan
plan -> native
native -> route
source -> keep
route -> keep
