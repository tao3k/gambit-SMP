direction: right
vars: { d2-config: { layout-engine: elk } }
capture: "capture: dev/architecture/runtime/control"
replay: "replay: dev/architecture/runtime/execution"
roots: "roots: dev/architecture/runtime/interfaces"
winding: "winding: dev/architecture/runtime/control"
prompt: "prompt: dev/architecture/runtime/control"
foreign: "foreign: dev/architecture/runtime/ffi"
schema: "schema: dev/architecture/compiler"
schema -> capture: "FrameSpec / PointId / stack-to-heap map"
capture -> roots: "Registered captured image and denv/wind roots"
roots -> replay: "Relocated authoritative slots and root reload"
replay -> winding: "Rooted Scheme transfer; hooks may collect or reenter"
winding -> replay: "Post-hook image refresh and current grant before commit"
prompt -> capture: "Explicit delimiter / tag / composition policy"
foreign -> replay: "Live-origin admission; no native-stack resurrection"
CS_SCHEDULE: "CS-SCHEDULE [quint]: control/transition-order-and-permit-lifetime"
CS_COHERENCE: "CS-COHERENCE [lean]: data/issued-view-coherence-under-versioned-history"
CS_BRIDGE: "CS-BRIDGE [source]: refinement/ticket-interface-to-issued-view-premises"
CS_WRITERS: "CS-WRITERS [source]: source/all-frame-denv-root-writers"
CS_HOOKS: "CS-HOOKS [source]: semantics/arbitrary-hook-capture-and-reinstatement"
CS_PROMPTS: "CS-PROMPTS [source]: semantics/delimiter-composition-and-handler-context"
CS_NATIVE: "CS-NATIVE [native]: native/full-generated-control-root-ffi-regression"
CS_FRAMES: "CS-FRAMES [source]: source/generated-frame-coordinate-equivalence"
capture -> CS_SCHEDULE: requires
capture -> CS_WRITERS: requires
capture -> CS_FRAMES: requires
replay -> CS_SCHEDULE: requires
replay -> CS_COHERENCE: requires
replay -> CS_BRIDGE: requires
roots -> CS_SCHEDULE: requires
roots -> CS_WRITERS: requires
winding -> CS_SCHEDULE: requires
winding -> CS_HOOKS: requires
prompt -> CS_SCHEDULE: requires
prompt -> CS_PROMPTS: requires
foreign -> CS_SCHEDULE: requires
foreign -> CS_NATIVE: requires
schema -> CS_FRAMES: requires
policy: "ASCENT: unique obligation and semantic key; exclusive verification owner"
CS_SCHEDULE -> policy: schedules only
CS_COHERENCE -> policy: payload algebra only
CS_BRIDGE -> policy: source correspondence OPEN
