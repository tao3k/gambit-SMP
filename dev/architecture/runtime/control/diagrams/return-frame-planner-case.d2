direction: down
old: "Real Gambit source chain\n_t-c-2: roots / ret-var / alignment-dependent expansion\n_t-c-3: extent / chunks / IFD-OFD policy\nHeader + mem.c: independent runtime consumer"
extract: "Required common reconstruction\nScheme G3: logical roots / saved roles / frame recipe\nBound runtime profile + generator-decoder correspondence\nDo not merely move scalar helpers"
alg: "Selected RFD algorithm in all three\nChecked sizing -> exact decision storage -> exact map fill\nOne immutable decision per return frame\nHomogeneous records and variable-length chunks"
variants: {
  label: "Three realizations of the same necessary component"
  cg: "C-G\nChecked C core + explicit status\nOne cleanup path\nQualified compiler builtins"
  czt: "C-ZT\nSame C core as C-G\nSame selected downstream Zig driver\nNo driver invocation inside RFD"
  zig: "Zig\nChecked helpers + private error propagation\nExact storage + explicit transfer\nNo mandatory container or LLVM C import"
}
outputs: "One RfdPlan -> C and native adapters + counts\nNo adapter repeats physical selection\nRuntime decoder / scanner / capture gates remain"
retire: "RF01-RF04: selected old reconstruction calls can migrate\nRF05/RF07: semantic roots and runtime consumer remain\nRF06: no required C visitor / growth / bignum support to remove"
report: "BM01-BM18 benefit matrix\nShared architecture versus Zig language delta\nLocal expression benefit conditional; timing and net bounds unknown\nNo implementation or native tests" {
  style.fill: "#fff0ce"
}
old -> extract
extract -> alg
alg -> variants.cg
alg -> variants.czt
alg -> variants.zig
variants.cg -> outputs
variants.czt -> outputs
variants.zig -> outputs
outputs -> retire
retire -> report
