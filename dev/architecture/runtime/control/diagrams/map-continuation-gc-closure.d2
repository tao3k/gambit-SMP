direction: down
roots: "Frozen root producers\nactive registers / frames / break anchors\nglobals / RC / native / task carriers"
remembered: "Frozen remembered sources\nmature frame / denv / managed field writes\nowner and slot remain valid"
cut: "One admitted participant epoch\nmutators and relevant major readers acknowledged"
roots -> cut
remembered -> cut
stabilize: "Stack capture stabilization\nretain source segments\ncanonical dynamic frame sharing"
cut -> stabilize
promote: "Young evacuation / mature promotion\nclaim -> initialize -> forward\nscan/fix child edges; count all in-flight work"
stabilize -> promote
close: "Minor closure\nall strong references updated\nweak policy + promotion/major debt settled\nqueues, workers and publishers quiescent"
promote -> close
fail: "Capacity / producer / access gap\nretain source and destination custody\nno partial rewind and premature resume"
stabilize -> fail
promote -> fail
resume: "Rebind context leases and reload homes\nthen recycle young/obsolete stack storage"
snapshot: "If major start is requested\nretain root VALUE snapshot before mutator release\npromoted/stabilized graph ready"
close -> snapshot
snapshot -> resume: "then release mutators"
concurrent: "Major concurrent mature tracing\nheap deletion and publication protocols\nframe scan/writer leases + root adoption"
snapshot -> concurrent: "scan published mature data"
finish: "Major closing cut\nproducer/mark/weak fixed-point obligations\nthen sweep and owner-affine release"
concurrent -> finish
