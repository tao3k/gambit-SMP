direction: down
convert: "FUNCTION / NONNULLFUNCTION conversion\nactual Scheme procedure and native converter"
static: "Existing static C entry\nconditional source path"
closure: "Conditional dynamic C closure\nregister RC carrier -> store proc\nactual owner and root epoch"
convert -> static
convert -> closure
incoming: "Protect incoming procedure / values\nand native carriers before allocation"
incoming -> convert
marker: "SFUN or ___run marker creation\nmarker/root lifetime and native stack validity"
static -> marker
closure -> marker
call: "___call and trampoline / catcher\nrooted arguments / return marker / current context"
marker -> call
scheme: "Scheme callback\nmay collect / capture / reenter foreign code\nmanaged writes follow admitted contract"
call -> scheme
exit: "Normal / error / nonlocal native exit\nrestore context and settle carriers\ninvalidate marker then release at last use"
scheme -> exit
roots: "Root policy\nenumerated mutable or cooperatively classified\ninterior managed writers still require coverage"
closure -> roots
marker -> roots
open: "Unknown raw managed writer / escaped borrow\nunregistered native root / unsupported ABI\nexplicit unresolved admission"
convert -> open
scheme -> open
