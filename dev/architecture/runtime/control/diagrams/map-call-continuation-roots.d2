direction: down
classes: {
  proposal: {style.fill: "#ede9fe"; style.stroke: "#7c3aed"}
  open: {style.fill: "#ffedd5"; style.stroke: "#c2410c"}
}
entry: "Map iteration\nproc + current pair" {class: proposal}
save: "Publish await-proc frame\nparent / proc / pair / after-proc" {class: proposal}
proc: "Generic Scheme proc call\nSELF / nargs / argument" {class: proposal}
capture: "Possible capture / GC / escape\nsaved chain + dynamic environment" {class: open}
resume: "After-proc\nreload / save result / read cdr" {class: proposal}
tail: "Publish await-tail frame\nresult + parent control\nnon-tail recursive map call" {class: proposal}
finish: "After-tail\nsentinel propagation or fresh cons\nactual bound / roots / check" {class: proposal}
ret: "Return through Scheme point\nnative dispatcher stays bounded" {class: proposal}
entry -> save -> proc -> resume -> tail -> finish -> ret
proc -> capture
capture -> resume: "restored continuation; repeatable"
tail -> entry
capture -> ret: "different control destination"
