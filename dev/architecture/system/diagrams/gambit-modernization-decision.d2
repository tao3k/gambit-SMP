direction: right
classes: {
  common: {style.fill: "#dbeafe"; style.stroke: "#2563eb"}
  candidate: {style.fill: "#ede9fe"; style.stroke: "#7c3aed"}
  open: {style.fill: "#ffedd5"; style.stroke: "#c2410c"}
}
core: "Gambit modernization\nsemantics / roots / GC-FFI owners\nshared native product" {class: common}
c: "C-G / C-ZT control\ngenerators + mature libraries\noptional LLVM services" {class: candidate}
zig: "Zig candidate\nreal native hosts + shared services\noptional LLVM services" {class: candidate}
compare: "Equal-capability lifecycle comparison\ncredit common gains once\ncount residual support + added cost" {class: open}
select: "Select Zig only if\nlower saving > upper added cost\nand all runtime gates close" {class: candidate}
continue: "Otherwise continue Gambit program\nmodern C + independent LLVM path\nZig selection remains deferred or rejected" {class: common}
core -> c -> compare
core -> zig -> compare
compare -> select: "positive bound + admitted domain"
compare -> continue: "no bound or negative increment"
