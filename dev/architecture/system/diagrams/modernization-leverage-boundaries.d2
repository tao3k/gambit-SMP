direction: down
classes: {
  benefit: {style.fill: "#eaf5e6"}
  retained: {style.fill: "#e6f2ff"}
  gate: {style.fill: "#fff0ce"}
}
meaning: "Semantic product\nScheme / binding / effect / capture identity\nTarget-neutral facts only where explicitly proved" {class: retained}
protocol: "Runtime protocol + physical plan\nValue / root / frame / control / ABI\nCohort changes invalidate dependent native products" {class: retained}
provider: "Provider service and recipe\nLLVM / MLIR version + target capabilities\nUpgrade invalidates dependent IR, cache and object products" {class: retained}
object: "Objects / image / link / debug products\nDo not rebuild unrelated semantics by default\nActual shared build/link dependencies still count" {class: retained}
instance: "Fresh VM / lexical / phase / module instance\nInitialization, roots and last-return lifetime\nCached immutable code is not a reused mutable instance" {class: retained}
retire: "FD01-FD09 selected C policy/route retirement\nC text / layout duplication / ordinal setup / FFI guesses\nNative-through-C packaging / command and lifetime fragments" {class: benefit}
leverage: "LM01-LM14 attribution\nArchitecture work removed + upstream mechanics reused\nCustom semantic/runtime and provider costs retained\nZig private support union counted separately" {class: benefit}
gates: "AG01-AG06 theory gates\nComplete capability + legal runtime/provider + real retirement\nPositive total vs B0 AND justified Zig increment vs C-full\nFuture native acceptance remains AG07" {class: gate}
meaning -> protocol
meaning -> provider: "admitted high/low route"
protocol -> provider
provider -> object
protocol -> object
object -> instance
instance -> retire: "complete selected caller/product closure"
retire -> leverage
leverage -> gates
provider -> gates: "version / integration / recurring cost"
