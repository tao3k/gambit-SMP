direction: down
classes: {
  owner: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  candidate: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
contracts: "Gambit semantic and runtime authority\nObjects / roots / continuations / FFI effects\nGC participants / VM generations / completion\nShared definitions for generated C and future IR" {class: owner}
depths: "Different modernization depths" {
  r0: "R0: native engineering\nOne resolver and artifact model\nServices, resources and diagnostics\nRetire managed legacy paths" {class: candidate}
  r1: "R1: proposed runtime support\nTyped native work and lifecycle state\nQueue / wait / budget components\nOne owner replaces an admitted old path" {class: candidate}
  r2: "R2: future coordinated revision\nCollector and compiler co-design\nRoots / barriers / maps / safepoints\nNew private protocol generation" {class: gate}
}
contracts -> depths.r0
contracts -> depths.r1
contracts -> depths.r2
llvm: "LLVM / MLIR reusable mechanisms\nAnalyses, passes, conversion and target codegen\nStatepoint / relocation / stack-map support\nNot a collector or Scheme legality proof" {class: candidate}
depths.r0 -> llvm: "isolated provider contract"
depths.r2 -> llvm: "runtime-specific lowering"
lessons: "Chez and OCaml design controls\nC API constrains collector choices\nBlocking participation and retained roots\nSerial cost, latency and memory matter" {class: owner}
lessons -> depths.r1
lessons -> depths.r2
ledger: "18-row benefit and cost ledger\nB0 existing / B1 same contracts in C / Z1 Zig\nRepeated work, FFI, GC, VMs and maintenance\nUnknown baselines stay unknown" {class: gate}
depths.r0 -> ledger
depths.r1 -> ledger
llvm -> ledger
admission: "Coherent-source acceptance before adoption\nSemantics + source/memory-order closure\nNative lifecycle + sequential and multicore cost\nNo implementation or performance result here" {class: gate}
ledger -> admission
