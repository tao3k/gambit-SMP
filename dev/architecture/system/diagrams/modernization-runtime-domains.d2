direction: down
classes: {
  contract: {style.fill: "#e6f2ff"}
  phase: {style.fill: "#eaf5e6"}
  gate: {style.fill: "#fff0ce"}
}
vm: "VM lifetime and root domain\nStable retained slots + published context carriers\nScan/update/close/withdraw/reuse protocol\nRoot enumeration independent of active processor count" {class: contract}
context: "ExecutionContext\nRuntime-owned Scheme frames + saved roots\nExclusive execution owner + live code / return origins" {class: contract}
active: "CT0 OwnedActive\nAdmitted local roots and collective participation" {class: phase}
publish: "CT1 Publishing\nComplete roots, request exclusion and native custody\nNo partial-state detachment" {class: phase}
parked: "CT2 ParkedNative\nNo managed access or callback\nRoot carrier stays scanned; member transition acknowledged" {class: phase}
reentry: "CT3 ReentryPending\nReconcile VM / execution / member requests\nReload moved values before Scheme conversion" {class: phase}
retire: "CT4 Retiring\nClose entry; drain distinct runtime/native/collector users\nKeep or publish surviving root custodian" {class: phase}
failed: "CT5 RetainedAfterFailure\nKnown carrier remains only under publication/no-mutation proof\nUnknown native users still block VM / code reclamation" {class: gate}
free: "CT6 Reclaimed\nNo scanner, execution, native return or code/map user\nInvalidate slot/context identity; then free" {class: phase}
gate: "Full candidate: new runtime work\nNot supplied by RC refcount, TLS or member decrement\nCollector, weak memory, control and recovery gates open" {class: gate}
vm -> context
context -> active
active -> publish
publish -> parked
parked -> reentry
reentry -> active
active -> retire
parked -> retire
retire -> free: "all actual last users discharged"
retire -> failed: "incomplete / failed drain"
failed -> retire: "only after lawful recovery"
vm -> failed: "roots and native-return lifetime differ"
gate -> publish
