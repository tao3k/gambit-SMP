direction: down
classes: {
  scheme: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
  native: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
}
roots: "Scheme AnchorState\nRequired role / return / external entry anchors\nIncoming contracts and named frame features\nSeparate from copied debug comments" {class: scheme}
rewrite: "Clone / cascade / common-block / common-tail\nDistinct exported entry boundaries remain\nFresh private origins and explicit lineage\nFrame / effect / frontier analysis invalidation" {class: scheme}
roots -> rewrite
dead: "Dead-code reachability\nSeed ordinary entry AND all external roots\nRuntime edges are not ordinary predecessor counts" {class: gate}
rewrite -> dead
fuse: "Useless-jump fusion\nOne Scheme predecessor does not imply one entry\nDo not absorb an external boundary" {class: scheme}
dead -> fuse
order: "Final scheduling / renumbering\nSeed every external root again\nExactly-once coverage of required anchors\nDCE preservation alone is insufficient" {class: gate}
fuse -> order
roots -> order: "same root authority"
completion: "G3 completion + G4 freeze\nPrivate check/force points and complete frames\nOne coherent CFG / anchor revision\nReject missing correspondence or exhausted budget" {class: scheme}
order -> completion
zig: "Zig common product planner\nConsumes preserved PointIds and obligations\nCannot reconstruct deleted anchors from C or ordinals" {class: native}
completion -> zig
