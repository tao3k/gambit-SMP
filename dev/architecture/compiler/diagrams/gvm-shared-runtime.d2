direction: down
classes: {
  gambit: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
  retained: {style.fill: "#E7F4E8"; style.stroke: "#397344"}
}
producer: "Gambit owns language and target policy\nGVM + logical constants + c-intf + module plan\nExact source / overlay / effective configuration" {class: gambit}
portable: "BC: portable C target retained\nReference / bootstrap / target coverage\nConfigured GCC remains supported" {class: retained}
native: "BG: proposed native service in Zig\nTyped GVM -> runtime-aware MLIR -> LLVM\nOwn IR buffers; never compiler heap addresses" {class: proposed}
high: "BH: earlier semantic export\nHigher-order / effect / escape analyses\nSame runtime contract after legal lowering" {class: proposed}
producer -> portable
producer -> native
producer -> high: "separate earlier entry"
profile: "One proposed SharedRuntimeProfile\nObject tags / closure and label layout\nGVM frames / roots / GC and control effects\nD0 or D1 / module and platform obligations" {class: gate}
portable -> profile
native -> profile
high -> profile
product: "Native product must replace C packaging too\nObject + descriptors + constant materialization\nRelocations / Gambit fixups / init and resources\nNo hidden generated-C wrapper for a no-C claim" {class: proposed}
native -> product
profile -> product: "admission requirements"
runtime: "One Gambit runtime authority\nPer-VM heaps and processor state\nExisting collector / libraries / continuation machinery\nSame scanner protocol for C and native Scheme code" {class: gambit}
profile -> runtime
product -> runtime: "admitted load and entry"
service: "Ordinary Zig/native services\nExplicit native ownership and FFI effects\nDifferent boundary from Scheme backend code" {class: gate}
runtime -> service
retire: "Actual retirement scope\nSelected Scheme C emission + macro expansion\nNative packaging C + eligible adapters\nRuntime semantics and BC remain" {class: retained}
product -> retire
status: "Design only: SR01-SR08 remain open\nNo native ABI / arm64e / speedup claim\nN01-N10 count removed work AND added costs" {class: gate}
runtime -> status
retire -> status
