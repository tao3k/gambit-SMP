direction: down
classes: {
  existing: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  contract: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
source: "Gambit authoritative inputs\nResolved tree + effective declarations / primitive identity\nNEW: capture structured FFI records during parsing" {class: existing}
contract: "Semantic export contract\nChosen evaluation order + complete may-effect summaries\nKnown lowering per artifact role; unknown never means pure" {class: contract}
source -> contract
high: "H / C: functional and explicit-control Scheme IR\nCustom higher-order, closure and continuation legality\nExisting GC remains default for unknown lifetimes" {class: proposed}
contract -> high
native: "N: restricted native computational domain\nPROVE extraction boundary before generic passes\nNo hidden Scheme control, heap loans or foreign retention" {class: contract}
high -> native: "only qualifying subcomputations"
generic: "Conditional reuse of MLIR mechanisms\nPinned pass + options + nested utilities + operation domain\nCanonicalize / CSE / LICM / mem2reg / kernel bufferization" {class: proposed}
native -> generic
runtime: "Gambit runtime lowering and full legality boundary\nFrames / roots / polls / tail calls / module metadata\nC islands retain their own wrapper / ABI obligations" {class: contract}
high -> runtime: "language-aware path"
generic -> runtime: "qualified native result"
reject: "Reject unsupported semantic profile\nMissing lowering, FFI contract or mandatory legality\nNo silent partial artifact" {class: contract}
contract -> reject: "unresolved required capability" {style.stroke-dash: 3}
note: "DESIGN ONLY: catalogue coverage is not implemented support.\nZig carries services and artifacts; pass legality remains semantic compiler work." {shape: text; style.font-size: 15}
runtime -> note: {style.opacity: 0}
