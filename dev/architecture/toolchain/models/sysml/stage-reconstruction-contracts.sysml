package GambitStageReconstruction {
    private import ScalarValues::*;
    part def SharedContract { attribute key:String; attribute schema:String; attribute producer:String; attribute consumers:String; attribute seal:String; attribute invalidation:String; attribute failureCustody:String; attribute retirement:String; attribute gap:String; }
    part contract0:SharedContract { attribute :>> key="query-snapshot"; attribute :>> schema="SemanticKey(source+expanded/declaration/provider/target-semantic inputs); LayoutKey(SemanticKey+ABI+debug/register/frame/native profile+plan default flags+ordered init recipe); dynamic-read closure and epoch"; attribute :>> producer="phase-artifact-graph"; attribute :>> consumers="incremental-query-service; gambit-phase-engine; native-module-data-emitter"; attribute :>> seal="Bind consumed projections and effective inputs before reusable result publication; immutable semantic and layout keys stay distinct"; attribute :>> invalidation="Semantic change invalidates both; layout-only change invalidates layout/native descendants; unknown effect refuses reuse, not valid fresh compilation"; attribute :>> failureCustody="Original request retains context and work when result is unknown; do not start a second destructive request"; attribute :>> retirement="Retire timestamp/whole-module freshness only after actual readers use these projections"; attribute :>> gap="Dynamic macro/native I/O read/write closure and actual key extraction remain source obligations"; }
    part contract1:SharedContract { attribute :>> key="private-context-lease"; attribute :>> schema="ContextId+generation+Owner; private target/primitive environment, compiler queues, ports/effects and root carriers"; attribute :>> producer="gambit-phase-engine"; attribute :>> consumers="incremental-query-service; native-module-data-emitter"; attribute :>> seal="One active owner per context; close writers/read capture before semantic sealing; stable rooted product precedes context release"; attribute :>> invalidation="Late dependency invalidates unpublished result; reentry needs distinct execution generation, not reuse of old mutable workspace"; attribute :>> failureCustody="Before stable product handoff the context keeps custody; response loss queries prior committed identity, not recompilation"; attribute :>> retirement="Retire global target/options/environment queues as sole authority after every direct/indirect user is context-bound"; attribute :>> gap="Source writer completeness, reentrant exception restoration and GC root registration are not implied by ownership model"; }
    part contract2:SharedContract { attribute :>> key="sealed-semantic-product"; attribute :>> schema="SemanticKey; normalized GVM/procedure graph; supply/demand and source/declaration identity; c-intf construction recipe; effects/dependencies; stable root owner"; attribute :>> producer="gambit-phase-engine"; attribute :>> consumers="native-module-data-emitter; phase-artifact-graph"; attribute :>> seal="Candidate seam: after compile-parsed-program/module semantic descriptor, before target.dump consumes c-intf; deep private copy and closed alias/read/write scope required"; attribute :>> invalidation="Target semantics or provider/declarations change invalidates semantic result; physical ABI-only edit may retain it if no semantic target input changed"; attribute :>> failureCustody="Keep private workspace on freeze/copy failure; original exceptions and source identity remain; valid programs may compile fresh without reuse"; attribute :>> retirement="Retire mandatory text/file/re-reader stage transport and live front-end context as only result after all modes migrate"; attribute :>> gap="Current module-procs/c-intf remain mutable; the source seam is not a ready-made immutable API"; }
    part contract3:SharedContract { attribute :>> key="module-layout-bundle"; attribute :>> schema="SemanticKey+LayoutABI; typed ModuleSpec with default initialization flags and order; complete FrameSpec table and PointId links; code/data/relocations; ordered C initializers; descriptor/image root ownership"; attribute :>> producer="native-module-data-emitter"; attribute :>> consumers="native-action-runtime; phase-artifact-graph; existing GC/continuation/module runtime"; attribute :>> seal="Finalize demand/resource closure and validate all physical frame data; seal code and descriptor manifest together; raw Scheme vectors/native VM pointers cannot be shared plan state"; attribute :>> invalidation="ABI/GC map/frame/return-label/code changes invalidate all consuming native results; old generations remain held by actual readers"; attribute :>> failureCustody="Unknown publication retains whole candidate and its descriptor holds; no code-only success or lost metadata ownership"; attribute :>> retirement="Retire count-specialized common header/layout emission only after GC, continuation, setup and linker consume the one plan"; attribute :>> gap="RETI actual/stored coordinates, full frame coverage, generic vector/FFI escape and manifest correspondence still require source/native refinement"; }
    part contract4:SharedContract { attribute :>> key="module-instance"; attribute :>> schema="VMId+InstanceGeneration; immutable ModulePlan reference; instance flags/init state; native ModuleHandle; descriptor/image/root holds"; attribute :>> producer="existing Gambit module runtime"; attribute :>> consumers="existing GC/continuation/FFI/init runtime; native-action-runtime lifetime interface"; attribute :>> seal="Allocate fresh instance state; setup flags/native pointer never mutate shared ModulePlan; preserve initializer order/effects per semantic instance"; attribute :>> invalidation="Instance state changes do not rewrite layout identity; code/ABI replacement requires distinct held plan generation"; attribute :>> failureCustody="Partially initialized instance retains roots/resources; unknown init/cleanup never becomes a cached success"; attribute :>> retirement="Retire shared legacy descriptor-vector flags/pointer authority after setup, init-mod, registry and FFI callers use instance handles"; attribute :>> gap="Per-VM module identity and initializer multiplicity must be source-refined; frozen data does not prove correct initialization"; }
