      attribute :>> planningRange="Same recorded before/after demand; at least twofold speedup is separate from residual Darwin/Linux gap";
      attribute :>> scope="Planning requirement and conditional budget; not an achieved speedup";
      attribute :>> requiredNetReduction="2*removed >= beforeDarwin+2*added; Linux nonregression separately required";
      attribute :>> floorCondition="2*retainedFloor <= beforeDarwin";
      attribute :>> linuxCondition="afterLinux<=beforeLinux; twofold speedup from 5x still leaves a 2.5x residual gap if Linux is fixed";
      attribute :>> evidenceUse="Reuse original elapsed cohorts without adding worker CPU sums or moving timers between consumers";
      attribute :>> qntPath="models/build/incremental_build.qnt";
