    // Whole-request elapsed target, reusing the existing metric and evidence graph.
    // Unassigned amounts are parameters, never fabricated performance samples.
    part def ElapsedTargetBudget {
      attribute beforeDarwin:Integer; attribute afterDarwin:Integer;
      attribute beforeLinux:Integer; attribute afterLinux:Integer;
      attribute removedElapsed:Integer; attribute validation:Integer;
      attribute coordination:Integer; attribute interaction:Integer;
      attribute retainedFloor:Integer;
      attribute cohortClosed:Boolean; attribute semanticParity:Boolean;
      constraint domain { beforeDarwin>=0 and afterDarwin>=0 and beforeLinux>0 and afterLinux>0 and removedElapsed>=0 and validation>=0 and coordination>=0 and interaction>=0 and retainedFloor>=0 }
      constraint balance { afterDarwin+removedElapsed==beforeDarwin+validation+coordination+interaction }
      constraint floor { retainedFloor<=afterDarwin }
    }
    part elapsedBudget:ElapsedTargetBudget;
    part def DevelopmentTarget {
      ref part budget:ElapsedTargetBudget;
      attribute key:String; attribute numerator:Integer; attribute denominator:Integer;
      attribute comparison:String; attribute achieved:Boolean;
      attribute planningRange:String; attribute scope:String; attribute requiredNetReduction:String;
      attribute floorCondition:String; attribute linuxCondition:String; attribute evidenceUse:String;
      attribute qntPath:String; attribute qntModule:String; attribute qntTest:String;
      attribute leanPath:String; attribute lemma:String; attribute measurementScope:String;
      constraint positiveRatio { numerator>0 and denominator>0 }
      constraint acceptedRatio { not achieved or (budget.cohortClosed and budget.semanticParity and ((comparison=="darwin-linux-gap" and denominator*budget.afterDarwin<=numerator*budget.afterLinux) or (comparison=="darwin-acceleration" and numerator*budget.afterDarwin<=denominator*budget.beforeDarwin)) and budget.afterLinux<=budget.beforeLinux) }
    }
    part target0:DevelopmentTarget { ref part :>> budget=elapsedBudget; attribute :>> comparison="darwin-linux-gap"; attribute :>> achieved=false; attribute :>> key="twofold"; attribute :>> numerator=2; attribute :>> denominator=1; attribute :>> planningRange="Per-package observed ratio r includes cases above5; no upper bound; bind original workload and final Linux comparator; 4 and5 are examples only"; attribute :>> scope="Planning objective and conditional budget; not an achieved or statistically estimated ratio"; attribute :>> requiredNetReduction="Net removal >= max(0,T_D-2*afterLinux); if Linux fixed and r=T_D/L, fraction>=1-2/r; r>5 requires more than60 percent"; attribute :>> floorCondition="retainedFloor <= 2*afterLinux"; attribute :>> linuxCondition="afterLinux <= beforeLinux; evaluate the final ratio against afterLinux, not automatically against the old comparator"; attribute :>> evidenceUse="Reuse linked original observations; do not redo old experiments merely for this model; component observations need a scope-preserving schedule projection before whole-request credit"; attribute :>> qntPath="models/build/incremental_build.qnt"; attribute :>> qntModule="darwin_development_work"; attribute :>> qntTest="targetFourToTwoTest"; attribute :>> leanPath="dev/architecture/toolchain/models/lean/DevelopmentBenefit.lean"; attribute :>> lemma="twofoldTarget"; attribute :>> measurementScope="matched-whole-request-elapsed:twofold"; }
