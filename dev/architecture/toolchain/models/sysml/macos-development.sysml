    part c23Edge7:C23DesignEdge { attribute :>> fromNode="owned replacement contracts"; attribute :>> toNode="Gerbil phase service"; attribute :>> contract="One query graph, private instances, exact manifests and shared resource budget"; }
    part c23Edge8:C23DesignEdge { attribute :>> fromNode="stage artifacts"; attribute :>> toNode="native action backend"; attribute :>> contract="Exact executable/argv/environment/cwd/fd/signal context; qualified Darwin realization"; }
