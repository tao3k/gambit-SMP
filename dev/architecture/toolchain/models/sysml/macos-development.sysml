      attribute leanPath:String; attribute lemma:String; attribute proofLimit:String;
    }

    part c23Feature0:C23FeaturePolicy { attribute :>> key="constexpr-objects"; attribute :>> origin="C23"; attribute :>> application="Module counts, masks and admissible scalar constants"; attribute :>> limit="Object definitions only; not constexpr functions or non-null pointer relocation tables"; attribute :>> benefit="Compiler diagnostics and fewer value macros; no automatic speed claim"; attribute :>> primary="https://www.open-std.org/jtc1/sc22/wg14/www/docs/n3018.htm"; }
    part c23Feature1:C23FeaturePolicy { attribute :>> key="type-expression"; attribute :>> origin="C23 standardization"; attribute :>> application="typeof/typeof_unqual and local object inference in generated helpers"; attribute :>> limit="Public ABI remains explicitly typed; existing GCC extensions are not new optimization"; attribute :>> benefit="Less type duplication and extension-specific glue"; attribute :>> primary="https://gcc.gnu.org/projects/c-status.html"; }
    part c23Feature2:C23FeaturePolicy { attribute :>> key="result-checking"; attribute :>> origin="C23 attributes"; attribute :>> application="nodiscard on fallible admission, initialization and publication results"; attribute :>> limit="Diagnostics only; not linear ownership or automatic cleanup"; attribute :>> benefit="Catch accidental ignored results; explicit outcome protocol still required"; attribute :>> primary="https://gcc.gnu.org/projects/c-status.html"; }
    part c23Feature3:C23FeaturePolicy { attribute :>> key="checked-capacity"; attribute :>> origin="C23 library"; attribute :>> application="ckd_mul/ckd_add for count times element size plus header"; attribute :>> limit="Reject overflow before publication; never consume overflow output; SDK capability unqualified"; attribute :>> benefit="Unify boundary overflow handling; checks remain charged"; attribute :>> primary="https://www.open-std.org/jtc1/sc22/wg14/www/docs/n2669.pdf"; }
    part c23Feature4:C23FeaturePolicy { attribute :>> key="atomic-alignment"; attribute :>> origin="C11 inherited"; attribute :>> application="Atomics, TLS, alignment and static assertions remain foundational"; attribute :>> limit="C23 does not create multicore ownership, lock freedom, GC roots or tail-call guarantees"; attribute :>> benefit="Standard baseline only; SMP correctness needs separate proofs"; attribute :>> primary="https://gcc.gnu.org/projects/c-status.html"; }
    part c23Feature5:C23FeaturePolicy { attribute :>> key="plain-functions-data"; attribute :>> origin="architecture decision"; attribute :>> application="Stable C declarations, per-module descriptor data and compiled common helpers"; attribute :>> limit="Static const and inline are older mechanisms; C23 alone does not remove preprocessing"; attribute :>> benefit="Actual token/parse work can disappear only after producer/consumer replacement"; attribute :>> primary="https://gcc.gnu.org/projects/c-status.html"; }
    part c23Boundary0:C23DesignBoundary { ref part :>> role=replacement0; ref part :>> stage=IncrementalCompilerArchitecture::stage6; ref part :>> descriptor=GambitNativeDescriptor::descriptorField1; attribute :>> key="stable-abi-module-data"; attribute :>> producer="Scheme native-contract generator"; attribute :>> consumer="Stable C23 ABI and module setup"; attribute :>> contract="Header surface independent of module counts; ModuleSpec data and mutable binding instances separate"; attribute :>> retirement="Retire count-controlled general header assembly only after all binding modes/consumers migrate"; attribute :>> added="Descriptor relocations, cold helper calls, controlled hot inlining and ABI rebuild"; attribute :>> sourcePath="vendor/gambit/gsc/_t-c-1.scm"; attribute :>> needle="(targ-define-count \"GLOCOUNT\""; attribute :>> qntPath="dev/architecture/toolchain/models/quint/native_artifact_partition.qnt"; attribute :>> qntTest="countDoesNotChangeAbiTest"; attribute :>> leanPath="dev/architecture/toolchain/models/lean/NativeArtifactPartition.lean"; attribute :>> lemma="countDoesNotChangeHeader"; attribute :>> proofLimit="Structural key law only; actual expanded tokens, C ABI/layout and setup parity remain open"; }
    part c23Boundary1:C23DesignBoundary { ref part :>> role=replacement1; ref part :>> stage=IncrementalCompilerArchitecture::stage5; ref part :>> descriptor=GambitNativeDescriptor::descriptorField3; attribute :>> key="frame-consumer-contract"; attribute :>> producer="Scheme FrameSpec/PointId generator"; attribute :>> consumer="GC, continuation and native frame consumers"; attribute :>> contract="One semantic role/layout owner; admitted descriptor ABI binds code and roots"; attribute :>> retirement="Retire duplicate IFD/OFD/return layout emission after all consumers and old captured-frame users migrate"; attribute :>> added="Decoder/profile validation and metadata/code retention"; attribute :>> sourcePath="vendor/gambit/include/_gambit/module_generation.h.in"; attribute :>> needle="___frame_root_next_run"; attribute :>> qntPath="dev/refactoring/modern-c/models/quint/frame_roots.qnt"; attribute :>> qntTest="width64MicrostepsTest"; attribute :>> leanPath="dev/refactoring/modern-c/models/lean/FrameCursorWords.lean"; attribute :>> lemma="sourceTotalCorrectAll"; attribute :>> proofLimit="Supported mathematical cursor family only; native pointer, compiler liveness, control and whole GC remain open"; }
    part c23Boundary2:C23DesignBoundary { ref part :>> role=replacement3; ref part :>> stage=IncrementalCompilerArchitecture::stage3; ref part :>> descriptor=GambitNativeDescriptor::descriptorField2; attribute :>> key="owned-phase-session"; attribute :>> producer="Gerbil phase programs and Gambit CompileContext"; attribute :>> consumer="gxi/gxc phase query service"; attribute :>> contract="Share immutable construction program; fresh binding/mark/context overlays and owned mutable compiler state"; attribute :>> retirement="Retire whole-request global-state authority only after protected writers and effects migrate"; attribute :>> added="Instance construction, input validation, worker transfer and roots"; attribute :>> sourcePath="vendor/gambit/gsc/_front.scm"; attribute :>> needle="(define (compile-frontend"; attribute :>> qntPath="models/build/iter_compiler_service.qnt"; attribute :>> qntTest="distinctContextsTest"; attribute :>> leanPath="models/build/IterCompilerService.lean"; attribute :>> lemma="projectionNeedsSupport"; attribute :>> proofLimit="Model context witnesses and projection counterexample; actual writer/effect closure and same-VM SMP remain open"; }
    part c23Boundary3:C23DesignBoundary { ref part :>> role=replacement4; ref part :>> stage=IncrementalCompilerArchitecture::stage7; ref part :>> descriptor=GambitNativeDescriptor::descriptorField0; attribute :>> key="stage-native-manifest"; attribute :>> producer="Phase-query outputs plus native action requests"; attribute :>> consumer="Link/module consumers and waiting clients"; attribute :>> contract="Semantic, generated-C, native and link keys separate; commit exact complete snapshot atomically"; attribute :>> retirement="Retire whole-module completion as sole gate and direct file-existence acceptance after all clients migrate"; attribute :>> added="Trace validation, manifest commit and failure/cancel drain"; attribute :>> sourcePath="vendor/gambit/gsc/_t-c-1.scm"; attribute :>> needle="(targ-dump-module-info"; attribute :>> qntPath="models/build/incremental_compiler_architecture.qnt"; attribute :>> qntTest="nativeLeavesExpansionTest"; attribute :>> leanPath="models/build/IncrementalCompilerArchitecture.lean"; attribute :>> lemma="publicationNeedsSuccess"; attribute :>> proofLimit="Existing bounded scheduler and conditional publication law; no full source refinement or speedup"; }
    part def C23DesignEdge { attribute fromNode:String; attribute toNode:String; attribute contract:String; }
    part c23Edge0:C23DesignEdge { attribute :>> fromNode="Scheme semantic owner"; attribute :>> toNode="stable ABI and module data"; attribute :>> contract="C23 constants plus explicit descriptors; no module-count-driven public header"; }
    part c23Edge1:C23DesignEdge { attribute :>> fromNode="stable ABI and module data"; attribute :>> toNode="compiled runtime helpers"; attribute :>> contract="Shared implementation once per ABI/tool profile; hot inline policy explicit"; }
