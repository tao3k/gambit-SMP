    // Parameters, not measured constants. Different metrics never share a sum.
    part def BenefitAccounting {
      attribute metric:String; attribute oldAmount:Integer; attribute newAmount:Integer;
      attribute removed:Integer; attribute validation:Integer;
      attribute coordination:Integer; attribute interaction:Integer;
      constraint nonnegative { oldAmount>=0 and newAmount>=0 and removed>=0 and validation>=0 and coordination>=0 and interaction>=0 }
      constraint balance { newAmount+removed==oldAmount+validation+coordination+interaction }
    }
    part workAccounting:BenefitAccounting { attribute :>> metric="homogeneous CPU-work units"; }
    part spanAccounting:BenefitAccounting { attribute :>> metric="critical-path or first-useful-feedback time units"; }
    part memoryAccounting:BenefitAccounting { attribute :>> metric="retained bytes under the same observation boundary"; }
    part authorityAccounting:BenefitAccounting { attribute :>> metric="independent responsibility authorities; not time"; }
    part def PlatformPhaseCost {
      attribute phase:String; attribute matchedWorkload:String;
      attribute nDarwin:Integer; attribute nLinux:Integer;
      attribute cDarwin:Integer; attribute cLinux:Integer;
      attribute hDarwin:Integer; attribute hLinux:Integer;
      attribute wDarwin:Integer; attribute wLinux:Integer;
      constraint domain { nDarwin>=0 and nLinux>=0 and cDarwin>=0 and cLinux>=0 and hDarwin>=0 and hLinux>=0 }
      constraint darwinWork { wDarwin==nDarwin*cDarwin+hDarwin }
      constraint linuxWork { wLinux==nLinux*cLinux+hLinux }
    }
    part platformPhaseCost:PlatformPhaseCost {
      attribute :>> matchedWorkload="Same package/source/input demand and outcome; bind compiler/SDK/flags/hardware/cache and topology separately. The existing >=4x package-gap report is a research input. Reuse original source-bound records; this model does not demand new sampling merely to organize them";
      attribute :>> phase="Apply to each additive CPU-work phase; parallel wall time additionally needs the actual dependency/resource span";
    }
    part def PlatformGainClaim {
      attribute claimed:Boolean; attribute matched:Boolean; attribute semanticParity:Boolean;
      attribute oldDarwin:Integer; attribute newDarwin:Integer;
      attribute oldLinux:Integer; attribute newLinux:Integer;
    }
    requirement def DarwinGainAndLinuxNonRegression {
      subject witness:PlatformGainClaim;
      require constraint { not witness.claimed or (witness.matched and witness.semanticParity and witness.newDarwin<witness.oldDarwin and witness.newLinux<=witness.oldLinux) }
    }
    part def DevelopmentBenefit {
      ref part pain:DarwinReconstruction; ref part accounting:BenefitAccounting;
      attribute key:String; attribute creditClass:String; attribute metric:String;
      attribute oldShape:String; attribute newShape:String;
      attribute condition:String; attribute counterexample:String;
      attribute interaction:String; attribute platformPolicy:String;
      attribute qntPath:String; attribute qntTest:String; attribute leanPath:String;
      attribute lemma:String; attribute scope:String;
      attribute evidenceReuse:String; attribute remainingDuty:String;
    }
