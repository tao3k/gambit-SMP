    part reconstruction2:DarwinReconstruction { ref part :>> component=IncrementalCompilerArchitecture::component4; ref part :>> stage=IncrementalCompilerArchitecture::stage7; ref part :>> boundary=c23Boundary3; attribute :>> key="phase-pipeline-and-budget"; attribute :>> historyPath="../../patches/gerbil-v19-darwin/README.md"; attribute :>> historyNeedle="bounded executor, parameter capture, and streaming lifecycle"; attribute :>> sourcePath="../gerbil-gambit-bootstrap-audit/src/gerbil/compiler/base.ss"; attribute :>> needle="(def (execute-pending-compile-jobs!)"; attribute :>> pain="Deferred jobs and whole-module readiness delay overlap; raising worker count does not remove serial expansion"; attribute :>> replacement="One phase-query scheduler and CPU/memory admission budget; immediate native successors and independent semantic sessions"; attribute :>> retirement="Retire duplicate job pools and sole whole-module completion only after producers/waiters/diagnostics/failure drain migrate"; attribute :>> measure="Runnable frontier, idle-with-ready-work, work/span and peak resident set; no requirement to saturate cores when dependencies forbid it"; attribute :>> added="Dependency waits, resource accounting, cancellation custody and session/process memory"; attribute :>> refusal="Global optimizer/expander locks cannot be deleted before writer ownership closes; same-VM SMP requires separate admission"; attribute :>> qntPath="models/build/incremental_compiler_architecture.qnt"; attribute :>> qntTest="parallelConsumersTest"; attribute :>> leanPath="models/build/IncrementalCompilerArchitecture.lean"; attribute :>> lemma="spanLowerBound"; attribute :>> proofLimit="Model scheduling witness and assumed span inequality; no native scheduling or 12-core utilization proof"; }
