    part responsibility8:ModelResponsibility { ref part :>> catalogue=GambitVerificationResponsibilities::lean; attribute :>> key="module-frame-spec-layout"; attribute :>> primary="lean"; attribute :>> semantic="data/module-frame-spec-cross-consumer-layout"; attribute :>> domain="data"; attribute :>> question="Do sealed semantic products and ModuleSpec/FrameSpec preserve all consumer layouts, roots and binding identities?"; attribute :>> model="dev/refactoring/modern-c/models/lean/FrameContract.lean"; attribute :>> obligation="L-SPEC: extend existing representation owner to the new cross-consumer contract"; attribute :>> handoff="Existing frame facts are premises; full new ModuleSpec/phase-product scope requires further proof"; attribute :>> excludes="No scheduler model; existing artifact is a foundation, not proof of this scope extension"; attribute :>> evidenceStatus="open"; }
    part responsibility9:ModelResponsibility { ref part :>> catalogue=GambitVerificationResponsibilities::quint; attribute :>> key="phase-query-invalidation"; attribute :>> primary="quint"; attribute :>> semantic="control/phase-query-invalidation-publication"; attribute :>> domain="control"; attribute :>> question="Can dynamic dependencies, early cutoff and stage publication race without false reuse in private sessions?"; attribute :>> model="models/build/incremental_build.qnt"; attribute :>> obligation="Q-DAG: extend existing incremental-graph owner to staged Gambit/private-context composition"; attribute :>> handoff="Existing graph model remains owner; new session/result composition is not yet discharged"; attribute :>> excludes="No duplicate Lean DAG scheduler and no claim that the old file closes the new component"; attribute :>> evidenceStatus="open"; }
    part def RefactorComponent { attribute key:String; attribute boundary:String; attribute owns:String; attribute inputContract:String; attribute outputContract:String; attribute oldAuthority:String; attribute retirement:String; attribute retained:String; attribute added:String; attribute evidenceRole:String; }
    part component0:RefactorComponent { attribute :>> key="incremental-query-service"; attribute :>> boundary="Gerbil service exposed through the same gxi/gxc/package requests"; attribute :>> owns="Dynamic dependency graph, consumed phase projections, ready-action demand and one CapacityPlan"; attribute :>> inputContract="Source cohort, requested phase and normalized effective resource/tool profile"; attribute :>> outputContract="Stage demand graph and complete consumer-specific result keys"; attribute :>> oldAuthority="std/make whole-module completion and separate resource defaults as only readiness authority"; attribute :>> retirement="Retire old freshness/coordinator authority after every caller consumes stage results and invalidation contracts"; attribute :>> retained="Required module initialization, effects, dependency waits and explicit serial requests"; attribute :>> added="Trace/validation/storage and private session setup"; attribute :>> evidenceRole="Historical serialization and phase-shift records constrain hypotheses; they do not choose the new architecture"; }
    part component1:RefactorComponent { attribute :>> key="gambit-phase-engine"; attribute :>> boundary="Gambit Scheme semantic pipeline plus portable C23 runtime/service boundary"; attribute :>> owns="Private CompileContext; normalization/GVM semantics; tail calls, continuation, roots and source/binding identity"; attribute :>> inputContract="Closed Scheme semantic input, target/provider profile and context ownership"; attribute :>> outputContract="Sealed phase result with GVM, FrameSpec, ModuleSpec and effect/dependency provenance"; attribute :>> oldAuthority="Global mutable compiler context and text/process transport as the only stage boundary"; attribute :>> retirement="Retire the old sole authority after semantic completion, reconstruction, exception and all mode consumers migrate"; attribute :>> retained="Scheme semantics, continuation multiplicity, FFI roots, collector and portable C ABI"; attribute :>> added="Context isolation, reconstruction, descriptor/ABI validation and retained roots"; attribute :>> evidenceRole="Current source establishes shared state; no claim that a generic request model proves Gambit semantic preservation"; }
    part component2:RefactorComponent { attribute :>> key="native-module-data-emitter"; attribute :>> boundary="Scheme-owned generator emits modern C and immutable native module data"; attribute :>> owns="Shared compiled cold helpers and qualified object/module/frame data; hot GVM operations remain explicit"; attribute :>> inputContract="Sealed GVM/ModuleSpec/FrameSpec with literal graph and target layout"; attribute :>> outputContract="Portable generated C/data plus exact object, root and module-binding descriptors"; attribute :>> oldAuthority="Repeated count-specialized common-header construction and textual literal packing for migrated classes"; attribute :>> retirement="Retire only fully migrated emission/layout paths after every runtime/linker/GC/continuation consumer agrees"; attribute :>> retained="32/64-bit, endian, character widths, cyclic identity, tail calls, source diagnostics and GC roots"; attribute :>> added="Data encoding, relocation/fixup, helper calls and parity checks"; attribute :>> evidenceRole="Atomic literal evidence motivates representation work; rejected header-only patches are not a backend design"; }
    part component3:RefactorComponent { attribute :>> key="native-action-runtime"; attribute :>> boundary="C23 NativeAction service with platform-specific realization"; attribute :>> owns="One exact argv/env/cwd/fd/signal plan, native result ledger, process/cleanup custody and shared budget"; attribute :>> inputContract="Verified native request and rooted stable owner with scoped descriptors"; attribute :>> outputContract="Known terminal/output receipt or explicitly retained unknown responsibility"; attribute :>> oldAuthority="Duplicated shell/config interpretation and eligible fork-child descriptor-limit sweep"; attribute :>> retirement="Retire old launch/recipe authority only after all request modes and failures have equivalent typed realizations"; attribute :>> retained="PTY, signals, loader/ABI semantics, native errors and VM/module root lifetime"; attribute :>> added="Request validation, process records, resource pins and unsupported-mode paths"; attribute :>> evidenceRole="Darwin launch evidence identifies one costly old branch; installed fixes are not counted twice"; }
    part component4:RefactorComponent { attribute :>> key="phase-artifact-graph"; attribute :>> boundary="Shared semantic/native artifact identity, not a second outer build wrapper"; attribute :>> owns="Sealed artifacts, atomic publication, consumed-projection invalidation and LinkPlan reuse"; attribute :>> inputContract="Exact source/tool/ABI/effect projection and dependency-ready products"; attribute :>> outputContract="Verified reusable phase products, manifest and lifetime-qualified successor receipt"; attribute :>> oldAuthority="Timestamp or complete-process success as sufficient whole-module freshness; mandatory repeated generation"; attribute :>> retirement="Retire old authority after every reader uses exact phase inputs and source-safe output publication"; attribute :>> retained="All real misses, changed effects, ABI invalidation and open native obligations"; attribute :>> added="Fingerprinting, trace validation, storage and observer/descriptor retirement"; attribute :>> evidenceRole="Existing reuse and coordinator regressions constrain net cost; cache HIT is not novel saving"; }
    part def ComponentObligation { ref part component:RefactorComponent; ref part obligation:ModelResponsibility; attribute purpose:String; }
    part use0:ComponentObligation { ref part :>> component=component0; ref part :>> obligation=responsibility9; attribute :>> purpose="Temporal dependency and publication composition; scope extension open"; }
    part use1:ComponentObligation { ref part :>> component=component0; ref part :>> obligation=responsibility6; attribute :>> purpose="Concrete entry and invalidation refinement"; }
    part use2:ComponentObligation { ref part :>> component=component0; ref part :>> obligation=responsibility7; attribute :>> purpose="Both complete package requests and correctness"; }
    part use3:ComponentObligation { ref part :>> component=component0; ref part :>> obligation=responsibility4; attribute :>> purpose="One shared general net-benefit law"; }
    part use4:ComponentObligation { ref part :>> component=component1; ref part :>> obligation=responsibility0; attribute :>> purpose="Request/result lifetime interface only; not GVM semantic preservation"; }
    part use5:ComponentObligation { ref part :>> component=component1; ref part :>> obligation=responsibility8; attribute :>> purpose="Phase product and descriptor representation; open extension"; }
    part use6:ComponentObligation { ref part :>> component=component1; ref part :>> obligation=responsibility6; attribute :>> purpose="Actual semantic/generator/consumer correspondence"; }
    part use7:ComponentObligation { ref part :>> component=component2; ref part :>> obligation=responsibility8; attribute :>> purpose="Object/frame/module representation; open extension"; }
    part use8:ComponentObligation { ref part :>> component=component2; ref part :>> obligation=responsibility6; attribute :>> purpose="Real emitter and consumer refinement; no forced QNT packing model"; }
