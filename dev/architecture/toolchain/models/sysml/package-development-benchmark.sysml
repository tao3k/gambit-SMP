package GambitPackageDevelopment {
    private import ScalarValues::*;
    part pairedExperiment {
        ref part executablePackage=repository0;
        ref part libraryPackage=repository1;
        ref part phaseEngine=component1;
        ref part emitter=component2;
        ref part artifactGraph=component4;
        attribute implementation:String="src/gambit_smp/scientific_package_development_benchmark_study.py::paired_elapsed_values; existing execution and artifact capabilities authenticate inputs before this pure value function";
        attribute nativeExecutor:String="src/gambit_smp/gerbil_build.py::execute_package; one shared kind-parameterized executor over managed source snapshots, Git metadata and original clean/build/test entries; failures retained before any performance witness";
        attribute arithmeticOwner:String="dev/architecture/toolchain/models/lean/DevelopmentBenefit.lean::twofoldAcceleration; conditional accounting only, not measured elapsed extraction";
        attribute temporalOwner:String="dev/architecture/toolchain/models/quint/package_benchmark_admission.qnt; publication, censoring, late exit and generation are exclusive temporal duties";
        attribute evidenceOwner:String="dev/modeling/ascent/package-development-benchmark.rules.scm; measurementReady, optimizationAccepted and twofoldAccepted are distinct";
        attribute targetFactor:Integer=2;
        attribute coldCase:String="package-clean";
        attribute cases:String="package-clean;no-change;leaf-edit;macro-edit;required-correctness";
        attribute repositories:String="mcp;poo";
        attribute measurementRule:String="Safe isolated native comparisons need matched authenticated source/tool/resource/input bindings; unresolved general semantic proofs do not block measurement. They still block their own release obligations";
        attribute sourceRule:String="Freeze one source cohort and explicit candidate delta before either arm. Match original package bytes and complete build/test graph. Concurrent vendor changes require a new cohort, never retroactive promotion";
        attribute profileRule:String="Same host/boot, monotonic clock/unit, SDK, target architecture, effective optimization settings, capacity, heap, budgets, dependency closure and cache policy. Bind differing compiler artifact identities explicitly; existing optimizations are baseline";
        attribute timingRule:String="elapsedNs is a positive integer for the complete declared case interval. Cold case includes official clean and build under the same supervisor; compiler bootstrap is separate. Retain preparation, build and correctness times separately; never transfer historical build-only timing to this scope";
        attribute cacheRule:String="Package-cold after official clean is not OS-page-cache-cold. Separate arm-owned output roots and fixed native-cache policy; no cross-arm generated/native artifact reuse";
        attribute incrementalRule:String="Predeclare exact identical leaf/macro edits and consumed dependency projection; no-change checks actual action inventory, macro edit checks all required invalidation, not only elapsed time";
        attribute observationRule:String="One pair cell per repository/arm/case per declared round; no duplicate selection. Missing, nonzero exit, timeout, unreaped or nonquiescent process, failed preparation, semantic or negative control censors the pair. Unknown work retains custody";
        attribute thresholdRule:String="For each repository independently, targetFactor*candidateNs <= referenceNs on cold builds and candidateNs <= referenceNs on every declared case. Do not average packages, sum overlapping timers, or infer time from bytes/counts";
        attribute samplingRule:String="One pair is feasibility evidence only. Any confirmation rounds/order must be frozen before running; retain every result, prohibit retry-until-pass and report the tested sample scope rather than claiming a distribution";
        attribute trustRule:String="The value function validates identities and integer arithmetic only; digest-shaped strings do not authenticate receipts. Native receipt/input/output extraction to these rows is still OPEN and must use existing owner capabilities";
        attribute rolloutRule:String="No new runner, stdout decoder or script per checkout. Test both package requests after a concrete work-removal delta exists; do not make complete framework cleanup or all standard-library targets prerequisites of a case with closed ready dependencies";
        attribute currentWorkRemoval:String="ModuleImageSpec now loads real fresh rationaldict, but full private header and four sizeof paths remain. Zero newly demonstrated frontend work removal; prefix recovery is not cold-build speedup";
        attribute wholePackageMeasured:Boolean=false;
        attribute nativeExtractorRefined:Boolean=false;
        attribute mergeAllowed:Boolean=false;
    }
    part def PackageCase { ref part budget:GambitDarwinDevelopment::DevelopmentTarget; attribute key:String; attribute root:String; attribute head:String; attribute graph:String; attribute command:String; attribute capacity:String; attribute cache:String; attribute correctness:String; attribute currentStatus:String; }
