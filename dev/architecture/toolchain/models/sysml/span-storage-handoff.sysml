 part def Contract { attribute key : String; attribute anchor : String; attribute rule : String; attribute openDuty : String; }
 part contract0 : Contract { attribute :>> key = "isolated-content"; attribute :>> anchor = "lexer.ss:120-122,146,175; deflexer.ss:53-58"; attribute :>> rule = "Private retained decoded chunks never alias mutable callback-visible @@; resuming after its allocation preserves the same exposed object"; attribute :>> openDuty = "Native/reflective alias exclusion and actual chunk publication; a copied Scheme record alone does not prove separate backing storage"; }
 part contract1 : Contract { attribute :>> key = "resume-occurrence"; attribute :>> anchor = "_thread.scm:8422-8529,8555-8584; lexer.ss:146,175"; attribute :>> rule = "Separate capture identity, resumption occurrence, source program point and transport operation; resuming after read does not reread, while executing a reader entry again may legitimately read current input"; attribute :>> openDuty = "Exact source/control simulation including captures in winding thunks; finite two-resumption model is not full Scheme semantics"; }
 part contract2 : Contract { attribute :>> key = "exception-reachability"; attribute :>> anchor = "std/error.ss:43-69; runtime/error.ss:16-20,37-43,67-72; runtime/syntax.ss:71,169-171"; attribute :>> rule = "ParseError and SyntaxError carry StackTrace continuation slots; delivery or successful wrapping does not prove old stream unreachable"; attribute :>> openDuty = "Actual reachable frames depend on tail-call elimination and capture point; do not assume every exception retains every stream"; }
 part contract3 : Contract { attribute :>> key = "translation-transfer"; attribute :>> anchor = "lang-reader.ss:60-71; runtime/error.ss:67-72; runtime/syntax.ss:169-171"; attribute :>> rule = "Prepare replacement roots before releasing original attempt custody; allocation, mapping or raise failure keeps responsibility until handler/trace/control reachability settles"; attribute :>> openDuty = "Ordinary nested-error propagation preserved; failure fallback must not silently replace the actual thrown exception with the original"; }
 part contract4 : Contract { attribute :>> key = "separate-release-domains"; attribute :>> anchor = "base.ss:7-8; lexer.ss:20,50-52; stream.ss:19,37-38; _io.scm:10003-10014"; attribute :>> rule = "Old stream, raw chunks, origin-port object and physical resource have distinct lifetimes; detached token/span views need not retain the old stream"; attribute :>> openDuty = "Prove no reverse side-table edge; GC-managed control capsules cannot be strongly rooted by their own native pin counts"; }
 part contract5 : Contract { attribute :>> key = "known-ignore-reduction"; attribute :>> anchor = "deflexer.ss:40-44; lexer.ss:146,175; lang-reader.ss:271-274,323-324"; attribute :>> rule = "A generated constant-$ reduction does not observe @@; a qualified descriptor may omit its otherwise unused chars->string materialization"; attribute :>> openDuty = "Restrict to proven generated descriptor; arbitrary Rs retain API, mutation and effects; allocation-failure observations require an explicit optimization profile"; }
