 part gain0 : Gain { attribute :>> key = "reset-calls"; attribute :>> avoided = "Same prior upper bound: 2A stream constructor calls plus A initial-location calls"; attribute :>> added = "Isolated content, views, root/operation records and adapters"; attribute :>> condition = "Not additive to prior study and not a time/allocation benchmark"; }
 part gain1 : Gain { attribute :>> key = "ignored-strings"; attribute :>> avoided = "For I qualified ignored occurrences: at most I chars->string source calls, with input lengths summing to L_ignore"; attribute :>> added = "Generated reduction classification, retained raw text and observation-policy proof"; attribute :>> condition = "Only constant-$ descriptors; preexisting compiler elimination may reduce realized saving to zero"; }
 part gain2 : Gain { attribute :>> key = "shared-raw-chunks"; attribute :>> avoided = "No mandatory full raw copy for each continuation resumption; old stream may drain before detached token/span views"; attribute :>> added = "Unique retained decoded contents plus O(views + active resumptions + pending operations); mutable @@ remains separate"; attribute :>> condition = "No side-table back edge; live errors/captures can retain history indefinitely"; }
 part gain3 : Gain { attribute :>> key = "modern-c-baseline"; attribute :>> avoided = "Remove split lifetime authority and accidental duplicate reads/effects"; attribute :>> added = "Tracing/root integration, failure custody and native publication support in either modern C or Zig"; attribute :>> condition = "Net work positive only when avoided work exceeds these supports; no uniquely Zig advantage established"; }
