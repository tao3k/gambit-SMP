 part gate2 : Gate { attribute :>> key = "exception-root-closure"; attribute :>> qualified = false; attribute :>> condition = "Original, replacement, secondary error, stacktrace and control references included before reclamation"; }
 part gate3 : Gate { attribute :>> key = "reclamation-adapter"; attribute :>> qualified = false; attribute :>> condition = "Managed reachability and native borrows/pending operations form a sound release witness without self-rooting cycles; native ordering unqualified"; }
 part gate4 : Gate { attribute :>> key = "ignore-specialization"; attribute :>> qualified = false; attribute :>> condition = "Generated constant-$ classification and allocation-observation policy prove omitted materialization admissible"; }
