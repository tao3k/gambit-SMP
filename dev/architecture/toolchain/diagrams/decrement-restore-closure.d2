direction: down
"derived-credit": "derived-credit\nRelease claim only after published and acknowledged\nexecution-session ownership; subsequent PSTATE\naccesses remain covered"
"execution-owner": "execution-owner\nAdopt original VM execution context before claim\nrelease; retain owner through host epilogue, catch\nrestoration and caller tail"
"host-restore": "host-restore\nR1 to SELF and host spill/reload remain under\nexecution ownership; same-host edges need their own\nlive-carrier proof"
"storage-commit": "storage-commit\nVM retirement requires settled execution and\nexported continuation/invocation authority; native\nempty receipt is narrower"
"catch-restore": "catch-restore\nTHROW and END_TRY access catcher and longjmp_err;\ncall epilogue still accesses fp and PSR0"
"abnormal-guard": "abnormal-guard\nRequired abnormal completion guard invalidates C\nmarker and settles roots even when lexical normal\ncleanup is bypassed"
"continuation-context": "continuation-context\nRetained continuation holds VM/frame authority;\nrestore acquires a valid current processor in same\nVM, not resurrected original PSTATE"
"leaf-release": "leaf-release\nLeaf decrement only in stable outer custodian after\nmarker, conversion/error propagation and restoration\nboundary settle"
"execution-owner" -> "derived-credit"
"derived-credit" -> "host-restore"
"host-restore" -> "catch-restore"
"catch-restore" -> "abnormal-guard"
"abnormal-guard" -> "leaf-release"
"abnormal-guard" -> "continuation-context"
"continuation-context" -> "storage-commit"
"leaf-release" -> "storage-commit"
"catch-restore" -> "leaf-release"
"execution-owner" -> "storage-commit"
proof: "SysML -> ASCENT -> QNT / Lean; source + platform OPEN"
"storage-commit" -> proof
gain0: "session-reuse\nOnly a proved shared-session contract permits b-s\nlease-pair reduction; current code has no such receipt\nand no speed gain is established"
proof -> gain0
gain1: "closure-retention\nContinuation roots retain required VM state, not every\noriginal processor indefinitely; no arbitrary forced\ntimeout"
proof -> gain1
gain2: "guard-support\nReuse must cover longjmp and multi-shot re-entry;\nordinary local cleanup flag or lexical return is\ninsufficient"
proof -> gain2
gain3: "c-baseline\nNo measured throughput or build gain; Zig cannot remove\nthese obligations and no additional net benefit is\nestablished"
proof -> gain3
