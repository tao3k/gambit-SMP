direction: down
classes: {
  source: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  contract: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
}
probe: "Existing configure authority\nCompiler / platform probes and captured inputs\nHeader values; capability evidence" {class: source}
policy: "One native policy definition\nProposed M4-owned vectors and recipe graph\nOrder / overrides / roles / binding stages\nNo parallel Zig flag table" {class: proposed}
model: "ConfiguredNativeModel\nLiteral words + capture/request/path references\nOrigins / feature set / unavailable tools\nLegacy opaque fragments explicitly tagged" {class: contract}
probe -> model
policy -> model
outputs: "Two renderers, one model" {
  legacy: "Legacy projection\nSH bindings and shell templates\nPreserve opaque fragments for legacy callers" {class: source}
  typed: "Typed projection\nAdmitted modes and ordered argv recipes\nReject reachable opaque or unbound inputs" {class: proposed}
}
model -> outputs.legacy
model -> outputs.typed
manifest: "Coherent generation manifest\nModel + header + script + profile digests\nStage first; activate only complete generation\nNo claim config.status is already atomic" {class: contract}
outputs.legacy -> manifest
outputs.typed -> manifest
extension: "Gerbil-owned extension\nDirect-exe recipes and semantic filtering\nSame schema, explicit compatibility" {class: source}
resolve: "One managed resolver and native executor\nIntent + typed profile + bound environment\nNo gambuild / native gsc -obj / shell eval" {class: proposed}
manifest -> resolve: "typed selection"
extension -> resolve
portable: "Explicit legacy selection\nUnsupported / portable callers remain scoped\nNo retry after managed effects" {class: source}
manifest -> portable: "legacy selection"
note: "DESIGN ONLY. New model/writer/renderers/manifest are not implemented.\nAutoconf emits the writer for configure hosts; no target Zig/GSC/MLIR bootstrap dependency." {shape: text; style.font-size: 15}
resolve -> note: {style.opacity: 0}
