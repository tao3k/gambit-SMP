direction: down
"derived-credit": "derived-credit\nRequests own durable identities independently of\npipe bytes; notification retries never republish\nsemantic work"
"full": "full\nFull-channel coalescing requires pinned endpoints,\nunique owner drain and mandatory pending recheck\nafter drain"
"eintr": "eintr\nInterrupted notification retains generation pin and\ndelivery credit; retry same wake right or use\nqualified rescue"
"storage-commit": "storage-commit\nAcquire endpoint plus generation under lifecycle\ngate; both descriptors remain alive through syscall\nand response settlement"
"arm": "arm\nArm and recheck durable pending under owner gate;\ndrain does not clear request identity; finite wait\nbounds missed notification detection conditionally"
"failure": "failure\nHard/unknown notification keeps producer or rescue\ncustody; signal lane uses prepinned lifetime and\nquiescence instead of mutex acquisition"
"participant": "participant\nReturn from OS wait then release borrow, publish\nroots and join old roster; acknowledge only selected\nrequest snapshot"
"retirement": "retirement\nWithdraw admission, drain producer/wait/signal\nusers, settle request and prior roster receipts,\nthen close; uncertain close quarantines generation"
"derived-credit" -> "full": "Bytes are not semantic request\ndebt"
"storage-commit" -> "full": "Full-channel witness requires\npinned lifetime"
"storage-commit" -> "eintr": "Retry retains exact endpoint\ngeneration"
"derived-credit" -> "arm": "Recheck sees published semantic\nrequests"
"full" -> "arm": "Drain is followed by durable\nrecheck"
"storage-commit" -> "failure": "Failure retains endpoint\nlifetime"
"arm" -> "participant": "Wake reaches rooted old owner"
"storage-commit" -> "retirement": "Pins drain before descriptor\nclose"
"failure" -> "retirement": "Signal grace and rescue\nresponsibility settled"
"participant" -> "retirement": "Old roster receipt precedes\nretirement"
proof: "SysML -> ASCENT -> QNT / Lean; source + platform OPEN"
"retirement" -> proof
gain0: "coalescing\nFor N requests an already-full channel may add zero\nbytes; request multiplicity is preserved by semantic\nledger, not byte count"
proof -> gain0
gain1: "latency\nConditional detection bound T plus scheduling delay;\nnot measured latency or arbitrary OS progress guarantee"
proof -> gain1
gain2: "lifetime\nO(P+W+S) control records plus payload roots; retained\nunknown close may quarantine VM services"
proof -> gain2
gain3: "language\nZig cannot remove synchronization, signal ABI, root or\nretirement obligations; extra language value not\nestablished"
proof -> gain3
