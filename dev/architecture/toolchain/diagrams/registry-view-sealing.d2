direction: down
registry: "Registry / native SysML" {
 grid-columns: 2
 n0: "five-roots\nFive list globals initialized empty; five define-*\nhelpers prepend; only managed profile may close\nwriters"
 n1: "stock-registrations\nPreserve initialization completion, duplicate\nprecedence and cross-category parser priority; do not\nnormalize to an unordered name set"
 n2: "parser-read\nParser checks flag, parameterized, boolean, namable,\nnamed-boolean in that order; registry receipt is a\nparser input"
 n3: "identity\nassq memq eq? require consistent symbol identities and\nprivate primitive names; spelling alone needs a proved\nbijection"
 n4: "extension\nLate registration creates a new managed registry\nsnapshot; unmediated writes taint dependent admission\nrather than blessing old keys"
}
alias: "Alias / native SysML" {
 grid-columns: 2
 n0: "parser-owned\nFresh extracted names spine can be privately sealed;\nshared symbols remain identity-bearing leaves"
 n1: "constructor-borrow\nBoth named constructors retain the caller names tail;\ncopying only the outer record does not close writable\naliases"
 n2: "view-borrow\nenv-declare stores supplied record; env-decl-ref\nexposes complete list; seal private copy or prove\nexclusive writer closure"
 n3: "revoke-drain\nStop new leases atomically with retirement; coherent\npinned immutable attempts may drain; tainted attempts\ncannot publish; roots survive until all holders exit"
}
chain: "Chain / native SysML" {
 grid-columns: 2
 n0: "per-name-arith\nEvery step queries the current provider captured\ncanonical name; named + does not cover ##+"
 n1: "unsafe-priority\nUnsafe distinct fallback precedes arithmetic mode; ##+\nhas absent unsafe fallback=self"
 n2: "fx-unsafe\nfx+ selects ##fx+ only when safe? is false"
 n3: "initial-gate\nResolve application/operand views per caller and\npreserve initial arity gate; no invented intermediate\narity gate"
 n4: "fixed-point\nCommit only after actual self step; stable private\nidentity/helper domain; exceptions and nontermination\nstay explicit"
}
gain: "Gain / native SysML" {
 grid-columns: 2
 n0: "registry-snapshot\nR registry work saved must exceed snapshot validation\nand key cost; current lists already share tails"
 n1: "named-view\nShare sealed tails only; retained-memory and\nrevocation-drain costs are accounted separately"
 n2: "chain-query\nPositive only when reused work or removed critical\npath exceeds added overhead; no fabricated core-count\nspeedup"
}
proof: "RV-H/I/S/E -> local ASCENT -> QNT / Lean; source and native gates OPEN"
registry -> alias
alias -> chain
chain -> proof
proof -> gain
