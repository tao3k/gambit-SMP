# Native SysML owns responsibilities/stages/graph; arrows denote logical contracts, not implementation.
direction: down
components: "Replacement architecture / modern C + Scheme" {
 grid-columns: 2
 c0: "snapshot-broker\nResolve all files, absence, paths,\nenvironment and admitted native reads in an\nimmutable input epoch"
 c1: "query-engine\nDemand phase-specific compiler results;\nrecord dynamic reads and validate prior\ntraces"
 c2: "semantic-session\nInstantiate binding/mark/module identity and\nmutable overlays per session"
 c3: "artifact-publisher\nCommit a coherent result manifest containing\ntyped interface, executable support, semantic\nIR and native products"
 c4: "resource-scheduler\nSingle-flight result keys, suspension on\ndiscovered dependencies, resource budgets and\ncancellation custody"
 c5: "backend-runtime\nGenerated modern C consumes the semantic\nresult and runtime contract; LLVM/MLIR\noptional consumers use the same contract"
}
stages: "Typed results / live session instances are separately owned" {
 grid-columns: 2
 s0: "source-syntax"
 s1: "binding-interface"
 s2: "phase-program"
 s3: "session-instance"
 s4: "expanded-semantic-ir"
 s5: "gvm-contract"
 s6: "generated-modern-c"
 s7: "native-manifest"
}
dag: "Bounded formal graph / not the full production graph" {
 n0: "iter-interface"
 n1: "iter-support"
 n2: "expand-misc"
 n3: "expand-wg"
 n4: "native-misc"
 n5: "native-wg"
 n6: "target-link"
 n7: "dynamic-support"
}
dag.n0 -> dag.n1
dag.n0 -> dag.n2
dag.n1 -> dag.n2
dag.n0 -> dag.n3
dag.n1 -> dag.n3
dag.n2 -> dag.n4
dag.n3 -> dag.n5
dag.n4 -> dag.n6
dag.n5 -> dag.n6
dag.n7 -> dag.n2: "dynamic / suspended demand" {style.stroke-dash: 4}
proof: "SysML IC-H/I/S/E -> ASCENT -> QNT / Lean"
benefit: "Separate work W, span S, overhead H and retained memory M"
gate: "Seven source/platform gates OPEN; no measured speedup"
components -> stages
stages -> dag
dag -> proof
proof -> benefit
benefit -> gate
