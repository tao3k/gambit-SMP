direction: down
chain: "Real iter macro dependency chain / executable closure still under admission" {
helpers: "std/interface + list-builder + iter/interface + iter/iterators"
macros: "iter/macros: begin-syntax + for / for1 / dispatch"
api: "iter/api -> std/iter re-export"
misc: "string/misc: for + in-range"
wg: "sync/wg: for + thread-join!"
helpers -> macros
macros -> api
api -> misc
api -> wg
}
seams: "Proposed typed stage contracts / not current public APIs" {
 s0: "gerbil-expand\nGerbil"
 s1: "generated-scheme\nGerbil to Gambit"
 s2: "normalize\nGambit"
 s3: "lower-gvm\nGambit"
 s4: "emit-modern-c\nGambit to Gerbil"
 s0 -> s1
 s1 -> s2
 s2 -> s3
 s3 -> s4
}
context: "Owned Gambit context / source writer census remains open" {
 grid-columns: 2
 c0: "environment\nnext-var-stamp, ret-var, ret-var-set,\nclosure-env-var, empty-var"
 c1: "parse-tree\nptree port, next-node-stamp, temp-variable-\nstamp"
 c2: "gvm\noperand interning plus basic-block/emission\nstate"
 c3: "target\ntarget selection, primitive metadata and\ntarget dispatch functions"
 c4: "outcome\ninput/diagnostic ports, roots, suspended\nstate, errors and result thunk"
}
ready: "Gerbil scheduler: binding + executable support + owned fresh instance"
drain: "Pause retains roots/context; failure or unknown drains; seal before release"
proof: "SysML IS-H/I/S/E -> ASCENT route -> QNT histories / Lean premises"
gain: "Benefit: avoided work > added work; removed critical path > added span"
 chain -> ready
 ready -> seams
 seams -> context
 context -> drain
 drain -> proof
 proof -> gain
