direction: down
root: "Root / native SysML" {
 grid-columns: 2
 n0: "scheme-roots\nScheme global/continuation/register/saved roots are\nactual scan paths; service-owned root graph must\nremain in their qualified closure"
 n1: "rc-scope\nRC list is per processor but inspected strong phase\ninvokes mark_rc only at processor 0; arbitrary worker\nRC coverage remains unqualified"
 n2: "rc-mutation\nRC retain/release and data assignment are plain\noperations; do not treat them as thread-safe handle\nleases or immutable publication"
 n3: "allocator\nNative still allocation may GC/fail; initialize body\nbefore next allocation; native pair/vector input\nconstraints forbid arbitrary movable arguments"
 n4: "ffi-gap\nReal stack-marker creator allocates before assigning\nproc_or_false and carries a GC-protection TODO;\ncopying this order does not prove candidate input\nsafety"
}
publication: "Publication / native SysML" {
 grid-columns: 2
 n0: "root-store\nService Scheme root graph and future VM-scoped root\nregistry must cover bundle graph/receipts; native\ndescriptor carries identity not raw movable address"
 n1: "reserve-initialize\nReserve empty scanned slot, protect allocation inputs,\ninitialize each new object before next GC-capable\nstep, then attach through qualified slot store"
 n2: "release-acquire\nRelease publication/acquire observation orders native\nmetadata; separate scanner/lifetime proof still\nrequired"
 n3: "pin-retire\nRead descriptor and acquire its lifetime lease under\nsame retirement gate; load then addref is a reclaim\ngap"
 n4: "fallback\nEmulated CAS uses mutex but barrier fallback is empty;\nsequential branch is not concurrent publication\nqualification"
}
gain: "Gain / native SysML" {
 grid-columns: 2
 n0: "shared-root-graph\nActual avoided copying must exceed\nroot/index/retention overhead; roots alone are\ncorrectness, not speedup"
 n1: "independent-contexts\nIndependent ready work must exceed coordination;\ncurrent nonzero RC coverage not assumed"
 n2: "failure-recovery\nNo effect rollback/retry on unknown commit; retention\nand unresolved tasks can negate gains"
}
proof: "BR-H/I/S/E -> local ASCENT -> QNT / Lean; source and native gates OPEN"
root -> publication
publication -> proof
proof -> gain
