direction: down
classes: {
  retained: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  contract: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
config: "Configured profile\nAuthoritative features / header / runtime / target\nTyped mode defaults and captured override origins\nActual GCC / SDK values required, not guessed" {class: retained}
intent: "Native intent + source metadata\nMode ID / ordered inputs and roles / symbols\nLiteral argv and typed conditions\nAbsent, empty vector and empty argument stay distinct" {class: retained}
admit: "Managed Darwin/GCC admission\nNative host/target, explicit tools/runtime compatibility\nSelected recipe and complete required fields?" {class: contract}
config -> admit
intent -> admit
reject: "Reject / defer unsupported profile or syntax\nNo fallback replay through old native chain\nSelected design is not qualified support" {class: contract}
admit -> reject: "unsupported / unresolved"
resolve: "One resolver: ordered resolution actions\nSearch precedence; pkg --cflags then --libs\nConditional metadata and exact per-mode segments\nPreserve diagnostics and actual query failures" {class: proposed}
admit -> resolve: "admitted inputs"
failure: "Resolution failure\nNo compiler result or successful cache HIT\nKeep stage / status / diagnostic evidence" {class: contract}
resolve -> failure: "failed query / decoding"
plan: "Effective plan\nExact tool + argv + environment + cwd\nBound input/output paths and dependencies\nField provenance and suppression decisions" {class: contract}
resolve -> plan
execute: "Direct native execution\nObject / bundle / generic exe / Gerbil direct-exe recipe\nDo not unify their distinct argument order\nNo gambuild-C, shell eval or nested gsc -obj" {class: proposed}
plan -> execute
result: "Native result and artifact envelope\nK request / D content / P compatibility / E admission\nRuntime loading and semantics remain Gambit-owned" {class: retained}
execute -> result
note: "DESIGN ONLY. No actual configured profile or native mode is qualified here.\nObject mode still performs package library queries; unused argv slots do not prove dead effects.\nRuntime construction, archive/dylib, cross targets and unadmitted MLIR outputs are outside initial scope." {shape: text; style.font-size: 15}
result -> note: {style.opacity: 0}
