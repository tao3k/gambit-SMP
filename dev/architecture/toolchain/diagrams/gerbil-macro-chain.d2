direction: right
# Selected action families; runtimeOnly may be empty; link is a proposed combined request.
node_macroInterface: "Coherent macro interface\nfamily 0"
node_phaseSupport: "Executable phase closure\nfamily 1"
node_facade: "Re-exported phase program\nfamily 2"
node_expandA: "Expand string/misc\nfamily 3"
node_expandB: "Expand sync/wg\nfamily 4"
node_nativeA: "Compile string/misc runtime\nfamily 5"
node_nativeB: "Compile sync/wg runtime\nfamily 6"
node_runtimeOnly: "Certified runtime-only remainder\nfamily 7"
node_link: "Example combined load/link closure\nfamily 8"
node_macroInterface -> node_phaseSupport
node_macroInterface -> node_facade
node_phaseSupport -> node_facade
node_facade -> node_expandA
node_facade -> node_expandB
node_expandA -> node_nativeA
node_expandB -> node_nativeB
node_macroInterface -> node_runtimeOnly
node_nativeA -> node_link
node_nativeB -> node_link
node_runtimeOnly -> node_link
node_runtimeOnly.style.stroke-dash: 4
node_link.style.stroke-dash: 4

