# SysML-derived conditional design; no native admission.
direction: down
DX_SPEC: "DX-SPEC\nmacOS development is a first-class\nmodern C contract"
SV_REFINE: "SV-REFINE\nFormal ledger preservation is\nnot concrete read or\ncontinuation admission"
SV_REFINE -> DX_SPEC
S_COST: "S-COST\nCharge stable acquisition, trace\nobligations and required effects"
S_COST -> DX_SPEC
DX_ATTRIBUTION: "DX-ATTRIBUTION\nDo not conflate Scheme expansion, C\nprovenance and first-output latency"
DX_SPEC -> DX_ATTRIBUTION
DX_LOWERING: "DX-LOWERING\nMove invariant ABI work out of per-\nmodule macro expansion"
DX_ATTRIBUTION -> DX_LOWERING
DX_REUSE: "DX-REUSE\nOne validated native request must\nremove duplicate preparation"
DX_SPEC -> DX_REUSE
SV_ISSUE: "SV-ISSUE\nIssue only after writer ingress,\nroot coverage and acquisition\nsettle"
SV_ISSUE -> DX_REUSE
DX_ADMISSION: "DX-ADMISSION\nDeveloper gain requires bounded\nwork, latency and memory across\nreal scenarios"
DX_REUSE -> DX_ADMISSION
DX_LOWERING -> DX_ADMISSION
roles: {
  label: "Required C architecture replacement roles / native qualification OPEN"
  direction: right
  Scheme: "Scheme semantic decisions"
  C_MODULE: "C-MODULE\nModule data and invariant\nruntime ABI"
  Scheme -> C_MODULE: "explicit contract"
  C_FRAME: "C-FRAME\nFrame, root and return-\npoint descriptors"
  Scheme -> C_FRAME: "explicit contract"
  C_MODULE -> C_FRAME: "requires"
  C_LITERAL: "C-LITERAL\nObject and literal data\nlowering"
  Scheme -> C_LITERAL: "explicit contract"
  C_MODULE -> C_LITERAL: "requires"
  C_EMISSION: "C-EMISSION\nRequest-owned emitter and\npublication lifecycle"
  Scheme -> C_EMISSION: "explicit contract"
  C_LINK: "C-LINK\nLink observation and\nconsumer protocol"
  Scheme -> C_LINK: "explicit contract"
  C_EMISSION -> C_LINK: "requires"
  C_MODULE -> C_LINK: "requires"
  Accepted: "Producer + consumer + failure/control parity\nNo native role retired yet"
  C_MODULE -> Accepted
  C_FRAME -> Accepted
  C_LITERAL -> Accepted
  C_EMISSION -> Accepted
  C_LINK -> Accepted
}
roles -> DX_ADMISSION: "whole-request gain and runtime acceptance"
