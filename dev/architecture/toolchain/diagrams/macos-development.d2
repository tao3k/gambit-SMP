# SysML native projection; dependency closure is not runtime or reuse admission.
direction: down
DX_SPEC: "DX-SPEC\nmacOS development is a first-class modern C contract\nconditional-development-contract"
DX_ATTRIBUTION: "DX-ATTRIBUTION\nDo not conflate Scheme expansion, C provenance and first-output latency\nhistorical-component-evidence"
DX_LOWERING: "DX-LOWERING\nMove invariant ABI work out of per-module macro expansion\narchitecture-hypothesis-native-open"
DX_REUSE: "DX-REUSE\nOne validated native request must remove duplicate preparation\nhistorical-regression-and-conditional-design"
DX_ADMISSION: "DX-ADMISSION\nDeveloper gain requires bounded work, latency and memory across real scenarios\nconditional-whole-request-admission"
DX_CURRENT_COST: "DX-CURRENT-COST\nAttribute the actual modern-C bootstrap critical path\nobserved-envelope-and-source; inner-attribution-open"
DX_C23_DARWIN: "DX-C23-DARWIN\nC23 baseline must retire repeated C macro work by responsibility\nrequired-C23-modernization-target; runtime-and-speedup-open"
DX_FEEDBACK_PATH: "DX-FEEDBACK-PATH\nSeparate full bootstrap qualification from incremental development work\nincremental-projection-and-retirement-open"
DX_NATIVE_POLICY: "DX-NATIVE-POLICY\nExisting configure and Make; no parallel profile or executor\nexisting-configure-make; typed-experiment-withdrawn; incremental-native-qualification-pending; M8-retirement-open"
SV_REFINE: "SV-REFINE\nSV-REFINE"
S_COST: "S-COST\nS-COST"
SV_ISSUE: "SV-ISSUE\nSV-ISSUE"
SV_REFINE -> DX_SPEC
S_COST -> DX_SPEC
DX_SPEC -> DX_ATTRIBUTION
DX_ATTRIBUTION -> DX_LOWERING
DX_SPEC -> DX_REUSE
SV_ISSUE -> DX_REUSE
DX_REUSE -> DX_ADMISSION
DX_LOWERING -> DX_ADMISSION
DX_ATTRIBUTION -> DX_CURRENT_COST
DX_ADMISSION -> DX_CURRENT_COST
DX_CURRENT_COST -> DX_C23_DARWIN
DX_LOWERING -> DX_C23_DARWIN
DX_C23_DARWIN -> DX_FEEDBACK_PATH
DX_REUSE -> DX_FEEDBACK_PATH
DX_C23_DARWIN -> DX_NATIVE_POLICY
DX_FEEDBACK_PATH -> DX_NATIVE_POLICY
roles: {
  label: "Required C architecture replacement roles / native qualification OPEN"
  direction: right
  Scheme: "Scheme semantic decisions"
  C_MODULE: "C-MODULE\nModule data and invariant\nruntime ABI"
  Scheme -> C_MODULE: "explicit contract"
  C_FRAME: "C-FRAME\nFrame, root and return-\npoint descriptors"
  Scheme -> C_FRAME: "explicit contract"
  C_MODULE -> C_FRAME: "requires"
  C_LITERAL: "C-LITERAL\nObject and literal data\nlowering"
  Scheme -> C_LITERAL: "explicit contract"
  C_MODULE -> C_LITERAL: "requires"
  C_EMISSION: "C-EMISSION\nRequest-owned emitter and\npublication lifecycle"
  Scheme -> C_EMISSION: "explicit contract"
  C_LINK: "C-LINK\nLink observation and\nconsumer protocol"
  Scheme -> C_LINK: "explicit contract"
  C_EMISSION -> C_LINK: "requires"
  C_MODULE -> C_LINK: "requires"
  Accepted: "Producer + consumer + failure/control parity\nNo native role retired yet"
  C_MODULE -> Accepted
  C_FRAME -> Accepted
  C_LITERAL -> Accepted
  C_EMISSION -> Accepted
  C_LINK -> Accepted
}
roles -> DX_ADMISSION: "whole-request gain and runtime acceptance"









# Native artifact boundary projection
artifacts: {
  label: "Distinct artifact projections / actual reuse admission OPEN"
  Scheme_generation: "Scheme generation\nscheme-source; macro-read; compiler-stage; generation-option; generation-path; generation-effect"
  Native_compilation: "Native compilation\ngenerated-c; handwritten-c; header-abi; native-policy; native-toolchain; target"
  Native_linking: "Native linking\nnative-object; native-runtime; link-policy; link-toolchain; module-binding"
  Scheme_generation -> Native_compilation: "changed output"
  Native_compilation -> Native_linking: "changed output"
}
DX_NATIVE_POLICY -> artifacts.Native_compilation: "native policy input"
constructors: "Mutable producer instance\nWritable working roles additionally bind the verified durable run-header digest and exact step endpoint; input content alone is not mutable identity\nExisting native case/history/prior and budget admission precedes construction; activation never enters the native case key or changes compiler flags"
constructors -> artifacts: "completed content reuse stays separate"
native_stage: "Modern C native-stage request\nExisting Make consumes explicit completed GeneratedCArtifact, native C leaf delta, ABI and the existing configured BUILD commands; no additional profile or executor. Never silently upgrade the compiler service or issue arbitrary Scheme-query freshness\nNative-only phase3/phase4 replaces gsc-boot with a non-executable directory gate and restores it afterward; complete generated artifact and original producer hashes stay unchanged. Unexpected generation fails; fixture Scheme compilation is accounted separately"
artifacts.Scheme_generation -> native_stage: "explicit completed artifact"
native_stage -> artifacts.Native_compilation: "C leaf + ABI + existing Make"
native_workspace: "One task-cache development workspace selected by an origin-bound route for first build, no-change rebuild and actual C-leaf edit; no per-run activation key, implicit clean, replacement tree or end-of-run full-tree snapshot. Origin replacement requires explicit rebase. Build entry reconciles active custody without global retention; native run returns its receipt without catalog evaluation"
native_configuration: "Existing configure_owned_source is the single owner of full output hashes and actual completed configure receipt. Same selected source/template/profile/tool/environment request skips aclocal/autoconf/configure; C leaf bodies are not configuration inputs. SDK/system replacement requires task-profile requalification; no general read-effect closure issued"
native_workspace -> native_stage: "same task-owned tree; no per-run copy"
native_configuration -> native_stage: "shared configure owner / same-request reuse"
validation: {
  label: "Validation identity and lifetime / fresh execution stays separate"
  configuration_proof: "configuration-proof\nselected-reuse\nqualified-task-profile"
  leased_tree_identity: "leased-tree-identity\nselected-reuse\nlive-recipe-lease"
  completed_step: "completed-step\nretained-only\nretained-observation"
  fixture_compilation: "fixture-compilation\nsame-recipe-only\nsame-recipe-compiled-artifact"
  smp_execution: "smp-execution\nfresh-required\nactual-execution"
  framework_controls: "framework-controls\nconditional\nqualified-test-context"
}
native_stage -> validation: "measure checks separately from Make and tests"
shared_fixtures: {
  label: "Three compilations / five fresh executions; original context retained"
  wide_map: "wide-map\ncompile + execute"
  wide_map_host: "wide-map-host\nconsume + fresh execute"
  wide_map -> wide_map_host: "exact compiled artifact / original cwd"
  worker_roles: "worker-roles\ncompile + execute"
  worker_roles_host: "worker-roles-host\nconsume + fresh execute"
  worker_roles -> worker_roles_host: "exact compiled artifact / original cwd"
}
native_stage -> shared_fixtures: "same runtime + tools / no new executor"
