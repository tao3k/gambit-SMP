direction: down
alias: "Alias / native SysML contracts" {
 grid-columns: 2
 n0: "target-capture\nregistry -> target vector -> default label/jump\nclosures -> original targ"
 n1: "primitive-self\nprimitive table -> proc vector -> specialize closure\n-> same proc vector"
 n2: "cross-primitive\ndef-spec -> specializer-maker -> get-prim-info ->\nspec/proc/specs captured objects"
 n3: "inline-context\nGVM primitive -> inline closure -> target\nemitter/frame/global state"
 n4: "canonical-tag\nproc vector slot zero -> proc-obj-tag; proc-obj?\ncompares eq?"
 n5: "gvm-cintf\nGVM/constants and c-intf/queues retain references to\nprocedures and foreign metadata"
}
phase: "Phase / native SysML contracts" {
 grid-columns: 2
 n0: "classify\nSeparate immutable data, relocated mutable nodes,\ncanonical tags and approved provider recipes"
 n1: "allocate-shells\nAllocate all destination shells in one private\nrooted arena; define injective ObjectId to handle\nmap"
 n2: "wire-graph\nPatch graph sharing/cycles, canonical tags and all\nGVM/C-interface references through one map"
 n3: "bind-providers\nGenerate self/cross-primitive and target/frame\nbehavior bound to destination handles/context"
 n4: "validate\nValidate mapping, provider coverage and\nobservational projection; close construction\nauthority"
 n5: "publish\nPublish ready workspace once, then allow destructive\nC emission using private payloads"
}
fidelity: "Fidelity / native SysML contracts" {
 grid-columns: 2
 n0: "identity\nPreserve equality and distinction inside a session;\nfresh mutable instances across sessions; stable\nnames are not eq?"
 n1: "origin\nCarry generated-view locations separately from\noptional original-source map; retain source in abort\ndiagnostics"
 n2: "declarations\nRebuild the same scoped declaration tree before\nselecting semantic target profile"
 n3: "exceptions\nProvider/patch failure produces admitted observer-\ncompatible outcome; original resources stay owned\nuntil settled"
}
gain: "Gain / native SysML contracts" {
 grid-columns: 2
 n0: "shared-template\n(k-1)*avoidedFront > Fz + k*(R+L) + V; raw closure\ncopy has no automatic saving"
 n1: "private-parallelism\nRemoved critical-path delay exceeds added\nreconstruction/coordination; runtime SMP qualified\nseparately"
 n2: "exclusive-single-use\nExclusive transfer remains available; do not count\nit as simultaneous shared snapshot reuse"
 n3: "retirement\nEvery compile/link/provider caller migrates;\nunchanged C preprocessing costs remain separate"
}
provider: "Scheme-generated qualified recipe families\ntarget-calling, self-specializer, safe-specializer,\nunsafe-specializer, nargs-specializer, arith-specializer,\nforce-inline, ordered-folders"
proof: "SysML AR-H/I/S/E -> local ASCENT -> QNT / Lean; source, host registration, native gates OPEN"
alias -> provider
provider -> phase
phase -> fidelity
fidelity -> proof
proof -> gain
