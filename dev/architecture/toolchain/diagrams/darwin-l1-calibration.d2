direction: down
classes: {
  retained: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
truth: "Independent calibration manifest\nExplicit raw argv/env vectors and cwd\nBound recorder variant and expected termination\nNo shared typed decoder as oracle" {class: retained}
launcher: "Controlled fixture launcher\nOwns only calibration child\nNo logger env/argv or inherited sink FD\nChanges here do not qualify original-tool L2" {class: proposed}
truth -> launcher
transition: "Darwin image transition and startup\nKernel exec boundary differs from main entry\nLoader/security effects remain observable limits" {class: gate}
launcher -> transition
leaf: "L1 native leaf at main entry\nCount/order/length/bytes for argv and raw env\nPhysical cwd identity + getcwd result/error\nCapture before opening the private sink" {class: proposed}
transition -> leaf
sink: "Fixture-bound absolute sink\nFramed bytes + checksum + exclusive commit\nOutside source/cwd/package search roots\nAny missing/truncated record invalidates evidence" {class: proposed}
leaf -> sink
status: "Designated calibration parent\nRaw wait status and decoded termination\nNo competing waitpid in Gambit runtime" {class: retained}
leaf -> status
compare: "C01-C12 calibration gate\nBytes / duplicate env / empty values / cwd errors\nSizes / concurrency / sink faults / control contamination\nMutated record copies must be rejected" {class: gate}
sink -> compare
status -> compare
truth -> compare
scope: "Admit only derived construction scope\nCopied legacy leaf slots versus managed fixture\nSame recorder tool identity in both arms\nNo GCC artifact or original-native parity claim" {class: gate}
compare -> scope
note: "DESIGN ONLY. No recorder, fixture launcher or calibration was implemented or run.\nPerfect main-entry recording cannot establish zero startup/system perturbation." {shape: text; style.font-size: 15}
scope -> note: {style.opacity: 0}
