direction: down
caller: "Caller / native SysML" {
 grid-columns: 2
 n0: "rc-register\nCurrent PSTATE registration versus processor-0 RC scan\nis not a VM-wide root contract"
 n1: "c-closure\nReal C closure stores Scheme proc in RC data; callback\nself and marker protection remain separate qualified\nboundaries"
 n2: "tcl-client\nTcl retains RC client data plus still vector; deletion\nreleases both; scan observations alone do not prove\ncurrent object death"
 n3: "resize-exit\nProcessor setup/cleanup initializes/frees RC chains;\ncommitted VM roots and their still-object storage must\nsurvive creator processor; root registration alone is\ninsufficient"
 n4: "gc-phase\nExisting GC phase barriers and root partitions are\nsource seams; registry membership is not\nprocessor_count"
}
protocol: "Protocol / native SysML" {
 grid-columns: 2
 n0: "register\nReserve initialized slot; producer root protects\npayload until atomic VM-root/index receipt handoff;\nwrong VM rejects"
 n1: "seal\nClose new permits, drain/cancel preaccepted updates\nand dereferences, then freeze slot membership and\nscanner tickets"
 n2: "scan\nExactly covered slots scanned via mutable root\nlocations; relocation updates values; registered\nreaders hold lifetime not raw addresses"
 n3: "retire\nClose slot admission; retain until scanner tickets,\nupdate permits, read leases and unresolved receipt\nholders all retire"
 n4: "processor-lifetime\nCommitted slot ownership belongs to VM, not creator\nPSTATE; local-only pending roots and still storage\nneed separate handoff before processor cleanup"
}
gain: "Gain / native SysML" {
 grid-columns: 2
 n0: "vm-root-ownership\nOnly committed VM-owned slots decouple from processor\nexit; no elimination of root scanning"
 n1: "stable-scan\nExact membership can bound scan work; quiescence\ndelays and slot bookkeeping count"
 n2: "independent-service\nParallel benefit requires actual independent work and\nall native writers admitted; no automatic multicore\ngain"
}
proof: "VR-H/I/S/E -> local ASCENT -> QNT / Lean; source and native gates OPEN"
caller -> protocol
protocol -> proof
proof -> gain
