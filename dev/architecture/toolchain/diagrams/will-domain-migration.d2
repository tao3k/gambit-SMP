direction: down
caller: "Caller / native SysML" {
 grid-columns: 2
 n0: "registration-and-writers\nMAKEWILL prepends movable will to current PSTATE\nnonexec list; raw field setters and explicit execution\nare distinct managed writers"
 n1: "decision-and-rebuild\nTestator must be memory allocated and unmarked; follow\nforwarding before reading; preserve tagged next flags\nand rebuild moved list heads"
 n2: "automatic-and-explicit\nCurrent GC raises interrupt only on p0; finalizer pops\ncurrent PSTATE list; public explicit execution need\nnot wait for eligibility; Scheme owns action context"
 n3: "shutdown-and-real-users\nExit final-will FIFO is separate; real SQLite and\nephemeron callbacks mutate resources/state and require\nexplicit context and failure policy"
 n4: "processor-exit\nStorage handoff does not transfer semantic weak\nmembership; creator exit must preserve both lists,\npending work and rooted action frames"
}
protocol: "Protocol / native SysML" {
 grid-columns: 2
 n0: "weak-domain-transfer\nSame VM weak-domain membership, not ordinary strong\nRootRegistry payload; close producers and list\nconsumers; exact durable transfer before creator\ncleanup"
 n1: "strong-decision-cut\nFreeze strong reachability for every relevant\ndecision; prevent earlier weak marking from changing\nlater eligibility; cross-domain source refinement\nremains open"
 n2: "moving-list-rebuild\nPreserve per-origin list sequence and tag semantics;\nrewrite heads and links after forwarding; keep weak-\nderived work until completion receipt"
 n3: "dispatch-and-capture\nPop acquires rooted action frame; capture\ntestator/action before clearing; no safepoint in\nunprotected pop-to-capture quantum; Scheme context\nexecutes action"
 n4: "continuation-and-shutdown\nCleared fields forbid fresh dispatch of same payload\nbut continuations may repeat body effects; escaped\nroots remain owned; no timeout-based retirement or\ndestructor equivalence"
}
gain: "Gain / native SysML" {
 grid-columns: 2
 n0: "weak-membership\nPositive work benefit only if removed\naffinity/reconstruction exceeds metadata; all required\nweak scans remain"
 n1: "action-ownership\nMay reduce critical-path affinity; arbitrary action\ncontext, resource ordering and escaped frames can\nnegate parallel gain"
 n2: "single-authority\nModern C can express full contract; Zig supplies no\ndemonstrated unique semantic saving; no speedup\nasserted"
}
proof: "WM-H/I/S/E -> local ASCENT -> QNT / Lean; source and native gates OPEN"
