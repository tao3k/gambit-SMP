# SysML-derived conditional design; no native admission.
direction: down
Acquiring -> Borrowed: "ISSUE / issue"
Borrowed -> Draining: "REVOKE / revoke"
Draining -> Draining: "RETURN-PIN / returnPin"
Draining -> Suspended: "CLEANUP-ACK / cleanupAck"
Suspended -> Acquiring: "RESUME / resume"
Acquiring -> Acquiring: "ROOT-GRANT / rootGrant"
Acquiring -> Draining: "UNKNOWN-WRITER / unknownWriter"
Borrowed -> Draining: "UNKNOWN-WRITER / unknownWriter"
Suspended -> Draining: "UNKNOWN-WRITER / unknownWriter"
Acquiring -> Acquiring: "PAYLOAD-WRITE / payloadWrite"
Draining -> Draining: "PAYLOAD-WRITE / payloadWrite"
Suspended -> Suspended: "PAYLOAD-WRITE / payloadWrite"
Acquiring -> Draining: "FAIL-ACQUIRE / failAcquire"
runtime: "ROOT-HANDOFF / CONTROL-ORIGIN / RETIRE-WINDOW\nConcrete refinement remains OPEN"
runtime -> Acquiring: "qualified coverage / fresh entry"
Draining -> runtime: "owned cleanup, no early release"
