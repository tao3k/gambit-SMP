direction: down
caller: "Caller / native SysML" {
 grid-columns: 2
 n0: "still-allocator\nPSTATE still chain owns physical blocks; charged and\ndeferred words are distinct; pending allocation\nreservation must settle before seal"
 n1: "c-closure\nNative RC code holds Scheme proc; relocation root and\nexecutable allocation lifetime are separate; no\nassumption that proc is still"
 n2: "tcl-client\nTcl holds RC client data plus still vector; callback\nresult string has separate Tcl release_string\nlifetime; failed creation needs qualified ownership\nevidence"
 n3: "foreign-release\nForeign wrapper release clears callback/pointer before\ninvocation; collector frees wrapper without\npropagating returned error; new asynchronous duty\nrequires explicit settlement"
 n4: "exit-and-census\nOld cleanup frees still chain then native RC headers;\nlive census enumerates current processors only; VM\narena must join scan and capacity census"
}
protocol: "Protocol / native SysML" {
 grid-columns: 2
 n0: "close-and-seal\nClose native writers and allocation; drain raw borrows\nand accepted operations; exact whole arena membership,\ngeneration and GC epoch; roots and release lane\nadmitted"
 n1: "atomic-authority\nPublish destination storage/RC membership, accounting\ndelta, release duty and exact receipt together; source\ncleanup loses authority at same commit"
 n2: "unknown-outcome\nPrecommit source retains custody; postcommit VM\nauthority retains it; unknown ack blocks reclaim, not\nnecessarily exit; repeated reclaim preserves monotonic\nretired identities"
 n3: "gc-and-exit\nSerialize handoff with epoch freeze; invalidate stale\nseal after GC; destination scanner/census remains\nafter processor leaves; join is not transfer"
 n4: "release-and-retire\nLease/root survival differs from raw pin; destructor\nowner outlives creator; drain callbacks before final\nrelease; error or unknown retains separate task\ncustody without blind pointer retry"
}
gain: "Gain / native SysML" {
 grid-columns: 2
 n0: "arena-handoff\nPositive only when avoided copy/rebinding work exceeds\ninventory, synchronization and retained-memory cost;\nno claim of zero-copy across VM"
 n1: "capacity-and-scan\nCorrectness gain is structural; scanning remains\nmandatory; consolidation need not improve asymptotic\nGC time"
 n2: "compiler-service\nParallel span improves only when affinity was critical\npath and independent sessions exist; unbounded leases\ncan erase memory benefit"
}
