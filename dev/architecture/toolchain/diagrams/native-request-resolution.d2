direction: down
classes: {
  retained: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  contract: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
config: "Gambit configuration producer\nFeature/header/runtime meaning remains here\nConfigured modes, defaults and their provenance" {class: retained}
intent: "Gerbil / Gambit native intent\nGeneration and semantic module-link remain upstream\nOrdered products + roles + native requirements\nPhase/debug/static policy and producer symbol names" {class: retained}
resolve: "One native resolver, proposed in Zig\nSelect compatible host tools / target / SDK\nResolve package precedence and conditional metadata\nApply exact mode order and explicit override suppressions" {class: proposed}
config -> resolve
intent -> resolve
plan: "Effective plan\nExact executable + argv + environment + cwd\nBound inputs, dependencies, outputs and service policy\nNo opaque shell-template command" {class: contract}
resolve -> plan
retire: "RETIRE FROM MANAGED EXECUTION\nGAMBUILD / BUILD_* round trip\nShell metadata re-parsing and command eval\nNested gsc -obj / repeated native option reconstruction" {class: contract}
resolve -> retire: "replaces responsibilities\nnot an execution step" {style.stroke-dash: 3}
native: "Direct admitted native tools\nConfigured GCC or other compiler / linker\nArchive only if explicitly supported" {class: proposed}
service: "Compiler-service operation\nProject export / capability / policy contract\nMLIR implementation and versions remain private" {class: proposed}
plan -> native
plan -> service
result: "Real terminal result + checked native products\nComplete dependency and provenance envelope\nNo publication on failure / unresolved cancellation" {class: contract}
native -> result
service -> result
runtime: "Retained Gambit runtime authority\nPreflight, loading/setup/init and GC/control\nArtifact compatibility is not runtime acceptance" {class: retained}
result -> runtime
note: "DESIGN ONLY. No legacy route has been removed.\nLegacy profiles can remain separate; supported managed requests must not delegate back into them.\nConfiguration knowledge is retained while its old request/template encoding is replaced." {shape: text; style.font-size: 15}
runtime -> note: {style.opacity: 0}
