# SysML-owned producer/consumer architecture; all native refinement remains OPEN.
direction: down
Semantic: "Scheme semantic completion\nModuleSpec + FrameSpec"
Layout: "Target layout interpreter\nABI facts + encoder/decoder"
Semantic -> Layout
Emission: "Modern generated C\nimmutable tables + code + checks"
Layout -> Emission
AbiWitness: "Production C ABI witness\nClang observation is conditional"
Emission -> AbiWitness
Instance: "LoadedImage + BindingInstance\nroots / labels / setup custody"
Emission -> Instance
AbiWitness -> Instance
Bound: "Native binding ready\nScheme init stages remain separate"
Instance -> Bound
Collector: "GC / frame access\nfinal roots + current metadata"
Bound -> Collector
Control: "Capture / restore / tail calls\nstack-heap relation + denv"
Bound -> Control
Retirement: "Close ingress and drain\ncontinuations / FFI / scanners"
Collector -> Retirement
Control -> Retirement
Ascent: "ASCENT code-contract-proof joins\nSource-bound hypotheses, no admission"
SysML: "SysML owns fields / source uses / cuts / duties"
SysML -> Ascent
Semantic -> Ascent: "producer identity"
Instance -> Ascent: "actual consumers"
Proofs: "QNT interleavings + Lean refinement duties\nPlanned, no new formal execution"
Ascent -> Proofs
Proofs -> Retirement: "requires discharged obligations"
