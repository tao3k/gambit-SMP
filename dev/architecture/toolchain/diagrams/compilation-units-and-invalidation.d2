direction: down
classes: {
  existing: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  contract: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
owners: "Bazel: outer actions / cache / sandbox\nGerbil: package and phase membership / scheduling\nGambit: semantics / composition / runtime\nZig: finite native construction and service execution" {class: existing}
group: "Requested snapshot group\nShare immutable context validation across independent units\nNot automatically one indivisible semantic module" {class: contract}
owners -> group
units: {
  label: "Producer-defined independent semantic units"
  style.font-size: 20
  a: "Unit A\nSource + macro/include/phase closure\nEffective declarations + naming + FFI" {class: proposed}
  b: "Unit B\nSeparate closed context\nExplicit imported assumptions" {class: proposed}
}
group -> units.a
group -> units.b
ac: "A: L1C generated C\nor L1H semantic export" {class: proposed}
bc: "B: L1C generated C\nor L1H semantic export" {class: proposed}
units.a -> ac
units.b -> bc
an: "A: L2 native product\nObject + runtime metadata" {class: proposed}
bn: "B: L2 native product\nObject + runtime metadata" {class: proposed}
ac -> an
bc -> bn
profile: "L0 toolchain / target / runtime profile\nProtocol change invalidates dependent native products\nMay also invalidate target-dependent generation" {class: contract}
profile -> an: "construction and compatibility"
profile -> bn
compose: "L3S: Gambit semantic composition\nORDERED members / flags / aliases / initializers\nL3N: native link; remaining link C can persist" {class: contract}
an -> compose
bn -> compose
bundle: "L4: immutable published closure\nContent identity + compatibility + scoped evidence\nGambit preflight / load / fixup / init" {class: contract}
compose -> bundle
change: "CHANGE RULE\nEdit A: re-establish A and affected aggregate products\nRebuild B only if its consumed A assumptions changed\nDefault dependency is full product; narrower cutoff needs a contract" {class: contract}
bundle -> change
graph_limit: "GRAPH CONSTRAINT\nBazel actions and boundaries must be declared before execution\nCurrent project tree action remains coarse until authoritative declarations exist\nSnapshot group, semantic unit and action are different granularities" {class: contract}
change -> graph_limit
note: "DESIGN ONLY: no per-unit Bazel actions, cache implementation or performance run added.\nRequest identity, content identity, compatibility and admission evidence stay distinct." {shape: text; style.font-size: 15}
graph_limit -> note: {style.opacity: 0}
