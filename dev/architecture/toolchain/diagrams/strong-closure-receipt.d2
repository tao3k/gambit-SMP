direction: down
caller: "Caller / native SysML" {
 grid-columns: 2
 n0: "root-producers\nInitial active credits cover each root walker before\nits first idle; p0-only VM/symbol/RC paths and all-\nprocessor frame/register/global paths have different\ncoverage"
 n1: "private-copy\nForwarding can precede full payload copy; winner\nretains active credit through private alloc cursor,\ninline tail and captured-frame copying"
 n2: "chunk-publication\nPrivate incomplete chunk need not enter FIFO; complete\nchunk publishes marker/link before visible tail;\nproducer stays active through synchronous call"
 n3: "dequeue-and-scan\nDequeued chunk and still node remain scanner-frame\ncustody until body/children/cursor advance complete;\nnew private work requires local rescan"
 n4: "zero-and-return\nCount zero observed under termination mutex closes\ncovered work; waiters check zero before reacquiring\ncredit; payload closure differs from all callback\nreturns"
}
protocol: "Protocol / native SysML" {
 grid-columns: 2
 n0: "counted-root-closure\nFreeze root/participant membership; close each root\nproducer only after all admitted root slots seed\naccounted work; complete census remains separate from\nqueue closure"
 n1: "active-custody\nA counted synchronous owner covers forwarding-visible\ncopies, private initialized chunks and pending cursor\nwrites; cannot go idle or exit with any such debt"
 n2: "publication-handoff\nBody/marker/link precede tail publication; source\ncovers until queue acceptance or local scan, active\nthief owns after dequeue; parent completion never\ndrops derived work"
 n3: "strong-receipt\nZero count plus complete ownership/root coverage and\nsame-epoch synchronization permits strong-closure\nreceipt; no new root/publication after terminal zero"
 n4: "barrier-reuse\nReturned worker may classify from certified closure\nbefore peers return; existing barrier waits for every\nclassification; receipt does not authorize\nPSTATE/queue retirement"
}
prior: "Prior / native SysML" {
 grid-columns: 2
 n0: "scan-count\nExisting counted-producer model distinguishes a\ndetached-publisher fault control; new idle obligations\nrefine private copy/cursor/frame coverage"
 n1: "work-closure\nExisting canonical work/copy/publication composition\nis linked to active-owner coverage; one symbolic\nobject does not prove actual chunk layout"
 n2: "callback-boundary\nExisting model assumes callback return and separately\naggregates users; payload closure must not be\nsubstituted for its return premise"
}
gain: "Gain / native SysML" {
 grid-columns: 2
 n0: "reuse-rendezvous\nZero extra barrier only after strong-return closure is\nqualified; local emptiness is insufficient"
 n1: "reuse-worker-credit\nNo extra runtime counter is implied by proof state;\ndetached producers require credit handoff or separate\ntracking"
 n2: "preserve-boundaries\nCorrectness foundation rather than proven GC speedup;\nroot omissions and native memory-order gaps still\nprevent full qualification"
}
proof: "SR-H/I/S/E -> local ASCENT -> QNT / Lean; source and native gates OPEN"
caller -> protocol
protocol -> proof
prior -> proof
proof -> gain
