direction: down
"derived-credit": "derived-credit\nReserve consumer custody before exchanging pending\ninto active batch; clear is not callback completion"
"target-accept": "target-accept\nSuccessful producer admission pins the immutable\ntarget domain before descriptor access; Close denies\nonly new entrants"
"pending-publish": "pending-publish\nAccepted producer may publish after Close; stable\ndomain owns pending until claim or exclusive\ncoordinator drain"
"storage-commit": "storage-commit\nRetire after producer gate closed and drained,\nconsumer gate sealed and drained, pending empty,\nwriter and root custody settled"
"claim-seal": "claim-seal\nSeal normal claim admission only after producers\ndrain; existing reservations finish; coordinator\nowns residual pending"
"activation-root": "activation-root\nVector load to registered activation root is a no-\nsafepoint interval; collection scans and rewrites\nthat slot"
"vector-writer": "vector-writer\nRoot setter argument before queueing; close external\nadmission; derived request holds parent claim until\nrendezvous commit; preserve selected roots"
"gc-move": "gc-move\nAll participating contexts parked with no unrooted\nload; rewrite global vector, selected activations\nand queued setter argument"
"target-accept" -> "pending-publish"
"pending-publish" -> "derived-credit"
"pending-publish" -> "claim-seal"
"claim-seal" -> "storage-commit"
"derived-credit" -> "storage-commit"
"derived-credit" -> "activation-root"
"activation-root" -> "vector-writer"
"activation-root" -> "gc-move"
"vector-writer" -> "gc-move"
"gc-move" -> "storage-commit"
proof: "SysML -> ASCENT -> QNT / Lean; source + platform OPEN"
"storage-commit" -> proof
gain0: "native-operations\nFour RMW plus one load is a proposed uncontended\nprotocol count, not a native instruction or latency\nbound"
proof -> gain0
gain1: "claim-operations\nThree RMW plus one load; empty claims still pay;\nunknown outcomes retain rather than replay"
proof -> gain1
gain2: "vector-gc\nk excludes existing scanned registers and frames;\nrendezvous cost grows with roster; setter frequency and\nGC cost must be included"
proof -> gain2
gain3: "net-benefit\nNo speed gain established; benefit requires avoided\nreal lifetime failures or eliminated work to exceed\nadditional atomics, rendezvous and scans; Zig does not\nremove these obligations"
proof -> gain3
