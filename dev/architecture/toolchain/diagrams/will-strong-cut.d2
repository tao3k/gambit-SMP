direction: down
caller: "Caller / native SysML" {
 grid-columns: 2
 n0: "shared-registration\nDistinct wills can register in current PSTATE lists\nwith same VM testator; shared container cleared after\npublication; exact native root liveness remains a\npremise"
 n1: "strong-closure\nSync dispatch runs collector per PSTATE; rooted wills\nmark noncapturing actions while testator stays weak;\nstrong barrier precedes concurrent local weak\nfunctions"
 n2: "late-classifier\nUNMARKED reads current header/mark; local classifier\nfinishes before its own weak preservation, not before\nevery other processor preservation"
 n3: "early-publisher\nOne processor may weak-mark shared testator before\nother classifies; completed-copy replay avoids relying\non unfinished payload publication"
 n4: "semantics-and-platform\nManual grounds strong reachability and resurrection;\nsource witness is conditional intended-memory control\nflow, not configured native reproduction or C memory-\nmodel proof"
}
protocol: "Protocol / native SysML" {
 grid-columns: 2
 n0: "input-witness\nSame VM, two distinct lists/wills and one allocated\ntestator; root wills but not testator/action captures;\nhelper source and temporary root retirement must\nqualify"
 n1: "source-interference\nP0 classify -> publish and finish testator marking ->\nP1 classify sees marked; valid source-model steps can\nomit P1 from this epoch selection"
 n2: "decision-cut\nFreeze all domains; classify after certified global\nstrong closure and before weak mutation; reuse\nexisting strong/weak barrier only if its prerequisites\nrefine"
 n3: "weak-publication\nWeak publish allowed only after global decision\nreceipt; preserve all testator/copy/scan work and\nexisting list ordering; atomic reads alone do not\nrepair semantics"
 n4: "semantic-repair\nMake selection independent of weak preservation order\nfor fixed strong snapshot; changes observable\ncallback/resurrection timing; not a transparent list\nrelocation optimization"
}
gain: "Gain / native SysML" {
 grid-columns: 2
 n0: "semantic-determinism\nCorrectness/semantic repair is primary; no automatic\npositive CPU-work saving against a correct baseline"
 n1: "phase-separation\nClassification remains O(W); zero or one additional\nbarrier depending on certified reuse; skew and receipt\nbookkeeping still count"
 n2: "bounded-retention\nNo fixed bytes/latency benefit; compare equivalent\nepoch semantics, not faster execution of an incorrect\noutcome"
}
proof: "WS-H/I/S/E -> local ASCENT -> QNT / Lean; source and native gates OPEN"
caller -> protocol
protocol -> proof
proof -> gain
