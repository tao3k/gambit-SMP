direction: down
classes: {
  retained: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  proposed: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
gaps: "ES lifecycle gaps\nFailed API/syscall returns\nQuery stdout and controlling-tty bytes\nScheme status/exception/barrier delivery" {class: gate}
paths: "Independent supplement paths" {
  sinks: "Existing original sinks\nImmutable source/run/sink-bound logs\nOnly the saved visible layer is proved\nNo new tee, redirection or PTY" {class: retained}
  external: "Conditional external observer\nSyscall returns / exact I/O + fd lifecycle\nPrivilege, SIP, framing and loss qualification\nNot provided by ES or dtruss text alone" {class: proposed}
  derived: "Controlled source-copy evidence\nSpawn preparation and errno-pipe handoff\nShell values and Scheme return/raise commits\nL1 only: changed source/tool context" {class: proposed}
}
gaps -> paths.sinks
gaps -> paths.external
gaps -> paths.derived
correlate: "Join with ES process-identity spine\nBoot scope + audit pid/pidversion + lineage\nThread/attempt ordinals and fd open generations\nEvery stream has separate completeness obligations" {class: gate}
paths.sinks -> correlate
paths.external -> correlate
paths.derived -> correlate
classify: "Classify each claim\nOriginal visible outcome / qualified external fact\nDerived internal evidence / unresolved join\nNo timestamp-only or PID-only proof" {class: gate}
correlate -> classify
retain: "R1-R7 stay unresolved where evidence is missing\nU6/U7/U8 refined, not closed\nNo E29 or M2-M8 retirement from source reads\nL3 native acceptance remains separate" {class: retained}
classify -> retain
note: "DESIGN ONLY. No stream, hook, audit policy or tracing setup was created.\nDo not read the private errno pipe or add a competing child reaper." {shape: text; style.font-size: 15}
retain -> note: {style.opacity: 0}
