direction: down
census: "Census / native SysML" {
 grid-columns: 2
 n0: "requester-entry\nProcessor-1 allocating request raises VM sync\ninterrupt and executes selected operation loop; locks\nneeded by that loop are released before join"
 n1: "peer-service\nOther processors enter service_sync_op; nonzero\nprocessor keeps servicing even after Scheme run\nreturns"
 n2: "old-roster\nTree captures current processor_count; resize nested\nGC happens before target membership commit; root-ready\ndoes not authorize excluding processor one"
 n3: "flag-reset\nFirst selected round resets sync-op flag\nsynchronously; later NOOP is needed before loop exit"
 n4: "rc-payload\nVM root adapter must scan processor-1\nRC/provisional/error slots while owner executes\nselected GC; legacy processor-zero RC scan still needs\nreplacement"
 n5: "loop-result\nWinning or combined request receives result and clears\nlocal request; callback return alone does not permit\nowner resume"
 n6: "owner-restore\nAfter loop exit validate VM/PSTATE generation and\nreload moved roots; processor-zero deferred error may\nunwind instead of normal return"
 n7: "guard-error\nStable guard preserves original error and catcher\ndestination through marker cleanup; exception data is\nhanded to rooted VM outcome storage"
 n8: "procedural-cleanup\ncleanup_interrupts_pstate releases procedural\ninterrupt queue; it does not itself demonstrate that\nall sync/GC facilities were disabled"
 n9: "foreign-and-rc\nfree_still_objs may call release_foreign before bulk\nRC cleanup; arbitrary foreign effects must close or\ntransfer while old owner still serviceable"
 n10: "topology-tail\nMessage publication unlocks before signal tail; common\nroster result and old sender lifetime are separate\nfrom worker receipt or join"
 n11: "global-cleanup\nLive shrink, unactivated rollback, global shutdown and\ncleanup_mem_vmstate wrapper need distinct permissions;\nVM wrapper destroys scan facilities before processor-\nzero memory cleanup, requiring whole-VM preflight"
}
protocol: "Protocol / native SysML" {
 grid-columns: 2
 n0: "ready-but-participating\nReady frame and stopped mutator remain attached to old\nVM roster and service sync-op; Scheme return does not\nremove the processor"
 n1: "loop-return\nFirst reset, selected operation disposition and\npending request result settle before final NOOP;\nresize-internal GC does not consume pending GC, and\nreload follows the latest epoch"
 n2: "guard-outcome\nGuard catches admitted unwind, preserves primary\npayload/destination, invalidates owned marker and\nhands rooted outcome to VM custodian; cleanup error\ncannot overwrite primary unwind"
 n3: "exit-preflight\nBefore roster commit or teardown admission closes,\ndrain guard/readers/pins/foreign producers under old\nserviceable roster; only acknowledged storage move\npermits retirement"
 n4: "topology-and-reuse\nAll participants use one effective topology result;\npublication acceptance is separate from sender\ntails/retained convergence; unknown OS join never\npermits PSTATE generation reuse"
}
settle: "Settle / native SysML" {
 grid-columns: 2
 n0: "ready-to-dispatch\nStopped mutator retains dispatcher service and old\nroster identity; OS sleep without service is rejected"
 n1: "gc-to-noop\nReturn of garbage_collect_pstate precedes request\nresult/NOOP loop completion; owner root reload follows\nloop return"
 n2: "catcher-and-marker\nRestore old catcher and invalidate only initialized\nmarker; completion guard records primary outcome\nbefore propagation"
 n3: "outcome-and-root\nVM custodian accepts rooted error/result and remaining\nresources before guard frame withdrawal; pin/readers\nmay delay storage free after rethrow"
 n4: "storage-and-foreign\nAcknowledge native storage ownership and foreign\nproducer closure before topological removal; lost\nreply does not grant cleanup permission"
 n5: "tree-and-admission\nAll participants observe effective roster; sender\ntails and retained convergence precede teardown; no\nlocal target-count veto after commit"
 n6: "exit-and-generation\nOwner may free only inert remainder; observed known\njoin permits OS/PSTATE generation reuse,\nignored/unknown join does not"
}
gain: "Gain / native SysML" {
 grid-columns: 2
 n0: "service-reuse\nReuse current service_sync_op/selected operation and\nexisting NOOP exit only after source refinement; no\nassumption that root-ready means arbitrary native\nblocking is legal"
 n1: "guard-reuse\nReuse runtime catcher mechanism with explicit guards;\nall supported nonlocal exits must reach the contract"
 n2: "retirement\nAdded O(P) acknowledgement/domain bookkeeping may\nreuse existing rounds only if qualified; no measured\nspeedup or zero-cost topology change is claimed"
}
proof: "SGC-H/I/S/E -> local ASCENT -> QNT / Lean; source and native gates OPEN"
census -> protocol
protocol -> proof
settle -> proof
proof -> gain
