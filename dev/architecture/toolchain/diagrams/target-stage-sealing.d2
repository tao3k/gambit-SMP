direction: down
writers: "Target writer owners / census scope and gaps recorded" {
 grid-columns: 2
 w0: "target-registry\nImmutable descriptor template + per-context\nselected-target instance"
 w1: "primitive-overlays\nPer-semantic-profile frozen base only after\nclosure proof; mutable overlays per context"
 w2: "c-interface\nExclusive consumed input OR immutable snapshot +\nprivate emission copy"
 w3: "module-heap\nEmissionWorkspace for one module attempt"
 w4: "procedure-emission\nProcedureWorkspace nested in one\nEmissionWorkspace"
 w5: "representation\nProfile configuration separated from per-\nprocedure analysis graph"
 w6: "source-output\nAttempt-owned diagnostic/source sink plus\ncaller-owned port lease"
 w7: "link-selection\nNative/link context with same semantic cohort\nrules"
}
fidelity: "GeneratedSchemeResult observations" {
 grid-columns: 2
 f0: "declarations\nOrdered declarations, annotation scope, section\nkind and phi-specific inlining policy"
 f1: "lexical-identity\nBinding equality/distinction, namespace/phi,\nsubstitutions, quote-syntax lifts and\ninitializer references"
 f2: "source-origin\nBaseline generated-file locations and\nreader/wrap/expand observations; original-source\nmap separately labeled"
 f3: "exceptions\nPhase-tagged diagnostics, nonzero subprocess\nstatus contract, output delivery and cleanup\ncustody"
}
seal: "Two distinct delivery modes / no shared destructive input" {
 grid-columns: 2
 s0: "normalized\nNo external mutable aliases, OR exclusive rooted\nregion transfer; include origins and target\nsemantic profile"
 s1: "gvm\nFrozen snapshot with alias-preserving\nrelocation; mutable target metadata and\nworkspaces excluded"
 s2: "exclusive-consume\nAtomic admission closure and one consumer\ntransfer; no retained cached alias"
 s3: "result-manifest\nComplete output group, current epoch/profile,\nknown success and closed writer admission"
}
proof: "SysML TS-H/I/S/E -> ASCENT -> QNT / Lean; source refinement OPEN"
benefit: "Repeated use must repay freezing + private copies + validation + retained memory"
writers -> fidelity
fidelity -> seal
seal -> proof
proof -> benefit
