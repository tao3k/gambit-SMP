direction: down
commit: "Commit / native SysML" {
 grid-columns: 2
 n0: "bundle\nReplace five mutable root authorities with one\nimmutable bundle: category roots, ordered event index,\nimmutable receipts and authority identity"
 n1: "prepare\nAllocate/root candidate before publication; partial\nregistry/index construction is private and cannot\nproduce a committed receipt"
 n2: "existing-first\nExact EventId plus canonical payload match returns\noriginal receipt before new-write predecessor/fence\nvalidation; collisions reject"
 n3: "publish\nPublish complete bundle once under fenced owner;\ncompare expected base; no callback/allocation in final\ncommit window; failed candidate never reruns expander"
 n4: "custody\nBundle/result/candidate roots survive unknown delivery\nand saved continuations; process crash durability is\nnot implied"
}
identity: "Identity / native SysML" {
 grid-columns: 2
 n0: "returned-expansion\nReturned macro form is expanded after callback\nreturns; fresh dynamic occurrence, not necessarily an\non-stack nested child"
 n1: "synchronous-child\nA resolved expander may synchronously call expansion;\nsuspend parent lane and commit child events in actual\nexecution order; real iter child effect not\nestablished"
 n2: "parent-resume\nParent-before, child and parent-after have distinct\noccurrence identities; source order does not sort by\nstatic parent position"
 n3: "semantic-reentry\nContinuation restores execution, not heap registry\nrollback; before-store semantic replay needs fresh\noccurrence; transport retry retains EventId"
 n4: "same-object-mismatch\nSame EventId with different ordered\npayload/symbol/profile is a conflict, never a\nsuccessful deduplicated delivery"
}
gain: "Gain / native SysML" {
 grid-columns: 2
 n0: "one-commit-authority\nCorrectness gain requires migrating actual readers and\nwriters; no wrapper-only claim"
 n1: "nested-session\nActual independent ready work must exceed coordination\ncost; parent/child effects remain ordered"
 n2: "cache-handoff\nSaved repeated work exceeds\nlookup/materialization/retention; arbitrary macro\nreplay remains unqualified"
