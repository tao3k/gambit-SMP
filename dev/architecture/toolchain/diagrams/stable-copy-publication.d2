direction: down
writer: "Writer / native SysML" {
 grid-columns: 2
 n0: "macro-eval\nActual macro definition evaluates code; extension\neffects require resolved binding/capability closure;\niter registry mutation is not established"
 n1: "macro-call\nActual expander callback can call retained procedures\nor mutate reachable pairs; do not hold a nonreentrant\nsealing lock across it"
 n2: "global-store\nInterpreter set! routes to global store; qualified\ncompiler binding reachability remains profile-specific"
 n3: "payload-store\nBorrowed names and exposed records can reach direct\npair/vector writes; helper interception alone cannot\nclose arbitrary aliases"
 n4: "namespace\nc# is the compiler namespace and includes\nregistry/helper/accessor names; spelling does not\nitself prove an admitted runtime binding"
}
copy: "Copy / native SysML" {
 grid-columns: 2
 n0: "source-conversion\nVisited-table private copy preserves cycles/sharing\nbut is not a stable snapshot or a generic declaration\nfreezer"
 n1: "exclusive-copy\nClose every writer before read; pin source and\nprivately rooted destination; copy under exclusion\nwith no arbitrary callback"
 n2: "immutable-generation\nCapture complete immutable registry/view generation\nand roots; concurrent writers create new generations\nwithout changing captured data"
 n3: "release-cut\nAfter complete identity-preserving private copy,\nsource custody can retire before publication; result\nkey stays the captured generation"
 n4: "raw-optimism\nA version comparison does not legalize plain C data\nraces, uncounted alias writes, ABA or incomplete\nwriter updates"
}
gain: "Gain / native SysML" {
 grid-columns: 2
 n0: "stable-service-input\nReuse only if saved work exceeds\nsealing/key/materialization and invalidation cost"
 n1: "early-source-release\nCopy cost and destination retention must be smaller\nthan removed contention/retention"
 n2: "immutable-sharing\nBenefit depends on actual demand and bounded retained\ngenerations; unsafe raw aliases deny sharing"
}
proof: "SC-H/I/S/E -> local ASCENT -> QNT / Lean; source and native gates OPEN"
writer -> copy
copy -> proof
