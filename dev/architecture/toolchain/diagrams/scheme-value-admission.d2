# Derived V-duty view; ROOT-HANDOFF is an existing external runtime contract.
direction: down
V_SNAPSHOT: "V-SNAPSHOT\nRoot liveness and interval\nstability are independent"
D_PRODUCER: "D-PRODUCER\nActual metadata macro: key\nchecked, values unrestricted"
D_PRODUCER -> V_SNAPSHOT
V_SYMBOL: "V-SYMBOL\nNames, interned identity and legal\nimmutability contracts"
V_SNAPSHOT -> V_SYMBOL
V_ROOTS: "V-ROOTS\nRC registration is not complete\nscanner participation"
V_SNAPSHOT -> V_ROOTS
runtime_ROOT_HANDOFF: "ROOT-HANDOFF\nExisting execution / GC / FFI contract\nNative closure remains OPEN"
runtime_ROOT_HANDOFF -> V_ROOTS
V_RELOC: "V-RELOC\nLogical values survive relocation;\ncopied addresses do not"
V_ROOTS -> V_RELOC
runtime_ROOT_HANDOFF -> V_RELOC
V_WRITER: "V-WRITER\nMark/write passes require one\ngoverned value view"
V_SYMBOL -> V_WRITER
V_RELOC -> V_WRITER
V_READ: "V-READ\nRead-back equality is consumer-\nspecific, not heap identity"
V_WRITER -> V_READ
V_ADMIT: "V-ADMIT\nFinite logical heap-to-tree\nadmission specification"
V_SYMBOL -> V_ADMIT
V_RELOC -> V_ADMIT
runtime_ROOT_HANDOFF -> V_ADMIT
V_CONSUMER: "V-CONSUMER\nLinker factorization must preserve\nsymbol and alias observations"
V_READ -> V_CONSUMER
V_ADMIT -> V_CONSUMER
V_COST: "V-COST\nChoose managed observation or\nrooted borrow by real need"
V_CONSUMER -> V_COST
D_SCALAR: "D-SCALAR\nFrame shape is weaker than full\nsemantic admission"
V_ADMIT -> D_SCALAR
D_BRIDGE: "D-BRIDGE\nSelected linker observes five\nmetadata keys plus other fields"
V_CONSUMER -> D_BRIDGE
