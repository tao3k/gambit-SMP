direction: down
classes: {
  source: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  candidate: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
platform: "Exact Darwin/provider qualification\nHost kernel/ABI, target visibility and permissions\nNative libdtrace consumer architecture/version\nHeader/stub and published source are not runtime proof" {class: gate}
consumer: "Observer-owned native raw consumer\nProbe/record callbacks + error/drop handlers\nBounded frames, per-CPU epochs and persistence\nNo target wrapper, extra fd or process-control API" {class: candidate}
platform -> consumer
caps: "Independent capability gates" {
  returns: "A: failed-return evidence\nSyscall/proc boundary, result convention\nThread/attempt pairing; exec-success special case\nEarlier libc setup errors remain separate" {class: candidate}
  bytes: "B: binary payload evidence\nExact lengths/chunks, bounds and copy outcomes\nSnapshot differs from kernel-consumed bytes\nConcurrent mutation prevents blanket fidelity" {class: candidate}
  fds: "C: descriptor graph\nSlots / descriptions / endpoints\nInheritance, close-on-exec and fd reuse\nSpawn kernel actions need their own witness" {class: candidate}
}
consumer -> caps.returns
consumer -> caps.bytes
consumer -> caps.fds
es: "Separate ES notification stream\nAudit process generations and lifecycle\nVersions, subscription/mutes and sequence coverage\nFD list may be partial" {class: source}
join: "D: independent cross-stream association\nBirth/image crosswalk; no PID/time-only match\nPer-stream loss and scope/drain qualification\nRetain partial local facts without invented joins" {class: gate}
caps.returns -> join
caps.bytes -> join
caps.fds -> join
es -> join
verdict: "Capability-scoped evidence or unresolved\nK01-K15 calibration unexecuted\nV1-V9 remain open; no Scheme commit from syscall alone\nNo E-row/native retirement or performance claim" {class: gate}
join -> verdict
note: "DESIGN ONLY. No probe enumeration, consumer build, trace or fixture run.\nThe observer is a version-bound evidence adapter, outside normal product builds." {shape: text; style.font-size: 15}
verdict -> note: {style.opacity: 0}
