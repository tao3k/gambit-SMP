direction: down
view: "View / native SysML" {
 grid-columns: 2
 n0: "construct\nPersistent spine is reusable only if declaration\nrecords and named payload lists are writer-closed"
 n1: "batch-order\nLater textual declarations are earlier lookup\ncandidates; do not preserve textual list without\nreversal"
 n2: "scope-restore\nRestore declaration projection only; preserve\nbindings/macros/other returned environment fields"
 n3: "shared-mutable\nDo not use persistent declaration head as proof that\nwhole env is immutable or session-independent"
 n4: "payload-alias\nInclude parser/optimizer/primitive derived\ndeclarations and their admitted writers; classify\npayload aliases, raw stores and FFI; syntactic nonuse\nis not closure"
 n5: "read-view\nRoot one related immutable/leased view across complete\nspecialization chain; keep primitive-name identity"
}
caller: "Caller / native SysML" {
 grid-columns: 2
 n0: "app-helper\nCarry resolution and selection views separately;\nreplacing both with current global env is unsound"
 n1: "parser-validation\nDiagnostics and rejected calls belong to observer;\nlate GVM-only migration misses this user"
 n2: "epc\nDo not normalize different caller environment choices\ninto one unlabeled view"
 n3: "branch-rewrite\nPreserve constant/void abstraction and context-local\ncanonical helper identities"
 n4: "gvm-and-analysis\nMigrate result consumers, inline predicates and **\nhelper slots in the same context domain"
 n5: "fixed-point\nTransport every step and termination identity; no\narbitrary one-step replacement, timeout success or\ninvented per-step arity check"
}
gain: "Gain / native SysML" {
 grid-columns: 2
 n0: "persistent-view\nExisting persistent updates are baseline; only\ngenuinely repeated work counts"
 n1: "query-reuse\nExpected saved work exceeds\nkey/validation/materialization; raw addresses are not\npersistent cache keys"
 n2: "parallel-context\nRemoved span exceeds new overhead; no unsafe sharing\nof mutable env or implicit gain from core count"
}
proof: "DC-H/I/S/E -> local ASCENT -> QNT / Lean; source and native gates OPEN"
