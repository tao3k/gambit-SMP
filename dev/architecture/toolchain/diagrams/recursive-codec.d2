# Derived focused proof-prerequisite graph; no runtime parser qualification.
direction: down
D_PRODUCER: "D-PRODUCER\nActual metadata macro: key\nchecked, values unrestricted"
D_MUTABLE: "D-MUTABLE\nMetadata store retains values and\nmutates lists"
D_PRODUCER -> D_MUTABLE
D_POLICIES: "D-POLICIES\nLast-value / ordered equal?-set /\nappend are distinct"
D_MUTABLE -> D_POLICIES
D_WRITER: "D-WRITER\nWriter output and read-back are\nseparate from stored values"
D_POLICIES -> D_WRITER
D_CODEC: "D-CODEC\nRecursive wire inverse / injection\nproved in the model"
D_WRITER -> D_CODEC
D_SCALAR: "D-SCALAR\nFrame shape is weaker than full\nsemantic admission"
D_CODEC -> D_SCALAR
D_BRIDGE: "D-BRIDGE\nSelected linker observes five\nmetadata keys plus other fields"
D_SCALAR -> D_BRIDGE
D_COST: "D-COST\nFormat cost explicit; list proof\nalgorithm is not a fast codec"
D_BRIDGE -> D_COST
L_FIELDS: "L-FIELDS\nFull typed record / framed domain\ncodec"
D_PRODUCER -> L_FIELDS
D_CODEC -> L_FIELDS
D_SCALAR -> L_FIELDS
L_REFLECT: "L-REFLECT\nEncoding facts + conditional\nsafety reflection"
D_BRIDGE -> L_REFLECT
