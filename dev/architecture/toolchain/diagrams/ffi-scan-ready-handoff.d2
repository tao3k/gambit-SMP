direction: down
census: "Census / native SysML" {
 grid-columns: 2
 n0: "incoming-root\nOrigin must remain in a valid\ngenerated/saved/registered/nonmoving root until frame\npublication; arbitrary raw movable C input is rejected"
 n1: "descriptor\nNative allocation may fail before taking over custody;\ninitialize descriptor and cells before publication; no\nGC allocation in preparing region"
 n2: "intent\nAccepted operation gets stable\nVM/owner/domain/activation identity before admission\ncutoff; an old accepted preparation may finish\npublishing after cutoff"
 n3: "rc-payload\nProvisional candidate and existing committed RC\npayload are separate scan slots; registration on\nprocessor 1 cannot rely on processor-zero-only mark_rc"
 n4: "publication\nFully initialized mutable root cells become collector-\nvisible before dropping origin custody; descriptor\npublication is not application commit"
 n5: "lease-conversion\nMutable preparation no longer blocks GC once scannable\nframe and stop record are accepted; storage pin\nremains owned without excluding scanner writeback"
 n6: "participant\nPark means no root mutation, not an OS wait that\nprevents the processor from running the selected GC\nsync operation"
 n7: "scan-root\nCollector uses admitted VM adapters including nonzero\nowner and rewrites all moved slot values; marker\nstill-body scan composes with base root model"
 n8: "reload\nResume acquire-observes GC completion and reloads\ncell; rejects stale epoch/generation or stale C local\nbefore initializing marker"
 n9: "marker\nMarker allocation follows handoff; initial #f body\nthen current rooted proc; transfer accepted only with\ninitialized externally held still marker"
 n10: "outcome\nCommitted receipt and known terminal guard are\ndistinct from response delivery; unknown running\noperation must still park before a later GC"
 n11: "continuation\nRoot reachability does not revive a killed C\nactivation; restored continuation cannot reuse retired\nframe capability; new execution receives new operation\nidentity"
}
protocol: "Protocol / native SysML" {
 grid-columns: 2
 n0: "reserve-before-borrow\nReserve stable native root-frame storage before\ndropping any existing root; failure leaves origin\ncustody; reject incoming movable C value without an\nadmissible source root"
 n1: "publish-before-join\nAccepted intent initializes root cells without\nallocation and release-publishes them through VM\nenrollment gate; root-frame publication is not commit\nof the target RC payload"
 n2: "reclassify-lease\nBefore requesting allocating GC, convert mutable-\npreparation lease to scan-ready custody and stop the\nattached context; collector waits for preparation\nclosure and parked participants, not operation return"
 n3: "scan-and-reload\nCollector scans all admitted VM domains including\nprocessor 1 and writes moved values back; owner\nreloads through current-epoch cell before marker\ninitialization or RC commit"
 n4: "guard-and-retire\nFailure and supported unwind retain frame until\nacknowledged terminal outcome, native/reader pins and\nnested children settle; unknown result is neither\nquiescence nor permission to free"
}
settle: "Settle / native SysML" {
 grid-columns: 2
 n0: "origin-transfer\nDo not withdraw origin before a collector-visible root\nframe has custody"
 n1: "preparation\nPreparation must terminate without allocating;\nacknowledged abort preserves original root, unknown\npreparation remains blocking"
 n2: "gc-join\nAll live activations parked or safely delegated before\nfreeze; collector never waits for operation completion"
 n3: "marker-exit\nGuard catches admitted runtime unwind, invalidates\nmarker, records error, retains frame until cleanup is\nknown"
 n4: "native-pin\nNative pin prevents unlink/free through ordinary\nrelease and whole-processor cleanup; it is not a GC-\nexclusion lease"
 n5: "nested-child\nParent descriptor remains while child activation is\nlive; no stack address resurrection on repeated\ncontinuation restore"
 n6: "reader-drain\nClose new readers and drain accepted metadata/storage\npins before withdrawal; raw value readers require\nattached-context safepoints"
}
gain: "Gain / native SysML" {
 grid-columns: 2
 n0: "cycle-removal\nFinite model reaches collector freeze while operation\noutcome is pending; native lock/progress refinement\nremains open"
 n1: "root-reuse\nO(k) retained slots per live activation; reuse of\nframe does not eliminate tracing or root scanning"
 n2: "modern-c\nC can implement all required mechanisms; neither Zig\ndefer nor a reference count alone handles Gambit\nnonlocal unwind or whole-PSTATE cleanup"
}
proof: "FSH-H/I/S/E -> local ASCENT -> QNT / Lean; source and native gates OPEN"
census -> protocol
protocol -> proof
settle -> proof
proof -> gain
