# Native SysML producer/caller containment and proof projection; not an execution schedule.
direction: down
domain: "ReaderSpanCustody\nModern C / Scheme semantic ownership"
contracts: "Canonical source contracts (containment view)" {
  grid-columns: 1
producers: "Eight real producer boundaries" {
  grid-columns: 2
  p0: "port-delivery\nport then in-flight character delivery"
  p1: "private-replay\noriginal char-stream and acceptance closure"
  p2: "accepted-reduction\nacceptance record before invoking R"
  p3: "ignored-lexeme\ntrivia ledger before ignored singleton disappears"
  p4: "failed-lexeme\nfailed attempt then rooted ERROR token/exception"
  p5: "header-io\nsection header invocation"
  p6: "scheme-datum\nreadenv and original input domain"
  p7: "post-action-delivery\naction/result record plus live frame aliases"
}
readers: "Five datum entries + six header I/O bypasses" {
  grid-columns: 3
  r0: "module-body\noutside body catch"
  r1: "section-id\noutside body catch"
  r2: "section-option\noutside body catch"
  r3: "parser-action\nbody catch"
  r4: "lexer-action\nbody catch"
}
resets: "Two reset paths with distinct consumers" {
  grid-columns: 2
  x0: "parser-reset\nImmediately reads next token before branch/rule construction"
  x1: "lexer-reset\nImmediately observes fresh stream location without reading"
}
}
models: "RS-H QNT / RS-I Lean\nRS-S source / RS-E native obligations"
ascent: "ASCENT\nScoped receipts + LC-S dependency"
gate: "Five source/native gates remain open"
domain -> contracts
contracts -> models
models -> ascent
ascent -> gate
