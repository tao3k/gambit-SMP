# Derived L-duty view; D-duty prerequisites and boundary edges are in recursive-codec.d2.
direction: down
L_CHAIN: "L-CHAIN\nReal _host generation / library\ncomposition"
L_READ: "L-READ\nTarget / extension resolution\nand parser"
L_WRITE -> L_READ
L_WRITE: "L-WRITE\nGambit datum writer and port\ncodec"
L_CHAIN -> L_WRITE
L_HEADER: "L-HEADER\nShallow acceptance is\ninsufficient"
L_READ -> L_HEADER
L_FIELDS: "L-FIELDS\nFull typed record / framed\ndomain codec"
L_HEADER -> L_FIELDS
L_ORDER: "L-ORDER\nOrdered siblings / base / flags\n/ metadata"
L_FIELDS -> L_ORDER
L_ARTIFACT: "L-ARTIFACT\nStored bytes: layout only;\norigin unknown"
L_CHAIN -> L_ARTIFACT
L_CLEAN: "L-CLEAN\nIndependent qualified clean-\norigin relation"
L_CHAIN -> L_CLEAN
L_FAIL: "L-FAIL\nEight outcomes; failure custody\nretained"
L_READ -> L_FAIL
L_ISSUE: "L-ISSUE\nSuccess / complete / current /\nsettled issuer"
L_ORDER -> L_ISSUE
L_CLEAN -> L_ISSUE
L_FAIL -> L_ISSUE
L_REFLECT -> L_ISSUE
L_REFLECT: "L-REFLECT\nEncoding facts + conditional\nsafety reflection"
L_ARTIFACT -> L_REFLECT
L_WORK: "L-WORK\nCut only proven consumer; charge\nother work"
L_ISSUE -> L_WORK
