direction: right
"phase-artifact-graph" -> "query-snapshot": "Bind consumed projections and effective inputs before reusable result publication; immutable semantic and layout keys stay distinct"
"query-snapshot" -> "incremental-query-service; gambit-phase-engine; native-module-data-emitter": "Semantic change invalidates both; layout-only change invalidates layout/native descendants; unknown effect refuses reuse, not valid fresh compilation"
"gambit-phase-engine" -> "private-context-lease": "One active owner per context; close writers/read capture before semantic sealing; stable rooted product precedes context release"
"private-context-lease" -> "incremental-query-service; native-module-data-emitter": "Late dependency invalidates unpublished result; reentry needs distinct execution generation, not reuse of old mutable workspace"
"gambit-phase-engine" -> "sealed-semantic-product": "Candidate seam: after compile-parsed-program/module semantic descriptor, before target.dump consumes c-intf; deep private copy and closed alias/read/write scope required"
"sealed-semantic-product" -> "native-module-data-emitter; phase-artifact-graph": "Target semantics or provider/declarations change invalidates semantic result; physical ABI-only edit may retain it if no semantic target input changed"
"native-module-data-emitter" -> "module-layout-bundle": "Finalize demand/resource closure and validate all physical frame data; seal code and descriptor manifest together; raw Scheme vectors/native VM pointers cannot be shared plan state"
"module-layout-bundle" -> "native-action-runtime; phase-artifact-graph; existing GC/continuation/module runtime": "ABI/GC map/frame/return-label/code changes invalidate all consuming native results; old generations remain held by actual readers"
"existing Gambit module runtime" -> "module-instance": "Allocate fresh instance state; setup flags/native pointer never mutate shared ModulePlan; preserve initializer order/effects per semantic instance"
"module-instance" -> "existing GC/continuation/FFI/init runtime; native-action-runtime lifetime interface": "Instance state changes do not rewrite layout identity; code/ABI replacement requires distinct held plan generation"
