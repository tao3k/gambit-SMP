direction: down
classes: {
  source: {style.fill: "#E5F1FB"; style.stroke: "#28618A"}
  candidate: {style.fill: "#EEE8FC"; style.stroke: "#6A4698"}
  gate: {style.fill: "#FFF1D9"; style.stroke: "#A36918"}
}
initial: "Initial fd state and process instance\nInherited slots known only with actual evidence\nUnknown roots remain Unknown\nExec generation is not a fresh fd table" {class: gate}
ops: "Observed operations and actual outcomes\nOpen/pipe outputs; dup/fcntl; close/reuse\nFork inheritance; successful exec transitions\nOverlapping calls need real ordering evidence" {class: candidate}
initial -> ops
spawn: "Darwin spawn action boundary\nKernel open/dup/close/inherit and CLOEXEC_DEFAULT\nNo assumption of individual userspace syscalls\nOpaque action memory and ES subset cannot fill graph" {class: gate}
initial -> spawn
expected: "Source-derived expected actions\nGambit file-action recipe and platform manuals\nIndependent invariant, not original observation" {class: source}
expected -> spawn
graph: "Partial descriptor graph\nProcess instance -> fd slot generation\nSlot -> shared open description -> endpoint\nUnknown/Ambiguous states propagate to channel claims" {class: candidate}
ops -> graph
spawn -> graph: "only qualified actual transforms"
bytes: "I/O record on qualified slot\nAttempt ordinal, requested and actual counts\nRaw snapshot boundary and fidelity proof\nPipe/tty delivery and shell value stay distinct" {class: candidate}
graph -> bytes
es: "ES audit generation crosswalk\nBirth/exec identity, not PID/name/timestamp alone\nSame-PID exec and reuse explicitly handled" {class: source}
accept: "Claim-specific join gate\nDescriptor linearization + process identity\nBinary fidelity + independent loss/drain coverage\nNo missing edge repaired by a matching log string" {class: gate}
bytes -> accept
es -> accept
scope: "Preserve scoped fact or mark unresolved\nA sound return may survive an unknown channel\nUnknown channel cannot certify query/tty attribution\nNative exit cannot prove Scheme status delivery" {class: gate}
accept -> scope
note: "DESIGN ONLY. No descriptor table or stream was captured.\nSequential fixture success cannot qualify concurrent original workloads." {shape: text; style.font-size: 15}
scope -> note: {style.opacity: 0}
