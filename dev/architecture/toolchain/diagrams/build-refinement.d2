# Derived from BuildRefinementStep; mapping is conditional, not native acceptance.
direction: down
full: "74 action source slice\n34 generation + 34 compilation + 6 composition"
boundary: "64 omitted actions / 64 module boundary edges\nOrdered views + readiness + real credits"
selected: "Ten-node protocol\nExact selected graph; integer oracle adequacy OPEN"
full -> boundary
boundary -> selected: "relation requires boundary receipts"
P_INITIAL: "P-INITIAL\nTen selected phases / selected indices\n31,1,65,35,68,69,70,71,72,73"
P_READY: "P-READY\nready(k) plus boundaryReady(k)"
P_START: "P-START\nstart(k), selected running count increases"
P_FINISH: "P-FINISH\nfinish(k), staged state before publish"
P_PUBLISH: "P-PUBLISH\npublish(k) with related output and saved\nsignature"
P_OMITTED: "P-OMITTED\nSelected projection stutter only within a\nrelated state"
P_SHARED_MACRO: "P-SHARED-MACRO\nNo unconditional ten-node whole-build\ntransition"
P_REVOKE: "P-REVOKE\ninvalidate/cancel/discard with matching\nphase and receipt generation"
selected -> P_INITIAL
P_INITIAL -> P_READY
P_READY -> P_START
P_START -> P_FINISH
P_FINISH -> P_PUBLISH
P_PUBLISH -> P_REVOKE
P_READY -> P_OMITTED
P_OMITTED -> P_SHARED_MACRO
proof: "Lean: adaptive replay + graph / ready / budget facts\nActual step simulation and receipt issuer remain OPEN"
P_INITIAL -> proof
P_READY -> proof
P_START -> proof
P_PUBLISH -> proof
macro: "Shared macro: old input receipts invalid\nEqual validated outputs may recertify safety\nOmitted work remains charged"
P_SHARED_MACRO -> macro
boundary -> macro
ascent: "ASCENT exact-source hypotheses\nNo observation / proof / execution promotion"
proof -> ascent
macro -> ascent
