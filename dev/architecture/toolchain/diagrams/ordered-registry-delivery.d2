direction: down
caller: "Caller / native SysML" {
 grid-columns: 2
 n0: "top-level\nExpand current macro, insert its returned form before\nremaining forms; add-macro and add-declarations\ncomplete before recursion"
 n1: "body-definitions\nLeading definition scan expands macros in order; after\nfirst nondefinition it defers forms with their\nenvironment"
 n2: "expression\nExpression macro expands recursively; expander return\nis not proof that all arbitrary effects are cacheable"
 n3: "macro-install\nEvaluating expander definition may itself have\neffects; installation and invocation are separate\nevent occurrences"
 n4: "gerbil-user\nGerbil iter transformer uses binding/marks/phase\ncontext before generated Scheme reaches Gambit; do not\nmerge the two macro engines"
}
delivery: "Delivery / native SysML" {
 grid-columns: 2
 n0: "identity\nEventId includes semantic invocation/activation,\nordinal and owner domain; retry of one event retains\nidentity; new invocation is not a duplicate"
 n1: "commit\nManaged registry root transition and immutable event\nreceipt commit under one authority; current helpers\nhave no such ledger"
 n2: "unknown\nLost acknowledgement retrieves exact committed\nreceipt; unavailable authoritative state means retain\ncustody and block automatic effect replay"
 n3: "exception-prefix\nPreserve completed registration prefix on error;\nexisting handler/scope restoration is not a registry\ntransaction rollback"
 n4: "continuation\nTransport retry is not semantic continuation replay;\nnew legitimate activation may register again;\nroot/unknown holders must drain explicitly"
}
gain: "Gain / native SysML" {
 grid-columns: 2
 n0: "transport-retry\nExisting raw helper calls cannot gain this property\nwithout replacing actual write authority"
 n1: "pure-query-reuse\nOnly effect-closed observer-equivalent work can be\nskipped; arbitrary macro effects deny receipt"
 n2: "ordered-context-parallelism\nWithin-context effect order stays serial; speed\ndepends on independent ready work rather than core\ncount"
}
proof: "OD-H/I/S/E -> local ASCENT -> QNT / Lean; source and native gates OPEN"
caller -> delivery
delivery -> proof
proof -> gain
