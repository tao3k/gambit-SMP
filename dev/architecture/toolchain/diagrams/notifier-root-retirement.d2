# Derived from native SysML; protocol is proposed, source/native gates remain open.
direction: down
domain: "gxi/gxc reader-session ownership / Scheme + modern C"
roots: "Six root/restoration boundaries" {
 grid-columns: 2
 r0: "argument-and-dispatcher\n_kernel.scm:2106-2116"
 r1: "register-bank\nmem.c:6511-6523; gambit.h.in:6802-6803,7060-7066"
 r2: "saved-temporaries\ngambit.h.in:8059-8084,11623; mem.c:6526-6537"
 r3: "active-and-internal-frames\nmem.c:3898-3966; _kernel.scm:1284-1344; _t-c-1.scm:1947-1963,1986-2008"
 r4: "captured-frames-and-denv\ngambit.h.in:6314-6330,6378-6388,6589-6606,6715-6735; _kernel.scm:3613-3635; mem.c:3667-3895,4096-4145"
 r5: "error-and-winding\nruntime/error.ss:37-43,67-72; _thread.scm:4794-4812,4914-4988,5047-5076"
}
prepare: "Prepared notification / live roots"
returned: "Normal return / roots may remain"
cut: "Certified cut / no roots or restoration edges"
receipt: "RootRetirementReceipt / matching attempt and root domain"
join: "Ancestor release join / notice alone is insufficient"
denied: "Capture, exception, escape or unknown / retain custody"
proof: "SysML NR-H/I/S/E -> ASCENT -> QNT / Lean"
gates: "Seven source/native gates OPEN"
domain -> roots
roots -> prepare
prepare -> returned
returned -> cut
cut -> receipt
receipt -> join
prepare -> denied
returned -> denied
cut -> proof
proof -> gates
