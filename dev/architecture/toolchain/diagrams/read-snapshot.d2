# Derived from GscReadBoundary and SnapshotIssueCondition; callbacks and native effects remain open.
direction: down
R_RECIPE: "R-RECIPE\ngsc suffix and link recipes"
R_RECIPE -> R_WRAP
R_RECIPE -> R_ROOT
R_RECIPE -> R_LINK
R_WRAP: "R-WRAP\nCLI installs c#wrap-program before\ncompile-source"
R_WRAP -> R_HEADER
R_WRAP -> R_EXPAND
R_ROOT: "R-ROOT\ncompile-frontend -> compile-\nfrontend-aux"
R_ROOT -> R_READER
R_ROOT -> R_WRAP
R_INCLUDE: "R-INCLUDE\nActive include-expr->source and\nread-source"
R_INCLUDE -> R_READER
R_EXPAND: "R-EXPAND\nparse-exprs / extract-defs"
R_EXPAND -> R_INCLUDE
R_EXPAND -> R_MACRO
R_MACRO: "R-MACRO\nadd-macro + macro-expand"
R_MACRO -> R_HOST
R_HOST: "R-HOST\nActive Gambit evaluator adapter"
R_READER: "R-READER\nread-all from path and psettings"
R_READER -> R_OPEN
R_READER -> R_READLOOP
R_READLOOP: "R-READLOOP\nread-all-as-a-begin-expr-from-port"
R_OPEN: "R-OPEN\nopen-file-generic-from-psettings"
R_HEADER: "R-HEADER\nRecipe prelude includes header.scm"
R_HEADER -> R_HEADER_CLOSURE
R_HEADER -> R_INCLUDE
R_HEADER_CLOSURE: "R-HEADER-CLOSURE\nHeader transitive Scheme\ndefinitions"
R_HEADER_CLOSURE -> R_INCLUDE
R_HEADER_CLOSURE -> R_MACRO
R_LINK: "R-LINK\ntarg-link-info / targ-link"
effects: "Unmediated macro / reader / native effects\nReusable closure NOT established"
R_HOST -> effects
R_READLOOP -> effects
R_OPEN -> effects
image: "I-IMAGE + I-PRODUCER\nCoherent source/tool/context image"
catalog: "I-CATALOG\nValidated generated groups + leases"
trace: "I-MEDIATION + I-TRACE\nClosed finite read trace; source proof OPEN"
admit: "I-SEAL + I-ADMIT\nComplete group, serialized revoke/commit"
replay: "I-REPLAY\nSame answers + same producer/context"
effects -> trace: "must mediate / constrain / reject"
image -> trace
catalog -> trace
trace -> admit
trace -> replay
replay -> admit
