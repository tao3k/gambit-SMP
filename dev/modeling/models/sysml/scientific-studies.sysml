    part ownership {
        attribute scheme:String="Gambit semantics and primary runtime evidence; no runtime change in this migration";
        attribute python:String="Existing ExecutionContext owns fixed deadline, task identity, process birth/reaping, static dependencies and typed artifact delivery";
        attribute scientificAlgorithm:String="Private ScientificLibrary instance holds scientific formulas, extraction algorithms, scenario enumeration and negative-control assertions";
        attribute sourceIdentity:String="Closed catalog resolves current library source identities; a caller cannot load an arbitrary helper path";
        attribute sourceInverse:String="tests/fixtures/sysml-api/scientific-cohort-migration.json joins 221 independent predecessor ASTs to current private libraries; no retired source execution";
        attribute retirement:String="133 guards, 46 subprocess helper bodies including the nested formal executor, three forwarding run helpers and importlib helper paths are removed; 245 unused private cache hints and two zero-argument loader forwarding methods are retired; native qualification is separately required";
    }
    part proofDuties {
        attribute qnt:String="Bounded state-transition interleavings and counterexamples in each study's declared QNT model; keep original samples, seeds and step limits; sampling is not induction";
        attribute lean:String="Unbounded invariants, arithmetic and explicit source/model refinement obligations in each study's declared Lean source; a compiler observation is not source refinement";
        attribute ascent:String="Join source identities, per-entry ownership, field provenance, duty selection and refusal facts; no theorem or OS-lifecycle truth invented from file presence";
        attribute sourceCheck:String="Finite AST inverse, private binding, argv/cap/negative-control equivalence and exact catalog membership; no new QNT/Lean model for simple finite file membership";
        attribute unresolved:String="Historical parent evidence and complete scientific execution remain separately qualified; current byte/native-artifact transport and selected inference controls have distinct admission gates; unavailable evidence never becomes PASS";
    }
    part inferenceBoundary {
        attribute scheduling:String="Existing research.audit source-flow and scientific-inference stages exchange a PASS typed observation; each stage remains bounded by 60 seconds and the complete Recipe by its original 120 seconds";
        attribute consumer:String="Four scientific callers (including the indirect reader-span support alias) use existing evaluate_observations directly; no trajectory mutation, repository UI reader or recursive CLI";
        attribute input:String="Owned generated DSL is copied once into the current evaluation directory, hash-bound before and after native evaluation; explicit clue/factor/binding schemas replace the ClueExchange-only fragment";
        attribute controls:String="tests/fixtures/sysml-api/clue-inference-controls.json: seven formal, seven logical-cursor, seven reader-span and six ownership historical inference cases; prior answers are independent and cannot qualify current source";
        attribute bytes:String="Fixed-deadline process capture preserves stdout/stderr bytes separately, including invalid UTF8, NUL and CRLF; diagnostic rendering is not raw evidence";
        attribute nativeJob:String="Only a PASS native-executable ArtifactRef from a declared producer dependency can enter scientific capture; path lookalikes and changed bytes refuse before spawn";
        attribute fields:String="tests/fixtures/sysml-api/three-study-evolution.json records source drift independently of the 809-field value oracle; a changed source hash does not authorize changing expected values";
        attribute qnt:String="No new transition model for finite transport membership and byte equality; existing study QNT remains responsible for runtime interleavings";
        attribute lean:String="No new theorem claim from native inference replay; existing Lean owns unbounded invariants and source refinement";
        attribute qualification:String="Selected inference replay and transport controls are separate from whole-study and Gambit runtime admission";
    }
    part admission {
        attribute baseline:String="C23 modular vendor/gambit; no runtime implementation or native performance tests";
        attribute budgets:String="Original Recipe and step deadlines remain fixed; per-command ceilings never exceed the original 60 seconds; cleanup consumes the same deadline";
        attribute failure:String="Missing provider/input, stale typed source, unknown library/tool, timeout, unreaped child or unknown completion refuses and retains owner responsibility";
        attribute git:String="Maintained scientific libraries, static generated catalog, reviewed sparse inverse fixture and selected design only; raw execution artifacts remain task cache";
        attribute nativeOrchestratorRetired:String="qualify-native-stage.py: 600-second private recursive CLI loop retired; source-only research cannot execute that historical cache recipe; use declared native.* or gambit.* Recipes under their existing budgets";
        attribute standaloneRunners:Integer=0;
        attribute wholeStudyAdmitted:Boolean=false;
        attribute nativeWriterClosure:Boolean=false;
    }
