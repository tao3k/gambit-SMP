        attribute nativeRoute:String="Native evidence requires matching source, profile, command, budget, process outcome and descendants; neither cache byte equality nor new typecheck qualifies an old native run";
        attribute retirement:String="Retire a live cache edge only after all actual code consumers use a declared typed dependency; keep every historical ledger obligation and failure";
