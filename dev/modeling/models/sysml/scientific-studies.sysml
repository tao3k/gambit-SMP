        attribute storageAuthority:String="Original SHA256 plus contained Git repository/full commit/blob/path; source version identity is distinct from original execution producer attestation";
        attribute storageClosure:String="Every current reference consumes the immutable identity; original referenceSpec and duty remain in the ledger; missing Git objects refuse facts and never trigger legacy cache fallback";
        attribute coldRecipe:String="tests/recipes/framework-contracts/current-research-recovery.recipe.json";
