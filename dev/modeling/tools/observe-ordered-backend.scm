(##namespace ("gambit#research#ordered-sync#"
              root runtime out cc records capture write-record hash-file common group-absent?))
(define root (path-expand (getenv "GAMBIT_SMP_ROOT")))
(define runtime (path-expand (getenv "GAMBIT_SMP_RUNTIME")))
(define out (path-expand (getenv "GAMBIT_SMP_OUT")))
(define cc (getenv "GAMBIT_SMP_CC"))
(define records '())
(define (write-record path value)
  (call-with-output-file path (lambda (p) (write value p) (newline p))))
(define (group-absent? pid)
  (let* ((p (open-process (list path: "/bin/kill" arguments: (list "-0" "--" (number->string (- pid))) stderr-redirection: #t)))
         (reader (make-thread (lambda () (read-line p #f)))))
    (close-output-port p) (thread-start! reader)
    (let ((status (process-status p 10 'unknown))
          (text (thread-join! reader 2 'unknown)))
      (close-input-port p)
      (and (number? status) (= status 256) (string? text)))))
(define (capture name argv cap)
  (let* ((start (time->seconds (current-time)))
         (p (open-process
             (list path: "/opt/homebrew/bin/gtimeout"
                   arguments: (append (list "--kill-after=2s" (string-append (number->string cap) "s")) argv)
                   directory: out stderr-redirection: #t)))
         (pid (process-pid p))
         (reader
          (make-thread (lambda ()
                         (call-with-output-file (string-append out "/" name ".output")
                           (lambda (log)
                             (let loop ((b (read-u8 p)))
                               (if (not (eof-object? b))
                                   (begin (write-u8 b log) (loop (read-u8 p)))))))))))
    (close-output-port p) (thread-start! reader)
    (let* ((status (process-status p (+ cap 3) 'unknown))
           (joined (thread-join! reader 2 'unknown))
           (quiet (group-absent? pid)))
      (close-input-port p)
      (set! records (cons (list name argv cap status (not (eq? joined 'unknown))
                                (- (time->seconds (current-time)) start) pid quiet) records))
      (write-record (string-append out "/observations.scm") (reverse records))
      (if (not (and (number? status) (= status 0) (not (eq? joined 'unknown)) quiet))
          (error "ordered backend observation failed" name status)))))
(define (hash-file path)
  (let* ((p (open-process (list path: "/usr/bin/shasum" arguments: (list "-a" "256" path))))
         (reader (make-thread (lambda () (read-line p #f)))))
    (close-output-port p) (thread-start! reader)
    (let ((status (process-status p 10 'unknown)) (line (thread-join! reader 2 'unknown)))
      (close-input-port p)
      (if (not (and (number? status) (= status 0) (string? line) (>= (string-length line) 64)))
          (error "cannot bind backend input" path))
      (cons path (substring line 0 64)))))
(create-directory out)
(for-each (lambda (k) (setenv k)) '("SDKROOT" "LIBRARY_PATH" "CPATH" "GAMBOPT"))
(setenv "PATH" (string-append (path-directory cc) ":/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin"))
(define common (list "-std=c23" "-O1" "-pthread" "-DHAVE_CONFIG_H" "-I" (string-append runtime "/include")))
(write-record (string-append out "/inputs.scm")
              (list (cons 'identity (map hash-file (list cc "/usr/bin/clang" (string-append root "/tests/ordered-sync.c")
                                                       (string-append runtime "/include/gambit.h")
                                                       (string-append runtime "/lib/setup.c"))))
                    (cons 'common common) (cons 'heap-override #f) (cons 'runtime-wait-extension #f)))
(capture "native-macros" (append (list cc) common (list "-dM" "-E" "-x" "c" "-include" "gambit.h" "/dev/null")) 30)
(capture "legacy-macros" (append (list cc) common (list "-D___ORDERED_WORD_FORCE_LEGACY" "-dM" "-E" "-x" "c" "-include" "gambit.h" "/dev/null")) 30)
(capture "legacy-compile" (append (list cc) common (list "-D___ORDERED_WORD_FORCE_LEGACY" (string-append root "/tests/ordered-sync.c") "-o" (string-append out "/legacy"))) 30)
(capture "legacy-run" (list (string-append out "/legacy")) 10)
(capture "native-assembly" (append (list cc) common (list "-S" (string-append root "/tests/ordered-sync.c") "-o" (string-append out "/native.s"))) 30)
(capture "clang-ir" (append (list "/usr/bin/clang") common (list "-S" "-emit-llvm" (string-append root "/tests/ordered-sync.c") "-o" (string-append out "/native.ll"))) 30)
(display "ORDERED-BACKEND-EVIDENCE-PASS\n")
