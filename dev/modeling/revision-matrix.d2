direction: right
model: "SysML: required audit / matrix contract"
report: "Reviewed nine-field report + typed matrix"
raw: "Durable raw evidence\nbase / tree / profile / value / unit / samples"
validator: "Existing Python submission service\nprovenance, arithmetic, signed change"
ascent: "ASCENT five gates\ncompleteness, context, evidence binding"
commit: "Reviewed commit body\nrows + audit digest + matrix digest"
open: "Unmeasured / retained failures\nno invented speedup or whole-SMP credit"
model -> report
model -> validator
raw -> validator
report -> validator
validator -> ascent
ascent -> commit: "all required evidence closes"
validator -> open: "explicit limitations"
ascent -> open: "missing / stale / invalid blocks"
