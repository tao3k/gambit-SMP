;; Evidence for the composed engineering experiment, not native admission.
(ascent-fragment
 (relation required_step ((step symbol?)))
 (relation observed_step ((step symbol?) (status string?) (capability string?)))
 (relation c_verdict ((step symbol?) (contract string?) (branch string?) (verdict string?) (scope string?)))
 (relation c_reachability ((step symbol?) (contract string?) (branch string?) (witness string?) (status string?)))
 (relation c_property ((step symbol?) (property string?) (status string?) (file string?) (line string?) (description string?)))
 (relation c_source ((step symbol?) (path string?) (sha string?)))
 (relation rest_cut ((step symbol?) (contract string?) (branch string?) (source string?)))
 (relation rest_source_cut ((step symbol?) (contract string?) (branch string?) (verdict string?) (source string?) (sha string?)))
 (relation rest_source_witness ((step symbol?) (witness string?) (status string?) (source string?) (sha string?)))
 (relation rest_source_counterexample ((step symbol?) (witness string?) (property string?) (source string?) (sha string?)))
 (relation rest_source_repair_target ((step symbol?) (witness string?) (source string?) (sha string?) (obligation string?)))
 (relation model_need ((id string?) (step symbol?) (capability string?)))
 (relation checked ((id string?)))
 (relation model_open ((id string?)))
 (relation qualified_counterexample ((id string?)))
 (relation native_need ((id string?)))
 (relation native_witness ((id string?)))
 (relation native_open ((id string?)))
 (relation source_open ((id string?)))
 ((model_need (lit "refusal-composition") (lit (quote frame-history)) (lit "quint.observe")) <-- (required_step (lit (quote frame-history))))
 ((model_need (lit "record-pin-retirement") (lit (quote source-lifetime)) (lit "quint.observe")) <-- (required_step (lit (quote source-lifetime))))
 ((model_need (lit "authority-revisions") (lit (quote authority-revisions)) (lit "quint.observe")) <-- (required_step (lit (quote authority-revisions))))
 ((model_need (lit "point-cut-baseline") (lit (quote argument-cut)) (lit "quint.observe")) <-- (required_step (lit (quote argument-cut))))
 ((model_need (lit "frame-and-stop-geometry") (lit (quote frame-geometry)) (lit "lean.check")) <-- (required_step (lit (quote frame-geometry))))
 ((model_need (lit "connected-contracts") (lit (quote contract-model)) (lit "sysml.project")) <-- (required_step (lit (quote contract-model))))
 ((model_need (lit "delivery-and-full-envelope") (lit (quote rest-envelope)) (lit "quint.observe")) <-- (required_step (lit (quote rest-envelope))))
 ((model_need (lit "section-entry-claim-publication") (lit (quote section-states)) (lit "quint.observe")) <-- (required_step (lit (quote section-states))))
 ((model_need (lit "rest-refinement-lemmas") (lit (quote rest-refinement)) (lit "lean.check")) <-- (required_step (lit (quote rest-refinement))))
 ((checked I) <-- (model_need I S C) (observed_step S (lit "PASS") C))
 ((model_open I) <-- (model_need I _ _) (not (checked I)))
 ((checked (lit "real-C-path-demand")) <--
   (c_verdict (lit (quote demand-source)) (lit "allocation-grant/rest-demand")
     (lit "path-footprint") (lit "VERIFIED") _))
 ((qualified_counterexample (lit "fast-is-not-full")) <--
   (c_reachability (lit (quote demand-control)) (lit "allocation-grant/rest-demand")
     (lit "path-footprint") (lit "control.fast-equals-full") (lit "REACHED")))
 ((rest_cut (lit (quote full-admission)) (lit "allocation-grant/rest-demand") (lit "full-admission")
     (lit "vendor/gambit/lib/_mem/rc-allocation.inc")) <-- (required_step (lit (quote full-admission))))
 ((rest_cut S (lit "rest-activation/settlement") (lit "ready-delivery")
     (lit "vendor/gambit/lib/_mem/rc-allocation.inc")) <-- (required_step S)
     (c_verdict S (lit "rest-activation/settlement") (lit "ready-delivery") _ _))
 ((rest_cut S (lit "rest-source/custody") (lit "caller-prefix")
     (lit "vendor/gambit/lib/_kernel.scm")) <-- (required_step S)
     (c_verdict S (lit "rest-source/custody") (lit "caller-prefix") _ _))
 ((rest_cut S (lit "allocation-grant/rest-section") (lit "claim-publication")
     (lit "vendor/gambit/lib/_mem/heap-sections.inc")) <-- (required_step S)
     (c_verdict S (lit "allocation-grant/rest-section") (lit "claim-publication") _ _))
 ((rest_source_cut S C B V P H) <-- (rest_cut S C B P) (c_verdict S C B V _) (c_source S P H))
 ((rest_source_witness S W T P H) <-- (rest_source_cut S C B (lit "REACHABILITY") P H) (c_reachability S C B W T))
 ((rest_source_counterexample S W Id P H) <--
     (rest_source_witness S W (lit "REACHED") P H) (c_property S Id (lit "FAILURE") _ _ W))
 ((checked (lit "current-handler-routing")) <--
     (rest_source_cut (lit (quote handler-routes)) _ _ (lit "VERIFIED") _ _))
 ((checked (lit "current-prefix-routing")) <--
     (rest_source_cut (lit (quote caller-prefix)) _ _ (lit "VERIFIED") _ _))
 ((checked (lit "serialized-fresh-claim-publication")) <--
     (rest_source_cut (lit (quote claim-publication)) _ _ (lit "VERIFIED") _ _))
 ((checked (lit "serialized-fresh-claim-reachable")) <--
     (rest_source_counterexample (lit (quote fresh-claim-control)) (lit "control.real-fresh-claim-and-publication") _ _ _))
 ((qualified_counterexample (lit "prefix-completion-is-not-cross-break-handoff")) <--
     (rest_source_counterexample (lit (quote prefix-no-handoff-control)) (lit "control.prefix-completes-without-handoff") _ _ _))
 ((qualified_counterexample (lit "soft-only-publication-is-not-a-section-claim")) <--
     (rest_source_counterexample (lit (quote soft-only-control)) (lit "control.soft-only-publishes-owned-edge-without-section-claim") _ _ _))
 ((rest_source_repair_target S (lit "control.grant-does-not-discharge-writer") P H (lit "prove-root-writer-and-delivery-custody-through-finish")) <--
     (rest_source_witness S (lit "control.grant-does-not-discharge-writer") (lit "REACHED") P H))
 ((rest_source_repair_target S (lit "control.prefix-completes-without-handoff") P H (lit "trace-real-break-link-and-last-old-source-use")) <--
     (rest_source_counterexample S (lit "control.prefix-completes-without-handoff") _ P H))
 ((rest_source_repair_target S (lit "control.soft-only-publishes-owned-edge-without-section-claim") P H (lit "measure-post-recovery-physical-shortage-before-lock-request")) <--
     (rest_source_counterexample S (lit "control.soft-only-publishes-owned-edge-without-section-claim") _ P H))
 ((rest_source_repair_target S (lit "c-verifier-counterexample") P H (lit "inspect-failed-property-and-trace")) <--
     (rest_source_cut S _ _ (lit "COUNTEREXAMPLE") P H))
 ((native_need (lit "whole-protected-footprint")) <-- (required_step (lit (quote demand-source))))
 ((native_need (lit "caught-refusal-then-reentry")) <-- (required_step (lit (quote frame-history))))
 ((native_need (lit "actual-cross-break-handoff")) <-- (required_step (lit (quote caller-prefix))))
 ((native_need (lit "last-old-source-use-and-successor-acquisition-before-unpin")) <-- (required_step (lit (quote caller-prefix))))
 ((native_need (lit "two-valid-rest-attempts-contend-for-same-last-eligible-section")) <-- (required_step (lit (quote claim-publication))))
 ((native_need (lit "winner-post-unlock-publication-and-renewed-grant-same-attempt")) <-- (required_step (lit (quote claim-publication))))
 ((native_open I) <-- (native_need I) (not (native_witness I)))
 ((source_open (lit "independent-complete-lowering")) <-- (required_step (lit (quote demand-source))))
 ((source_open (lit "actual-exception-unwind-and-fixture-frame")) <-- (required_step (lit (quote frame-history))))
 ((source_open (lit "logical-successor-to-C-decoder")) <-- (required_step (lit (quote caller-prefix))))
 ((source_open (lit "claim-custody-under-interference-through-publication")) <-- (required_step (lit (quote claim-publication))))
 ((source_open (lit "producer-and-linked-image-correspondence")) <-- (required_step _))
)
