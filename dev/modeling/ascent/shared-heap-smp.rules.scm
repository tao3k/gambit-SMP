;; Native SysML supplies the joint cut and its exact existing-owner dependencies.
;; The separate obligation-ownership rules enforce Quint/Lean/source/native
;; responsibility. No receipt or file association alone grants runtime authority.
(relation shDesign (id))
(relation shExecutionQuestion (id))
(relation shNeed (id))
(relation shSupport (id question owner subject scope))
(relation shSupportReceipt (id owner subject scope))
(relation shSupportChecked (id))
((shSupportChecked I) <-- (shSupport I _ O H S) (shSupportReceipt I O H S))
(relation shSupportOpen (id question))
((shSupportOpen I Q) <-- (shSupport I Q _ _ _) (not (shSupportChecked I)))
(relation shWorkstream (id))
(relation shAssignment (question workstream))
(relation shWorkDependency (dependent prerequisite))
(relation shSourceSite (id question artifact digest status))
(relation shSourceRequirement (id gap))
(relation shAdapter (id question subject))
(relation shAdapterClause (id adapter kind))
(relation shAdapterReceipt (clause subject method outcome))
(relation shInventoryFamily (family adapter))
(relation shInventoryReviewOpen (adapter family))
((shInventoryReviewOpen A F) <-- (shInventoryFamily F A) (shAdapterClauseOpen _ A))
(relation shSourceCase (id adapter clause))
(relation shCaseDependency (dependent prerequisite))
(relation shHandoffPoint (id protocol clause))
(relation shHandoffPointOpen (id protocol))
((shHandoffPointOpen I P) <-- (shHandoffPoint I P C) (shAdapterClauseOpen C _))
(relation shHandoffProtocolOpen (id))
((shHandoffProtocolOpen P) <-- (shHandoffPointOpen _ P))
(relation shSourceCaseOpen (id reason))
((shSourceCaseOpen I (lit "source-clause-open")) <--
 (shSourceCase I _ C) (shAdapterClauseOpen C _))
((shSourceCaseOpen I (lit "handoff-premise-open")) <--
 (shCaseDependency I P) (shSourceCaseOpen P _))
(relation shAdapterClauseChecked (id))
((shAdapterClauseChecked C) <-- (shAdapterClause C A _)
 (shAdapter A _ H) (shAdapterReceipt C H (lit "source-refinement") (lit "pass")))
(relation shAdapterClauseOpen (clause adapter))
((shAdapterClauseOpen C A) <-- (shAdapterClause C A _) (not (shAdapterClauseChecked C)))
(relation shAdapterSourceMissing (adapter))
((shAdapterSourceMissing A) <-- (shAdapter A Q _) (shSourceSite _ Q _ _ (lit "missing")))
(relation shAdapterClosed (id))
((shAdapterClosed A) <-- (shAdapter A _ _) (shAdapterClause _ A _)
 (not (shAdapterClauseOpen _ A)) (not (shAdapterSourceMissing A)))
(relation shAdapterQuestionOpen (question))
((shAdapterQuestionOpen Q) <-- (shAdapter A Q _) (not (shAdapterClosed A)))
(relation shSourceLocated (id))
((shSourceLocated I) <-- (shSourceSite I _ _ _ (lit "located")))
(relation shSourceGap (question site gap))
((shSourceGap Q I G) <-- (shSourceSite I Q _ _ _) (shSourceRequirement I G))
(relation shMappedQuestion (id))
((shMappedQuestion Q) <-- (shSourceSite I Q _ _ _) (shSourceLocated I))
(relation shWorkOpen (id reason))
((shWorkOpen W (lit "question-open")) <-- (shAssignment Q W) (shOpen Q _))
((shWorkOpen W (lit "source-location-missing")) <--
 (shAssignment Q W) (shSourceSite I Q _ _ (lit "missing")))
((shWorkOpen W (lit "prerequisite-open")) <--
 (shWorkDependency W P) (shWorkOpen P _))
(relation shDependency (dependent prerequisite))
(relation shExternal (id authority artifact digest scope))
(relation shExternalDependency (dependent prerequisite))
(relation shExternalReceipt (id authority artifact digest scope method outcome))
(relation shExternalChecked (id))
((shExternalChecked I) <-- (shExternal I A P H S)
 (shExternalReceipt I A P H S (lit "source-refinement") (lit "pass")))
(relation shOpen (id reason))
((shOpen Q (lit "support-factor-open")) <-- (shSupportOpen _ Q))
((shOpen I (lit "local-evidence-missing")) <-- (shNeed I) (verificationMissing I _))
((shOpen Q (lit "adapter-refinement-open")) <-- (shAdapterQuestionOpen Q))
((shOpen Q (lit "source-location-missing")) <--
 (shSourceSite _ Q _ _ (lit "missing")))
((shOpen I (lit "inherited-source-frontier-open")) <--
 (shExternalDependency I P) (not (shExternalChecked P)))
((shOpen I (lit "dependency-open")) <-- (shDependency I P) (shOpen P _))
(relation shCheckedLocal (id))
((shCheckedLocal I) <-- (shNeed I) (verificationChecked I) (not (shAdapterQuestionOpen I)))
(relation shPath (from to))
((shPath A B) <-- (shDependency A B))
((shPath A C) <-- (shPath A B) (shDependency B C))
(relation shCycle (id))
((shCycle I) <-- (shPath I I))
(relation shNativeReady (id))
((shNativeReady C) <-- (shDesign C) (shExecutionQuestion I)
 (shNeed I) (verificationChecked I) (verificationReady C)
 (not (shOpen _ _)) (not (shCycle _)))
