(ascent-fragment
 (relation scenario ((id string?)))
 (relation need ((id string?) (kind string?) (path string?) (digest string?) (scope string?)))
 (relation receipt ((scenario string?) (id string?) (path string?) (digest string?) (scope string?)))
 (relation method ((kind string?) (tool string?)))
 (relation route ((scenario string?) (id string?) (tool string?) (path string?) (scope string?)))
 ((route S N T P C) <-- (scenario S) (need N K P _ C) (method K T))
 (relation checked ((scenario string?) (id string?)))
 (relation blocked ((scenario string?) (reason string?)))
 (relation candidate ((scenario string?)))
 ((checked S N) <-- (scenario S) (need N _ P H C) (receipt S N P H C))
 ((blocked S N) <-- (scenario S) (need N _ _ _ _) (not (checked S N)))
 (relation binding ((key string?) (action string?) (lemma string?)))
 (relation modelAction ((action string?)))
 (relation modelLemma ((lemma string?)))
 (relation linked ((key string?)))
 ((linked K) <-- (binding K A L) (modelAction A) (modelLemma L))
 ((blocked S K) <-- (scenario S) (binding K _ _) (not (linked K)))
 (relation witness ((key string?) (path string?) (digest string?) (needle string?)))
 (relation observation ((key string?) (path string?) (digest string?) (needle string?)))
 (relation observed ((key string?)))
 ((observed K) <-- (witness K P H N) (observation K P H N))
 ((blocked S K) <-- (scenario S) (witness K _ _ _) (not (observed K)))
 (relation bridgeBinding ((key string?) (guard string?) (update string?)))
 (relation certificateLemma ((name string?)))
 (relation bridgeLinked ((key string?)))
 ((bridgeLinked K) <-- (bridgeBinding K G U) (certificateLemma G) (certificateLemma U))
 ((blocked S K) <-- (scenario S) (bridgeBinding K _ _) (not (bridgeLinked K)))
 ((candidate S) <-- (scenario S) (not (blocked S _)))
)
