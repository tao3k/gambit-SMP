;; Fragment inventory comes from native GambitHeaderOrganization evaluation.
;; Source equality and native consumers have separate authority. No QNT/Lean
;; schedule/algebra or global runtime-commit rule is introduced here.
(relation hoIdentity (baseline source profile))
(relation hoPart (id digest))
(relation hoPartEvidence (id digest baseline source outcome))
(relation hoPass (outcome) (("pass")))
(relation hoPartRejected (id))
((hoPartRejected I) <-- (hoIdentity B S _) (hoPart I H)
 (hoPartEvidence I H B S O) (not (hoPass O)))
(relation hoPartSupplied (id))
((hoPartSupplied I) <-- (hoIdentity B S _) (hoPart I H)
 (hoPartEvidence I H B S "pass") (not (hoPartRejected I)))
(relation hoPartMissing (id))
((hoPartMissing I) <-- (hoPart I _) (not (hoPartSupplied I)))
(relation hoPartition (baseline source exact))
(relation hoByteQualified (source))
((hoByteQualified S) <-- (hoIdentity B S _) (hoPartition B S "pass")
 (not (hoPartMissing _)))
(relation hoNative (source profile check outcome))
(relation hoNativeRejected (source))
((hoNativeRejected S) <-- (hoIdentity _ S P) (hoNative S P _ O)
 (not (hoPass O)))
(relation hoConsumerQualified (source))
((hoConsumerQualified S) <-- (hoIdentity _ S P) (hoByteQualified S)
 (hoNative S P "configured-output" "pass")
 (hoNative S P "c23-consumer" "pass")
 (hoNative S P "all-dependencies" "pass")
 (hoNative S P "distribution-paths" "pass")
 (not (hoNativeRejected S)))
;; Header organization cannot grant native SMP/retirement/commit admission.
(relation hoRuntimeAdmission (source))
