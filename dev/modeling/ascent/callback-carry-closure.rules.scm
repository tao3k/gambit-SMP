(ascent-fragment
 (relation scenario ((id string?)))
 (relation need ((id string?) (kind string?) (path string?) (digest string?) (scope string?)))
 (relation receipt ((scenario string?) (id string?) (path string?) (digest string?) (scope string?)))
 (relation checked ((scenario string?) (id string?)))
 (relation blocked ((scenario string?) (reason string?)))
 (relation candidate ((scenario string?)))
 ((checked S N) <-- (scenario S) (need N _ P H C) (receipt S N P H C))
 ((blocked S N) <-- (scenario S) (need N _ _ _ _) (not (checked S N)))
 (relation binding ((action string?) (lemma string?)))
 (relation actionName ((action string?)))
 (relation lemmaName ((lemma string?)))
 (relation linked ((action string?)))
 ((linked A) <-- (binding A L) (actionName A) (lemmaName L))
 ((blocked S A) <-- (scenario S) (binding A _) (not (linked A)))
 (relation sourceNeed ((id string?) (path string?) (digest string?) (needle string?)))
 (relation sourceObservation ((id string?) (path string?) (digest string?) (needle string?)))
 (relation sourceLinked ((id string?)))
 ((sourceLinked I) <-- (sourceNeed I P H N) (sourceObservation I P H N))
 ((blocked S I) <-- (scenario S) (sourceNeed I _ _ _) (not (sourceLinked I)))
 (relation callbackNeed ((key string?) (registrant string?) (closure string?) (authority string?) (status string?)))
 (relation callbackObservation ((key string?) (registrant string?) (closure string?) (authority string?) (status string?)))
 (relation callbackLinked ((key string?)))
 ((callbackLinked K) <-- (callbackNeed K R C A T) (callbackObservation K R C A T))
 ((blocked S K) <-- (scenario S) (callbackNeed K _ _ _ _) (not (callbackLinked K)))
 ((candidate S) <-- (scenario S) (not (blocked S _)))
)
