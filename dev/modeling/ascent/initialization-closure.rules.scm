;; Native SysML owns caller edges and qualification gates; controls are not authority.
(relation initNodeFact (node kind anchor))
(relation initEdgeFact (producer consumer))
(relation initNodeTripleFact (n0 k0 a0 n1 k1 a1 n2 k2 a2))
((initNodeFact N K A) <-- (initNodeTripleFact N K A _ _ _ _ _ _))
((initNodeFact N K A) <-- (initNodeTripleFact _ _ _ N K A _ _ _))
((initNodeFact N K A) <-- (initNodeTripleFact _ _ _ _ _ _ N K A))
(relation initEdgeSixFact (p0 c0 p1 c1 p2 c2 p3 c3 p4 c4 p5 c5))
((initEdgeFact P C) <-- (initEdgeSixFact P C _ _ _ _ _ _ _ _ _ _))
((initEdgeFact P C) <-- (initEdgeSixFact _ _ P C _ _ _ _ _ _ _ _))
((initEdgeFact P C) <-- (initEdgeSixFact _ _ _ _ P C _ _ _ _ _ _))
((initEdgeFact P C) <-- (initEdgeSixFact _ _ _ _ _ _ P C _ _ _ _))
((initEdgeFact P C) <-- (initEdgeSixFact _ _ _ _ _ _ _ _ P C _ _))
((initEdgeFact P C) <-- (initEdgeSixFact _ _ _ _ _ _ _ _ _ _ P C))
(relation freezeFirstFact (scenario closed g0 q0 g1 q1 g2 q2 g3 q3))
(relation freezeSecondFact (scenario g4 q4 g5 q5 g6 q6 g7 q7))
(relation initializationReach (scenario node))
(relation initializationBoundary (scenario node kind anchor))
(relation freezeMissingGate (scenario gate))
(relation freezeDenied (scenario reason))
(relation freezeCandidate (scenario))
((initializationReach S (lit "root")) <-- (boundComponent (lit "build-scheduler") _) (scenarioFact S _))
((initializationReach S B) <-- (initializationReach S A) (initEdgeFact A B))
((initializationBoundary S N (lit "opaque") A) <-- (initializationReach S N) (initNodeFact N (lit "opaque") A))
((initializationBoundary S N (lit "open") A) <-- (initializationReach S N) (initNodeFact N (lit "open") A))
((initializationBoundary S N (lit "native") A) <-- (initializationReach S N) (initNodeFact N (lit "native") A))
((initializationBoundary S N (lit "process") A) <-- (initializationReach S N) (initNodeFact N (lit "process") A))
((freezeMissingGate S G) <-- (scenarioFact S _) (freezeFirstFact S _ G (lit "false") _ _ _ _ _ _))
((freezeMissingGate S G) <-- (scenarioFact S _) (freezeFirstFact S _ _ _ G (lit "false") _ _ _ _))
((freezeMissingGate S G) <-- (scenarioFact S _) (freezeFirstFact S _ _ _ _ _ G (lit "false") _ _))
((freezeMissingGate S G) <-- (scenarioFact S _) (freezeFirstFact S _ _ _ _ _ _ _ G (lit "false")))
((freezeMissingGate S G) <-- (scenarioFact S _) (freezeSecondFact S G (lit "false") _ _ _ _ _ _))
((freezeMissingGate S G) <-- (scenarioFact S _) (freezeSecondFact S _ _ G (lit "false") _ _ _ _))
((freezeMissingGate S G) <-- (scenarioFact S _) (freezeSecondFact S _ _ _ _ G (lit "false") _ _))
((freezeMissingGate S G) <-- (scenarioFact S _) (freezeSecondFact S _ _ _ _ _ _ G (lit "false")))
((freezeDenied S (lit "source-closure-open")) <-- (scenarioFact S _) (freezeFirstFact S (lit "false") _ _ _ _ _ _ _ _))
((freezeDenied S G) <-- (freezeMissingGate S G))
((freezeCandidate S) <-- (scenarioFact S _) (freezeFirstFact S (lit "true") _ (lit "true") _ (lit "true") _ (lit "true") _ (lit "true")) (freezeSecondFact S _ (lit "true") _ (lit "true") _ (lit "true") _ (lit "true")))
