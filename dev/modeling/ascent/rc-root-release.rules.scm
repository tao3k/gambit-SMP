(ascent-fragment
 (relation sourceNeed ((id string?) (path string?) (hash string?) (needle string?)))
 (relation sourceSeen ((id string?) (path string?) (hash string?) (needle string?)))
 (relation sourceLinked ((id string?)))
 ((sourceLinked I) <-- (sourceNeed I P H N) (sourceSeen I P H N))
 (relation obligation ((id string?) (status string?) (condition string?)))
 (relation qualified ((id string?) (status string?) (condition string?)))
 (relation obligationLinked ((id string?)))
 ((obligationLinked I) <-- (obligation I S C) (qualified I S C))
 (relation actionName ((name string?)))
 (relation lemmaName ((name string?)))
 (relation routeNeed ((action string?) (lemma string?) (source string?) (obligation string?)))
 (relation routeSeen ((action string?) (lemma string?) (source string?) (obligation string?)))
 (relation routeLinked ((action string?)))
 ((routeLinked A) <-- (routeNeed A L S O) (routeSeen A L S O) (actionName A) (lemmaName L) (sourceLinked S) (obligation O _ _))
 (relation issuerNeed ((id string?) (source string?) (signature string?) (gap string?)))
 (relation issuerSeen ((id string?) (source string?) (signature string?) (gap string?)))
 (relation issuerLinked ((id string?)))
 ((issuerLinked I) <-- (issuerNeed I S C G) (issuerSeen I S C G) (sourceLinked S))
 (relation blocked ((id string?)))
 ((blocked I) <-- (sourceNeed I _ _ _) (not (sourceLinked I)))
 ((blocked I) <-- (obligation I _ _) (not (obligationLinked I)))
 ((blocked I) <-- (routeNeed I _ _ _) (not (routeLinked I)))
 ((blocked I) <-- (issuerNeed I _ _ _) (not (issuerLinked I)))
 (relation candidate ((status string?)))
 ((candidate "conditional") <-- (not (blocked _))))
