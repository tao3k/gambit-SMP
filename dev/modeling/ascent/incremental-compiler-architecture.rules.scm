(relation compilerPlacementFact (key owner anchor))
(relation compilerPlacement (scenario key owner anchor))
((compilerPlacement S K O A) <-- (scenarioFact S _) (compilerPlacementFact K O A))
(relation compilerComponentFact (key anchor))
(relation compilerGateFact (scenario key qualified))
(relation compilerSourceFact (scenario qualified))
(relation compilerComponent (scenario key anchor))
(relation compilerMissing (scenario gate))
(relation compilerBlocked (scenario reason))
(relation compilerCandidate (scenario))
((compilerComponent S K A) <-- (scenarioFact S _) (compilerComponentFact K A))
((compilerMissing S G) <-- (compilerGateFact S G (lit "false")))
((compilerBlocked S G) <-- (compilerMissing S G))
((compilerBlocked S (lit "compiler-source-refinement-open")) <-- (compilerSourceFact S (lit "false")))
((compilerCandidate S) <-- (scenarioFact S _) (compilerSourceFact S (lit "true")) (not (compilerBlocked S _)))
