(ascent-fragment
 (relation contractNeed ((id string?) (schema string?) (producer string?) (consumers string?) (seal string?) (invalidate string?) (custody string?) (retirement string?) (gap string?)))
 (relation contractSeen ((id string?) (schema string?) (producer string?) (consumers string?) (seal string?) (invalidate string?) (custody string?) (retirement string?) (gap string?)))
 (relation contractLinked ((id string?)))
 ((contractLinked I) <-- (contractNeed I S P C F V U R G) (contractSeen I S P C F V U R G))
 (relation contractGap ((id string?)))
 ((contractGap I) <-- (contractNeed I _ _ _ _ _ _ _ _) (not (contractLinked I)))
 (relation sliceNeed ((id string?) (owner string?) (semantic string?) (artifact string?) (state string?)))
 (relation sliceSeen ((id string?) (owner string?) (semantic string?) (artifact string?) (state string?)))
 (relation artifactNeed ((path string?) (digest string?)))
 (relation artifactSeen ((path string?) (digest string?)))
 (relation checkedSlice ((id string?)))
 ((checkedSlice I) <-- (sliceNeed I O S P "conditional-subset")
  (sliceSeen I O S P "conditional-subset") (artifactNeed P H) (artifactSeen P H))
 (relation sliceGap ((id string?)))
 ((sliceGap I) <-- (sliceNeed I _ _ _ _) (not (checkedSlice I)))

 ;; A checked interface slice is not a receipt closing its canonical obligation.
 (relation gateNeed ((id string?) (entry string?) (completion string?) (blocked string?)))
 (relation depends ((gate string?) (prior string?)))
 (relation gateReceipt ((id string?) (scope string?) (disposition string?)))
 (relation gateBlocked ((id string?)))
 ((gateBlocked I) <-- (gateNeed I _ C _) (not (gateReceipt I C "source-and-native-qualified")))
 ((gateBlocked I) <-- (gateNeed I _ _ _) (contractGap _))
 ((gateBlocked I) <-- (gateNeed I _ _ _) (sliceNeed S _ _ _ "conditional-subset") (not (checkedSlice S)))
 ((gateBlocked I) <-- (depends I P) (gateBlocked P))
 (relation gateReady ((id string?)))
 ((gateReady I) <-- (gateNeed I _ _ _) (not (gateBlocked I)))
 (relation oldReader ((id string?)))
 (relation retirementReady ((id string?)))
 ((retirementReady I) <-- (gateReady I) (not (oldReader I)))
)
