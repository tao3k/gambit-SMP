;; SysML owns classifications, dependency edges and source gate facts.
(relation readerRegionFact (region ownership anchor contract))
(relation readerEdgeFact (producer consumer))
(relation readerRegionTripleFact (n0 k0 a0 t0 n1 k1 a1 t1 n2 k2 a2 t2))
((readerRegionFact N K A T) <-- (readerRegionTripleFact N K A T _ _ _ _ _ _ _ _))
((readerRegionFact N K A T) <-- (readerRegionTripleFact _ _ _ _ N K A T _ _ _ _))
((readerRegionFact N K A T) <-- (readerRegionTripleFact _ _ _ _ _ _ _ _ N K A T))
(relation readerEdgeSixFact (p0 c0 p1 c1 p2 c2 p3 c3 p4 c4 p5 c5))
((readerEdgeFact P C) <-- (readerEdgeSixFact P C _ _ _ _ _ _ _ _ _ _))
((readerEdgeFact P C) <-- (readerEdgeSixFact _ _ P C _ _ _ _ _ _ _ _))
((readerEdgeFact P C) <-- (readerEdgeSixFact _ _ _ _ P C _ _ _ _ _ _))
((readerEdgeFact P C) <-- (readerEdgeSixFact _ _ _ _ _ _ P C _ _ _ _))
((readerEdgeFact P C) <-- (readerEdgeSixFact _ _ _ _ _ _ _ _ P C _ _))
((readerEdgeFact P C) <-- (readerEdgeSixFact _ _ _ _ _ _ _ _ _ _ P C))
(relation readerGateFact (scenario admitted g0 q0 g1 q1 g2 q2 g3 q3 g4 q4))
(relation readerReach (scenario region))
(relation readerFreezeCandidate (scenario region anchor))
(relation readerOwnerRequired (scenario region anchor))
(relation readerBoundary (scenario region ownership anchor))
(relation readerMissingGate (scenario gate))
(relation readerAdmissionDenied (scenario reason))
(relation readerAdmissionCandidate (scenario))
((readerReach S (lit "entry")) <-- (boundComponent (lit "build-scheduler") _) (scenarioFact S _))
((readerReach S B) <-- (readerReach S A) (readerEdgeFact A B))
((readerFreezeCandidate S N A) <-- (readerReach S N) (readerRegionFact N (lit "candidate") A _))
((readerOwnerRequired S N A) <-- (readerReach S N) (readerRegionFact N (lit "session") A _))
((readerOwnerRequired S N A) <-- (readerReach S N) (readerRegionFact N (lit "owner") A _))
((readerOwnerRequired S N A) <-- (readerReach S N) (readerRegionFact N (lit "borrow") A _))
((readerBoundary S N (lit "callback") A) <-- (readerReach S N) (readerRegionFact N (lit "callback") A _))
((readerBoundary S N (lit "dynamic") A) <-- (readerReach S N) (readerRegionFact N (lit "dynamic") A _))
((readerBoundary S N (lit "output") A) <-- (readerReach S N) (readerRegionFact N (lit "output") A _))
((readerBoundary S N (lit "custody") A) <-- (readerReach S N) (readerRegionFact N (lit "custody") A _))
((readerBoundary S N (lit "unresolved") A) <-- (readerReach S N) (readerRegionFact N (lit "unresolved") A _))
((readerMissingGate S G) <-- (scenarioFact S _) (readerGateFact S _ G (lit "false") _ _ _ _ _ _ _ _))
((readerMissingGate S G) <-- (scenarioFact S _) (readerGateFact S _ _ _ G (lit "false") _ _ _ _ _ _))
((readerMissingGate S G) <-- (scenarioFact S _) (readerGateFact S _ _ _ _ _ G (lit "false") _ _ _ _))
((readerMissingGate S G) <-- (scenarioFact S _) (readerGateFact S _ _ _ _ _ _ _ G (lit "false") _ _))
((readerMissingGate S G) <-- (scenarioFact S _) (readerGateFact S _ _ _ _ _ _ _ _ _ G (lit "false")))
((readerAdmissionDenied S (lit "reader-source-open")) <-- (scenarioFact S _) (readerGateFact S (lit "false") _ _ _ _ _ _ _ _ _ _))
((readerAdmissionDenied S G) <-- (readerMissingGate S G))
((readerAdmissionCandidate S) <-- (scenarioFact S _) (readerGateFact S (lit "true") _ (lit "true") _ (lit "true") _ (lit "true") _ (lit "true") _ (lit "true")))
