(relation releaseIssuerFact (key anchor existing mayIssue cannotIssue))
(relation releaseGateFact (scenario key qualified))
(relation releaseSourceFact (scenario qualified))
(relation releaseIssuer (scenario key anchor existing mayIssue cannotIssue))
(relation releaseMissing (scenario gate))
(relation releaseBlocked (scenario reason))
(relation releaseCandidate (scenario))
((releaseIssuer S K A E M C) <-- (scenarioFact S _) (releaseIssuerFact K A E M C))
((releaseMissing S G) <-- (releaseGateFact S G (lit "false")))
((releaseBlocked S G) <-- (releaseMissing S G))
((releaseBlocked S (lit "issuer-source-refinement-open")) <-- (releaseSourceFact S (lit "false")))
((releaseCandidate S) <-- (scenarioFact S _) (releaseSourceFact S (lit "true")) (not (releaseBlocked S _)))
