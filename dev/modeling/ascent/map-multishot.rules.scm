;; Native SysML supplies component uses, methods, scopes and source anchors.
;; A local conditional law never closes the source simulation obligation.
(relation studyFact (claim))
(relation needFact (obligation method artifact scope premise))
(relation useFact (component obligation))
(relation routeFact (component anchors contract))
(relation scenarioFact (scenario))
(relation artifactFact (artifact digest))
(relation receiptFact (scenario obligation method artifact digest scope status))
(relation boundStudy (claim))
(relation modelRequired (scenario component obligation method artifact scope premise))
(relation qualifiedSlice (scenario component obligation method artifact scope))
(relation componentFrontier (scenario component obligation))
(relation componentReady (scenario component))
(relation sourceRoute (component anchors contract))
(relation architectureMissing (scenario obligation))
(relation architectureReady (scenario))
(relation question (claim))
((boundStudy C) <-- (studyFact C) (clue I D C _ _ _)
 (factor I D (lit "target-model-bundle-sha256") H) (binding (lit "target-model-bundle-sha256") H)
 (factor I D (lit "native-output-sha256") N) (binding (lit "native-output-sha256") N)
 (factor I D (lit "planner-dsl-sha256") P) (binding (lit "planner-dsl-sha256") P))
((modelRequired S C O M A T P) <-- (boundStudy _) (scenarioFact S)
 (useFact C O) (needFact O M A T P))
((qualifiedSlice S C O M A T) <-- (modelRequired S C O M A T _)
 (artifactFact A H) (receiptFact S O M A H T (lit "pass")))
((componentFrontier S C O) <-- (modelRequired S C O M A T _)
 (not (qualifiedSlice S C O M A T)))
((componentReady S C) <-- (modelRequired S C _ _ _ _ _) (not (componentFrontier S C _)))
((architectureMissing S O) <-- (componentFrontier S _ O))
((architectureReady S) <-- (boundStudy _) (scenarioFact S) (modelRequired S _ _ _ _ _ _)
 (not (architectureMissing S _)))
((sourceRoute C A T) <-- (boundStudy _) (routeFact C A T))
((question C) <-- (boundStudy C))
