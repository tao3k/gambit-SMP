(ascent-fragment
 (relation sourceNeed ((id string?) (path string?) (hash string?) (needle string?)))
 (relation sourceSeen ((id string?) (path string?) (hash string?) (needle string?)))
 (relation sourceLinked ((id string?)))
 ((sourceLinked I) <-- (sourceNeed I P H N) (sourceSeen I P H N))
 (relation routeNeed ((id string?) (owner string?) (seam string?) (evidence string?) (qpath string?) (action string?) (lpath string?) (lemma string?) (scope string?)))
 (relation routeSeen ((id string?) (owner string?) (seam string?) (evidence string?) (qpath string?) (action string?) (lpath string?) (lemma string?) (scope string?)))
 (relation symbolSeen ((path string?) (symbol string?) (hash string?)))
 (relation symbolNeed ((path string?) (symbol string?) (hash string?)))
 (relation symbolLinked ((path string?) (symbol string?)))
 ((symbolLinked P N) <-- (symbolNeed P N H) (symbolSeen P N H))
 (relation routeLinked ((id string?)))
 ((routeLinked I) <-- (routeNeed I O S E Q A L T C) (routeSeen I O S E Q A L T C) (sourceLinked E) (symbolLinked Q A) (symbolLinked L T))
 (relation gap ((id string?)))
 ((gap I) <-- (sourceNeed I _ _ _) (not (sourceLinked I)))
 ((gap I) <-- (routeNeed I _ _ _ _ _ _ _ _) (not (routeLinked I)))
 (relation sourceRefinementNeed ((id string?) (scope string?)))
 (relation sourceRefinementSeen ((id string?) (scope string?)))
 ((gap I) <-- (sourceRefinementNeed I C) (not (sourceRefinementSeen I C)))
 (relation wholeNeed ((gate string?) (scope string?)))
 (relation wholeSeen ((gate string?) (scope string?)))
 ((gap G) <-- (wholeNeed G C) (not (wholeSeen G C)))
 (relation candidate ((status string?)))
 ((candidate "conditional-input-completeness-only") <-- (not (gap _)))
 (relation scopeNeed ((id string?) (path string?) (lemma string?) (hash string?) (meaning string?)))
 (relation scopeSeen ((id string?) (path string?) (lemma string?) (hash string?) (meaning string?)))
 (relation kernelCheckSeen ((path string?) (hash string?) (toolHash string?) (status string?)))
 (relation kernelCheckNeed ((path string?) (hash string?) (toolHash string?) (status string?)))
 (relation mathematicalClosure ((id string?)))
 ((mathematicalClosure I) <-- (scopeNeed I P T H M) (scopeSeen I P T H M)
   (symbolLinked P T) (kernelCheckNeed P H B "lean-accepted-default")
   (kernelCheckSeen P H B "lean-accepted-default"))
 ((gap I) <-- (scopeNeed I _ _ _ _) (not (mathematicalClosure I)))
 (relation scopeKind ((id string?) (kind string?)))
 (relation abstractClosure ((id string?)))
 (relation conditionalRefinement ((id string?)))
 (relation structuralRefinement ((id string?)))
 ((abstractClosure I) <-- (mathematicalClosure I) (scopeKind I "abstract-total"))
 ((conditionalRefinement I) <-- (mathematicalClosure I) (scopeKind I "conditional-refinement"))
 ((structuralRefinement I) <-- (mathematicalClosure I) (scopeKind I "extracted-structural"))
 (relation cursorFamilyClosure ((id string?)))
 ((cursorFamilyClosure I) <-- (mathematicalClosure I) (scopeKind I "extracted-total"))
  (relation cFacingArithmetic ((id string?)))
  ((cFacingArithmetic I) <-- (mathematicalClosure I) (scopeKind I "c-facing-arithmetic")))
