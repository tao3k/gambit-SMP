;; Publication binds one producing source, existing mode and full output set.
;; It neither supplies runtime protocol proofs nor promotes remote CI status.
(ascent-fragment
 (relation source ((tree string?) (mode string?)))
 (relation observed ((tree string?) (mode string?)))
 (relation requiredPremise ((id string?)))
 (relation sourcePremise ((id string?)))
 (relation requiredCase ((id string?)))
 (relation nativeCase ((id string?) (tree string?) (mode string?)))
 (relation produced ((path string?) (digest string?)))
 (relation selected ((path string?) (digest string?)))
 (relation unchanged ((id string?)))
 (relation requireUnchanged ((id string?)))
 (relation wholeClaim ((id string?)))
 (relation gap ((id string?) (reason string?)))
 (relation ready ((tree string?)))
 ((gap P "missing-source-premise") <-- (requiredPremise P) (not (sourcePremise P)))
 ((gap T "stale-source-or-mode") <-- (source T M) (not (observed T M)))
 ((gap C "missing-consumer-case") <-- (source T M) (requiredCase C) (not (dischargedCase C T M)))
 ((gap P "missing-or-mixed-output") <-- (produced P H) (not (selected P H)))
 ((gap P "unproduced-output") <-- (selected P H) (not (produced P H)))
 ((gap I "changed-official-boundary") <-- (requireUnchanged I) (not (unchanged I)))
 ((gap I "unsupported-whole-acceptance") <-- (wholeClaim I))
 ((ready T) <-- (source T M) (observed T M) (not (gap _ _)))
 ;; Known failures remain failures; this only decides a source-disjoint REV.
 (relation dischargedCase ((id string?) (tree string?) (mode string?)))
 (relation boundaryCase ((id string?)))
 (relation requiredFamily ((family string?)))
 (relation requiredField ((field string?)))
 (relation requiredRole ((role string?)))
 (relation observedFamily ((family string?) (role string?)))
 (relation comparison ((family string?) (field string?) (baseline string?) (candidate string?)))
 (relation equalValue ((left string?) (right string?)))
 (relation equalField ((family string?) (field string?)))
 (relation baselineFailure ((family string?) (signature string?)))
 (relation candidateFailure ((family string?) (signature string?)))
 (relation disjointFamily ((family string?)))
 (relation boundaryPermitted ((tree string?) (mode string?)))
 (relation remainingPassed ((tree string?) (mode string?)))
 (relation boundaryGap ((id string?) (reason string?)))
 (relation boundaryReady ((tree string?) (mode string?)))
 (relation familyBlocked ((family string?) (signature string?)))
 ((equalValue V V) <-- (comparison _ _ V _))
 ((equalValue V V) <-- (comparison _ _ _ V))
 ((boundaryGap K "different-controlled-input") <-- (comparison _ K B C) (not (equalValue B C)))
 ((boundaryGap F "unmodeled-failed-family") <-- (candidateFailure F _) (not (requiredFamily F)))
 ((boundaryGap T "missing-compared-family") <-- (source T _) (boundaryCase _) (not (requiredFamily _)))
 ((equalField F K) <-- (comparison F K V V))
 ((boundaryGap F "missing-complete-observation") <-- (requiredFamily F) (requiredRole R) (not (observedFamily F R)))
 ((boundaryGap K "missing-or-different-controlled-input") <-- (requiredFamily F) (requiredField K) (not (equalField F K)))
 ((boundaryGap F "source-not-proved-disjoint") <-- (requiredFamily F) (not (disjointFamily F)))
 ((boundaryGap S "new-or-unclassified-failure") <-- (candidateFailure F S) (not (baselineFailure F S)))
 ((boundaryGap T "missing-explicit-boundary-policy") <-- (source T P) (boundaryCase _) (not (boundaryPermitted T P)))
 ((boundaryGap T "remaining-original-prerequisites-not-passed") <-- (source T P) (boundaryCase _) (not (remainingPassed T P)))
 ((boundaryReady T P) <-- (source T P) (boundaryCase _) (boundaryPermitted T P) (remainingPassed T P) (not (boundaryGap _ _)))
 ((dischargedCase C T P) <-- (nativeCase C T P))
 ((dischargedCase C T P) <-- (boundaryCase C) (boundaryReady T P))
 ((familyBlocked F S) <-- (candidateFailure F S))
 ((gap I R) <-- (boundaryGap I R))
)
