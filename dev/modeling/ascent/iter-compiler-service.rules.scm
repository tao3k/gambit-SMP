(relation iterDependencyFact (fromKey toKey))
(relation iterDependency (scenario fromKey toKey))
((iterDependency S F T) <-- (scenarioFact S _) (iterDependencyFact F T))
(relation iterRefinementFact (key qntScope leanScope))
(relation iterRefinement (scenario key qntScope leanScope))
((iterRefinement S K Q L) <-- (scenarioFact S _) (iterRefinementFact K Q L))
(relation iterSeamFact (key owner anchor))
(relation iterContextFact (key anchor))
(relation iterGateFact (scenario key qualified))
(relation iterSourceFact (scenario qualified))
(relation iterSeam (scenario key owner anchor))
(relation iterContext (scenario key anchor))
(relation iterMissing (scenario gate))
(relation iterBlocked (scenario reason))
(relation iterCandidate (scenario))
((iterSeam S K O A) <-- (scenarioFact S _) (iterSeamFact K O A))
((iterContext S K A) <-- (scenarioFact S _) (iterContextFact K A))
((iterMissing S G) <-- (iterGateFact S G (lit "false")))
((iterBlocked S G) <-- (iterMissing S G))
((iterBlocked S (lit "source-refinement-open")) <-- (iterSourceFact S (lit "false")))
((iterCandidate S) <-- (scenarioFact S _) (iterSourceFact S (lit "true")) (not (iterBlocked S _)))
