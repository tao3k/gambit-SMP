(relation storageContractFact (key anchor rule))
(relation storageGateFact (scenario key qualified))
(relation storageSourceFact (scenario qualified))
(relation storageDuty (scenario key anchor rule))
(relation storageMissing (scenario gate))
(relation storageBlocked (scenario reason))
(relation storageCandidate (scenario))
((storageDuty S K A R) <-- (scenarioFact S _) (storageContractFact K A R))
((storageMissing S G) <-- (storageGateFact S G (lit "false")))
((storageBlocked S G) <-- (storageMissing S G))
((storageBlocked S (lit "source-refinement-open")) <-- (storageSourceFact S (lit "false")))
((storageCandidate S) <-- (scenarioFact S _) (storageSourceFact S (lit "true")) (not (storageBlocked S _)))
