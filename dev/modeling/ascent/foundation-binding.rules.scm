;; Region classes are target obligations, never deep-freeze certificates.
(relation foundationRegionFact (region ownership anchor contract))
(relation foundationClosedFact (status))
(relation imageCandidate (scenario region anchor))
(relation canonicalDefinition (scenario region anchor))
(relation reconstructionRequired (scenario region anchor))
(relation serializedInstanceRequired (scenario region anchor))
(relation foundationAdmissionBlocked (scenario reason))
((imageCandidate S R A) <-- (boundComponent (lit "build-scheduler") _)
 (scenarioFact S _) (foundationRegionFact R (lit "image") A _))
((canonicalDefinition S R A) <-- (boundComponent (lit "build-scheduler") _)
 (scenarioFact S _) (foundationRegionFact R (lit "canonical") A _))
((reconstructionRequired S R A) <-- (boundComponent (lit "build-scheduler") _)
 (scenarioFact S _) (foundationRegionFact R (lit "session") A _))
((reconstructionRequired S R A) <-- (boundComponent (lit "build-scheduler") _)
 (scenarioFact S _) (foundationRegionFact R (lit "split") A _))
((serializedInstanceRequired S R A) <-- (boundComponent (lit "build-scheduler") _)
 (scenarioFact S _) (foundationRegionFact R (lit "effect-domain") A _))
((foundationAdmissionBlocked S (lit "foundation-source-open")) <--
 (boundComponent (lit "build-scheduler") _) (scenarioFact S _) (foundationClosedFact (lit "false")))
