(ascent-fragment
 (relation scenario ((id string?)))
 (relation need ((id string?) (kind string?) (path string?) (hash string?) (scope string?)))
 (relation method ((kind string?) (tool string?)))
 (relation receipt ((scenario string?) (id string?) (path string?) (hash string?) (scope string?)))
 (relation route ((scenario string?) (need string?) (tool string?) (path string?) (scope string?)))
 (relation checked ((scenario string?) (id string?)))
 (relation blocked ((scenario string?) (reason string?)))
 (relation candidate ((scenario string?)))
 ((route S N T P C) <-- (scenario S) (need N K P _ C) (method K T))
 ((checked S N) <-- (scenario S) (need N _ P H C) (receipt S N P H C))
 ((blocked S N) <-- (scenario S) (need N _ _ _ _) (not (checked S N)))
 (relation gate ((scenario string?) (key string?) (closed string?)))
 ((blocked S K) <-- (gate S K (lit "false")))
 (relation ownerneed ((id string?) (path string?)))
 (relation ownerbinding ((id string?) (path string?)))
 (relation ownerok ((id string?)))
 ((ownerok I) <-- (ownerneed I P) (ownerbinding I P))
 ((blocked S I) <-- (scenario S) (ownerneed I _) (not (ownerok I)))
 (relation contractneed ((key string?) (interface string?) (producer string?) (consumer string?) (action string?) (guard string?) (lemma string?) (source string?) (hash string?) (needle string?)))
 (relation contractbinding ((key string?) (interface string?) (producer string?) (consumer string?) (action string?) (guard string?) (lemma string?) (source string?) (hash string?) (needle string?)))
 (relation modelstep ((action string?) (guard string?) (lemma string?)))
 (relation sourcewitness ((source string?) (hash string?) (needle string?)))
 (relation contractok ((key string?)))
 ((contractok K) <-- (contractneed K I P C A G L F H N) (contractbinding K I P C A G L F H N) (modelstep A G L) (sourcewitness F H N) (ownerok P) (ownerok C))
 ((blocked S K) <-- (scenario S) (contractneed K _ _ _ _ _ _ _ _ _) (not (contractok K)))
 (relation paperneed ((key string?) (paper string?) (section string?)))
 (relation paperbinding ((key string?) (paper string?) (section string?)))
 (relation paperok ((key string?)))
 ((paperok K) <-- (paperneed K P C) (paperbinding K P C))
 ((blocked S K) <-- (scenario S) (paperneed K _ _) (not (paperok K)))
 (relation useneed ((advantage string?) (contract string?) (obligation string?)))
 (relation usebinding ((advantage string?) (contract string?) (obligation string?)))
 (relation useok ((advantage string?) (contract string?)))
 ((useok A C) <-- (useneed A C N) (usebinding A C N) (paperok A) (contractok C) (need N (lit "source-refinement") _ _ _))
 ((blocked S A) <-- (scenario S) (useneed A C _) (not (useok A C)))
 (relation wholeneed ((id string?) (path string?) (hash string?) (scope string?)))
 (relation wholereceipt ((scenario string?) (id string?) (path string?) (hash string?) (scope string?)))
 (relation wholeok ((scenario string?) (id string?)))
 ((wholeok S N) <-- (scenario S) (wholeneed N P H C) (wholereceipt S N P H C))
 ((blocked S N) <-- (scenario S) (wholeneed N _ _ _) (not (wholeok S N)))
 ((candidate S) <-- (scenario S) (not (blocked S _)))
)
