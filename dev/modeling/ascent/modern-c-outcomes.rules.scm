;; Integration results, review units and independent whole-runtime families.
;; Observations must be bound/validated by the caller; leaf/support REVs cannot
;; manufacture either integration evidence or complete native family evidence.
(ascent-fragment
 (relation source ((tree string?) (profile string?)))
 (relation result ((id string?)))
 (relation needs ((result string?) (evidence string?)))
 (relation observed ((evidence string?) (tree string?) (profile string?)))
 ;; SysML component cases refine an integration need. A bootstrap or a broad
 ;; receipt cannot hide a missing writer, borrow, exit or native counterexample.
 (relation caseNeed ((result string?) (id string?)))
 (relation caseObserved ((id string?) (tree string?) (profile string?)))
 (relation dependency ((before string?) (next string?)))
 (relation reachable ((before string?) (next string?)))
 (relation hasNeed ((result string?)))
 (relation missing ((result string?) (evidence string?)))
 (relation directComplete ((result string?) (tree string?) (profile string?)))
 (relation prerequisiteMissing ((result string?) (prior string?)))
 (relation resultClosed ((id string?) (tree string?) (profile string?)))
 (relation path ((name string?)))
 (relation unit ((id string?)))
 (relation owns ((path string?) (unit string?)))
 (relation route ((unit string?) (target string?)))
 (relation support ((id string?)))
 (relation different ((left string?) (right string?)))
 (relation generated ((unit string?)))
 (relation submitAlone ((unit string?)))
 (relation leafRevision ((id string?) (tree string?) (profile string?)))
 (relation planGap ((id string?) (reason string?)))
 (relation planChecked ((tree string?) (profile string?)))
 (relation family ((id string?)))
 (relation familyObserved ((id string?) (tree string?) (profile string?)))
 (relation familyFailure ((id string?) (signature string?)))
 (relation familyClosed ((id string?) (tree string?) (profile string?)))
 (relation impact ((result string?) (family string?)))
 ((reachable A B) <-- (dependency A B))
 ((reachable A C) <-- (reachable A B) (dependency B C))
 ((hasNeed R) <-- (needs R _))
 ((missing R N) <-- (source T P) (result R) (needs R N) (not (observed N T P)))
 ((missing R C) <-- (source T P) (result R) (caseNeed R C) (not (caseObserved C T P)))
 ((directComplete R T P) <-- (source T P) (result R) (hasNeed R) (not (missing R _)))
 ((prerequisiteMissing R Prior) <-- (source T P) (reachable Prior R) (not (directComplete Prior T P)))
 ((resultClosed R T P) <-- (directComplete R T P) (not (prerequisiteMissing R _)) (not (planGap _ _)))
 ((planGap R "missing-result-contract") <-- (result R) (not (hasNeed R)))
 ((planGap R "unknown-result") <-- (needs R _) (not (result R)))
 ((planGap R "unknown-dependency") <-- (dependency R _) (not (result R)))
 ((planGap R "unknown-dependency") <-- (dependency _ R) (not (result R)))
 ((planGap R "dependency-cycle") <-- (reachable R R))
 ((planGap P "unowned-path") <-- (path P) (not (owns P _)))
 ((planGap P "duplicate-primary-owner") <-- (owns P A) (owns P B) (different A B))
 ((planGap P "unknown-path") <-- (owns P _) (not (path P)))
 ((planGap U "unknown-unit") <-- (owns _ U) (not (unit U)))
 ((planGap U "missing-result-route") <-- (unit U) (not (route U _)))
 ((planGap U "duplicate-result-route") <-- (route U A) (route U B) (different A B))
 ((planGap U "unknown-result-route") <-- (route U R) (not (result R)) (not (support R)))
 ((planGap U "unqualified-generated-submission") <-- (generated U) (submitAlone U))
 ((planChecked T P) <-- (source T P) (not (planGap _ _)))
 ;; Deliberately no resultClosed/leafRevision/impact -> familyClosed rule.
 ((familyClosed F T P) <-- (source T P) (family F) (familyObserved F T P) (not (familyFailure F _)))
)
