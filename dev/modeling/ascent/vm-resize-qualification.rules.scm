;; SysML owns needs and routes. Evidence class is a required join, not a label
;; interpreted after a pass. A route token check is not a C simulation proof.
(relation resizeStudyFact (claim))
(relation resizeSourceFact (source profile))
(relation resizeCandidateFact (scenario source profile))
(relation resizeNeedFact (component obligation method artifact digest scope class check))
(relation resizeScenarioClassFact (scenario mode))
(relation resizeEvidenceFact (evidence digest mode class))
(relation resizeObservedFact (scenario source profile obligation method artifact digest scope class check status evidence evidenceDigest))
(relation resizeRouteFact (step token kind))
(relation resizeTokenFact (token kind))
(relation resizeBound (claim))
((resizeBound C) <-- (resizeStudyFact C) (clue I D C _ _ _)
 (factor I D (lit "target-model-bundle-sha256") B) (binding (lit "target-model-bundle-sha256") B)
 (factor I D (lit "native-output-sha256") N) (binding (lit "native-output-sha256") N)
 (factor I D (lit "planner-dsl-sha256") P) (binding (lit "planner-dsl-sha256") P))
(relation resizeRequired (scenario component obligation))
((resizeRequired S C O) <-- (resizeBound _) (resizeCandidateFact S _ _) (resizeNeedFact C O _ _ _ _ _ _))
(relation resizeChecked (scenario component obligation))
((resizeChecked S C O) <-- (resizeRequired S C O)
 (resizeSourceFact L P) (resizeCandidateFact S L P)
 (resizeNeedFact C O M A H T K Q)
 (resizeObservedFact S L P O M A H T K Q (lit "pass") E EH)
 (resizeScenarioClassFact S Mode) (resizeEvidenceFact E EH Mode K))
(relation resizeMissing (scenario component obligation))
((resizeMissing S C O) <-- (resizeRequired S C O) (not (resizeChecked S C O)))
(relation resizeFailed (scenario component obligation))
((resizeFailed S C O) <-- (resizeRequired S C O)
 (resizeSourceFact L P) (resizeCandidateFact S L P)
 (resizeNeedFact C O M A H T K Q)
 (resizeObservedFact S L P O M A H T K Q (lit "fail") E EH)
 (resizeScenarioClassFact S Mode) (resizeEvidenceFact E EH Mode K))
(relation resizeRouteMissing (step token kind))
((resizeRouteMissing S T K) <-- (resizeBound _) (resizeRouteFact S T K) (not (resizeTokenFact T K)))
(relation resizeDependencyFact (dependent prerequisite))
(relation resizeDepends (dependent prerequisite))
((resizeDepends C P) <-- (resizeDependencyFact C P))
((resizeDepends C P) <-- (resizeDepends C Q) (resizeDependencyFact Q P))
(relation resizeDependencyGap (scenario dependent prerequisite))
((resizeDependencyGap S C P) <-- (resizeRequired S C _) (resizeDepends C P) (resizeMissing S P _))
(relation resizeDependencyCycle (component))
((resizeDependencyCycle C) <-- (resizeDepends C C))
(relation resizeComponentReady (scenario component))
((resizeComponentReady S C) <-- (resizeRequired S C _) (not (resizeMissing S C _))
 (not (resizeDependencyGap S C _)) (not (resizeDependencyCycle C)) (not (resizeRouteMissing _ _ _)))
(relation resizeAllReady (scenario))
((resizeAllReady S) <-- (resizeBound _) (resizeCandidateFact S _ _) (not (resizeMissing S _ _))
 (not (resizeDependencyCycle _)) (not (resizeRouteMissing _ _ _)))
(relation resizeQuestionFact (id source condition counterexample))
(relation resizeQuestion (id source condition counterexample))
((resizeQuestion I S C X) <-- (resizeBound _) (resizeQuestionFact I S C X))
(relation question (claim))
((question C) <-- (resizeBound C))
