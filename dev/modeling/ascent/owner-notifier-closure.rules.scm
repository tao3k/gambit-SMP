(relation notifierHolderFact (key anchor actualEdge requiredChange))
(relation notifierGateFact (scenario key qualified))
(relation notifierSourceFact (scenario qualified))
(relation notifierHolder (scenario key anchor actualEdge requiredChange))
(relation notifierMissing (scenario gate))
(relation notifierBlocked (scenario reason))
(relation notifierCandidate (scenario))
((notifierHolder S K A E C) <-- (scenarioFact S _) (notifierHolderFact K A E C))
((notifierMissing S G) <-- (notifierGateFact S G (lit "false")))
((notifierBlocked S G) <-- (notifierMissing S G))
((notifierBlocked S (lit "notifier-source-refinement-open")) <-- (notifierSourceFact S (lit "false")))
((notifierCandidate S) <-- (scenarioFact S _) (notifierSourceFact S (lit "true")) (not (notifierBlocked S _)))
