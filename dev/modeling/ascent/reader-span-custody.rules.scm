;; The route and retirement premises are native SysML data; not Python decisions.
(relation spanProducerFact (key anchor custodian))
(relation spanReaderFact (key bodyCatch consumer))
(relation spanGateFact (scenario key qualified))
(relation spanSourceFact (scenario qualified))
(relation spanCustody (scenario producer anchor custodian))
(relation spanExceptionRoute (scenario reader route consumer))
(relation spanMissing (scenario gate))
(relation spanBlocked (scenario reason))
(relation spanCandidate (scenario))
((spanCustody S P A C) <-- (scenarioFact S _) (spanProducerFact P A C))
((spanExceptionRoute S R (lit "body-parseerror-only") C) <-- (scenarioFact S _) (spanReaderFact R (lit "true") C))
((spanExceptionRoute S R (lit "outside-body-catch") C) <-- (scenarioFact S _) (spanReaderFact R (lit "false") C))
((spanMissing S G) <-- (spanGateFact S G (lit "false")))
((spanBlocked S G) <-- (spanMissing S G))
((spanBlocked S (lit "source-refinement-open")) <-- (spanSourceFact S (lit "false")))
((spanCandidate S) <-- (scenarioFact S _) (spanSourceFact S (lit "true")) (not (spanBlocked S _)))
