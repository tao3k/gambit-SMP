(ascent-fragment
 (relation scenario ((id string?)))
 (relation need ((id string?) (kind string?) (path string?) (digest string?) (scope string?)))
 (relation receipt ((scenario string?) (id string?) (path string?) (digest string?) (scope string?)))
 (relation checked ((scenario string?) (id string?)))
 (relation blocked ((scenario string?) (reason string?)))
 (relation candidate ((scenario string?)))
 ((checked S N) <-- (scenario S) (need N _ P H C) (receipt S N P H C))
 ((blocked S N) <-- (scenario S) (need N _ _ _ _) (not (checked S N)))
 (relation binding ((action string?) (lemma string?)))
 (relation actionName ((action string?)))
 (relation lemmaName ((lemma string?)))
 (relation linked ((action string?)))
 ((linked A) <-- (binding A L) (actionName A) (lemmaName L))
 ((blocked S A) <-- (scenario S) (binding A _) (not (linked A)))
 (relation witness ((id string?) (path string?) (digest string?) (needle string?)))
 (relation observation ((id string?) (path string?) (digest string?) (needle string?)))
 (relation observed ((id string?)))
 ((observed I) <-- (witness I P H N) (observation I P H N))
 ((blocked S I) <-- (scenario S) (witness I _ _ _) (not (observed I)))
 (relation compositionNeed ((key string?) (lemma string?)))
 (relation compositionLinked ((key string?)))
 ((compositionLinked K) <-- (compositionNeed K L) (lemmaName L))
 ((blocked S K) <-- (scenario S) (compositionNeed K _) (not (compositionLinked K)))
 ((candidate S) <-- (scenario S) (not (blocked S _)))
 (relation targetActionName ((target string?)))
 (relation refinementNeed ((action string?) (target string?) (lemma string?)))
 (relation refinementLinked ((action string?)))
 ((refinementLinked A) <-- (refinementNeed A T L) (actionName A) (targetActionName T) (lemmaName L))
 ((blocked S A) <-- (scenario S) (refinementNeed A _ _) (not (refinementLinked A)))

 (relation bridgeNeed ((key string?) (path string?) (digest string?) (lemma string?)))
 (relation bridgeObservation ((key string?) (path string?) (digest string?) (lemma string?)))
 (relation bridgeLinked ((key string?)))
 ((bridgeLinked K) <-- (bridgeNeed K P H L) (bridgeObservation K P H L) (lemmaName L))
 ((blocked S K) <-- (scenario S) (bridgeNeed K _ _ _) (not (bridgeLinked K)))
 (relation inventoryNeed ((key string?) (path string?) (count string?) (digest string?) (scope string?)))
 (relation inventoryObservation ((key string?) (path string?) (count string?) (digest string?) (scope string?)))
 (relation inventoryLinked ((key string?)))
 ((inventoryLinked K) <-- (inventoryNeed K P N H C) (inventoryObservation K P N H C))
 ((blocked S K) <-- (scenario S) (inventoryNeed K _ _ _ _) (not (inventoryLinked K)))

 (relation seamNeed ((producer string?) (consumer string?) (contract string?) (action string?) (lemma string?)))
 (relation seamObservation ((producer string?) (consumer string?) (contract string?) (action string?) (lemma string?)))
 (relation seamLinked ((contract string?)))
 ((seamLinked K) <-- (seamNeed P C K A L) (seamObservation P C K A L) (actionName A) (lemmaName L))
 ((blocked S K) <-- (scenario S) (seamNeed _ _ K _ _) (not (seamLinked K)))
)
