;; Premise coverage and native evidence routing, not a second state machine.
(relation aliasIdentity (source profile))
(relation aliasClause (id obligation digest))
(relation aliasWitness (id file digest))
(relation aliasUse (clause witness))
(relation aliasLocated (id))
((aliasLocated C) <-- (aliasClause C _ _) (aliasUse C W) (aliasWitness W _ _))
(relation aliasPremiseEvidence (id owner source contract outcome))
(relation aliasSuccessful (outcome) (("pass")))
(relation aliasPremiseRejected (id))
((aliasPremiseRejected C) <-- (aliasClause C _ H) (aliasIdentity S _)
 (aliasPremiseEvidence C "source" S H O) (not (aliasSuccessful O)))
(relation aliasPremiseSupplied (id))
((aliasPremiseSupplied C) <-- (aliasClause C _ H) (aliasIdentity S _)
 (aliasPremiseEvidence C "source" S H "pass") (not (aliasPremiseRejected C)))
(relation aliasPremiseMissing (id obligation))
((aliasPremiseMissing C O) <-- (aliasClause C O _) (not (aliasPremiseSupplied C)))
(relation aliasCriterion (id obligation digest))
(relation aliasNativeEvidence (id owner source profile contract outcome))
(relation aliasNativeRejected (id))
((aliasNativeRejected C) <-- (aliasCriterion C _ H) (aliasIdentity S P)
 (aliasNativeEvidence C "native" S P H O) (not (aliasSuccessful O)))
(relation aliasNativeSupplied (id))
((aliasNativeSupplied C) <-- (aliasCriterion C _ H) (aliasIdentity S P)
 (aliasNativeEvidence C "native" S P H "pass") (not (aliasNativeRejected C)))
(relation aliasNativeMissing (id))
((aliasNativeMissing C) <-- (aliasCriterion C _ _) (not (aliasNativeSupplied C)))
(relation aliasCandidate (id))
(relation aliasLocalPremises (id))
((aliasLocalPremises C) <-- (aliasCandidate C) (not (aliasPremiseMissing _ _)))
(relation aliasLocalSmpEvidence (id))
((aliasLocalSmpEvidence C) <-- (aliasLocalPremises C) (not (aliasNativeMissing _)))
;; Local records never manufacture the six original source/native obligations.
;; Existing exclusive ownership rules and all five full-cut gates must close.
(relation aliasGate (id))
(relation aliasGateEvidence (id source profile outcome))
(relation aliasGateMissing (id))
((aliasGateMissing G) <-- (aliasGate G) (aliasIdentity S P)
 (not (aliasGateEvidence G S P "pass")))
(relation aliasModernSmpReady (id))
((aliasModernSmpReady C) <-- (aliasCandidate C) (aliasLocalSmpEvidence C)
 (verificationReady C) (not (aliasGateMissing _)))
