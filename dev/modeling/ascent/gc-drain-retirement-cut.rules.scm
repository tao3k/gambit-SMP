(relation drainPointFact (key anchor descriptor actualEdge requiredChange))
(relation drainGateFact (scenario key qualified))
(relation drainSourceFact (scenario qualified))
(relation drainPoint (scenario key anchor descriptor actualEdge requiredChange))
(relation drainMissing (scenario gate))
(relation drainBlocked (scenario reason))
(relation drainCandidate (scenario))
((drainPoint S K A D E C) <-- (scenarioFact S _) (drainPointFact K A D E C))
((drainMissing S G) <-- (drainGateFact S G (lit "false")))
((drainBlocked S G) <-- (drainMissing S G))
((drainBlocked S (lit "generated-cut-source-open")) <-- (drainSourceFact S (lit "false")))
((drainCandidate S) <-- (scenarioFact S _) (drainSourceFact S (lit "true")) (not (drainBlocked S _)))
