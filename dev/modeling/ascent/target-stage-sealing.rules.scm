(relation targetWriterFact (key anchor))
(relation targetRefinementFact (key qntScope leanScope))
(relation targetGateFact (scenario key qualified))
(relation targetSourceFact (scenario qualified))
(relation targetWriter (scenario key anchor))
(relation targetRefinement (scenario key qntScope leanScope))
(relation targetMissing (scenario gate))
(relation targetBlocked (scenario reason))
(relation targetCandidate (scenario))
((targetWriter S K A) <-- (scenarioFact S _) (targetWriterFact K A))
((targetRefinement S K Q L) <-- (scenarioFact S _) (targetRefinementFact K Q L))
((targetMissing S G) <-- (targetGateFact S G (lit "false")))
((targetBlocked S G) <-- (targetMissing S G))
((targetBlocked S (lit "source-refinement-open")) <-- (targetSourceFact S (lit "false")))
((targetCandidate S) <-- (scenarioFact S _) (targetSourceFact S (lit "true")) (not (targetBlocked S _)))
