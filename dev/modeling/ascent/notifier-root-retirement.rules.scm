(relation retirementRootFact (key anchor actualEdge requiredChange))
(relation retirementGateFact (scenario key qualified))
(relation retirementSourceFact (scenario qualified))
(relation retirementRoot (scenario key anchor actualEdge requiredChange))
(relation retirementMissing (scenario gate))
(relation retirementBlocked (scenario reason))
(relation retirementCandidate (scenario))
((retirementRoot S K A E C) <-- (scenarioFact S _) (retirementRootFact K A E C))
((retirementMissing S G) <-- (retirementGateFact S G (lit "false")))
((retirementBlocked S G) <-- (retirementMissing S G))
((retirementBlocked S (lit "root-retirement-source-open")) <-- (retirementSourceFact S (lit "false")))
((retirementCandidate S) <-- (scenarioFact S _) (retirementSourceFact S (lit "true")) (not (retirementBlocked S _)))
