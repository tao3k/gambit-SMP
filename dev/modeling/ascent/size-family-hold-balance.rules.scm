(ascent-fragment
 (relation scenario ((id string?)))
 (relation need ((id string?) (status string?) (condition string?)))
 (relation receipt ((scenario string?) (id string?) (status string?) (condition string?)))
 (relation checked ((scenario string?) (id string?)))
 (relation blocked ((scenario string?) (reason string?)))
 (relation candidate ((scenario string?)))
 ((checked S I) <-- (scenario S) (need I T C) (receipt S I T C))
 ((blocked S I) <-- (scenario S) (need I _ _) (not (checked S I)))
 (relation sourceNeed ((id string?) (path string?) (hash string?) (needle string?)))
 (relation sourceObservation ((id string?) (path string?) (hash string?) (needle string?)))
 (relation sourceLinked ((id string?)))
 ((sourceLinked I) <-- (sourceNeed I P H N) (sourceObservation I P H N))
 ((blocked S I) <-- (scenario S) (sourceNeed I _ _ _) (not (sourceLinked I)))
 (relation actionName ((name string?)))
 (relation lemmaName ((name string?)))
 (relation routeNeed ((component string?) (action string?) (lemma string?) (source string?) (obligation string?)))
 (relation routeObservation ((component string?) (action string?) (lemma string?) (source string?) (obligation string?)))
 (relation routeLinked ((component string?) (action string?)))
 ((routeLinked C A) <-- (routeNeed C A L P N) (routeObservation C A L P N) (actionName A) (lemmaName L) (sourceLinked P) (need N _ _))
 ((blocked S A) <-- (scenario S) (routeNeed C A _ _ _) (not (routeLinked C A)))
 (relation profileNeed ((id string?) (width string?) (min string?) (max string?) (status string?)))
 (relation profileObservation ((id string?) (width string?) (min string?) (max string?) (status string?)))
 (relation profileLinked ((id string?)))
 ((profileLinked I) <-- (profileNeed I W L U S) (profileObservation I W L U S))
 ((blocked S I) <-- (scenario S) (profileNeed I _ _ _ _) (not (profileLinked I)))
 (relation inventoryNeed ((family string?) (direction string?) (effect string?) (release string?)))
 (relation inventoryObservation ((family string?) (direction string?) (effect string?) (release string?)))
 (relation inventoryLinked ((family string?) (direction string?)))
 ((inventoryLinked F D) <-- (inventoryNeed F D E R) (inventoryObservation F D E R))
 ((blocked S F) <-- (scenario S) (inventoryNeed F D _ _) (not (inventoryLinked F D)))
 (relation groundingNeed ((component string?) (source string?) (paper string?) (obligation string?)))
 (relation groundingLinked ((component string?) (source string?) (paper string?)))
 ((groundingLinked C P K) <-- (groundingNeed C P K N) (sourceLinked P) (sourceLinked K) (routeLinked C _) (need N _ _))
 ((blocked S P) <-- (scenario S) (groundingNeed C P K _) (not (groundingLinked C P K)))
 ((candidate S) <-- (scenario S) (not (blocked S _))))
