;; Native inert ASCENT fragment for one receipt-bound observation stream.
;; Neither a checked cut nor a repair target admits Family A or execution.
(ascent-fragment
(relation rest_required ((case symbol?) (image symbol?) (spelling symbol?) (obligation symbol?)))
(relation rest_check ((case symbol?) (image symbol?) (spelling symbol?) (obligation symbol?) (status string?) (reference symbol?)))
(relation rest_route ((obligation symbol?) (source symbol?) (action symbol?)))
(relation rest_violation ((case symbol?) (image symbol?) (spelling symbol?) (obligation symbol?) (reference symbol?)))
(relation rest_missing ((case symbol?) (image symbol?) (spelling symbol?) (obligation symbol?)))
(relation rest_supported ((case symbol?) (image symbol?) (spelling symbol?) (obligation symbol?)))
(relation rest_incomplete ((case symbol?) (image symbol?) (spelling symbol?)))
(relation rest_observed_cut ((case symbol?) (image symbol?) (spelling symbol?)))
(relation rest_repair_target ((case symbol?) (image symbol?) (spelling symbol?) (obligation symbol?) (source symbol?) (action symbol?)))
((rest_violation C I S O R) <-- (rest_required C I S O)
 (rest_check C I S O (lit "fail") R))
((rest_supported C I S O) <-- (rest_required C I S O)
 (rest_check C I S O (lit "pass") _)
 (not (rest_violation C I S O _)))
((rest_missing C I S O) <-- (rest_required C I S O)
 (not (rest_check C I S O _ _)))
((rest_incomplete C I S) <-- (rest_missing C I S _))
((rest_incomplete C I S) <-- (rest_violation C I S _ _))
((rest_observed_cut C I S) <-- (rest_required C I S _)
 (not (rest_incomplete C I S)))
((rest_repair_target C I S O P A) <-- (rest_violation C I S O _)
 (rest_route O P A))
((rest_repair_target C I S O P A) <-- (rest_missing C I S O)
 (rest_route O P A))
)
