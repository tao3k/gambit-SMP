(ascent-fragment
 (relation scenario ((id string?)))
 (relation need ((id string?) (kind string?) (path string?) (digest string?) (scope string?)))
 (relation needOwner ((id string?) (component string?)))
 (relation receipt ((scenario string?) (id string?) (path string?) (digest string?) (scope string?)))
 (relation checked ((scenario string?) (id string?)))
 (relation blocked ((scenario string?) (reason string?)))
 (relation candidate ((scenario string?)))
 ((checked S N) <-- (scenario S) (need N _ P H C) (receipt S N P H C))
 ((blocked S N) <-- (scenario S) (need N _ _ _ _) (not (checked S N)))
 (relation binding ((action string?) (lemma string?)))
 (relation actionName ((action string?)))
 (relation lemmaName ((lemma string?)))
 (relation linked ((action string?)))
 ((linked A) <-- (binding A L) (actionName A) (lemmaName L))
 ((blocked S A) <-- (scenario S) (binding A _) (not (linked A)))
 (relation sourceNeed ((id string?) (path string?) (digest string?) (needle string?)))
 (relation sourceObservation ((id string?) (path string?) (digest string?) (needle string?)))
 (relation sourceLinked ((id string?)))
 ((sourceLinked I) <-- (sourceNeed I P H N) (sourceObservation I P H N))
 ((blocked S I) <-- (scenario S) (sourceNeed I _ _ _) (not (sourceLinked I)))
 (relation routeNeed ((component string?) (action string?) (lemma string?) (producer string?) (obligation string?)))
 (relation routeObservation ((component string?) (action string?) (lemma string?) (producer string?) (obligation string?)))
 (relation routeLinked ((component string?) (action string?)))
 ((routeLinked C A) <-- (routeNeed C A L P N) (routeObservation C A L P N)
    (needOwner N C) (linked A) (lemmaName L) (sourceLinked P))
 ((blocked S A) <-- (scenario S) (routeNeed C A _ _ _) (not (routeLinked C A)))
 (relation proofNeed ((id string?) (lemma string?)))
 (relation proofLinked ((id string?)))
 ((proofLinked I) <-- (proofNeed I L) (lemmaName L))
 ((blocked S I) <-- (scenario S) (proofNeed I _) (not (proofLinked I)))
 (relation creatorNeed ((key string?) (producer string?) (captures string?) (writes string?) (reachability string?) (retirement string?)))
 (relation creatorObservation ((key string?) (producer string?) (captures string?) (writes string?) (reachability string?) (retirement string?)))
 (relation creatorLinked ((key string?)))
 ((creatorLinked K) <-- (creatorNeed K P C W R T) (creatorObservation K P C W R T))
 ((blocked S K) <-- (scenario S) (creatorNeed K _ _ _ _ _) (not (creatorLinked K)))
 ((candidate S) <-- (scenario S) (not (blocked S _)))
)
