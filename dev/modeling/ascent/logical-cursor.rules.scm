;; Python transports native SysML values; these rules own inference, not Python.
(relation logicalFacetFact (key semantic anchor))
(relation logicalGateFact (scenario key qualified))
(relation logicalSourceFact (scenario qualified))
(relation logicalFacet (scenario key semantic anchor))
(relation logicalMissing (scenario key))
(relation logicalRepair (scenario key))
(relation logicalBlocked (scenario reason))
(relation logicalCandidate (scenario))
((logicalFacet S K M A) <-- (scenarioFact S _) (logicalFacetFact K M A))
((logicalRepair S K) <-- (logicalFacet S K (lit "explicit-repair") _))
((logicalMissing S K) <-- (logicalGateFact S K (lit "false")))
((logicalBlocked S K) <-- (logicalMissing S K))
((logicalBlocked S (lit "source-refinement-open")) <-- (logicalSourceFact S (lit "false")))
((logicalCandidate S) <-- (logicalSourceFact S (lit "true")) (scenarioFact S _) (not (logicalBlocked S _)))
