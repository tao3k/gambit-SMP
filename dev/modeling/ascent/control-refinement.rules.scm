;; These are evidence admission rules, not another continuation protocol.
;; Source observations locate code. Only reviewed source-refinement evidence
;; can satisfy a source obligation; native cases belong to CS-NATIVE alone.
(relation controlRoute (route obligation owner))
(relation controlWitness (route witness file digest first last))
(relation controlMapped (route))
((controlMapped R) <-- (controlRoute R _ _) (controlWitness R _ _ _ _ _))
(relation controlSourceClosed (route))
((controlSourceClosed R) <-- (controlRoute R I "source") (verificationChecked I))
(relation controlIdentity (source profile target))
(relation controlCase (id target digest))
(relation controlCaseResult (id source profile digest outcome))
(relation controlCaseRequired (id digest))
((controlCaseRequired I H) <-- (controlIdentity _ _ T) (controlCase I T H))
(relation controlCasePassed (id))
((controlCasePassed I) <-- (controlCaseRequired I H) (controlIdentity S P _)
 (controlCaseResult I S P H "pass"))
(relation controlCaseMissing (id))
((controlCaseMissing I) <-- (controlCaseRequired I _) (not (controlCasePassed I)))
;; The native obligation cannot be injected as an unqualified endpoint receipt.
((verificationObservation I "native" A H S) <--
 (verificationObligation I _ "native" A H S) (controlCaseRequired _ _)
 (not (controlCaseMissing _)))
(relation controlOpen (route obligation))
((controlOpen R I) <-- (controlRoute R I _) (verificationMissing I _))
(relation controlGate (id requirement))
(relation controlGateEvidence (id source profile outcome))
(relation controlGatePassed (id))
((controlGatePassed G) <-- (controlGate G _) (controlIdentity S P _)
 (controlGateEvidence G S P "pass"))
(relation controlGateMissing (id))
((controlGateMissing G) <-- (controlGate G _) (not (controlGatePassed G)))
(relation controlCommitCandidate (id))
((controlCommitCandidate C) <-- (verificationReady C)
 (not (controlCaseMissing _)) (not (controlGateMissing _)))
