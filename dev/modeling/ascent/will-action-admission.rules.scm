(relation actionPointFact (key anchor rootDuty deadMask condition))
(relation actionCohortFact (key anchor observation limit))
(relation actionGateFact (scenario key qualified))
(relation actionSourceFact (scenario qualified))
(relation actionPoint (scenario key anchor rootDuty deadMask condition))
(relation actionCohort (scenario key anchor observation limit))
(relation actionMissing (scenario gate))
(relation actionBlocked (scenario reason))
(relation actionCandidate (scenario))
((actionPoint S K A R M C) <-- (scenarioFact S _) (actionPointFact K A R M C))
((actionCohort S K A O L) <-- (scenarioFact S _) (actionCohortFact K A O L))
((actionMissing S G) <-- (actionGateFact S G (lit "false")))
((actionBlocked S G) <-- (actionMissing S G))
((actionBlocked S (lit "will-action-source-open")) <-- (actionSourceFact S (lit "false")))
((actionCandidate S) <-- (scenarioFact S _) (actionSourceFact S (lit "true")) (not (actionBlocked S _)))
