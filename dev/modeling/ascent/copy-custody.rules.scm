;; SysML supplies contracts, handoffs and artifact routes. This policy does
;; not promote structural tokens, conditional laws or debugger traces to C proof.
(relation copyStudyFact (claim))
(relation copyIdentityFact (source profile))
(relation copyCandidateFact (scenario source profile))
(relation copyNeedFact (component method artifact digest scope class))
(relation copyRouteFact (component method token))
(relation copyTokenFact (method token))
(relation copyAnchorEvidence (source profile evidence))
(relation copyObservedFact (scenario source profile component method artifact digest scope class evidence status))
(relation copyBound (claim))
((copyBound C) <-- (copyStudyFact C) (clue I D C _ _ _)
 (factor I D (lit "target-model-bundle-sha256") B) (binding (lit "target-model-bundle-sha256") B)
 (factor I D (lit "native-output-sha256") N) (binding (lit "native-output-sha256") N)
 (factor I D (lit "planner-dsl-sha256") P) (binding (lit "planner-dsl-sha256") P))
(relation copyRequired (scenario component method))
((copyRequired S C M) <-- (copyBound _) (copyCandidateFact S _ _) (copyNeedFact C M _ _ _ _))
(relation copyRouteMissing (component method token))
((copyRouteMissing C M T) <-- (copyBound _) (copyRouteFact C M T) (not (copyTokenFact M T)))
(relation copyChecked (scenario component method))
((copyChecked S C M) <-- (copyRequired S C M)
 (copyIdentityFact L P) (copyCandidateFact S L P) (copyNeedFact C M A H T K)
 (copyAnchorEvidence L P _)
 (copyObservedFact S L P C M A H T K _ (lit "pass")) (not (copyRouteMissing C M _)))
(relation copyMissing (scenario component method))
((copyMissing S C M) <-- (copyRequired S C M) (not (copyChecked S C M)))
(relation copyEdgeFact (dependent prerequisite))
(relation copyOpenFact (component obligation))
(relation copyOpenQuestion (scenario component obligation))
((copyOpenQuestion S C O) <-- (copyRequired S C _) (copyOpenFact C O))
(relation copyDepends (dependent prerequisite))
((copyDepends C P) <-- (copyEdgeFact C P))
((copyDepends C P) <-- (copyDepends C Q) (copyEdgeFact Q P))
(relation copyDependencyGap (scenario dependent prerequisite))
((copyDependencyGap S C P) <-- (copyRequired S C _) (copyDepends C P) (copyMissing S P _))
;; A scoped pass cannot erase a failing acceptance row from the same identity.
(relation copyNativeFailureFact (source profile component check artifact digest))
(relation copyNativeFailure (scenario component check artifact digest))
((copyNativeFailure S C T A H) <-- (copyBound _) (copyIdentityFact L P)
 (copyCandidateFact S L P) (copyNativeFailureFact L P C T A H))
(relation copyAllReady (scenario))

((copyAllReady S) <-- (copyBound _) (copyCandidateFact S _ _)
 (not (copyMissing S _ _)) (not (copyRouteMissing _ _ _)) (not (copyNativeFailure S _ _ _ _)))
(relation question (claim))
((question C) <-- (copyBound C))
