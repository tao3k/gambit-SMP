;; SysML owns requirements; this checks refinement evidence delivery, not a
;; replacement weak-memory model, scheduler model or root algebra theorem.
(relation osIdentity (source profile))
(relation osNeed (id method))
(relation osObservation (id method source profile outcome))
(relation osPass (outcome) (("pass")))
(relation osRejected (id))
((osRejected I) <-- (osNeed I M) (osIdentity S P) (osObservation I M S P O) (not (osPass O)))
(relation osSupplied (id))
((osSupplied I) <-- (osNeed I M) (osIdentity S P) (osObservation I M S P "pass") (not (osRejected I)))
(relation osMissing (id))
((osMissing I) <-- (osNeed I _) (not (osSupplied I)))
(relation osOpenBoundary (id))
(relation osBoundaryReceipt (id source))
(relation osBoundaryMissing (id))
((osBoundaryMissing I) <-- (osIdentity S _) (osOpenBoundary I) (not (osBoundaryReceipt I S)))
(relation osScopedClosure (source))
((osScopedClosure S) <-- (osIdentity S _) (not (osMissing _)))
(relation osArchitecture (source))
(relation osCommitReady (source))
((osCommitReady S) <-- (osScopedClosure S) (osArchitecture S) (not (osBoundaryMissing _)))
