(ascent-fragment
 (relation scenario ((id string?)))
 (relation need ((id string?) (kind string?) (path string?) (digest string?) (scope string?)))
 (relation method ((kind string?) (tool string?)))
 (relation receipt ((scenario string?) (id string?) (path string?) (digest string?) (scope string?)))
 (relation route ((scenario string?) (id string?) (tool string?) (path string?) (scope string?)))
 (relation checked ((scenario string?) (id string?)))
 (relation blocked ((scenario string?) (reason string?)))
 (relation candidate ((scenario string?)))
 ((route S N T P C) <-- (scenario S) (need N K P _ C) (method K T))
 ((checked S N) <-- (scenario S) (need N _ P H C) (receipt S N P H C))
 ((blocked S N) <-- (scenario S) (need N _ _ _ _) (not (checked S N)))
 (relation gate ((scenario string?) (key string?) (closed string?)))
 ((blocked S K) <-- (gate S K (lit "false")))
 (relation witnessneed ((key string?) (path string?) (digest string?) (needle string?) (scope string?)))
 (relation witnessbinding ((key string?) (path string?) (digest string?) (needle string?) (scope string?)))
 (relation witnessok ((key string?)))
 ((witnessok K) <-- (witnessneed K P H N C) (witnessbinding K P H N C))
 ((blocked S K) <-- (scenario S) (witnessneed K _ _ _ _) (not (witnessok K)))
 (relation bridge ((key string?) (lemma string?)))
 (relation bridgereceipt ((scenario string?) (key string?) (lemma string?)))
 (relation bridgeok ((scenario string?) (key string?)))
 ((bridgeok S K) <-- (scenario S) (bridge K L) (bridgereceipt S K L))
 ((blocked S K) <-- (scenario S) (bridge K _) (not (bridgeok S K)))
 (relation externalneed ((id string?) (path string?) (digest string?) (scope string?)))
 (relation externalreceipt ((scenario string?) (id string?) (path string?) (digest string?) (scope string?)))
 (relation externalok ((scenario string?) (id string?)))
 ((externalok S N) <-- (scenario S) (externalneed N P H C) (externalreceipt S N P H C))
 ((blocked S N) <-- (scenario S) (externalneed N _ _ _) (not (externalok S N)))
 ((candidate S) <-- (scenario S) (not (blocked S _)))
)
