;;; Actual model observations cannot substitute for fresh-expansion rationaldict
;;; plus same-producer compiler whole-package gates. A retained-Scheme native witness
;;; is separately recorded and does not populate these complete gate facts.
(define-evidence (make-darwin-module-image)
  (sources observed_step required_step)
  (outputs checked missing_native merge_allowed)
  (relation observed_step ((id string?) (outcome string?) (capability string?)))
  (relation required_step ((id string?)))
  (relation checked ((id string?)))
  (relation missing_native ((id string?)))
  (relation merge_allowed ((id string?)))
  ((checked I) <-- (required_step I) (observed_step I (lit "PASS") _))
  ((missing_native (lit "gerbil-compiler")) <-- (required_step (lit "integration-model"))
    (not (observed_step (lit "gerbil-compiler") (lit "PASS") _)))
  ((missing_native (lit "rationaldict")) <-- (required_step (lit "integration-model"))
    (not (observed_step (lit "rationaldict") (lit "PASS") _)))
  ((missing_native (lit "gerbil-mcp")) <-- (required_step (lit "integration-model"))
    (not (observed_step (lit "gerbil-mcp") (lit "PASS") _)))
  ((missing_native (lit "gerbil-poo")) <-- (required_step (lit "integration-model"))
    (not (observed_step (lit "gerbil-poo") (lit "PASS") _)))
  ((missing_native (lit "global-capacity")) <-- (required_step (lit "integration-model"))
    (not (observed_step (lit "global-capacity") (lit "PASS") _)))
  ((missing_native (lit "parallel-global-writers")) <-- (required_step (lit "integration-model"))
    (not (observed_step (lit "parallel-global-writers") (lit "PASS") _)))
  ((missing_native (lit "child-status-lifetime")) <-- (required_step (lit "integration-model"))
    (not (observed_step (lit "child-status-lifetime") (lit "PASS") _)))
  ((missing_native (lit "paired-package-speedup")) <-- (required_step (lit "integration-model"))
    (not (observed_step (lit "paired-package-speedup") (lit "PASS") _)))
  ((missing_native (lit "static-products")) <-- (required_step (lit "integration-model"))
    (not (observed_step (lit "static-products") (lit "PASS") _)))
  ((missing_native (lit "ordered-link-equivalence")) <-- (required_step (lit "integration-model"))
    (not (observed_step (lit "ordered-link-equivalence") (lit "PASS") _)))
  ((missing_native (lit "resource-admission")) <-- (required_step (lit "integration-model"))
    (not (observed_step (lit "resource-admission") (lit "PASS") _)))
  ((missing_native (lit "source-custody")) <-- (required_step (lit "integration-model"))
    (not (observed_step (lit "source-custody") (lit "PASS") _)))
  ((merge_allowed (lit "darwin")) <--
    (observed_step (lit "resource-admission") (lit "PASS") _)
    (observed_step (lit "source-custody") (lit "PASS") _)
    (observed_step (lit "static-products") (lit "PASS") _)
    (observed_step (lit "ordered-link-equivalence") (lit "PASS") _)
    (observed_step (lit "gerbil-compiler") (lit "PASS") _)
    (observed_step (lit "rationaldict") (lit "PASS") _)
    (observed_step (lit "global-capacity") (lit "PASS") _)
    (observed_step (lit "parallel-global-writers") (lit "PASS") _)
    (observed_step (lit "child-status-lifetime") (lit "PASS") _)
    (observed_step (lit "paired-package-speedup") (lit "PASS") _)
    (observed_step (lit "gerbil-mcp") (lit "PASS") _)
    (observed_step (lit "gerbil-poo") (lit "PASS") _)))
