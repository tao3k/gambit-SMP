;; Native cases and source witness strength do not issue native admission.
(relation cursorCaseFact (case scope legacy coherent))
(relation cursorNodeFact (node ownership anchor))
(relation cursorEdgeFact (producer consumer))
(relation cursorEvidenceFact (derived native))
(relation cursorGateFact (scenario admitted g0 q0 g1 q1 g2 q2 g3 q3))
(relation cursorReach (scenario node))
(relation cursorWitness (scenario case scope))
(relation cursorNativeWitness (scenario case))
(relation sameCursorDatum (case))
(relation modeRepairRequired (scenario case legacy coherent))
(relation cursorMissingGate (scenario gate))
(relation cursorAdmissionDenied (scenario reason))
(relation cursorAdmissionCandidate (scenario))
((cursorReach S (lit "witness")) <-- (boundComponent (lit "build-scheduler") _) (scenarioFact S _))
((cursorReach S B) <-- (cursorReach S A) (cursorEdgeFact A B))
((cursorWitness S (lit "lexerQuote") T) <-- (scenarioFact S _) (cursorEvidenceFact (lit "true") _) (cursorCaseFact (lit "lexerQuote") T _ _))
((cursorNativeWitness S (lit "lexerQuote")) <-- (scenarioFact S _) (cursorEvidenceFact _ (lit "true")))
((sameCursorDatum C) <-- (cursorCaseFact C _ V V))
((modeRepairRequired S C L R) <-- (scenarioFact S _) (cursorCaseFact C _ L R) (not (sameCursorDatum C)))
((cursorMissingGate S G) <-- (scenarioFact S _) (cursorGateFact S _ G (lit "false") _ _ _ _ _ _))
((cursorMissingGate S G) <-- (scenarioFact S _) (cursorGateFact S _ _ _ G (lit "false") _ _ _ _))
((cursorMissingGate S G) <-- (scenarioFact S _) (cursorGateFact S _ _ _ _ _ G (lit "false") _ _))
((cursorMissingGate S G) <-- (scenarioFact S _) (cursorGateFact S _ _ _ _ _ _ _ G (lit "false")))
((cursorAdmissionDenied S (lit "adapter-source-open")) <-- (scenarioFact S _) (cursorGateFact S (lit "false") _ _ _ _ _ _ _ _))
((cursorAdmissionDenied S G) <-- (cursorMissingGate S G))
((cursorAdmissionCandidate S) <-- (scenarioFact S _) (cursorGateFact S (lit "true") _ (lit "true") _ (lit "true") _ (lit "true") _ (lit "true")))
