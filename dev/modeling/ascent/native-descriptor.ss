 (fact (proof "ND-ABI" "ND-ABI:dev/architecture/toolchain" "ND-ABI:AcceptedShape implies every declared native field access is representation-compatible; does not imply control/GC safety / QNT: admitted implies exact relevant target/layout/call and semantic policy agreement" "ND-ABI:open-design-only" "ND-ABI:BF-BUILD-CUT"))
 (fact (proof "ND-ENCODE" "ND-ENCODE:dev/architecture/toolchain" "ND-ENCODE:For every admitted slot i, mapBit(decode(f),i)=scanPolicy(f,i); internal transform once; chunk concatenation correct / QNT: Decoded facts match completed FrameSpec and all accesses remain in bounds" "ND-ENCODE:open-design-only" "ND-ENCODE:CONTROL-ORIGIN"))
 (fact (proof "ND-PUBLISH" "ND-PUBLISH:dev/architecture/runtime/execution" "ND-PUBLISH:Each actual scanner observation follows initialization and final root handoff; record publication alone insufficient / QNT: published implies initialized descriptor/tables and scanner-visible final roots; one setup owner; failure retains custody" "ND-PUBLISH:open-design-only" "ND-PUBLISH:ROOT-HANDOFF; GC-WORK-CLOSURE"))
 (fact (proof "ND-BIND" "ND-BIND:dev/architecture/runtime/interfaces" "ND-BIND:Binding observations and errors match old ordered producer/consumer trace; every live temporary is rooted / QNT: Blueprint unchanged; equal semantic names share identity exactly within specified domain; no complete credential on failure" "ND-BIND:open-design-only" "ND-BIND:ROOT-HANDOFF"))
 (fact (proof "ND-INIT" "ND-INIT:dev/architecture/runtime/control" "ND-INIT:Refinement preserves permitted stage/effect/exception observations; no automatic retry of irreversible initialization / QNT: entered is not completed; no success delivery before all required stages; preserve staged reentry policy" "ND-INIT:open-design-only" "ND-INIT:CONTROL-ORIGIN; RETIRE-WINDOW"))
 (fact (proof "ND-ROOT" "ND-ROOT:dev/architecture/runtime/gc" "ND-ROOT:Source liveness plus map/coordinate correctness plus final handoff implies no live root omitted; scanner preserves identity / QNT: Every live managed location covered at admitted checkpoint; scanned slots initialized/tag-valid; restored roots current" "ND-ROOT:open-design-only" "ND-ROOT:ROOT-HANDOFF; GC-WORK-CLOSURE"))
 (fact (proof "ND-CONTROL" "ND-CONTROL:dev/architecture/runtime/control" "ND-CONTROL:Capture/restore and repeated invocation preserve logical continuation; tail steps do not accumulate frame debt / QNT: No lost copy responsibility; link chain and PointId resolution preserved; proper-tail space bound independent of tail steps" "ND-CONTROL:open-design-only" "ND-CONTROL:CONTROL-ORIGIN"))
 (fact (proof "ND-LIFETIME" "ND-LIFETIME:dev/architecture/runtime/gc" "ND-LIFETIME:No surviving continuation/frame references reclaimed descriptor, label address or module instance; failed transfer retains owner / QNT: Reclaim only after admitted producers closed and all descriptor/code/root users drained; unknown users retain" "ND-LIFETIME:open-design-only" "ND-LIFETIME:RETIRE-WINDOW; ROOT-HANDOFF"))
