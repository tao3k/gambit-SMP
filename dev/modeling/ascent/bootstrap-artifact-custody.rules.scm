;; SysML owns the component-specific evidence inventory and five stage gates.
;; Existing QNT/Lean do not prove artifact custody or supply native receipts.
(relation bcIdentity (source profile recipe))
(relation bcNeed (id method))
(relation bcObservation (id method source profile recipe outcome))
(relation bcPass (outcome) (("pass")))
(relation bcRejected (id))
((bcRejected I) <-- (bcIdentity S P R) (bcNeed I M) (bcObservation I M S P R O) (not (bcPass O)))
(relation bcSupplied (id))
((bcSupplied I) <-- (bcIdentity S P R) (bcNeed I M) (bcObservation I M S P R "pass") (not (bcRejected I)))
(relation bcMissing (id))
((bcMissing I) <-- (bcNeed I _) (not (bcSupplied I)))
(relation bcGate (id))
(relation bcGateEvidence (id source profile recipe outcome))
(relation bcGateRejected (id))
((bcGateRejected G) <-- (bcIdentity S P R) (bcGate G) (bcGateEvidence G S P R O) (not (bcPass O)))
(relation bcGateMissing (id))
((bcGateMissing G) <-- (bcIdentity S P R) (bcGate G) (not (bcGateEvidence G S P R "pass")))
((bcGateMissing G) <-- (bcGateRejected G))
(relation bcStageRequest (scope))
(relation bcScope (scope))
(relation bcImplementation (identity))
(relation bcStageCommit (scope source implementation))
((bcStageCommit C S I) <-- (bcStageRequest C) (bcScope C) (bcImplementation I) (bcIdentity S _ _) (not (bcMissing _)) (not (bcGateMissing _)))
;; A bounded stage commit is not a native release/SMP-wide admission.
(relation bcRuntimeAdmission (source))
