# interconnection rendering (no view declared; rendering GambitAssuranceRouting::RoutingGraph directly)
classes: {
  definition: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14 } }
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  connection: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 3 } }
}
n0: "«part def»\nRoutingGraph" {
  class: definition
  n1: "«part»\ncomponentNeed : ModelNeed" { class: usage }
  n2: "«part»\nmethodPolicy : MethodRule" { class: usage }
  n3: "«part»\nascent : Planner" { class: usage }
  n4: "«part»\nquint : QntChecker" { class: usage }
  n5: "«part»\nlean : LeanChecker" { class: usage }
  n6: "«part»\nreceipt : ScopedReceipt" { class: usage }
  n7: "«part»\nfrontier : OpenFrontier" { class: usage }
}
n0.n1 -- n0.n3: "needs" { class: connection }
