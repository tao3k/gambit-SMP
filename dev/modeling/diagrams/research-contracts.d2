scientificLibraries: "Private scientific instances\nAlgorithms and negative controls retained"
scientificQnt: "quint.observe / quint.verify\nBounded observations / exhaustive checker"
scientificLean: "lean.check\nInduction and explicit refinement duties"
scientificJoin: "ASCENT\nSource inverse + owner + duty + refusal"
scientificGap: "No whole-study or runtime admission\nMissing historical/native evidence remains unavailable"
