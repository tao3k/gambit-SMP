# Architecture view of research-contracts.sysml; no execution result.
direction: right
model: "SysML: declarations / exclusive obligations"
task: "Existing workspace + task_entry + cli"
recipe: "Existing typed Recipe: 120 s total"
project: "sysml.project: sealed SDK scalar projection"
header: "source.contract: 37 modules / unique declaration"
make: "source.contract: Make delta / prior defect retained"
rules: "Existing ASCENT observation-contract"
cache: "Managed task/process run cache"
denial: "Missing / changed / unknown => no admission"
semantic: "Existing QNT: runtime interleavings\nExisting Lean: semantic refinement"
retire: "Migrate equivalent callers\nthen retire standalone loops\nthen global rebinding"
model -> recipe: source contract
task -> recipe: identity / leases / output
recipe -> project: fixed stage budget
project -> header: typed hash-bound artifact
project -> make: typed hash-bound artifact
header -> rules: actual step observations
make -> rules: includes priorContractUsable = false
rules -> cache: local observations only
header -> denial
make -> denial
recipe -> semantic: separate duties; no duplicate proof
rules -> retire: equivalence gates

facade: "justfile: flags only"
cli: "Existing audit CLI: source / model / part"
sdk: "Official OpenSysML Python API"
instance: "Owned typed contract attributes"
sourceBinding: "Selected checkout + model sourcePrefix"
service: "Task-owned service + bounded RPC child"
facade -> cli
cli -> sdk
model -> sdk: typed parse and independent oracle replay
sdk -> instance: instantiate / owned attributes
instance -> sourceBinding
sourceBinding -> header
sourceBinding -> make
sdk -> service: task birth / explicit endpoint / no download
cli -> cache: source inspection; no evidence admission

seal: "Sealed SDK + lock + official binary\nExecutable role + policy bytes"
request: "Fresh nonce + exact model bytes\nPart + original deadline"
closed: "Both children actually reaped\nControlled stop; binary unchanged"
retained: "Unknown completion\nTask registry keeps custody; deny"
oracle: "Independent old-frontend fixture\nFull frozen and current field equality"
serviceRules: "ASCENT sdk_qualified / sdk_denied\nConflicting rows deny"
seal -> project
request -> project
service -> closed: stop / wait within original budget
service -> retained: timeout / interruption / unknown
closed -> serviceRules
oracle -> serviceRules
serviceRules -> header: only qualified projection
serviceRules -> make
retained -> denial
model -> serviceRules: research-service.sysml obligations

audit: "Shared research.audit capability"
policy: "Typed policy / six classes / flow contract"
controls: "Independent pre-retirement oracle: 21 + 7 cases"
views: "Pure shared view generator / compare\nCache previews; explicit source review"
index: "Shared bounded Git index audit"
old: "Two standalone loops and stdout parsers deleted"
project -> policy: one API parse / nine part projections
policy -> audit
controls -> audit: exact relation equality
views -> audit: no implicit source publication
index -> audit
recipe -> audit: same ExecutionContext / total ceiling
rules -> old: complete chain acceptance required

structure: "Shared sysml.structure / SDK to_api_json"
preflight: "Shared architecture.preflight / stable Org input hashes"
renderer: "ArchitectureViews(root, output)\nOwned rendering library; no execution loop"
viewCheck: "Shared architecture.views\nCache proposals only; drift denies"
structureFixture: "Independent native structure graph digest\nExact AST relocation + eight negative controls"
viewGap: "Full DEV transport: 60-second timeout\nActual source anchor: old/new both reject\nNo complete-view acceptance"
preflight -> structure: existing Recipe dependency
structure -> renderer: explicit typed model and source identities
renderer -> viewCheck
structureFixture -> viewCheck: bounded qualifications only
viewCheck -> viewGap: preserve unresolved
old -> renderer: sync-views runner deleted; no source --write

entryGate: "SysML exact remaining-entry identity\n0 standalone paths; exact 133-entry catalog"
debt: "Source-byte-bound execution factors\nOverlapping mechanisms; not semantic closure"
model -> entryGate
entryGate -> audit: fail closed before admission
audit -> debt: per-entry migration evidence

workspaceOwner: "Existing owner context / work and results"
workspaceCohort: "123 entry modules / 4223 baseline reads"
workspaceProof: "Independent AST fixture + fixed controls"
namespaceRetired: "168 helper assignments + global rebind/restore deleted"
lateContext: "Retired owner -> copied callback access refused"
stdoutDebt: "0 stdout decoders; all 133 entries use shared ownership"
workspaceCohort -> workspaceOwner: direct owner lookup
workspaceProof -> audit: complete cohort source check
workspaceOwner -> lateContext: revoke before context reset
workspaceCohort -> namespaceRetired: exact declared substitution
namespaceRetired -> stdoutDebt: separate next migration obligation

selectedPlan: "SysML selectedFields / literal references\nIndependent 807-field oracle / 275 sources"
selectedProducer: "Existing sysml.project / one parse\nSame sealed service owner / 60 s total"
selectedConsumers: "3 existing studies / explicit --projection-run\n374 + 271 + 162 ordered fields"
selectedReject: "Missing / stale / changed / wrong kind or order -> refuse"
selectedProof: "Old/new return + saves + source scope\nOriginal scientific AST and controls preserved"
model -> selectedPlan
selectedPlan -> selectedProducer
selectedProducer -> serviceRules: actual service admission
serviceRules -> selectedConsumers: explicit CURRENT typed artifact
selectedConsumers -> selectedReject
selectedProof -> audit
selectedConsumers -> stdoutDebt: first cohort: 3 decoder blocks retired

completeCohort: "101 remaining entries + shared library migrated\n110 source/consumer inverses / 98 typed requests"
zeroGate: "Exact zero decoder gate\nMissing/foreign/contradictory rows deny"
sharedInput: "Existing Recipe: typed dependency reference\nExisting projection.json + execution provenance"
noLegacy: "No CLI builder / stdout fallback\nNo --reuse-sysml checkpoint or delivery wrapper"
loopGap: "133 entries are private libraries\nWhole-study/native qualification remains open"
model -> completeCohort: SysML audit + selectedFields
completeCohort -> sharedInput
completeCohort -> zeroGate: Python source facts -> ASCENT
zeroGate -> audit
sharedInput -> noLegacy
noLegacy -> loopGap: mechanism retirement only

scientificAuthority: "ScientificStudies::catalog\n221 libraries / 133 entries"
