direction: down
source: "Existing necessary paths\nGambit compile / link -> gambuild-C\nGerbil Darwin object + env/bundle leg\nShell metadata + package queries + native tools"
scheme: "Gambit / Gerbil semantic owner\nGeneration, module identity, configured feature authority\nExisting process/I-O machinery owns worker child\nNo second independent native reaper in this process"
gateway: "Explicit admitted gateway\nStructured intent + profile, owned request bytes\nResult/status/diagnostics and fd/TTY contract\nGC/control and failure delivery gates remain open"
worker: {
  label: "Matched independent worker: C-G / C-ZT / Zig"
  resolver: "One resolver\nOrdered metadata + package actions\nExact argv/env/cwd; one authoritative recipe graph"
  runner: "One child runner\nWorker owns tool children and terminal status\nSeparate inherited-stdio and bounded query-capture adapters"
  provider: "Optional later LLVM/MLIR adapter\nExplicit cohort / raw-output normalization\nNot required by external-tool-only NJS"
  result: "Result owner\nOutput roles + provenance + failure state\nWorker loss is not compiler success or safe retry"
  resolver -> runner
  runner -> result
  resolver -> provider: "only when demanded"
  provider -> result
}
tools: "Actual tool processes\nPackage queries / C compiler / linker\nOptional external IR driver\nNo automatic C preprocessing or semantic work removal"
retain: "Retained cheaper control and residuals\nTyped Scheme direct execution may suffice\nPublic process runtime, generic invoke, legacy/non-C/info callers remain\nNo code retired; no native tests" {
  style.fill: "#fff0ce"
}
source -> scheme
scheme -> gateway
gateway -> worker.resolver: "request"
worker.result -> gateway: "acknowledged result / failure"
worker.runner -> tools
tools -> worker.runner: "terminal state / selected I-O"
source -> retain
