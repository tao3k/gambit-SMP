direction: down
source: "Observed Gambit label path\nScheme produces variants and selects C macro forms\nHeader packs descriptors and builds label records"
contract: "Common reconstruction in either language\nScheme semantic PointId / FrameSpec + validated traversal\nOne native physical decision shared by C and native outputs"
pair: {
  label: "Proposed resident native source-product sum"
  c: "LP-C\nOpaque / generated typed support\nSC-ADT-C association family"
  z: "LP-Z\nTyped union construction + branch payload capture\nSC-ADT-C project implementation avoided"
}
stream: "LP-stream counterdesign\nImmutable Scheme traversal + narrow typed requests\nShared native planner retains physical decisions\nNo native source-product sum required by reviewed consumers"
residual: "Retained in both\nSemantic schema / identity / validation\nPhysical packing / runtime roots and control / lifetimes\nOutput handlers / ABI and provider admission"
events: "E01-E09 change accounting\nStable generator is not edited per generated variant\nShared cleanup is not rewritten per failure exit\nCharge migration and C/Zig/provider version support"
result: "TG4: scoped support mechanism established\nOne prospective family avoided only in the resident pair\nZero existing retirements; no universal necessity bound" {
  style.fill: "#e8f2ff"
}
gate: "TG5: positive aggregate bound remains unproved\nCurrent theoretical gate not passed\nNo implementation, native test or engine run" {
  style.fill: "#fff0ce"
}
source -> contract
contract -> pair.c
contract -> pair.z
contract -> stream
pair.c -> residual
pair.z -> residual
stream -> residual
residual -> events
events -> result
stream -> result: "can avoid the same support in C"
result -> gate
