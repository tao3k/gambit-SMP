direction: down
users: "Actual Gambit users\nRC / C callbacks / setters / TLS / devices / shutdown"
contract: "Shared semantic and ownership contract\nOne schema, independent readers\nExisting native C leaves credited in both routes"
users -> contract
services: {
  label: "Necessary new service authorities"
  roots: "RootRegistry\nstable cells, scan / transfer / teardown"
  barriers: "BarrierLog\nreserve / store / epoch / drain"
  release: "ReleaseCoordinator\naccept / cancel / wait / payload / shutdown"
}
contract -> services.roots
contract -> services.barriers
contract -> services.release
support: "Shared support priced once\nallocation, products, synchronization, evidence"
services -> support
alternatives: {
  label: "Source-informed author estimates: known scoped work only"
  c: "Modern generated C\n172-344 workdays\ngenerator + services + migration + qualification"
  zig: "Zig service implementation\n176-400 workdays\nsame protocols + C client / ABI / tool integration"
}
support -> alternatives.c
support -> alternatives.zig
retire: "Eligible old authorities\nPSTATE RC root scan / unclassified stores\nopaque cleanup runner / unaccounted destruction\nretire only after actual caller closure"
alternatives -> retire
tail: "Unpriced additional work\nunknown aliases, new target callback paths\nwhole collector / backend / bootstrap, proof failures\nno finite whole-runtime cost bound"
retire -> tail
