direction: down
classes: {
  evidence: {style.fill: "#edf4ff"}
  decision: {style.fill: "#fff0ce"}
}
intent: "VQ01 / VQ12\nNamed demand + horizon + ownership\nCurrently missing" {class: decision}
evidence: "Gambit papers + current source\nSupporting and limiting claims\nExact local hashes / upstream access scope" {class: evidence}
questions: "VQ01-VQ12: durable adoption questions\nHuman judgment + alternative + reversal trigger\nASCENT checks correspondence, not worth"
choices: {
  label: "Separate investment choices"
  contract: "Gambit semantic/runtime contract\nVQ02 / VQ03 / VQ08 / VQ09"
  zig: "Zig native subsystem candidate\nVQ04: incremental language value"
  llvm: "LLVM provider / optional semantic MLIR\nVQ05 / VQ06 / VQ10"
}
comparators: "B0: retained architecture\nB1: same refactor in C / existing tools\nZ1: same refactor in Zig"
accounting: "Q01-Q18 benefit and recurring-cost ledger\nM1-M12 + H01-H10 real retirement\nNo double counting / no observed net gain" {class: evidence}
review: "Continue / narrow / defer / reject\nCurrent: research continues; adoption unresolved\nVQ07 prevents false startup attribution" {class: decision}
reopen: "Source/profile changes, contrary findings,\nworkload changes, provider upgrades,\nfailed retirement or cost growth"
intent -> questions
evidence -> questions
questions -> choices.contract
questions -> choices.zig
questions -> choices.llvm
choices.contract -> comparators
choices.zig -> comparators
choices.llvm -> comparators
comparators -> accounting
accounting -> review
review -> reopen
reopen -> questions: "append reviewed revision" {style.stroke-dash: 5}
