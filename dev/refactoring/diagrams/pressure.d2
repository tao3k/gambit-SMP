# Derived from RefactoringPressure metadata in adoption.sysml. Necessary replacement, not acceptance.
direction: right
exit: "Error delivery and receiver lifetime" {
  coupling: "An asynchronous outcome can outlive\nthe catcher or execution context\nselected to receive it"
  replacement: "Explicit admission, retained outcome\nowner, drain and late-result\ndisposition before receiver\nreclamation"
  retirement: "Remove implicit live-catcher\nassumption only after every legal\nsender and unwind path has a\ndisposition"
  coupling -> replacement: "change mechanism"
  replacement -> retirement: "qualify before retiring"
}
work: "GC work owner versus processor lifetime" {
  coupling: "Execution identity, collector storage,\nwork custody and participation are\ncoupled"
  replacement: "Explicit collector work context,\nproducer closure and retained custody\ncarrier with last-use reclamation"
  retirement: "Replace collector PSTATE aliases only\nafter all roots, phase producers,\nresize paths and consumers are mapped"
  coupling -> replacement: "change mechanism"
  replacement -> retirement: "qualify before retiring"
}
copy: "Hidden copy progress and pending scan continuation" {
  coupling: "Original slot, rebound Tail cell,\npayload progress and caller advance\nreside in local C control state"
  replacement: "Explicit phase-tagged copy subframe\nand parent continuation; preserve\nreservation before execution"
  retirement: "Retire implicit local-state recovery\nonly after exact progress,\npublication, rejection and unknown-\noutcome adapters qualify"
  coupling -> replacement: "change mechanism"
  replacement -> retirement: "qualify before retiring"
}
ffi: "Foreign entry roots and callback ownership" {
  coupling: "Marker creation can allocate before\nits incoming Scheme value is\nindependently protected"
  replacement: "Generated root-safe entry plans with\nexplicit owner, borrowed slots, block\nparticipation and acquired-effect\ncleanup"
  retirement: "Retire handwritten per-entry root\nchoreography only after complete\ncaller and exceptional-exit coverage"
  coupling -> replacement: "change mechanism"
  replacement -> retirement: "qualify before retiring"
}
release: "Foreign cleanup effects and resource lifetime" {
  coupling: "Arbitrary external effects, collector\nprogress and native resource lifetime\nmeet inside cleanup"
  replacement: "Effect-classified release service,\nexplicit wait context and shutdown\naccounting for accepted descendants"
  retirement: "Retire inline cleanup only for\ndeclared resource classes after\npayload roots, task acceptance and\nfinal drain close"
  coupling -> replacement: "change mechanism"
  replacement -> retirement: "qualify before retiring"
}
frames: "Cached frame state across GC-capable boundaries" {
  coupling: "Compiler cache, physical frame,\ncollector relocation and return\ninterpretation must agree"
  replacement: "One Scheme-owned FrameSpec and\ncheckpoint contract generates C root\nwriteback, reload and unwind metadata"
  retirement: "Retire duplicate frame decisions after\nevery generator/runtime consumer\nshares schema and preserves supported\ncontinuations"
  coupling -> replacement: "change mechanism"
  replacement -> retirement: "qualify before retiring"
}
profile: "Requested SMP versus effective native capability" {
  coupling: "Requested options, effective headers,\nlinked RTS and runtime population can\ndiverge"
  replacement: "Typed effective profile and ABI-bound\nartifact graph, audited target\nprojections and one shared CPU budget"
  retirement: "Retire string-only capability\ninference after configured-header,\nobject, link and runtime witness\ncoverage"
  coupling -> replacement: "change mechanism"
  replacement -> retirement: "qualify before retiring"
}
generation: "Scheme to generated C and linked runtime coherence" {
  coupling: "Scheme source, generated type/label\nidentities, archive and executable are\none affected dependency closure"
  replacement: "Single semantic plan, generated\ndeclarations and manifests; bind the\naffected generated/header/link closure"
  retirement: "Retire manually synchronized\nemission/layout decisions after all\nconsumers regenerate and reject stale\nclosure"
  coupling -> replacement: "change mechanism"
  replacement -> retirement: "qualify before retiring"
}
