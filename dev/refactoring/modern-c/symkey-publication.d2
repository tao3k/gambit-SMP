direction: right
factory: "Native make/find/new"
bootstrap: "Exclusive static bootstrap intern"
registry: {
  label: "Existing global_gate: one transaction"
  lookup: "Canonical lookup / recheck"
  construct: "Permanent name + object"
  insert: "Bucket + NEXT + count"
  grow: "Optional rehash / anchor publication"
  lookup -> construct: missing
  construct -> insert
  insert -> grow
}
allocator: "Existing permanent_gate\nNULL processor / no Scheme GC"
walkers: "Native reverse lookup + TTY walk\nNoReentry callback premise"
capture: "GC: capture before[2], cells[2]\nunder registry gate"
mark: "Mark local cells outside gate\nexisting RootTask scan lease"
commit: "Conditional moved-anchor commit\nnever overwrite newer permanent anchor"
open: "OPEN ROOT-VIEWS\nScheme table aliases / raw folds"
factory -> registry.lookup
bootstrap -> registry.insert: "exclusive owner"
registry.construct -> allocator
walkers -> registry: "same topology authority"
registry.grow -> capture: "serialized capture"
capture -> mark: unlock
mark -> commit: "reacquire gate"
registry.grow -> commit: "new publication may intervene"
open -> registry: "not admitted by native mutex"
open.style.stroke-dash: 4
