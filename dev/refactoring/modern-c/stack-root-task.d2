direction: right
source: "VM-owned context\nfp / stack_break\nexisting stopped roster"
task: "STACK RootOrigin → RootTask\nfresh → READY → CLAIMED\nSCANNING → SCANNED → DONE"
scanner: "Original in-place frame scanner\nRETI / RETN / live root slots\nbreak anchor → captured tail"
heap: "Original heap captured-frame scanner\nweak move / restore / multi-shot\nouter context + VM lifetime"
source -> task: "actual epoch + matching VM slot"
task -> scanner: "one known scan; no replay of unknown work"
scanner -> heap: "descendant/weak work outlives scan lease"
models: "SysML authority → ASCENT\nQNT: temporal schedules\nLean: conditional cells/addresses\nLLM: ambient source review"
pbt: "Existing native Scheme fixture\ncontrol + real map / dynamic-wind\nrestore → GC → restore\nfresh replay + deletion shrink"
models -> task: "conditional refinement"
pbt -> scanner: "implementation evidence"
