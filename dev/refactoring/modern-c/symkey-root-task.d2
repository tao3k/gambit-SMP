direction: right
source: "Actual global-state anchor cells\nsymbol_table / keyword_table\nregistry + VM + round lifetime"
task: "Collecting VM coordinator\nSYMKEY RootOrigin → RootTask\npublish → claim → scan → finish"
scan: "Explicit-source mark_symkey_tables\nmark_array(&source->symbol_table,1)\nmark_array(&source->keyword_table,1)"
heap: "Existing bucket / object-copy / weak work\nouter lifetime remains after local DONE"
open: "OPEN: other-VM writers / raw aliases\nintern / rehash / global cleanup\nVM safepoint is insufficient"
source -> task: "current source + actual RC epoch"
task -> scan: "one known local scan obligation"
scan -> heap: "in-place cell update; no bucket algorithm change"
open -> source: "existing admission premise, not a new certificate"
models: "SysML → shared ASCENT\nQNT: temporal schedules\nLean: conditional cells/addresses\nLLM: ambient review"
pbt: "Existing Scheme PBT/replay/shrink\nimmediate control + two movable empty valid anchors\nnative GC; RC restore before Scheme lookup"
models -> task: "conditional source refinement"
pbt -> scan: "implementation observations"
