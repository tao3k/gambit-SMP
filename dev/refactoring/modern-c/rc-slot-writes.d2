direction: right
caller: "setup / closure / Tcl constructor\ninstall payload before borrow/exposure"
gate: "RC domain mutex\nowner + OPEN + native ref > 0"
loan: "Stable-cell borrow\nlogical referent fixed; contents mutable"
write: "Different referent\nreject while borrowed"
noop: "Identical referent\naccept without store"
task: "Frozen claimed RC RootTask\nscan lease = 1"
gc: "mark_array repairs moved address\nborrow may remain live"
reload: "Caller reloads cell after allocation\nhandoff to marker then return loan"
exit: "native refs = 0 AND borrows = 0\nheader may be reclaimed"
caller -> gate -> loan
gate -> write
gate -> noop
loan -> task -> gc -> reload -> exit
loan -> exit: "return every loan"
