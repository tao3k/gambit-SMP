direction: right
bootstrap: "Exclusive bootstrap\ninit_symkey_glo2"
writer: "Current admitted RC source\nmake_global_var"
registry: "global_gate\nindex + link + count + pointer publication"
allocator: "permanent_gate\nall permanent cursor users"
cut: "P0 after frozen roster\none immutable N, R, epoch"
tasks: "GLOBALS RootTasks\nsame snapshot, distinct half-open shards"
cells: "Original VM cells\nin-place moving-root updates"
done: "Existing strong collective\nall shard leases complete -> close"
other: "Other VM append\nnew index only; this VM suffix stays UNB1"
open: "Separate boundaries\ninterner / raw value writers / W != R / Repair9"
models: "SysML -> ASCENT\nsource + native refinement"
qnt: "Existing QNT\ntemporal writer / lease histories"
lean: "Existing Lean\nconditional cell / partition laws"
bootstrap -> registry
writer -> registry: "RC gate held"
registry -> allocator
registry -> cut: "short serialized capture"
cut -> tasks: "existing setup collective"
tasks -> cells
cells -> done
registry -> other: "gate released before scan"
other -> cut: "preserve frozen prefix"
models -> qnt
models -> lean
models -> tasks: "actual adapter obligations"
done -> open: "no whole-SMP claim"
