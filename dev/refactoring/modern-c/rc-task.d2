direction: right
source: "Attached RC source\nOPEN / prior DONE\nLookup lifetime protected by roster"
publish: "Domain mutex\nfreeze + new checked epoch\nREADY + scan lease1"
claim: "Same source/epoch/executor\nREADY -> CLAIMED\nDuplicate or stale claim rejected"
scan: "Actual mark_rc / mark_array\nCLAIMED -> SCANNING -> SCANNED\nUnknown effects keep custody"
finish: "SCANNED -> DONE\nlease1 ->0 exactly once\nKnown finish reply idempotent"
round: "Source still FROZEN\nexisting strong/weak/copy/cleanup closure\nprivate epilogue checks epoch/DONE/lease0"
detach: "Normal retirement\nclear owner + executor\nbyte handles may outlive carrier"
tests: "Native Scheme replay / shrink\nfresh process per candidate\n24 generated cases /864 actions\nstale-finish negative calibration"
models: "SysML -> ASCENT\nexisting root_dispatch schedules\nexisting Lean coverage laws\nno duplicated machine"
source -> publish -> claim -> scan -> finish -> round -> source
source -> detach
tests -> publish
models -> tests
