direction: right
# View of GambitHashLayoutDelivery and GambitHashIndexOwnership.
decoder: "Text / binary decoder"
construction: "Strong construction roots"
commit: "Publish final policy + index debt"
gc: "GC repairs references; preserves slots"
cursor: "Suspended physical cursor"
read: "Pure probe; dirty miss fallback"
writer: "Exclusive writer reconstructs index"
sysml: "SysML: nine selected obligations"
ascent: "ASCENT: five source-bound gates"
qnt: "Existing QNT: finite schedules + counterexamples"
lean: "Existing Lean: conditional transport law"
native: "Bootstrap + original GSI + vendor regressions"
decoder -> construction -> commit
construction -> gc
gc -> cursor: stable coordinates
gc -> read: current references + address debt
read -> writer: debt remains until mutation
sysml -> qnt
sysml -> lean
sysml -> native
qnt -> ascent
lean -> ascent
native -> ascent
