# Current SysML root phases
root_phases: {
  label: "Root domain phase tasks / collective drain retained"
  prepare: "PREPARE"
  strong: "STRONG"
  weak: "WEAK"
  cleanup: "CLEANUP"
  prepare -> strong: exact predecessor DONE + drained users
  strong -> weak: exact predecessor DONE + drained users
  weak -> cleanup: exact predecessor DONE + drained users
}
origin_task_claim -> root_phases: explicit frozen domain
root_phases -> context_resume: cleanup DONE + whole-round seal
root_phases -> teardown_reclamation: join unknown does not reclaim native state
worker_arena: {
  label: "SysML worker-arena-handoff / guarded restore intervals"
  reserve: "R restoration stacks + W copy sections"
  copy: "VM section ledger / private copy grants"
  drain: "Weak descendants + actual writer exclusion"
  handoff: "Final interval + retired words, exactly once"
  reserve -> copy: bounded optional stack loan
  copy -> drain: no pending copy or Tail
  drain -> handoff: epoch + exclusive recipient
}
independent_copy_arena -> worker_arena
worker_arena -> context_resume: active stack restored separately
unequal_admission: {
 label: "Unequal counts / 2 obligations remain open"
 w_independent_refill: "independent-refill / source-refined"
 w_resume_coverage: "resume-coverage / source-refined"
 w_affine_cleanup: "affine-cleanup / source-refined"
 w_collective_split: "collective-split / source-refined"
 w_descendant_termination: "descendant-termination / source-refined"
 w_physical_packing: "physical-packing / open"
 w_native_writer_closure: "native-writer-closure / open"
}
worker_arena -> unequal_admission: scoped source evidence only
worker_domains: {
 label: "W collectors / R owner services"
 freeze: "FREEZE"
 prepare: "PREPARE"
 strong: "STRONG"
 weak: "WEAK"
 restore: "RESTORE"
 owner_cleanup: "OWNER_CLEANUP"
 resume: "RESUME"
 freeze -> prepare: actual W + frozen R grants
 prepare -> strong: R tasks claimed by W workers
 strong -> weak: W descendant drain
 weak -> restore: no pending copy or Tail
 restore -> owner_cleanup: all R stacks restored
 owner_cleanup -> resume: R host-token completions
}
worker_arena -> worker_domains
worker_domains -> unequal_admission: selected native cases only
owner_effects: {
 label: "Native effects / explicit custody boundaries"
 b_owner_new_still: "owner-new-still / selected-source-native-control"
 b_nested_gc: "nested-gc / explicit-rejection"
 b_managed_entry: "managed-entry / explicit-rejection"
 b_raw_rc_and_payload: "raw-rc-and-payload / unresolved"
 b_nonlocal_native_exit: "nonlocal-native-exit / unresolved"
 b_teardown_producer: "teardown-producer / unresolved"
 b_native_run_abi: "native-run-abi / selected-source-native-control"
 b_write_authority: "write-authority / selected-source-native-control"
 b_owner_new_still -> b_nested_gc: collecting request fails before publication
 b_managed_entry -> b_raw_rc_and_payload: low-level refusal is not writer closure
 b_nonlocal_native_exit -> b_teardown_producer: escrow/lifetime proof still required
}
worker_domains -> owner_effects: actual native owner services
copy_authority: {
 label: "copy-before-reservation"
 source_hint: "SOURCE_HINT"
 source_section: "SOURCE_SECTION"
 claim: "CLAIM"
 revalidate: "REVALIDATE"
 reserve: "RESERVE"
 forward: "FORWARD"
 release: "RELEASE"
 initialize: "INITIALIZE"
 ready: "READY"
 commit: "COMMIT"
 tail: "TAIL"
 source_hint -> source_section
 source_section -> claim
 claim -> revalidate
 revalidate -> reserve
 reserve -> forward
 forward -> release
 release -> initialize
 initialize -> ready
 ready -> commit
 commit -> tail
}
worker_arena -> copy_authority: claim before any physical mutation
copy_cost: "One word per allocated msection, no fixed VM array. If N sections are allocated, storage is N times sizeof WORD; compared with the former array, metadata delta is (N-64) times sizeof WORD. One acquire/release per attempted winner plus header revalidation. Native ordered-word backend loads each inspected header directly; legacy fallback takes an additional gate around its ordinary read to avoid RMW on read-only storage. Same-section requests and reservation critical sections serialize; payload copy remains parallel. Source metadata trailer stays unchanged. Heap/profile limits unchanged; metadata is charged separately, no measured throughput claim"
copy_authority -> copy_cost
source_bounded_request: {
 label: "source-bounded-request"
 claim: "CLAIM"
 validate_interval: "VALIDATE_INTERVAL"
 prepared: "PREPARED"
 reserved: "RESERVED"
 commit_or_cancel: "COMMIT_OR_CANCEL"
 settled: "SETTLED"
 claim -> validate_interval
 validate_interval -> prepared
 prepared -> reserved
 reserved -> commit_or_cancel
 commit_or_cancel -> settled
}
source_bounded_request -> unequal_admission: selected source replacement; global obligations remain
closed_root_domain: {
 label: "closed-root-domain"
 running: "RUNNING"
 close_writers: "CLOSE_WRITERS"
 frozen_scan: "FROZEN_SCAN"
 owner_cleanup: "OWNER_CLEANUP"
 whole_round_drain: "WHOLE_ROUND_DRAIN"
 reopen: "REOPEN"
 running -> close_writers
 close_writers -> frozen_scan
 frozen_scan -> owner_cleanup
 owner_cleanup -> whole_round_drain
 whole_round_drain -> reopen
}
closed_root_domain -> unequal_admission: selected source replacement; global obligations remain
copy_authority -> source_bounded_request: ownership before space request
closed_root_domain -> source_bounded_request: frozen and scannable inputs
writer_coverage: {
 label: "Source families / enforcement still required"
 rc_chain: "rc-chain / source-replacement"
 rc_payload: "rc-payload / source-replacement"
 generated_entry: "generated-entry / unresolved"
 callback_client_data: "callback-client-data / unresolved"
 still_release: "still-release / partial"
 copy_forwarding: "copy-forwarding / source-replacement"
}
writer_coverage -> owner_effects: inventory is not admission
build_custody: {
 label: "Existing configure / Make / one owned workspace"
 configure_probes: "configure-probes"
 configuration_templates: "configuration-templates"
 source_relocation: "source-relocation"
 native_object_context: "native-object-context"
 configure_probes -> configuration_templates: completed probes plus authenticated substitutions
 source_relocation -> configuration_templates: policy change requires configure
 configuration_templates -> native_object_context: compare last successful object context
}
build_custody -> owner_effects: current source compiled and executed independently
protocols: {
 label: "SysML-selected concurrent contracts / finite safety only"
 capacity_publication: "capacity-publication / source-bounded-request"
 capacity_freeze: "freeze / located-not-C-proof"
 capacity_publication -> capacity_freeze: atomic C-boundary obligation
 capacity_plan: "discover; closeCensus; reserveAt; acknowledge; publishPlan; refuse; observe; returnRefused; unknownResult; retain / missing-adapter"
 capacity_publication -> capacity_plan: atomic C-boundary obligation
 capacity_flip: "flip / missing-adapter"
 capacity_publication -> capacity_flip: atomic C-boundary obligation
 sfun_writer_publication: "sfun-writer-publication / closed-root-domain"
 sfun_protect: "protect / located-not-C-proof"
 sfun_writer_publication -> sfun_protect: atomic C-boundary obligation
 sfun_conversion: "convert; allocateMarker / located-not-C-proof"
 sfun_writer_publication -> sfun_conversion: atomic C-boundary obligation
 sfun_batch: "acquireWriter; storeArgument; releaseWriter; reload; enter / located-not-C-proof"
 sfun_writer_publication -> sfun_batch: atomic C-boundary obligation
 sfun_close: "closeWriters; freeze / located-not-C-proof"
 sfun_writer_publication -> sfun_close: atomic C-boundary obligation
 sfun_scan: "acquire; relocate / located-not-C-proof"
 sfun_writer_publication -> sfun_scan: atomic C-boundary obligation
 sfun_exit: "leave; release / located-not-C-proof"
 sfun_writer_publication -> sfun_exit: atomic C-boundary obligation
 hash_layout_ownership: "hash-layout-ownership / hash-layout-ownership"
 hash_cursor: "beginRead; visit; finishRead / located-not-C-proof"
 hash_layout_ownership -> hash_cursor: atomic C-boundary obligation
 hash_key_movement: "relocate; repairStable / located-not-C-proof"
 hash_layout_ownership -> hash_key_movement: atomic C-boundary obligation
 hash_reference_repair: "freeze; resume / located-not-C-proof"
 hash_layout_ownership -> hash_reference_repair: atomic C-boundary obligation
 hash_access: "lookup; ownedRebuild / located-not-C-proof"
 hash_layout_ownership -> hash_access: atomic C-boundary obligation
 hash_deserialize: "deserialize / located-not-C-proof"
 hash_layout_ownership -> hash_deserialize: atomic C-boundary obligation
}
protocols -> qnt: tests plus exhaustive finite safety and counterexamples
protocols -> lean: interval and root encoding obligations only
protocols -> ascent: source digests plus action coverage plus observed verdicts
ascent -> retire: model checking never supplies missing C refinement
