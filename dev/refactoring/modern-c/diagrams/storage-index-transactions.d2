direction: down
title: "C23 unified storage index: reserve, publish, drain and settle"
"CallerA" -> "OwnerTransaction": "reserve A after exact revision and\ngeneration validation"
"CallerB" -> "OwnerTransaction": "reserve B checks pending live and\ndraining intervals"
"OwnerTransaction" -> "Reserved": "commit interval plus exact lease custody"
"Reserved" -> "RootPreparation": "keep source rooted through allocation"
"RootPreparation" -> "LiveBundle": "publish complete bundle and operation\nresult atomically"
"LiveBundle" -> "LostReply": "response may be absent; commit remains"
"LostReply" -> "ExactQuery": "same immutable request and OperationId"
"ExactQuery" -> "Closing": "observed result permits coordinated\nrevoke"
"LiveBundle" -> "Closing": "close new lookups; retain accepted\nreaders"
"Closing" -> "Drain": "reader scan and lookup grace"
"Drain" -> "LeaseSettlement": "known result plus exact generation and\nLeaseId"
"LeaseSettlement" -> "Unlinked": "atomic lease return and occupancy\nremoval"
"Unlinked" -> "Reuse": "all storage users native pins and GC\ngrace settled"
"Reuse" -> "StaleRejection": "advance without wrap; keep old result\ntombstones"
"LiveBundle" -> "GCScanner": "pinned descriptor; exclusive update slot\nownership"
