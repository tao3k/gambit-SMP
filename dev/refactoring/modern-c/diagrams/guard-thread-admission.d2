direction: down
title: "Gambit paper to C23 thread admission and stable guard ownership"
"GambitPaper" -> "EntrySpec": "PVM calling contract plus separate\nScheme and native return lifetimes"
"SourceOwner" -> "IngressOffer": "preissued stable descriptor and source\nroots; recipient owns nothing yet"
"IngressOffer" -> "MaskConfirmed": "cancellation before confirmation\nleaves source responsibility intact"
"MaskConfirmed" -> "GuardReserved": "claim preallocated capacity; no\ncallback allocation or implicit thread\nbootstrap"
"GuardReserved" -> "RootRegistry": "publish with source roots retained\nuntil same-round acknowledgment"
"RootRegistry" -> "ContextLease": "known root coverage before checked VM\ncontext and TLS binding"
"ContextLease" -> "SchemeEntry": "only now may generated SFUN allocate\nmarker and invoke Scheme"
"SchemeEntry" -> "NestedEntry": "distinct guard; outer root retained\nand inner saved mask is DISABLE"
"NestedEntry" -> "StableExitOwner": "resolve child before outer completion;\nunknown child retains both"
"SchemeEntry" -> "StableExitOwner": "stable supervisor owns roots TLS and\nreturn-domain debt before restore"
"StableExitOwner" -> "Restoration": "restore may fail or never return;\ncustody already stable"
"Restoration" -> "Retirement": "known return then admission closure\nTLS detach and scan grace"
"Restoration" -> "Quarantine": "nonreturn or unknown restoration\nretains root and metadata; no\nautomatic replay"
"EntrySpec" -> "GuardReserved": "Generate checked enrollment before\nPSTATE lookup or marker allocation"
"GambitPaper" -> "NativeReturnDomain": "Native frame lifetime remains\nseparate; stack-segment design is open"
"NativeReturnDomain" -> "StableExitOwner": "Proposed native return-domain hold;\nqualification remains open"
