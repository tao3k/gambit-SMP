direction: right
sdk: OpenSysML SDK
contract: "SysML: 8 cases × p1/p2\noriginal sources and guards"
producer: "Accepted canonical producer\nsame C23 profile and fixed cache"
target: "Target: original work\nwait for finish"
driver: "Driver: original interrupts\nobserve handler → send finish → join"
native: "Original -gsc runner\ncompile and load every fixture"
negative: "Unmodified p1 failure\nretained without PASS credit"
validate: "Python Evidence\nmode + commands + source + completion"
ascent: "ASCENT prefix + five gates\nnot a runtime speedup claim"
ledger: "Independent SMP 5/12\n7 later families remain"
ci: "Remote CI\nseparate source-bound observation"
sdk -> contract -> native
producer -> native
target -> driver: waiting target remains owned
driver -> target: finish only after handler observed
target -> native
negative -> validate: counterevidence
native -> validate -> ascent -> ledger
ci -> ascent: does not manufacture native credit
