direction: right
entry: "Existing native lifecycle entry\nTLS + VM/owner + entry retention"
context: "Execution context\none native VM identity\nno duplicate permit/epoch"
module: "Shared module fixup\nPRIVATE → CLAIMED → READY / REFUSED\nunknown stays non-executable"
descriptor: "Executable descriptor publication\nacquire READY before setup_mod"
read: "Generated host borrows stable VM\ncurrent directory + canonical cell\nacquire presence/value/template"
freeze: "Existing RootTask collective\npark → clear → scan → restore → barrier"
drain: "Last exit\nclear identity before last-entry release\nunknown retains existing custody"
audit: "SysML → ASCENT\nsource + native + QNT\nmatched cost + five gates"
entry -> context
module -> descriptor
descriptor -> read
context -> read
context -> freeze
freeze -> context: "restored roster only"
context -> drain
read -> audit
freeze -> audit
drain -> audit
