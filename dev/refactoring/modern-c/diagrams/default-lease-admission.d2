"root-freeze" -> "writer-exclusion": "Close mutation entry\npoints before first\nmanifest read"
"writer-exclusion" -> "manifest": "Pin actual section\nidentities list and\nfuture restore lengths"
"manifest" -> "lease-budget": "Unique fresh and one\nstack token per worker"
"manifest" -> "physical-split": "Include heap markers\nrestore interval and\nbreak metadata"
"lease-budget" -> "participant-votes": "Publish same generation\nand digest"
"physical-split" -> "participant-votes": "Each owner validates its\ninterval and restoration\nfootprint"
"participant-votes" -> "decision": "Any reject prevents\nsetup; unknown vote\nretains cohort"
"decision" -> "last-reader-acks": "Every member consumes\nsame immutable outcome"
"last-reader-acks" -> "collective-release": "All readers retired\nbefore setup or failure\nreturn"
"collective-release" -> "accepted-setup": "Accept only; no partial\nrollback to old parity"
"collective-release" -> "failure-delivery": "Reject only; same\noutcome consumed by\nevery member"
"failure-delivery" -> "pool-free": "Complete delivery and no\nnative borrowers;\nsingle-use receipt"
"accepted-setup" -> "allocator-epoch": "Guard every fresh\nfallback and context\nrebinding entry"
"allocator-epoch" -> "storage-close": "Drain before resize\ncleanup or metadata\nreclamation"
