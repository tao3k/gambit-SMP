  cut_handler_unwind: "handler-unwind\n_kernel.scm"
  cut_service_effects -> cut_handler_unwind: dependency
  cut_native_entry: "native-entry\nsetup.c"
  cut_post_poll_transfer: "post-poll-transfer\n_t-c-2.scm"
  cut_grant_extent -> cut_post_poll_transfer: dependency
  cut_handler_unwind -> cut_post_poll_transfer: dependency
  cut_resume_copy -> cut_post_poll_transfer: dependency
  cut_resume_copy: "resume-copy\ncapacity-resize.inc"
  cut_resume_loan -> cut_resume_copy: dependency
  cut_resume_loan: "resume-loan\nheap-sections.inc"
  cut_resume_plan -> cut_resume_loan: dependency
  cut_resume_plan: "resume-plan\ncopy-planning.inc"
  cut_service_effects: "service-effects\n_kernel.scm"
  cut_resume_copy -> cut_service_effects: dependency
  proof_entry_envelope -> cut_caller_transfer: conditional premises
  proof_entry_envelope -> cut_grant_extent: conditional premises
  proof_entry_envelope -> cut_c_entry_stores: conditional premises
  proof_entry_envelope -> cut_native_entry: conditional premises
  proof_handler_return -> cut_handler_unwind: conditional premises
  proof_handler_return -> cut_service_effects: conditional premises
  proof_restored_envelope -> cut_resume_plan: conditional premises
  proof_restored_envelope -> cut_resume_loan: conditional premises
  proof_restored_envelope -> cut_resume_copy: conditional premises
  proof_restored_envelope -> cut_post_poll_transfer: conditional premises
}
bootstrap.target.label: "51 target C products regenerated\nNative link and self-emission OPEN"
bootstrap.numeric: "Numeric object RSS refusal\nNo object published"
bootstrap.target -> bootstrap.numeric: configured C23 consumer
numeric_contract: "Numeric host admission: 6 Quint histories" {
