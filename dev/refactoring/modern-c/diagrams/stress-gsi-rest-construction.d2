direction: right
source: Generated entry {
  g7: GET_REST / handler 7
  g9: GET_KEY_REST or GET_REST_KEY / handler 9
  guard: Checked interval and stack floor
  g7 -> guard
  g9 -> guard
}
fast: Existing processed-argument tail ABI
record: Package A {
  key: VM incarnation / slot / generation
  pin: Resolve and pin before first load
  final: Final writes and reader drain before FREE
  key -> pin
  pin -> final: settle after last use
}
frame: Package B {
  input: Caller keeps live window
  roots: RC data label + list, N arguments, K keys, result
  mapped: Configured retry frame + saved RA
  input -> roots: install and confirm
  roots -> mapped: transfer source custody
}
gc: Existing full GC {
  freeze: Frozen origin and scan lease
  repair: Census and moving repair
  restore: Publish repaired view and current interval
  freeze -> repair -> restore
}
resume: Package C {
  reload: Resolve original token and reload repaired slots
  grant: Reserve entire emitted batch in current round
  ready: Initialize result and publish READY
  claim: Claim once and transfer roots to tail ABI
  reload -> grant -> ready -> claim
}
failure: Preserve caller or attempt custody {style.fill: "#fff4cc"}
review: Independent audit {
  cuts: Same GSI with exact and one-short cases
  original: Original p2 then p1, 295 / 300 seconds
  cuts -> original: reviewed evidence
}
source.guard -> fast: enough space
source.guard -> frame.input: short, zero writes and pops
frame.input -> record.key: open attempt
record.pin -> frame.roots: native storage admitted
frame.input -> failure: preparation failure or lost install
frame.mapped -> gc.freeze: publish complete frame first
gc.restore -> resume.reload
resume.grant -> failure: current grant refused
resume.claim -> fast
resume.claim -> record.final: close after transfer
fast -> review.cuts: actual tail and Scheme body

# SysML TFIB producer projection
producer: Compiler producer admission {
  p0: "Admit full group at old root map\ntfib-a-emitter-demand"
  p1: "Back handler spill before ordinary execution\ntfib-a-handler-backing"
  p2: "Limit service consumes pending demand\ntfib-a-demand-consumption"
  p3: "Reload and return before first store\ntfib-a-prewrite-return"
  p1 -> p0: preserve entry backing
  p0 -> p2: shortage before mutation
  p2 -> p3: full grant
  p3 -> p0: revalidate same attempt
  fail: Backed finite failure or explicit wait
  p2 -> fail: no grant
}
producer.p0 -> source.guard: admitted generated group
bootstrap: Existing BC-HOST boundary {
  host: "Coherent whole host compiler\ncurrent source + independent host ABI"
  emit: "Current rest source emits C\n86 source controls; native coverage open"
  backing: "Granted entry-frame publication\nregister both cursor resources before retry"
  target: "Historical inline cohort: 51 C products\nOPEN: shared cohort + self-emission"
  scope: "Physical C host owns attempt scratch\nlive roots + RA define backed prefix"
  scope -> emit: existing resource declaration
  shared: "Shared runtime entry; original ordered checks\nNumeric C smaller; native A open"
  emit -> shared -> target
  plan: "Same instruction / root view / fp / emission frontier\nExpand demand only before first write"
  plan -> shared
  opaque: "OPEN: any-C whole-unit fallback\nActual single host / limit zero / 22493 labels"
  opaque -> target: certify host dependency before retirement
  host -> emit -> target
  backing -> emit: source-level contract
}
bootstrap.target -> producer.p0: qualify before native A
bootstrap.host -> bootstrap.target: "host runtime excluded" {
  style.stroke-dash: 4
}
guard: Physical publication boundary {
  trip: Context limit to actual poll trip
  backing: Burst + spill + break stay owned
  first: Last valid view to first invalid write
  trip -> backing -> first
}
guard.first -> bootstrap.target: same-image evidence required

cscope: Existing C interface scope {
  raw: Raw declaration / initializer / object
  ool: Compiler-owned out-of-line function
  stub: Scheme argument + RA frame / CFUN_OOL / mapped return
  entry: "OPEN: caller grant or own incoming root map\nBefore first slot / RA write"
  entry -> stub: establish whole-frame coverage
  plan: Existing compilation-unit C scope
  qualify: "OPEN: host / header / root / callback dependencies"
  raw -> plan
  ool -> plan
  stub -> plan
  plan -> qualify: provenance is not admission
  resources: "Host-local read / write / declaration closure\nNegative: seven missing R4 declarations\nDEV corrected object compiles; linked gate open"
  resources -> qualify: implicit raw spill and reload are real accesses
}
cscope.qualify -> bootstrap.opaque: qualify before fallback retirement

