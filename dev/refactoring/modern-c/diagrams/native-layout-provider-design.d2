direction: down
scheme: "Gambit Scheme semantic authority\nG3 completion / PointId / FrameSpec / effects / roots"
profile: "Bound target/runtime/provider profile\nLD2 target C ABI facts + LD3 Gambit protocols\nLD1 service-host layout is a separate domain"
plan: "One common physical product plan, in C or Zig\nDescriptorDecision / symbolic point and host bindings\nConstant materialization / runtime fixup obligations"
routes: {
  label: "Provider routes independent of planner language"
  llvm: "PR1 direct LLVM\nC APIs: TargetData / musttail / object emission"
  mlir: "PR2 MLIR then LLVM\nAdmitted dialects, passes and translation\nCustom semantics need explicit support"
  tool: "PR3 IR / bitcode artifact + driver\nZig CLI source recognizes .ll / .bc\nC planner can use the same tool"
}
object: "LD4 selected OS object and linker mechanics\nProvider-owned codegen and ordinary relocations\nNo automatic Scheme object/global identity resolution"
runtime: "Gambit-aware materialization and publication\nRuntime GC / continuation / mixed tail edges\nInit / failure / retained code-map-object lifetime"
account: "Keep accounts separate\nShared contract reconstruction\nLLVM provider delegation\nZig-specific project-support savings and added costs" {
  style.fill: "#e8f2ff"
}
decision: "LLVM delegation is a concrete architecture option\nZig tool role and implementation-language role are independent\nNo positive Zig aggregate bound or native admission yet" {
  style.fill: "#fff0ce"
}
scheme -> plan
profile -> plan
plan -> routes.llvm
plan -> routes.mlir
plan -> routes.tool
routes.mlir -> routes.llvm: "after admitted lowering"
routes.llvm -> object
routes.tool -> object
object -> runtime
runtime -> account
account -> decision
