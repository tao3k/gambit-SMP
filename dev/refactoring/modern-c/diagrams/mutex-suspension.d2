direction: right
decision: "Existing mutex lock\nOwner and deadline decision"
immediate: "Immediate result\nKeep running root view"
suspend: "Actual wait\nTHREAD_SAVE"
commit: "BTQ / current / TOQ\nCommit then release locks"
service: "Restore / interrupt / GC\nOriginal mapped continuation"
retry: "Void resume\nReacquire same mutex\nKeep absolute deadline"
decision -> immediate: "No scheduler save"
decision -> suspend: "Must block"
suspend -> commit: "Root before publication"
commit -> service
service -> retry: "Not granted"
retry -> decision
service -> immediate: "Grant / timeout / abandonment"
