direction: right
entry: "Existing lifecycle admission\nTLS / owner / VM / source / entry borrow"
source: "RC domain\none owner-only clean idle record"
live: "Physical activation\nVM active list + roots + marker"
known: "Known last C use\nunlink → root return → clear"
leave: "Publish clean idle before last entry release"
cleanup: "Entry closure + RC gate\nfree idle before detach"
unknown: "Live / revoked / unknown extent\nretain record, roots and entry"
entry -> source: "take clean idle or allocate"
source -> live: "initialize new logical scope"
live -> known: "existing physical end"
live -> unknown: "no reuse authority"
known -> source: "one idle slot, free excess"
source -> leave
leave -> cleanup
roots: "Existing GC banks / markers\nmulti-shot frame descriptors"
live -> roots
idle: "Idle has no Scheme edges\nworker never scans idle storage"
source -> idle
models: "SysML → ASCENT\nsource/native refinement"
models -> entry
models -> cleanup
formal: "Existing QNT: lifetime histories\nExisting Lean: root-span laws"
models -> formal
benefit: "Complete matched cohort + cost bounds\npositive-benefit publication gate"
models -> benefit
