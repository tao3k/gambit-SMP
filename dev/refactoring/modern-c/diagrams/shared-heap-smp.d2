messages -> execution: "service ownership, not wait state"
messages -> control: "Repair9: one request owner; reusable wait suffix and distinct mapped service activation"
control -> roots: "Repair9: publish wait/service/request slots before park, GC and nonlocal exit"
roots -> collector: "Repair9: R frozen sources survive W worker scan, repair and whole-round closure"
collector -> execution: "Repair9: repaired roots and exact resume authority precede wait/service reentry"
messages -> retirement: "Repair9: terminal reply is not result consumption, last use or physical join"
retirement -> roots: "Repair9: retained unknown work and successor roots remain in the next GC cut"
qualification -> messages: "Repair9: original closed-loop counts, armed target deadlines and matched capacity/peak"
control -> retirement: "Repair9: active detach is not graph absence; captured user suffixes keep their lifetime"
retirement -> collector: "Repair9: complete root absence and last frozen/private reader precede reuse; capacity remains independently gated"
execution -> roots: "Repair9: generated last use, host spill, complete frozen homes and repaired reload form one root publication"
control -> qualification: "Repair9: count actual wait restarts M separately from360 million requests N; subtract required captures, barriers and live user aliases"
messages -> control: "Repair9: completion fast/slow waiting creates sender episodes across all six populations, not only target waits"
collector -> qualification: "Repair9: census, first materialization, forwarded alias repair and heap-frame scans have separate work counts"
retirement -> qualification: "Repair9: last resume writer and ended-Thread live window determine whether retained work is real and deadline-relevant"
messages -> retirement: "Repair9: fuse private fast completion acquisition/result/physical unlock under one qualified lease; no state-only shortcut"
control -> execution: "Repair9: proposed static completion resume PointId uses frame operands, not a fresh callable environment per episode"
execution -> roots: "Repair9: canonical wait-frame binding survives Thread.cont restore, GC relocation and multi-shot incarnation before static resume"
control -> roots: "Repair9: proposed private snapshot frame S keeps closure-value aliasing distinct from mutable caller slots"
execution -> control: "Repair9: static retry validates structural next S before break restore; fixed outcome and user return keep their own paths"
collector -> execution: "Repair9: S forwarding/ancestry repair and fresh decode preserve the same logical payload across GC, not raw addresses"
control -> qualification: "Repair9: proven callable exposure and extra S restoration cost gate closure/capture removal; generic fallback remains counted"
control -> execution: "Repair9: GVM semantic S/checkpoint plan precedes physical FrameSpec and host placement; no C-only closure deletion"
execution -> roots: "Repair9: operand snapshot/check/reload and typed no-GC corridor preserve complete canonical sources"
roots -> collector: "Repair9: actual roster barriers publish S to source-based GC; labels and emitter checks do not synchronize workers"
control -> execution: "Repair9: choose complete generic/static semantic lowering before S publication; no unsupported late helper replay"
execution -> roots: "Repair9: root destination before same-registration authority transfer and ACK; UNKNOWN retains both graphs"
roots -> collector: "Repair9: conversion and rebuilt multi-shot graphs preserve canonical roots, fresh repair and graph identity"
control -> retirement: "Repair9: query settles one conversion/registration; entry alpha is not eliminated-closure or exit credit"
control -> roots: "Repair9: same-wait conversion publishes complete rooted destination before execution/receipt/ACK"
roots -> collector: "Repair9: restore moves canonical roots to active/break ancestry; next W<R roster survives source exit"
messages -> retirement: "Repair9: outcome and cached action are last users; ACK is not complete captured-graph retirement"
execution -> control: "Repair9: query deduplicates within shot, never user multi-shot invocation; closed/materialized/pending alpha populations remain separate"
roots -> retirement: "Repair9: actual RC/full-GC/wait DEV bridge validates controlled query/ACK and reader exclusion; production S/queue authority and native whole-gate evidence stay OPEN"
roots -> execution: "Repair9: actual wait continuation survives original owner exit and two GC-separated user shots; real reflective slot replacement and old alias semantics remain mandatory, not immutable-S admission"
roots -> control: "Repair9: real wait serde preserves native refusal or explicit same-VM identity, captured exception/winding and post-ACK root custody; shared-token alias counterexample stays retained"
control -> retirement: "Repair9: close resolver admission while accepted requests/results retain rooted code/resource scope; ACK ends payload query rights, not physical module lifetime"
control -> roots: "Repair9: pre-registration general fallback differs from post-registration same-wait recovery; query never re-registers and ACK never revokes cached/escaped root users"
