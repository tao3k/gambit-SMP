collector -> allocationRegions: "Destination and restore leases preserve object identity, unique initialization and disjoint physical intervals"
collectionDomains -> retirement: "Scoped writers/queries/native access and all dependent work must close before region or service reclamation"
control -> sharing: "Every restore shot preserves shared frame/denv aliases and actual effects; request end is not environment death"
messages -> execution: "Claim runnable computation, then acquire execution grant; queue membership is not a grant"
messages -> roots: "Queued requests and suspended computations retain authoritative roots until accepted transfer or abandonment"
retirement -> messages: "Close future callbacks and queue producers, settle admitted tasks, then drain last users; never wait on own GC dependency"
generations -> roots: "Minor scan exclusion requires complete root cut, remembered sources and governed continuation/FFI writers"
execution -> roots: "Generated safe PointId and complete updateable FrameSpec roots precede release publication; unparked raw native readers forbid relocation"
roots -> collector: "Acquire exact frozen VM/epoch/source generation; W workers claim the task union of R member-root domains without borrowing carrier identity; task/shard count is independent of R and W, and scan completion retains source lifetime"
collector -> control: "Repair canonical roots and close copy/frontier/Tail, weak work and physical restore reservation before publishing whole-round completion"
control -> execution: "Acquire completed epoch and reload per-shot slots before execution grant; preserve shared heap aliases, repeated restore, wind and required effects"
generations -> collector: "remembered cut and promotion reserve"
messages -> roots: "queued/request roots"
retirement -> roots: "retained unknown origins"
