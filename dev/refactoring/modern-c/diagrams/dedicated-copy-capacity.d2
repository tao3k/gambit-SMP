"old-source-epoch" -> "source-envelope": "Old N and validated Q stay\nfixed during target growth"
"source-envelope" -> "grant-profile": "Bound payload, alignment\nand effective frame\nrequests"
"grant-profile" -> "packing-envelope": "Include threshold charge\nand no-fit waste"
"restore-spans" -> "dedicated-stacks": "R plus execution headroom\nindependently fits"
"dedicated-stacks" -> "destination-target": "P stacks plus K heap\nsections plus E future\nreserve"
"packing-envelope" -> "destination-target": "Global size alone is\ninsufficient; contiguous\ngrants must fit"
"destination-target" -> "detached-reservation": "Stable native owner; no GC\ncallback or old-manifest\nmutation"
"detached-reservation" -> "known-partial": "Actual blocks retained for\nretry or qualified cleanup"
"detached-reservation" -> "unknown-custody": "Uncertain block ownership\npins old roster and\nmetadata"
"known-partial" -> "collective-plan": "Accept only qualified\ncomplete actual grant;\notherwise internal refusal"
"unknown-custody" -> "collective-plan": "Resolve exact attempt\nbefore admission"
"collective-plan" -> "setup": "All members consume\naccepted plan and retire\nlast read"
"collective-plan" -> "alternative-plan": "Refusal is not a Scheme\nerror; preserve old source"
"setup" -> "copy-and-resume": "Enforce same budget through\nstrong weak restore and\nheadroom"
