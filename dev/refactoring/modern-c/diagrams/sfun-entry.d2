direction: right
source: "Registered owner / generated SCMOBJ prefix"
entry: "Existing lifecycle activation\nretains physical C extent"
bank: "One initialized RC span\nprocedure + argument cells"
roots: "Existing RC RootOrigin → RootTask\nsame span in census and scan"
marker: "Marker / conversion / nested Scheme\nGC updates canonical span"
frame: "Noncollecting final frame handoff\nexisting call / trampoline"
logical: "Scheme handler / continuation restored\nC extent may still be live"
landing: "Actual last C use / catcher landing\nkill marker → return borrow → release bank → leave"
unknown: "Unknown owner result\nretain activation and resources"
source -> entry -> bank -> marker -> frame
bank <-> roots: "source gate / immutable count / frozen scan lease"
frame -> logical -> marker: "retain; multi-shot semantics unchanged"
logical -> landing: "outer marker forces physical unwind"
entry -> unknown: "no stop proof"
unknown -> landing: "only proven owner landing"

permanent: "Known-PERM / zero arguments\nno root bank; tagged activation owns entry"
entry -> permanent -> marker
revoke: "Revoke return permission\nretain bank, borrow and physical entry"
logical -> revoke -> landing
quint: "Existing QNT: protocol interleavings\n12 scenarios; revoke != physical exit"
lean: "RootSpan Lean: five array/size laws\nno lifecycle transition duplication"
roots -> lean
revoke -> quint
population: "Original population / fixed120s\n393 pass / 15 known failures; no whole-SMP pass"
landing -> population
