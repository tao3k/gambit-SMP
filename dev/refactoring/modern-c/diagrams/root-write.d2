direction: right
entry: "Actual lifecycle activation\nretained through last physical C use"
primary: "Ordinary RC primary setter\nborrowed identity immutable"
span: "Generated SFUN raw / converted slots\none activation-owned bank"
gate: "One RC source gate\nactual owner / OPEN / not joined\npositive ownership / bound / borrow mode"
roots: "Canonical RC cells\nexisting RootOrigin → RootTask\nsame census / scan coverage"
freeze: "Cooperative freeze / moving GC\npark accesses; retain storage\nreload after restore"
exit: "Actual catcher / last use\nreturn borrow / release / leave"
retired: "Separate BLOCKED VM/code-layout retirement\ncombined proposal has unattributed division failure"
models: "SysML → ASCENT\nQNT: protocol / aliases / borrowing\nLean: reused array arithmetic only"
entry -> primary -> gate
entry -> span -> gate -> roots -> freeze -> exit
freeze -> span: "canonical reload"
entry -> exit: "revocation alone cannot discharge"
retired -> entry: "not part of this stable-ABI RC contract"
models -> gate
models -> freeze
