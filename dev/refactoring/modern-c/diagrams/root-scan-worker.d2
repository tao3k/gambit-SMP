direction: right
round: "Accepted collection round\nactual collector worker" 
dispatcher: "root_round_scan(work, epoch)"
sources: {
  label: "Six frozen source adapters"
  rc: "RC domain + scan lease"
  bank: "Context register/saved/cache bank"
  stack: "Stack / multi-shot frames"
  vm: "VM object"
  globals: "VM global snapshot shards"
  symkey: "Symbol / keyword anchors"
}
admit: "Validate explicit work\ncurrent carrier binding + VM"
scan: "Existing mark_array / mark_continuation\nsame work through private consumers"
finish: "Source SCANNED → DONE\nwhole-round join still required"
carrier: "Physical carrier\nexisting source/current-executor gates"
round -> dispatcher -> admit -> sources -> scan -> finish
carrier -> admit: "validation, never silent substitution"
carrier -> finish: "claim / completion source authority"
models: "SysML → ASCENT\nC refinement + native PBT"
qnt: "Existing QNT: task / phase histories"
lean: "Existing Lean: root / interval laws"
models -> qnt: "reference existing protocol"
models -> lean: "reference existing laws"
models -> admit: "wrong-worker / stale / missing controls"
cost: "Matched cost evidence\nadverse observations retained"
publication: "Positive-benefit publication gate\nDENY: benefit not established"
held: "Candidate and evidence remain local\nno commit / push / PR comment\nprogress delta zero"
models -> publication
cost -> publication
publication -> held
