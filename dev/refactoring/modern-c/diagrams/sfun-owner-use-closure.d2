direction: down
title: "C23 SFUN owner closure, current invocation and multi-shot Scheme control"
"One_Rooted_Marker_Owner" -> "Body_or_Input_Error": "one existing native reference; owner\nstays valid"
"Body_or_Input_Error" -> "Current_Call": "new InvocationEpoch; same marker owner"
"Current_Call" -> "Result_Conversion": "___call returns NO_ERR; owner remains\nopen"
"Result_Conversion" -> "Conversion_Error_Handler": "typed conversion failure; preserved\nprocedure and dynamic exception\nhandler"
"Conversion_Error_Handler" -> "Current_Call": "retry with new invocation, same marker"
"Captured_Old_Scheme_Origin" -> "Current_Call": "live same-owner return may complete\ncurrent call"
"Old_Completion_Receipt" -> "Current_Call": "query only; cannot close or decrement\ncurrent use"
"Result_Conversion" -> "Final_Use_Check": "success and all future\nconverter/cleanup uses accounted"
"Final_Use_Check" -> "Owner_Closure_Record": "close admission, drain users, bind\nfinal epoch"
"Current_Call" -> "Unknown_Native_Escape": "stable guard keeps roots/code; local\nEND_SFUN may be skipped"
"Unknown_Native_Escape" -> "Confirmed_Subtree_Exit": "exact landing plus descendant/owner\nlast-use evidence"
"Confirmed_Subtree_Exit" -> "Owner_Closure_Record": "abnormal mode; no current complete\nnative signer"
"Owner_Closure_Record" -> "Physical_Drop_Gap": "NoAbandon and GC/count-writer\nexclusion"
"Physical_Drop_Gap" -> "Committed_Release": "one owned decrement; commit before\nreply/unmask"
"Committed_Release" -> "Idempotent_Query": "lost reply performs no second\ndecrement"
"Committed_Release" -> "Expired_Scheme_Prefix": "multi-shot Scheme computation remains\npossible; native return rejected"
"Expired_Scheme_Prefix" -> "Root_and_Code_Retirement": "last capture, GC and global image\nowners must leave"
