direction: right
model: "SysML\nordered source partition"
private: "include/_gambit/\nsnake_case private templates"
probe: "gambit.h.in\nconfigure-probe driver"
aggregate: "config.status\nordered concatenation + substitution"
public: "gambit.h\nflat public aggregate"
consumers: "generated C / runtime / FFI\nC23 compilation"
source_evidence: "exact byte reconstruction\nmodule and driver identities"
native_evidence: "configured equality / dependencies\ndistribution / actual consumers"
ascent: "ASCENT\nsource versus consumer qualification"
model -> private: "native SysML projection"
private -> probe: "balanced includes; guard slices inline"
private -> aggregate: "explicit AC_CONFIG_FILES inputs"
aggregate -> public
public -> consumers
model -> source_evidence
consumers -> native_evidence
source_evidence -> ascent
native_evidence -> ascent
ascent -> consumers: "qualified scope; no SMP retirement or commit authority"
