direction: down
title: "C23 nested unwind, root custody and descriptor retirement"
"Admitted_Outer_Source" -> "Outer_Target_Roots": "publish; collective scan admission\nack; source release"
"Outer_Target_Roots" -> "Outer_Guard": "rooted entry and descriptor lease"
"Outer_Guard" -> "Admitted_Inner_Source": "source protected before callback\npayload read"
"Admitted_Inner_Source" -> "Inner_Target_Roots": "publish; separate ack; release source"
"Inner_Target_Roots" -> "Inner_Guard": "fresh activation and native return\ndomain"
"Inner_Guard" -> "Captured_Scheme_Frames": "multi-shot frames retain descriptor\ndependency"
"Inner_Guard" -> "Stable_Subtree_Escrow": "outer unwind closes descendants and\ntransfers custody"
"Stable_Subtree_Escrow" -> "Landing_Or_Unknown": "invalidate native return rights;\nretain all leases"
"Landing_Or_Unknown" -> "Known_Landing": "only exact target/thread/operation\nreceipt qualifies"
"Landing_Or_Unknown" -> "Unknown_Custody": "lost reply; no timeout-based freeing"
"Known_Landing" -> "Postorder_Guard_Settlement": "inner first; then outer"
"Postorder_Guard_Settlement" -> "Root_Admission_Close": "also require holders and fresh\nresumptions drained"
"Root_Admission_Close" -> "Root_Grace": "already admitted GC readers continue"
"Root_Grace" -> "Root_Slots_Retired": "source/target slots no longer borrowed"
"Captured_Scheme_Frames" -> "Image_Lease_Join": "logical native return stale;\ndescriptor still live"
"Root_Slots_Retired" -> "Image_Lease_Join": "code-reader grace and known native\nexit"
"Image_Lease_Join" -> "Local_Descriptor_Retired": "other VM/image owners remain an\nexternal condition"
