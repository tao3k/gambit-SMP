direction: right
origin: "Origin RC root\nGC updates stable cell"
closed: "Closed old cohort\nreload after GC"
grant: "Allocator grants\nall stack/heap pairs + resume allowance"
setup: "Initialize exact pairs\nchild RC cells"
park: "Create native children\npark before TLS / GC / Scheme"
commit: "OP_SET_PROCESSOR_COUNT\nRUN release/acquire"
entry: "Existing sync loop\nVM receipt retains startup RC root"
marker: "GC-aware marker takes value\nclear VM receipt → return root borrow"
scheme: "Original Scheme entry\ntail calls / multi-shot control preserved"
early: "Pre-marker thread_exit\nVM receipt survives vanished C activation"
joined: "Known native join\ncoordinator releases remaining startup root"
abort: "ABORT → join every created child"
refund: "Known joins\ncleanup actual slots → refund charge"
retain: "Unknown join\nretain roots + grants + metadata\nrefuse owning VM reuse / reclamation"
origin -> closed -> grant -> setup -> park -> commit -> entry -> marker -> scheme
entry -> early -> joined
setup -> abort: failure
park -> abort: partial create failure
abort -> refund: known quiescence
abort -> retain: unknown
model: "SysML authority → ASCENT gates\nQNT: interleavings\nLean: conditional arithmetic / intervals\nC + native tests: concrete refinement"
model -> grant: coverage premise
model -> commit: publication guard
