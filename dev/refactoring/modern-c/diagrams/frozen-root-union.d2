direction: right
complete_view -> roster -> close -> freeze -> scan -> drain -> restore -> resume
"VM" -> freeze: "canonical source"
"symbol/keyword" -> freeze: "canonical source"
"RC" -> freeze: "canonical source"
"globals" -> freeze: "canonical source"
"stack" -> freeze: "canonical source"
"bank" -> freeze: "canonical source"
templates: "Shared permanent image code"
overrides: "VM-local override + presence"
templates -> overrides: "fallback; local rebind reset"
overrides -> scan: "owning globals shard"
entry_roots: "Raw Scheme argument RC roots before marker GC"
entry_roots -> freeze
drain -> restore: "local DONE retains source lease"
cpu_alias: "Raw CPU cell fixup3/4: UNIMPL"
