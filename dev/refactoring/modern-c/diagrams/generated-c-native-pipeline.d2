direction: down
scheme: "Gambit Scheme semantics\nbindings, closure / control / effects / roots"
schema: "Authoritative Scheme contract schema\nobjects, operations, service states, roles"
facts: "Effective target / ABI / access facts\nexisting configure / typed profile seam"
complete: "Scheme semantic completion\nGVM -> explicit checks / roots / frames / PointIds"
plan: "Scheme common native planner\nimmutable ResolvedNativePlan\nno live handles or private C label ordinals"
scheme -> complete
schema -> complete
facts -> complete: "capability negotiation"
complete -> plan
providers: {
  label: "Independent native providers"
  c: "Mainline: Scheme C renderer\ntyped headers + descriptors + host C\npolicy calls / module product"
  llvm: "Optional direct LLVM provider\nqualified maps / control / relocation"
}
plan -> providers.c
plan -> providers.llvm
early: "Early immutable Scheme export\nbefore normalization\nstructured FFI / lexical / order facts"
mlir: "Optional MLIR compiler service\ncustom Scheme effect / control semantics\nqualified lowering to common runtime contract"
scheme -> early
early -> mlir
mlir -> complete: "validated semantic result; recompute affected facts"
runtime: "Modern C runtime services\nRootRegistry / BarrierLog / ReleaseCoordinator\nGC / continuation / native leaves remain explicit"
providers -> runtime: "same admitted contract, independent evidence"
instances: "Fresh VM/context bindings and live instances\nroots / epochs / reservations / task custody"
runtime -> instances
