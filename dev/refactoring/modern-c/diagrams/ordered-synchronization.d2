direction: right
ordered_word: "ordered-word\nVolatile polling as synchronization authority"
ticket_owner: "ticket-owner\nDuplicated debug/release volatile current reads and implicit full-fence ownership assumptions"
collective_slot: "collective-slot\nSeparate sync_id0/1/2 and sync_op0/1/2 fields, early reset before payload copy"
predicate_wait: "predicate-wait\nSYNC_INIT_MSG, SYNC_GET_MSG and SYNC_SEND_MSG split protocol"
physical_stop: "physical-stop\nGC phase visibility relying on volatile sync flags"
legacy_arithmetic: "legacy-arithmetic\nSigned-overflow increment in emulated word counter"
ordered_word -> ticket_owner: "Release current-ticket write is read by acquire admission; ordinary protected queue data follows that edge"
ordered_word -> collective_slot: "Release READY/acquire read protects payload; release EMPTY/acquire observation protects reuse after copy"
collective_slot -> predicate_wait: "Stamp owns visibility; recipient mutex and shared-CV broadcast own waiting, without extending deadlines"
predicate_wait -> physical_stop: "Upward arrivals and downward result form the root-stop and resume happens-before cuts; membership stays fixed for that collective"
