"frozen-roster" -> "manifest": "Freeze finite leases and\ncomplete producer\nclasses"
"manifest" -> "capacity-plan": "Sum per-lease threshold\nand prepare budgets;\nchecked allocation"
"capacity-plan" -> "collective-admit": "All participants see the\nsame success or failure\nbefore flip"
"collective-admit" -> "copy-owner": "One open node\nreservation precedes\nforwarding"
"copy-owner" -> "threshold-close": "Committed spans uniquely\ncharge a new successor\nnode"
"copy-owner" -> "early-close": "Partial or empty close\nretains prior node and\nmarker"
"early-close" -> "lease-prepare": "Preparing next lease\nissues one new node"
"threshold-close" -> "same-pool-ledger": "Pair birth with\nroot/child reserve\nexactly once"
"lease-prepare" -> "same-pool-ledger": "No separate acceptance\non queue publication"
"same-pool-ledger" -> "weak-continuity": "Carry old occupancy plus\nunfinished physical span"
"weak-continuity" -> "retire-cut": "Allocation close and old\nlast-user obligations\nboth required"
