direction: down
title: "C23 catcher landing, marker effect custody and GC retirement"
"Admitted_Roots_and_Catchers" -> "Private_Subtree_Preparation": "original native references and roots\nstay owned"
"Private_Subtree_Preparation" -> "Known_Private_Rollback": "release private extra leases only"
"Private_Subtree_Preparation" -> "Unknown_Preparation_Custody": "old executor/pins retained until\nqualified reconciliation"
"Private_Subtree_Preparation" -> "Stable_Escrow_Record": "atomic commit after full preparation"
"Stable_Escrow_Record" -> "Inner_Catcher": "unwind issued; no landing receipt yet"
"Inner_Catcher" -> "Restored_Parent_Catcher": "destination mismatch propagates"
"Restored_Parent_Catcher" -> "Target_Catcher_Restored": "caught frame is outer; current catcher\nbecomes prior frame"
"Target_Catcher_Restored" -> "Classified_Landing_Record": "check operation, frame, thread, error\nand marker; freshly rooted data"
"Classified_Landing_Record" -> "Exclusive_Marker_Release": "NoAbandon and GC/writer exclusion"
"Exclusive_Marker_Release" -> "Effect_Before_Receipt": "plain decrement has happened; stable\ncustodian cannot abandon"
"Effect_Before_Receipt" -> "Committed_Release_Record": "commit before releasing exclusion or\nreturning reply"
"Committed_Release_Record" -> "Idempotent_Reply_Query": "lost reply never replays decrement"
"Both_Markers_Committed" -> "Captured_Scheme_Resumption": "guards settled; fresh Scheme ticket;\nnative return remains expired"
"Captured_Scheme_Resumption" -> "GC_Registry_Cell": "freeze context before relocation"
"GC_Registry_Cell" -> "GC_Context_Cell": "partial update held under scanner\nownership"
"GC_Ready_Join" -> "Root_And_Code_Grace": "coherent cells AND initialized payload\nbefore exposure; final capture and\nreader closure"
"Root_And_Code_Grace" -> "Descriptor_Retirement": "last captured/native/scanner/global\nowner closure"
"Classified_Landing_Record" -> "Target_Invocation_Exit": "caller-side evidence after the\nidentified ___call returns"
"Target_Invocation_Exit" -> "Owner_Last_Use_Check": "invocation return alone does not close\nmarker owner; qualify final use"
"Committed_Release_Record" -> "Outer_Marker_Release": "inner reference committed; target\ninvocation-exit receipt also required"
"Outer_Marker_Release" -> "Both_Markers_Committed": "separate outer effect and commit under\nsame qualified custody"
"GC_Registry_Cell" -> "Payload_Initialization": "root address can be updated before\ncopying payload"
"GC_Context_Cell" -> "GC_Ready_Join": "all registered cells coherent; payload\nalso required"
"Payload_Initialization" -> "GC_Ready_Join": "initialized payload; coherent context\ncell also required"
"Owner_Last_Use_Check" -> "Invocation_And_Owner_Closure": "___run final-use profile; outer SFUN\nretry closure remains unresolved"
"Invocation_And_Owner_Closure" -> "Outer_Marker_Release": "invocation receipt AND owner-use\nclosure; same operation and marker\nowner"
