direction: down
title: "C23 RC lifecycle: allocation, root admission, custody and physical release"
"SchemeAndNativeCaller" -> "StableAttempt": "operation identity and preallocation\ncustody before allocation"
"StableAttempt" -> "CheckedExtent": "C23 checked header plus payload size"
"CheckedExtent" -> "NoStorageFailure": "overflow or synchronous NULL: definite\nno registration"
"CheckedExtent" -> "PrivateNativeBlock": "success retains header base and\nallocator provenance"
"PrivateNativeBlock" -> "IndexReservation": "check overlap and record private\nallocation custody"
"PrivateNativeBlock" -> "PrivateAbort": "never-linked rollback uses private\ndestructor contract"
"IndexReservation" -> "ScanVisibleCarrier": "root and descriptor protection before\npublication"
"ScanVisibleCarrier" -> "PublishedResult": "one root bundle and operation result\ncommit"
"PublishedResult" -> "UnknownCommit": "lost response retains allocation and\nsource hold"
"UnknownCommit" -> "StableVMOwner": "context exit transfers responsibility;\nno cleanup_rc bypass"
"StableVMOwner" -> "ExactQuery": "same operation and request; definitive\noutcome only"
"PublishedResult" -> "CloseAndDrain": "close raw borrow admission and settle\ncaller references"
"ExactQuery" -> "CloseAndDrain": "observed commit authorizes release\nprotocol"
"CloseAndDrain" -> "Unpublish": "withdraw root-use view; retain owned\nextent until physical free"
"PrivateAbort" -> "Unpublish": "definite nonpublication and private root\nwithdrawal"
"Unpublish" -> "ScanGrace": "old root views and descriptor users\ndrained; extent still owned"
"ScanGrace" -> "PhysicalFree": "free header base only with exact permit"
"PhysicalFree" -> "FreeOutcomeUnknown": "never repeat irreversible free on\nuncertainty"
"PhysicalFree" -> "NextGeneration": "known completion; address may be equal\nbut identity differs"
"NextGeneration" -> "OldTokenRejection": "expected generation required from caller"
"CurrentRawAPI" -> "AdmissionRefusal": "address-only input cannot prove expected\ngeneration"
