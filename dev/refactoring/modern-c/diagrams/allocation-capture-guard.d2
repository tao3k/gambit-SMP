direction: down
title: "C23 allocation capture: noescape segment and stable exit owner"
"Caller" -> "StableGuard": "reserve stable metadata root and\ncompletion identity before native\nentry"
"StableGuard" -> "MaskedInvocation": "confirm saved cancellation state and\nnoescape profile; no pool lock across\nallocator"
"MaskedInvocation" -> "UnrecordedReturn": "raw native effect; local pointer not\nreconstructible by an outer catcher"
"UnrecordedReturn" -> "CapturedRecord": "capture original base before header\ncallbacks debug logger or cancellation\nrestore"
"CapturedRecord" -> "StableExitOwner": "publish supervisor ownership before\nrestoration can abandon execution"
"StableExitOwner" -> "Logger": "preserve vfprintf and fflush after\ncapture; hold stream lifetime"
"Logger" -> "NestedFFI": "Optional admitted hook; current logger\nhas no proven Scheme route"
"NestedFFI" -> "NestedSettlement": "Separate child ticket; settle only its\nown identity"
"Logger" -> "IndexAdmission": "No active child; ordinary I/O error\npreserves allocation"
"UnrecordedReturn" -> "Quarantine": "protocol violation loses recoverable\npointer; retain identity deny retry\nand teardown"
"StableExitOwner" -> "Quarantine": "restore unknown or cancellation\nabandonment retains captured candidate"
"NestedSettlement" -> "IndexAdmission": "Known child result and logger\ncompletion required"
"NestedFFI" -> "Quarantine": "Unknown child retains parent; no outer\nhandoff"
