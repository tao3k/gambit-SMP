direction: right
classes: {
  open: {style.fill: "#fff0dc"}
  owner: {style.fill: "#e8f1fb"}
}
census: "census\ntarget_processor_count_ scalar and conditional-only nominal floor" {class: owner}
grant: "grant\nEach new setup independently acquiring sections and falling into fatal sharing fallback" {class: owner}
roots: "roots\nthread.data_scmobj and pre-sync C local as implicit roots" {class: owner}
publication: "publication\nPublish count before pthread_create; fatal on partially created member population" {class: owner}
failure: "failure\nerrno-based pthread result decoding; ignored shrink join; reclaim without quiescence" {class: owner}
retirement: "retirement\nUnconditional free_still_objs/cleanup_rc on successful member retirement" {class: owner}
census -> grant: custody / prerequisite
roots -> grant: custody / prerequisite
grant -> publication: custody / prerequisite
publication -> failure: custody / prerequisite
failure -> retirement: custody / prerequisite
authority: SysML needs and routes
policy: ASCENT exact identity and evidence class
quint: QNT bounded histories
lean: Lean conditional laws
native: Current-source native caller / bootstrap
copy: "copy-once\nOPEN: unique scans, fragments, pre-flip bound" {class: open}
whole: "Host-budget p11 + C refinement; OPEN / commit blocked" {class: open}
authority -> policy
policy -> quint
policy -> lean
policy -> native
quint -> grant: finite only
lean -> publication: conditional only
native -> retirement: own evidence scope
census -> copy
copy -> whole
retirement -> whole
