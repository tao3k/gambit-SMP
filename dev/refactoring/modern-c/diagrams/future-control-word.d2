direction: down
title: "C23 shared control word and cross-owner publication"
"Task occurrence pin" -> "Route + ready word": "no reuse while any owner/observer/root lives"
"Reserve CAS" -> "Route + ready word": "0 -> 1; whole expected word must match"
"Prepared child root" -> "Child completion CAS": "payload/root first; CAS merges +4, retains source carrier"
"Child completion CAS" -> "Route + ready word": "0/1/2/3 -> 4/5/6/7; old splitter expected must fail"
"Split commit CAS" -> "Route + ready word": "1 -> 2 or 5 -> 6; preserve ready bit"
"Route + ready word" -> "Activator acquire": "reads commit or qualifying completion RMW release sequence"
"Activator acquire" -> "Active ledger release": "carry commit visibility across owners"
"Active ledger release" -> "Worker acquire and claim": "inactive -> active -> claimed; notification is not permission"
"CAS failure" -> "Reclassify and rebuild": "refresh observed value; clear intent; no grant or root release"
"GC root adapter" -> "Prepared child root": "physical scan/update remains unresolved"
