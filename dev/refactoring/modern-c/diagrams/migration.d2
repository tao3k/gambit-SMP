# Derived from GambitRefactoring MigrationStage metadata. Nodes are design/qualification prerequisites.
direction: down
sourceCut: "sourceCut\nBind source, capability,\nwriter/consumer and failure\ninventories"
schema: "schema\nScheme semantic completion and\ngenerated frame/root/entry schema"
buildGraph: "buildGraph\nSemantic dependency graph, memoized\nplanning, action cut and shared budget"
entryPark: "entryPark\nRoot-safe host entry, callback origin,\npark/reload and acquired-effect plans"
workCore: "workCore\nCollector work context, producer close\nand parent/Tail handoff"
generation: "generation\nNursery/promotion, barriers and mature\ncontinuation scan policy"
releaseDrain: "releaseDrain\nResource classes, release acceptance,\nWaitContext and descendant drain"
exitLifecycle: "exitLifecycle\nOutcome owner, participant removal,\nOS-user drain and final reclamation"
nativeClosure: "nativeClosure\nBuild one selected modern-C runtime\nwith exact semantic/native ABI closure"
qualification: "qualification\nSeparate semantic, native stability,\nweak-memory and cost qualification"
retirement: "retirement\nRemove each named old semantic or\nmechanism owner"
sourceCut -> schema
sourceCut -> buildGraph
schema -> entryPark
schema -> workCore
entryPark -> workCore
workCore -> generation
schema -> generation
workCore -> releaseDrain
entryPark -> releaseDrain
releaseDrain -> exitLifecycle
workCore -> exitLifecycle
entryPark -> exitLifecycle
buildGraph -> nativeClosure
schema -> nativeClosure
generation -> nativeClosure
exitLifecycle -> nativeClosure
nativeClosure -> qualification
qualification -> retirement
