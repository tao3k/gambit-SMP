direction: right
freeze -> census -> reserve -> publish_decision -> flip -> roots -> descendants -> transfer -> restore -> owner_cleanup -> resize_result -> resume
"VM" -> roots: "canonical source"
"symbol/keyword" -> roots: "canonical source"
"RC" -> roots: "canonical source"
"globals" -> roots: "canonical source"
"stack" -> roots: "canonical source"
"bank" -> roots: "canonical source"
worker: "W private copy/scan authorities"
worker -> descendants
census: "read-only typed closure; object/frame extents"
reserve: "R restore spans + sealed K-section copy prefix"
publish_decision: "all R observe ACCEPT / REFUSE / RETAIN before flip"
restore: "R owners; W tails plus R-W disjoint spans"
owner_cleanup: "R original native owners"
