direction: down
title: "C23 exit-domain producers, data drain and key retirement"
"external gate" -> "registration serial": "close admission; no pair dedup"
"registration serial" -> "in-flight escrow": "retain operation ACK beyond node lifetime"
"in-flight escrow" -> "callback result": "pop is not completion"
"callback result" -> "node free result": "separate last uses"
"tail finalizers" -> "registration serial": "descendant producer permit while services live"
"node free result" -> "producer closure": "all known done; no unresolved publication"
"producer closure" -> "key reader drain": "close key gate; wait admitted lookups"
"Windows resource duty" -> "TSD detach": "no retiring-data dependency"
"key reader drain" -> "TSD detach": "same epoch release/acquire"
"TSD detach" -> "local data receipt": "clear known before free"
"local data receipt" -> "cache and owner roster": "independent external authority"
"cache and owner roster" -> "generic key retirement": "all TLS users including no-table readers"
