"stack-descriptor" -> "copied-span": "Normalize RETI;\nauthenticate fs/link"
"copied-span" -> "physical-tile": "No holes; exact header\nwalk including padding"
"physical-tile" -> "chunk-seal": "Every overlapping\nwriter closed"
"copier-fixup" -> "chunk-seal": "Seal pending\npredecessor and\nterminal"
"chunk-seal" -> "release-publish": "Marker plus full\ncoverage"
"release-publish" -> "acquire-claim": "Object and chunk\nauthorities distinct"
"acquire-claim" -> "scanner": "Validate exact epoch\nand owned interval"
"local-frontier" -> "scanner": "Per-object seal also\nrequired"
"strong-producers" -> "strong-closure": "Private Tail copies\nroots queued still\ndebt all settled"
"strong-closure" -> "classify-all": "Frozen context lists\nand roster"
"classify-all" -> "decision-cut": "All owners including\nempty acknowledge"
"decision-cut" -> "weak-producers": "All six route classes\ninherit permission"
"weak-producers" -> "child-reservation": "Reserve before parent\nfinal release"
"child-reservation" -> "weak-closure": "Unknown delivery\nretains existing task"
"weak-closure" -> "cleanup": "No new weak roots;\nexternal hooks\nseparately admitted"
"chunk-seal" -> "producer-ledger": "Retain delayed chunk\nas phase debt; source\nrelation open"
"weak-producers" -> "producer-ledger": "Same epoch task\nidentity"
"producer-ledger" -> "weak-closure": "Private queued Tail\nstill child debt zero"
"terminator" -> "queue-link-alias": "Next leading link\nequals prior term"
"queue-link-alias" -> "C11-obligation": "Scanner reads need\nsynchronized or\nimmutable metadata"
qualification: "Conditional model induction\nNative allocation / phase / C11 open"
