"forward" -> "copying": "winner owns payload"
"initialize" -> "publish": "initialized payload"
"publish" -> "claim": "release FIFO publish"
"claim" -> "scan": "transfer scan custody"
"scan" -> "idle": "skip Tail field"
"private" -> "idle": "drain private work"
"idle" -> "strong-cut": "last active decrement"
"strong-cut" -> "weak-cut": "weak work reopens scan"
"weak-cut" -> "cleanup": "cleanup remains"
"frame-lock" -> "publish": "frame copier lock"
"synchronous-binding" -> "idle": "carrier binding"
"round-counters" -> "idle": "two round counters"
"object-ready" -> "publish": "publish scan readiness"
"object-authority" -> "scan": "object scan completion"
"copying" -> "initialize": "winner copies payload"
"forward" -> "tail": "winner reserves first field"
"tail" -> "idle": "settled Tail required"
"publish" -> "tail": "Tail may remain pending"
