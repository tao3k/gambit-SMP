direction: down
vars: { d2-config: { layout-engine: elk } }
host: { label: "host\ncomplete current compiler source graph -> independent AOT host ABI -> emitter for target ABI; interpreted igsc retained as a diagnostic" }
argv: { label: "argv\nprocess.scm command-line/script-command-line -> igsc canonical processed argv -> main.scm command-args" }
inventory: { label: "inventory\nleased source-state inputs -> all top-level lib/gsi/gsc _*.c -> bootclean -> complete generated hash inventory" }
target-native: { label: "target-native\nsame Bazel configure profile -> generated C -> target libgambit/gsi/gsc" }
temporary-roots: { label: "temporary-roots\nGC_SAVE/RESTORE1..3 and os_setup six service families -> execution_context.saved -> mark_execution_roots -> reload/clear" }
self: { label: "self\nnew target gsc -> fresh bootclean -> target self-source pass -> hash/identity receipt" }
semantics: { label: "semantics\nnew target gsc -exe -> tests/frame-continuation-roots.scm -> real map capture, two restores, GC and native call" }
startup-capacity: { label: "startup-capacity\ncurrent_vm_resize -> vm_resize_pstate -> GC resize_heap -> setup_pstate/setup_mem_pstate -> two physical startup sections per new context" }
host -> argv: "contract + byte-bound result"
argv -> inventory: "contract + byte-bound result"
inventory -> temporary-roots: "contract + byte-bound result"
temporary-roots -> target-native: "contract + byte-bound result"
target-native -> self: "contract + byte-bound result"
self -> startup-capacity: "contract + byte-bound result"
startup-capacity -> semantics: "contract + byte-bound result"
models: { label: "Component proof obligations (SysML authority)"
  BC-HOST: { label: "BC-HOST\nnative-host\nevidence/research/modern-c-bootstrap/hash-index-host.json" }
  BC-ARGV: { label: "BC-ARGV\nnative-host\nvendor/gambit/gsc/igsc.scm" }
  BC-PRODUCTS: { label: "BC-PRODUCTS\nnative-first-pass\nevidence/research/modern-c-bootstrap/hash-index-reviewed-bootstrap.recipe.json" }
  BC-TEMP: { label: "BC-TEMP\nnative-control\nvendor/gambit/tests/runtime-roles.c" }
  BC-QNT: { label: "BC-QNT\nquint\ndev/refactoring/modern-c/models/quint/bootstrap_cohort.qnt" }
  BC-COVER: { label: "BC-COVER\nlean\ndev/refactoring/modern-c/models/lean/BootstrapCohort.lean" }
  BC-REFINE: { label: "BC-REFINE\nlean-source-refinement\ndev/refactoring/modern-c/models/lean/RuntimeRoles.lean" }
  BC-NATIVE: { label: "BC-NATIVE\nnative\nevidence/research/modern-c-bootstrap/hash-index-reviewed-bootstrap.recipe.json" }
  BC-EARLY-GC: { label: "BC-EARLY-GC\nnative\nvendor/gambit/lib/mem.c" }
  BC-ADMISSION: { label: "BC-ADMISSION\nascent\ndev/modeling/ascent/commit-admission.rules.scm" }
  BC-CAP-QNT: { label: "BC-CAP-QNT\nquint\ndev/refactoring/modern-c/models/quint/context_startup_capacity.qnt" }
  BC-CAP-LEAN: { label: "BC-CAP-LEAN\nlean\ndev/refactoring/modern-c/models/lean/ContextStartupCapacity.lean" }
  BC-CAP-NATIVE: { label: "BC-CAP-NATIVE\nnative\nvendor/gambit/lib/setup.c" }
}
host -> models.BC-HOST: "requires exact scope + evidence"
argv -> models.BC-ARGV: "requires exact scope + evidence"
target-native -> models.BC-PRODUCTS: "requires exact scope + evidence"
temporary-roots -> models.BC-TEMP: "requires exact scope + evidence"
inventory -> models.BC-QNT: "requires exact scope + evidence"
inventory -> models.BC-COVER: "requires exact scope + evidence"
temporary-roots -> models.BC-REFINE: "requires exact scope + evidence"
self -> models.BC-NATIVE: "requires exact scope + evidence"
semantics -> models.BC-EARLY-GC: "requires exact scope + evidence"
semantics -> models.BC-ADMISSION: "requires exact scope + evidence"
startup-capacity -> models.BC-CAP-QNT: "requires exact scope + evidence"
startup-capacity -> models.BC-CAP-LEAN: "requires exact scope + evidence"
startup-capacity -> models.BC-CAP-NATIVE: "requires exact scope + evidence"
old: { label: "Old generated C + new runtime header\nREJECTED: 4 modules, 29 field accesses"; style.fill: "#ffe4dd" }
old -> inventory: "regenerate; no carrier compatibility aliases"
proof: { label: "SysML -> ASCENT\nQNT coverage / argv / self-pass counterexamples\nLean concrete-source refinement OPEN" }
semantics -> proof: "actual oracle result required"
gate: { label: "Five conjunctive commit gates\nNo native result from model-only evidence"; style.fill: "#fff0c2" }
proof -> gate
