"source-marker" -> "unified-atomic": "All classifiers and\nwriters atomically\ncompatible"
"source-marker" -> "split-record": "Immutable marker;\nmutable queue next\nseparate"
"unified-atomic" -> "transport-permit": "Qualified storage and\nlifetime"
"split-record" -> "transport-permit": "Reserved node pool and\nretained dummy head"
"strong-close" -> "classify-all": "No hidden strong\ndelayed debt"
"classify-all" -> "weak-cut": "Same epoch and all\ncontext lists"
"weak-cut" -> "accept-delayed": "One task identity and\naccepted debt"
"accept-delayed" -> "seal-delayed": "Keep original\nchunk/frame/root pin"
"seal-delayed" -> "queue-publish": "Transport permit plus\nwhole physical seal"
"transport-permit" -> "queue-publish": "Guarded product; real\nC issuer open"
"queue-publish" -> "scan-owner": "Same work debt;\nunknown ack not\nanother task"
"scan-owner" -> "derived-child": "Reserve before\nreleasing parent"
"derived-child" -> "weak-complete": "Root admission closed\nand all work zero"
"weak-complete" -> "future-users-closed": "Cleanup and callbacks\nmust not reuse queue"
"future-users-closed" -> "head-detached": "Drop lifetime pin; no\nnew work"
"head-detached" -> "epoch-retired": "Receipt observers also\nretired"
"epoch-retired" -> "storage-free": "Product permits\ntransport reclamation\nonly now"
qualification: "Conditional model induction\nNative allocation / phase / C11 open"
