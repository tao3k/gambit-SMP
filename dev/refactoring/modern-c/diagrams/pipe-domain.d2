direction: right
factory: "Pipe factory\none managed mutex before publication\nvector / string / u8vector"
endpointA: "Endpoint A"
endpointB: "Endpoint B"
domain: "One source domain\nFIFO / buffer cursors / close flags"
wait: "Release → wait → reacquire\nrecheck actual predicate\ntimeout hook exits released"
gc: "Existing Scheme roots / GC\nshared mutex alias remains traced\nno native pointer cache"
close: "Close publication + peer wake\nunder the same domain"
generation: "One IO generation + five linker recipes\n50 unchanged generated artifacts reused\nexisting Make / C23 / same workspace"
models: "SysML → ASCENT\nQNT: pipe owner/wait/close\nLean: no new duty"
factory -> endpointA
factory -> endpointB
endpointA -> domain
endpointB -> domain
domain -> wait -> domain
close -> domain
factory -> gc
generation -> factory
models -> domain
models -> wait
