direction: right
source: "Actual source owner\nOPEN / not joined / RC gate"
register: "Private or repeated registration\nno early same-domain bypass"
borrow: "Canonical root borrow\nstorage / logical identity retained"
record: "Actual SFUN activation\nROOTED or ACTIVE / bank / bound"
store: "One colocated store policy\nprimary or authenticated span"
revoke: "Marker revoked\nmutation closed / roots retained"
scan: "Existing RootTask\nfreeze / relocate / reload"
exit: "Physical C last use\nreturn borrow / release / leave"
model: "SysML → native SDK → ASCENT\nQNT: lifecycle and alias interleavings\nLean: unchanged arithmetic"
source -> register -> borrow
source -> store
record -> store
record -> revoke -> scan -> exit
borrow -> scan
revoke -> store: "reject"
model -> store
model -> scan
