  p7: "_mem/object-allocation.inc"
  p8: "_mem/symbols.inc"
  p9: "_mem/diagnostics.inc"
  p10: "_mem/heap-sections.inc"
  p11: "_mem/copy-reservations.inc"
  p12: "_mem/continuation-roots.inc"
  p13: "_mem/rc-roots.inc"
  p14: "_mem/object-scanning.inc"
  p15: "_mem/still-sweep.inc"
  p16: "_mem/memory-lifecycle.inc"
  p17: "_mem/wills.inc"
  p18: "_mem/weak-tables.inc"
