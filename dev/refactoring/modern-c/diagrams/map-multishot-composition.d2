direction: down
vars: { d2-config: { layout-engine: elk } }

semantic: { label: "GVM semantic completion\nFrameSpec\nPointId\nEffectSpec\nModuleSpec\nAllocationSpec" }
execution: { label: "ExecutionContext and GCParticipant\nGeneratedCheckpoint\nParticipation\nRootCut" }
heap: { label: "Generational heap and independent collector work\nControlRoots\nRootCut\nWorkClosure" }
control: { label: "Repeatable continuation and dynamic control\nFrameSpec\nControlRoots\nOutcomeLifetime" }
foreign: { label: "Root-safe FFI and effect boundary\nParticipation\nRootCut\nOutcomeLifetime\nReleaseDrain" }
scheduler: { label: "Scheduler and carrier independence\nParticipation\nWorkClosure\nOutcomeLifetime" }
build: { label: "Contract artifacts and backend services\nArtifactClosure\nPlanAbi" }
semantic -> execution: "FrameSpec / PointId / GeneratedCheckpoint"
execution -> heap: "RootCut / closed participant epoch"
control -> heap: "ControlRoots / remembered mature writes"
heap -> execution: "Relocated roots / completed minor epoch"
execution -> foreign: "Root handles before conversion/allocation"
foreign -> scheduler: "Parked activation / result custody"
scheduler -> execution: "Exclusive execution grant / reload"
execution -> control: "Resume same captured computation / wind"
semantic -> build: "Closed semantic plan / ABI dependency"
build -> semantic: "Target facts / independently validated lowering"
proof: { label: "SysML -> ASCENT -> QNT / Lean\nFinite custody checked; source simulation OPEN"; style.fill: "#fff0c2" }
control -> proof: "multiple shots / no heap rollback"
heap -> proof: "barrier closure / relocation"
foreign -> proof: "roots / unwind / outcome lifetime"
