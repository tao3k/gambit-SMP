direction: right
compiler_input: "compiler-input\nExtra target seed core before standard two target passes"
completed_snapshot: "completed-snapshot\nCompleted seed and bootstrap outputs aliasing mutable rebuild inputs"
private_rebuild: "private-rebuild\nIn-place policy conflating completed artifact ownership with working-tree ownership"
exact_routing: "exact-routing\nTreating a path or generic state inventory as a backup or successful producer"
two_target_passes: "two-target-passes\nOne redundant target build, no semantic pass or original deadline removed"
producer_consumption: "producer-consumption\nRecompilation merely to recover an existing exact completed target"
compiler_input -> private_rebuild: "Qualified generator host prepares only a bootstrap input; full target ABI is rebuilt"
completed_snapshot -> private_rebuild: "Checked copy and actual lease precede destructive bootclean; producer remains intact"
private_rebuild -> two_target_passes: "Same profile and original whole/step budgets; no pre-target-seed build"
two_target_passes -> completed_snapshot: "Actual exit0, quiescence, full phase inventory and source stability precede preserved completed output"
completed_snapshot -> producer_consumption: "Exact source/configuration/toolchain/producer identity authorizes use; no success inferred from directory existence"
