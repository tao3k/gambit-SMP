direction: down
vars: { d2-config: { layout-engine: elk } }
authority: "SMP/dev: native SysML / named cases / shared contracts"
gambit: {
 label: "Gambit repository: independent modern-c CI"
 workflow: ".github/workflows/smp.yml"
 seed: "Existing configure / Make seed"
 suite: "Scheme namespace: gambit#tests#smp#\nexecute-case / catalog.scm"
 bootstrap: "Two-pass bootstrap: 600 s original command cap"
 cases: {
 label: "Independent named C / Scheme / Make scenarios"
 grid-columns: 3
 c0: "gambit.smp.gc.root-task\npublication-claim-arena\nPASS"
 c1: "gambit.smp.runtime.roles\nstorage-layout\nPASS"
 c2: "gambit.smp.control.continuation\nmap-multishot\nPASS"
 c3: "gambit.smp.gc.frame-roots\nsingle-processor\nPASS"
 c4: "gambit.smp.gc.frame-roots\nhost-processors\nPASS"
 c5: "gambit.smp.gc.shared-roots\ncyclic-aliases\nPASS"
 c6: "gambit.smp.scheduler.mailbox\nordered-shared-values\nPASS"
 c7: "gambit.smp.control.dynamic-wind\nmultishot-gc\nPASS"
 c8: "gambit.smp.memory.modules\nmake-invalidation\nPASS"
 }
 workflow -> seed
 seed -> suite
 suite -> bootstrap
 bootstrap -> cases
}
evidence: "SMP: immutable native receipts, byte streams, prior failures"
ascent: "ASCENT: exact identity, method and missing/conflicting evidence"
formal: "Existing QNT schedules / Lean coherence: distinct owners, no duplicate models"
open: "Mailbox failure witness / physical worker retirement / five gates: OPEN"
authority -> gambit.suite
authority -> gambit.cases
gambit.cases -> evidence
evidence -> ascent
authority -> ascent
formal -> ascent: original obligations retained
ascent -> open: no module-only commit authority
