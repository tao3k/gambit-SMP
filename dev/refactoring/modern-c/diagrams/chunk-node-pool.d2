"manifest" -> "preflight": "Disjoint spans and\nbounded producers yield\npool demand budget"
"preflight" -> "pool": "Allocate before\nflip/forward; reject\nundersized plan"
"pool" -> "copy": "Reserve node with work\ndebt before forwarding"
"copy" -> "sealed": "Complete payload and\nframe links; retain Tail\ndebt"
"sealed" -> "queue": "Publish moves same\naccepted debt under\nqueue gate"
"queue" -> "scanner": "Claim node while\nretaining lifetime\noutside gate"
"scanner" -> "work-complete": "Settle scan debt after\nderiving all children"
"work-complete" -> "users-closed": "Drain future publishers\ncallbacks and borrowers\nseparately"
"users-closed" -> "receipt": "Detach dummy heads and\nretire receipts and pins"
"receipt" -> "reclaim": "Generation-bound\npermission; epoch reuse\nonly after consumption"
proof: "SysML -> ASCENT -> QNT / Lean\nConditional model; native / C11 OPEN"
