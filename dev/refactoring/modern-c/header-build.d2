direction: right
manifest: "include/gambit.h.in\nOnly maintained ordered inventory"
parts: "include/_gambit/*.h.in\nSingle-owned payload bytes"
configure: "configure / config.status\nSubstitution service"
make: "include/Make\nValidate and derive dependencies"
temporary: "Target-local temporary\nFailed render never completes"
public: "One installed gambit.h\nReplace only changed bytes"
stamp: "stamp-gambit\nSuccessful input-check receipt"
distribution: "RCFILES / DISTFILES\nDerived same inventory"
consumers: "Existing C / Scheme consumers\nSame ABI, frames and multi-shot semantics"
model: "SysML -> ASCENT\nExact source and native evidence"
manifest -> make
parts -> configure
make -> configure: "Ordered inputs"
configure -> temporary
temporary -> public: "cmp then atomic publication"
temporary -> stamp: "Only after success"
stamp -> make: "Absorb unchanged-content touches"
make -> distribution
public -> consumers
model -> make: "Ownership and completion contract"
consumers -> model: "Measured observations, no SMP promotion"
