direction: right
registry: "Native canonical registry\nexisting global_gate"
query: "Query N under gate"
allocate: "Scheme allocates/root-protects vector[N]\nGC or exception allowed; no native debt"
copy: "Count matches: copy N identities under gate\nNo allocation / Scheme / GC"
retry: "Count mismatch: no destination writes\nretry with managed storage"
fold: "Higher-order fold over private view\nno bucket / NEXT alias"
callback: "User callback\nintern / nested fold / GC / escape"
continuation: "Captured Scheme frames\none view shared by multiple resumptions"
raw: "OPEN 3.4: raw getter aliases\nGeiser / checkdoc / metadata consumers"
query -> allocate
allocate -> copy
registry -> query
registry -> copy
copy -> retry: changed
retry -> allocate
copy -> fold: complete
fold -> callback
callback -> registry: "may change topology"
callback -> continuation: capture
continuation -> fold: "GC-rooted multi-shot resume"
raw -> registry: "separate reader/lifetime obligation"
raw.style.stroke-dash: 4
