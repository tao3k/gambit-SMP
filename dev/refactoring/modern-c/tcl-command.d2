direction: right
caller: "Scheme generated caller\nlive CFUN_ARG → C value"
root: "Existing RC allocation/register\nowner processor; payload = proc"
allocate: "Still vector allocation\nmay collect and relocate proc"
reload: "Read relocated RC payload\ninitialize vector; RC payload = vector"
register: "Real Tcl_CreateCommand"
accepted: "Token returned\nTcl owns ClientData"
rejected: "NULL before acceptance\nconstructor owns rollback"
release: "Existing scheme_delete_cmd\nrelease still hold + release RC"
discard: "Vector allocation failed\nrelease RC only; no vector exists"
unknown: "No returned decision\nno inferred rollback/completion"
later: "Zero still refcount\nphysical reclaim waits for GC"
caller -> root -> allocate -> reload -> register
allocate -> discard: "allocation error"
register -> accepted -> release: "Tcl deletion/replacement"
register -> rejected -> release
register -> unknown
release -> later
