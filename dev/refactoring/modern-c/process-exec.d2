direction: right
parent: "Parent\nPrepare spawn metadata before fork"
fork: "Existing fork and same PID\nSignal/affinity cleanup"
pipe: "Existing fd relocation / redirection\nCLOEXEC errno pipe"
admit: "Child-only admission\nExplicit path after existing cwd/env handling\nOpen, non-CLOEXEC stdio"
kernel: "SETEXEC + CLOEXEC_DEFAULT\nActual descriptor-table closure"
legacy: "Original closefrom → exec\nAll refusal/error ownership retained"
publish: "Existing parent protocol\nEOF/error → device registration"
parent -> fork -> pipe -> admit
admit -> kernel: "Admitted"
admit -> legacy: "Refused"
kernel -> legacy: "Failed SETEXEC; no second child"
kernel -> publish: "Same PID; error-pipe EOF"
legacy -> publish
