direction: right
writers: "Generated GLO / GLOBALVARSET / set!\nmodule setup / registry count + linked nodes\nexisting stopped admitted writers"
source: "Immutable borrowed global source\nVM + global-state + count + roster\nparticipant + [lo,hi)"
layout: "Single VM: bucket/node/val\nMultiple VM: actual vm->glos cells\nshared existing20000 allocation bound"
task: "GLOBALS RootOrigin → RootTask\ninitialize before READY → claim\nSCANNING → SCANNED → finish"
scan: "Explicit-source mark_global_variables\noriginal in-place address updates\nRC before; stack/bank after"
outer: "Outer VM/registry/round lifetime\nunknown scan never requeued\nlocal DONE is not global reclaim"
writers -> source: "stop/lifetime premises; recheck is not freeze"
source -> layout: "checked floor bounds, including empty shards"
source -> task: "fresh metadata before READY; actual epoch"
task -> scan: "one claimed participant shard"
scan -> outer: "descendants and storage outlive local lease"
models: "SysML → shared ASCENT\nQNT: temporal schedules\nLean: conditional cell/address laws\nLLM: ambient source review"
pbt: "Existing real Scheme replay/shrink\ncorrupted metadata + partition checks\np1/p2 actual shard cell relocation"
models -> task: "conditional source refinement"
pbt -> scan: "finite implementation evidence"
