#! /usr/bin/env gsi
;;; Test-side observer for the proposed mature-slot protocol.
;;; Vectors stand for slots and relocation outputs, not native frame addresses.
(define self (car (command-line)))
(define (trace-tag) 'mature-slot-replay)
(include "../../../../vendor/gambit/tests/root-task-replay.scm")

(define (observe commands fault)
  (let ((slots (vector #f #f))
        (expected (vector #f #f))
        (remembered '())
        (overflow #f)
        (epoch 0)
        (direct #f)
        (direct-slot 0))
    (define (store slot value)
      (if (pair? remembered)
          (set! overflow #t)
          (set! remembered (list slot)))
      (vector-set! slots slot value)
      (vector-set! expected slot (vector-ref value 0)))
    (define (relocate value)
      (and value (vector (vector-ref value 0) epoch)))
    (define (repair slot)
      (vector-set! slots slot (relocate (vector-ref slots slot))))
    (define (collect)
      (set! epoch (+ epoch 1))
      (if direct
          (begin
            (set! direct (relocate direct))
            (if (not (equal? direct (vector (vector-ref expected direct-slot) epoch)))
                (error "independent root was not repaired" direct))))
      (let ((selected (if (and overflow (not (eq? fault 'overflow)))
                          '(0 1) remembered)))
        (for-each
         (lambda (slot)
           (if (not (and (eq? fault 'missed) direct (= slot direct-slot)))
               (repair slot)))
         selected)
        ;; Oracle enumerates the fixed fixture independently of selection.
        (let check ((slot 0))
          (cond
           ((= slot (vector-length expected))
            (set! remembered '())
            (set! overflow #f)
            (for-each
             (lambda (index)
               (if (and (vector-ref slots index)
                        (not (and (eq? fault 'residual) (= epoch 1))))
                   (if (pair? remembered)
                       (set! overflow #t)
                       (set! remembered (list index)))))
             selected)
            #f)
           ((let ((token (vector-ref expected slot)))
              (equal? (and token (vector token epoch))
                      (vector-ref slots slot)))
            (check (+ slot 1)))
           (else (list fault (list epoch slot)))))))
    (let loop ((rest commands) (index 0))
      (if (null? rest)
          (list 'root-task-result 'pass index)
          (let ((failure
                 (case (car rest)
                   ((frame) (store 0 (vector 'frame epoch)) #f)
                   ((denv) (store 1 (vector 'denv epoch)) #f)
                   ((hold hold-denv)
                    (set! direct-slot (if (eq? (car rest) 'hold) 0 1))
                    (set! direct (vector-ref slots direct-slot))
                    #f)
                   ((collect) (collect))
                   ((noise) #f)
                   (else (error "unknown mature-slot action" (car rest))))))
            (if failure
                (cons 'root-task-result (cons 'mismatch (cons index failure)))
                (loop (cdr rest) (+ index 1))))))))

(define (replay trace)
  (if (and (list? trace) (= (length trace) 4)
           (eq? (car trace) (trace-tag)) (eqv? (cadr trace) 1)
           (list? (caddr trace))
           (memq (cadddr trace) '(none missed residual overflow)))
      (observe (caddr trace) (cadddr trace))
      (error "invalid mature-slot replay" trace)))

;; Reuse deletion and signature handling with an in-process test observer.
(set! trial (lambda (commands fault)
              (replay (list (trace-tag) 1 commands fault))))

(define (check-control commands fault expected)
  (let* ((wanted (signature (trial commands fault)))
         (minimal (shrink commands fault expected))
         (trace (list (trace-tag) 1 minimal fault))
         (decoded (call-with-input-string
                   (call-with-output-string (lambda (port) (write trace port)))
                   read)))
    (if (not (and (equal? wanted expected)
                  (equal? (signature (replay decoded)) expected)
                  (one-minimal? minimal fault expected)
                  (not (signature (trial minimal 'none)))))
        (error "mature-slot control failed" trace expected wanted))
    (write (list 'MATURE-SLOT-CONTROL-PASS fault
                 (length commands) (length minimal) trace))
    (newline)))

(let ((args (cdr (command-line))))
  (cond
   ((null? args)
    (check-control '(noise frame hold noise collect noise)
                   'missed '(missed (1 0)))
    (check-control '(noise denv hold-denv noise collect noise)
                   'missed '(missed (1 1)))
    (check-control '(noise frame collect noise collect noise)
                   'residual '(residual (2 0)))
    (check-control '(noise frame denv noise collect noise)
                   'overflow '(overflow (1 1)))
    (if (signature (trial '(frame denv collect collect) 'none))
        (error "overflow fallback lost next-epoch coverage"))
    (display "MATURE-SLOT-OVERFLOW-REARM-PASS two-epochs")
    (newline))
   ((and (= (length args) 2) (string=? (car args) "--replay"))
    (let ((result (replay (call-with-input-file (cadr args) read))))
      (write result)
      (newline)
      (exit (if (signature result) 71 0))))
   (else (error "expected no arguments or --replay FILE"))))
