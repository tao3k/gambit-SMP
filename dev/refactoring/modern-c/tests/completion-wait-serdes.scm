;;; Existing serializer requires block compilation to name local subprocedures.
(declare (block))
(include "completion-wait-restore.scm")
(define serdes-shot-exit #f)
(define serdes-winds '())
(define serdes-raised 0)
(define (serdes-restored-handler exception)
  (if (and (pair? exception) (eq? (car exception) 'restored-error))
      (begin
        (set! serdes-raised (+ serdes-raised 1))
        (serdes-shot-exit (list 'caught exception)))
      (raise exception)))
(define (outcome thunk)
  (with-exception-catcher (lambda (e) (list 'raised e))
    (lambda () (list 'returned (thunk)))))
(define (resource? x)
  (or (thread? x) (mutex? x) (condition-variable? x) (thread-group? x) (port? x)))

(define (code-manifest k)
  (let loop ((p k) (fuel 256) (rows '()))
    (if (not p) (list (##system-version) (reverse rows))
        (begin
          (ensure (> fuel 0) "finite code identity chain")
          (let ((ret (##continuation-ret p)))
            (loop (##continuation-next p) (- fuel 1)
                  (cons (list (##subprocedure-parent-name ret) (##subprocedure-id ret)
                              (##continuation-fs p) (##continuation-link p)) rows)))))))
(define (serdes-wait-case converted? #!optional (lifetime? #f))
  (set! serdes-winds '())
  (set! serdes-raised 0)
  (let ((controller (current-thread)) (m (make-mutex)) (gate (make-mutex))
        (cv (make-condition-variable)) (released #f) (callbacks 0)
        (bytes (make-f64vector 2 0.0)))
    (mutex-lock! m #f #f)
    (let ((worker (thread-start! (make-thread
                     (lambda () (mutex-lock! m) (mutex-unlock! m) (raise 'owner-exit))))))
      (let await ()
        (if (not (thread-state-waiting? (thread-state worker)))
            (begin (thread-yield!) (await))))
      (##thread-intr! worker #t
       (lambda ()
         (set! callbacks (+ callbacks 1))
         (with-exception-catcher serdes-restored-handler
          (lambda ()
            (dynamic-wind
             (lambda () (set! serdes-winds (cons 'before serdes-winds)))
             (lambda ()
               (let* ((cell (vector 'wait-cell 5))
                      (answer (continuation-capture
                               (lambda (k) (thread-send controller k) 'initial))))
                 (cond
                  ((eq? answer 'initial)
                   (mutex-lock! gate)
                   (let wait ()
                     (if (not released)
                         (begin (mutex-unlock! gate cv) (mutex-lock! gate) (wait))))
                   (mutex-unlock! gate))
                  ((eq? answer 'throw) (raise (list 'restored-error (vector-ref cell 1))))
                  (else (serdes-shot-exit (list answer (vector-ref cell 1)))))))
             (lambda () (set! serdes-winds (cons 'after serdes-winds))))))))
      (let* ((k (thread-receive))
             (ignored (##get-bytes-allocated! bytes 0))
             (generation (transfer-init (if converted? k (vector 'generic-target k #f)))))
        (ensure (> generation 0) "serde source registration")
        (transfer-cache! #t)
        ;; Encoder exception leaves the original native root untouched.
        (ensure (equal? (outcome (lambda ()
                          (object->u8vector (vector k)
                            (lambda (x) (if (continuation? x) (raise 'encode-fault) x)))))
                        '(raised encode-fault)) "encoder exception")
        (ensure (= (transfer-query generation) 1) "precommit exception custody")
        (let ((raw (outcome (lambda () (object->u8vector k)))))
          (ensure (and (eq? (car raw) 'raised) (error-exception? (cadr raw)))
                  "default serializer must preserve native rejection"))
        (if converted?
            (begin
              (ensure (transfer-prepare (vector 'generic-target k #f)) "serde target")
              (transfer-commit generation #t)))
        ;; Match exception workload in both modes; only custody state differs.
        (ensure (equal? (outcome (lambda () (raise 'postcommit-fault)))
                        '(raised postcommit-fault)) "post-setup exception")
        (ensure (= (transfer-query generation) (if converted? 2 1))
                "query after exceptional lost return")
        (let* ((peak (root-slots)) (slot (wait-frame-slot k)) (cell (vector-ref slot 2))
               (graph (vector 'wait-graph k k cell cell m m))
               (handles (make-table test: eq?)) (seen (make-table test: eqv?))
               (resources '()) (live? #t)
               (admission? #t) (code-valid? #t) (close-in-decode? #f)
               (accepted 0) (code-results 0) (decode-calls 0) (late-refusals 0)
               (expected-code (code-manifest k)) (good-ticket #f))
          ;; Only the format's direct single-byte negative integers bypass
          ;; share/alloc. Larger fixnums also enter the shared-object table.
          ;; Both encounter orders detect collision with original numeric data.
          (define (encode x)
            (cond
             ((##fixnum? x)
              (if (assv x resources) (raise 'resource-token-collision))
              (table-set! seen x #t) x)
             ((resource? x)
              (or (table-ref handles x #f)
                  (let ((token (+ -128 (length resources))))
                    (ensure (and (##fixnum? token) (< token 0)) "single-byte token capacity")
                    (if (table-ref seen token #f) (raise 'resource-token-collision))
                    (set! resources (cons (cons token x) resources))
                    (table-set! handles x token) token)))
             (else x)))
          ;; Test-owned admission/result records. They are ordinary rooted
          ;; Scheme data, not production loader or query-service replacements.
          (define (rebuild-pins-drained?) (and (= accepted 0) (= code-results 0)))
          (define (admit manifest)
            (if (not admission?) (raise 'resolver-admission-closed))
            (if (or (not code-valid?) (not (equal? manifest expected-code)))
                (raise 'stale-code-identity))
            (set! accepted (+ accepted 1))
            (vector 'accepted #f #f))
          (define (ticket-query ticket)
            (if (eq? (vector-ref ticket 0) 'accepted) '(pending)
                (vector-ref ticket 1)))
          (define (ticket-ack ticket)
            (if (not (vector-ref ticket 2))
                (begin
                  (ensure (not (eq? (vector-ref ticket 0) 'accepted)) "ACK pending rebuild")
                  (vector-set! ticket 2 #t)
                  (vector-set! ticket 0 'consumed)
                  (vector-set! ticket 1 '(consumed))
                  (set! accepted (- accepted 1)))))
          (define (run-accepted ticket encoded)
            (if (eq? (vector-ref ticket 0) 'accepted)
                (let ((result
                       (outcome (lambda ()
                         (set! decode-calls (+ decode-calls 1))
                         (if (not code-valid?) (raise 'stale-code-identity))
                         (u8vector->object encoded decode)))))
                  (vector-set! ticket 1 result)
                  (vector-set! ticket 0 'result)
                  (if (eq? (car result) 'returned)
                      (set! code-results (+ code-results 1)))))
            (ticket-query ticket))
          (define (decode x)
            (if (not live?) (raise 'unresolved-resource))
            (if close-in-decode?
                (begin
                  (set! close-in-decode? #f)
                  (set! admission? #f)
                  (ensure (equal? (ticket-query good-ticket) '(pending))
                          "pending query is not a false result or permission")
                  (ensure (equal? (outcome (lambda () (admit expected-code)))
                                  '(raised resolver-admission-closed)) "late admission")
                  (set! late-refusals (+ late-refusals 1))
                  (ensure (not (rebuild-pins-drained?)) "accepted decoder pins code")
                  (##gc)))
            (let ((entry (and (##fixnum? x) (assv x resources))))
              (if entry (cdr entry) x)))
          (let* ((encoded (object->u8vector graph encode))
                 (encoded-resource-count (length resources)))
            (ensure (pair? resources) "actual wait graph resource handles")
            (if lifetime?
                (begin
                  (ensure (equal? (outcome (lambda () (admit '(wrong-code))))
                                  '(raised stale-code-identity)) "manifest identity refusal")
                  (set! code-valid? #f)
                  (ensure (equal? (outcome (lambda () (admit expected-code)))
                                  '(raised stale-code-identity)) "revoked code admission")
                  (set! code-valid? #t)
                  ;; Native decoder itself rejects the changed system version.
                  (let* ((bad (object->u8vector graph
                                (lambda (x)
                                  (if (eqv? x (##system-version))
                                      (+ x 1) (encode x)))))
                         (result (outcome (lambda () (u8vector->object bad decode)))))
                    (ensure (and (eq? (car result) 'raised)
                                 (error-exception? (cadr result))) "native version refusal"))))
            (set! live? #f)
            (if lifetime?
                (let ((failed (admit expected-code)))
                  (run-accepted failed encoded)
                  (ensure (equal? (ticket-query failed) '(raised unresolved-resource))
                          "failed decode result query")
                  (ticket-ack failed) (ticket-ack failed)
                  (ensure (= accepted 0) "failed result ACK once"))
                (ensure (equal? (outcome (lambda () (u8vector->object encoded decode)))
                                '(raised unresolved-resource)) "decoder exception"))
            (ensure (= (transfer-query generation) (if converted? 2 1))
                    "failed rebuild preserves old root")
            (##gc)
            (set! live? #t)
            (if lifetime?
                (begin (set! good-ticket (admit expected-code))
                       (set! close-in-decode? #t)))
            (let* ((rebuilt
                    (if lifetime?
                        (begin
                          (run-accepted good-ticket encoded)
                          ;; Recover a deliberately ignored result by query.
                          (let ((calls decode-calls))
                            (run-accepted good-ticket encoded)
                            (ensure (= calls decode-calls) "query cannot decode again"))
                          (ensure (eq? (car (ticket-query good-ticket)) 'returned)
                                  "accepted decode result")
                          (cadr (ticket-query good-ticket)))
                        (u8vector->object encoded decode)))
                   (rk (vector-ref rebuilt 1))
                   (before (frame-cost rk)))
              (ensure (and (continuation? rk) (eq? rk (vector-ref rebuilt 2))
                           (eq? (vector-ref rebuilt 3) (vector-ref rebuilt 4))
                           (not (eq? (vector-ref rebuilt 3) cell))
                           (eq? (vector-ref rebuilt 5) m)
                           (eq? (vector-ref rebuilt 6) m))
                      "reconstruction sharing versus original graph")
              (if lifetime?
                  (ensure (equal? (code-manifest rk) expected-code) "rebuilt code manifest"))
              (vector-set! (active-graph converted?) 2 rebuilt)
              (set! k #f)
              (if converted?
                  (begin
                    (transfer-ack generation #t)
                    (ensure (= (transfer-query generation) 3) "serde ACK query")))
              (transfer-reader! #t)
              (if lifetime?
                  (begin
                    (ticket-ack good-ticket) (ticket-ack good-ticket)
                    (ensure (= accepted 0) "successful result ACK once")
                    (ensure (not (rebuild-pins-drained?)) "published result pins code")
                    ;; Completed graph owns resolved resources. Closing/clearing
                    ;; this registry must not invalidate that already-owned graph.
                    (set! live? #f) (set! resources '())
                    (set! handles (make-table test: eq?))
                    (ensure (equal? (ticket-query good-ticket) '(consumed))
                            "ACK closes callable-result query right")
                    (let ((calls decode-calls))
                      (ensure (equal? (outcome (lambda () (admit expected-code)))
                                      '(raised resolver-admission-closed)) "post-close rebuild")
                      (set! late-refusals (+ late-refusals 1))
                      (ensure (= calls decode-calls) "late reject before native decode"))
                    (##gc)))
              (mutex-lock! gate) (set! released #t)
              (condition-variable-broadcast! cv) (mutex-unlock! gate)
              (mutex-unlock! m)
              (let ((joined (outcome (lambda () (thread-join! worker)))))
                (ensure (and (eq? (car joined) 'raised)
                             (uncaught-exception? (cadr joined))
                             (eq? (uncaught-exception-reason (cadr joined)) 'owner-exit))
                        "original owner abnormal exit semantics"))
              (transfer-cache! #f)
              (if converted? (ensure (not (transfer-retire generation #f)) "rebuild reader pin"))
              (##gc)
              (let ((answer (call/cc (lambda (out)
                                      (set! serdes-shot-exit out)
                                      (continuation-return rk 20)))))
                (ensure (equal? answer '(20 5)) "rebuilt normal return"))
              (##gc)
              (let ((answer (call/cc (lambda (out)
                                      (set! serdes-shot-exit out)
                                      (continuation-return rk 'throw)))))
                (ensure (equal? answer '(caught (restored-error 5)))
                        "rebuilt captured handler and exception exit"))
              (ensure (and (= callbacks 1) (= serdes-raised 1)
                           (equal? serdes-winds '(after before after before after before)))
                      "exception winding or duplicate callback")
              (##get-bytes-allocated! bytes 1)
              (write (list 'COMPLETION-WAIT-SERDES-COST (if lifetime? (if converted? 'resolver-converted 'resolver-control)
                               (if converted? 'converted 'control))
                           'encoded-bytes (u8vector-length encoded)
                           'resource-handles encoded-resource-count
                           'peak-root-slots peak 'retained-root-slots (root-slots)
                           'frames-before before 'frames-after (frame-cost rk)
                           'allocated-bytes (- (f64vector-ref bytes 1) (f64vector-ref bytes 0))))
              (newline)
              (if lifetime?
                  (begin
                    (ensure (and (= accepted 0) (= code-results 1) (= late-refusals 2))
                            "resolver lifetime accounting")
                    (vector-set! (active-graph converted?) 2 #f)
                    (set! rk #f) (set! rebuilt #f)
                    (set! code-results (- code-results 1))
                    (ensure (rebuild-pins-drained?) "scoped code pins after final result use")
                    (write (list 'COMPLETION-RESOLVER-LIFETIME
                                 (if converted? 'converted 'control)
                                 'accepted accepted 'code-results code-results
                                 'decode-calls decode-calls 'late-refusals late-refusals
                                 'code-points (length (cadr expected-code))))
                    (newline)))
              ;; Exercise the same encoder in both collision encounter orders.
              ;; These directed refusals run after the measured codec window.
              (for-each
               (lambda (input)
                 (set! resources '())
                 (set! handles (make-table test: eq?))
                 (set! seen (make-table test: eqv?))
                 (ensure (equal? (outcome (lambda () (object->u8vector input encode)))
                                 '(raised resource-token-collision))
                         "resource token collision refusal"))
               (list (vector -128 m) (vector m -128)))
              (transfer-reader! #f)
              (ensure (if converted? (transfer-retire generation #f) (finish-control))
                      "serde exceptional lifetime settlement"))))))))
(serdes-wait-case #f)
(serdes-wait-case #t)
(display "COMPLETION-WAIT-SERDES-PASS default=refused explicit-same-vm=rebuilt sharing=preserved resource-alias=exact token-collision=both-orders encode+decode-exceptions=retained owner=abnormal-exit restored-handler=caught query+ack=settled\n")

(serdes-wait-case #f #t)
(serdes-wait-case #t #t)

;; Retire an actual nonzero PSTATE only after an independently installed root
;; permits source ACK. Cross-VM raw object transfer is deliberately not tested.
(c-declare "#include \"completion-wait-exit.h\"")
(define exit-source-create
  (c-lambda () int "___return(wait_exit_create(___ps));"))
(define exit-target-install
  (c-lambda () int "___return(wait_exit_install(___ps));"))
(define exit-source-ack
  (c-lambda () int "___return(wait_exit_ack(___ps));"))
(define exit-source-stopped
  (c-lambda () int "___return(wait_exit_stopped());"))
(define exit-target-value
  (c-lambda () scheme-object
    "___return(___data_rc(wait_exit_source.target));"))
(define exit-target-finish
  (c-lambda () int "___return(wait_exit_finish());"))
(define exit-vm-begin
  (c-lambda () int "___return(wait_exit_vm_begin(___ps));"))
(define exit-vm-finish
  (c-lambda () int "___return(wait_exit_vm_finish(___ps));"))
(define (on-exit-source thunk)
  (let ((worker (make-thread thunk)))
    (##thread-pin! worker (##processor 2))
    (thread-start! worker)
    (thread-join! worker)))
(##thread-pin! (current-thread) (##processor 0))
(##thread-migrate-to! 0)
(ensure (= (##current-processor-id) 0) "exit controller source0")
(ensure (= (##current-vm-processor-count) 3) "exit initial R=3")
(ensure (= (on-exit-source exit-source-create) 1) "exit source2 root created")
(ensure (not (equal? (##cvmr 2) 0)) "live source2 root must refuse removal")
(ensure (= (##current-vm-processor-count) 3) "refusal keeps original member set")
(##gc)
(ensure (normal-wait-topology?) "healthy GC after source refusal R=3 W=2")
(ensure (= (exit-target-install) 1) "target root installed before source ACK")
(##gc)
(ensure (equal? (exit-target-value) (make-vector 7 113)) "installed target scan")
(ensure (= (on-exit-source exit-source-ack) 1) "source owner clears only after install")
(ensure (equal? (##cvmr 2) 0) "source2 native stop and join")
(ensure (= (exit-source-stopped) 1) "source2 detached byte handle after native exit")
(##gc)
(ensure (equal? (exit-target-value) (make-vector 7 113)) "target survives retired PSTATE")
(ensure (equal? (##cvmr 3) 0) "restore original three-member capacity")
(##gc)
(ensure (normal-wait-topology?) "restored R=3 W=2")
(ensure (equal? (exit-target-value) (make-vector 7 113)) "target survives source reuse")
(ensure (= (exit-target-finish) 1) "target release after native source retirement")
(display "COMPLETION-WAIT-PSTATE-EXIT-PASS live-root=refused install-before-ACK=1 native-stop=joined detached-byte-owner=released target-GC=survived R=3/2/3 W=2\n")
(force-output)

;; A separate VM refuses cleanup with a root/borrow. Healthy primary GC can run.
;; Only clear/release of the source payload permits actual VM reclamation.
(let ((generation (transfer-init (vector 'healthy-vm-target 149))))
  (ensure (> generation 0) "VM exit independent primary root")
  (ensure (transfer-prepare (transfer-source)) "VM exit primary target install")
  (ensure (= 2 (transfer-commit generation #f)) "VM exit primary commit")
  (ensure (= 3 (transfer-ack generation #f)) "VM exit primary ACK")
  (ensure (= (exit-vm-begin) 1) "secondary cleanup refuses borrow and nonempty root")
  (##gc)
  (ensure (normal-wait-topology?) "healthy GC while secondary retained")
  (ensure (equal? (transfer-target) '#(healthy-vm-target 149)) "healthy VM root retained")
  (ensure (= (exit-vm-finish) 1) "secondary clear, cleanup and one release")
  (##gc)
  (ensure (normal-wait-topology?) "healthy GC after secondary VM destruction")
  (ensure (equal? (transfer-target) '#(healthy-vm-target 149)) "primary root after VM exit")
  (ensure (transfer-retire generation #f) "VM exit target retirement")
  (ensure (transfer-releases) "VM exit primary roots released once"))
(display "COMPLETION-WAIT-VM-EXIT-PASS borrowed+rooted=refused healthy-GC=continued source-cleared=reclaimed release=once duplicate=refused cross-VM-pointer-transfer=absent\n")
(force-output)
(##thread-pin! (current-thread) #f)
(display "COMPLETION-RESOLVER-PASS close-in-decode=accepted-pinned late=rejected-before-decode manifest+native-version=refused result-query=no-redecode ack=once registry=cleared owner=exited rebuilt-shots=valid code-pins=scoped-last-use-not-unload\n")

;; Interpreter-created environments are distinct from compiled wait frames.
;; This is the ordinary eager representation control, not deferred allocation.
(define (environment-alias-case)
  (let* ((saved #f) (escape #f) (captures 0) (winds '())
         (graph
          (eval
           '(let ((location (vector 'environment-cell 7)))
              (vector
               (lambda () location)
               (lambda (value) (set! location value))
               (lambda (publish leave wind)
                 (dynamic-wind
                  (lambda () (wind 'before))
                  (lambda ()
                    (map (lambda (item)
                           (let ((answer
                                  (continuation-capture
                                   (lambda (k) (publish k) 'initial))))
                             (if (eq? answer 'initial)
                                 'initial
                                 (leave (list answer location item)))))
                         '(payload)))
                  (lambda () (wind 'after))))))))
         (get (vector-ref graph 0)) (put (vector-ref graph 1))
         (run (vector-ref graph 2))
         (rte (##interp-procedure-rte get))
         (original (get)) (replacement (vector 'environment-cell 9)))
    (ensure (and (##interp-procedure? get) (##interp-procedure? put)
                 (##interp-procedure? run) (vector? rte)
                 (eq? rte (##interp-procedure-rte put))
                 (eq? rte (##interp-procedure-rte run)))
            "interpreted closures expose the same lexical environment")
    (ensure (equal?
             (run (lambda (k) (set! saved k) (set! captures (+ captures 1)))
                  (lambda (x) (escape x))
                  (lambda (tag) (set! winds (cons tag winds))))
             '(initial))
            "interpreted map completes its original activation")
    (ensure (and saved (= captures 1)) "one actual map callback capture")
    (put replacement)
    (##gc)
    (ensure (normal-wait-topology?) "environment control R3/W2 after GC")
    (ensure (and (eq? (get) replacement)
                 (eq? rte (##interp-procedure-rte get))
                 (= (vector-ref original 1) 7))
            "GC preserves independent old value and shared lexical assignment")
    (let ((first (call/cc (lambda (out)
                            (set! escape out)
                            (continuation-return saved 'first)))))
      (ensure (and (eq? (car first) 'first)
                   (eq? (cadr first) replacement)
                   (eq? (caddr first) 'payload))
              "first interpreted map shot sees canonical lexical location"))
    (vector-set! replacement 1 11)
    (##gc)
    (ensure (normal-wait-topology?) "environment control R3/W2 after GC")
    (let ((second (call/cc (lambda (out)
                             (set! escape out)
                             (continuation-return saved 'second)))))
      (ensure (and (eq? (car second) 'second)
                   (eq? (cadr second) (get))
                   (= (vector-ref (cadr second) 1) 11)
                   (= (vector-ref original 1) 7)
                   (= captures 1)
                   (equal? winds '(after before after before after before)))
              "second shot preserves set!, old alias and dynamic-wind"))
    ;; Substitute one real closure environment, retaining both valid graphs.
    ;; This detects a wrong logical source mapping, not a stale raw address.
    (let ((bad (vector-copy rte)) (changed 0))
      (do ((i 1 (+ i 1))) ((= i (vector-length bad)))
        (let ((value (vector-ref bad i)))
          (cond ((eq? value replacement)
                 (vector-set! bad i original) (set! changed (+ changed 1)))
                ((and (##box? value) (eq? (##unbox value) replacement))
                 (vector-set! bad i (##box original))
                 (set! changed (+ changed 1))))))
      (ensure (= changed 1) "one actual lexical source slot for alias negative")
      (let ((saved-trial trial) (seed 317))
        (define (environment-trial commands fault?)
          (let ((state 0) (result #f) (index 0))
            (dynamic-wind
             (lambda () (##closure-set! get 3 rte))
             (lambda ()
               (for-each
                (lambda (command)
                  (if (not result)
                      (case command
                        ((idle) #f)
                        ((alias)
                         (if (= state 0)
                             (begin (if fault? (##closure-set! get 3 bad))
                                    (set! state 1))
                             (set! result (list 'root-task-result 'invalid index))))
                        ((collect)
                         (if (= state 1)
                             (begin (##gc)
                                    (ensure (normal-wait-topology?) "alias PBT R3/W2")
                                    (set! state 2))
                             (set! result (list 'root-task-result 'invalid index))))
                        ((observe)
                         (if (= state 2)
                             (if (eq? (get) replacement)
                                 (set! state 3)
                                 (set! result
                                   (list 'root-task-result 'mismatch index
                                         'environment-source-alias 0)))
                             (set! result (list 'root-task-result 'invalid index))))
                        (else (set! result (list 'root-task-result 'invalid index)))))
                  (set! index (+ index 1)))
                commands))
             (lambda () (##closure-set! get 3 rte)))
            (ensure (and (eq? (get) replacement) (= (vector-ref original 1) 7))
                    "alias trial restores canonical root and retains independent old value")
            (or result (list 'root-task-result (if (= state 3) 'pass 'invalid) index))))
        (dynamic-wind
         (lambda () (set! trial environment-trial))
         (lambda ()
           (do ((i 0 (+ i 1))) ((= i 8))
             (set! seed (modulo (* seed 48271) 2147483647))
             (let* ((idles (modulo seed 3))
                    (commands (append (make-list idles 'idle) '(alias collect observe)))
                    (encoded (call-with-output-string
                               (lambda (port) (write (list 'environment-alias 1 '(3 2) commands) port))))
                    (decoded (call-with-input-string encoded read)))
               (ensure (and (equal? (caddr decoded) '(3 2))
                            (eq? (cadr (trial (cadddr decoded) #f)) 'pass))
                       "real environment alias positive replay")
               (write (list 'COMPLETION-ENVIRONMENT-REPLAY decoded)) (newline)))
           (let* ((history '(idle alias idle collect observe idle))
                  (wanted '(environment-source-alias 0))
                  (minimal (shrink history #t wanted)))
             (ensure (and (equal? minimal '(alias collect observe))
                          (one-minimal? minimal #t wanted)
                          (equal? (signature (trial minimal #t)) wanted)
                          (eq? (cadr (trial minimal #f)) 'pass)
                          (eq? (cadr (trial '(alias observe) #t)) 'invalid))
                     "real closure-source alias negative retains GC when shrinking")
             (write (list 'COMPLETION-ENVIRONMENT-SHRINK minimal wanted)) (newline)))
         (lambda () (set! trial saved-trial)))))
    (write (list 'COMPLETION-ENVIRONMENT-ALIAS-PASS
                 'representation 'eager 'map-shots 2 'captures captures
                 'shared-rte #t 'old-value 7 'current-value 11
                 'winding 'exact 'eliminated-allocations 'unmeasured))
    (newline)))
(environment-alias-case)

;; Isolated code-node hook: ^1 is macro-code-ref(code,1), hence vector slot6.
;; A retained exec may run after the original procedure activation returned.
(define (environment-hook-case)
  (let* ((pair (eval '(let ((runs 0))
                       (vector
                        (lambda (x)
                          (set! runs (+ runs 1))
                          (if (eq? x 'throw) (raise 'environment-hook-fault)
                              (vector 'hook-result x (lambda () x)
                                      (lambda (value) (set! x value)))))
                        (lambda () runs)))))
         (proc (vector-ref pair 0)) (runs (vector-ref pair 1))
         (code (##interp-procedure-code proc))
         (old (##interp-procedure-entry-hook proc))
         (retained #f) (entries 0))
    (ensure (and (not old) (eq? old (vector-ref code 6)))
            "official hook accessor agrees with req1 code slot")
    (dynamic-wind
     (lambda ()
       (##interp-procedure-entry-hook-set! proc
         (lambda (self args exec)
           (ensure (and (eq? self proc) (list? args)) "real req1 hook args")
           (set! entries (+ entries 1))
           (set! retained exec)
           'deferred)))
     (lambda ()
       (ensure (and (eq? (proc 23) 'deferred) (= (runs) 0)) "hook returns before body")
       (let ((normal retained))
         (##gc)
         (ensure (normal-wait-topology?) "hook roots R3/W2")
         (let* ((first (normal)) (get (vector-ref first 2))
                (put (vector-ref first 3)))
           (put 29)
           (let ((second (normal)))
             (ensure (and (= (get) 29) (= ((vector-ref second 2)) 23)
                          (= (runs) 2))
                     "repeated exec creates distinct mutable parameter locations"))
         (ensure (eq? (proc 'throw) 'deferred) "second hook admission")
         (##gc)
         (ensure (equal? (outcome retained) '(raised environment-hook-fault))
                 "retained exec exception preserves original failure")
         (##gc)
         (ensure (eq? (proc 1 2) 'deferred) "hook intercepts wrong arity before execute")
         (let ((failure (outcome retained)))
           (ensure (and (eq? (car failure) 'raised)
                        (wrong-number-of-arguments-exception? (cadr failure))
                        (= (runs) 3))
                   "retained invalid exec preserves native arity failure before body"))
         (let ((last (normal)))
           (ensure (and (normal-wait-topology?) (= entries 3) (= (runs) 4)
                        (= ((vector-ref last 2)) 23) (= (get) 29))
                   "earlier exec and escaped location survive newer args and exceptions")))))
     (lambda () (##interp-procedure-entry-hook-set! proc old)))
    (ensure (and (eq? (##interp-procedure-entry-hook proc) old)
                 (eq? (vector-ref code 6) old)) "official hook and code alias restored")
    (display "COMPLETION-ENVIRONMENT-HOOK-PASS entries=3 bodies=4 invalid-exec=1 fresh-locations=distinct escaped-value=29 old-arg=23 exception=preserved code-hook=restored hook-access=official\n")))

;; Globals prevent the encoder registry from becoming a captured local value.
;; Decoded control remains same-VM and uses already-loaded application/library code.
(define environment-serde-exit #f)
(define environment-serde-k #f)
(define environment-serde-captures 0)
(define environment-serde-winds '())
(define (environment-serde-publish k)
  (set! environment-serde-k k)
  (set! environment-serde-captures (+ environment-serde-captures 1)))
(define (environment-serde-leave value) (environment-serde-exit value))
(define (environment-serde-wind tag)
  (set! environment-serde-winds (cons tag environment-serde-winds)))
(define (make-environment-serde-graph)
  (let* ((graph
          (eval
           '(let ((location (vector 'serde-environment-cell 5)))
              (vector
               (lambda () location)
               (lambda (x) (set! location x))
               (lambda (publish leave wind)
                 (dynamic-wind
                  (lambda () (wind 'before))
                  (lambda ()
                    (map (lambda (item)
                           (let ((answer (continuation-capture
                                          (lambda (k) (publish k) 'initial))))
                             (if (eq? answer 'initial) 'initial
                                 (leave (list answer location item)))))
                         '(payload)))
                  (lambda () (wind 'after))))))))
         (get (vector-ref graph 0)))
    (ensure (equal? ((vector-ref graph 2) environment-serde-publish
                    environment-serde-leave environment-serde-wind) '(initial))
            "interpreted serialized map original activation ends")
    (vector environment-serde-k environment-serde-k graph (get) (get))))

(define (environment-serde-case)
  (set! environment-serde-captures 0)
  (set! environment-serde-winds '())
  (let* ((original (make-environment-serde-graph))
         (graph (vector-ref original 2)) (original-get (vector-ref graph 0))
         (port (open-input-string "same-vm-resource"))
         (payload (vector port original port))
         (registry '()) (objects (make-table test: eq?)) (seen (make-table test: eqv?))
         (live? #t) (decode-attempts 0) (decode-completions 0))
    (define (register x)
      (or (table-ref objects x #f)
          (let ((token (+ -128 (length registry))))
            (ensure (< token 0) "bounded same-vm resolver token capacity")
            (if (table-ref seen token #f) (raise 'resource-token-collision))
            (set! registry (cons (cons token x) registry))
            (table-set! objects x token) token)))
    (define (code-tree node)
      (if (not (table-ref objects node #f))
          (begin
            (register node)
            (do ((i 5 (+ i 1))) ((= i (vector-length node)))
              (let ((child (vector-ref node i)))
                (if (and (vector? child) (> (vector-length child) 3)
                         (eq? (vector-ref child 0) node))
                    (code-tree child)))))))
    (define (encode x)
      (cond ((table-ref objects x #f) => (lambda (token) token))
            ((##fixnum? x)
             (if (assv x registry) (raise 'resource-token-collision))
             (table-set! seen x #t) x)
            ((resource? x) (register x))
            (else x)))
    (define (decode x)
      (if (not live?) (raise 'environment-resolver-closed))
      (let ((entry (and (##fixnum? x) (assv x registry))))
        (if entry (cdr entry) x)))
    (define (rebuild encoded transformer)
      (set! decode-attempts (+ decode-attempts 1))
      (let ((result (u8vector->object encoded transformer)))
        (set! decode-completions (+ decode-completions 1))
        result))
    ;; These are actual code-node edges, not arbitrary vector traversal.
    (do ((i 0 (+ i 1))) ((= i 3))
      (let ascend ((code (##interp-procedure-code (vector-ref graph i))))
        (let ((parent (vector-ref code 0)))
          (if (vector? parent) (ascend parent) (code-tree code)))))
    (let ((raw (outcome (lambda () (object->u8vector payload)))))
      (ensure (and (eq? (car raw) 'raised) (error-exception? (cadr raw))
                   (equal? (error-exception-message (cadr raw)) "can't serialize"))
              "default resource serialization refusal stays native"))
    (let* ((encoded (object->u8vector payload encode))
           (partial
            (outcome (lambda ()
              (rebuild encoded
                (lambda (x)
                  (let ((entry (and (##fixnum? x) (assv x registry))))
                    (if (and entry (vector? (cdr entry)))
                        (raise 'environment-decode-fault))
                    (decode x)))))))
           (partial-guard
            (begin
              (ensure (equal? partial '(raised environment-decode-fault))
                      "real partial rebuild exception reaches code field")
              (##gc)
              (ensure (and (normal-wait-topology?) (= (vector-ref (original-get) 1) 5))
                      "partial graph rebuild leaves original roots intact")))
           (rebuilt (rebuild encoded decode))
           (restored (vector-ref rebuilt 1))
           (k (vector-ref restored 0)) (functions (vector-ref restored 2))
           (get (vector-ref functions 0)) (put (vector-ref functions 1))
           (replacement (vector 'serde-environment-cell 9)))
      (ensure (and (eq? (vector-ref rebuilt 0) port) (eq? (vector-ref rebuilt 2) port)
                   (eq? k (vector-ref restored 1))
                   (eq? (vector-ref restored 3) (vector-ref restored 4))
                   (eq? (get) (vector-ref restored 3))
                   (eq? (##interp-procedure-rte get) (##interp-procedure-rte put)))
              "rebuilt continuation, closures, location and resources share canonical targets")
      (put replacement)
      (##gc)
      (ensure (and (normal-wait-topology?) (= (vector-ref (original-get) 1) 5))
              "reconstructed lexical mutation leaves original environment independent")
      (let ((first (call/cc (lambda (out) (set! environment-serde-exit out)
                             (continuation-return k 'serialized-first)))))
        (ensure (and (eq? (car first) 'serialized-first)
                     (eq? (cadr first) replacement) (eq? (caddr first) 'payload))
                "first reconstructed interpreter map continuation uses rebuilt location"))
      (vector-set! replacement 1 11)
      (set! live? #f)
      (ensure (equal? (outcome (lambda () (rebuild encoded decode)))
                      '(raised environment-resolver-closed))
              "closed resolver refuses late reconstruction")
      (set! registry '())
      (set! objects #f)
      (set! payload #f)
      (set! original #f)
      (set! original-get #f)
      (set! graph #f)
      (set! environment-serde-k #f)
      (set! environment-serde-exit #f)
      (##gc)
      (ensure (and (normal-wait-topology?) (= (vector-ref (get) 1) 11)
                   (= decode-attempts 3) (= decode-completions 1))
              "target roots survive source and resolver retirement after partial failure")
      (let ((second (call/cc (lambda (out) (set! environment-serde-exit out)
                              (continuation-return k 'serialized-second)))))
        (ensure (and (eq? (car second) 'serialized-second)
                     (eq? (cadr second) (get)) (= (vector-ref (cadr second) 1) 11)
                     (= environment-serde-captures 1)
                     (equal? environment-serde-winds '(after before after before after before)))
                "second shot after retirement preserves mutation and exact winding"))
      (set! environment-serde-exit #f)
      (close-input-port port)
      (write (list 'COMPLETION-ENVIRONMENT-SERDES-PASS
                   'domain 'same-vm 'default 'refused 'explicit 'rebuilt
                   'shots 2 'captures environment-serde-captures
                   'code-and-resource-registry 'closed 'late-decode 'refused
                   'retained-target 11 'decode-attempts decode-attempts
                   'decode-completions decode-completions 'partial-exception 'retained
                   'second-shot-after-retirement #t 'production-query-ack 'absent)) (newline))))
(environment-hook-case)
(environment-serde-case)
