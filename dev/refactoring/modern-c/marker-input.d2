direction: right
scalar: "Public explicit procedure value"
register: "Existing RC domain\nregister → install → borrow"
allocate: "Marker allocation\nGC may update borrowed cell"
reload: "Initialize marker\nRooted: reload cell; permanent: stable value"
return: "Returned outcome\nTemporary adapter: return loan → free owner\nAlready-rooted caller: keeps its loan"
rooted: "Internal startup rooted caller"
selector: "False / dynamic closure\nunchanged; separate open ABI duty"
scalar -> register -> allocate -> reload -> return
permanent: "Subtyped permanent identity\nNo temporary root or loan"
scalar -> permanent: "Existing object tag/header"
permanent -> allocate: "Address and VM-lifetime stable"
rooted -> allocate: "No temporary root"
register -> return: "Returned refusal; marker unchanged"
