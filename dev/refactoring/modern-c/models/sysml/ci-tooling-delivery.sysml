package GambitCIToolingDelivery {
  private import ScalarValues::*;
  ref part selected = GambitRevisionDelivery::ciTools;
  attribute scope:String="Exactly .github/workflows/ci.yml: remove unused target make package; install Linux m4 prerequisites and run standard aclocal/autoconf in existing setup. Preserve every Build/Test command and platform mode.";
  attribute stage:String="Dependency-only CI publication after qualified default generated products. Local YAML and source controls admit publication; actual remote platform checks are observed afterward and remain distinct from local admission.";
  attribute formalDuty:String="Native YAML parser plus exact comparison of all existing Build/Test steps, job and architecture identities; negative controls reject core replacement and missing macro setup. SysML drives five ASCENT gates; no new QNT protocol or Lean theorem.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part source:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="CI-SOURCE"; attribute :>> method="source-refinement"; attribute :>> artifact=".cache/research/legacy-evidence/evidence/refactoring/modern-c/ci-tooling/source.json"; attribute :>> scope="one-path source cut; completed generated-product baseline; canonical source and preserved native artifact identities"; }
  part controls:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="CI-PREFLIGHT"; attribute :>> method="native"; attribute :>> artifact=".cache/research/legacy-evidence/evidence/refactoring/modern-c/ci-tooling/tests.json"; attribute :>> scope="actual YAML parser; unchanged Build/Test commands and matrix; rejection of core replacement and missing macro setup; source-bound local preflight only, remote results recorded separately"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="CI-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/ci-tooling-delivery.org"; attribute :>> scope="separate prerequisite repair from generated products and bootstrap qualification; preserve the stock core consumer"; }
  part processNeed:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="CI-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/models/sysml/revision-delivery.sysml"; attribute :>> scope="CI dependency cut before pending build/runtime/harness changes; no platform deletion or premature SMP progress"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="CI-MODELS"; attribute :>> method="native-model-projection"; attribute :>> artifact=".cache/research/legacy-evidence/evidence/refactoring/modern-c/ci-tooling/model.json"; attribute :>> scope="strict native SysML projection and shared ASCENT policy with five rejection controls"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="CI-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/ci-tooling-delivery.org"; attribute :>> scope="public namespace/control/GC semantics unchanged; no runtime ownership claim; remote OS and future C23 mode admission remain explicit"; }
}
