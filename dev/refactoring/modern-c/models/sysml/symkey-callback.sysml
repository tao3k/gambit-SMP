package GambitSymkeyCallback {
  private import ScalarValues::*;
  ref part registry=GambitSymkeyPublication::component;
  ref part views=GambitSymkeyGetters::component;
  ref part coverage=GambitModernCDeliveryPlan::rootWriters;
  attribute auditNumber:String="3.5.2.3";
  attribute parentNumber:String="3.5.2";
  attribute requiredCases:String="caller-census;shared-copy;vector-tag;allocator-effect;native-pbt;native-gc;nested-callback;new-publication-excluded;allocation-refusal;copy-refusal;null-callback;predecessor-replay;optional-isolation;producer;original-consumers";
  attribute sourceCases:String="caller-census;shared-copy;vector-tag;allocator-effect";
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="symkey-callback";
    attribute :>> responsibility="Replace callback-spanning native bucket/NEXT borrowing by a private checked permanent-identity snapshot; share the identity-copy primitive with Scheme views and deliver failure to the actual terminal consumer";
    attribute :>> sources="lib/_mem/symbols.inc;lib/mem.h;lib/os_tty.c;tests/root-task.scm;tests/makefile.in";
    attribute :>> tests="Actual linked native iterator, old-source lock control, nested snapshot/interning, real GC, both kinds, actual replay/shrink, controlled allocation/validation refusal, full producer and original consumers";
    attribute :>> retired="Calling a native visitor under global_gate while retaining mutable table/NEXT traversal state; duplicate checked identity walkers; ignored native traversal failure in complete_word";
    attribute :>> excluded="Dynamic C closure ABI, Tcl callback deletion/nonlocal exit, arbitrary foreign writers/owner death, all ROOTS/worker/capacity/scheduler duties and whole-SMP credit";
  }
  attribute scope:String="Baseae9c64f8; one permanent native identity-borrow leaf3.5.2.3, not closure of parent3.5.2/3.5/3.6. Only declared callbacks which return normally and a live global-state owner are admitted. Existing TTY visitor is a pure fold of permanent names and retains only a permanent result identity.";
  attribute stage:String="PUBLISHED4b9d8656; five selected handwritten paths; frozen pre-commit models/checklist retained in publication.json. Parent3.5.2/3.5/3.6 and remaining mixed-feature prototypes stay open; independent13-item/SMP12 accounting unchanged.";
  attribute contract:String="One global_gate interval queries count, performs the existing noncollecting native allocation and copies/validates all identities. Callback execution starts only after unlock and after complete validation. Only permanent symbol/keyword values cross that boundary. Normal return frees the private array exactly once. Refusal invokes no callbacks. Scheme views use the same checked-copy helper but keep collecting allocation outside the gate. Native allocation stays inside to avoid spurious count-growth refusal or an unbounded retry loop.";
  attribute consumer:String="The sole production caller is os_tty complete_word via lineeditor_word_completion; CANNOT_COMPLETE returns INVALID_OP before edit/insert or completion cleanup. Ordinary concurrent registration must not introduce this error. Snapshot OOM/validation refusal has explicit status. Unchanged pure visit_symbol and descending-bucket copy order imply the same completion fold for an admitted snapshot; interactive terminal behavior is not inferred from a callback PBT.";
  attribute memoryOrder:String="Existing global_gate acquire/release serializes all admitted registry writers with count/allocation/copy. No new atomic or distributed protocol. The native malloc/debug wrapper has no Scheme/GC call. Callback GC may update ordinary roots while copied permanent identities retain lifetime/address. A snapshot is not a global-state shutdown pin or a proof that all raw writers are admitted.";
  attribute cost:String="At most N*sizeof(SCMOBJ) native payload bytes per simultaneously active snapshot, plus allocator and C stack overhead. One allocation/free and N pointer copies per nonempty call; one gate interval as before, now including native allocation and excluding every callback. Empty snapshots allocate zero. Nested depth adds the active snapshot sizes. No new VM/root fields, RC roots, root scans or performance/whole-round RSS claim.";
  attribute benefit:String="A callback borrows only immutable-lifetime identities; it cannot keep bucket/NEXT traversal aliases. Native reentrant interning/nested snapshots and GC need not hold the registry gate. Shared Scheme/native copy support retires a separate unchecked walker. Critical occupancy changes from traversal plus sum(callback work) to count/native allocation/checked copy; benefit depends on callback work exceeding copy/allocation cost.";
  attribute unknown:String="Returned refusal balances owned native storage. Arbitrary longjmp, thrown Scheme continuation through this private C callback, foreign cancellation or global cleanup is not admitted. No unknown outcome authorizes free or proves owner death. General callback/activation cleanup remains a separate open root borrower duty.";
  attribute formalDuty:String="SysML owns lifetime/effect/caller/linearization and cost premises. Source refinement proves the existing gate interval and actual noncollecting allocator/TTY endpoints; real native PBT probes the linked iterator, with exact old-source control and controlled failure adapter. Reuse existing source/native concordance ASCENT and shared five gates. Existing QNT keeps competing root/task histories and Lean keeps distinct conditional coverage/address laws. Neither is copied or claimed to prove this serial snapshot loop; concrete mutex refinement is the new obligation.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="SYMKEY-CALLBACK-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/symkey-callback/receipt.json"; attribute :>> scope="Actual linked iterator and real GC/reentry/PBT; exact predecessor replay/shrink, controlled native adapter, complete original producer and consumers under unchanged limits"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="SYMKEY-CALLBACK-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/symkey-callback.org"; attribute :>> scope="Identity lifetime versus mutable traversal, shared support, necessary native allocation under gate and real TTY failure semantics; costs and falsifiers"; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="SYMKEY-CALLBACK-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/symkey-callback.org"; attribute :>> scope="One complete leaf, remaining whole-path inventory recomputed, parent ROOTS/SMP ledgers remain separate; no unqualified prototype admission"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="SYMKEY-CALLBACK-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/symkey-callback.org"; attribute :>> scope="Native SysML and actual ASCENT source/native/case checks, exact adapter-to-source bridge; QNT/Lean distinct and unchanged"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="SYMKEY-CALLBACK-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/symkey-callback.org"; attribute :>> scope="Why permanent identities need no extra roots, who allocates/frees, normal growth versus failure, lock order and callback return assumptions, real old control versus broader SMP claims"; }
}
