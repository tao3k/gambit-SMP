package GambitBankRootTask {
  private import ScalarValues::*;
  ref part predecessor=GambitVmRootTask::component;
  ref part acceptanceBoundary=GambitModernCProgress::gcFfi;
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="bank-root-task";
    attribute :>> responsibility="One participant's register/saved/type-cache/processor-object bank becomes an explicit VM-slot RootOrigin and confined RootTask; original four disjoint visitors and order retained; stack remains separate";
    attribute :>> sources="lib/root.h;lib/_mem/root-tasks.inc;lib/_mem/root-origins.inc;lib/_mem/capacity-resize.inc;lib/_mem/collection-round.inc;tests/root-task.scm;tests/makefile.in";
    attribute :>> tests="Exact producer and existing frame/map/RC/exit/original test disposition; existing native Scheme PBT extended to bank; same compiled fixture additionally runs p2 bank moving roots on owners0/1; byte-exact relocation of three existing visitors";
    attribute :>> retired="Four direct unclaimed bank scans in strong phase; bank scanner definitions owned by capacity-resize; VM-only confined publisher/initializer replaced by shared fresh-task constructor/publication without an alias";
    attribute :>> excluded="Continuation stack tasks/frame restoration, globals/symbol sources, complete census, async scheduling, W!=R, VM membership/capacity/unknown join, raw FFI/cross-VM writers and whole SMP";
  }
  part priorEdge:GambitRevisionDelivery::Dependency { ref part :>> predecessor=GambitVmRootTask::component; ref part :>> successor=component; }
  part nextEdge:GambitRevisionDelivery::Dependency { ref part :>> predecessor=component; ref part :>> successor=GambitRevisionDelivery::rootDispatch; }
  attribute scope:String="Bank source is the current participant's execution_context and matching active VM slot. Existing setup barriers and stack handling precede bank publication. Task scans r,saved,type_cache,processor_scmobj separately, never pc/fp/hp or padding. Each participant owns one fresh confined C task; no queue or independent executor.";
  attribute stage:String="After832d6e51 VM task; bank source/native review complete: tree328eadaa, bootstrap210.399s/core36.323s; RC/VM/BANK2592 actions,24-to4 shrink/replay each, p2 bank cells owners0/1 pass. Actual publication belongs in bank-root-task-result.org. Stack/globals/symbol tasks and arenas remain separate successors; no inherited SMP numerator.";
  attribute formalDuty:String="Existing root_dispatch alone checks temporal claim/scan/finish/unknown/round schedules; SCANNED is an internal native cut. Existing Lean RuntimeRoles owns conditional logical-cell census/partition/current-address laws; bank cells use VM slot,family,range,index, not referent identity. At p2 actual RC2+bank2+VM1 is five tasks; existing two-origin model is a selected projection, not full census or source of a whole-round seal. No new QNT/Lean machine/proof.";
  attribute memoryOrder:String="Bank state is confined to current participant's nonreentrant C invocation under the existing stopped collective; no extra atomic/mutex. Current-PSTATE, active population, context pointer and actual VM-slot identity checked before source payload access. External stop/epoch/storage premises come from the actual GC caller, not a fabricated flag. Arbitrary raw/cross-VM writers and unknown stops remain excluded.";
  attribute lifecycle:String="Shared fresh init/publish controls VM and bank; RC retains its domain gate and common claim/finish. Current admitted RC epoch seeds bank task and must match. Source storage/round hold outlives task DONE. Fresh init is never a reset of unknown work; stack/capture ownership is not inferred from bank completion.";
  attribute writers:String="Generated GVM register macros and lowlevel context consumers; GC_SAVE1/2/3 helpers; _io.scm character-port cache stores; setup and _thread processor queues/interrupt stores are existing bank writers. Existing safepoints/collective protect admitted writers. Field15 is documented unused processor storage for the focused native fixture, not a new production field.";
  attribute pbt:String="One existing root-task.scm/Make driver covers RC,VM,bank. C arguments are snapshotted before p1 bank payload is set to immediates; no subsequent Scheme allocation/callback/return before _Exit. Same observable oracle/replay/deletion shrink. Real p2 pinned owners0/1 separately retain a pair/vector through actual moving GC in processor unused-field15.";
  attribute progress:String="This delta adds the bank domain only. Historical taxonomy remains GambitModernCProgress; current component observations/actual publication update the live branch checklist. Stack/globals/symbol-keyword tasks, full census, independent arenas/restoration and all whole-runtime gates remain separate.";
  attribute nativeObservations:String="Current GSI408/40862.465s first sample; whole check test8 still fails setup capacity6/6,members1/12,max_heap0; later official consumers pass6.612s. Origin16/task48/domain192/public layouts unchanged, persistent delta0; bank source-level record48+epoch8, optimized stack/peak unmeasured.32 disjoint cells and byte-exact moved visitors; no extra mutex/task allocation.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="BANK-ROOT-TASK-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/bank-root-task/receipt.json"; attribute :>> scope="Exact bootstrap/current required consumers; all three real implementation PBT families and replay/shrink; p2 bank cell relocation owners0/1; original test disposition/failures retained. Missing required component test blocks; not full SMP acceptance."; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="BANK-ROOT-TASK-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/bank-root-task.org"; attribute :>> scope="Retire implicit bank scan authority, preserve actual disjoint ranges and visitor bodies, measure metadata/control/test costs without a runtime speedup claim."; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="BANK-ROOT-TASK-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/bank-root-task.org"; attribute :>> scope="Bank-only REV after VM; current branch checklist; existing cache/profile/names/limits; remaining stack, workers, membership and FFI explicit."; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="BANK-ROOT-TASK-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/bank-root-task.org"; attribute :>> scope="Map actual bank source/tuple/scan completion to existing temporal model and distinct Lean cell/address premises. Source binding and quiescence are explicit conditional refinement duties, not complete C proof or duplicated models."; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="BANK-ROOT-TASK-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/bank-root-task.org"; attribute :>> scope="Why whole-context flattening is invalid; why source slots differ from shared multi-shot object identity; why stack/round lifetime cannot be discharged by bank DONE; why confined tasks do not prove W!=R."; }
}
