package GambitStressGsiCursorHandoff {
 private import ScalarValues::*;
 ref part section = GambitStressGsiSectionRealization::family;
 attribute fastPath:String="Compiler closure reservation and generated ALLOC_CLO write through the local hp. A range check alone does not establish exclusive live ownership or a current epoch.";
 attribute handoff:String="The collector arena or disjoint resume loan sets the owning processor's alloc_heap_ptr. After restoration and possible fudge refill, prepare_mem_pstate publishes context hp; generated host entry must reload it.";
 attribute oldReader:String="Old physical claims may retire only after all old-section readers drain. The linked p2 diagnostic holds the last restoration read through a real waiting load and checks that a bypass crosses the cut while that reader is held. The original-family campaign and coverage of other old-space readers remain open.";
 attribute existingModels:String="Reuse ContinuationRestorePlan and DedicatedCopyCapacity for admission and capacity. The reader-cut model records a separate physical lifetime obligation and does not replace those models.";
 attribute family6TemporalModel:String="dev/refactoring/modern-c/models/quint/smp_resume_publication_tfib.qnt";
 attribute family6Authority:String="Bind VM lifetime, context, epoch, physical section and parity, interval and publication sequence at the producer. Match all of them at the actual generated reload and first complete write.";
 attribute sectionParityControl:String="The diagnostic arms on the published physical section and destination half. It rejects a changed section or half before the generated header store even when cursor, base and limit have the same numeric values. Observe the whole six-word region independently in both negative cases.";
 attribute firstObject:String="The first observed allocation kind is an output of the resumed path. Pair and join closure both require current physical authority and a full pre-store extent. Pair completion includes the header, CAR, CDR and final cursor. Coverage of other allocation entries remains separate.";
 attribute linkedJoinControl:String="The opt-in join receiver requests a real GC with the captured continuation, thread and timeout still live. Require the generated resume label before the six-word closure write and use the same site for the short-extent control. An intervening pair leaves the join first-write witness open.";
 attribute family6CorrectnessEvidence:String="Retain the earliest mismatch in release, publication, reload or complete write. Missing event coverage leaves the diagnosis open, even when no mismatch is observed.";
 attribute family6PerformanceEvidence:String="A valid but censored stress run records per-phase progress and time on the original workload. Coverage, natural completion and matched cost are separate evidence.";
 attribute family6Handoff:String="Python drive_flow projects these source obligations through the shared heap SysML SourceSite and existing ASCENT rules. Use the DEV Org checklist to review Grok receipts before family admission.";
 attribute familyAdmitted:Boolean=false;
}
