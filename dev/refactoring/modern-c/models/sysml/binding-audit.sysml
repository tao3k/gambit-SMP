 part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
 part tests:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="BA-AUDIT-TESTS"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/binding-activation/framework-submission/validation.json"; attribute :>> scope="All37 exact source-selected tests pass; published native-development tests retained. Native runtime consumers have independent vendor admission."; }
 part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="BA-AUDIT-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/binding-activation.org"; attribute :>> scope="No stable runtime speedup; retain rejected designs and actual negative controls."; }
 part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="BA-AUDIT-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/binding-activation.org"; attribute :>> scope="One complete post-foundation binding owner; primary path inventory is not progress; independent1/12 unchanged."; }
