 part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="BA-AUDIT-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/binding-activation.org"; attribute :>> scope="Explicit metadata cost, read/lifetime preconditions, code-layout sensitivity and retained whole-SMP failures."; }
