part role2:RoleRow { attribute :>> key="StableGuard"; attribute :>> identity="Activation TicketId, rooted arguments and completion custody"; attribute :>> retirement="Exact activation settled, entry closed, scanner and code readers drained"; attribute :>> boundary="Guard persistence does not extend local jmp_buf lifetime"; }
part role3:RoleRow { attribute :>> key="CapturedContinuation"; attribute :>> identity="Scheme frames, denv and descriptor leases"; attribute :>> retirement="All reachable holders and in-flight restorations relinquished"; attribute :>> boundary="A restoration does not recreate expired native return authority"; }
part role4:RoleRow { attribute :>> key="RootBundle"; attribute :>> identity="Actual GC-updatable slots and owner generation"; attribute :>> retirement="Transfer acknowledged, borrowers drained and collector grace"; attribute :>> boundary="Native pointer pin alone is not a registered Scheme root"; }

part proof10:ProofRow { attribute :>> key="consumedReturnNeverRevives"; attribute :>> lemma="NativeReturn.consumedReturnNeverRevives"; }

part proof11:ProofRow { attribute :>> key="newShotGetsFreshTicket"; attribute :>> lemma="NativeReturn.newShotGetsFreshTicket"; }
}
