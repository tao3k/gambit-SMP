part gain0:GainRow { attribute :>> key="G1"; attribute :>> avoided="No current C-stack-copying work removed; zero-copying constraint retained"; attribute :>> added="Pinned native carrier and explicit segment registry"; attribute :>> condition="No arbitrary C-stack copying; thread-affine libraries remain on owner"; }
