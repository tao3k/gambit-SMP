package GambitMarkerInput {
  private import ScalarValues::*;
  ref part sourceBase=GambitTclCommand::component;
  ref part rootProtocol=GambitRcTask::component;
  ref part coverage=GambitModernCDeliveryPlan::rootWriters;
  attribute auditNumber:String="3.5.2.2";
  attribute parentNumber:String="3.5.2";
  attribute requiredCases:String="real-gc;vector-refusal;rc-refusal;borrow-refusal;rooted-entry;permanent-origin;optional-isolation;predecessor-replay;original-consumers;producer";
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="marker-input";
    attribute :>> responsibility="Classify explicit marker inputs by lifetime: permanent identity needs no temporary root; movable/still inputs have a registered borrowed root before allocating the marker, reload after collection and release both borrow and native owner on every returned outcome";
    attribute :>> sources="lib/c_intf.c;lib/makefile.in;tests/root-task.scm;tests/makefile.in";
    attribute :>> tests="Complete source producer and original consumers; actual C marker under real GC, controlled RC/vector/borrow refusal, repeated construction, source count conservation, existing implementation replay/shrink";
    attribute :>> retired="A by-value explicit movable procedure surviving a collecting call solely as an untracked C scalar";
    attribute :>> excluded="False/dynamic closure identity, generated conversion banks, arbitrary nonlocal allocation exits, callback deletion/drain, worker/capacity/scheduler changes and complete3.5.2/3.5/3.6";
  }
  attribute scope:String="Base920cf0c7. One explicit scalar-input ownership adapter at the existing public API. Internal already-rooted startup callers retain their no-extra-root path. False selects the existing dynamic C-closure path unchanged; its ABI and lifetime remain open.";
  part rootDependency:GambitRevisionDelivery::Dependency { ref part :>> predecessor=GambitRcTask::component; ref part :>> successor=component; }
  attribute stage:String="QUALIFYING.3.5.2.2 explicit input root handoff; parent3.5.2/3.5/3.6 and separate SMP12 remain open. No repair-line credit or pending prototype admission.";
  attribute contract:String="A valid subtyped permanent input has an immutable lifetime/address until global cleanup; it uses the existing scalar constructor without a temporary root. Still is not permanent. For movable/still input alloc_rc/register and try_set do not collect. On successful installation borrow the root, then allocate marker and reload the cell. Returning the borrow precedes releasing the native owner. Allocation/registration/store/borrow refusal returns the existing SFUN heap error without publishing marker; vector refusal returns after balancing the root. A valid active owner context is a caller premise, not established from a foreign pointer.";
  attribute memoryOrder:String="Existing RC domain mutex serializes install/borrow/release and logical writers; current cooperative GC freezes that domain and updates its cell through the claimed RootTask. No root gate is held over GC. The borrow prevents logical replacement, not physical relocation. No new C atomics, root registry or independent scanner is introduced.";
  attribute unknown:String="Returned failures permit local balance. Arbitrary foreign cancellation or nonlocal exit between root acquisition and release is not authorized; no returned outcome means no inferred cleanup/owner death receipt. make_vector/alloc_scmobj's audited path reports allocation errors as fixnums. Generated SFUN/CFUN exits remain a separate responsibility.";
  attribute benefit:String="A scalar input is transferred to an existing scanned source before the first GC-capable call; physical movement no longer leaves a stale marker procedure. Multi-shot continuation, marker layout, invocation protocol and public namespace stay unchanged. This is a correctness contract, not a measured throughput improvement.";
  attribute cost:String="One temporary native RC header per nonpermanent explicit input call, five existing registration/install/borrow/return/release critical sections, and temporary root scan work. Permanent input classification adds a tag/header check but no root allocation. Internal rooted startup and false-selector paths avoid this allocation. Count header bytes under the unchanged layout and bounded simultaneous depth; allocator overhead and GC peak remain unmeasured. Future generated caller roots may avoid this boundary cost only under their own proof.";
  attribute formalDuty:String="Source refinement establishes actual allocator effects, live-cell reload and balanced returned paths. Existing QNT retains temporal source/task histories; existing Lean retains distinct conditional coverage/address laws. This serial adapter adds no duplicate machine or theorem. SysML drives source/native evidence obligations; ASCENT rejects stale identity, missing real GC/failure controls or unsupported whole-parent admission.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="MARKER-INPUT-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/marker-input/receipt.json"; attribute :>> scope="Actual production implementation and controlled allocator adapter; real moving GC, refusal balance, predecessor replay/shrink, complete original consumers"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="MARKER-INPUT-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/marker-input.org"; attribute :>> scope="Explicit C scalar versus already-rooted caller and closure selector; explain why each allocation is necessary and what remains unchanged"; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="MARKER-INPUT-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/marker-input.org"; attribute :>> scope="One leaf3.5.2.2, parent obligations open, preserve dirty prototypes and separate13-item versus SMP12 ledgers"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="MARKER-INPUT-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/marker-input.org"; attribute :>> scope="Actual source/order/native adapter premises with native SysML and ASCENT, no duplicate QNT/Lean"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="MARKER-INPUT-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/marker-input.org"; attribute :>> scope="Which callers supply movable values, which operations collect, why temporary native root, which errors return, what extra cost and closure/unwind gaps remain"; }
}
