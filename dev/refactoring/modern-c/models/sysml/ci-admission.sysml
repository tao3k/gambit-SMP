 part submission:GambitCommitGates::SubmissionUnit { attribute :>> kind="support"; attribute :>> result=""; attribute :>> progressDelta=0; attribute :>> supportPaths="evidence/scenarios/stack-header/source-byte-clues.view.json;evidence/scenarios/stack-header/pointer-unit-clues.view.json;evidence/scenarios/concurrent-gc/captured-heap-return.view.json;evidence/scenarios/concurrent-gc/btq-copy-epochs.view.json;evidence/scenarios/concurrent-gc/ffi-select-frame.view.json;evidence/scenarios/concurrent-gc/btq-edge-integrity.view.json;evidence/scenarios/concurrent-gc/btq-working.view.json;evidence/scenarios/zig-native/research.view.json;evidence/scenarios/tool-reasoning/framework-execution.view.json;evidence/scenarios/zig-native/research.view.source.json;evidence/scenarios/zig-native/research.view.binding.json;evidence/research/ci/upstream-check.recipe.json;evidence/research/ci/gc-ffi.recipe.json;evidence/research/ci/compile-execute.recipe.json;evidence/research/ci/threads.recipe.json;evidence/research/ci/tfib-stress.recipe.json;evidence/research/ci/interrupt-stress.recipe.json;evidence/research/ci/interrupt2-stress.recipe.json;evidence/research/ci/terminate-stress.recipe.json;tests/test_source_identity.py;tests/test_runtime_artifact.py;dev/refactoring/modern-c/models/sysml/ci-admission.sysml;dev/refactoring/modern-c/ci-admission.org;dev/refactoring/modern-c/branch-checklist.org;dev/refactoring/modern-c/diagrams/ci-admission.d2;dev/refactoring/modern-c/diagrams/ci-admission.svg;evidence/research/retained/modern-c/ci-admission/receipt.json;evidence/research/retained/modern-c/ci-admission/remote.json;evidence/research/retained/modern-c/ci-admission/source-identity-tests.txt;evidence/research/retained/modern-c/ci-admission/runtime-artifact-tests.txt"; attribute :>> testModules="tests/test_source_identity.py;tests/test_runtime_artifact.py"; }
