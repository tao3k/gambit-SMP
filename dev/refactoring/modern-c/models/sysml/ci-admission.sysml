 part submission:GambitCommitGates::SubmissionUnit { attribute :>> kind="support"; attribute :>> result=""; attribute :>> progressDelta=0; attribute :>> supportPaths="src/gambit_smp/runtime_artifact.py;tests/test_runtime_artifact.py;tests/test_upstream_tests.py;tests/test_source_identity.py;evidence/scenarios/concurrent-gc/working-modeling.view.json;evidence/scenarios/concurrent-gc/reasoning-methods.view.json;evidence/scenarios/concurrent-gc/reasoning-methods.view.source.json;evidence/scenarios/concurrent-gc/reasoning-methods.view.binding.json;evidence/research/ci/upstream-check.recipe.json;evidence/research/ci/gc-ffi.recipe.json;evidence/research/ci/compile-execute.recipe.json;dev/refactoring/modern-c/models/sysml/ci-admission.sysml;dev/refactoring/modern-c/ci-admission.org;dev/refactoring/modern-c/branch-checklist.org;dev/refactoring/modern-c/diagrams/ci-admission.d2;dev/refactoring/modern-c/diagrams/ci-admission.svg;evidence/research/retained/modern-c/ci-consumer-closure/receipt.json;evidence/research/retained/modern-c/ci-consumer-closure/remote.json;evidence/research/retained/modern-c/ci-consumer-closure/tests.txt;evidence/research/retained/modern-c/ci-consumer-closure/framework-failure.txt"; attribute :>> testModules="tests/test_source_identity.py;tests/test_runtime_artifact.py;tests/test_upstream_tests.py"; }
