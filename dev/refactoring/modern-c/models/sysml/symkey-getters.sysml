package GambitSymkeyGetters {
  private import ScalarValues::*;
  ref part prior=GambitSymkeyViews::component;
  ref part coverage=GambitModernCDeliveryPlan::rootViews;
  attribute auditNumber:String="3.4.2";
  attribute parentNumber:String="3.4";
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="symkey-getters";
    attribute :>> responsibility="Both C-target Scheme registry getters own flat identity vectors; in-tree Geiser, documentation and official metadata consumers traverse only those owned values";
    attribute :>> sources="lib/_kernel.scm;lib/_geiser/_geiser.scm;doc/checkdoc.scm;tests/test10.scm;tests/run-unit-tests.scm;tests/root-task.scm";
    attribute :>> tests="Same workspace and Bazel C23 source bootstrap/original tests; real getter PBT, negative raw getter alias, shrink/replay, native interning growth, GC, callback escape and multi-shot recovery; actual reader AST/caller census";
    attribute :>> retired="Production C-target Scheme getters exposing GSTATE bucket storage; direct bucket/NEXT iteration in the four in-tree consumer sites; noninterrupting classification of a now allocating getter";
    attribute :>> excluded="External private-layout users including Gerbil TODO heap walker, optional native debug diagnostics, raw reflective writes, full writer/lifetime census and worker separation; no wholesale SMP or performance claim";
  }
  part priorEdge:GambitRevisionDelivery::Dependency {
    ref part :>> predecessor=GambitSymkeyViews::component;
    ref part :>> successor=component;
  }
  attribute scope:String="Base da5651af. Complete leaf3.4.2 under thirteen-item audit stage3 ROOTS. Parent3.4 remains open for external private-layout disposition; three scoped closed and three remaining ROOTS groups, separate from twelve exact-source SMP acceptance families. Do not stage unrelated pending prototypes.";
  attribute stage:String="QUALIFYING owned getter/caller replacement after3.4.1 managed fold; source-bound selected tree and same leased producer are authoritative. Pending changes have dependency-ordered batches, not permission to commit by directory.";
  attribute capture:String="Preserve private getter names and arities; return a fresh flat vector of canonical PERM symbol/keyword identities through the existing query/allocate/copy service. Scheme allocation and precise rooting happen outside global_gate; matching-count native copy holds that gate, allocates nothing and retains no destination. Remove not-interrupts-enabled from allocating wrappers. No bucket count/NEXT layout survives delivery.";
  attribute aliases:String="Different getter calls own distinct vectors; mutation of one cannot affect registry or another view. Ordinary Scheme GC/continuation frames retain vectors; native rehash cannot reach them. The vector is mutable ordinary shared Scheme data, not a universally immutable snapshot. Stored binding values are not snapshotted. Multi-shot restoration shares a view captured by a fold; no one-shot restriction.";
  attribute callers:String="Geiser module completions folds canonical identities and retains its filtering/sorting; checkdoc and both official procedure metadata adapters use vector-to-list without bucket skipping or symbol-field iteration. Universal target remains separate. Native GSC source has no getter intrinsic override. Explicit raw test getter executes only as predecessor negative control. External private representation readers must migrate or remain unadmitted.";
  attribute failure:String="Allocation may collect or escape without native lock/debt; count change retries without destination writes; errors retain only ordinary unpublished Scheme objects. Finite completion needs stable count interval. No worker/owner-death guarantee, bounded polling latency or native buffer escrow is inferred.";
  attribute formalDuty:String="Existing QNT owns source/task lease histories; existing Lean owns conditional cell/census/address laws. Neither is duplicated for Scheme vectors. Concrete getter classification, C-target generated roots, caller iteration, alias isolation, actual copy/count refusal and multi-shot recovery are source/native refinement obligations. SysML provides the component and gate needs to actual ASCENT; ambient LLM review is not native evidence.";
  attribute benefit:String="Remove two live registry alias escape sites and four in-tree intrusive readers. Reuse the existing capture service and ordinary Scheme rooting instead of per-consumer locks/cleanup. A retained or mutated Scheme view cannot rewrite registry topology, and callbacks/resumptions can outlive rehash. This amplifies Gambit shared identity and multi-shot semantics; it is not a repair9/whole-SMP or speedup claim.";
  attribute cost:String="Each getter changes O(1) alias return into O(bucket count+N) capture plus N managed reference words and header, with transient retry vectors and unbounded aggregate retained views. Live views add ordinary GC reference scanning; no whole-GC work reduction is claimed. Two independent getters use two vectors; canonical PERM identities are not copied. Zero new native buffers, mutexes, public fields or manual root records. Physical peaks, contention and timing benefit remain unmeasured; downstream private-layout migration is a real cost.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="SYMKEY-GETTERS-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/symkey-getters/receipt.json"; attribute :>> scope="Exact producer/original tests, actual getter/old raw getter replay and shrink, alias/growth/GC/resumption, caller census and AST refinement"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="SYMKEY-GETTERS-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/symkey-getters.org"; attribute :>> scope="Delivery transfers representation ownership; insertion synchronization alone cannot protect escaping bucket aliases"; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="SYMKEY-GETTERS-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/symkey-getters.org"; attribute :>> scope="Leaf3.4.2, thirteen-item audit and separate SMP12; pending REV dependency batches preserve unrelated work"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="SYMKEY-GETTERS-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/symkey-getters.org"; attribute :>> scope="Native SysML to ASCENT needs, source/caller bridge; unchanged QNT histories and distinct Lean laws"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="SYMKEY-GETTERS-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/symkey-getters.org"; attribute :>> scope="Why getters and all direct consumers must move together; cost/falsifiers; why external raw private layout keeps parent open; Gambit identity and multi-shot advantage"; }
}
