package GambitBuildResources {
  private import ScalarValues::*;
  ref part selected=GambitRevisionDelivery::buildResources;
  attribute scope:String="Exactly eight existing source files, selected resource/stamp/probe/runner blocks only. No modular header, runtime ABI, generation metadata encoding, strict cross-platform C23 gate or default C snapshot replacement";
  attribute stage:String="Build resource REV after target integration, before generation-configuration and runtime ownership. Preserve every unqualified staged/working block; use the single established cache and Bazel SMP/C23 service";
  attribute formalDuty:String="Source refinement of existing Make jobserver/CLI parsing and conditional initial-context bound; native bootstrap, incremental, runtime-population and early-failure controls. Existing GC/control/build-state models retain their duties; no duplicate QNT/Lean protocol is added";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part source:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="BR-SOURCE"; attribute :>> method="source-refinement"; attribute :>> artifact="evidence/refactoring/modern-c/build-resources/source.json"; attribute :>> scope="exact eight-path partial tree; configured private SMP products remain separate from default distribution C; unchanged runtime ABI and pending source custody"; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="BR-NATIVE"; attribute :>> method="native"; attribute :>> artifact=".cache/research/legacy-evidence/evidence/refactoring/modern-c/build-resources/tests.json"; attribute :>> scope="complete two-pass bootstrap <=600s with existing Bazel SMP/C23 flags; all original check prerequisites; two no-change cores, only edited native object on C-only change, source restoration, compilerp1/runtimep2, affected compiled cases and immediate phase failure; failed dummy seed attempt retained"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="BR-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/build-resources.org"; attribute :>> scope="initial-context versus thread quota; accumulated versus exclusive options; producer seed versus stock consumer; artifact reuse versus source/configuration qualification"; }
  part processNeed:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="BR-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/models/sysml/revision-delivery.sysml"; attribute :>> scope="resource subcut is independently reviewable; C23 admission, raw generation strings, header/ABI and modular SMP CI remain separate dependencies"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="BR-MODELS"; attribute :>> method="native-model-projection"; attribute :>> artifact="evidence/refactoring/modern-c/build-resources/model.json"; attribute :>> scope="strict native SysML projection and actual shared ASCENT policy with stale/missing evidence controls; no duplicate QNT/Lean"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="BR-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/build-resources.org"; attribute :>> scope="Scheme/tail/multi-shot and C portability preserved; managed resource bound conditions explicit; no whole-SMP, universal option override or measured speedup assertion"; }
}
