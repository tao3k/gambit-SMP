package GambitGlobalsRootTask {
  private import ScalarValues::*;
  ref part storageReplacement=GambitRequestProduct::globalStorage;
  attribute sourcePeriod:String="Historical fixed-array root-task REV. Its count/index/capacity statements describe that source period only. Current storage replacement is GambitRequestProduct::globalStorage; this record grants no current fixed-array or full-SMP acceptance.";
  ref part predecessor=GambitSymkeyRootTask::component;
  ref part acceptanceBoundary=GambitModernCProgress::gcFfi;
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="globals-root-task";
    attribute :>> responsibility="Each collecting participant's global-variable shard becomes a typed immutable local source descriptor and GLOBALS RootOrigin -> confined RootTask; explicit registry count/roster/index/half-open bounds drive the real scanner";
    attribute :>> sources="lib/root.h;lib/_mem/root-tasks.inc;lib/_mem/root-origins.inc;lib/_mem/collection-round.inc;lib/_mem/memory-lifecycle.inc;tests/root-task.scm;tests/makefile.in";
    attribute :>> tests="Exact bootstrap, existing roles/frame/map/RC/exit/original disposition, seven real Scheme replay/shrink families; globals adds four metadata corruption refusals per core history, finite partition checks including empty shards and p1/p2 actual shard relocation plus generated global setter survival";
    attribute :>> retired="Direct unclaimed mark_global_variables and scanner-internal PSTATE/registry partition derivation; old literal20000 allocator extent becomes shared GLOBALS_CAPACITY with same value; repeated fresh eligibility factored into existing confined protocol, no alias/new state machine";
    attribute :>> excluded="Cross-VM registry/foreign writer closure, complete universal census/round seal, W!=R/independent workers/arenas/restoration, glos resizing/reclamation, capacity/unknown join/CFFI/generations and whole SMP; single-VM branch has source review but no second native profile";
  }
  part priorEdge:GambitRevisionDelivery::Dependency { ref part :>> predecessor=GambitSymkeyRootTask::component; ref part :>> successor=component; }
  part nextEdge:GambitRevisionDelivery::Dependency { ref part :>> predecessor=component; ref part :>> successor=GambitRevisionDelivery::rootDispatch; }
  attribute scope:String="Actual caller publishes one globals view after RC task and before stack/bank, using admitted RC epoch. View holds global-state/VM pointers,count,participants,participant,lo,hi. Single VM scans linked bucket range floor(id*GLO_SUBLIST_COUNT/R)..floor((id+1)*GLO_SUBLIST_COUNT/R); multiple VM scans actual vm->glos floor(id*count/R)..floor((id+1)*count/R). Root cells are visited/updated in place, never copied into a value snapshot.";
  attribute stage:String="Aftercaa630e9 SYMKEY task. Globals-only source/shard/writer adapter under qualification in existing Modern C workspace/profile; actual observations and publication belong in globals-root-task-result.org. This component is not complete SMP, cross-VM registry closure or independent workers.";
  attribute lifecycle:String="Caller supplies valid fresh metadata storage, existing stopped admitted writers, stable registry topology/count/roster and outer VM/global/round lifetime. Descriptor initialized before READY only on shared fresh guard; publication refusal never overwrites an exposed descriptor. Repeated known publication requires same pointer and unchanged fields. Claim/scan/finish rederive expected view and reject stale/mutated metadata. Only normal scanner return gives SCANNED and one lease release. Unknown scan cannot reset/requeue; local DONE does not reclaim descriptor users/VM/glos/global registry/descendants.";
  attribute memoryOrder:String="Task and descriptor are confined to one nonreentrant C invocation; descriptor is const at consumers. C sequencing initializes fields before existing READY publication, no new mutex/atomic/queue/task allocation. Existing stopped collective and admitted writer exclusion remain premises. Snapshot rechecks are TOCTOU checks, not a cross-VM writer freeze; native/raw writes and module/registry changes require separate closure. Existing copying/frame/weak synchronization unchanged.";
  attribute writers:String="Generated GVM GLO/global setters and GLOBALVARSET write VM glos or single-VM glo->val; gsc/_t-c-2 global-var-set operator emits that macro; _kernel global-var-set routes to it. setup.c module binding writes UNB markers; setup and make_global_var call glo_list_add, changing registry count/list/global indexes. VM setup initializes allocated glos to UNB1. Scanner rewrites live addresses. Primitive PRMCELL setters are a separate permanent/runtime contract, not added to ordinary global roots. Other VM registry changes, dynamic aliases and raw FFI writers remain OPEN.";
  attribute physicalBound:String="Memory-lifecycle already allocates20000 glos cells. A private shared GLOBALS_CAPACITY replaces only that literal and bounds multi-VM view admission; no allocation/heap increase or new arbitrary capacity. Partition helper checks valid range and unsigned product representability before floor division. Single-VM bucket capacity remains GLO_SUBLIST_COUNT. Audited source has a resize TODO and no explicit glos free endpoint; this leaf does not claim or redesign reclamation.";
  attribute formalDuty:String="Existing QNT root_dispatch exclusively owns temporal publication/claim/scan/finish/stale/unknown/drain. Native SCANNED is an internal cut. Existing Lean RuntimeRoles exclusively owns conditional logical-cell census/partition/current-address laws: cells use VM,GLOBALS,index or bucket/node/val coordinate, not referent identity. Finite C partition/metadata PBT checks are implementation refinement evidence, not duplicate mathematical/temporal models. At p2 RC2+BANK2+STACK2+GLOBALS2+VM1+SYMKEY1 gives ten local tasks; unchanged two-origin QNT is a selected projection, not whole census/round seal. No QNT/Lean duplication or Lean rerun.";
  attribute refinement:String="Under stable roster/registry/topology and current participant/epoch premises, checked floor bounds equal old valid arithmetic, explicit cell addresses/order equal old scanner. Single-VM GLOCELL expands to val identity; multi-VM scanner consumes vm->glos+lo from frozen source. Other visitor/frame/copy/weak algorithms unchanged. Stable allocation extent ties admitted count to real backing storage. This is conditional C refinement; arbitrary cross-VM mutation and universal C memory-model proof remain open.";
  attribute pbt:String="Existing root-task.scm/Make only: seventh family GLOBALS adds source snapshot corruption requests to shared typed oracle/replay/deletion shrinker, not another simulator. Immediate-only fresh p1 replay snapshots all C commands then clears actual global payload to FAL without changing count/roster; no Scheme allocation/lookup/callback/return before _Exit. Positive native control borrows one UNB1 cell in every actual p1/p2 shard, installs moving pairs, calls native GC, checks actual cell updates and restores before returning to Scheme. Separate normal generated set!/GC verifies an owned global pair/vector. Partition checker covers empty shards and invalid inputs. Mutation/shrink controls labeled, not production recovery or exhaustive schedules.";
  attribute progress:String="One complete local globals root-entry leaf, with real sources/writers and snapshot obligations. All named strong entry families now have tasks, but total root/caller coverage, cross-VM exclusion, FFI/native activation, whole-round seal, independent workers and twelve whole-runtime families are not established by counting these components. No inherited repair numerator/12.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="GLOBALS-ROOT-TASK-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/globals-root-task/receipt.json"; attribute :>> scope="Exact producer/required consumers; seven replay/shrink families; empty/malformed partitions, metadata refusals and real p1/p2 shard roots/global setter; original failures retained; no whole-SMP credit"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="GLOBALS-ROOT-TASK-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/globals-root-task.org"; attribute :>> scope="Retire hidden partition authority and name actual allocator bound; preserve Gambit shared/multi-shot control semantics; quantify descriptor/control/test overhead without speedup claim"; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="GLOBALS-ROOT-TASK-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/globals-root-task.org"; attribute :>> scope="Globals leaf after SYMKEY, fixed cache/profile/source/limits; complete global writer/census/worker/capacity obligations remain separate"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="GLOBALS-ROOT-TASK-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/globals-root-task.org"; attribute :>> scope="Actual descriptor/epoch/shard/writer premises map to existing temporal and distinct cell-address laws; range tests are finite C evidence; no second QNT/Lean machine"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="GLOBALS-ROOT-TASK-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/globals-root-task.org"; attribute :>> scope="Why count equality is not a writer freeze; why empty shards matter; why root cells differ from referents; why local DONE/ten tasks cannot certify complete census, global reclaim or W!=R"; }
}
