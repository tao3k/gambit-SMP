package GambitGeneratedProductsDelivery {
  private import ScalarValues::*;
  ref part selected = GambitRevisionDelivery::generatedProducts;
  attribute scope:String="Exactly thirteen default-configuration generated C products corresponding to committed Scheme sources. Original core/check commands and golden outputs are unchanged; SMP-private products and pending handwritten runtime changes are excluded.";
  attribute stage:String="Distribution coherence after checked increment and frame/layout foundation REVs; before CI prerequisite fixes and pending runtime ownership. Preserve all pending index and working bytes. Restore the same SMP workspace from verified artifacts after default qualification.";
  attribute formalDuty:String="Exact producer/input/output identity and unchanged consumer qualification. Native strict SysML selects five ASCENT gates and rejection controls. No concurrent protocol or representation theorem changes: do not duplicate QNT/Lean or treat projection as native platform qualification.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part source:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="GP-SOURCE"; attribute :>> method="source-refinement"; attribute :>> artifact=".cache/research/legacy-evidence/evidence/refactoring/modern-c/generated-products/source.json"; attribute :>> scope="exact thirteen-path producer output; complete canonical inputs; default feature configuration; qualified compiler and consumer artifacts; preserve pending raw working products"; }
  part controls:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="GP-NATIVE"; attribute :>> method="native"; attribute :>> artifact=".cache/research/legacy-evidence/evidence/refactoring/modern-c/generated-products/tests.json"; attribute :>> scope="source bootstrap; clean objects; intentional dummy seed; unchanged core and full check; construction-root and traversal fixtures; no golden change"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="GP-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/generated-products-delivery.org"; attribute :>> scope="generator changes require distribution C publication through existing mechanism; core remains a consumer; separate default and SMP generation identities"; }
  part processNeed:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="GP-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/models/sysml/revision-delivery.sysml"; attribute :>> scope="generated products precede small CI prerequisite cut; pending runtime/harness changes stay separate"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="GP-MODELS"; attribute :>> method="native-model-projection"; attribute :>> artifact=".cache/research/legacy-evidence/evidence/refactoring/modern-c/generated-products/model.json"; attribute :>> scope="strict native SysML and shared ASCENT admission with five negative controls; no duplicate QNT/Lean"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="GP-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/generated-products-delivery.org"; attribute :>> scope="default feature identity, unchanged core, exact generation, pending namespace/ABI isolation and remote platform boundary"; }
}
