  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="LF-NATIVE"; attribute :>> method="native"; attribute :>> artifact=".cache/tasks/modern-c-frame-contract/runs/layout-fixture-local/result.json"; attribute :>> scope="Same workspace/profile/artifact identities; actual GCC/Clang original/fixed normal/lowlevel consumers;20 active wrong-coordinate compile rejections; unchanged existing frame/continuation/root and runtime-role targets. Remote MSVC is not claimed by local qualification"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="LF-AUDIT"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/layout-fixture-portability.org"; attribute :>> scope="Explain concrete C constant-expression portability mechanism, independent oracle, proof identity, benefit, zero runtime impact, necessity of the single file and original remote failure witness"; }
  part processNeed:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="LF-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/layout-fixture-portability.org"; attribute :>> scope="Fixture-only follow-up before root dispatch; precise producer reuse rather than source rebuild. Post-push exact-head CI is required before lifting the successor's predecessor gate"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="LF-MODELS"; attribute :>> method="native-model-projection"; attribute :>> artifact=".cache/tasks/modern-c-frame-contract/runs/layout-fixture-submission/evidence/model.json"; attribute :>> scope="Strict native SysML selects six needs/five gates; actual ASCENT must reject missing needs, stale tree/profile/artifact and model-only evidence. Do not duplicate QNT/Lean for this expression spelling change"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="LF-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/layout-fixture-portability.org"; attribute :>> scope="No deleted assertions, weakened expected values, new platform guards, workflow/name/limit changes, false local-MSVC equivalence, source-copy rebuild or inherited SMP success. Root dispatch stays unadmitted until actual new-head CI succeeds"; }
