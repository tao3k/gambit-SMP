package GambitLayoutFixturePortability {
  private import ScalarValues::*;
  attribute scope:String="One vendor path: tests/frame-spec.scm. Emit array-member offsetof plus literal index times sizeof actual element instead of compound array-element offsetof. Retain all290 declaration IDs, expected coordinates, target/feature guards and existing test entrypoints. No production source, public name, workflow, heap or timeout changes";
  attribute stage:String="Pre-publication local qualification of the bounded fixture follow-up to bf08f39f. Actual MSVC and five-platform CI are post-push requirements; root-dispatch code remains blocked until that exact new head is all-green";
