package GambitRootDispatch {
  private import ScalarValues::*;
  ref part predecessor=GambitRevisionDelivery::runtimeBinding;
  ref part selected=GambitRevisionDelivery::rootDispatch;
  attribute base:String="vendor/gambit b77ad85cd338adad6ea571395975bdb2166dd147";
  attribute candidateTree:String="8b596e1b90af807d07cb452a3cb40d8f1e495131";
  attribute generationInputTree:String="f5515cdb564264860b0bad04f33c3ed2b6ffe3b1";
  attribute productBinding:String="Review-only tree8b596e1b selects23 handwritten/test inputs plus15 exact consumed generated C products. Froma4e8019b only old-roster root handoff in setup/root-tasks, existing RC fixture/Make include and two reused test-only Darwin adapter/calibration sources change. Native core22.816s retains generated C; full bootstrap237.365s/core57.896s recorded independently. Real index/16 unrelated prototypes preserved; generated products are explicit dependencies. No admission/commit";
  attribute status:String="C-REFINEMENT-IN-PROGRESS; f5515cdb two-pass bootstrap237.365s/core57.896s PASS. Final runtime-role4.164s includes actual marker-allocation GC, borrowed-root reload, callback escape/next entry, nonzero RC and stop/reuse; frame4.466s retains290 assertions and multi-shot/root tests; exit0.629s PASS. Calibrated final pthread_join error case exit0.086s after retained-root GC, reuse refusal, fresh successful recovery join/reuse; uninjected control0.439s PASS. GSI408/408 PASS69.568s; original group stops at known test8 capacity defect24.853s, later official9/10/12/entry/inline PASS8.798s separately. Historical a4 GSI407/408 failure not retried or called fixed. General native writer/second-VM/collector-stop and C premises remain open; no REV";
  attribute stage:String="ROOT-SOURCE after execution-storage/layout predecessors; exact selected source tree excludes pending unrelated prototypes. Root adapters and lifetime are implemented candidates, not whole-GC independent-worker acceptance";
  attribute formalDuty:String="Reuse root_dispatch bounded ownership/freeze/unknown schedules and RuntimeRoles universal root-cell/current-address laws. C must establish physical parking, same-VM native admission, roster/task completeness and adapter source mapping. Do not duplicate either model or replace native execution with a theorem";
  attribute predecessorGate:String="CLOSED for b77ad85c: exact-head run40456227030 succeeds on all five platform jobs and ReportResult; actual MSVC Test compiles/executes frame-contract and continuation/root consumers with all290 fixture declarations retained. MinGW32 keeps its official Test skip. Original bf08f39f run40453535604 failure remains historical evidence. Begin ROOT-SOURCE refinement from the published base, not the dirty prototype; no root-dispatch runtime acceptance transfers from this green CI";
  attribute scope:String="Replace the complete strong-root census, frozen-origin publication, explicit scan-source adapters, generation-checked task claim, completion and source-borrow release. Roots are selected from RootOrigin, never inferred from the collector carrier index";
  attribute publicBoundary:String="Keep public Gambit names, GVM/frame descriptor semantics, multi-shot continuation, configure/Make/CI entries and the committed flat gambit.h.in. Private role types/signatures may change when required. The pending header-module split, generic CFFI redesign and new test framework are excluded";
  attribute identity:String="VM identity plus closed GC epoch, origin kind/slot and partition. Stable bounded records; no unbounded identity table. Reuse needs all task/reader borrows drained and prior claims excluded. Reject epoch exhaustion; a separately read generation followed by state-only CAS is not ABA protection";
  attribute publication:String="Managed root writers stop and root-address view freezes before release-publishing the immutable census. Claim acquires that publication under a generation/lifetime pin. Completion release-publishes rewritten roots; an acquire observer releases source borrows only after existing whole-round strong/weak/copy/cleanup barriers allow it. Actual barrier/lock refinement is mandatory";
  attribute sourceOwnership:String="Context owns Scheme register/stack storage. RC cells belong to independently lived domains routed by bounded VM source slots; a stopped carrier leaves a PASSIVE domain scanned by the surviving leader. Native byte references may outlive VM retirement only after Scheme payload/root readers drain. No duplicate rc_head owner remains. Raw header/payload aliases outside managed admission remain unqualified";
  attribute executionBoundary:String="Worker allocation/restore/cleanup policy remains the committed policy. Task eligibility records its required allocation and thread-affinity capabilities. Where only same-carrier capacity is qualified, assignment remains explicitly constrained; arbitrary stealing, independent worker counts and whole-collector W<R require the later worker arena/restoration cut";
  attribute states:String="Collecting -> FrozenPublished -> Ready -> Claimed -> Scanning -> Done -> RoundDrained -> Reusable. Ready claim has one winner. Known rejection before scanner entry retains source custody. A lost completion result is queried by the same key; it is not permission to scan again";
  attribute unknownRule:String="Unknown execution/stop/join keeps the task, source roots and descriptor pinned. A worker may return an unstarted task only with a stop/entry-exclusion proof. After possible scanner entry, do not requeue destructive stack/frame work without a separate progress/recovery proof. Root-task completion alone never permits VM/PSTATE/global cleanup";
  attribute benefit:String="One source-explicit root census covers every admitted context and actual RC head; VM/global work is explicit instead of processor-zero authority. RootTask owns unique root-job permission independently of collector identity, enabling later worker-policy changes without rewriting root meaning. No reduced object scan/copy count or speedup is established by this design";
  attribute addedCost:String="For R active contexts and C retained domains, K=3R+C+2<=4*MAX_PROCESSORS+2. RootOrigin is embedded in RootTask, never charged twice. One VM block reserves sizeof(RootRound)+Kmax*sizeof(RootTask), plus one RC domain per initialized source slot and enlarged RC headers. An embedded activation avoids its first extra allocation; deeper native entries allocate. Publication scans fixed slots; each task adds claim/enter/finish locks. Actual sizeof/peak results and failure refusals are required; no speedup or extra heap/wait authorized";
  attribute retirement:String="Retire carrier-index-derived root selection and root-range partitioning, leader-only implicit RC coverage, and root scanner reads of the executor's context as its source. Preserve the current copy/weak algorithm and worker allocation owner; task uniqueness does not establish unique object/frame copy";
  attribute stopRule:String="No code REV until all seven needs and five gates close for one exact source tree. Source model links, existing tests or the current storage REV cannot discharge missing claim protocol, source coverage, writer freeze or native evidence";
  attribute observedSource:String="b77ad85c: setup_rc/register_rc store a per-PSTATE rc_head; release_rc unlinks/frees without PS; set_data_rc stores data; mark_rc rewrites data; collection-round strong phase calls mark_rc only on processor0. cleanup_mem_pstate frees still objects and the complete RC chain; shrink performs cleanup before thread_exit and ignores join errors";
  attribute counterexample:String="tests/rc-root-origin.scm compiled against exact b77ad85c SMP/C23 artifacts in the existing workspace: (RC-ROOT-ORIGIN 0 0 3), (RC-ROOT-ORIGIN 1 1 2). Bit2=moved ordinary Scheme root; bit1=RC word updated. Both real origins registered; origin1 data stayed stale. No stale payload dereference, fake PSTATE, added heap or increased wait. Counterexample is baseline evidence, not a passing successor test";
  attribute freezePremises:String="All managed contexts physically park at the existing collective before the leader freezes OPEN/PASSIVE RC domains. Borrowed RC cells may remain pinned on parked callers; scanners rewrite the cell and callers reload after the final collective. Only a current, natively bound OPEN context may read/write same-VM Scheme payloads; unmanaged raw aliases are excluded. Header release during scanning defers detach instead of waiting for the round. Current-VM parking does not stop another VM's GSTATE writers; snapshot count/permanent table values under the shared metadata lock";
  attribute exitCustody:String="Close departing managed writer admission while old members are parked. Transfer only address-stable still lists without foreign release functions to the surviving allocator, including deferred/occupied accounting; unknown-affinity foreign cleanup refuses shrink. Old-roster owner closes markers and hands RC domain to PASSIVE before membership publication; native OS cleanup follows acknowledgment, outside root ownership. Domains are not freed; all retained domains enter the next census. Reserve source slots before member removal; only observed join success permits reuse. Failed/unknown join keeps its slot and VM reclamation blocked, but does not enlarge the surviving GC roster or block another VM";
  attribute callerSurvival:String="Observed counterexample: unpinned Scheme caller resumed on processor1 and requested target1, then its own carrier exited before returning. The source-admission candidate checks the actual native caller before on_all_processors and refuses an invalid target or removal of that caller without changing membership. The real processor1 refusal control retains count2 and returns on processor1; positive retirement pins the control thread to surviving processor0. This is necessary admission, not a transfer protocol for arbitrary pending or merged resize callers; their closed-root/return-debt proof remains a successor dependency";
  attribute observedCost:String="Configured Darwin GCC16/C23 consumer: sizeof RootOrigin88, RootTask112, RcDomain288, RootRound1400; Kmax258 for MAX_PROCESSORS64, VM root block30296 bytes. Each initialized source adds288 native bytes; aligned RC header grows from32 to64 bytes; deeper activation record80 bytes. Three task-transition mutex acquisitions per K plus publication/freeze/thaw. Call-unwind guard adds one domain-locked checkpoint per call and depth-linear exceptional cleanup, no normal heap allocation. Managed handoff adds one shrink collective,2(R-1) logical sends plus per-source debt/domain checks, no new field/task. No reduced copy count, speedup or process-peak claim; failed/unknown custody may retain payloads beyond metadata bounds";
  attribute payloadAlignment:String="Native negative on rejected inpute0187123: header56, prior32, fundamental alignment16, actual payload remainder8. Word-sized role/embedded fields replace unsigned-int tags, preserving the former pointer/word stride relationship without a padding constant. Final allocator control observes header64/prior32/remainder0 and checks the relative header stride on every build. This is a C layout/allocator refinement duty, not another QNT/Lean theorem; metadata costs are updated accordingly";
  attribute consumerLayout:String="Private C consumers crossing the compiled root API must use the actual configured runtime layout. Native negative: default raw header consumer reads root_round at0x130b8 while library writes0x12eb8, delta512=64*8; generated config selects SINGLE_HOST and changes c_stack_trip storage. Same fixture with HAVE_CONFIG_H passes. Correct the existing test target's compile input, preserve official names and all controls; do not infer a runtime root failure from mismatched layouts";
  attribute originalCheckStatus:String="Currentf5515cdb original GSI408/408 PASS69.568s, composed remaining group executes1-7 then fails test8 exit70 in24.853s. Independent test9/10/12/entry/inline targets PASS8.798s, not a full compiled-unit suite. Historicala4 GSI407/408 failure retained without retry. b77 interpreter baseline uses that failed run's recorded runtime environment, except four mandatory current task-custody keys; no framework stale-context bypass. Current PASS is not a scheduler repair claim. Known test8 capacity repair stays successor work; original composed check still FAIL";
  attribute originalFailureCut:String="Matched official test8 on preserved b77ad85c and finalf5515cdb artifacts, same leased cwd/environment/profile/input: both make exit2/client exit70 before eval_string, Heap overflow in setup_mem_pstate during setup/resize. Both actual configured layout reads show total/assigned sections6/6, published/target members1/12, max_heap0. The unchanged resize_heap decision prefix computes member floor24 but clamps it only inside max_heap>0; after GC resize proceeds and new carrier's null stack/heap cannot share an exhausted section. This observed failure predates ROOT-SOURCE; no all-path equivalence claim. Keep FAIL and defer physical member-floor/post-GC admission to capacity successor. Debugger exit0 is transport only";
  attribute callUnwindGuard:String="Existing rc-root-origin.scm zero-refcount borrowed-cell moving-GC and generated callback escape reveals input2068bf79 exit70 after intermediate PASS markers: the skipped SFUN epilogue leaves an abandoned activation. Inputa4e8019b makes call validate its LIVE marker before frame mutation, save parent identity and unwind departed activation/descendants before exceptional propagation; normal SFUN epilogue retains result-conversion ownership. Full bootstrap and final three existing targets now pass, including complete fixture exit0; failed counterexample retained. Added one domain-locked checkpoint per call and depth-linear exceptional cleanup; no normal heap allocation or table. Raw unregistered markers refused; unknown close retains custody. The specific construction-GC observation now passes; arbitrary failure effects and whole source/exit admission remain open";
  attribute managedHandoff:String="f5515cdb reserves source slots/transfers still accounting, then shrink-only old-roster collective orders transfer before owner activation close and memory/root cleanup to PASSIVE. Existing membership-publication collective acknowledges handoff before count changes; native interrupt/OS cleanup follows acknowledgment without control locks. Join grants only reuse/reclamation, never scan readiness. Queued procedural cleanup refuses preflight; raw unmanaged concurrent enqueue excluded. Managed-stop invariant violations fail closed, not arbitrary native-death recovery. Olda4 injected case exits70 at next GC; final full f551 calibrated pthread_join error case exits0 after retained-root GC/reuse refusal/fresh actual recovery join. Added one shrink collective:2(R-1) logical sends, not a latency bound; one debt mutex/source plus short domain check, no new metadata/normal-GC task. No independent-VM or unknown partly executed collector proof";
  attribute markerAllocationControl:String="Existing fixture uses valid still allocations with one member, measures empty-vector overhead, leaves one approximate free word and fills MAX_STILL_DEFERRED without counter mutation. Requires no prior GC, then real marker allocation raises collection count, returns relocated closure and preserves captured value. Final full f551 ordinary/injected controls consume exact SDK headers and exit0. Undeclared-macro compile/relative-header diagnostics remain historical. No heap option, production hook or copied STILL_BODY. Specific constructor-root observation closes; arbitrary failure/exit effects remain open";
  attribute originalGsiBaseline:String="Preserved b77ad85c GSI408/408 PASS67.670s under the retained a4 failed suite recorded runtime environment except four mandatory current task-custody keys; same argv/cwd/inventory, no a4 retry. Stale-custody launch was denied/restored, never bypassed. Earlier profile-only baseline74.597s differs in LANG/shell and is not the strict control. Final f551 GSI408/408 PASS69.568s is a different source revision. Test lacks active-target handshake before line41; interrupt checks termination under lock. Source sensitivity is not historical schedule proof or scheduler repair; earlier failure causality unresolved";
  attribute adapterBoundary:String="scan(worker, origin, task): origin supplies context bank, fp/stack_break, stable RC domain or explicit global range; worker supplies allocation/chunks/diagnostics and phase-local resources. Active domains remain source-affine; PASSIVE domains explicitly choose leader allocation eligibility. Each worker visits its published task interval, total O(K), not an R*K table search. Keep mark_array, FrameSpec forwarding and multi-shot sharing; unknown entered scans are never requeued";
  attribute sourceQuestions:String="SRC-WRITERS: native payload/header aliases and nested cleanup freeze; SRC-LIFETIME: source-borrow drain before cleanup_rc/free_still_objs; SRC-GLOBAL: GSTATE writers versus per-VM closure; SRC-ENTRY: marker preallocation root and callback borrow; SRC-ABI: register_rc void versus void-pointer declarations and refcount int versus WORD. No blanket CFFI ABI repair is included without a separately audited caller closure";
  attribute modelPartition:String="runtime_roles QNT keeps collective result delivery; root_dispatch in that same file checks only bounded task claims, writer/freeze arbitration, lost ACK, unknown execution and stale epochs. RuntimeRoles Lean proves arbitrary-cell coverage from census/adapter premises, not schedules. Source refinement must establish those premises; native tests determine actual caller reachability and C behavior. Neither model manufactures C correctness";

  part def Route { attribute id:String; attribute path:String; attribute symbol:String; attribute duty:String; }
  part contexts:Route { attribute :>> id="context-roots"; attribute :>> path="include/gambit.h.in;lib/setup.c;lib/_num.scm;lib/_io.scm;lib/_mem/capacity-resize.inc;lib/_mem/root-origins.inc"; attribute :>> symbol="___W_Rn;___GC_SAVE1/2/3;##bignum.make;macro-char-input/output-port-cache-fill;mark_registers;mark_saved;mark_type_cache;mark_processor_scmobj"; attribute :>> duty="Include raw Scheme c-code saved writes in bignum.make, cache-fill writers and lowlevel register materialization; read the frozen origin's bank, not the executor's, while preserving save/reload/clear semantics"; }
  part stacks:Route { attribute :>> id="continuation-roots"; attribute :>> path="lib/_mem/continuation-roots.inc"; attribute :>> symbol="mark_continuation;mark_frame;mark_captured_continuation"; attribute :>> duty="Origin supplies fp/stack_break and frame address view; retain existing frame-root cursor, multi-shot shared reachability and forwarding protocol"; }
  part globals:Route { attribute :>> id="vm-global-roots"; attribute :>> path="lib/_mem/root-origins.inc;lib/_mem/collection-round.inc"; attribute :>> symbol="mark_vm_scmobj;mark_global_variables;mark_symkey_tables;garbage_collect_mark_strong_phase"; attribute :>> duty="Explicit VM/global root tasks and partition descriptors; preserve global/VM ownership and include empty/single-origin cases"; }
  part rc:Route { attribute :>> id="rc-roots"; attribute :>> path="lib/_mem/configuration.inc;lib/_mem/rc-allocation.inc;lib/_mem/rc-roots.inc;lib/_mem/collection-round.inc;lib/c_intf.c;lib/os_dyn.c;lib/os_io.c;lib/os_files.c;examples/tcltk/tcltk.scm;examples/Xlib-simple/Xlib.scm;tests/rc-root-origin.scm"; attribute :>> symbol="rc_head;___alloc_rc;___register_rc;___set_data_rc;___release_rc;___release_rc_tls_context;___release_event;mark_rc;cleanup_rc"; attribute :>> duty="Nonzero API caller and stale moving payload reproduced on exact SMP baseline. Include TLS/Win32 directory/event RC owners and feature-conditional GC release callbacks; distinguish byte storage, dynamic closures and actual SMP example arity. Replace leader-only coverage only after writer, borrow and cleanup reentry contracts hold"; }
  part lifecycle:Route { attribute :>> id="root-task-lifetime"; attribute :>> path="include/gambit.h.in;lib/root.h;lib/_mem/root-tasks.inc;lib/_mem/collection-round.inc;lib/_mem/memory-lifecycle.inc;lib/_mem/capacity-resize.inc;lib/setup.c;lib/c_intf.c"; attribute :>> symbol="publish_root_sources;scan_root_tasks;finish_root_round;root_task_claim/enter/finish/completed;root_prepare_pstate_stop;root_transfer_still;root_activation_begin/publish/unwind;current_vm_resize"; attribute :>> duty="Closed source roster and source-explicit task intervals; rooted construction/catcher exit, surviving caller admission, passive RC census and before-removal slot quarantine. Preserve native resource affinity/refuse unknown transfer; no whole-round seal from task count or arbitrary caller migration credit"; }

  // Project these through the existing commitOwnershipRouteFact DSL. A native
  // counterexample or checked mathematical law does not close a C adapter.
  part def SourceConcern { attribute id:String; attribute model:String; attribute evidence:String; attribute premise:String; attribute obligation:String; }
  part sourceAdapter:SourceConcern { attribute :>> id="SRC-ADAPTER"; attribute :>> model="dev/refactoring/modern-c/models/lean/RuntimeRoles.lean"; attribute :>> evidence="vendor/gambit/lib/_mem/continuation-roots.inc"; attribute :>> premise="CompleteCensus, TaskCoverage, AdapterFaithful and currentAddressCovered must refine actual context/stack/RC/global cells; indirect helper source reads cannot use worker context. OPEN"; attribute :>> obligation="ROOT-SOURCE"; }
  part rcProducer:SourceConcern { attribute :>> id="SRC-RC-PRODUCER"; attribute :>> model="dev/refactoring/modern-c/models/sysml/root-dispatch.sysml"; attribute :>> evidence="vendor/gambit/tests/rc-root-origin.scm"; attribute :>> premise="Exact-base origin1 stale counterexample retained. Final candidate has real origins0/1 updated, then one surviving collector scans both RC domains after source1 stops, and confirmed reuse passes. This closes those actual API cases, not all platform closures, external aliases or complete writer admission. Aggregate source obligation OPEN"; attribute :>> obligation="ROOT-SOURCE"; }
  part writerStop:SourceConcern { attribute :>> id="SRC-WRITERS"; attribute :>> model="dev/refactoring/modern-c/models/quint/runtime_roles.qnt"; attribute :>> evidence="vendor/gambit/lib/_mem/rc-allocation.inc"; attribute :>> premise="Physical writer/reader stop and alias admission; GC destructor reentry cannot wait for the same round. Raw header/data aliases and post-scan root addition require exclusion or explicit rescan. OPEN C refinement"; attribute :>> obligation="ROOT-SOURCE"; }
  part sourceLife:SourceConcern { attribute :>> id="SRC-LIFETIME"; attribute :>> model="dev/refactoring/modern-c/models/quint/runtime_roles.qnt"; attribute :>> evidence="vendor/gambit/lib/_mem/memory-lifecycle.inc"; attribute :>> premise="Borrow/drain before cleanup_rc, free_still_objs, PSTATE cleanup and VM lock destruction; a failed join never releases source roots. OPEN"; attribute :>> obligation="ROOT-SOURCE"; }
  part globalView:SourceConcern { attribute :>> id="SRC-GLOBAL"; attribute :>> model="dev/refactoring/modern-c/models/lean/RuntimeRoles.lean"; attribute :>> evidence="vendor/gambit/lib/_mem/global-bindings.inc"; attribute :>> premise="Freeze glo count/range and valid backing capacity; distinguish permanent symbol metadata from movable VM values. Current VM barrier does not establish GSTATE writer exclusion across VMs. OPEN"; attribute :>> obligation="ROOT-SOURCE"; }
  part entryView:SourceConcern { attribute :>> id="SRC-ENTRY"; attribute :>> model="dev/refactoring/modern-c/models/sysml/root-dispatch.sysml"; attribute :>> evidence="vendor/gambit/lib/setup.c"; attribute :>> premise="c_intf roots proc before marker allocation; real pressure-induced constructor GC now relocates/reloads closure on full f551 artifacts. call owns exceptional activation retirement, normal SFUN epilogue owns conversion/close, run keeps fallback guard. Borrow/GC, callback escape/next entry and calibrated retired-carrier join-error/GC have native receipts. Arbitrary effects/unknown executing collector and complete C premise refinement remain OPEN; generic CFFI separate"; attribute :>> obligation="ROOT-SOURCE"; }
  part claimRoute:SourceConcern { attribute :>> id="TASK-CLAIMS"; attribute :>> model="dev/refactoring/modern-c/models/quint/runtime_roles.qnt"; attribute :>> evidence="dev/refactoring/modern-c/root-dispatch.org"; attribute :>> premise="root_dispatch finite schedules only: one task entry, lost ACK query, no replay after possible entry, writer/freeze arbitration and non-wrapping reuse. Physical stop, real memory order and round-seal issuer are source premises. OPEN full C/protocol admission"; attribute :>> obligation="ROOT-PROTOCOL"; }
  part cellRoute:SourceConcern { attribute :>> id="CELL-COVERAGE"; attribute :>> model="dev/refactoring/modern-c/models/lean/RuntimeRoles.lean"; attribute :>> evidence="vendor/gambit/lib/_mem/root-origins.inc"; attribute :>> premise="Universal root-cell and current-address coverage under explicit census/adapter premises; no interleaving or object-copy theorem. Theorems checked; actual C premise proofs OPEN"; attribute :>> obligation="ROOT-COVERAGE"; }

  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part source:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="ROOT-SOURCE"; attribute :>> method="source-refinement"; attribute :>> artifact="vendor/gambit/lib/_mem/collection-round.inc"; attribute :>> scope="Actual reader/writer/registration/cleanup census and explicit origin vs executor arguments, including nonzero RC producers; generation/pin, memory-order and failure custody refinement. OPEN"; }
  part protocol:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="ROOT-PROTOCOL"; attribute :>> method="bounded-protocol"; attribute :>> artifact="dev/refactoring/modern-c/models/quint/runtime_roles.qnt"; attribute :>> scope="root_dispatch now has task readiness/owner/entry, duplicate/lost completion, stale epoch, writer/freeze and stopped-vs-unknown schedules. Ten deterministic controls and 10000 sampled 64-step traces checked; simulation is not exhaustive verification or C stop/atomic refinement. OPEN for complete protocol admission"; }
  part coverage:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="ROOT-COVERAGE"; attribute :>> method="universal-coverage"; attribute :>> artifact="dev/refactoring/modern-c/models/lean/RuntimeRoles.lean"; attribute :>> scope="completeRootVisit, distinctOriginsNoDuplicateCell and currentAddressCovered checked for arbitrary Cell/Origin/Task types under explicit census, task, adapter and partition premises. Actual C/FrameSpec premise proofs remain OPEN. No duplicate QNT interleaving theorem"; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="ROOT-NATIVE"; attribute :>> method="native"; attribute :>> artifact="vendor/gambit/tests/runtime-roles.c"; attribute :>> scope="Reuse existing test targets and same Bazel/cache: exact full bootstrap <=600s, original check/disposition, nonzero-origin and RC moving-root updates, real map multi-shot/GC, stale/duplicate claim and unknown-stop refusal. W<R dispatcher-only observations are not whole-GC acceptance. OPEN"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="ROOT-AUDIT"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/root-dispatch.org"; attribute :>> scope="Per-path necessary retirement and measured root coverage, duplicate-job prevention and actual metadata/atomic/peak costs; no invented speedup or inherited SMP credit. OPEN for implementation"; }
  part processNeed:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="ROOT-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/models/sysml/root-dispatch.sysml"; attribute :>> scope="Complete root-dispatch responsibility after published b77ad85c; worker arena/restoration, entry lifetime and VM cleanup remain dependency-bound cuts. OPEN for implementation"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="ROOT-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/root-dispatch.org"; attribute :>> scope="Actual producer closure, frozen global ownership, root aliases vs object forwarding, affinity/capacity, bounded reuse, unknown worker effects and Gambit multi-shot amplification answered before code commit. OPEN"; }
}
