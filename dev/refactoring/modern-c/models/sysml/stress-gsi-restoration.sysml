package GambitStressGsiRestoration {
 private import ScalarValues::*;
 ref part family=GambitModernCDeliveryPlan::a6;
 attribute authority:String="DEV ContinuationRestoreAdmission and DedicatedCopyCapacity own physical restoration admission; SharedHeapSmp owns the joint resume cut. Repair9/TFIB history supplies references and falsifiers only, not this new architecture's authority or native proof.";
 attribute progress:String="Preserve accepted5/12. One concrete restoration-source defect is corrected; whole pressure-interpreted family6 and its five commit gates remain OPEN.";
 attribute source:String="vendor/gambit/lib/_mem/capacity-resize.inc::move_continuation";
 attribute consumer:String="vendor/gambit/lib/_mem/collection-round.inc::accepted arena/resume handoff -> move_continuation -> restored -> barrier -> prepare_mem_pstate";
 attribute coordinateOwner:String="vendor/gambit/include/_gambit/gvm_operations.h.in::___INVALIDATE_STACK_OVERFLOW_UNDO";
 attribute regression:String="vendor/gambit/tests/collector-diagnostics.c::restoration_overflow_ownership invokes actual mem.c; existing stack-overflow-undo.c covers five generated continuation operations";
 attribute geometry:String="Let A=active source words, F=first-break space, M=overflow-link offset and D=destination high. L=A+F, destinationTop=D-L, destinationFirstBreak=D-F. The canonical metadata cell is D-F+M; the retired expression D-L+M differs by A. For A>0 it can zero a live frame slot and retain the old physical section link. Bounds require 0<=M<F and one pinned disjoint destination span; address arithmetic alone does not prove ownership.";
 attribute exampleActive:Integer=8;
 attribute exampleFirstBreak:Integer=4;
 attribute exampleMarker:Integer=2;
 attribute exampleHigh:Integer=96;
 attribute exampleSpan:Integer=exampleActive+exampleFirstBreak;
 attribute exampleTop:Integer=exampleHigh-exampleSpan;
 attribute exampleBreak:Integer=exampleHigh-exampleFirstBreak;
 attribute exampleLegacyCell:Integer=exampleTop+exampleMarker;
 attribute exampleCanonicalCell:Integer=exampleBreak+exampleMarker;
 attribute exampleBoundary:String="Configured64-bit source-control example, not a portable constant requirement. Actual C control uses the included header macros and actual function for active0/8/16; other ABI profiles require their own build/consumer evidence.";
 attribute retirement:String="Retire the manual active-top metadata projection in GC restoration. Capture/save/restore/graft/return and GC restoration share the existing canonical first-break projection; no new runtime namespace, identity table, lock, heap policy or configuration layer.";
 attribute proofRouting:String="DEV models/quint/continuation_restore_plan.qnt owns plan/admit/refuse/unknown histories; DEV models/quint/dedicated_copy_capacity.qnt owns physical capacity and partial reservation histories. Existing ContinuationRestore/RestoreAdmissionComposition/DedicatedCopy Lean scopes own conditional ranges and induction. This cut supplies a concrete C coordinate/writer adapter with actual-function counterexamples, not another scheduling proof. No new QNT/Lean model or rerun. No copied Repair9 state machine.";
 attribute observationPolicy:String="Source, ordinary compilation and execution only. The user prohibits debugger, disassembly, process-memory or binary inspection; do not delegate them. Grok source-only attempt timed out without a report and is not independent audit completion.";
 part def Obligation { attribute id:String; attribute owner:String; attribute condition:String; attribute evidence:String; attribute remaining:String; }
 part plan:Obligation {
  attribute :>> id="RESTORE-PHYSICAL-GRANT";
  attribute :>> owner="VM round and actual resume/WorkerArena owner";
  attribute :>> condition="Accepted same-epoch source span and actual destination interval remain held through weak scan, restoration and publication; unknown grants or writers retain custody. The corrected metadata coordinate cannot supply these premises.";
  attribute :>> evidence="Existing DEV admission/capacity/joint-cut design and actual C caller order; no change to census, section count, locks, barriers or rejection conditions.";
  attribute :>> remaining="Complete section free-list/allocator lifetime and original TFIB causal attribution remain open; no all-SMP ownership closure inferred.";
 }
 part coordinates:Obligation {
  attribute :>> id="RESTORE-CANONICAL-FIRST-BREAK";
  attribute :>> owner="Frame representation shared by generated control and GC restoration";
  attribute :>> condition="Copy exactly L source words, preserve active frame words, revoke only the destination first break's old overflow-section eligibility before reporting restored. Do not use the post-copy active cursor as first-break base.";
  attribute :>> evidence="Unchanged actual function fails the independent oracle at active8/16 with four wrong words; empty control succeeds. Candidate reuses ___INVALIDATE_STACK_OVERFLOW_UNDO and the same control reports zero wrong words.";
  attribute :>> remaining="Native whole-runtime producer and unchanged pressure interpretations still required. This is a proved coordinate defect, not proof of the first producer of a prior TFIB crash.";
 }
 part consumers:Obligation {
  attribute :>> id="RESTORE-REAL-CONSUMERS";
  attribute :>> owner="Existing diagnostic and frame/continuation test owners";
  attribute :>> condition="Exercise the actual mem.c restoration body with an independently enumerated expected destination, not a duplicate helper implementation. Keep diagnostic wrong-worker and fatal controls and all existing generated-control assertions.";
  attribute :>> evidence="Extend existing collector-diagnostics.c, use its existing isolated DEBUG compile/link path, and retain baseline/candidate source-control results and failed Make-plan observation separately.";
  attribute :>> remaining="Existing fixture completion is distinct from full bootstrap, root scanning, multi-shot Scheme execution and stress-GSI acceptance.";
 }
 part benefit:Obligation {
  attribute :>> id="RESTORE-BENEFIT-AND-COMMIT";
  attribute :>> owner="Existing Evidence/ASCENT whole-family and five-gate admission";
  attribute :>> condition="A concrete unsafe frame write and stale section-eligibility edge are eliminated. Charge the canonical context/first-break projection; do not claim a pause, throughput, RSS or TFIB-budget improvement without matched native evidence.";
  attribute :>> evidence="Same C23 profile, unchanged coordinate fixture, one stable cache, no managed heap increase, no removed check/lock or longer acceptance timeout; zero new runtime metadata allocation.";
  attribute :>> remaining="Combined source producer, original p2/p1 four-file unspliced campaign and net-benefit/five-gate closure remain OPEN; no6/12 or commit/push yet.";
 }
}
