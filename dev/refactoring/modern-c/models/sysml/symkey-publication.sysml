package GambitSymkeyPublication {
  private import ScalarValues::*;
  ref part prior=GambitGlobalsSnapshot::component;
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="symkey-publication";
    attribute :>> responsibility="One native canonical interning transaction owns lookup, construction, bucket/count changes, optional rehash and publication; GC owns a captured anchor pair without holding the registry gate through copying";
    attribute :>> sources="lib/_mem/symbols.inc;lib/_mem/global-bindings.inc;lib/_mem/root-origins.inc;tests/root-task.scm;tests/makefile.in";
    attribute :>> tests="Existing exact-tree Bazel Darwin/GCC C23 bootstrap/core and original GSI/Make consumers; existing root-task Scheme oracle/replay/shrinker with real native actors; predecessor split-lookup counterexample/current replay, failed rehash and stale GC writeback controls";
    attribute :>> retired="Independent native probe/create and unguarded bucket/NEXT/count/rehash authority; direct runtime insertion bypass; native reverse/TTY walks without registry exclusion; mutable GSTATE anchor address passed directly to physical mark";
    attribute :>> excluded="Raw Scheme table aliases/folds and mutation; optional DEBUG_GARBAGE_COLLECT_globals diagnostic raw walk (disabled in this profile); arbitrary foreach callbacks/reentry; moving-table concurrent interning; arbitrary native owner loss; full root census, workers, generations, Repair9 or whole SMP acceptance";
  }
  part priorEdge:GambitRevisionDelivery::Dependency {
    ref part :>> predecessor=GambitGlobalsSnapshot::component;
    ref part :>> successor=component;
  }
  attribute scope:String="Base7abe6770, ROOT-SYMKEY coverage group within the ROOTS stage. The selected tree and same leased SDK are authorities; unrelated dirty prototypes are not admitted. Native service callers retain names/signatures; Scheme multi-shot continuation, official build/CI names and heap/time limits remain.";
  attribute stage:String="QUALIFYING: one service responsibility, not all symbol/keyword views or the complete ROOTS stage. Two of six coverage groups are scoped closed before this cut; this group and three others remain. A commit can add one scoped closure only after its actual five gates close.";
  attribute writers:String="setup init_symkey_glo2 alone uses direct intern for exclusive static bootstrap. Both native factories and direct new_symkey use one existing global_gate critical section; internal helpers do not recursively acquire it. A direct new request rechecks identity under the same authority. Tables, constructed symbols/keywords and names are permanent; allocation with NULL processor never enters Scheme GC. Source strings remain caller-owned against mutation. Integer checks respect both fixnum and C-index bounds.";
  attribute readers:String="Native find, TTY foreach and reverse-global lookup use the same gate as rehash. The only actual foreach callback is os_tty visit_symbol: permanent-name read and private visit-data updates, no registry/GC/Scheme reentry. This private NoReentry premise is an explicit source obligation; arbitrary callbacks are not admitted. Scheme raw table getters/foldl are ROOT-VIEWS, still open.";
  attribute handoff:String="GC captures before[2] and cells[2] under the registry gate, unlocks before mark_array, then conditionally commits a moved cell only if the current anchor still equals before. Permanent production anchors do not move and are not reclaimed until outer-exclusive runtime cleanup; a newer published permanent table therefore cannot be overwritten. Existing exclusive p1 moving-root fixture may update its still-current anchor. Concurrent raw moving publishers are excluded. RootTask claim/scan/finish and its retained lease are unchanged.";
  attribute failure:String="Preconstruction allocation failure returns the existing fixnum error without bucket/count publication. If rehash allocation fails after node insertion, the canonical node/count remain committed in the old valid table and a later insertion may retry growth. No GC/callback/join while the registry gate is held. Unobserved native owner termination while holding the gate is not recovered by this cut; no blanket progress or robust-mutex claim is made.";
  attribute formalDuty:String="Existing runtime_roles.qnt root_dispatch owns freeze/claim/lease/unknown/completion histories, not symbol name uniqueness. Existing RuntimeRoles Lean owns conditional distinct-cell/census/current-address laws, not mutex schedules. New concrete local-cell capture and conditional writeback require source refinement and actual relocation/interleaving controls; neither existing model automatically proves them. Canonicalization is justified by serialized concrete service operations plus actual implementation PBT and predecessor counterexample. No duplicate QNT/Lean machine or LLM proof oracle.";
  attribute benefit:String="For admitted native factories, one name/subtype has one canonical result and one count increment even when two calls overlap. Rehash and native walkers cannot race on NEXT. GC no longer borrows a concurrently replaceable anchor address and does not hold the gate through copying. Forced predecessor schedules and current replay quantify correctness, not throughput. Scheme continuation/root semantics and C portability remain opportunities for later worker separation.";
  attribute cost:String="Reuse existing registry/permanent gates: zero new mutexes, header fields, persistent metadata or barriers. Four temporary SCM words in the anchor adapter. Hash/string construction and O(table+entries) rehash/TTY walks serialize; waiting/peak RSS/throughput require separate measurement. Rehash peak retains both permanent vectors until global teardown, as before. No heap or deadline increase.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="SYMKEY-PUBLICATION-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/symkey-publication/receipt.json"; attribute :>> scope="Exact producer, required original consumers and real implementation PBT/replay/shrink, growth/failure/GC-publication controls; retain failures"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="SYMKEY-PUBLICATION-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/symkey-publication.org"; attribute :>> scope="Canonical service transaction versus independent checks; permanent-node lifetime versus raw Scheme views; GC marking outside locks and conditional commit"; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="SYMKEY-PUBLICATION-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/symkey-publication.org"; attribute :>> scope="ROOT-SYMKEY after ROOT-GLOBALS; explicit group counts and next dependencies, no inherited repair-line numerator"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="SYMKEY-PUBLICATION-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/symkey-publication.org"; attribute :>> scope="SysML source/retirement/need projection to ASCENT; separate existing QNT/Lean obligations and actual C native premises"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="SYMKEY-PUBLICATION-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/symkey-publication.org"; attribute :>> scope="Why gate transaction retires check-then-create, why no lock over mark, when failed growth is committed, what views remain open, why this is not full SMP or performance closure"; }
}
