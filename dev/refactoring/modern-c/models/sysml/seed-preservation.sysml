package GambitSeedPreservation {
 private import ScalarValues::*;
 attribute scope:String="Completed seed output custody, not a new builder. Only a successful declared seed consuming the same configured-source ancestry may retire its old snapshots after independent completed preservation. Old-descriptor current-byte checks stay strict.";
 attribute stage:String="Support correction of observed CI STALE; no runtime/integration increment. Architecture3/4 and SMP1/12 unchanged; hosted build and macOS pair remain separate.";
 attribute formalDuty:String="Existing models/build/incremental_build.qnt owns scheduling and models/build/IncrementalBuild.lean owns conditional input algebra. Neither proves filesystem/hash/host behavior; this cut supplies source refinement and real filesystem counterexamples without duplicating models.";
 attribute existingOwner:String="dev/refactoring/modern-c/models/sysml/bootstrap-artifact-custody.sysml#retained";
 attribute sourceProducer:String="src/gambit_smp/bootstrap_artifacts.py#freeze";
 attribute sourceConsumer:String="src/gambit_smp/recipes.py#preserved_successor";
 attribute snapshotRule:String="Historical source snapshot RETAINED only with verified old custody, successful seed declared-input ancestry, completed record bound to saved identity, both current full identities equal, disjoint paths and no same-file leaf aliases";
 attribute borrowRule:String="RETAINED does not satisfy old current-byte artifact consumption; missing, failed, unknown, modified or aliased transfer remains refused";
 attribute diagram:String="direction: right\ninput: Declared configured source\nbuild: Same owned workspace after seed build\nsaved: Preserved completed seed\nproof: Input ancestry + receipt + full identities + independent inodes\npast: Earlier snapshot retained\nreuse: Old descriptor reuse rejected\nready: Saved runtime available\nrefuse: Missing or changed proof rejected\ninput -> build: admitted mutation\nbuild -> saved: existing freeze\nbuild -> proof\nsaved -> proof\nproof -> past: verified\npast -> reuse: no current-byte authority\nsaved -> ready: current identity checked\nproof -> refuse: unknown or mismatch\n";
 part def Need { attribute id:String; ref part gate:GambitCommitGates::Gate; attribute method:String; attribute artifact:String; attribute scope:String; }
