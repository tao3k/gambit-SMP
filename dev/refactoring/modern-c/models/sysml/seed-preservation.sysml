 part submission:GambitCommitGates::SubmissionUnit { attribute :>> kind="support"; attribute :>> result=""; attribute :>> progressDelta=0; attribute :>> supportPaths="src/gambit_smp/recipes.py;src/gambit_smp/bootstrap_artifacts.py;tests/test_bootstrap_artifacts.py;dev/refactoring/modern-c/models/sysml/seed-preservation.sysml;dev/refactoring/modern-c/seed-preservation.org;dev/refactoring/modern-c/branch-checklist.org;dev/refactoring/modern-c/diagrams/seed-preservation.d2;dev/refactoring/modern-c/diagrams/seed-preservation.svg;evidence/research/retained/modern-c/ci-handoff/receipt.json;evidence/research/retained/modern-c/ci-handoff/root-cause.json"; attribute :>> testModules="tests/test_bootstrap_artifacts.py"; }
