  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="PF-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/bootstrap-phase-failure.org"; attribute :>> scope="The owner of staged compilation must retain failed outcome instead of allowing a later successful child to overwrite it. Error propagation is build lifecycle ownership, not runtime concurrency repair"; }
  part processNeed:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="PF-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/models/sysml/revision-delivery.sysml"; attribute :>> scope="One buildable responsibility per tree, explicit parent dependencies, no inherited aggregate/native admission"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="PF-MODELS"; attribute :>> method="native-model-projection"; attribute :>> artifact="evidence/refactoring/modern-c/bootstrap-phase-failure/model.json"; attribute :>> scope="Strict native SysML and real shared ASCENT policy, including missing-native, stale-tree, wrong-profile/artifact and model-only rejection"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="PF-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/bootstrap-phase-failure.org"; attribute :>> scope="First failure reaches phases caller; no later phase launched; successful sequence unchanged; original core workflow untouched; no runtime,capacity,FFI or whole SMP claim"; }
