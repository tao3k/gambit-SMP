package GambitVmRootTask {
  private import ScalarValues::*;
  ref part predecessor=GambitRcTask::component;
  ref part acceptanceBoundary=GambitModernCProgress::gcFfi;
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="vm-root-task";
    attribute :>> responsibility="Explicit tagged VM RootOrigin and coordinator-confined RootTask replace implicit leader-only VM-object scan authority; shared RC/VM claim and completion states own one native scan lease";
    attribute :>> sources="lib/root.h;lib/rc.h;lib/_mem/root-tasks.inc;lib/_mem/root-origins.inc;lib/_mem/rc-roots.inc;lib/_mem/rc-allocation.inc;lib/_mem/collection-round.inc;tests/root-task.scm;tests/rc-root-origin.scm";
    attribute :>> tests="Exact two-pass producer; existing roles/frame/map/exit/p2 RC tests; same native Scheme PBT driver replays and shrinks RC and VM implementation actions; actual moving VM payload via documented unused-field2; current original GSI/check disposition";
    attribute :>> retired="VM source inferred inside mark_vm_scmobj from executor; unclaimed direct VM scan at the phase boundary; RC-only inline claim/finish mutations lifted into shared primitives; lease metadata held outside RootTask";
    attribute :>> excluded="Other root families, complete census, async/independent workers, W!=R, unknown thread/lock-holder recovery, full GC/FFI/membership/capacity and whole SMP acceptance";
  }
  part priorEdge:GambitRevisionDelivery::Dependency { ref part :>> predecessor=GambitRcTask::component; ref part :>> successor=component; }
  part nextEdge:GambitRevisionDelivery::Dependency { ref part :>> predecessor=component; ref part :>> successor=GambitRevisionDelivery::rootDispatch; }
  attribute scope:String="One VM Scheme-object root domain per existing stopped VM. Both setup barriers precede publication. Only the current coordinator may act on its live C task record. The actual scanner consumes the typed source and alone issues SCANNED. Task DONE ends its scan borrow, never VM/round lifetime. Existing RC semantics and public layout remain unchanged.";
  attribute stage:String="After162cd90d RC scan leases; VM source-task source/native review complete: tree25867657, bootstrap121.128s/core28.054s; RC/VM1728 actions and24-to4 shrink per family; moving VM payload pass. Other root families and workers remain separate successors. Actual publication is recorded in vm-root-task-result.org; no patch-line fraction transfers.";
  attribute formalDuty:String="Existing root_dispatch alone owns temporal claim/enter/finish/unknown/drain schedules. VM C record is a confined projection: SCANNED maps to scanning before finish, no requeue, outer roster holds abstract pin after native task lease0. Existing Lean RuntimeRoles owns conditional logical-cell coverage/partition/current-address laws, not another temporal machine. VM cells are (VM identity,VM-root family,index), not pointed-to heap objects; RC cells are native headers. No complete census or universal C proof is inferred.";
  attribute memoryOrder:String="RC task mutations retain the existing domain mutex. VM task state has one nonreentrant coordinator C owner and is never queued/shared, so adds no publication atomic or mutex. Real barrier_sync_noop/execute_sync_op provides the existing source-quiescence precondition. Current PSTATE/VM/coordinator checks reject alien sources/executors. Arbitrary raw writers and unknown stopped-roster outcomes are excluded.";
  attribute lifecycle:String="RootOrigin selects typed RC or VM storage. Lease lives once in RootTask. VM init accepts fresh unexposed records only; production seeds epoch from the already admitted nonzero RC round epoch. No address reuse credential or unknown task reset/requeue. VM storage survives weak/copy/cleanup independently of the completed stack record.";
  attribute pbt:String="Extend existing tests/root-task.scm and Make target, not another framework. Native Scheme family-tagged traces drive actual shared C states and real scanner over immediate-only VM fields in fresh p1 children, with no subsequent Scheme allocation. Separate ordinary GC test preserves/moves a pair/vector through actual VM unused-field2. Stale finish mutation must shrink24 to4 per family and replay deletion1-minimal; not schedule exhaustion or a discovered runtime bug.";
  attribute progress:String="Current branch delivery adds only the VM-object source-task responsibility after RC. Root bank/continuation stack, globals, symbols/keywords still need explicit task/lifetime adapters; arenas/restoration/membership/generations/FFI remain open. The historical twelve-family taxonomy is referenced, not redefined; local producer/PBT evidence does not create an overall n/12.";
  attribute nativeObservations:String="Current GSI first407/40861.394s; exact parent interpreter407/40864.638s on the actual outer/child path; fixed second current408/40860.926s. Whole check still fails test8 setup capacity6/6,members1/12,max_heap0; later official consumers pass. Origin16/task48/domain192, persistent +8D bytes, coordinator source-level record48+epoch8, optimized stack/peak unmeasured. No added mutex/GC task allocation.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="VM-ROOT-TASK-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/vm-root-task/receipt.json"; attribute :>> scope="Exact producer and required current native consumers, moving VM root, both actual PBT families/replay/shrink, current original test disposition. Missing required component test blocks; full SMP remains separate."; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="VM-ROOT-TASK-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/vm-root-task.org"; attribute :>> scope="Explain actual authority retired and shared state transitions; measure typed-origin/lease bytes, task stack and replay cost; do not invent runtime speedup."; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="VM-ROOT-TASK-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/vm-root-task.org"; attribute :>> scope="VM-only successor and dependency bound; current branch checklist, official names, unchanged cache/profile/limits and explicit remaining root/worker duties."; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="VM-ROOT-TASK-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/vm-root-task.org"; attribute :>> scope="Refine actual source selection/epoch/scan/finish to existing QNT and separate Lean cell/address premises; no duplicate protocol, arbitrary native token or whole-round seal from DONE."; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="VM-ROOT-TASK-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/vm-root-task.org"; attribute :>> scope="Explain why root location identity differs from multi-shot continuation object identity; why coordinator confinement is a bounded source seam and not W!=R; why source storage outlives the task record and unknown work cannot be replayed."; }
}
