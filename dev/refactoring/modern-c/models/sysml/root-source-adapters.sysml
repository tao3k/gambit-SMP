package GambitRootSourceAdapters {
  private import ScalarValues::*;
  ref part component=GambitRevisionDelivery::rootSourceAdapters;
  attribute scope:String="Six private execution-context/RC visitors receive explicit source addresses. Their existing mark_array executor, phase ordering, source eligibility, root cells, layouts and copying algorithm are preserved. No root-task, RC-domain or membership protocol is admitted.";
  attribute stage:String="First independently buildable leaf after b77ad85c execution-storage/layout. Source adapters precede RC-domain lifetime, activation custody, task publication and managed retirement. The larger root-dispatch study remains an open programme, not this REV submission.";
  attribute formalDuty:String="Source substitution/caller census: the phase caller passes precisely the context/RC head previously recovered inside each visitor. Frame coordinates remain stable in strong marking until later weak-phase continuation movement. Existing QNT schedules do not change; existing Lean FrameSpec/adapter premises are preserved, not re-proved or duplicated. No concurrent writer-stop or cross-VM theorem is claimed.";
  attribute sourceTree:String="7468dff0519b2200d1dfabb3ba59721941c31f11";
  attribute sourceFiles:String="lib/_mem/capacity-resize.inc;lib/_mem/collection-round.inc;lib/_mem/continuation-roots.inc;lib/_mem/rc-roots.inc;lib/_mem/root-origins.inc";
  attribute retirement:String="Remove six visitors' implicit use of the collector carrier to select execution roots/RC head. Caller now owns source selection; ___ps continues to own existing mark/copy resources and diagnostics. Leader-only RC eligibility is deliberately unchanged, not called repaired.";
  attribute cost:String="Five private C fragments only. No new field, allocation, lock, barrier, task, public declaration, generated Scheme/C emitter, workflow, test target or configuration layer. Extra private source arguments are subject to compiler optimization; no zero-instruction or speedup claim.";
  attribute excluded:String="Cross-VM GSTATE synchronization, nonzero-processor RC coverage, RC-domain lifetime, root freezing, task claims, native callback/exit recovery, worker arenas, generation GC and SMP milestones belong to separately qualified successor cuts. Their open programme obligations do not block this behavior-preserving source-adapter leaf.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="ADAPTER-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/root-source-adapters/receipt.json"; attribute :>> scope="Exact five-file tree; full bootstrap <=600s; existing frame/map multi-shot/GC-root and exit controls; unchanged original GSI inventory and official failures disposed against base. Bounded consumer acceptance, never whole original-check/SMP success."; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="ADAPTER-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/root-source-adapters.org"; attribute :>> scope="Six source-selection responsibilities explicitly relocated to phase caller, full caller census and precise before/after addresses; quantified zero metadata/synchronization additions, no performance claim."; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="ADAPTER-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/models/sysml/root-source-adapters.sysml"; attribute :>> scope="Independent dependency-first leaf, only five C fragments; larger RC/dispatcher/retirement prototype and SMP-generated C differences excluded. Official names and entrypoints retained."; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="ADAPTER-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/models/sysml/root-source-adapters.sysml"; attribute :>> scope="Source-coordinate substitution and existing strong/weak-phase ordering establish leaf equivalence. Native SysML drives shared ASCENT. QNT interleavings unchanged; Lean FrameSpec/coverage assumptions are not duplicated or promoted to worker/writer proofs."; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="ADAPTER-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/root-source-adapters.org"; attribute :>> scope="Explain Gambit GVM/portable-C and multi-shot preservation, why source selection differs from collector resources, actual layout/scan invariants, known baseline defects and exact successor boundaries before the small REV."; }
}
