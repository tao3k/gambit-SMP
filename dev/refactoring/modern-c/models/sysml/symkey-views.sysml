package GambitSymkeyViews {
  private import ScalarValues::*;
  ref part prior=GambitSymkeyPublication::component;
  ref part coverage=GambitModernCDeliveryPlan::rootViews;
  attribute auditNumber:String="3.4.1";
  attribute parentNumber:String="3.4";
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="symkey-views";
    attribute :>> responsibility="A Scheme higher-order symbol/keyword fold owns one managed flat identity view across user callbacks, GC, nonlocal exit and multi-shot resumption";
    attribute :>> sources="lib/_mem/symbols.inc;lib/mem.h;lib/_kernel.scm;tests/root-task.scm;tests/makefile.in";
    attribute :>> tests="Same cache/Bazel C23 producer and original consumers; existing Scheme replay/shrinker extended with real managed views, alias mutation, native interning, rehash, GC, callback exceptions and two resumptions; compiled92d predecessor fold counterexample and current replay";
    attribute :>> retired="Higher-order fold retaining a live bucket vector and reading intrusive NEXT between callbacks; registry traversal authority implicitly surviving arbitrary Scheme control";
    attribute :>> excluded="Raw symbol-table/keyword-table getters, Geiser/checkdoc/official metadata helpers that walk raw aliases, arbitrary private-layout callers, concurrent user mutation of shared view values, global teardown/FFI census, independent workers or whole ROOT-VIEWS/SMP closure";
  }
  part priorEdge:GambitRevisionDelivery::Dependency {
    ref part :>> predecessor=GambitSymkeyPublication::component;
    ref part :>> successor=component;
  }
  attribute scope:String="Base92d70198. Audit item3.4.1 is a complete fold responsibility inside still-open3.4 ROOT-VIEWS, not permission to close that parent. Thirteen top-level refactoring audit items and six ROOTS groups are distinct from twelve SMP acceptance families. The exact selected source tree and same leased producer, not pending vendor prototypes, are authorities.";
  attribute stage:String="QUALIFYING: one managed higher-order view leaf after native canonical publication. ROOTS still has3 scoped closed groups and3 remaining; raw getter/alias consumers and complete lifetimes remain before worker handoff. No whole-stage or inherited repair numerator.";
  attribute captureContract:String="One nonallocating native query/copy operation reuses global_gate. Scheme queries count, allocates/root-protects an ordinary vector outside the gate, then requests copy. A count mismatch returns the new required count without any destination write. Successful copy visits exactly N permanent identities in existing descending-bucket/NEXT order while native interning/rehash is excluded. Native code neither allocates nor calls Scheme/GC; it retains no destination pointer after return.";
  attribute lifetime:String="After capture, only a private Scheme vector is carried by fold frames; normal precise GC and captured continuation roots own it. No registry gate, native buffer, extra root record or manual cleanup crosses a callback. Callback interning, nested folds and GC cannot rewrite that vector. Multiple resumptions share the captured heap view and preserve Scheme dynamic-wind; no one-shot limit or copying of the registry on each resume. Deliberate aliases to caller-owned view vectors are ordinary Scheme state, not authority to modify registry storage.";
  attribute failure:String="Managed allocation may collect or escape before native copy with no lock/resource held. Count change retries with a new managed destination; abandoned vectors are ordinary GC-owned objects. Malformed/inconsistent source or invalid destination returns the existing error without publishing a view. Full partial-copy errors leave only an unpublished private vector; no native retention. Under continuous native registration retry/liveness is conditional on a finite stable-size interval; no bounded latency or arbitrary dead-owner recovery is claimed.";
  attribute callers:String="C-target kernel symbol-table-foldl is the sole source caller of symkey-table-foldl; global-var-table-foldl and REPL environment-info consume it. The universal backend has its separate implementation. Raw getter callers remain in Geiser, doc/checkdoc and official metadata helpers; their representation is unchanged and their migration remains open, preserving official assertions/names. Arbitrary external use of private symkey-table-foldl with old bucket input is outside this changed private flat-view contract.";
  attribute formalDuty:String="Reuse existing root_dispatch QNT only for unchanged source/task lease histories. Existing RuntimeRoles Lean owns conditional cell/census/address laws, not this vector copy algorithm or Scheme callback schedule. Concrete gate exclusion, N-to-N bijection, no-write refusal, generated Scheme rooting and dynamic-wind/multi-shot equivalence need source/native refinement. Actual predecessor Scheme code executes as a compiled fixture control, not an observer mutation or whole predecessor build. No duplicate QNT/Lean machine or ambient LLM proof oracle.";
  attribute benefit:String="A callback may grow/reverse registry chains without changing the fold's entry identity set; GC and two resumptions retain that set. Registry traversal and arbitrary control no longer share one mutable layout lifetime. The existing C ABI, shared symbol identity and multi-shot Scheme semantics remain; this is a necessary ownership foundation for later collector separation, not a full SMP solution or throughput gain.";
  attribute cost:String="Zero new mutexes, public layout fields, permanent records, native buffers or manual root APIs. One managed N-word identity vector per completed capture plus its ordinary header; retries allocate additional transient vectors. Capture adds O(bucket count+N) gate-held work and delays GC polling during that noncollecting fragment. Retained independent folds can retain sum(N_i) words; multiple resumptions of one captured fold share one view. Physical peak, contention and release performance are unmeasured.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="SYMKEY-VIEWS-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/symkey-views/receipt.json"; attribute :>> scope="Exact source producer/original consumers, real Scheme/C PBT/replay/shrink, callback growth, copy refusal, multi-shot/GC/exception paths and retained failures"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="SYMKEY-VIEWS-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/symkey-views.org"; attribute :>> scope="Separate registry topology lifetime from Scheme control lifetime; quantify snapshot allocation/critical work versus actual correctness benefit"; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="SYMKEY-VIEWS-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/symkey-views.org"; attribute :>> scope="Numbered13-item audit, leaf3.4.1 within open3.4, six ROOTS groups and separate SMP12-family acceptance; no partial-parent promotion"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="SYMKEY-VIEWS-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/symkey-views.org"; attribute :>> scope="Native SysML drives actual ASCENT needs and ordinal/dependency checks; existing QNT temporal and Lean conditional-cell duties remain separate from concrete Scheme/C view refinement"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="SYMKEY-VIEWS-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/symkey-views.org"; attribute :>> scope="Why insertion locking cannot protect a callback-held NEXT chain; why no lock may span user code; why managed roots amplify multi-shot reuse; what raw aliases remain and which outcomes falsify the claimed replacement"; }
}
