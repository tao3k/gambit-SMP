package GambitTclCommand {
  private import ScalarValues::*;
  ref part sourceBase=GambitRcSlotWrites::component;
  ref part coverage=GambitModernCDeliveryPlan::rootWriters;
  attribute auditNumber:String="3.5.2.1";
  attribute parentNumber:String="3.5.2";
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="tcl-command-construction";
    attribute :>> responsibility="One Tcl command construction owner roots the procedure before allocation, initializes the still payload from the relocated RC cell, then transfers to Tcl on acceptance or runs the existing delete release path on rejection";
    attribute :>> sources="examples/tcltk/command.h;examples/tcltk/tcltk.scm;examples/tcltk/makefile.in;tests/root-task.scm;tests/makefile.in";
    attribute :>> tests="Exact source producer and official consumers; optional real Tcl provider through the existing root-task replay/shrinker; acceptance/replacement/deletion, rejected preserved interpreter, forced real GC and controlled vector refusal; actual configured Make empty/source-prefix argv and object compilation with those include options";
    attribute :>> retired="Inline construction without an explicit C-value root, missing processor argument in the SMP RC allocation call, and ownerless RC/still resources after a returned NULL registration";
    attribute :>> excluded="No callback pin registry, new runtime namespace/fields/locks, Tcl cancellation/result-boundary redesign, cross-library nonlocal-exit recovery, dynamic C-closure ABI fix or complete3.5.2/3.5/3.6 closure";
  }
  attribute scope:String="Base8ee204fc. Independent3.5.2.1 construction source-root/returned-result ownership. Original generated ___arg2 is a live ___CFUN_ARG reference, not evidence of a stale old Scheme argument. Extracting a C helper captures a scalar value, so its existing RC record must become the explicit pre-allocation root. Invocation/delete code is moved unchanged into the same command header; no callback-drain admission follows.";
  attribute stage:String="QUALIFYING. Source/root job follows existing Gambit RC registration, actual collector update and still lifetime. Parent ROOT-WRITERS and root-borrowers remain open. The separate thread-interrupt failure is retained; scheduler and capacity changes are excluded.";
  attribute contract:String="No interpreter means no allocation. Native RC allocation/register supplies the owner processor; install proc in its private root before make_vector can collect. Allocation failure releases that record. On vector success initialize its field from data_rc after collection, then install vector in the RC cell. A returned registration token transfers native ownership to Tcl's existing delete callback. NULL before acceptance invokes that same callback locally, balancing the still hold and RC owner exactly once. No allocation/callback lies between post-GC reload and field initialization.";
  attribute unknown:String="A native call that does not return grants no local success or rollback receipt. Do not infer nonacceptance from timeout or release a possibly registered ClientData. Existing registered RC/still custody remains wherever actually transferred; automatic lookup/recovery and cross-library unwind remain unqualified. Retained RC debt can refuse cleanup while still being scanned; no claim that all unknown outcomes are recoverable.";
  attribute memoryOrder:String="Existing owner/OPEN RC registration and setter domain mutexes publish the construction root; the existing frozen claimed RC RootTask scans and updates it during GC. Still vector starts with native refcount1 and no allocation intervenes before payload initialization. This is the current cooperative/owner-thread contract, not arbitrary concurrent Tcl or foreign-reader admission.";
  attribute formalDuty:String="Source refinement supplies actual pre-allocation root, relocated reload, initialized still payload and returned ownership decision. Existing QNT retains competing source/task/lifetime histories, existing Lean retains distinct conditional cell/coverage/address laws. This serial constructor does not create a second QNT/Lean machine. Native SysML and actual ASCENT bind source/effect/test observations and reject incomplete or stale submission claims.";
  attribute benefit:String="A rejected registration no longer permanently retains one RC record and one positive still-object hold. The same RC allocation also roots the captured C helper argument across real collection, with no additional root table or object. One release implementation serves Tcl deletion and preacceptance rollback. Header/make dependencies make the real adapter independently testable without Tk GUI startup.";
  attribute cost:String="Successful construction adds one RC payload store and one post-GC load under existing locks, no additional allocation/record/field/lock. Rejection releases the RC block now; the zero-refcount still vector becomes reclaimable by a later GC, not immediately freed physical memory. The same existing Scheme fixture gains an optional Tcl-linked build; ordinary official check has no new Tcl dependency. No measured latency/throughput or whole-round peak reduction.";
  attribute calibration:String="Original SMP example contains alloc_rc(0) without PSD. The compiled predecessor control supplies PSD and a live caller cell to preserve the original generated CFUN_ARG semantics; it reproduces the old allocation/publication/NULL-result sequence. These adaptations are explicit: it is not an exact-byte whole predecessor executable or a fabricated stale-argument bug. Real Tcl rejection and actual RC/still counts decide the property. The allocator adapter forces a real GC before the real allocation, or returns a controlled failure; observers are unmodified.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="TCL-COMMAND-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/tcl-command/receipt.json"; attribute :>> scope="Exact current producer/consumers and real provider, construction lifecycle PBT with failed predecessor/current replay and shrink, real GC and controlled refusal; missing required cases block publication"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="TCL-COMMAND-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/tcl-command.org"; attribute :>> scope="Preserve generated live-argument semantics when extracting a C helper; reuse the existing RC record, balance returned rejection, distinguish refund from immediate physical reclaim"; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="TCL-COMMAND-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/tcl-command.org"; attribute :>> scope="One construction leaf within3.5.2, source-selected hunks only; callback/dynamic closure/scheduler remain independent; update15-target queue,13-item ledger and SMP12 separately"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="TCL-COMMAND-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/tcl-command.org"; attribute :>> scope="SysML/ASCENT source/result authority and source-bound evidence; existing QNT/Lean unchanged and no proof inferred from finite PBT"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="TCL-COMMAND-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/tcl-command.org"; attribute :>> scope="Why this is necessary ownership replacement, why the old argument is not proven stale, which actual native provider is tested, what NULL/unknown means, what costs and callback/native ABI gaps remain"; }
}
