package GambitRcTask {
  private import ScalarValues::*;
  ref part predecessor=GambitRcOwnership::component;
  ref part acceptanceBoundary=GambitModernCProgress::gcFfi;
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="rc-root-task-lease";
    attribute :>> responsibility="RC source freeze and one scan lease publish atomically; epoch/executor-bound claim, actual scan and completion; only existing whole-round epilogue resumes the source";
    attribute :>> sources="lib/root.h;lib/rc.h;lib/_mem/root-tasks.inc;lib/_mem/rc-roots.inc;lib/_mem/rc-allocation.inc;lib/_mem/collection-round.inc;lib/mem.c;lib/makefile.in;tests/root-task.scm;tests/rc-root-origin.scm;tests/makefile.in";
    attribute :>> tests="Exact producer; existing frame/map/RC/GSI controls; real C structured replay, stale-finish invocation mutation and deletion shrinking with fresh process per candidate; lease retention and detached executor clearing";
    attribute :>> retired="Direct unclaimed RC scanning, completion without normal scanner return, reopening a source from its frozen bit alone, and retained executor pointers in detached byte domains";
    attribute :>> excluded="Other root families, W!=R, task requeue/worker death recovery, physical whole-round seal replacement, arbitrary raw source lookup, full membership/GC/FFI and whole SMP acceptance";
  }
  part priorEdge:GambitRevisionDelivery::Dependency { ref part :>> predecessor=GambitRcOwnership::component; ref part :>> successor=component; }
  part nextEdge:GambitRevisionDelivery::Dependency { ref part :>> predecessor=component; ref part :>> successor=GambitRevisionDelivery::rootDispatch; }
  attribute scope:String="One RC RootTask per independently lived RC domain, using the existing cooperative roster/executor. Publication owns exactly one scan lease; duplicate claim/scan rejected, finish idempotent, source remains frozen after task completion until existing round barriers finish. Native source cut qualified; actual publication/admission is recorded in rc-task-result.org.";
  attribute stage:String="After94b14f24 RC ownership; native qualification,864 real implementation actions and24-to4 shrink/replay complete. No inherited SMP patch-line fraction. The branch checklist separates local component tests from the12 whole-runtime gate families.";
  attribute formalDuty:String="Use existing runtime_roles.qnt root_dispatch: freeze/publish fusion, claim, enter, finish, queryDone and qualified round drain. Native SCANNED is a refinement cut after actual mark_array returns, not a second QNT machine. Per-task lease completion does not discharge model.pinned until whole-round closure. Existing Lean arbitrary-cell coverage premises remain unchanged; RC-only tasks do not establish complete census.";
  attribute memoryOrder:String="The existing domain mutex orders epoch, eligible executor, state, phase and lease as one transaction. Domain attachment/closed roster protects lookup before locking. No new atomic loop or identity table. Unfinished/unknown scans retain lease and cannot requeue or resume. Detached domains clear both owner and executor before VM storage can disappear.";
  attribute pbt:String="Native Scheme action data carries opcode, relative epoch and logical actor. Independent observable oracle drives actual C in a fresh executable process per replay/shrink. An explicitly labeled stale-finish adapter mutation must reduce from24 to4 causal actions and reproduce the same acceptance mismatch while lease1/stateSCANNED remain. This is deletion1-minimal, not global minimality or schedule exhaustion.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="RC-TASK-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/rc-task/receipt.json"; attribute :>> scope="Exact runtime bootstrap and consumers, real RC source1/root and detach controls, current original GSI, actual replay and shrink negative calibration; test8/full original failure retained and disposed separately. Missing required test blocks."; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="RC-TASK-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/rc-task.org"; attribute :>> scope="Retire unleased scan/reopen authority; quantify inline task memory, locks and actual replay/shrink cost; no throughput or whole-SMP claim."; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="RC-TASK-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/rc-task.org"; attribute :>> scope="RC-only RootTask successor, actual branch checklist, other roots/worker arenas/membership/FFI/performance explicitly open. Official names and existing build/test path retained."; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="RC-TASK-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/rc-task.org"; attribute :>> scope="Map actual C publication/claim/scan/completion and existing epilogue to distinct existing QNT/Lean obligations; actual source-address lifetime and epoch premises explicit. No duplicate QNT/Lean machine or formal proof claim from PBT."; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="RC-TASK-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/rc-task.org"; attribute :>> scope="Explain preservation/amplification of exact roots and multi-shot continuation, source versus executor separation, why completed task is not whole-GC completion, and why fresh replay/shrink avoids dirty-state reuse."; }
}
