package GambitRcOwnership {
  private import ScalarValues::*;
  ref part predecessor=GambitRevisionDelivery::rootSourceAdapters;
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="rc-source-ownership";
    attribute :>> responsibility="RC registration, payload/reference/borrow access, every-source scanning and pre-retirement close share an independently lived source domain";
    attribute :>> sources="include/gambit.h.in;lib/rc.h;lib/_mem/rc-allocation.inc;lib/_mem/rc-roots.inc;lib/_mem/collection-round.inc;lib/_mem/memory-lifecycle.inc;lib/_mem/configuration.inc;lib/mem.c;lib/setup.c;lib/makefile.in;tests/makefile.in;tests/rc-root-origin.scm";
    attribute :>> tests="Exact producer bootstrap and original GSI; moving source0/source1 control; native slot-action properties, registration/duplicate-setup refusal, borrow-last, native reference handoff, true resize refusal and byte retirement; existing frame/continuation/exit and old-module controls";
    attribute :>> retired="Implicit rc_head carrier alias, leader-only RC eligibility, unguarded registered list/count/payload mutation, bulk freeing externally owned RC nodes, overwrite of an attached processor source";
    attribute :>> excluded="Independent worker/task/arena/capacity protocols, unknown join or killed holder recovery, raw CFFI/marker constructor/Tcl acquisition and whole SMP/global VM reclamation; no new QNT/Lean machine";
  }
  part predecessorEdge:GambitRevisionDelivery::Dependency { ref part :>> predecessor=GambitRevisionDelivery::rootSourceAdapters; ref part :>> successor=component; }
  part successorDependency:GambitRevisionDelivery::Dependency { ref part :>> predecessor=component; ref part :>> successor=GambitRevisionDelivery::rootDispatch; }
  attribute scope:String="Complete RC registration/payload/reference/borrow/scan/close lifecycle within the existing cooperative roster. Byte-only native ownership can outlive its carrier; live Scheme payload or borrow refuses retirement. No RootTask scheduler or independent collector admission.";
  attribute stage:String="Exact b593b658 source after43db0e3f: full bootstrap, original GSI408/408, moving-root control, stateful RC ownership/retirement, held old-module and frame consumers complete. Source-bound ASCENT admission is required before publication. Baseline test8 remains failed. Global writers, raw CFFI, unknown joins and capacity are separate successors.";
  attribute formalDuty:String="Reuse rc_root_release.qnt owner/borrow/scan exclusion and root_store_projection.qnt frozen coverage/reload; refine actual mutex and synchronous barriers at source. Existing Lean FrameSpec laws remain unchanged. Native stateful properties test real RC APIs, not a duplicated formal protocol. Finite models, PBT and ambient LLM review do not prove arbitrary C interleavings.";
  attribute authority:String="RC source domain owns list membership, payload mutation, borrow counts and retirement; the collector retains existing copy resources. No parallel native namespace or configuration service.";
  attribute cOrder:String="POSIX mutex or Win32 critical-section release/acquire orders source stores and scan; no-thread is sequential. Source freezes before the existing GC barrier; normal source accesses complete before mutex unlock, unfreeze and free. A valid reference/borrow precedes header lookup. Unknown scanner exit has no completion receipt.";
  attribute formalModels:String="dev/refactoring/modern-c/models/quint/rc_root_release.qnt;dev/refactoring/modern-c/models/quint/root_store_projection.qnt;existing Lean frame laws;no new QNT/Lean file";
  attribute pbt:String="Structured legal slot actions and independent reference oracle call real C APIs. Fixed seeds/history support replay; automatic dependency-preserving shrinking and controlled concurrent schedules remain future test-adapter work. Rust Quint Connect is not introduced into the C runtime.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="RC-OWNERSHIP-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/rc-ownership/receipt.json"; attribute :>> scope="Exact source/profile bootstrap and existing frame/map/GSI controls, matched source1 moving-root failure/pass, true owner/borrow/shrink/refusal and detached-byte release. Missing or failed required result blocks."; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="RC-OWNERSHIP-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/rc-ownership.org"; attribute :>> scope="Explain removed bulk-free/leader-only/unguarded responsibilities, actual new locks/allocation/retention and no invented speedup. Distinguish legal PBT histories from model checking and native schedule coverage."; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="RC-OWNERSHIP-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/models/sysml/rc-ownership.sysml"; attribute :>> scope="Buildable ownership successor to43db0e3f, not whole root-dispatch/capacity/CFFI/SMP closure; official names and build entrypoints retained."; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="RC-OWNERSHIP-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/rc-ownership.org"; attribute :>> scope="Explicit valid-reference-before-header premise, publication/freeze/scan/unlink memory order, borrow reload, old-roster close/refusal and detached-domain lifetime. Reuse existing Quint actions and Lean laws without duplicate machines; conditional source argument is not arbitrary C proof."; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="RC-OWNERSHIP-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/rc-ownership.org"; attribute :>> scope="Preserve Scheme roots/multi-shot frame consumers and portable C; expose source identity/lifetime rather than attach RC eligibility to collector0. Explain scope, refusal, native byte lifetime and why PBT does not close raw FFI/unknown-exit obligations."; }
}
