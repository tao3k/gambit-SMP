package GambitPrimitiveDelivery {
  private import ScalarValues::*;
  ref part selected = GambitRevisionDelivery::primitive;
  ref part contract = GambitModernCCommitAdmission::checkedIncrement;
  attribute scope:String="Exactly gsc/_prims.scm and tests/vector-increment-contract.scm on the delivered hash-layout REV. Safe general-vector increment validates its delta and stored element after vector/index admission, before the unsafe atomic operation. Other primitives and concurrent arbitrary-type writers are outside this cut.";
  attribute stage:String="Compiler safety REV after native index ownership, before build-budget and runtime-role ABI migration. Preserve every unrelated staged/working responsibility. Whole original GSC/SMP acceptance remains a programme obligation, not inferred from affected-case tests.";
  attribute formalDuty:String="Source refinement of existing short-circuit specialization and one-evaluation operand binding; actual old-compiler negative plus new interpreted/compiled controls. This pure validation/control-flow addition needs no duplicate QNT scheduler or Lean theorem; it does not prove typed atomicity against concurrent arbitrary-value replacement.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part source:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="V-SOURCE"; attribute :>> method="source-refinement"; attribute :>> artifact=".cache/research/legacy-evidence/evidence/refactoring/modern-c/vector-increment/source.json"; attribute :>> scope="exact two-path tree and complete canonical native input/output binding; no pending worker/layout/CI content"; }
  part controls:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="V-NATIVE"; attribute :>> method="native"; attribute :>> artifact=".cache/research/legacy-evidence/evidence/refactoring/modern-c/vector-increment/tests.json"; attribute :>> scope="old compiler produces expected invalid-delta failure; incremental new compiler; interpreted and compiled operand/no-write/return-value fixture; two unchanged affected original GSC cases"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="V-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/primitive-delivery.org"; attribute :>> scope="safe specialization must not infer fixnum contents from a general vector; no parallel primitive or namespace; preserve unsafe specialization"; }
  part processNeed:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="V-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/models/sysml/revision-delivery.sysml"; attribute :>> scope="separate compiler safety, build, runtime ownership, harness and CI responsibilities with own evidence"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="V-MODELS"; attribute :>> method="native-model-projection"; attribute :>> artifact=".cache/research/legacy-evidence/evidence/refactoring/modern-c/vector-increment/model.json"; attribute :>> scope="native strict SysML drives shared ASCENT gates and five rejection controls; existing checkedIncrement source contract; no duplicate formal duties"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="V-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/primitive-delivery.org"; attribute :>> scope="preserve Scheme binding/error and old-value semantics, portable C lowering and control machinery; expose the arbitrary concurrent writer limit and whole-suite boundary"; }
}
