package GambitGlobalValueWriters {
  private import ScalarValues::*;
  attribute scope:String="3.5.3.1: ordinary per-VM global-value writes, from Scheme SET_GLO and reflective GLOBALVARSET to the canonical cell scanned by ROOT_GLOBALS. This is a source-audited proposed responsibility cut, not an implemented or admitted runtime REV. Shared PRMCELL writers, all FFI and whole ROOTS remain separate.";
  attribute sourceRevision:String="043a9341168645caa1fc8f13cb586ef63a352dcc";
  attribute status:String="SOURCE_CENSUS_OPEN_NO_RUNTIME_ADMISSION";
  attribute contract:String="A real write either commits to the canonical VM cell before its source freezes, with a happens-before path to scanning, or is refused/deferred without a store or lost source root. A count snapshot alone is not writer exclusion. Do not add per-store locking or reuse an RC ownership name as proof of a new complete root-write protocol.";
  attribute qnt:String="dev/refactoring/modern-c/models/quint/root_store_projection.qnt: beginWriter/finishWriter, closeAdmission/freeze and canonical aliases; existing competing histories only, unchanged. Its closedWriters premise is not established by the present C macros.";
  attribute lean:String="dev/refactoring/modern-c/models/lean/RuntimeOwnership.lean: instantiate root-slot coverage/relocation laws only after a real cell map is proved. No duplicated schedule or C weak-memory theorem; unchanged and not rerun.";
  attribute firstPatch:String="Preserve SET_GLO/GLOBALVARSET spelling and evaluation semantics; route generated and reflective ordinary stores to one source-authorized capability. Include actual runtime binding/ABI consumers and old-module rejection if the required service changes the interface. Account for setup before publication and declared raw C writers. Do not include the shared primitive-cell protocol or W!=R redesign in this cut.";
  attribute benefit:String="Conditional: replace implicit stopped-carrier/root-count assumptions by explicit canonical-cell ownership and close/store arbitration; enable independent root tasks without racing late writes. No measured throughput or GC improvement follows from this source audit.";
  attribute cost:String="Unresolved choice: per-store synchronization versus an activation-scoped permit. Must count actual acquisitions, metadata and critical-path operations for the chosen implementation; neither is claimed free or implemented. Additional remembered-set costs belong to their separate future contract.";
  part def Edge { attribute id:String; attribute file:String; attribute anchor:String; attribute responsibility:String; }
  part generated:Edge { attribute :>> id="generated"; attribute :>> file="gsc/_t-c-2.scm"; attribute :>> anchor="(list \"SET_GLO\""; attribute :>> responsibility="Two real emitter sites; preserve one evaluation and global binding selection."; }
  part reflective:Edge { attribute :>> id="reflective"; attribute :>> file="gsc/_t-c-2.scm"; attribute :>> anchor="\"GLOBALVARSET\""; attribute :>> responsibility="Actual global-var-set! lowering, distinct from primitive-set!."; }
  part ordinary:Edge { attribute :>> id="ordinary"; attribute :>> file="include/gambit.h.in"; attribute :>> anchor="#define ___GLOBALVARSET"; attribute :>> responsibility="Direct lvalue store today; lacks explicit writer admission."; }
  part macro:Edge { attribute :>> id="macro"; attribute :>> file="include/gambit.h.in"; attribute :>> anchor="#define ___SET_GLO"; attribute :>> responsibility="Direct generated lvalue store today; aliases reflective ordinary cell."; }
  part coordinates:Edge { attribute :>> id="coordinates"; attribute :>> file="include/gambit.h.in"; attribute :>> anchor="#define ___GLOCELL_IN_VM"; attribute :>> responsibility="VM glos[index] versus SINGLE_VM direct cell; compile modes must remain distinct."; }
  part shared:Edge { attribute :>> id="shared"; attribute :>> file="include/gambit.h.in"; attribute :>> anchor="#define ___GLOBALVARPRIMSET"; attribute :>> responsibility="Shared PRMCELL store; cannot infer per-VM ownership from the ordinary global mapping."; }
  part freeze:Edge { attribute :>> id="freeze"; attribute :>> file="lib/_mem/root-tasks.inc"; attribute :>> anchor="___BOOL ___root_globals_begin"; attribute :>> responsibility="Existing closed-roster/RC-frozen premise and one common count; does not supply missing store permits."; }
  part scan:Edge { attribute :>> id="scan"; attribute :>> file="lib/_mem/root-origins.inc"; attribute :>> anchor="___BOOL ___root_task_scan_globals"; attribute :>> responsibility="Actual canonical source slice consumed by one claimed scan task."; }
  part def Obligation { attribute id:String; attribute condition:String; }
  part census:Obligation { attribute :>> id="GLOBAL-WRITER-CENSUS"; attribute :>> condition="Enumerate generated/reflection/setup/raw C ordinary stores and distinguish compiler-controlled from unadmitted external lvalue aliases."; }
  part arbitration:Obligation { attribute :>> id="GLOBAL-WRITER-ARBITRATION"; attribute :>> condition="Real C permission issue/last store/release/close path, memory order and failure custody; no gate held across collecting work or callbacks."; }
  part identity:Obligation { attribute :>> id="GLOBAL-CANONICAL-CELL"; attribute :>> condition="Prove both ordinary forms map to the actual scanned cell in each admitted compile mode; shared primitive storage stays a distinct owner."; }
  part moduleBinding:Obligation { attribute :>> id="GLOBAL-WRITER-BINDING"; attribute :>> condition="Actual header/generator/runtime/module table mapping and old-module behavior if changed; keep Gerbil build names and public Scheme names."; }
  part native:Obligation { attribute :>> id="GLOBAL-WRITER-NATIVE"; attribute :>> condition="Real generated and reflective assignment, processor0/nonzero, close/store race, relocation and failure effects with implementation PBT/replay/shrink and unchanged official consumers."; }
  part def NativeCase { attribute id:String; attribute condition:String; }
  part stores:NativeCase { attribute :>> id="generated-reflective-stores"; attribute :>> condition="Actual ordinary writes through both source forms and actual canonical cell; processor0/nonzero."; }
  part racing:NativeCase { attribute :>> id="freeze-relocation-refusal"; attribute :>> condition="Real close/store ordering, moving GC and refusal/failure non-effects; no heap/wait increase."; }
  part replay:NativeCase { attribute :>> id="implementation-replay-shrink"; attribute :>> condition="Actual implementation histories, independent predecessor control, exported replay and shrinking."; }
  part consumers:NativeCase { attribute :>> id="unchanged-official-consumers"; attribute :>> condition="Same production/Bazel profile and official populations; source-disjoint baseline attribution is separate from whole SMP acceptance."; }
}
