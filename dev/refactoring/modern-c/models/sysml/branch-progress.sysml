package GambitModernCProgress {
  private import ScalarValues::*;
  attribute authority:String="This is the branch-specific checklist authority. Published responsibility slices, local test observations and twelve whole-runtime acceptance families are separate dimensions; no patch-line count transfers.";
  attribute source:String="docs/smp-threaded-vm-milestone.md and docs/bazel-profile-grid-review-checkpoint.md supply the historical12-family taxonomy. Their old sources/counts are not this branch's native evidence.";
  attribute checkpoint:String="Published bf08f39f execution storage,b77ad85c fixture correction,43db0e3f source adapters,94b14f24 RC ownership. RC RootTask leases/replay/shrink are native-qualified; rc-task-result.org records actual publication separately.";
  attribute countPolicy:String="Do not publish a numerator/12 until a current-source full gate manifest binds exact inventory, mode, processor population, native artifacts and budgets. Local bootstrap or default GSI success may be recorded without claiming that manifest.";
  part def GateFamily { attribute id:String; attribute title:String; attribute status:String; attribute evidence:String; attribute gap:String; }
  part bootstrap:GateFamily { attribute :>> id="bootstrap"; attribute :>> title="Complete producer bootstrap"; attribute :>> status="LOCAL_PASS_PENDING_MILESTONE_BINDING"; attribute :>> evidence="RC-task production tree01ae9308: two complete phase1--4 passes199.430s; stock core39.535s; final733e5e10 has only a qualified test delta"; attribute :>> gap="Exact production reuse proved; no full12-gate publication"; }
  part interpreted:GateFamily { attribute :>> id="interpreted-inventory"; attribute :>> title="Complete interpreted inventory"; attribute :>> status="LOCAL_INVENTORY_PASS_PENDING_SMP_BINDING"; attribute :>> evidence="RC-task733e5e10: first407/408 in61.080s, fixed second408/408 in61.713s; first interrupt failure retained"; attribute :>> gap="Bind full milestone-required mode/population/inventory on each new source; not PR/stress acceptance"; }
  part compiled:GateFamily { attribute :>> id="compiled-inventory"; attribute :>> title="Complete compiled inventory"; attribute :>> status="OPEN"; attribute :>> evidence="Focused compiled frame/map/RC and official9/10/12 cases only"; attribute :>> gap="Every original GSC unit and natural completion still required"; }
  part prInterpreted:GateFamily { attribute :>> id="pr-interpreted"; attribute :>> title="Additional PR regressions interpreted"; attribute :>> status="OPEN"; attribute :>> evidence="No full branch-specific PR manifest accepted"; attribute :>> gap="Select exact upstream additional-regression inventory and execute in declared interpreted mode"; }
  part prCompiled:GateFamily { attribute :>> id="pr-compiled"; attribute :>> title="Additional PR regressions compiled"; attribute :>> status="OPEN"; attribute :>> evidence="No full branch-specific PR manifest accepted"; attribute :>> gap="Same inventory in compiled mode; no inherited patch success"; }
  part stressInterpreted:GateFamily { attribute :>> id="stress-interpreted"; attribute :>> title="Original interpreted stress"; attribute :>> status="OPEN"; attribute :>> evidence="Historical repair-line stress remains reference only"; attribute :>> gap="Unchanged original stress on this producer; tfib diagnosis not expanded inside a root-task REV"; }
  part stressCompiled:GateFamily { attribute :>> id="stress-compiled"; attribute :>> title="Original compiled stress"; attribute :>> status="OPEN"; attribute :>> evidence="No full current branch stress completion"; attribute :>> gap="Unchanged complete compiled stress inventory and fixed limits"; }
  part registry:GateFamily { attribute :>> id="registry-lifetime"; attribute :>> title="Shared registry lifetime"; attribute :>> status="OPEN_WITH_COMPONENT_EVIDENCE"; attribute :>> evidence="RC source domains and known normal retirement have local native controls"; attribute :>> gap="Complete cross-VM registry, repeated resize/reuse/retirement and generation isolation remain open"; }
  part lifecycle:GateFamily { attribute :>> id="lifecycle-faults"; attribute :>> title="Lifecycle faults and rollback"; attribute :>> status="OPEN_WITH_COMPONENT_EVIDENCE"; attribute :>> evidence="RC registration/duplicate setup/retirement refusal and byte-owner handoff pass"; attribute :>> gap="Metadata OOM, partial creation, unknown joins, old handlers and global reclaim not admitted"; }
  part gcFfi:GateFamily { attribute :>> id="gc-ffi"; attribute :>> title="Complete GC/FFI"; attribute :>> status="OPEN_WITH_COMPONENT_EVIDENCE"; attribute :>> evidence="Moving source1 RC roots, borrowed cells, multi-shot map/root frames and RC task leases pass;864 real task actions,24-to4 shrink/replay"; attribute :>> gap="Other root sources/task leases, independent worker resources, raw FFI and full collector closure remain open; official test8 fails"; }
  part gerbil:GateFamily { attribute :>> id="gerbil-correctness"; attribute :>> title="Gerbil build and test correctness"; attribute :>> status="OPEN"; attribute :>> evidence="Public names/build entries retained; no full current branch Gerbil success"; attribute :>> gap="Exact producer stage0/stage1/stdlib and full Gerbil tests"; }
  part performance:GateFamily { attribute :>> id="release-performance"; attribute :>> title="Release performance"; attribute :>> status="OPEN"; attribute :>> evidence="Structural costs and qualification times only"; attribute :>> gap="Matched workloads, complete latency populations, peak memory and release build/performance gates"; }
}
