package GambitTestEntry {
  private import ScalarValues::*;
  ref part selected=GambitRevisionDelivery::testEntry;
  attribute scope:String="Six test source/build paths only; shared configured entry adapter, original three assertion bodies and one dispatch/return control. No Scheme test rewrite, runtime/layout change or workflow command replacement";
  attribute stage:String="CI entry repair after target integration; pending resource, header, scope rename, runtime ownership and modular CI remain separate. Preserve deleted legacy working source and unqualified future renamed content";
  attribute formalDuty:String="Source refinement against configured WinMainCRTStartup and existing typed Gambit Windows main, native original bodies plus adapter dispatch/return control; real Windows ABI observed after push. No new QNT/Lean state/representation obligation";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part source:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="TE-SOURCE"; attribute :>> method="source-refinement"; attribute :>> artifact=".cache/research/legacy-evidence/evidence/refactoring/modern-c/test-entry/source.json"; attribute :>> scope="exact six-path tree; unchanged bodies except declaration/include; source archive closure; correct entry signature and return propagation; pending runtime source excluded"; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="TE-NATIVE"; attribute :>> method="native"; attribute :>> artifact=".cache/research/legacy-evidence/evidence/refactoring/modern-c/test-entry/tests.json"; attribute :>> scope="original stack/scope/frame controls, multi-shot and wide-root consumers, single dispatch/nonzero return control, exact default-runtime reuse; synthetic control is not a Windows ABI pass"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="TE-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/test-entry.org"; attribute :>> scope="CRT entry and C body are distinct contracts; standalone C controls must not invoke Scheme setup or silently override linker flags"; }
  part processNeed:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="TE-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/models/sysml/revision-delivery.sysml"; attribute :>> scope="entry repair is independent of resource timing failure and scope rename; original Scheme tests and fixed limits retained"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="TE-MODELS"; attribute :>> method="native-model-projection"; attribute :>> artifact=".cache/research/legacy-evidence/evidence/refactoring/modern-c/test-entry/model.json"; attribute :>> scope="strict native SysML and shared ASCENT five gates plus stale/missing evidence rejection controls; no duplicated QNT/Lean"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="TE-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/test-entry.org"; attribute :>> scope="same body, exit propagation, configured calling convention, no Scheme startup, no public namespace/GC/multi-shot change; remote exact-source validation remains separately observed"; }
}
