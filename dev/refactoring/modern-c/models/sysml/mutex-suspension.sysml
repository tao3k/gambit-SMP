package GambitMutexSuspension {
  private import ScalarValues::*;
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="mutex-suspension";
    attribute :>> responsibility="The mutex lock owns the decision; only a committed blocked wait publishes the thread's scheduler continuation. Immediate ownership and expired timeout keep the running root view.";
    attribute :>> sources="lib/_thread.scm; affected generated thread/link products;tests/mutex-suspension.scm;tests/makefile.in";
    attribute :>> tests="Exact two-pass bootstrap; native immediate/blocked/interrupted-GC histories; real implementation PBT, baseline shrink and candidate replay; existing frame/map multi-shot, RC/root tasks, official test12 and original GSI inventory with failures retained";
    attribute :>> retired="Unconditional THREAD_SAVE before the mutex state decision, including continuation-field publication and stack-break setup on nonblocking outcomes; the actual wait body and mutex result protocol remain authoritative.";
    attribute :>> excluded="No repair overlay, private drain catcher/wind fusion, request representation rewrite, universal mailbox/park/exit closure, W!=R, full capacity census, test8 repair or whole repair9/12 acceptance.";
  }
  attribute scope:String="One existing SMP mutex slow-path responsibility. Original mutex lock spans the owner decision and blocked continuation publication. Timeout conversion remains before the decision with original unlock/relock protocol. Actual wait mutations, default void resume, absolute timeout, return/abandonment and interrupt retry remain in the original semantic order.";
  attribute stage:String="Bounded scheduler/root-retention cut on29f09a81, following published root entries. Repair9 supplies the coupled modernization target; it does not provide a patch or native credit. Actual results belong in mutex-suspension.org and the portable receipt; original load capacity remains open.";
  attribute formalDuty:String="Source refinement only for moving the unchanged immediate decision outside THREAD_SAVE: no shared-history transition or waiter transfer policy changes. Existing models/gambit/abandoned_mutex_waiter_transfer.qnt exclusively owns target termination versus ownership-transfer interleavings; its unchanged boundary is inspected, not copied. Existing control frame/root laws retain conditional consumer duties; no new Lean theorem or rerun is claimed. Real implementation root-view observation, PBT replay/shrink and generated C are separate evidence and cannot establish native fairness or wall-time bounds.";
  attribute sourceRelation:String="Under the already-held mutex lock, immediate owner inspection and updates are the same operations, now without saving a scheduler frame. In the blocking branch THREAD_SAVE still precedes BTQ/current/TOQ publication and lock release. On void resume the same mutex is reacquired before retry. Generated frame maps and existing moving collectors consume the remaining saved continuation normally.";
  attribute sourceDifference:String="Modern-c HEAD has the original direct execute/store/unlock dispatch, not the repair image's per-request drain catcher and execution wind. Removing those absent constructs would be a fictitious branch benefit. Public user continuation, dynamic-wind and exception semantics are unchanged.";
  attribute benefit:String="One avoided scheduler-save operation and no newly installed saved-frame root per admitted immediate slow-path outcome. Actual materialized frame words, root visits, peak and original-load throughput must be measured; a removed source operation is not a speedup or proof of leak elimination.";
  attribute cost:String="No new runtime fields, locks, atomics, allocation, generation table or public namespace. Existing current-thread/owner locals participate in generated liveness; exact generated labels/maps and compiler effects must be qualified. One component Scheme fixture reuses official Make, existing native Scheme generation, replay and deletion shrinking.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="MUTEX-SUSPENSION-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/mutex-suspension/receipt.json"; attribute :>> scope="Exact producer, runtime source and generated consumers; baseline1-step witness, candidate replay/PBT and actual wait/interrupt/GC; official failures retained; no whole-SMP credit"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="MUTEX-SUSPENSION-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/mutex-suspension.org"; attribute :>> scope="Separate capture/save/materialization/retention; do not import repair-image overhead into the modern-c baseline; preserve lazy and multi-shot Gambit control"; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="MUTEX-SUSPENSION-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/mutex-suspension.org"; attribute :>> scope="One complete mutex decision-to-suspension cut using same cache/profile and resource limits; coupled delivery/GC/retirement architecture remains larger"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="MUTEX-SUSPENSION-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/mutex-suspension.org"; attribute :>> scope="Native SysML projects five Needs into shared ASCENT; conditional source relation and unchanged waiter-transfer boundary, no duplicate QNT/Lean proof"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="MUTEX-SUSPENSION-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/mutex-suspension.org"; attribute :>> scope="Why nonblocking need not save; why real blocking must still save; why anonymous/immediate acquisition can retain a saved root; why structural removal alone cannot establish original repair9 capacity"; }
}
