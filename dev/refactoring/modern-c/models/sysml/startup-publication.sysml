package GambitStartupPublication {
  private import ScalarValues::*;
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="startup-publication";
    attribute :>> responsibility="One resize-growth transaction: every request has an origin-owned moving root, all physical stack/heap pairs are granted before initialization, all native children are parked before membership commit, and known rollback requires every created child to be joined.";
    attribute :>> sources="include/gambit.h.in;lib/setup.c;lib/c_intf.c;lib/c_intf.h;lib/os_thread.c;lib/mem.c;lib/vm-resize.h;lib/_mem/startup-reservation.inc;lib/_mem/memory-lifecycle.inc;lib/_mem/capacity-resize.inc;lib/_mem/collection-round.inc;lib/makefile.in; component-native fixture and existing tests/makefile.in";
    attribute :>> tests="Exact configured producer and original test8; request roots across GC, nonzero origins and repeated growth; actual allocator/create/join negative histories; existing frame/map multi-shot and RC/root tests; original GSI and Make failures retained. Native, source, QNT and commit admission are separate.";
    attribute :>> retired="Incidental per-new-context stack/heap acquisition; unrooted copied sync-op thunk values; member publication before OS creation; rollback repeatedly cleaning the last setup pointer; post-create common initialization and errno inference for POSIX thread return codes.";
    attribute :>> excluded="No repair overlay, larger configured heap, longer waits, new Scheme-ready operation, W!=R arena planning, whole-copy census, shared-still retirement redesign, arbitrary foreign cancellation/nonlocal escape, whole SMP12 or repair9 acceptance, frontend optimization or CI renaming.";
  }
  attribute scope:String="Closed old-cohort startup transaction on modern-c9bb0e364. Existing source-domain RC cells, RootTask scans, msection allocator and sync collective are reused. Publication is not completion of the scheduler thunk. The existing trailing sync-loop collective joins the new set; no extra unmatched barrier is invented.";
  attribute stage:String="Candidate implementation and native qualification in the existing Modern C workspace. No new REV until five scoped gates close. Historical repair evidence locates factors, not branch acceptance. Current baseline original test8 independently exits70 with members1,target12,sections6,assigned6,max_heap0.";
  attribute formalDuty:String="Existing vm_resize_transaction.qnt owns finite reserve/initialize/create/commit/abort/unknown histories. Existing startup_custody.qnt owns the distinct publication/readiness proposition; READY changes are excluded here. Existing ContextStartupCapacity, RoundCapacity and selected ResizeSources Lean laws own conditional arithmetic, interval coverage and relocated-cell implications, not scheduling; bounded-token64 is not adopted as a C identity map. No duplicate Lean transition system or new proof of physical C intervals. Concrete allocator suffix, C publication, root reload and native outcomes must be checked against those premises.";
  attribute rootContract:String="Each caller allocates an existing RC cell before synchronization; sync_op carries its stable C cell address. GC updates the cell; coordinator reloads after GC. Each child receives a separate P0-domain borrowed cell before native creation. The VM slot retains the custody receipt across the entry synchronization and allocating marker, even while the C activation uses its cell. Only successful marker ownership or known native join permits receipt removal and root release. Catcher cleanup handles supported throws; a thread_exit bypassing that catcher leaves the receipt for the coordinator after join.";
  attribute capacityContract:String="For A assigned sections, N new contexts and existing normal overflow reserve O, section size S and fudge F, startup requires A+2N+ceil((O+4F)/S) physical sections, with checked arithmetic and finite-cap refusal. The final term follows existing prepare_mem_pstate subdivision, not a heap option. All 2N grants must be a distinct linked suffix before counters charge once. Failed native allocation may keep new free sections cached but must not publish partial grants. Collector retention of currently assigned/imminent restore ranges is separate from future startup grants.";
  attribute publicationContract:String="Initialization consumes exact granted pairs. Native creation publishes immutable thread arguments via the platform thread API. Children acquire the gate and wait before TLS, GC or Scheme entry. OP_SET_PROCESSOR_COUNT at the old collective root publishes membership and releases RUN only after every required setup/create succeeded. ABORT children return without Scheme entry. Successful joins precede cleanup/refund; unknown joins retain the owning VM's roots, ranges and metadata and prohibit reuse/reclamation.";
  attribute memoryOrder:String="Source refinement obligations: RC domain lock protects cell registration/borrow/refcount and scanner exclusion; existing collective orders old-cohort state; pthread/CreateThread publishes arguments; gate release/acquire orders RUN/ABORT and child custody. Slot writers are exclusive before create/commit. No raw Scheme pointer is inferred to be a C atomic root. Native tests cannot prove the complete C memory model or all backend synchronization implementations.";
  attribute benefit:String="Eliminate fatal incidental startup exhaustion when a valid physical grant exists, unrooted losing-request values across merged GC, premature native membership and unsafe known-failure refund. Reuse existing RC scanning and allocator rather than adding a root registry or identity map. Preserve Scheme entry, multi-shot continuation, moving-GC and portable C semantics. No timing/RSS or whole-load gain is assumed.";
  attribute cost:String="One VM sidecar pointer in SMP layout; one bounded MAX_PROCESSORS slot table, native mutex/condition and lazy allocation per resized VM. One request RC root and N child RC roots/borrows; scan N+1 cells while retained. Two physical startup sections per added context plus derived unassigned resume allowance. Retained unknown results keep real memory and may refuse that VM's GC. Exact sizeof, tests and source limitations belong to the portable receipt.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="STARTUP-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/startup-publication/receipt.json"; attribute :>> scope="Current source producer, unchanged original test8 and actual root/gate/failure histories; negative evidence and exact limits retained; no inherited repair acceptance"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="STARTUP-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/startup-publication.org"; attribute :>> scope="Explain why root custody, physical grant, initialized context, native creation and membership are distinct authorities; connect DEV transaction and lazy control design"; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="STARTUP-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/startup-publication.org"; attribute :>> scope="One complete startup growth responsibility; explicit later retirement, arenas, whole-round census, request-service/control and CFFI stages; same cache/profile"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="STARTUP-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/startup-publication.org"; attribute :>> scope="Native SysML projection into shared ASCENT, existing finite QNT and conditional Lean premises; no duplicate proof or simulation-claim laundering"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="STARTUP-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/startup-publication.org"; attribute :>> scope="Why default cap0 fails; why raw sync copies are not roots; why count does not prove a thread/ready state; why failure or unknown cannot authorize refund; how original test8 differs from repair9 capacity"; }
}
