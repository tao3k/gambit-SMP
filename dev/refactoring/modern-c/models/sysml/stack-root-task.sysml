package GambitStackRootTask {
  private import ScalarValues::*;
  ref part predecessor=GambitBankRootTask::component;
  ref part acceptanceBoundary=GambitModernCProgress::gcFfi;
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="stack-root-task";
    attribute :>> responsibility="Current participant's active stack and break-frame continuation anchor become one explicit VM-slot STACK RootOrigin and confined RootTask; preserve the original in-place frame/captured-tail scanner and multi-shot restoration";
    attribute :>> sources="lib/root.h;lib/_mem/root-tasks.inc;lib/_mem/continuation-roots.inc;lib/_mem/collection-round.inc;tests/root-task.scm";
    attribute :>> tests="Exact bootstrap/current roles/frame/map/exit/RC consumers, four native control replay/shrink families and real map multi-shot dynamic-wind histories with moving GC; existing Make target only; original failures retained";
    attribute :>> retired="Direct unclaimed mark_continuation entry in strong phase; private bank-only eligibility predicate replaced by shared root_context_executor with all callers updated, no alias";
    attribute :>> excluded="Captured heap-frame ownership algorithm, weak move_continuation, FrameSpec encoding, globals/symbol tasks/full census, independent workers/W!=R, capacity/unknown join, CFFI and whole SMP";
  }
  part priorEdge:GambitRevisionDelivery::Dependency { ref part :>> predecessor=GambitBankRootTask::component; ref part :>> successor=component; }
  part nextEdge:GambitRevisionDelivery::Dependency { ref part :>> predecessor=component; ref part :>> successor=GambitRevisionDelivery::rootDispatch; }
  attribute scope:String="Existing stopped GC invocation publishes/claims/scans/finishes one context stack after globals and before bank, with the actual nonzero admitted RC epoch. root_context_executor checks current PSTATE, active population and exact bound VM slot before payload access. No asynchronous lookup/migration or queue.";
  attribute stage:String="After39656ad6 bank task. This leaf is the stack root-entry protocol; source/native qualification and actual publication are separate records. Remaining whole-runtime gates and original failures cannot inherit patch-line numerator/12.";
  attribute formalDuty:String="Existing QNT root_dispatch exclusively owns temporal publication/claim/entry/finish/stale/unknown/drain schedules. Native SCANNED is an internal cut; at p2 RC2+BANK2+STACK2+VM1 gives seven actual tasks: unchanged two-origin QNT is a selected projection, not full census or round seal. Existing Lean RuntimeRoles exclusively owns conditional logical-cell census/partition/current-address laws. Frame cells use origin/frame-coordinate/live-slot identity, not shared referent identity or moving address. Logical frame coordinates/current physical address mapping for arbitrary reflective writers remain open; no stable runtime frame-ID table is added. Native source/ABI/stack-layout refinement remains conditional, not a new universal proof. No QNT/Lean duplication.";
  attribute memoryOrder:String="Task confined to current participant's nonreentrant C invocation under existing setup barriers/stopped collective; ordinary C sequencing suffices for the task record, not for arbitrary cross-thread source writers. No new atomic/mutex. Existing frame locks/forwarding/CAS/copy synchronization unchanged. Before reading payload require the actual outer source hold and stop/epoch premises; origin tag alone proves neither.";
  attribute lifecycle:String="Fresh unexposed record only; init must never reset unknown work. publish lease1, claim once, SCANNING before original scanner, SCANNED only on normal return, finish releases once and known repeated finish is idempotent. Unknown/partial scanner cannot requeue: original algorithm mutates links and forwarding/copy state. DONE ends entry-scan borrow only; existing context/VM/round storage hold continues through heap descendants, weak move, cleanup and restore.";
  attribute frameContract:String="Byte-exact original mark_captured_continuation/mark_frame/mark_continuation bodies and original line3667 retained. RETI/RETN descriptors/live-slot runs and in-place break anchor retained. Heap object scanner still invokes captured scanner independently; weak move and multi-shot continuation primitives unchanged. Root aliases are distinct cells even if they share the same continuation object.";
  attribute writers:String="Generated C call/return/check/stack-extension macros write fp/return/frame slots; _kernel continuation capture/copy/return and reflection/serialization rebuild captured frames. Strong frame scanner rewrites links and break anchor; heap object scanner handles captured objects; weak move restores current addresses. Existing active participant stop excludes Scheme writers, not arbitrary FFI/cross-VM mutation. This leaf does not introduce new writable frame aliases.";
  attribute pbt:String="One existing root-task.scm trace/replay/deletion shrinker: RC/VM/bank/stack control observations, plus actual map continuation-capture/continuation-return histories. Stack control child snapshots C inputs then uses empty break anchor and exits without Scheme allocation/callback/return. Semantic histories preserve full active/captured frames, shared graph identity and dynamic-wind through repeated restores and GC. Labeled stale-finish or wrong-resume-value invocation mutations calibrate shrink/replay; not runtime defect claims or exhaustive schedules.";
  attribute progress:String="Explicit stack source plus existing RC/VM/bank is not complete root census, independent WorkerArena, R-context restoration or W!=R. Global/symbol tasks, copy resource ownership, membership/failure custody, generations, raw FFI and full GSC/Gerbil/release performance remain separate successors.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="STACK-ROOT-TASK-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/stack-root-task/receipt.json"; attribute :>> scope="Exact bootstrap, required frame/multi-shot/RC/exit consumers and real native histories/shrink; original failures retained; no whole-SMP credit"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="STACK-ROOT-TASK-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/stack-root-task.org"; attribute :>> scope="Explicit stack scan ownership preserves Feeley/Gambit control semantics; root-entry task does not flatten frames or impose one-shot continuation"; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="STACK-ROOT-TASK-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/stack-root-task.org"; attribute :>> scope="One stack leaf after bank; fixed source tree/cache/profile/limits and exact five-file submission; next complete census/workers separate"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="STACK-ROOT-TASK-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/stack-root-task.org"; attribute :>> scope="Actual source/epoch/frame coordinates and scanner completion map to existing temporal and separate spatial duties; outer lifetime and unknown results explicit"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="STACK-ROOT-TASK-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/stack-root-task.org"; attribute :>> scope="Why scanner restart is unsafe; why DONE is not captured-frame lifetime; why distinct root cells cannot deduplicate referents; why this does not prove W!=R"; }
}
