  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="TI-NATIVE"; attribute :>> method="native"; attribute :>> artifact=".cache/research/legacy-evidence/evidence/refactoring/modern-c/target-integration/tests.json"; attribute :>> scope="complete source bootstrap, clean objects, dummy seed, original core and every original check prerequisite; full408 GSI test11 retains its existing300s budget and exact identity, remaining original check uses120s with only completed test11 assumed old; whole120s check timeouts stay failed; remote CI separately observed"; }
