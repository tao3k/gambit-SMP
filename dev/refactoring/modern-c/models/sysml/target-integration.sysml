  part processNeed:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="TI-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/models/sysml/revision-delivery.sysml"; attribute :>> scope="target synchronization is one independent cut; pending ABI, build, shared publication and modular CI remain separately admitted"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="TI-MODELS"; attribute :>> method="native-model-projection"; attribute :>> artifact=".cache/research/legacy-evidence/evidence/refactoring/modern-c/target-integration/model.json"; attribute :>> scope="strict native SysML, actual shared ASCENT policy and five rejection controls; no duplicate QNT/Lean"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="TI-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/target-integration.org"; attribute :>> scope="core unchanged; target tests retained; exact source identities; pending research custody; no whole-SMP claim"; }
