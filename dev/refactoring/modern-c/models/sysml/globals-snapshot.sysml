package GambitGlobalsSnapshot {
  private import ScalarValues::*;
  ref part localEntry=GambitGlobalsRootTask::component;
  ref part startup=GambitStartupPublication::component;
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="globals-snapshot";
    attribute :>> responsibility="One serialized global registration transaction and one immutable VM-round extent, borrowed by every GLOBALS RootTask through actual scan completion";
    attribute :>> sources="include/gambit.h.in;lib/root.h;lib/mem.h;lib/setup.c;lib/_mem/global-bindings.inc;lib/_mem/permanent-allocation.inc;lib/_mem/memory-lifecycle.inc;lib/_mem/root-tasks.inc;lib/_mem/collection-round.inc;tests/root-task.scm;tests/makefile.in";
    attribute :>> tests="Same exact-tree Bazel Darwin/GCC C23 producer, original GSI and Make inventory; existing p1/p2 moving global roots, frame/map multi-shot, RC and startup; new mode of existing Scheme replay/oracle/shrinker using a real second VM and production registration/snapshot/task functions";
    attribute :>> retired="Per-participant live-count authority and consumer count rechecks; independent bootstrap/runtime index assignment; unguarded registry append and shared permanent allocation cursor; unbounded creation beyond the existing glos backing";
    attribute :>> excluded="Full symbol interner, primitive-cell writers, arbitrary raw/cross-VM value stores, glos expansion/reclaim, W!=R, general native owner death, request-service control, Repair9 and complete SMP acceptance";
  }
  part priorEdge:GambitRevisionDelivery::Dependency {
    ref part :>> predecessor=GambitGlobalsRootTask::component;
    ref part :>> successor=component;
  }
  attribute scope:String="Base ff44e8f8. Modern C is mandatory. The selected Git tree and qualified persistent SDK are source authorities; the preserved dirty prototype cohort is not admitted. Scheme names, generated global setters, official build/profile/CI interfaces and multi-shot semantics remain. This is a complete registry-prefix/snapshot responsibility, not complete root-writer or SMP closure.";
  attribute stage:String="Registry-prefix and common-snapshot leaf after ff44e8f8. Qualification is in progress; no publication until all five scoped gates bind the exact tested source. Later complete root census, independent workers, request-service and retirement remain separate.";
  attribute writers:String="Bootstrap init_symkey_glo2 and runtime make_global_var are the only registry append producers. global_append assigns an index and links/increments under global_gate. Dynamic registration holds the current source RC gate through the transaction and rejects a new binding after freeze/close or without an admitted source. Exclusive bootstrap ownership precedes runtime admission. Symbol-to-node publication is release/acquire; nodes and indices remain permanent. Permanent allocation has its own short gate shared by all allocator callers. Lock order is RC -> registry -> permanent, without Scheme allocation/safepoints/callbacks/joins under these locks.";
  attribute snapshotContract:String="Coordinator captures count once after all admitted RC sources freeze, before heap flip. Existing setup-completion collective publishes snapshot storage to all participants. Every view includes snapshot identity/epoch, immutable count and roster, and floor-partition bounds. Normal scan then finish changes one shard lease to complete. The existing strong-completion collective precedes coordinator close; absent, claimed or unknown shards refuse close. Stack descriptor/VM/global lifetime is retained, never reclaimed by a local DONE. No extra collective or heap allocation is required.";
  attribute prefixLaw:String="For multiple VMs, all fixed glos cells are initialized UNB1. Registration is append-only and writes an immutable new index. Other-VM registration may extend N to N+k but does not write this frozen VM's cells; its suffix remains UNB1. Ordinary same-VM stores are excluded by the existing stopped collective. Therefore scan [0,N) covers this VM's roots at the cut, while other-VM append need not wait for the whole GC. In single-VM mode all runtime sources are frozen and bootstrap append is closed, preserving bucket topology. Raw cross-VM stores or concurrent interning are not consequences of this prefix law.";
  attribute failure:String="Capacity/admission refusal precedes allocation or mutation. Allocation failure retains the caller's symbol and leaves count/link/publication unchanged. Preserve the existing Scheme heap-exception/retry boundary; it does not implicitly run GC. A nonlocal exception handler may escape refusal; resuming at a permanently exhausted registry cannot manufacture capacity. Native setup callers retain the existing fixnum-error protocol. A lost registration result can reread the same permanent symbol/node without another index. Snapshot publication/finish are single-source/idempotent; unknown scan retains its lease and invocation. Cleanup has an outer runtime-exclusive premise and refuses retained snapshot authority; no claim of recovery from arbitrary VM/owner death.";
  attribute formalDuty:String="Reuse root_dispatch in runtime_roles.qnt for writer exclusion on each VM root origin, task lease, stale/unknown and completion histories. Other-VM registry append is not a write to a frozen VM's logical prefix: this distinction is a concrete source-refinement obligation. Existing RuntimeRoles Lean owns conditional distinct-cell census, partition and current-address laws, not scheduling. Native prefix, pointer publication, roster/caller coverage and C memory order are source/native obligations. Do not add a duplicate QNT or Lean machine. The ambient LLM reviews actual mappings; it is not a proof oracle.";
  attribute pbt:String="Existing root-task.scm typed trace, independent Scheme oracle, fresh child replay and deletion shrinker. Pre-create four permanent symbols before the destructive cut; actual setup_vmstate supplies an OPEN second VM. Actions register locally/remotely/from an unbound caller, freeze/begin, publish, claim, premature close, scan, finish and close. No Scheme allocation/callback/return after root payload clearing. Labeled live-count observation mutation must shrink and replay against actual C; it is calibration, not a claimed production defect or exhaustive native schedule exploration.";
  attribute benefit:String="One authoritative extent instead of R independently sampled extents, eliminating partition gaps/overlap caused by registry growth; fully initialized index/node is published once. Scanners still visit original moving cells and preserve Gambit's continuation semantics. No automatic scan-volume, throughput, peak-memory or whole-SMP gain is claimed.";
  attribute cost:String="Two global native mutexes, bootstrap owner metadata, one snapshot pointer per VM; one bounded coordinator descriptor and shard bytes proportional to existing MAX_PROCESSORS. R source checks plus short publication/finish registry critical sections and begin/end. Dynamic new binding uses RC/registry/permanent gates; reflective symbol-to-global reads acquire-load. No extra barrier, root-value copy, capacity/heap option increase, executor or identity table. Configured sizeof and measured qualification costs belong in the evidence matrix.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="GLOBALS-SNAPSHOT-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/globals-snapshot/receipt.json"; attribute :>> scope="Exact source producer and affected original consumers, real cross-VM prefix and moving-root observations, replay/shrink and negatives; failures retained"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="GLOBALS-SNAPSHOT-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/globals-snapshot.org"; attribute :>> scope="Distinguish immutable root extent from copied values, registry append from VM value store, source freeze from writer lookup, correctness gain from performance"; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="GLOBALS-SNAPSHOT-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/globals-snapshot.org"; attribute :>> scope="One registry-prefix and shared-snapshot leaf after ff44; later interner/raw writers/workers/control/retirement remain separate"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="GLOBALS-SNAPSHOT-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/globals-snapshot.org"; attribute :>> scope="Existing QNT temporal duties and distinct Lean cell laws; actual C prefix/ordering and tests discharge adapter obligations only"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="GLOBALS-SNAPSHOT-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/globals-snapshot.org"; attribute :>> scope="Why local count checks fail, when other VM append is safe, why locks cannot span GC, why unknown task retains authority, what remains before W/R or Repair9 acceptance"; }
}
