package GambitRcSlotWrites {
  private import ScalarValues::*;
  ref part sourceBase=GambitRcTask::component;
  ref part coverage=GambitModernCDeliveryPlan::rootWriters;
  attribute auditNumber:String="3.5.1";
  attribute parentNumber:String="3.5";
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="rc-slot-writes";
    attribute :>> responsibility="One RC domain gate arbitrates logical slot writes against all live stable-cell borrows; frozen RootTask scanning retains its distinct authority to relocate the payload";
    attribute :>> sources="lib/_mem/rc-allocation.inc;lib/rc.h;tests/rc-root-origin.scm;tests/root-task.scm;tests/makefile.in";
    attribute :>> tests="Same-cache complete C23 producer and original consumers; nonzero processor RC ownership/borrow-last/native references; existing real C history replay/shrinker extended with RC writer histories and exact predecessor function control";
    attribute :>> retired="Mutator replacement or clearing of a logically borrowed RC root, including when native references remain positive; unnecessary same-value stores through the shared slot";
    attribute :>> excluded="No new root pin table, loan token, namespace, API/ABI or runtime field; no GC prohibition during borrows, deep object freeze, scheduler fix, arbitrary owner death recovery, raw data_rc borrower migration or complete3.5/3.6 census";
  }
  attribute scope:String="Base86fdffcc; one complete RC logical-slot write authority, not all root writers. Existing setup callers install thunks before borrowing, reload via cell across marker allocation and release after handoff. Public setters delegate to this one private gate; native refcount operations do not rebind the root. RC initial FAL is unpublished; mark_array owns physical GC relocation.";
  attribute stage:String="QUALIFYING3.5.1; ROOT-WRITERS remains OPEN after this leaf. Four of six root groups scoped-closed, two open; thirteen-item programme and independent twelve-family SMP audit unchanged. Thread-interrupt failure stays explicitly unresolved.";
  attribute contract:String="Under the existing domain mutex: require current owner, OPEN source and positive native reference. If any root borrow exists, reject a different SCMOBJ; an identical SCMOBJ succeeds without a store. The collector may update the cell only through the frozen claimed RC RootTask with its scan lease. Borrowers reload after allocating/GC-capable calls and retain ordinary Scheme payload mutability. Native reference zero plus borrow keeps the cell alive; last return may free it. No timeout creates ownership.";
  attribute memoryOrder:String="Existing RC mutex acquire/release serializes loan count, phase and logical store. Borrow prevents header reclamation, not GC movement. GC physical writes still require whole-round participation/freeze and claimed scan lease; this leaf neither proves all foreign readers participate nor makes naked cell reads generally concurrent-safe. No extra fence, lock, polling or GC wait is introduced.";
  attribute formalDuty:String="Existing QNT root_dispatch owns competing freeze/claim/scan/finish and lifecycle histories. Existing Lean owns distinct conditional cell coverage/address laws. This cut supplies a concrete source premise: a live borrowed cell cannot change logical referent through admitted mutator writes. ASCENT checks actual source/caller dispositions, physical relocation and no-store effect separation, native predecessor calibration and publication gates. No duplicate QNT/Lean machine or universal proof from finite PBT.";
  attribute benefit:String="Remove two conflicting mutator authorities over a borrowed logical root and avoid same-value physical stores. Thunk/source identity survives across GC-capable marker construction without pinning objects or restricting multi-shot continuation. Concrete new test calibration: predecessor admits a forbidden replacement; current rejects it, with real replay/shrink and live-borrow GC. No measured throughput or peak-memory reduction claim.";
  attribute cost:String="One borrow-count predicate and object comparison in the existing locked setter; identical values skip the old store. Zero new fields, bytes of retained runtime metadata, locks, allocation sites or namespace. Added test workload and stricter private logical-borrow contract; a future legitimate retargeter must return every loan before rebinding. Unknown outstanding loans retain custody and may prevent cleanup, not root scanning.";
  part def Writer { attribute id:String; attribute source:String; attribute effect:String; attribute disposition:String; }
  part setter:Writer { attribute :>> id="setter"; attribute :>> source="lib/_mem/rc-allocation.inc:___try_set_data_rc/___set_data_rc"; attribute :>> effect="logical-rebind"; attribute :>> disposition="domain-gated"; }
  part initialize:Writer { attribute :>> id="initialize"; attribute :>> source="lib/_mem/rc-allocation.inc:___alloc_rc_no_register"; attribute :>> effect="initial-FAL"; attribute :>> disposition="before-publication"; }
  part collector:Writer { attribute :>> id="collector"; attribute :>> source="lib/_mem/rc-roots.inc:mark_rc"; attribute :>> effect="physical-relocation"; attribute :>> disposition="frozen-claimed-scan-lease"; }
  part startup:Writer { attribute :>> id="startup"; attribute :>> source="lib/setup.c:resize prepare/current_vm_resize/run_startup_root"; attribute :>> effect="thunk-install-and-cell-borrow"; attribute :>> disposition="set-before-borrow-reload-before-release"; }
  part closure:Writer { attribute :>> id="closure"; attribute :>> source="lib/os_dyn.c:___make_c_closure"; attribute :>> effect="procedure-install"; attribute :>> disposition="set-before-exposure"; }
  part tcl:Writer { attribute :>> id="tcl"; attribute :>> source="examples/tcltk/command.h:scheme_create_cmd;examples/tcltk/tcltk.scm:generated caller"; attribute :>> effect="command-vector-install"; attribute :>> disposition="private-construction-root-before-allocation-and-returned-ownership;raw-callback-readers-open"; }
  part snapshots:Writer { attribute :>> id="snapshots"; attribute :>> source="lib/c_intf.c:C-closure;examples/tcltk/command.h:callback/delete"; attribute :>> effect="snapshot-read"; attribute :>> disposition="separate-open-borrow-migration"; }
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="RC-SLOT-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/rc-slot-writes/receipt.json"; attribute :>> scope="Exact source/profile producer, original manifests, moving borrowed cell, nonzero processor ownership, real C predecessor replay and deletion shrinking"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="RC-SLOT-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/rc-slot-writes.org"; attribute :>> scope="Separate logical write authority from collector address repair; stable native cell is not a pinned Scheme object or deep freeze"; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="RC-SLOT-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/rc-slot-writes.org"; attribute :>> scope="Independent3.5.1, source-selected five paths only;13-item and SMP12 audits separate, root parent remains open"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="RC-SLOT-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/rc-slot-writes.org"; attribute :>> scope="Native SysML/actual ASCENT source-effect refinement and rejection controls; unchanged QNT and Lean responsibilities"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="RC-SLOT-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/rc-slot-writes.org"; attribute :>> scope="Why real callers fit, why GC remains legal, what old writer retires, what cost and unknown loan remain, why original scheduler failure does not become a root-write fix"; }
}
