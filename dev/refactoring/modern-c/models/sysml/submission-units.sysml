package GambitSubmissionUnits {
  private import ScalarValues::*;
  attribute scope:String="Enforce complete integration submission in the existing RevisionSubmission and shared ASCENT policy; support corrections have zero architecture progress and exact non-runtime paths. This mechanism does not implement runtime lifecycle result3.";
  attribute stage:String="Framework support only; main integration2/4 and independent SMP1/12 unchanged. Next runtime target is the complete owned-lifetime contract, never a helper/setter count.";
  attribute formalDuty:String="Native SysML owns submission kinds, four results and their predecessor obligations. ASCENT combines unit coverage with all five gates. Python checks actual Git paths and exact durable receipt identities. Existing QNT temporal and Lean arithmetic duties are unchanged; no duplicate proof added. Raw Git and the truth of reviewed receipts remain explicit external boundaries.";
  attribute graph:String="sysml -> projection -> custody -> unit; unit -> ascent; gates -> ascent; ascent -> commit; unit -> complete; unit -> support; complete -> one_result; support -> zero_progress; raw_git -> external_boundary;";
  part submission:GambitCommitGates::SubmissionUnit {
    attribute :>> testModules="tests/test_revision_submission.py;tests/test_revision_comment_policy.py;tests/test_modern_c_outcomes.py";
    attribute :>> kind="support"; attribute :>> result=""; attribute :>> progressDelta=0;
    attribute :>> supportPaths="src/gambit_smp/revision_submission.py;tests/test_revision_submission.py;tests/test_revision_comment_policy.py;tests/test_modern_c_outcomes.py;dev/modeling/ascent/commit-admission.rules.scm;dev/modeling/models/sysml/commit-gates.sysml;dev/refactoring/modern-c/models/sysml/submission-units.sysml;dev/refactoring/modern-c/models/sysml/owned-lifetime.sysml;dev/refactoring/modern-c/delivery-contract.org;dev/refactoring/modern-c/diagrams/submission-units.d2;dev/refactoring/modern-c/diagrams/owned-lifetime.d2;evidence/research/retained/modern-c/submission-consumers/receipt.json;evidence/research/retained/modern-c/submission-consumers/source-review.json";
  }
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part tests:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="UNIT-TESTS"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/submission-consumers/receipt.json"; attribute :>> scope="Actual framework Git and native ASCENT controls, real native SysML projections and unchanged outcome-policy tests. These tests do not qualify Gambit runtime or third-result code."; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="UNIT-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/delivery-contract.org"; attribute :>> scope="Close the gap between resultClosed and commitReady; audit completeness alone never closes an ownership replacement."; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="UNIT-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/delivery-contract.org"; attribute :>> scope="One complete result, explicit predecessor regression and source/native cases; support progress0. The third runtime delivery remains open until every obligation closes."; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="UNIT-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="evidence/research/retained/modern-c/submission-consumers/source-review.json"; attribute :>> scope="Real SysML projects the programme obligation closure, not a Python duplicate list. ASCENT must reject missing unit, missing current/predecessor/component evidence, stale identities and support promotion."; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="UNIT-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/delivery-contract.org"; attribute :>> scope="Why did five gates allow leaves? What is now executable? What can receipts and raw Git bypass? Why does framework support not close Gambit lifecycle?"; }
}
