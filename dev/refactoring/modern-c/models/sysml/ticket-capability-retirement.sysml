part claim1:ClaimRow { attribute :>> key="generic"; attribute :>> mechanism="Functional keyed ledger and handle map in Lean"; attribute :>> condition="Lookup/update are faithful and equality is full-key equality"; attribute :>> result="Other-key noninterference, idempotence and terminal outcome retention hold for arbitrary keys"; attribute :>> gap="Hash collision, parser/payload coding and current C source refinement unproved"; }
part claim2:ClaimRow { attribute :>> key="projection"; attribute :>> mechanism="Concrete commit/query AST to generic per-key record"; attribute :>> condition="Typed AST binds same ticket fields and fixed abstract payload"; attribute :>> result="Commit/query correspondence and other-slot noninterference proved where stated"; attribute :>> gap="Does not establish arbitrary real Scheme value encoding or all-model simulation"; }
part claim3:ClaimRow { attribute :>> key="multi-shot"; attribute :>> mechanism="True continuation invocation reserves a fresh ticket"; attribute :>> condition="Stable external gateway covers no-winding and all restore paths"; attribute :>> result="Retaining CaptureId supports multiple invocations without ticket reuse"; attribute :>> gap="Current source has no complete gateway insertion/caller census"; }
part claim4:ClaimRow { attribute :>> key="cap-retirement"; attribute :>> mechanism="Close managed admission before census; keep root until scan cut"; attribute :>> condition="No raw escape and all exact handles/borrows/accepted attempts accounted"; attribute :>> result="Authority closure and physical root retirement are distinct states"; attribute :>> gap="Generic Scheme last-reference retirement remains unresolved"; }
part claim5:ClaimRow { attribute :>> key="ack-loss"; attribute :>> mechanism="Outcome commits before reply; record survives observation loss"; attribute :>> condition="Single surviving owner/ledger instance; no blind retry"; attribute :>> result="Same TicketId query returns original outcome"; attribute :>> gap="Crash recovery/durable exactly-once external effects not proved"; }
part claim6:ClaimRow { attribute :>> key="semantics"; attribute :>> mechanism="Raw/unknown escape keeps optimization unavailable"; attribute :>> condition="No forced single-shot conversion or global ban on Scheme restoration"; attribute :>> result="Safe fallback can preserve original continuation behavior"; attribute :>> gap="Actual fallback and full second-normalization equivalence still open"; }
