part issuer1:IssuerRow { attribute :>> key="settlement"; attribute :>> proposedIssuer="Ledger linearization owner"; attribute :>> actualSource="No existing TicketId ledger identified in inspected executor paths"; attribute :>> status="Model assumes trusted executor witness bound to this key and payload"; attribute :>> responsibility="Atomically retain terminal outcome and ownership result before reply"; }
part issuer2:IssuerRow { attribute :>> key="query"; attribute :>> proposedIssuer="Same ledger owner with record/read lease"; attribute :>> actualSource="No existing keyed query service in inspected paths"; attribute :>> status="Required service boundary; timeout caller is not an absence issuer"; attribute :>> responsibility="Answer pending/completed/conflict without replaying execution"; }
part issuer3:IssuerRow { attribute :>> key="fresh-attempt"; attribute :>> proposedIssuer="Runtime restore gateway before no-winding/graft/thread restoration"; attribute :>> actualSource="Same-dynwind fast path directly restores; Scheme before hook not complete"; attribute :>> status="GVM/native contract insertion points still require a complete inventory"; attribute :>> responsibility="Mint ID outside capture; duplicate delivery keeps the existing ID"; }
