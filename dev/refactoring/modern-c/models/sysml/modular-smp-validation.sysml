package GambitModularSmpValidation {
  private import ScalarValues::*;
  part writerAuthorization:SharedContract {
    attribute :>> id="write-authority";
    attribute :>> source="vendor/gambit/lib/write_authority.c";
    attribute :>> anchor="___write_authority_try_handoff";
    attribute :>> invariant="One generation-bound packed word couples admission and live/spent writer roles. Transfer requires closed and drained and installs both owner permits atomically. Shared C controls compile the actual implementation; the Scheme caller fingerprints private headers, memory modules and component sources with exact-path batched hashes";
    attribute :>> open="A permit is not a root, VM-lifetime lease or physical-stop receipt; full generated and foreign writer wiring remains a RootWorkerExit source obligation";
  }
  part writerCoverage:Coverage {
    ref part :>> lane=c3; ref part :>> contract=writerAuthorization;
    attribute :>> scope="Current write-authority C control body, shared GC kernel and actual module linking; no whole writer-closure or shutdown admission";
  }
  ref part orderedWord:GambitOrderedSynchronization::Responsibility=GambitOrderedSynchronization::word;
  ref part stopPublication:GambitOrderedSynchronization::Responsibility=GambitOrderedSynchronization::stop;
  ref part mailboxProtocol:GambitMailboxPublication::Responsibility=GambitMailboxPublication::queue;
  ref part mailboxRootTransfer:GambitMailboxPublication::Responsibility=GambitMailboxPublication::roots;
  attribute sourceLock:String=".cache/research/legacy-evidence/evidence/research/ordered-sync/initialization/source.lock.json";
  attribute profile:String="evidence/fixtures/gerbil-bazel-build-profile/profile.json";
  attribute runner:String="macos-15";
  attribute testPolicy:String="Official units and stress through existing runner/Make are baseline. Source review consolidates20 pending SCM into8 candidate controls. Native execution of each changed scenario remains required before its implementation REV; source retention does not imply acceptance.";
  attribute reviewEvidence:String=".cache/research/legacy-evidence/evidence/refactoring/modern-c/test-review/model.json";
  attribute workItemBoundary:String="Test necessity/consolidation and published-tree CI verification only. Native exploratory results retain their exact source identities; no new whole-SMP repair objective follows from a failing official test. The tfib crash is parked with no runtime fix or suppressing check. Future GC/control work must be selected by DEV architecture and scoped five-gate admission, not by chasing every test failure in one REV.";
  attribute currentNativeEvidence:String=".cache/research/legacy-evidence/evidence/refactoring/modern-c/test-review/runtime-tests.json";
  attribute currentNativeBoundary:String="Current117-path ABI cohort completed two-pass bootstrap and8 candidate C compilations with10 executions, including W<R owner cleanup, loan/refill, unknown join isolation and original mailbox witnesses. All408 original GSI units and map/frame consumers passed on that cohort. Existing source-refinement, physical packing, writer closure, supported-toolchain and submission gates remain independent. Original Make/GSC/stress qualification is separately recorded; do not infer whole SMP or remote pending-tree success.";
  attribute toolBoundary:String="Existing configure/Make and the environment own compiler and OS tools. No per-case tool catalog or hash/process wrapper remains in vendor. Historical runner tool metadata belongs to its retained receipt only.";
  attribute workflow:String="vendor/gambit/.github/workflows/smp.yml";
  attribute ownership:String="Gambit owns official runner/Make and minimal component controls; suite/catalog/campaign are withdrawn. SMP owns research/source identity and SysML/ASCENT/formal links; old suite receipts are historical only.";
  attribute proofOwnership:String="Existing CS-SCHEDULE QNT owns ordering and permit histories; CS-COHERENCE Lean owns issued-view algebra. Source adapters and native observations do not duplicate either theorem.";
  attribute bootstrapContract:String="Existing source bootstrap remains <=600 seconds. Original CI core commands stay intact. New SMP workflow reuses configure/Make and official runner without suite/catalog/campaign; definition alone supplies no native admission.";
  attribute failureCustody:String="Unknown or failed origins retain roots and native resources; missing native observations remain open. CI definitions are not remote CI acceptance.";
  part def Lane { attribute id:String; attribute namespace:String; attribute name:String; attribute kind:String; attribute program:String; attribute stdout:String; attribute topology:String; attribute budget:Integer; }
  part callbackExit:Lane { attribute :>> id="gambit.smp.control.callback.nonlocal-exit"; attribute :>> namespace="gambit.smp.control.callback"; attribute :>> name="nonlocal-exit"; attribute :>> kind="scheme"; attribute :>> program="vendor/gambit/tests/sfun-exit.scm"; attribute :>> stdout="CALLBACK-EXIT-PASS direct nested normal gc dynamic-wind\n"; attribute :>> topology="host-managed"; attribute :>> budget=90; }
  part vmLifecycle:Lane { attribute :>> id="gambit.smp.gc.vm-lifecycle.custody"; attribute :>> namespace="gambit.smp.gc.vm-lifecycle"; attribute :>> name="custody"; attribute :>> kind="scheme"; attribute :>> program="vendor/gambit/tests/smp/gc/vm-lifecycle.scm"; attribute :>> stdout="VM-LIFECYCLE-PASS registry owner roots retained-release no-replay healthy-gc\n"; attribute :>> topology="fixture-managed"; attribute :>> budget=90; }
  part vmGlobalReclaim:Lane { attribute :>> id="gambit.smp.gc.vm-lifecycle.global-reclaim"; attribute :>> namespace="gambit.smp.gc.vm-lifecycle"; attribute :>> name="global-reclaim"; attribute :>> kind="scheme-host"; attribute :>> program="vendor/gambit/tests/smp/gc/vm-lifecycle-host.scm"; attribute :>> stdout="VM-GLOBAL-RECLAIM-PASS secondary-ack global-permit duplicate-refusal\n"; attribute :>> topology="fixture-managed"; attribute :>> budget=90; }
  part c3:Lane { attribute :>> id="gambit.smp.gc.root-task.publication-claim-arena"; attribute :>> namespace="gambit.smp.gc.root-task"; attribute :>> name="publication-claim-arena"; attribute :>> kind="kernel"; attribute :>> program="vendor/gambit/tests/gc-root-task.c"; attribute :>> stdout="PUBLICATION-PASS\nCLAIM-RACE-PASS\nCOPY-AUTHORITY-PASS\nARENA-PASS\nARENA-HANDOFF-PASS\nROOT-DOMAIN-RESUME-PASS\nNATIVE-RUN-ABI-PASS\nwrite-authority controls passed\n"; attribute :>> topology=""; attribute :>> budget=180; }
