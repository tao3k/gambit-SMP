  part mailboxIdentity:Lane { attribute :>> id="gambit.smp.scheduler.mailbox.concurrent-first-publishers"; attribute :>> namespace="gambit.smp.scheduler.mailbox"; attribute :>> name="concurrent-first-publishers"; attribute :>> kind="scheme"; attribute :>> program="vendor/gambit/tests/smp/scheduler/mailbox-identity.scm"; attribute :>> stdout="MAILBOX-IDENTITY-PASS publishers=8 messages=64 shared-aliases\n"; attribute :>> topology="host-managed"; attribute :>> budget=90; }
  part orderedKernel:Lane { attribute :>> id="gambit.smp.sync.ordered.word-ticket-slot"; attribute :>> namespace="gambit.smp.sync.ordered"; attribute :>> name="word-ticket-slot"; attribute :>> kind="kernel"; attribute :>> program="vendor/gambit/tests/ordered-sync.c"; attribute :>> stdout="ORDERED-SYNC-PASS locks=16384 slots=16384 trylock=2 wrap=1\nORDERED-SYNC-LAYOUT word=64 slot=32 prior-pair=32\n"; attribute :>> topology=""; attribute :>> budget=180; }
  part mailboxStop:Lane { attribute :>> id="gambit.smp.gc.stop.mailbox-epoch-handoff"; attribute :>> namespace="gambit.smp.gc.stop"; attribute :>> name="mailbox-epoch-handoff"; attribute :>> kind="scheme"; attribute :>> program="vendor/gambit/tests/smp/gc/mailbox-epoch-handoff.scm"; attribute :>> stdout="MAILBOX-EPOCH-HANDOFF-PASS workers=4 messages=128\n"; attribute :>> topology="host-managed"; attribute :>> budget=90; }
  part def SharedContract { attribute id:String; attribute source:String; attribute anchor:String; attribute invariant:String; attribute open:String; }
  part sourcePartition:SharedContract { attribute :>> id="source-partition"; attribute :>> source="vendor/gambit/lib/mem.c"; attribute :>> anchor="memory/configuration.inc"; attribute :>> invariant="Original preamble and all payload intervals reconstruct exactly; explicit fragment end markers preserve blank bytes and pass strict patch admission; Make owns the complete include dependency inventory"; attribute :>> open="One translation unit remains; no parallel compilation or reduced macro expansion is established"; }
  part rootAuthority:SharedContract { attribute :>> id="root-authority"; attribute :>> source="vendor/gambit/lib/_mem/root-origins.inc"; attribute :>> anchor="mark_execution_roots"; attribute :>> invariant="Existing collective physically freezes complete origins; epoch and incarnation publish before READY; one owner-bearing CAS grants repair authority; DONE does not alone authorize whole-round resume"; attribute :>> open="Foreign writer admission, unknown-owner stop, reader grace and full carrier retirement remain canonical RootWorkerExit obligations"; }
  part frameRoots:SharedContract { attribute :>> id="frame-roots"; attribute :>> source="vendor/gambit/lib/_mem/continuation-roots.inc"; attribute :>> anchor="mark_captured_continuation_locked"; attribute :>> invariant="Frame descriptors identify ordinary roots separately from structural links; frame access serializes capture/link repair; full multi-shot restoration preserves shared aliases and Scheme dynamic-wind"; attribute :>> open="Existing CS-SCHEDULE QNT and CS-COHERENCE Lean are reused; general C root-map, writer and FFI refinement is not replaced by finite native fixtures"; }
  part arenaReservation:SharedContract { attribute :>> id="arena-reservation"; attribute :>> source="vendor/gambit/lib/_mem/copy-reservations.inc"; attribute :>> anchor="reserve_copy"; attribute :>> invariant="Actual contiguous worker interval is reserved before forwarding; exact unpublished reservation alone may refund; visible forwarding retains initialization and Tail responsibility"; attribute :>> open="Current WorkerArena and W/R source evidence is owned by RootWorkerExit; full physical packing, arbitrary unknown CAS outcomes and whole round-capacity proof remain open"; }
  part sharedScheduler:SharedContract { attribute :>> id="shared-scheduler"; attribute :>> source="vendor/gambit/lib/_thread.scm"; attribute :>> anchor="thread-send"; attribute :>> invariant="GambitMailboxPublication owns source refinement: one mailbox identity, detached rooted node, one permit for FIFO/cursor; scanner uses physical writer stop and unique scan authority without taking the mailbox permit. Original shared values and multi-shot roots remain"; attribute :>> open="Unknown native writers, arbitrary owner death and all original SMP acceptance families remain separate from message/GC controls"; }
  part orderedContract:SharedContract { attribute :>> id="ordered-synchronization"; attribute :>> source="vendor/gambit/include/gambit.h.in"; attribute :>> anchor="___SYNC_SLOT_ACK"; attribute :>> invariant="GambitOrderedSynchronization owns atomic ticket handoff and fixed-slot collective publication: payload-before-READY, copy-before-ACK, acquire before consumption/reuse, and physical GC stop distinct from fences"; attribute :>> open="Finite kernel/native controls do not prove every weak-memory history. Debug history, unqualified platforms and unknown-owner membership remain open"; }
  part def Coverage { ref part lane:Lane; ref part contract:SharedContract; attribute scope:String; }
  part orderedCoverage:Coverage { ref part :>> lane=orderedKernel; ref part :>> contract=orderedContract; attribute :>> scope="Actual ordered ticket and SPSC slot macros, finite races, wrap and fixed native layout"; }
  part stopCoverage:Coverage { ref part :>> lane=mailboxStop; ref part :>> contract=orderedContract; attribute :>> scope="Real built-in mailbox, four blocked senders, whole collective GCs and original shared identities"; }
