  attribute profile:String="evidence/fixtures/gerbil-bazel-build-profile/profile.json";
  attribute runner:String="macos-15";
  attribute hashToolVariable:String="GAMBIT_SMP_SHASUM";
  part def ToolDependency {
    attribute id:String; attribute variable:String; attribute command:String;
