  part c10:Lane { attribute :>> id="gambit.smp.control.dynamic-wind.multishot-gc"; attribute :>> namespace="gambit.smp.control.dynamic-wind"; attribute :>> name="multishot-gc"; attribute :>> kind="scheme"; attribute :>> program="vendor/gambit/tests/frame-continuation.scm"; attribute :>> stdout="FRAME-CONTINUATION-PASS\nHASH-INDEX-OWNER-PASS\n"; attribute :>> topology="host-managed"; attribute :>> budget=90; }
  part dependencies:Lane { attribute :>> id="gambit.smp.memory.modules.make-invalidation"; attribute :>> namespace="gambit.smp.memory.modules"; attribute :>> name="make-invalidation"; attribute :>> kind="make"; attribute :>> program="vendor/gambit/lib/makefile.in"; attribute :>> stdout="MEMORY-DEPENDENCIES-PASS fragments=25\n"; attribute :>> topology=""; attribute :>> budget=60; }
