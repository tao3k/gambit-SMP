  part mailboxIdentityCoverage:Coverage { ref part :>> lane=mailboxIdentity; ref part :>> contract=sharedScheduler; attribute :>> scope="Concurrent first publishers,64 messages and original shared alias identity"; }
  part h11:Coverage { ref part :>> lane=c10; ref part :>> contract=frameRoots; attribute :>> scope="Three shots, two restorations, winding order and GC"; }
