  part c10:Lane { attribute :>> id="gambit.smp.control.dynamic-wind.multishot-gc"; attribute :>> namespace="gambit.smp.control.dynamic-wind"; attribute :>> name="multishot-gc"; attribute :>> kind="scheme"; attribute :>> program="vendor/gambit/tests/smp/control/dynamic-wind-multishot.scm"; attribute :>> stdout="WIND-RESUME-GC-PASS shots=3\n"; attribute :>> topology="host-managed"; attribute :>> budget=90; }
