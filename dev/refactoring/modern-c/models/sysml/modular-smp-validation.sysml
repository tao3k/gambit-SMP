  part c7:Lane { attribute :>> id="gambit.smp.gc.frame-roots.host-processors"; attribute :>> namespace="gambit.smp.gc.frame-roots"; attribute :>> name="host-processors"; attribute :>> kind="scheme"; attribute :>> program="vendor/gambit/tests/frame-continuation-roots.scm"; attribute :>> stdout="FRAME-CONTINUATION-ROOTS-PASS\nFORCED-GC-COMPLETE count=11\n"; attribute :>> topology="host-managed"; attribute :>> budget=90; }
