  part vmLifecycle:Lane { attribute :>> id="gambit.smp.gc.vm-lifecycle.custody"; attribute :>> namespace="gambit.smp.gc.vm-lifecycle"; attribute :>> name="custody"; attribute :>> kind="scheme"; attribute :>> program="vendor/gambit/tests/smp/gc/vm-lifecycle.scm"; attribute :>> stdout="VM-LIFECYCLE-PASS registry owner roots retained-release no-replay healthy-gc\n"; attribute :>> topology="fixture-managed"; attribute :>> budget=90; }
  part vmGlobalReclaim:Lane { attribute :>> id="gambit.smp.gc.vm-lifecycle.global-reclaim"; attribute :>> namespace="gambit.smp.gc.vm-lifecycle"; attribute :>> name="global-reclaim"; attribute :>> kind="scheme-host"; attribute :>> program="vendor/gambit/tests/smp/gc/vm-lifecycle-host.scm"; attribute :>> stdout="VM-GLOBAL-RECLAIM-PASS secondary-ack global-permit duplicate-refusal\n"; attribute :>> topology="fixture-managed"; attribute :>> budget=90; }
