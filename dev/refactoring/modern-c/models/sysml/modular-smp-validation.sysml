  attribute hashToolContract:String="Caller supplies an existing absolute executable path with the shasum -a 256 -- interface. Freeze it before hashing; record selected path and tool SHA. Missing/invalid input refuses rather than falling back to a fixed system binary; batch validation retains exact paths and all before/after file checks";
  attribute workflow:String="vendor/gambit/.github/workflows/smp.yml";
  attribute ownership:String="Gambit owns independent native CI and fixtures. SMP owns SysML, ASCENT, QNT/Lean links, Org, D2 and evidence; no parent-repository runtime dependency.";
  attribute proofOwnership:String="Existing CS-SCHEDULE QNT owns ordering and permit histories; CS-COHERENCE Lean owns issued-view algebra. Source adapters and native observations do not duplicate either theorem.";
  attribute bootstrapContract:String="One exact-source two-pass bootstrap, original 600-second wall budget; no heap increase, patch import or timeout extension. CI runs modules against its single bootstrapped checkout; local research may use an authenticated existing producer without making a cold-CI claim.";
  attribute failureCustody:String="Unknown or failed origins retain roots and native resources; missing native observations remain open. CI definitions are not remote CI acceptance.";
  part def Lane { attribute id:String; attribute namespace:String; attribute name:String; attribute kind:String; attribute program:String; attribute stdout:String; attribute topology:String; attribute budget:Integer; }
