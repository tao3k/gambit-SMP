package GambitModularSmpValidation {
  private import ScalarValues::*;
  part writerAuthorization:SharedContract {
    attribute :>> id="write-authority";
    attribute :>> source="vendor/gambit/lib/write_authority.c";
    attribute :>> anchor="___write_authority_try_handoff";
    attribute :>> invariant="One generation-bound packed word couples admission and live/spent writer roles. Transfer requires closed and drained and installs both owner permits atomically. Shared C controls compile the actual implementation; the Scheme caller fingerprints private headers, memory modules and component sources with exact-path batched hashes";
    attribute :>> open="A permit is not a root, VM-lifetime lease or physical-stop receipt; full generated and foreign writer wiring remains a RootWorkerExit source obligation";
  }
  part writerCoverage:Coverage {
    ref part :>> lane=c3; ref part :>> contract=writerAuthorization;
    attribute :>> scope="Current write-authority C control body, shared GC kernel and actual module linking; no whole writer-closure or shutdown admission";
  }
  ref part orderedWord:GambitOrderedSynchronization::Responsibility=GambitOrderedSynchronization::word;
  ref part stopPublication:GambitOrderedSynchronization::Responsibility=GambitOrderedSynchronization::stop;
  ref part mailboxProtocol:GambitMailboxPublication::Responsibility=GambitMailboxPublication::queue;
