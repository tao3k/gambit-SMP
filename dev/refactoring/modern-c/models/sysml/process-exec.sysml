package GambitProcessExec {
  private import ScalarValues::*;
  ref part platform=GambitRevisionDelivery::darwinDiagnostics;
  ref part distribution=GambitRevisionDelivery::generatedProducts;
  attribute auditNumber:String="12.2.1";
  attribute requiredCases:String="source-order;parent-preparation;child-only-guard;same-pid;high-fd-closed;parent-fd-retained;all-bytes;closed-stdio;cloexec-stdio;cwd-preserved;env-preserved;exec-failure;default-bootstrap;default-core;default-gsi;default-make;smp-bootstrap;smp-gsi;smp-make;unchanged-histories";
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="process-exec";
    attribute :>> responsibility="Replace Darwin explicit-path post-chdir/environment child descriptor closure with kernel SETEXEC/CLOEXEC_DEFAULT, retaining the existing forked PID, signal/affinity cleanup, error pipe and parent registration";
    attribute :>> sources="lib/os_io.c;tests/root-task.scm;tests/makefile.in;existing RC/mutex fixture mode admission";
    attribute :>> tests="Same Modern C workspace, existing default workflow mode and existing SMP Bazel profile. Complete source producers and original GSI/Make budgets. Actual existing root-task replay/shrink plus descriptor-above-FD_SETSIZE, parent ownership, exact512 bytes, PID, closed/CLOEXEC stdin, cwd and failed exec controls";
    attribute :>> retired="For the admitted Darwin operation, child issuing close syscalls for every integer up to configured OPEN_MAX before exec; fresh-process isolation and all native executions remain";
    attribute :>> excluded="No fd-limit reduction, sample/action/GC removal, extra PBT concurrency, cached native execution, new launcher/profile, public namespace, workflow/golden rename, Scheme frontend optimization or whole-SMP credit";
  }
  attribute scope:String="Basee6a80bcb; independent platform support leaf12.2.1, not RC/worker/FFI completion. Five handwritten files only. Default generated distribution remains a separate attached12.3 publication; no handwritten generated C.";
  attribute stage:String="PUBLISHED81d3acc0: five selected handwritten files; complete default and SMP consumers under fixed budgets. Exact proof and source/native case snapshots are frozen in process-exec/publication.json. Platform support12.2.1 only, no root/worker/whole-SMP completion.";
  attribute formalDuty:String="SysML owns exact operation admission, lifetime/rollback/observable obligations and five commit gates. Reuse the maintained generic source/native concordance ASCENT fragment and shared commit rules; bind source, mode and actual cases; missing whole consumers block publication. Existing QNT keeps root/worker competing histories and Lean keeps independent conditional laws; neither is copied or rerun for this retained fork/publication protocol. Source and actual native tests refine the Darwin syscall boundary.";
  attribute childContract:String="Prepare/destroy spawn metadata only in parent. Existing fork, signal cleanup, affinity reset, fd relocation/redirection and error-pipe CLOEXEC happen first. In the single-threaded child require all three stdio descriptors open and not CLOEXEC. After the unchanged child chdir/environment handling, for explicit paths try SETEXEC plus kernel default closure, with stdio self-dup actions. Successful SETEXEC never returns and retains PID; failure falls through the original close/exec/error pipe. No second child or retry with an unknown created child.";
  attribute refusal:String="Missing Apple flags, failed metadata preparation, non-explicit PATH lookup, PTY, closed or CLOEXEC stdio retain the original branch. PTY setup remains before the child attempt and is not claimed qualified by pipe tests. No source claim is a proof of arbitrary foreign fd interference or every historical Apple kernel.";
  part def Step { attribute order:Integer; attribute anchor:String; attribute obligation:String; attribute custodian:String; attribute anchorChoice:String; }
  part prepare:Step { attribute :>> order=1; attribute :>> anchor="posix_spawnattr_init"; attribute :>> obligation="parent-preparation"; attribute :>> custodian="parent; opaque native allocations; no Scheme GC"; attribute :>> anchorChoice="first"; }
  part forkChild:Step { attribute :>> order=2; attribute :>> anchor="fork ()"; attribute :>> obligation="same-pid"; attribute :>> custodian="kernel child identity; parent still owns its metadata"; attribute :>> anchorChoice="first"; }
  part cleanupSignals:Step { attribute :>> order=3; attribute :>> anchor="___cleanup_all_interrupt_handling ();"; attribute :>> obligation="source-order"; attribute :>> custodian="private child; existing signal and affinity cleanup"; attribute :>> anchorChoice="first"; }
  part relocate:Step { attribute :>> order=4; attribute :>> anchor="___move_fds_to_non_std (fds, 6, 0)"; attribute :>> obligation="high-fd-closed"; attribute :>> custodian="private child owns redirected pipe descriptors"; attribute :>> anchorChoice="first"; }
  part guardStdio:Step { attribute :>> order=5; attribute :>> anchor="int flags = fcntl (fd, F_GETFD)"; attribute :>> obligation="child-only-guard"; attribute :>> custodian="private child; no concurrent parent fd-table mutation"; attribute :>> anchorChoice="first"; }
  part applyCwd:Step { attribute :>> order=6; attribute :>> anchor="chdir_long_path (dir)"; attribute :>> obligation="cwd-preserved"; attribute :>> custodian="private child; original cwd failure sentinel retained"; attribute :>> anchorChoice="first"; }
  part applyEnvironment:Step { attribute :>> order=7; attribute :>> anchor="environ = env"; attribute :>> obligation="env-preserved"; attribute :>> custodian="private child; existing native environment buffer"; attribute :>> anchorChoice="first"; }
  part replaceImage:Step { attribute :>> order=8; attribute :>> anchor="posix_spawn (NULL"; attribute :>> obligation="all-bytes"; attribute :>> custodian="same child PID; success consumes old child image, not parent metadata"; attribute :>> anchorChoice="first"; }
  part fallbackExec:Step { attribute :>> order=9; attribute :>> anchor="execvp (argv[0], argv)"; attribute :>> obligation="exec-failure"; attribute :>> custodian="private child retains original close/exec/errno path on returned failure"; attribute :>> anchorChoice="first"; }
  part publishDevice:Step { attribute :>> order=10; attribute :>> anchor="___device_process_setup_from_pid"; attribute :>> obligation="same-pid"; attribute :>> custodian="parent; error-pipe EOF permits device registration, not proof of successful program completion"; attribute :>> anchorChoice="last"; }
  part releaseParent:Step { attribute :>> order=11; attribute :>> anchor="posix_spawn_file_actions_destroy"; attribute :>> obligation="parent-preparation"; attribute :>> custodian="parent metadata released on returned paths after the original publication protocol"; attribute :>> anchorChoice="last"; }
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="PROCESS-EXEC-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/process-exec/receipt.json"; attribute :>> scope="Complete default/SMP producers and original consumers plus actual descriptor/byte/PID/refusal checks; fixed600/300/120 budgets and original PBT histories/replay/shrink"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="PROCESS-EXEC-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/process-exec.org"; attribute :>> scope="Measured process creation, not inferred GC/macro cost; kernel descriptor ownership closure eliminates work proportional to fd limit"; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="PROCESS-EXEC-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/process-exec.org"; attribute :>> scope="One platform responsibility; source-selected commit then attached generated cohort, preserving residual prototypes and independent13-item/SMP12 ledgers"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="PROCESS-EXEC-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/process-exec.org"; attribute :>> scope="Native SysML and real ASCENT operation/case concordance; no duplicate QNT/Lean histories/laws or model-to-native promotion"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="PROCESS-EXEC-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/process-exec.org"; attribute :>> scope="Why creation dominates, which fd set closes, same PID/signals/error custody, closed stdio/cwd/refusal, known failure versus unknown outcome, actual costs and unqualified cells"; }
}
