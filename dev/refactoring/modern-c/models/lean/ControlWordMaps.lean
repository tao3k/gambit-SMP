def Invariant (q : State) : Prop := ((q.wordWins≥(0)) ∧ (q.wordWins≤(3)) ∧ ((q.n_decision≤(1)) → (q.wordWins=(q.n_claims+q.n_done))) ∧ ((q.n_decision≥(2)) → (q.wordWins=((q.n_claims+q.n_done)+(1)))) ∧ (q.word=(q.n_decision+((4)*q.n_done))) ∧ (q.word≥(0)) ∧ (q.word≤(7)) ∧ (q.sExpected≥(0)) ∧ (q.sExpected≤(7)) ∧ (q.sMode≥(0)) ∧ (q.sMode≤(3)) ∧ (q.cExpected≥(0)) ∧ (q.cExpected≤(7)) ∧ (q.cMode≥(0)) ∧ (q.cMode≤(2)) ∧ (q.preparedResult≥(0)) ∧ (q.preparedResult≤(1)) ∧ (q.commitRelease≥(0)) ∧ (q.commitRelease≤(1)) ∧ (q.resultRelease=q.n_done) ∧ (q.aSeen≥(0)) ∧ (q.aSeen≤(1)) ∧ (q.aWord≥(0)) ∧ (q.aWord≤(7)) ∧ (q.activationWord≥(0)) ∧ (q.activationWord≤(2)) ∧ (q.activeRelease=q.active) ∧ (q.carriedCommit=q.activeRelease) ∧ (q.workerSeen≥(0)) ∧ (q.workerSeen≤(1)) ∧ (q.resultSeen≥(0)) ∧ (q.resultSeen≤(1)) ∧ (q.casFailures≥(0)) ∧ ((q.commitRelease=(1)) → (q.n_decision=(2))) ∧ ((q.n_decision=(2)) → (q.commitRelease=(1))) ∧ ((q.aSeen=(1)) → ((q.commitRelease=(1)) ∧ ((q.aWord=(2)) ∨ (q.aWord=(6))))) ∧ ((q.active=(1)) → ((q.aSeen=(1)) ∧ (q.activationWord≥(1)))) ∧ ((q.activationWord≥(1)) → (q.active=(1))) ∧ ((q.activationWord=(1)) → (q.p_phase=(4))) ∧ ((q.activationWord=(2)) → ((q.p_phase=(5)) ∨ (q.p_phase=(7)))) ∧ (((q.p_phase=(5)) ∨ (q.p_phase=(7))) → (q.activationWord=(2))) ∧ ((q.workerSeen=(1)) → ((q.activeRelease=(1)) ∧ (q.carriedCommit=(1)))) ∧ ((q.activationWord=(2)) → (q.workerSeen=(1))) ∧ ((q.resultSeen=(1)) → (q.resultRelease=(1))) ∧ ((q.n_remoteGrants=(1)) → ((q.resultSeen=(1)) ∧ (q.workerSeen=(1)))))
theorem safeEquivalent (q : State) : Safe q ↔ FrameActivationAst.Safe (parent q) ∧ Invariant q := by rfl
theorem nativeBounds (q : State) (h : Safe q) : 0≤q.n_decision ∧ q.n_decision≤3 ∧ 0≤q.n_done ∧ q.n_done≤1 ∧ 0≤q.n_claims ∧ q.n_claims≤1 := by
