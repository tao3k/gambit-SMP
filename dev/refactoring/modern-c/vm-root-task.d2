direction: right
roster: "Existing GC collective\nexecute_sync_op / setup barriers\nVM storage + stopped mutators retained"
origin: "RootOrigin\nkind VM + explicit VM pointer\ncoordinator/VM match checked"
publish: "Fresh confined C record\nround epoch -> READY + lease1\nno new allocation / queue"
scan: "Shared claim states\nactual mark_vm_scmobj(source)\nmark_array(VM_SIZE) -> SCANNED"
done: "Shared finish\nDONE + lease0\nno VM release / round resume"
round: "Existing strong/weak/copy/cleanup\nVM lifetime and resume authority\nunchanged"
rc: "Existing RC domain\nsame tagged origin/task record\nsource mutex retained"
pbt: "One existing Scheme/Make driver\nRC + VM structured replay/shrink\nseparate real moving VM payload"
models: "Native SysML -> ASCENT\nexisting QNT temporal model\nunchanged Lean cell/address duties"
roster -> origin -> publish -> scan -> done -> round
rc -> scan: "shared claim/finish, source-specific exclusion"
models -> pbt -> scan
