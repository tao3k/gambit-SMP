direction: right
source: "Committed Scheme\nOwned symbol/keyword identity vectors"
workflow: "Existing CI C flags\nNo new profile or Core command"
producer: "One generated C cohort\nComplete source bootstrap"
consumer: "Original core → original test10\nOwned identities, not bucket count"
smp: "Same SMP SDK\nVerified artifacts/config/helpers saved"
restore: "Restore same SDK\nVerify bytes, timestamps and consumers"
source -> producer
workflow -> producer
producer -> consumer: "Exact source/mode/output"
smp -> producer: "Artifact handoff; no source clone"
consumer -> restore
restore -> smp
stale: "Old shipped C\nRaw bucket vector with count header"
stale -> consumer: "Rejected representation"

fixtures: "Existing RC / bank / mutex fixtures\nSame assertions and history counts"
default: "Single context\nNo affinity choice; public mutex entry"
parallel: "SMP p2\nOwner 0/1 and forced private slow path"
fixtures -> default: "Exact capability admission"
fixtures -> parallel: "Architecture acceptance retained"
default -> consumer
parallel -> restore

gate: "HOLD: original Make timed out120s\nFocused pass cannot replace full gate"
consumer -> gate: "Actual incomplete prerequisite group"
gate -> restore: "Preserve failure and restore SMP mode"
