direction: right
phase1: "phase1 returned success"
phase2: "phase2 returned success"
phase3: "phase3 returned success"
phase4: "phase4 returned success"
stop: "Any child returned failure\nstop · retain diagnostics · no success grant"
identity: "Then qualify source/tool/output identities\nand original consumers"
phase1 -> phase2: "zero only"
phase2 -> phase3: "zero only"
phase3 -> phase4: "zero only"
phase4 -> identity: "necessary, not sufficient"
phase1 -> stop: "failure"
phase2 -> stop: "failure"
phase3 -> stop: "failure"
phase4 -> stop: "failure"
