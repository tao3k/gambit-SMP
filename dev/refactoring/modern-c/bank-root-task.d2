direction: right
cohort: "Existing stopped GC cohort\nsetup barriers -> continuation scan\nVM-slot/context lifetime retained"
origin: "BANK RootOrigin\ncurrent participant + active VM slot\nexact source context pointer"
publish: "Shared fresh init/publication\nRC round epoch -> READY / lease1\nconfined C record"
claim: "Existing shared claim\nkind / executor / epoch\nduplicate or stale entry refused"
scan: "Bank source scan\nr -> saved -> type_cache -> processor\noriginal disjoint ranges/bodies"
finish: "SCANNED only on actual return\nshared finish -> DONE / lease0\nnot stack/round completion"
hold: "Existing VM storage / round hold\nheap descendants + weak/copy/cleanup\nno async handle or requeue"
tests: "One native Scheme/Make driver\nRC / VM / BANK replay + shrink\np2 moving cells owners0/1"
models: "Native SysML -> ASCENT\nexisting QNT temporal projection\nunchanged Lean cell/address laws"
excluded: "pc / fp / hp / padding\nnot bank Scheme roots\nstack task remains separate"
cohort -> origin -> publish -> claim -> scan -> finish -> hold
scan -> excluded: "never flatten context"
models -> tests -> scan
