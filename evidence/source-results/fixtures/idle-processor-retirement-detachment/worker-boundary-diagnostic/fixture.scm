;; Diagnostic only: additional output can perturb the scheduler and GC.
;; The unchanged resize_still_reuse.scm remains the acceptance fixture.
(define population (##current-vm-processor-count))
(if (< population 2) (error "requires parallel processors"))
(define victim (- population 1))
(define objects (make-vector population #f))
(##thread-pin! (current-thread) (##processor 0))
(define (resize! count)
  (##cvmr count)
  (if (not (= count (##current-vm-processor-count))) (error "reuse membership")))
(define (expected epoch) (vector epoch (make-vector 64 epoch)))
(define (boundary epoch stage)
  (display (list 'reuse-boundary epoch stage (##current-vm-processor-count)))
  (newline)
  (force-output))
(do ((epoch 0 (+ epoch 1))) ((= epoch population))
  (boundary epoch 'grow-enter)
  (resize! population)
  (boundary epoch 'grow-return)
  (let ((worker
         (make-thread
          (lambda ()
            (boundary epoch 'worker-enter)
            (let ((copy (##still-copy (expected epoch))))
              (boundary epoch 'still-copy-return)
              (vector (##current-processor-id) copy))))))
    (##thread-pin! worker (##processor victim))
    (thread-start! worker)
    (boundary epoch 'worker-start-return)
    (let ((result (thread-join! worker)))
      (if (not (= victim (vector-ref result 0))) (error "reuse allocation processor"))
      (vector-set! objects epoch (vector-ref result 1))))
  (boundary epoch 'worker-joined)
  (resize! victim)
  (boundary epoch 'shrink-return)
  (##gc)
  (boundary epoch 'gc-return)
  (do ((i 0 (+ i 1))) ((> i epoch))
    (if (not (equal? (vector-ref objects i) (expected i)))
        (error "still object lost across slot reuse" epoch i))))
(display "NATIVE-OK:resize_still_reuse_worker_boundaries\n")
