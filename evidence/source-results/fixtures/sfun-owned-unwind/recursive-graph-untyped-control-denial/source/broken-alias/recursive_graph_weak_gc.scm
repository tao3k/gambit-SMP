;; One strong root per worker retains a cyclic graph and its weak-table keys.
(define population (##current-vm-processor-count))
(define nodes 1024)
(define rounds 3)
(if (< population 2) (error "recursive GC requires parallel processors"))

(define (make-graph worker)
  (let ((building (make-vector nodes))
        (weak (make-table test: eq? weak-keys: #t init: 'missing)))
    (do ((i 0 (+ i 1))) ((= i nodes))
      (vector-set! building i (vector worker i #f #f #f (list worker i))))
    (do ((i 0 (+ i 1))) ((= i nodes))
      (let* ((node (vector-ref building i))
             (next (vector-ref building (modulo (+ i 1) nodes)))
             (cross (vector-ref building (modulo (+ (* i 17) 3) nodes))))
        (vector-set! node 2 next)
        (vector-set! node 3 cross)
        (vector-set! node 4 cross)
        (table-set! weak node i)))
    ;; The construction index is not retained by the returned roots.
    (cons (vector-ref building 0) weak)))

(define (verify-graph graph worker)
  (let ((root (car graph)) (weak (cdr graph)))
    (let loop ((node root) (i 0) (checks 0))
      (if (= i nodes)
          (if (eq? node root) (+ checks 1) (error "cycle root changed" worker))
          (let ((next (vector-ref node 2)) (cross (vector-ref node 3)))
            (if (not (and (= (vector-ref node 0) worker)
                          (= (vector-ref node 1) i)
                          (= (vector-ref next 1) (modulo (+ i 1) nodes))
                          (eq? next (vector-ref node 4))
                          (= (vector-ref cross 1) (modulo (+ (* i 17) 3) nodes))
                          (= (table-ref weak node) i)
                          (equal? (vector-ref node 5) (list worker i))))
                (error "recursive graph/weak key changed" worker i))
            (loop next (+ i 1) (+ checks 7)))))))

(define (worker id)
  (let ((graph (make-graph id)))
    (let loop ((round 0) (checks (verify-graph graph id)))
      (if (= round rounds)
          (vector id checks)
          (begin
            (thread-yield!)
            (##gc)
            (loop (+ round 1) (+ checks (verify-graph graph id))))))))

(define threads
  (let loop ((id 0) (result '()))
    (if (= id population)
        (reverse result)
        (let ((thread (make-thread (lambda () (worker id)))))
          (thread-start! thread)
          (loop (+ id 1) (cons thread result))))))
(define results (map thread-join! threads))
(define expected (* (+ rounds 1) (+ (* nodes 7) 1)))
(let loop ((rows results) (id 0))
  (if (pair? rows)
      (begin
        (if (not (equal? (car rows) (vector id expected)))
            (error "worker/result inventory changed" id (car rows)))
        (loop (cdr rows) (+ id 1)))
      (if (not (= id population)) (error "missing recursive worker"))))
(display "RECURSIVE-GC:processors=") (display population)
(display ",nodes=") (display nodes)
(display ",forced=") (display (* population rounds))
(display ",checks=") (display (* population expected)) (newline)
(display "NATIVE-OK:recursive_graph_weak_gc\n")
