;;; Syntactic evidence is not execution, dominance, alias closure or speedup.
(define-evidence (make-darwin-source-chain)
  (sources ast_source ast_function ast_call ast_keyword reference source_binding required_call
           component obligation required_receipt observed_receipt
           run_engine engine_source recorded_product dispatch_binding execution_edge)
  (outputs source_current matched_call missing_call unresolved_call unclosed
           used_source recorded_phase observed_call clue factor link inventory)
  (relation ast_source ((path string?) (digest string?)))
  (relation ast_function ((path string?) (owner string?) (start integer?) (end integer?)))
  (relation ast_call ((path string?) (owner string?) (site string?) (target string?) (resolution string?) (line integer?)))
  (relation ast_keyword ((site string?) (keyword string?) (expression string?)))
  (relation reference ((id string?) (path string?) (digest string?)))
  (relation source_binding ((path string?) (snapshot string?) (checkout string?)))
  (relation required_call ((id string?) (path string?) (owner string?) (target string?)))
  (relation component ((id string?) (sysml string?)))
  (relation obligation ((id string?) (component string?) (claim string?)))
  (relation required_receipt ((id string?) (stage string?)))
  ;; observed_receipt is supplied only by a bound terminal receipt importer.
  ;; No producer currently supplies package results to this static view.
  (relation observed_receipt ((id string?) (stage string?) (digest string?)))
  (relation run_engine ((run string?) (engine string?)))
  (relation engine_source ((engine string?) (path string?) (digest string?)))
  (relation recorded_product ((run string?) (stage string?) (receipt string?) (inputs string?)))
  (relation dispatch_binding ((id string?) (path string?) (callee string?)))
  (relation execution_edge ((run string?) (caller string?) (callee string?) (caller_digest string?)
                            (callee_digest string?) (stage string?) (receipt string?)))
  (relation observed_call (id run stage receipt))
  (relation used_source (run path digest))
  (relation recorded_phase (run stage receipt inputs))
  (relation source_current (path digest))
  (relation matched_call (id site digest))
  (relation missing_call (id))
  (relation unresolved_call (owner site target))
  (relation unclosed (id reason))
  (relation clue (id digest claim polarity role source))
  (relation factor (id digest name value))
  (relation link (claim target label id digest))
  (relation inventory (name value))
  ((source_current P D) <-- (ast_source P D) (source_binding P S L)
    (reference S P D) (reference L P D))
  ((used_source R P D) <-- (run_engine R E) (engine_source E P D) (source_current P D))
  ;; This does not imply compiler readiness, reusable bytes or package success.
  ((recorded_phase R Stage Receipt Inputs) <-- (recorded_product R Stage Receipt Inputs)
    (run_engine R E) (engine_source E (lit "src/gambit_smp/gerbil_build/bazel_build.py") _))
  ((observed_call I R Stage Receipt) <-- (required_call I P Owner _)
    (dispatch_binding I CalleePath Callee)
    (execution_edge R Owner Callee CallerDigest CalleeDigest Stage Receipt)
    (used_source R P CallerDigest) (used_source R CalleePath CalleeDigest))
  ((matched_call I Site D) <-- (required_call I P Owner Target)
    (ast_call P Owner Site Target (lit "lexical") _) (source_current P D))
  ((missing_call I) <-- (required_call I _ _ _) (not (matched_call I _ _)))
  ((unresolved_call Owner Site Target) <-- (ast_call _ Owner Site Target (lit "unresolved") _))
  ((unclosed I (lit "missing-or-drifted-syntactic-edge")) <-- (missing_call I))
  ((unclosed I Stage) <-- (required_receipt I Stage) (not (observed_receipt I Stage _)))
  ((clue I D Claim (lit "support") (lit "observation") P) <--
    (matched_call I _ D) (required_call I P _ _) (obligation I _ Claim))
  ((clue I D (lit "darwin-call-resolution-not-established") (lit "counter") (lit "observation") P) <--
    (missing_call I) (required_call I P _ _) (source_current P D))
  ((factor I D (lit "evidence-kind") (lit "lexical-syntax-only")) <-- (matched_call I _ D))
  ((factor I D (lit "scope") (lit "darwin-acceleration")) <--
    (required_call I P _ _) (source_current P D))
  ((factor I D (lit "unclosed") Reason) <-- (unclosed I Reason)
    (required_call I P _ _) (source_current P D))
  ((factor I D (lit "sysml") Sysml) <-- (matched_call I _ D)
    (obligation I C _) (component C Sysml))
  ((factor I D (lit "limit") (lit "syntax-only-not-control-flow-or-runtime-proof")) <-- (matched_call I _ D))
  ((link Claim Sysml (lit "specified-by") I D) <-- (matched_call I _ D)
    (obligation I C Claim) (component C Sysml))
  ((inventory (lit "scope") (lit "darwin-acceleration")) <-- (obligation _ _ _)))
