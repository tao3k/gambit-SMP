;;; Design evidence supports scoped questions, not collector rankings.
(define-evidence (make-gc-design-reasons)
  (sources candidate expected_flag flag flag_binding design requirement support objection cost source)
  (outputs why why_not unknown tradeoff missing_flag actions)
  (explain (lambda (program result query scope)
    (hash ("status" "recorded-only") ("dependencies" (.ref program 'rules))
      ("gap" "Scoped evidence is not source correctness, performance, adoption or execution authority; missing is not refuted"))))
  (relation candidate ((id string?) (identity string?)))
  (relation expected_flag ((name string?)))
  (relation flag ((candidate string?) (name string?)))
  (relation flag_binding ((candidate string?) (configuration string?) (execution string?)))
  (relation design ((id string?) (mechanism string?)))
  (relation requirement ((design string?) (id string?) (phase string?) (description string?)))
  (relation support ((design string?) (requirement string?) (source string?) (scope string?) (reason string?)))
  (relation objection ((design string?) (requirement string?) (source string?) (scope string?) (reason string?)))
  (relation cost ((design string?) (metric string?) (source string?) (prediction string?)))
  (relation source ((id string?) (path string?) (sha string?)))
  (relation why (design requirement scope reason path sha))
  (relation why_not (design requirement scope reason path sha))
  (relation unknown (candidate identity design requirement phase description))
  (relation tradeoff (design metric prediction path sha))
  (relation bound_support (design requirement))
  (relation missing_flag (candidate flag))
  (relation verified_flag (candidate flag))
  (relation actions (id query reason))
  ((bound_support D R) <-- (support D R S Scope Reason) (source S _ _))
  ((why D R Scope Reason Path H) <-- (design D _) (requirement D R _ _)
    (support D R S Scope Reason) (source S Path H))
  ((why_not D R Scope Reason Path H) <-- (design D _) (requirement D R _ _)
    (objection D R S Scope Reason) (source S Path H))
  ;; A literature rationale or finite control never discharges Gambit requirements.
  ((unknown C I D R P Text) <-- (candidate C I) (design D _)
    (requirement D R P Text) (not (bound_support D R)))
  ((tradeoff D M Prediction Path H) <-- (design D _) (cost D M S Prediction) (source S Path H))
  ((verified_flag C F) <-- (flag C F) (flag_binding C Config Run)
    (source Config _ _) (source Run _ _))
  ((missing_flag C F) <-- (candidate C I) (expected_flag F) (not (verified_flag C F)))
  ((actions (lit "inspect-design-support") (lit "why")
    (lit "Inspect scoped reasons, not architecture superiority")) <-- (why _ _ _ _ _ _))
  ((actions (lit "inspect-design-objections") (lit "why_not")
    (lit "Inspect bounded counterexamples; not a native incident attribution")) <-- (why_not _ _ _ _ _ _))
  ((actions (lit "inspect-design-premises") (lit "unknown")
    (lit "Missing premises are unknown, not refutations or authorizations")) <-- (unknown _ _ _ _ _ _))
  ((actions (lit "inspect-design-costs") (lit "tradeoff")
    (lit "Predicted costs require same-input runtime measurement")) <-- (tradeoff _ _ _ _ _)))
