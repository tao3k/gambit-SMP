;;; This review selects missing proof work; it never authorizes execution.
(define-evidence (make-failure-premise-review)
  (sources candidate failure premise changed checked model_support model_checked source_refined)
  (outputs missing_premise unresolved covered retry_denied retry_reviewable actions)
  (explain (lambda (program result query scope)
    (hash ("status" "review-only") ("dependencies" (.ref program 'rules))
      ("gap" "Reviewable means declared prerequisites are present, not native correctness or execution authorization"))))
  (relation candidate ((id string?) (source_identity string?)))
  (relation failure ((candidate string?) (failure_identity string?)))
  (relation premise ((failure_identity string?) (requirement string?)))
  (relation changed ((candidate string?) (requirement string?) (change_identity string?)))
  (relation checked ((candidate string?) (requirement string?) (review_identity string?)))
  (relation model_support ((candidate string?) (requirement string?) (model_identity string?)))
  (relation model_checked ((model_identity string?) (result_identity string?)))
  (relation source_refined ((candidate string?) (requirement string?) (refinement_identity string?)))
  (relation missing_premise (candidate failure_identity))
  (relation unresolved (candidate failure_identity requirement))
  (relation covered (candidate failure_identity requirement))
  (relation retry_denied (candidate failure_identity))
  (relation retry_reviewable (candidate failure_identity))
  (relation actions (id query reason))
  ((covered C F P) <-- (candidate C S) (failure C F) (premise F P)
    (changed C P D) (checked C P R) (model_support C P M)
    (model_checked M V) (source_refined C P I))
  ((missing_premise C F) <-- (candidate C S) (failure C F) (not (premise F _)))
  ((unresolved C F P) <-- (candidate C S) (failure C F) (premise F P) (not (covered C F P)))
  ((retry_denied C F) <-- (missing_premise C F))
  ((retry_denied C F) <-- (unresolved C F P))
  ((retry_reviewable C F) <-- (candidate C S) (failure C F) (not (retry_denied C F)))
  ((actions (expr (P) (string-append "refine:" P)) (lit "unresolved")
    (lit "Establish source change, review, checked model support and source correspondence before considering a repeat")) <-- (unresolved C F P))
  ((actions (lit "classify-failure-premises") (lit "missing")
    (lit "Missing failure classification is not evidence that a repeated run is safe or useful")) <-- (missing_premise C F)))
