;;; Experiments expose obligations; they do not grant runtime execution.
(define-evidence (make-concurrent-gc-review)
  (sources candidate flag expected_flag obligation model source evidence measurement metric source_anchor)
  (outputs missing_flag configured open model_context observed missing_metric source_gap actions)
  (explain (lambda (program result query scope)
    (hash ("status" "recorded-only") ("dependencies" (.ref program 'rules))
      ("gap" "Finite relocation models are not Gambit source refinement, C memory-model proof, native acceptance, measured performance or execution authorization"))))
  (relation candidate ((id string?) (identity string?)))
  (relation flag ((candidate string?) (name string?)))
  (relation expected_flag ((name string?)))
  (relation obligation ((id string?) (phase string?) (description string?)))
  (relation model ((obligation string?) (path string?) (source_id string?)))
  (relation source ((id string?) (path string?) (sha string?) (scope string?)))
  (relation evidence ((obligation string?) (outcome string?) (receipt string?)))
  (relation measurement ((candidate string?) (metric string?) (receipt string?)))
  (relation metric ((name string?)))
  (relation source_anchor ((obligation string?) (source_id string?)
    (start exact-integer?) (end exact-integer?) (requirement string?)))
  (relation missing_flag (candidate name))
  (relation configured (candidate identity))
  (relation open (candidate obligation phase description))
  (relation model_context (obligation path sha))
  (relation observed (obligation outcome receipt))
  (relation missing_metric (candidate metric))
  (relation actions (id query reason))
  (relation source_gap (obligation path sha start end requirement))
  ((missing_flag C F) <-- (candidate C I) (expected_flag F) (not (flag C F)))
  ((configured C I) <-- (candidate C I) (not (missing_flag C _)))
  ;; Observations deliberately cannot close source/native obligations.
  ((open C O P D) <-- (candidate C I) (obligation O P D))
  ((model_context O Path H) <-- (model O Path S) (source S Path H _))
  ((observed O Outcome R) <-- (obligation O _ _) (evidence O Outcome R))
  ((source_gap O Path H Start End Requirement) <--
    (source_anchor O S Start End Requirement) (source S Path H _))
  ((missing_metric C M) <-- (candidate C I) (metric M) (not (measurement C M _)))
  ((actions (expr (O) (string-append "inspect:" O)) (lit "open") D) <-- (open C O P D))
  ((actions (lit "inspect-three-flags") (lit "missing_flag")
    (lit "Inspect exact configured flags; no native acceptance")) <-- (candidate C I))
  ((actions (lit "inspect-model-context") (lit "model_context")
    (lit "Inspect two-round and publication assumptions; no source proof")) <-- (model_context _ _ _))
  ((actions (lit "inspect-source-refinement") (lit "source_gap")
    (lit "Inspect exact source anchors and missing protocol correspondence")) <-- (source_gap _ _ _ _ _ _))
  ((actions (lit "inspect-matched-performance") (lit "missing_metric")
    (lit "Require same-input paired pauses, throughput, CPU, RSS and FFI latency")) <-- (missing_metric C M)))
