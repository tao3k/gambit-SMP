    "rationale": [
      ["ticket-codegen-audit", "compiler-transformation", "The recorded diagnostic uses GCC -O2 -S; inspecting transformations requires the same source/options, not Clang IR substituted for GCC.", "codegen"],
      ["ticket-codegen-audit", "instruction-order", "The original assembly records a volatile poll without a post-wait acquire; inspect the exact successor image rather than assuming reservation ordering covers ownership.", "codegen"],
      ["ticket-codegen-audit", "object-layout", "Exact object format, symbols and relocations must be checked before mapping diagnostic instructions onto a runtime image.", "codegen"],
      ["ticket-codegen-audit", "address-origin", "The complete stress report retains a failure and explicitly lacks a proven per-test incident association; obtain a matching address/image mapping without inventing common causality.", "stress"],
      ["ticket-codegen-audit", "debug-integrity", "Source mapping depends on matching debug information; a compiler-generated assembly listing alone does not supply runtime DWARF.", "codegen"],
      ["ticket-codegen-audit", "runtime-ownership", "Shared ticket acquire did not close compiled stress; ownership, lifetime and failure context remain competing investigations.", "stress"],
      ["ticket-codegen-audit", "weak-memory", "Instruction ordering observations and abstract QNT handoff do not establish full C/AArch64 memory semantics; a mapped litmus can discriminate the ordering hypothesis only.", "codegen"]
