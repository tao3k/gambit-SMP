    "rationale": [
      [
        "stack-push-statement",
        "compiler-transformation",
        "The statement-terminated ___PUSH uses a GCC memory barrier before the store. Whether GCC sinks or fuses that store is a transformation question about this lock, not the archived ticket assembly.",
        "review"
      ],
      [
        "stack-push-statement",
        "instruction-order",
        "The poll-kind failure was an stp of 0x20 from fp 24 bytes above the floor. The next image must be this lock's object, and an instruction listing is not header-integrity proof.",
        "review"
      ],
      [
        "stack-push-statement",
        "runtime-ownership",
        "A stopped Mach-O image can show fp and alloc_stack_limit. It does not admit the runtime or retire the TFIB and interrupt2 barriers.",
        "candidate"
      ]
    ],
    "tool": [
      [
        "gcc-dumps",
        "Reproduce exact GCC options and inspect GIMPLE/RTL for moved or eliminated accesses",
        "Diagnostic compilation is not the original runtime and does not prove race freedom",
        "policy"
      ],
      [
        "clang-ir",
        "Inspect Clang-generated IR and optimization remarks for this Clang build",
        "Do not substitute LLVM IR from a different compiler for GCC evidence",
        "policy"
      ],
      [
        "gnu-objdump",
        "Inspect the exact symbol range for ownership poll, protected accesses and fences",
        "Installed BFD target support must be checked; an instruction is not synchronization proof",
        "policy"
      ],
      [
        "gnu-readelf",
        "Inspect ELF sections, symbols and relocations",
        "ELF only; not a Mach-O inspection route",
        "policy"
      ],
      [
        "llvm-objdump",
        "Inspect exact-image AArch64 instructions, including GCC-produced objects",
        "No full protocol, lifetime or performance proof",
        "policy"
      ],
      [
        "llvm-readobj",
        "Inspect Mach-O headers, symbols and relocations",
        "Object structure does not establish runtime selection or ownership",
        "policy"
      ],
      [
        "llvm-symbolizer",
        "Resolve exact-image addresses and inline source frames",
        "Requires address normalization/load slide; mapping is not cause",
        "policy"
      ],
      [
        "gnu-addr2line",
        "Resolve addresses using matching GNU-supported ELF debug information",
        "Not a generic Mach-O path; mapping is not cause",
        "policy"
      ],
      [
        "llvm-dwarfdump",
        "Verify the matching DWARF information before relying on mappings",
        "Valid DWARF does not prove runtime correctness",
        "policy"
      ],
      [
        "gdb",
        "Inspect actual threads, registers, watched writes or a recorded core",
        "Target support/permission required; stopped snapshots perturb scheduling and do not prove liveness",
        "policy"
      ],
      [
        "lldb",
        "Inspect exact Mach-O image threads, registers, watched writes and object memory",
        "Permission/target support required; observation is not a fairness or cause proof",
        "policy"
      ],
      [
        "herd7-aarch64",
        "Check whether the bad handoff/publication outcome is allowed by the bound AArch64 litmus/model",
        "Not repair, whole-source refinement, lifetime, hardware execution or performance evidence",
        "policy"
      ],
      [
        "herd7-c",
        "Check a separate C-level litmus with explicit atomic/data-race assumptions",
        "Cannot silently replace legacy volatile accesses with race-free atomic semantics",
        "policy"
      ]
    ],
