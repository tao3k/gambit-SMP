;;; Project reviewed records into the Library's shared Clue relations.
(define-evidence (make-stack-entry-clues)
  (sources observation attribute edge reference)
  (outputs clue factor link inventory)
  (relation observation ((id string?) (claim string?) (polarity string?) (source string?)))
  (relation attribute ((id string?) (name string?) (value string?)))
  (relation edge ((id string?) (target string?) (label string?)))
  (relation reference ((id string?) (path string?) (digest string?)))
  (relation clue (id digest claim polarity role source))
  (relation factor (id digest name value))
  (relation link (claim target label id digest))
  (relation inventory (name value))
  ((clue I D C P (lit "observation") Path) <--
    (observation I C P S) (reference S Path D))
  ((factor I D N V) <-- (clue I D _ _ _ _) (attribute I N V))
  ((link C Target Label I D) <-- (clue I D C _ _ _) (edge I Target Label))
  ((inventory N V) <-- (factor _ _ N V)))

;;; This application's optional policy; all factors must match one witness.
(define-evidence (make-stack-entry-navigation)
  (sources clue factor binding)
  (outputs question matched unknown_binding conjunction_gap
           unbound_scope available_factor available_value nearby_observation)
  (relation clue ((id string?) (digest string?) (claim string?)
                  (polarity string?) (role string?) (source string?)))
  (relation factor ((id string?) (digest string?) (name string?) (value string?)))
  (relation binding ((name string?) (value string?)))
  (relation witnessed (id digest name value))
  (relation missing (id digest name value))
  (relation matched (claim id digest role))
  (relation question ((claim string?)))
  (relation has_binding (name))
  (relation has_match (name value))
  (relation unknown_binding (name value))
  (relation matched_binding (name value))
  (relation conjunction_gap (name value))
  (relation known_factor (name))
  (relation anchor_match ())
  (relation association_gap ())
  (relation unbound_scope ())
  (relation available_factor (name))
  (relation available_value (name value))
  (relation nearby_observation (claim id digest name value))
  ((has_binding N) <-- (binding N _))
  ((witnessed I D N V) <-- (binding N V) (factor I D N V))
  ((missing I D N V) <-- (clue I D _ _ _ _) (binding N V)
    (not (witnessed I D N V)))
  ((matched C I D Role) <-- (has_binding _) (clue I D C _ Role _)
    (not (missing I D _ _)))
  ((question C) <-- (matched C _ _ _))
  ((has_match N V) <-- (binding N V) (clue I D _ _ _ _) (factor I D N V))
  ((unknown_binding N V) <-- (binding N V) (not (has_match N V)))
  ((matched_binding N V) <-- (matched _ I D _) (binding N V) (factor I D N V))
  ((conjunction_gap N V) <-- (has_match N V) (not (matched_binding N V)))
  ;; Discovery witnesses do not relax the requested conjunction or select work.
  ((known_factor N) <-- (clue I D _ _ _ _) (factor I D N _))
  ((anchor_match) <-- (witnessed _ _ _ _))
  ((association_gap) <-- (unknown_binding _ _))
  ((association_gap) <-- (conjunction_gap _ _))
  ((unbound_scope) <-- (not (has_binding _)))
  ((association_gap) <-- (unbound_scope))
  ((available_factor N) <-- (association_gap) (known_factor N))
  ((available_value N V) <-- (unknown_binding N _) (not (anchor_match))
    (clue I D _ _ _ _) (factor I D N V))
  ((available_value N V) <-- (unknown_binding N _) (witnessed I D _ _)
    (clue I D _ _ _ _) (factor I D N V))
  ((nearby_observation C I D N V) <-- (association_gap)
    (witnessed I D _ _) (clue I D C _ _ _) (factor I D N V)))
