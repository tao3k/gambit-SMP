;;; -*- Gerbil -*-
;;; Native campaign observation policy, independent of execution admission.
(def (make-campaign)
 (make-recorded-module
  (ascent-fragment
           (relation CampaignIdentity ((campaign symbol?) (recipe symbol?) (engine symbol?)
                                      (receipt symbol?) (candidate symbol?) (mode symbol?) (regime symbol?)))
           (relation CampaignStatus ((campaign symbol?) (status symbol?)))
           (relation RetryDecision ((campaign symbol?) (decision symbol?)))
           (relation KnownSelected ((campaign symbol?) (failure symbol?)))
           (relation RetryDenied ((campaign symbol?) (failure symbol?) (reason symbol?)))
           (relation RetryMissing ((campaign symbol?) (failure symbol?) (premise symbol?)))
           (relation RetryEligible ((campaign symbol?) (failure symbol?) (mode symbol?)))
           (relation NativeStepOutcome ((campaign symbol?) (outcome symbol?)))
           (relation ObservedCommand ((campaign symbol?) (stage symbol?) (exit exact-integer?) (timeout boolean?)))
           (relation CampaignGap ((campaign symbol?) (gap symbol?)))
           (relation CampaignKnownFailure ((campaign symbol?) (failure symbol?)))
           (relation CampaignOpenPremise ((campaign symbol?) (failure symbol?) (premise symbol?)))
           (relation CampaignActualOutcome ((campaign symbol?) (outcome symbol?)))
           (relation CampaignFailure ((campaign symbol?) (reason symbol?)))
           (relation CampaignEligibility ((campaign symbol?) (mode symbol?)))
           (relation CampaignDisposition ((campaign symbol?) (disposition symbol?)))
           ((CampaignKnownFailure C F) <-- (KnownSelected C F))
           ((CampaignOpenPremise C F P) <-- (RetryMissing C F P))
           ((CampaignActualOutcome C O) <-- (NativeStepOutcome C O))
           ((CampaignFailure C R) <-- (RetryDenied C F R))
           ((CampaignFailure C (lit 'native-step-denied)) <-- (NativeStepOutcome C (lit 'DENY)))
           ((CampaignFailure C (lit 'native-step-timeout)) <-- (NativeStepOutcome C (lit 'TIMEOUT)))
           ((CampaignFailure C (lit 'native-step-failed)) <-- (NativeStepOutcome C (lit 'FAIL)))
           ((CampaignFailure C (lit 'command-timeout)) <-- (ObservedCommand C S E (lit #t)))
           ((CampaignFailure C (lit 'command-exit)) <-- (ObservedCommand C S E T)
            (if (E) (not (= E 0))))
           ((CampaignEligibility C M) <-- (RetryEligible C F M) (CampaignStatus C (lit 'CURRENT)))
           ((CampaignDisposition C (lit 'DENY)) <-- (CampaignFailure C R) (CampaignStatus C (lit 'CURRENT)))
           ((CampaignDisposition C (lit 'STALE)) <-- (CampaignStatus C (lit 'STALE)))
           ((CampaignDisposition C (lit 'OBSERVATION_REQUIRED)) <-- (CampaignGap C G))
           ((CampaignDisposition C (lit 'OBSERVATION_REQUIRED)) <-- (NativeStepOutcome C (lit 'BLOCKED)))
           ((CampaignDisposition C (lit 'REVIEW_REQUIRED)) <-- (RetryDecision C (lit 'REVIEW_REQUIRED)))
           ((CampaignDisposition C (lit 'CONDITIONAL_RETRY)) <-- (RetryDecision C (lit 'RETRY_ELIGIBLE))
            (CampaignStatus C (lit 'CURRENT)))
           ((CampaignDisposition C (lit 'NATIVE_OBSERVED)) <-- (NativeStepOutcome C (lit 'PASS))
            (CampaignStatus C (lit 'CURRENT)) (not (CampaignGap C _)) (not (CampaignFailure C _))))
  '(CampaignIdentity CampaignStatus RetryDecision KnownSelected RetryDenied
    RetryMissing RetryEligible NativeStepOutcome ObservedCommand CampaignGap)))
