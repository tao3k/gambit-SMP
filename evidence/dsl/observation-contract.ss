;;; Exact caller-declared observations. No runtime or causal admission.
(define-evidence (make-observation-contract)
  (sources RequiredCase RequiredField ObservedCase ObservedField
           observed_step required_step step_dependency source_binding workspace_projection
           compiled_workspace tested_executable control_case native_process)
  (outputs MissingCase UnknownCase DuplicateCase MissingField WrongField ExtraField
           missing_step bound_source bound_control)
  (relation observed_step ((step string?) (outcome string?) (capability string?)))
  (relation required_step ((step string?)))
  (relation step_dependency ((step string?) (parent string?)))
  (relation source_binding ((binding string?) (workspace string?)))
  (relation workspace_projection ((workspace string?) (source string?)))
  (relation compiled_workspace ((build string?) (binding string?)))
  (relation tested_executable ((test string?) (build string?)))
  (relation control_case ((test string?) (case string?) (negative boolean?)))
  (relation native_process ((step string?) (stage string?) (exit exact-integer?) (timeout boolean?)))
  (relation checked_step ((step string?)))
  (relation missing_step ((step string?)))
  (relation bound_source ((binding string?) (source string?)))
  (relation bound_control ((test string?) (case string?) (negative boolean?) (binding string?)))
  (relation RequiredCase ((case string?)))
  (relation RequiredField ((case string?) (field string?) (value string?)))
  (relation ObservedCase ((case string?) (row exact-integer?)))
  (relation ObservedField ((case string?) (row exact-integer?) (field string?) (value string?)))
  (relation SeenCase ((case string?)))
  (relation SeenField ((case string?) (row exact-integer?) (field string?)))
  (relation DeclaredField ((case string?) (field string?)))
  (relation MissingCase ((case string?)))
  (relation UnknownCase ((case string?)))
  (relation DuplicateCase ((case string?)))
  (relation MissingField ((case string?) (row exact-integer?) (field string?)))
  (relation WrongField ((case string?) (row exact-integer?) (field string?)))
  (relation ExtraField ((case string?) (row exact-integer?) (field string?)))
  ((SeenCase C) <-- (ObservedCase C R))
  ((SeenField C R F) <-- (ObservedField C R F V))
  ((DeclaredField C F) <-- (RequiredField C F V))
  ((MissingCase C) <-- (RequiredCase C) (not (SeenCase C)))
  ((UnknownCase C) <-- (ObservedCase C R) (not (RequiredCase C)))
  ((DuplicateCase C) <-- (ObservedCase C R) (ObservedCase C S) (if (R S) (< R S)))
  ((MissingField C R F) <-- (RequiredField C F V) (ObservedCase C R) (not (SeenField C R F)))
  ((WrongField C R F) <-- (RequiredField C F V) (ObservedField C R F W)
                        (if (V W) (not (equal? V W))))
  ((ExtraField C R F) <-- (ObservedField C R F V) (not (DeclaredField C F)))
  ((checked_step S) <-- (observed_step S (lit "PASS") C))
  ((missing_step S) <-- (required_step S) (not (checked_step S)))
  ((bound_source B S) <-- (source_binding B W) (workspace_projection W S))
  ((bound_control T C N B) <-- (control_case T C N) (tested_executable T X)
                            (compiled_workspace X B) (bound_source B S)))
