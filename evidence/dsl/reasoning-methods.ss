;;; Method suitability is evidence, not a scheduler or execution permission.
(define-evidence (make-reasoning-methods)
  (sources focus source question method serves requirement premise reuse)
  (outputs options missing supported reused unbound exploration choice_scope actions)
  (explain (lambda (program result query scope)
    (hash ("status" "recorded-only") ("dependencies" (.ref program 'rules))
      ("gap" "Caller-reviewed suitability and premises, not proof completeness, causal review, execution authority or source refinement. Unknown methods remain open."))))
  (relation focus ((id string?) (source string?) (sha string?)))
  (relation source ((id string?) (path string?) (sha string?)))
  (relation question ((focus string?) (id string?) (kind string?) (source string?)))
  (relation method ((id string?) (purpose string?) (boundary string?) (source string?)))
  (relation serves ((method string?) (kind string?) (reason string?)))
  (relation requirement ((method string?) (premise string?)))
  (relation premise ((focus string?) (question string?) (premise string?) (source string?)))
  (relation reuse ((focus string?) (question string?) (method string?) (source string?)))
  (relation current (focus))
  (relation bound_premise (focus question premise))
  (relation options (focus question method purpose reason boundary question_path question_sha policy_path policy_sha))
  (relation missing (focus question method premise))
  (relation supported (focus question method))
  (relation reused (focus question method path sha))
  (relation unbound (focus kind source))
  (relation exploration (focus question kind path sha))
  (relation choice_scope ((kind string?) (meaning string?))
    (("coverage" "Open world: these methods and premise lists are examples, not an exhaustive universe or completeness certificate")
     ("selection" "Optional and unordered: no mandatory model, proof, DSL edit or fixed sequence")
     ("authority" "Supported means declared premises have bound sources, never execution permission, proof admission or correctness")
     ("review" "SHA establishes identity, not the truth or sufficiency of a host review")))
  (relation actions (id query reason))
  ((current F) <-- (focus F S H) (source S _ H))
  ((exploration F Q K P H) <-- (current F) (question F Q K S) (source S P H))
  ((options F Q M Purpose Reason Boundary QP QH PP PH) <--
    (exploration F Q K QP QH) (serves M K Reason)
    (method M Purpose Boundary S) (source S PP PH))
  ((bound_premise F Q P) <-- (premise F Q P S) (source S _ _))
  ((missing F Q M P) <-- (options F Q M _ _ _ _ _ _ _) (requirement M P)
    (not (bound_premise F Q P)))
  ((supported F Q M) <-- (options F Q M _ _ _ _ _ _ _)
    (not (missing F Q M _)))
  ((reused F Q M P H) <-- (options F Q M _ _ _ _ _ _ _)
    (reuse F Q M S) (source S P H))
  ((unbound F (lit "question") S) <-- (question F _ _ S) (not (source S _ _)))
  ((unbound F (lit "premise") S) <-- (premise F _ _ S) (not (source S _ _)))
  ((unbound F (lit "reuse") S) <-- (reuse F _ _ S) (not (source S _ _)))
  ((unbound F (lit "method-policy") S) <-- (current F) (method _ _ _ S) (not (source S _ _)))
  ((actions (lit "inspect-reasoning-methods") (lit "options")
    (lit "Inspect suitability, why and conclusion boundaries; no prescribed method or sequence"))
    <-- (options _ _ _ _ _ _ _ _ _ _))
  ((actions (lit "inspect-method-premises") (lit "missing")
    (lit "Missing declared premises guide investigation, not a ban on other authorized inquiry"))
    <-- (missing _ _ _ _))
  ((actions (lit "inspect-method-support") (lit "supported")
    (lit "Bound declared premises are not sufficient proof or execution authorization"))
    <-- (supported _ _ _))
  ((actions (lit "inspect-reused-method-evidence") (lit "reused")
    (lit "Reuse only at the recorded identity and scope; no inherited PASS"))
    <-- (reused _ _ _ _ _))
  ((actions (lit "explore-other-reasoning-methods") (lit "exploration")
    (lit "Unlisted methods and investigations remain open, including when no known method fits"))
    <-- (exploration _ _ _ _ _))
  ((actions (lit "inspect-method-provenance") (lit "unbound")
    (lit "Missing provenance does not establish a premise or applicability"))
    <-- (unbound _ _ _))
  ((actions (lit "inspect-method-choice-scope") (lit "choice_scope")
    (lit "Inspect open-world, optional and non-authorizing interpretation"))
    <-- (current _)))
