;;; Downstream interpretation of upstream Trajectory comparisons, never a gate.
(define-evidence (make-trajectory-review)
  (sources comparison attempt)
  (outputs repeated_observation repeat_candidate intentional_replication comparison_unknown changed_premise historical)
  (explain (lambda (program result query scope)
    (hash ("status" "recorded-only") ("dependencies" (.ref program 'rules))
      ("gap" "Matching outcomes describe observed repetition, not wasted thought, causal failure, execution permission or a complete hypothesis set."))))
  (relation comparison ((id string?) (relation string?)))
  (relation attempt ((id string?) (ordinal exact-integer?) (status string?)
                     (outcome string?) (purpose string?)))
  (relation repeated_observation (earlier later outcome))
  (relation repeat_candidate (later outcome))
  (relation intentional_replication (id purpose))
  (relation comparison_unknown (id))
  (relation changed_premise (id))
  (relation historical (id))
  ((repeated_observation A B O) <--
    (comparison A (lit "exact-current")) (comparison B (lit "exact-current"))
    (attempt A I SA O _) (attempt B J SB O (lit ""))
    (if (I J SA SB) (and (< I J) (string=? SA SB))))
  ((repeat_candidate B O) <-- (repeated_observation _ B O))
  ((intentional_replication A P) <--
    (comparison A (lit "exact-current")) (attempt A _ _ _ P)
    (if (P) (not (string=? P ""))))
  ((comparison_unknown A) <-- (comparison A (lit "comparison-unknown")))
  ((changed_premise A) <-- (comparison A (lit "changed-premise")))
  ((historical A) <-- (comparison A (lit "historical"))))
