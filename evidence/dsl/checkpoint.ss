;; One shared projection for checkpoint inspection and Clue composition.
(def execution-observation-fragment
 (ascent-fragment
  ;; Transport/liveness and completed-work observations never grant a PASS.
  (relation execution_location (token step))
  (relation execution_process (token pid observation))
  (relation execution_end (token))
  (relation execution_sample (token count monotonic reference))
  (relation execution_older (token count))
  (relation execution_pending (step token pid observation))
  (relation execution_frontier (step token count monotonic reference))
  (relation execution_unattributed (token pid observation))
  (relation execution_custody (provider state reference))
  (relation execution_detached (step provider state reference))
  ((execution_pending S T P O) <-- (execution_location T S)
    (execution_process T P O) (not (execution_end T))
    (if (O) (or (equal? O "present") (equal? O "present-unattributed"))))
  ((execution_unattributed T P O) <-- (execution_process T P O)
    (not (execution_location T _)) (not (execution_end T)))
  ((execution_older T N) <-- (execution_sample T N _ _)
    (execution_sample T M _ _) (if (N M) (< N M)))
  ((execution_frontier S T N At Ref) <-- (execution_location T S)
    (execution_sample T N At Ref) (not (execution_older T N)))
  ((execution_detached S Provider State Ref) <-- (execution_pending S _ _ _)
    (execution_custody Provider State Ref)
    (if (State) (or (equal? State "returned") (equal? State "interrupted"))))))

;; Domain projection composes the registered Library; it does not choose work.
(define-evidence (make-build-start)
  (sources step dependency hosted_module capability_output)
  (outputs guarded_step build_obligation diagnostic_setup)
  (relation step (id capability))
  (relation dependency (child parent))
  (relation hosted_module (id))
  (relation capability_output (capability type))
  (relation producer_output (type))
  (relation reuse_capability (capability))
  (relation ancestor (child parent))
  (relation producer (id))
  (relation diagnostic (id))
  (relation configuration (id))
  (relation diagnostic_setup (id))
  (relation guarded_step (id))
  (relation build_obligation (id reason))
  (fact (producer_output (lit "seed-runtime")))
  (fact (producer_output (lit "source-runtime")))
  (fact (producer_output (lit "bootstrap-input")))
  (fact (producer_output (lit "native-object")))
  (fact (producer_output (lit "native-executable")))
  (fact (producer_output (lit "native-shared-library")))
  (fact (producer_output (lit "gerbil-build-observations")))
  (fact (reuse_capability (lit "gambit.seed-checkpoint")))
  (fact (reuse_capability (lit "gambit.runtime-import")))
  (fact (reuse_capability (lit "gambit.completed-runtime")))
  (fact (reuse_capability (lit "gambit.observation-identity")))
  ((ancestor C P) <-- (dependency C P))
  ((ancestor C P) <-- (dependency C I) (ancestor I P))
  ((producer S) <-- (step S C) (capability_output C T)
    (producer_output T) (not (reuse_capability C)))
  ((configuration S) <-- (step S (lit "gambit.configure")))
  ((diagnostic S) <-- (step S (lit "gambit.regenerate-module")) (hosted_module S))
  ((diagnostic_setup C) <-- (configuration C) (diagnostic D) (ancestor D C))
  ((build_obligation S (lit "native-producer")) <-- (producer S))
  ((build_obligation S (lit "hosted-module-diagnostic")) <-- (diagnostic S))
  ((build_obligation C (lit "configuration-with-producer")) <--
    (configuration C) (producer P) (ancestor P C))
  ((build_obligation C (lit "configuration-without-diagnostic-consumer")) <--
    (configuration C) (not (diagnostic_setup C)))
  ((guarded_step S) <-- (build_obligation S _)))

(define-evidence (make-execution-transport)
  (sources transport_required transport_recorded transport_enumerated)
  (outputs transport_gap transport_current)
  (relation transport_required (key identity))
  (relation transport_recorded (key identity))
  (relation transport_enumerated ())
  (relation transport_gap (key))
  (relation transport_current ())
  ((transport_gap K) <-- (transport_required K D) (not (transport_recorded K D)))
  ((transport_current) <-- (transport_enumerated) (not (transport_gap _))))

(define-evidence (make-repair-loop)
  (sources failed_cut command_end command_log diagnostic_location
           proposed causal_delta delta_checked violation verified_cut observed_cut
           predecessor_input candidate_input repair_step repair_product hosted_module
           hang_guard_widened compiler_event compiler_boundary)
  (outputs localized evidence_gap eligible blocked verified probe_observed predecessor_delta
           compiler_frontier compiler_signal compiler_unreturned_signal)
  (relation failed_cut (step phase))
  (relation command_end (step phase exit timeout))
  (relation command_log (step phase reference))
  (relation diagnostic_location (step phase reference line))
  (relation compiler_event (step phase kind site first second reference line))
  (relation compiler_boundary (step phase kind reference line))
  (relation compiler_frontier (step phase kind reference line))
  (relation compiler_signal (step phase kind site first second reference line))
  (relation compiler_unreturned_signal (step phase kind site first second reference line))
  (relation proposed (intent))
  (relation causal_delta (kind identity))
  (relation delta_checked ())
  (relation violation (reason))
  (relation verified_cut ())
  (relation observed_cut ())
  (relation predecessor_input (kind digest))
  (relation candidate_input (kind digest))
  (relation predecessor_delta (kind previous current))
  (relation predecessor_compared ())
  (relation repair_step (id capability))
  (relation repair_product (id kind))
  (relation hosted_module (id))
  (relation hang_guard_widened (step from to))
  (relation diagnostic_product (kind))
  (relation diagnostic_step (id))
  (relation localized (step phase reason))
  (relation evidence_gap (step phase reason))
  (relation eligible ())
  (relation blocked (reason))
  (relation verified ())
  (relation probe_observed ())
  (fact (diagnostic_product (lit "source-tree")))
  (fact (diagnostic_product (lit "configured-tree")))
  (fact (diagnostic_product (lit "compilation-workspace")))
  (fact (diagnostic_product (lit "source-binding")))
  (fact (diagnostic_product (lit "sysml-source-contract")))
  (fact (diagnostic_product (lit "sysml-structural-model")))
  (fact (diagnostic_product (lit "source-contract-observation")))
  (fact (diagnostic_product (lit "architecture-view-inputs")))
  (fact (diagnostic_product (lit "architecture-view-observation")))
  (fact (diagnostic_product (lit "research-audit-observation")))
  (fact (diagnostic_product (lit "quint-observation")))
  (fact (diagnostic_product (lit "quint-typed-ir")))
  (fact (diagnostic_product (lit "quint-verification")))
  (fact (diagnostic_product (lit "lean-check-observation")))
  (fact (diagnostic_product (lit "c-source")))
  ((diagnostic_step S) <-- (repair_product S P) (diagnostic_product P))
  ((diagnostic_step S) <-- (repair_step S (lit "evidence.evaluate")))
  ((diagnostic_step S) <-- (repair_step S (lit "quint.parse")))
  ((diagnostic_step S) <-- (repair_step S (lit "quint.typecheck")))
  ((diagnostic_step S) <-- (repair_step S (lit "quint.test")))
  ((blocked (lit "diagnostic-scope")) <-- (repair_step S _) (not (diagnostic_step S)))
  ((blocked (lit "diagnostic-scope")) <-- (repair_product _ P) (not (diagnostic_product P)))
  ((blocked (lit "diagnostic-scope")) <-- (repair_step S (lit "gambit.regenerate-module"))
    (not (hosted_module S)))
  ((predecessor_compared) <-- (predecessor_input _ _))
  ((predecessor_delta (lit "hang-guard") FROM TO) <-- (hang_guard_widened _ FROM TO))
  ((predecessor_delta K A B) <-- (predecessor_input K A) (candidate_input K B)
    (if (A B) (not (equal? A B))))
  ((blocked (lit "unchanged-predecessor")) <-- (proposed _) (predecessor_compared)
    (not (predecessor_delta _ _ _)))
  ((localized S P (lit "recorded-failure-boundary")) <-- (failed_cut S P))
  ((localized S P (lit "watchdog")) <-- (failed_cut S P)
    (command_end S P _ (lit "timeout")))
  ((localized S P (lit "diagnostic-in-command-log")) <-- (diagnostic_location S P _ _))
  ((evidence_gap S P (lit "no-command-diagnostic")) <-- (failed_cut S P)
    (not (diagnostic_location S P _ _)))
  ((evidence_gap S P (lit "no-bound-command-log")) <-- (failed_cut S P)
    (not (command_log S P _)))
  ((compiler_frontier S P K R L) <-- (compiler_boundary S P K R L))
  ((compiler_signal S P K SITE A B R L) <-- (compiler_event S P K SITE A B R L)
    (if (K) (and (not (equal? K "enter")) (not (equal? K "return"))
                 (not (equal? K "legacy-enter")))))
  ((compiler_unreturned_signal S P K SITE A B R L) <--
    (compiler_frontier S P (lit "enter") R START)
    (compiler_signal S P K SITE A B R L)
    (if (START L) (< START L)))
  ((evidence_gap S (lit "regenerate-module") (lit "no-bound-compiler-boundary")) <--
    (failed_cut S (lit "regenerate-module")) (not (compiler_boundary S _ _ _ _)))
  ((blocked R) <-- (violation R))
  ((blocked (lit "no-causal-delta")) <-- (proposed _) (delta_checked) (not (causal_delta _ _)))
  ((eligible) <-- (proposed _) (failed_cut _ _) (causal_delta _ _) (not (blocked _)))
  ((verified) <-- (eligible) (proposed (lit "repair")) (verified_cut))
  ((probe_observed) <-- (eligible) (proposed (lit "probe")) (observed_cut)))

(def checkpoint-binding-group-fragment
 (ascent-fragment
  (relation binding_group (group key digest))
  (relation receipt_binding_group (receipt group))
  (relation support_binding_group (requirement contract group))
  ((binding E K D) <-- (receipt_binding_group E G) (binding_group G K D))
  ((required_binding R C K) <-- (support_binding_group R C G) (binding_group G K _))))

(define-evidence (make-checkpoint-state)
  (sources requirement dependency contract receipt verified
           support_declaration support_witness required_command
           current_binding binding_group
           receipt_binding_group support_binding_group command command_observation
           prerequisite quiescent material available withdrawn
           required_step recorded_failure campaign_pass receipt_checked
           output_retained execution_quiescent campaign_required campaign_enumerated
           progress_contract progress_active progress_cursor progress_sample
           progress_attested progress_completed
           execution_location execution_process execution_end execution_sample execution_custody)
  (outputs historical_complete reusable support_declaration support_witness closed_support
           satisfied artifact_unavailable historical_only unresolved invalidated failed
           campaign_reusable invalidated_by binding_gap enumeration_gap unclosed material_gap completion_gap applicable consumable
           progress_frontier progress_advanced progress_rejected
           execution_pending execution_frontier execution_unattributed execution_detached
           failed_attempt_history)
  (include evidence-checkpoint-fragment)
  (include checkpoint-binding-group-fragment)
  (include evidence-progress-fragment)
  (include execution-observation-fragment)
  (fact (completed_outcome (lit "PASS")))
  (relation required_step (step))
  (relation recorded_failure (step outcome))
  (relation campaign_pass ())
  (relation receipt_checked ())
  (relation inputs_current ())
  (relation output_retained (step))
  (relation execution_quiescent ())
  (relation completed_step (step))
  (relation satisfied (step))
  (relation artifact_unavailable (step))
  (relation historical_only (step))
  (relation unresolved (step))
  (relation invalidated (step))
  (relation failed (step outcome))
  (relation campaign_gap ())
  (relation campaign_required (step))
  (relation campaign_enumerated ())
  (relation campaign_reusable ())
  (relation inputs_current ())
  (relation consumable (step receipt))
  (relation attempt_recorded (step))
  (relation attempt_gap (step))
  (relation failed_attempt_history ())
  ((completed_step S) <-- (historical_complete S _))
  ((inputs_current) <-- (receipt_checked) (not (binding_gap _ _)))
  ((satisfied S) <-- (applicable S _))
  ((consumable S E) <-- (reusable S E))
  ((consumable P E) <-- (consumable S Child) (prerequisite Child P E)
                        (applicable P E) (output_retained P))
  ((artifact_unavailable S) <-- (material_gap S _ _))
  ((historical_only S) <-- (completed_step S) (output_retained S)
                          (artifact_unavailable S))
  ((unresolved S) <-- (required_step S) (not (completed_step S)))
  ((invalidated S) <-- (completed_step S) (not (satisfied S)))
  ((failed S O) <-- (required_step S) (recorded_failure S O) (receipt_checked))
  ((attempt_recorded S) <-- (receipt_checked) (receipt E S _ _) (verified E))
  ((attempt_gap S) <-- (required_step S) (not (attempt_recorded S)))
  ((attempt_gap S) <-- (campaign_required S) (not (attempt_recorded S)))
  ;; Historical failure permits review of a changed attempt, never native credit.
  ((failed_attempt_history) <-- (receipt_checked) (campaign_enumerated)
    (execution_quiescent) (failed _ _) (not (attempt_gap _)))
  ((campaign_gap) <-- (required_step S) (not (satisfied S)))
  ((campaign_gap) <-- (campaign_required S) (not (satisfied S)))
  ((campaign_gap) <-- (material_gap S _ _) (not (output_retained S)))
  ((campaign_reusable) <-- (campaign_pass) (receipt_checked) (inputs_current) (campaign_enumerated)
                          (execution_quiescent) (not (campaign_gap))))
