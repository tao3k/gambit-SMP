(define-evidence (make-research-flow)
 (sources input observation sourceClass execution writer transportRequired transportObserved libraryRequired libraryObserved formalDuty formalObserved clueRequired clueObserved recoveryRequired recoveryObserved storageRequired storageObserved producerRequired producerObserved producerHistory producerKind)
 (outputs ready unavailable blocked accepted unresolved writerAdmitted writerBlocked transportChecked transportBlocked libraryChecked libraryBlocked formalBlocked clueChecked clueBlocked recoveryQualified recoveryPending storageRetired storagePending producerClosed producerPending producerHistorical)
 (relation input ((id string?) (path string?) (mode string?)))
 (relation observation ((id string?) (state string?) (identity string?)))
 (relation sourceClass ((id string?) (allowed string?)))
 (relation ready ((id string?)))
 ((ready I) <-- (input I _ "required-source") (sourceClass I "yes")
                 (observation I "matched" "exact"))
 ((ready I) <-- (input I _ "historical-evidence")
                 (observation I "matched" "exact"))
 (relation unavailable ((id string?)))
 ((unavailable I) <-- (input I _ "historical-evidence") (not (ready I)))
 (relation blocked ((id string?)))
 ((blocked I) <-- (input I _ "required-source") (not (ready I)))
 (relation execution ((id string?) (state string?) (closure string?)))
 (relation accepted ((id string?)))
 ((accepted I) <-- (execution I "completed" "verified"))
 (relation unresolved ((id string?)))
 ((unresolved I) <-- (execution I _ _) (not (accepted I)))
 (relation writer ((id string?) (entry string?) (scope string?)))
 (relation writerAdmitted ((id string?)))
 ((writerAdmitted I) <-- (writer I "guarded" "fresh-run"))
 ((writerAdmitted I) <-- (writer I "source-generator" "explicit-publication"))
 ((writerAdmitted I) <-- (writer I "capability-library" "recipe-owned"))
 (relation writerBlocked ((id string?)))
 ((writerBlocked I) <-- (writer I _ _) (not (writerAdmitted I)))
 (relation transportRequired ((id string?)))
 (relation transportObserved ((id string?) (before string?) (after string?) (decoder string?)))
 (relation transportGood ((id string?) (before string?) (after string?) (decoder string?)))
 ((transportGood I "matched" "matched" "absent") <-- (transportObserved I "matched" "matched" "absent"))
 (relation transportBad ((id string?)))
 ((transportBad I) <-- (transportObserved I B A D) (not (transportGood I B A D)))
 (relation transportChecked ((id string?)))
 ((transportChecked I) <-- (transportRequired I) (transportGood I "matched" "matched" "absent") (not (transportBad I)))
 (relation transportBlocked ((id string?)))
 ((transportBlocked I) <-- (transportRequired I) (not (transportChecked I)))
 ((transportBlocked I) <-- (transportObserved I _ _ _) (not (transportRequired I)))

 (relation libraryRequired ((id string?)))
 (relation libraryObserved ((id string?) (inverse string?) (transport string?) (owner string?) (runner string?)))
 (relation libraryGood ((id string?) (inverse string?) (transport string?) (owner string?) (runner string?)))
 ((libraryGood I "matched" "typed" "recipe" "absent") <-- (libraryObserved I "matched" "typed" "recipe" "absent"))
 (relation libraryBad ((id string?)))
 ((libraryBad I) <-- (libraryObserved I A T O R) (not (libraryGood I A T O R)))
 (relation libraryChecked ((id string?)))
 ((libraryChecked I) <-- (libraryRequired I) (libraryGood I "matched" "typed" "recipe" "absent") (not (libraryBad I)))
 (relation libraryBlocked ((id string?)))
 ((libraryBlocked I) <-- (libraryRequired I) (not (libraryChecked I)))
 ((libraryBlocked I) <-- (libraryObserved I _ _ _ _) (not (libraryRequired I)))
 (relation formalDuty ((id string?) (role string?)))
 (relation formalObserved ((id string?) (role string?)))
 (relation formalMatch ((id string?)))
 ((formalMatch I) <-- (formalDuty I R) (formalObserved I R))
 (relation formalBlocked ((id string?)))
 ((formalBlocked I) <-- (formalDuty I _) (not (formalMatch I)))
 ((formalBlocked I) <-- (formalObserved I R) (not (formalDuty I R)))

 (relation clueRequired ((id string?)))
 (relation clueObserved ((id string?) (result string?) (scope string?)))
 (relation clueBad ((id string?)))
 (relation clueGood ((id string?) (result string?) (scope string?)))
 ((clueGood I "equal" "historical-inference") <-- (clueObserved I "equal" "historical-inference"))
 ((clueBad I) <-- (clueObserved I R S) (not (clueGood I R S)))
 (relation clueChecked ((id string?)))
 ((clueChecked I) <-- (clueRequired I) (clueObserved I "equal" "historical-inference") (not (clueBad I)))
 (relation clueBlocked ((id string?)))
 ((clueBlocked I) <-- (clueRequired I) (not (clueChecked I)))
 ((clueBlocked I) <-- (clueObserved I _ _) (not (clueRequired I)))


 (relation recoveryRequired ((id string?) (duty string?)))
 (relation recoveryObserved ((id string?) (state string?) (scope string?) (duty string?) (producer string?)))
 (relation recoveryGood ((id string?) (state string?) (scope string?) (duty string?) (producer string?)))
 ((recoveryGood I "fresh-checked" "current" D "source-bound") <-- (recoveryObserved I "fresh-checked" "current" D "source-bound"))
 (relation recoveryBad ((id string?)))
 ((recoveryBad I) <-- (recoveryObserved I S C D P) (not (recoveryGood I S C D P)))
 (relation recoveryQualified ((id string?)))
 ((recoveryQualified I) <-- (recoveryRequired I D) (recoveryGood I "fresh-checked" "current" D "source-bound") (not (recoveryBad I)))
 (relation recoveryPending ((id string?)))
 ((recoveryPending I) <-- (recoveryRequired I _) (not (recoveryQualified I)))
 (relation storageRequired ((id string?)))
 (relation storageObserved ((id string?) (kind string?) (content string?) (duty string?) (fallback string?)))
 (relation storageGood ((id string?) (kind string?) (content string?) (duty string?) (fallback string?)))
 ((storageGood I "git" "same-content" "same-duty" "no-cache") <-- (storageObserved I "git" "same-content" "same-duty" "no-cache"))
 (relation storageBad ((id string?)))
 ((storageBad I) <-- (storageObserved I K C D F) (not (storageGood I K C D F)))
 (relation storageRetired ((id string?)))
 ((storageRetired I) <-- (storageRequired I) (storageGood I "git" "same-content" "same-duty" "no-cache") (not (storageBad I)))
 (relation storagePending ((id string?)))
 ((storagePending I) <-- (storageRequired I) (not (storageRetired I)))

 (relation producerRequired ((id string?) (duty string?) (mode string?)))
 (relation producerObserved ((id string?) (duty string?) (status string?) (scope string?) (kind string?)))
 (relation producerKind ((duty string?) (kind string?)))
 (relation producerHistory ((id string?)))
 (relation producerGood ((id string?) (duty string?) (status string?) (scope string?) (kind string?)))
 ((producerGood I D "PASS" "current" K) <-- (producerObserved I D "PASS" "current" K) (producerKind D K))
 (relation producerBad ((id string?)))
 ((producerBad I) <-- (producerObserved I D S C K) (not (producerGood I D S C K)))
 (relation producerClosed ((id string?)))
 ((producerClosed I) <-- (producerRequired I D "reacquire") (producerGood I D "PASS" "current" _) (not (producerBad I)))
 (relation producerHistorical ((id string?)))
 ((producerHistorical I) <-- (producerRequired I _ "history") (producerHistory I))
 (relation producerPending ((id string?)))
 ((producerPending I) <-- (producerRequired I _ "reacquire") (not (producerClosed I)))

)
