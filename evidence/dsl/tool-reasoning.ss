;;; Caller-owned investigation choices, not execution or repair admission.
(define-evidence (make-tool-reasoning)
  (sources focus source build compiler_kind question rationale tool offers support requirement available observation environment_hint)
  (outputs compiler_context options why missing ready reuse unbound conflicts context_gaps choice_scope exploration_window environment_options actions)
  (relation choice_scope ((kind string?) (meaning string?))
    (("coverage" "Open world: known examples, never an exhaustive tool universe")
     ("selection" "Optional and unordered; no tool or sequence is mandatory")
     ("unknown" "Outside this catalog means unclassified, not forbidden or infeasible")
     ("authority" "Reasoning remains open; execution authorization is independently checked")))
  (relation focus ((id string?) (source string?) (sha string?)))
  (relation source ((id string?) (path string?) (sha string?)))
  (relation build ((focus string?) (compiler string?) (version string?) (format string?) (arch string?) (source string?)))
  (relation compiler_kind ((name string?) (family string?) (source string?)))
  (relation question ((focus string?) (goal string?) (source string?)))
  (relation rationale ((focus string?) (goal string?) (reason string?) (source string?)))
  (relation tool ((id string?) (purpose string?) (boundary string?) (source string?)))
  (relation offers ((tool string?) (goal string?)))
  (relation support ((tool string?) (compiler string?) (format string?) (arch string?)))
  (relation requirement ((tool string?) (premise string?)))
  (relation available ((focus string?) (premise string?) (source string?)))
  (relation observation ((focus string?) (goal string?) (tool string?) (source string?)))
  (relation environment_hint ((tool string?) (source string?)))
  (relation current (focus))
  (relation compatible (focus tool))
  (relation conflicts (focus))
  (relation compiler_context (focus compiler version format arch path sha))
  (relation context_gaps (focus goal))
  (relation exploration_window (focus goal reason path sha))
  (relation environment_options (focus tool path sha))
  (relation options (focus goal tool purpose boundary question_path question_sha policy_path policy_sha))
  (relation why (focus goal tool reason path sha))
  (relation missing (focus goal tool premise))
  (relation ready (focus goal tool))
  (relation reuse (focus goal tool path sha))
  (relation unbound (focus kind source))
  (relation actions (id query reason))
  ((current F) <-- (focus F S H) (source S _ H))
  ((exploration_window F G
    (lit "Consider other tools, methods or separating observations, including unlisted ones; no catalog completion is required before independently authorized inquiry") P H)
    <-- (current F) (question F G S) (source S P H))
  ((compiler_context F C V B A P H) <-- (current F)
    (build F Name V B A S) (source S P H)
    (compiler_kind Name C Policy) (source Policy _ _))
  ((context_gaps F G) <-- (current F) (question F G S) (source S _ _)
    (not (compiler_context F _ _ _ _ _ _)))
  ((conflicts F) <-- (compiler_context F C _ _ _ _ _)
    (compiler_context F Other _ _ _ _ _) (if (C Other) (not (string=? C Other))))
  ((conflicts F) <-- (compiler_context F _ V _ _ _ _)
    (compiler_context F _ Other _ _ _ _) (if (V Other) (not (string=? V Other))))
  ((conflicts F) <-- (compiler_context F _ _ B _ _ _)
    (compiler_context F _ _ Other _ _ _) (if (B Other) (not (string=? B Other))))
  ((conflicts F) <-- (compiler_context F _ _ _ A _ _)
    (compiler_context F _ _ _ Other _ _) (if (A Other) (not (string=? A Other))))
  ((compatible F T) <-- (compiler_context F C _ B A _ _)
    (support T TC TB TA)
    (if (C TC) (or (string=? TC "any") (string=? TC C)))
    (if (B TB) (or (string=? TB "any") (string=? TB B)))
    (if (A TA) (or (string=? TA "any") (string=? TA A))))
  ((options F G T Purpose Boundary QP QH PP PH) <--
    (current F) (not (conflicts F)) (question F G Q) (source Q QP QH)
    (offers T G) (compatible F T) (tool T Purpose Boundary Policy) (source Policy PP PH))
  ((why F G T Reason P H) <-- (options F G T _ _ _ _ _ _)
    (rationale F G Reason S) (source S P H))
  ((environment_options F T P H) <-- (options F _ T _ _ _ _ _ _)
    (environment_hint T S) (source S P H))
  ((missing F G T P) <-- (options F G T _ _ _ _ _ _) (requirement T P)
    (not (available F P _)))
  ((missing F G T P) <-- (options F G T _ _ _ _ _ _) (requirement T P)
    (available F P S) (not (source S _ _)))
  ((ready F G T) <-- (options F G T _ _ _ _ _ _) (not (missing F G T _)))
  ((reuse F G T P H) <-- (current F) (observation F G T S) (source S P H))
  ((unbound F (lit "build") S) <-- (build F _ _ _ _ S) (not (source S _ _)))
  ((unbound F (lit "question") S) <-- (question F _ S) (not (source S _ _)))
  ((unbound F (lit "premise") S) <-- (available F _ S) (not (source S _ _)))
  ((unbound F (lit "observation") S) <-- (observation F _ _ S) (not (source S _ _)))
  ((unbound F (lit "rationale") S) <-- (rationale F _ _ S) (not (source S _ _)))
  ((actions (lit "inspect-tool-options") (lit "options")
    (lit "Source-bound tool choices and limits; no prescribed order, installation claim or execution authority"))
    <-- (options _ _ _ _ _ _ _ _ _))
  ((actions (lit "inspect-tool-premises") (lit "missing")
    (lit "Inspect missing declared premises; other authorized investigations remain available"))
    <-- (missing _ _ _ _))
  ((actions (lit "inspect-tool-evidence") (lit "reuse")
    (lit "Reuse existing observations at their exact identity and scope, not as proof of repair"))
    <-- (reuse _ _ _ _ _))
  ((actions (lit "inspect-compiler-context") (lit "compiler_context")
    (lit "Compiler provenance is distinct from the inspection tool family"))
    <-- (compiler_context _ _ _ _ _ _ _))
  ((actions (lit "inspect-tool-provenance") (lit "unbound")
    (lit "Missing source provenance cannot establish tool applicability"))
    <-- (unbound _ _ _))
  ((actions (lit "inspect-build-conflicts") (lit "conflicts")
    (lit "Resolve contradictory build descriptions before claiming tool compatibility"))
    <-- (conflicts _))
  ((actions (lit "inspect-tool-purpose") (lit "why")
    (lit "Inspect the source-bound investigation rationale, not a mandatory next step"))
    <-- (why _ _ _ _ _ _))
  ((actions (lit "inspect-missing-build-context") (lit "context_gaps")
    (lit "Build/compiler context is unknown; no compiler family is guessed and unrelated inquiry is not forbidden"))
    <-- (context_gaps _ _))
  ((actions (lit "inspect-open-investigation-space") (lit "exploration_window")
    (lit "Known tool options are non-exhaustive; unlisted methods remain open, with separate execution authority"))
    <-- (exploration_window _ _ _ _ _))
  ((actions (lit "inspect-tool-choice-scope") (lit "choice_scope")
    (lit "Inspect the open-world, optional, unordered meaning of this capability catalog"))
    <-- (current _))
  ((actions (lit "inspect-tool-environment-route") (lit "environment_options")
    (lit "Optional source-bound environment discovery; no eval, installation or model execution is implied"))
    <-- (environment_options _ _ _ _)))
