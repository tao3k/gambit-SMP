;;; Review scope is not execution permission or native correctness.
(define-evidence (make-upstream-test-scope)
  (sources selected_make_target make_dependency make_unit_selection make_unit_mode)
  (outputs review_make_scope review_unit_selection review_unit_mode scope_cycle)
  (relation selected_make_target ((target string?)))
  (relation make_dependency ((parent string?) (child string?)))
  (relation make_unit_selection ((target string?) (selection string?)))
  (relation make_unit_mode ((target string?) (mode string?)))
  (relation make_reaches ((parent string?) (child string?)))
  (relation review_make_scope ((target string?)))
  (relation review_unit_selection ((selection string?)))
  (relation review_unit_mode ((mode string?)))
  (relation scope_cycle ((target string?)))
  ((make_reaches P C) <-- (make_dependency P C))
  ((make_reaches P C) <-- (make_reaches P M) (make_dependency M C))
  ((review_make_scope T) <-- (selected_make_target T))
  ((review_make_scope C) <-- (selected_make_target P) (make_reaches P C))
  ((review_unit_selection S) <-- (review_make_scope T) (make_unit_selection T S))
  ((review_unit_mode M) <-- (review_make_scope T) (make_unit_mode T M))
  ((scope_cycle T) <-- (review_make_scope T) (make_reaches T T))
  (explain (lambda (program result query scope)
    (hash ("status" "recorded-only") ("dependencies" (.ref program 'rules))
          ("gap" "declared source-bound review scope is neither retry permission nor proof of native execution")))))
