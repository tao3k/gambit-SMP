;;; Transport supplies checked observations; native ASCENT owns disposition.
(ascent-fragment
  (relation checkpoint ((step symbol?)))
  (relation receipt_bound ((step symbol?)))
  (relation producer_pass ((step symbol?)))
  (relation artifact_bound ((step symbol?)))
  (relation input_bound ((step symbol?)))
  (relation process_quiescent ((step symbol?)))
  (relation clock_bound ((step symbol?)))
  (relation budget_remaining ((step symbol?)))
  (relation recovery_reviewed ((step symbol?)))
  (relation checkpoint_dependency ((step symbol?) (parent symbol?)))
  (relation ancestor ((step symbol?) (parent symbol?)))
  (relation local_gap ((step symbol?) (reason symbol?)))
  (relation recovery_gap ((step symbol?) (reason symbol?)))
  (relation blocked ((step symbol?)))
  (relation resumable ((step symbol?)))
  (relation evidence_readable ((step symbol?)))
  ((ancestor S P) <-- (checkpoint_dependency S P))
  ((ancestor S P) <-- (checkpoint_dependency S Q) (ancestor Q P))
  ((local_gap S 'receipt-missing) <-- (checkpoint S) (not (receipt_bound S)))
  ((local_gap S 'producer-not-pass) <-- (checkpoint S) (not (producer_pass S)))
  ((local_gap S 'artifact-unbound) <-- (checkpoint S) (not (artifact_bound S)))
  ((local_gap S 'input-unbound) <-- (checkpoint S) (not (input_bound S)))
  ((local_gap S 'process-unverified) <-- (checkpoint S) (not (process_quiescent S)))
  ((local_gap S 'clock-unbound) <-- (checkpoint S) (not (clock_bound S)))
  ((local_gap S 'budget-expired) <-- (checkpoint S) (not (budget_remaining S)))
  ((local_gap S 'review-required) <-- (checkpoint S) (not (recovery_reviewed S)))
  ((recovery_gap S R) <-- (local_gap S R))
  ((recovery_gap S 'dependency-missing) <-- (checkpoint S) (ancestor S P) (not (checkpoint P)))
  ((recovery_gap S 'dependency-unqualified) <-- (checkpoint S) (ancestor S P) (local_gap P R))
  ((recovery_gap S 'dependency-cycle) <-- (checkpoint S) (ancestor S S))
  ((blocked S) <-- (recovery_gap S R))
  ((resumable S) <-- (checkpoint S) (not (blocked S)))
  ;; Expired or unreviewed records remain readable; this is not execution permission.
  ((evidence_readable S) <-- (checkpoint S) (receipt_bound S)))
