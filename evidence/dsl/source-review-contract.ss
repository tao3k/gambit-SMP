(define-evidence (make-source-review-contract)
  (sources RequiredModel AllowedStatus SourceReview)
  (outputs MissingModel UnknownModel UnknownStatus)
  (relation RequiredModel ((model string?)))
  (relation AllowedStatus ((status string?)))
  (relation SourceReview ((model string?) (id string?) (status string?)))
  (relation SeenModel ((model string?)))
  (relation MissingModel ((model string?)))
  (relation UnknownModel ((model string?)))
  (relation UnknownStatus ((id string?) (status string?)))
  ((SeenModel M) <-- (SourceReview M I S))
  ((MissingModel M) <-- (RequiredModel M) (not (SeenModel M)))
  ((UnknownModel M) <-- (SourceReview M I S) (not (RequiredModel M)))
  ((UnknownStatus I S) <-- (SourceReview M I S) (not (AllowedStatus S))))
