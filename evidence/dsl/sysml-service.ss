;;; Finite observed lifecycle admission, not an OS or arbitrary-model theorem.
(define-evidence (make-sysml-service)
  (sources sdk_observation)
  (outputs sdk_qualified sdk_denied)
  (relation sdk_observation ((id string?) (expected string?) (actual string?)
    (request string?) (response string?) (phase string?) (clientExit exact-integer?)
    (serviceReaped boolean?) (clientReaped boolean?) (controlled boolean?)
    (forced boolean?) (stable boolean?) (childrenBound boolean?) (serviceExit exact-integer?)))
  (relation sdk_qualified ((id string?)))
  (relation sdk_denied ((id string?)))
  (relation sdk_bad_row ((id string?)))
  ((sdk_bad_row I) <-- (sdk_observation I E A Q R P X S C T F B K Y)
    (if (E A Q R P X S C T F B K Y)
      (not (and (equal? E A) (equal? Q R) (equal? P "closed") (= X 0)
           S C T (not F) B K (or (= Y 0) (= Y -15))))))
  ((sdk_qualified I) <-- (sdk_observation I _ _ _ _ _ _ _ _ _ _ _ _ _)
    (not (sdk_bad_row I)))
  ((sdk_denied I) <-- (sdk_observation I _ _ _ _ _ _ _ _ _ _ _ _ _)
    (not (sdk_qualified I))))
