;;; Task/component admission only; never native acceptance or speedup.
(define-evidence (make-work-item-boundary)
  (sources scope_owner scope_action scope_allow scope_read scope_blocked_by scope_subject)
  (outputs scope_permitted scope_denied scope_dependency)
  (relation scope_subject ((id string?) (component string?)))
  (relation scope_mismatch ((id string?)))
  (relation scope_owner ((component string?) (task string?)))
  (relation scope_action ((id string?) (task string?) (component string?) (capability string?)))
  (relation scope_allow ((task string?) (capability string?)))
  (relation scope_read ((task string?) (capability string?)))
  (relation scope_blocked_by ((task string?) (component string?)))
  (relation scope_permitted ((id string?)))
  (relation scope_denied ((id string?)))
  (relation scope_dependency ((task string?) (owner string?) (component string?)))
  ((scope_mismatch A) <-- (scope_action A T C K) (scope_subject A S)
    (if (C S) (not (equal? C S))))
  ((scope_permitted A) <-- (scope_action A T C K) (scope_subject A C) (scope_owner C T) (scope_allow T K) (not (scope_mismatch A)))
  ((scope_permitted A) <-- (scope_action A T C K) (scope_owner C _) (scope_subject A C) (scope_read T K) (not (scope_mismatch A)))
  ((scope_denied A) <-- (scope_action A _ _ _) (not (scope_permitted A)))
  ;; A blocker produces a dependency, never a component ownership/grant.
  ((scope_dependency T O C) <-- (scope_blocked_by T C) (scope_owner C O)))
