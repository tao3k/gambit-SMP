;;; Completed observations and actual property verdicts are separate relations.
(define-evidence (make-c-bounded-contract)
  (sources observed_step required_step step_dependency source_binding workspace_projection
           compiled_workspace tested_executable control_case native_process
           c_verdict c_property c_source c_assumption c_reachability)
  (outputs missing_boundary repair_needed verified unresolved bound_source assumption reachability counterexample)
  (relation observed_step ((step string?) (outcome string?) (capability string?)))
  (relation required_step ((step string?)))
  (relation step_dependency ((step string?) (parent string?)))
  (relation source_binding ((binding string?) (workspace string?)))
  (relation workspace_projection ((workspace string?) (source string?)))
  (relation compiled_workspace ((build string?) (binding string?)))
  (relation tested_executable ((test string?) (build string?)))
  (relation control_case ((test string?) (case string?) (negative boolean?)))
  (relation native_process ((step string?) (stage string?) (exit exact-integer?) (timeout boolean?)))
  (relation c_verdict ((step string?) (contract string?) (branch string?) (verdict string?) (scope string?)))
  (relation c_property ((step string?) (id string?) (status string?) (file string?) (line string?) (description string?)))
  (relation c_source ((step string?) (path string?) (sha string?)))
  (relation c_assumption ((step string?) (text string?)))
  (relation c_reachability ((step string?) (contract string?) (branch string?) (witness string?) (status string?)))
  (relation reachability ((contract string?) (branch string?) (step string?) (witness string?) (status string?)))
  (relation counterexample ((contract string?) (branch string?) (step string?)))
  (relation has_verdict ((step string?)))
  (relation missing_boundary ((step string?)))
  (relation repair_needed ((contract string?) (branch string?) (step string?) (id string?) (file string?) (line string?) (description string?)))
  (relation verified ((contract string?) (branch string?) (step string?) (scope string?)))
  (relation unresolved ((contract string?) (branch string?) (step string?) (scope string?)))
  (relation bound_source ((step string?) (path string?) (sha string?)))
  (relation assumption ((step string?) (text string?)))
  ((counterexample K B S) <-- (c_verdict S K B (lit "COUNTEREXAMPLE") _))
  ((has_verdict S) <-- (c_verdict S K B V C))
  ((missing_boundary S) <-- (observed_step S O (lit "c.cbmc")) (not (has_verdict S)))
  ((missing_boundary S) <-- (observed_step S O (lit "c.frama-c")) (not (has_verdict S)))
  ((missing_boundary S) <-- (observed_step S O (lit "c.genmc")) (not (has_verdict S)))
  ((repair_needed K B S P F L D) <-- (c_verdict S K B (lit "COUNTEREXAMPLE") C)
                               (c_property S P (lit "FAILURE") F L D))
  ((verified K B S C) <-- (c_verdict S K B (lit "VERIFIED") C))
  ((unresolved K B S C) <-- (c_verdict S K B (lit "INCONCLUSIVE") C))
  ((unresolved K B S C) <-- (c_verdict S K B (lit "BOUNDED") C))
  ((unresolved K B S C) <-- (c_verdict S K B (lit "SAMPLED") C))
  ((bound_source S P H) <-- (c_source S P H))
  ((assumption S A) <-- (c_assumption S A))
  ((reachability K B S W Status) <-- (c_reachability S K B W Status)))
