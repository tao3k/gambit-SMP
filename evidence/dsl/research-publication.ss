(define-evidence (make-research-storage)
 (sources candidate classified classPolicy)
 (outputs gitAllowed gitRejected)
 (relation candidate ((id string?) (path string?) (declared string?)))
 (relation classified ((id string?) (kind string?) (disposition string?)))
 (relation classPolicy ((kind string?) (git string?)))
 (relation gitAllowed ((id string?)))
 ((gitAllowed I) <-- (candidate I _ K) (classified I K "allow") (classPolicy K "yes"))
 (relation gitRejected ((id string?)))
 ((gitRejected I) <-- (candidate I _ _) (not (gitAllowed I)))
)
