+(def (c-linker-id name)
+  (call-with-output-string
+   (lambda (output)
+     (string-for-each
+      (lambda (character)
+        (cond
+         ((char=? character #\_)
+          (display "__" output))
+         ((let (code (char->integer character))
+            (or (and (>= code 65) (<= code 90))
+                (and (>= code 97) (<= code 122))
+                (and (>= code 48) (<= code 57))))
+          (write-char character output))
+         (else
+          (display #\_ output)
+          (display (number->string (char->integer character) 16) output)
+          (display #\_ output))))
+      name))))
+
