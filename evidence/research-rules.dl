# Research admission is distinct from a runtime correctness verdict.
audit_value_path(I, P, M, S) <= audit_pr(I, P) & audit_model(I, M) & source_obligation(M, S)
audit_receipt_known(M) <= has_model_receipt(M)
audit_receipt_known(M) <= audit_reusable_receipt(M, P, D)
audit_legacy_known(M) <= audit_legacy_receipt(M, P, D)
audit_legacy_review(M, P, D) <= audit_legacy_receipt(M, P, D) & ~audit_receipt_known(M)
audit_model_gap(I, M) <= audit_model(I, M) & ~audit_receipt_known(M) & ~audit_legacy_known(M)
audit_contract_gap(I, D) <= audit_model(I, M) & contract_path(M, D) & ~audit_receipt_known(D) & ~audit_legacy_known(D)
audit_paper_path(I, P, S, M) <= audit_paper(I, P, S) & audit_model(I, M)
audit_blocker(I, B) <= audit_issue(I, B, Priority)
protocol_evidence_known(M) <= protocol_checked(M, D)
protocol_gap(M) <= protocol_model(M, D) & ~protocol_evidence_known(M)
protocol_value_path(M, Prior, Source) <= protocol_composes(M, Prior) & protocol_source(M, Source)
protocol_ancestor(M, Prior) <= protocol_composes(M, Prior)
protocol_ancestor(M, Prior) <= protocol_composes(M, Intermediate) & protocol_ancestor(Intermediate, Prior)
protocol_upstream(M, P) <= protocol_ancestor(M, Prior) & model_context_pr(Prior, P)
source_repair_needed(M, I) <= source_review(M, I, 'repair-required')
source_origin_needed(M, I) <= source_review(M, I, 'unresolved-origin')
retry_denied(R, 'unchanged-tested-inputs') <= retry_route(R) & ~retry_delta(R)
retry_denied(R, 'budget-expanded') <= retry_budget_expanded(R)
retry_denied(R, 'failure-scope-mismatch') <= retry_scope_mismatch(R)
retry_denied(R, 'missing-causal-hypothesis') <= retry_route(R) & ~retry_hypothesis(R)
retry_denied(R, 'unreviewed-artifact-identity') <= retry_unbound(R)
retry_has_denial(R) <= retry_denied(R, Reason)
retry_review_required(R) <= retry_route(R) & retry_delta(R) & ~retry_has_denial(R)
