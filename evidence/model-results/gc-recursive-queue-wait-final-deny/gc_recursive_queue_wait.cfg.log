*)
initSource == s = initial("source", "none")

(*
  @type: (() => Bool);
*)
initCombined == s' := (initial("combined", "none"))

(*
  @type: (() => Bool);
*)
init == \E policy \in { "source", "combined" }: s' := (initial(policy, "none"))

(*
  @type: (() => Bool);
*)
probeRecheckQueue ==
  \E w \in workers:
    \E q \in s["remaining"][w]:
      s["mode"][w] = "recheck"
        /\ s["mutex"] = w
        /\ s["queueOwner"][q] = -1
        /\ s'
          := [
            [
              s EXCEPT
                !["remaining"] =
                  [ s["remaining"] EXCEPT ![w] = s["remaining"][w] \ {q} ]
            ] EXCEPT
              !["found"] =
                [ s["found"] EXCEPT ![w] = s["found"][w] \/ queuePending(q) ]
          ]

(*
  @type: (() => Bool);
*)
producerLifetimeSafe ==
  \A w_1946 \in workers:
    privateWork(w_1946) => s["mode"][w_1946] \in activeModes

(*
  @type: (() => Bool);
*)
restoreSafe == countSafe

(*
  @type: ((Int) => Bool);
*)
ready(w_424) == ~(privateWork(w_424))

(*
  @type: (() => Bool);
*)
claimQueue ==
  \E w \in workers:
    \E o \in queued:
      LET (*@type: (() => Int); *) q == s["queueOf"][o] IN
      s["mode"][w] = "active"
        /\ ready(w)
        /\ s["queueOwner"][(q)] = -1
        /\ s'
          := [
            [
              [ s EXCEPT !["queueOwner"] = [ s["queueOwner"] EXCEPT ![q] = w ] ]
                EXCEPT
                !["target"] = [ s["target"] EXCEPT ![w] = o ]
            ] EXCEPT
              !["mode"] = [ s["mode"] EXCEPT ![w] = "claim-locked" ]
          ]

(*
  @type: (() => Bool);
*)
finalEmptyProbe ==
  \E w \in workers:
    s["mode"][w] = "active"
      /\ queued = {}
      /\ (ready(w) \/ s["fault"] = "early-idle")
      /\ s' := [ s EXCEPT !["mode"] = [ s["mode"] EXCEPT ![w] = "probed" ] ]

(*
  @type: (() => Bool);
*)
safe ==
  ((((((countSafe /\ payloadSafe) /\ ownershipSafe) /\ producerLifetimeSafe)
          /\ closureSafe)
        /\ localExportSafe)
      /\ queueTopologySafe)
    /\ fieldPartitionSafe

(*
  @type: (() => Bool);
*)
q_init == initSource

(*
  @type: (() => Bool);
*)
sourceSafe == safe

(*
  @type: (() => Bool);
*)
combinedSafe == safe

(*
  @type: (() => Bool);
*)
step ==
  copyWord
    \/ beginPublish
    \/ publish
    \/ releasePublication
    \/ acquireSignalMutex
    \/ signalWork
    \/ finishHead
    \/ claimLocal
    \/ claimQueue
    \/ popQueue
    \/ markTail
    \/ finishScan
    \/ finalEmptyProbe
    \/ lockTermination
    \/ probeRecheckQueue
    \/ countOrRetry
    \/ registerWait
    \/ spuriousWake
    \/ resume
    \/ finished

(*
  @type: (() => Bool);
*)
progress == [](terminal \/ ENABLED step) /\ (WF_{s}(step) => <>terminal)

(*
  @type: (() => Bool);
*)
q_step == step

(*
  @type: (() => Bool);
*)
q_inv == sourceSafe

(*
  @type: (() => Bool);
*)
q_temporalProps == progress

