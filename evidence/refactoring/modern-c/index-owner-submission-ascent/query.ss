(relation commitScenarioClassFact (scenario evidenceClass) (("current" "selected-source-and-native") ("missing-bootstrap" "selected-source-and-native") ("stale-tree" "selected-source-and-native") ("wrong-artifact" "selected-source-and-native") ("wrong-profile" "selected-source-and-native") ("model-only" "model-only")))
(relation commitSourceFact (head tree manifest profile) (("db7e3425152c7036aec4cc30b20dd188d034773a" "e27bb1ed6118134eef2aa07933a451cabae7b895" "b7d6b2c6c36033a8456848eaffecf9010502dfeda49947edef1e054b66485e0e" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69")))
