{
  "schema": "evidence-recipe.v2",
  "id": "dev-rest-original-stress-module-checks",
  "scope": "Isolated actual emitter and configured GCC/C23 checks; no core, bootstrap, Family A or Family 6 admission.",
  "budgetSeconds": 300,
  "workspacePolicy": "in-place",
  "inputs": [
    "evidence/fixtures/dev-rest-original-runner/source.lock.json",
    "patches/fixtures/dev-rest-original-runner.patch",
    "evidence/research/retained/modern-c/dev-rest-original-runner-bootstrap/completed-producer.json",
    "evidence/research/retained/modern-c/activation-storage/qualified-existing-profile.json",
    "evidence/research/retained/modern-c/stress-gsi/manifest.json",
    "evidence/research/retained/modern-c/stress-gsi/dev-family6-receipt-audit.json",
    "evidence/native-failures.json",
    "evidence/dsl/suite-review-rules.ss",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-rest-original-runner/observations.json",
    "evidence/fixtures/dev-rest-original-runner/binding.json"
  ],
  "steps": [
    {
      "id": "source",
      "capability": "gambit.materialize",
      "dependsOn": [],
      "budgetSeconds": 30,
      "arguments": {
        "sourceLock": "evidence/fixtures/dev-rest-original-runner/source.lock.json"
      }
    },
    {
      "id": "producer",
      "capability": "gambit.completed-runtime",
      "dependsOn": [
        "source"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "source": {
          "step": "source",
          "output": "source"
        },
        "producer": "evidence/research/retained/modern-c/dev-rest-original-runner-bootstrap/completed-producer.json"
      }
    },
    {
      "id": "check-kernel",
      "capability": "gambit.regenerate-module",
      "dependsOn": [
        "producer"
      ],
      "budgetSeconds": 120,
      "arguments": {
        "runtime": {
          "step": "producer",
          "output": "runtime"
        },
        "module": "lib/_kernel.scm",
        "syntaxCheck": true
      }
    },
    {
      "id": "check-nonstd",
      "capability": "gambit.regenerate-module",
      "dependsOn": [
        "producer"
      ],
      "budgetSeconds": 120,
      "arguments": {
        "runtime": {
          "step": "producer",
          "output": "runtime"
        },
        "module": "lib/_nonstd.scm",
        "syntaxCheck": true
      }
    },
    {
      "id": "check-system",
      "capability": "gambit.regenerate-module",
      "dependsOn": [
        "producer"
      ],
      "budgetSeconds": 120,
      "arguments": {
        "runtime": {
          "step": "producer",
          "output": "runtime"
        },
        "module": "lib/_system.scm",
        "syntaxCheck": true
      }
    },
    {
      "id": "module-check-evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "source",
        "producer",
        "check-kernel",
        "check-nonstd",
        "check-system"
      ],
      "budgetSeconds": 30,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "queries": {
          "missing_step": "missing_step"
        },
        "expected": {
          "missing_step": []
        }
      }
    }
  ]
}
