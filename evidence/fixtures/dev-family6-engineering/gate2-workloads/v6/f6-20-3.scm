(declare (extended-bindings))
(define-macro (at-depth)
  (let* ((targ (cdr (assq 'C c#targets-alist)))
         (p ((c#target-prim-info targ) '##map))
         (orig (vector-ref p 9))
         (tmpl (vector-ref ((c#target-prim-info targ) '##car) 14))
         (code (##closure-code tmpl))
         (const2 (lambda (v)
                   (let ((c (##make-closure code 1)))
                     (##closure-set! c 1 v)
                     c)))
         (tv0 (c#new-temp-variable #f 't0))
         (c-ntv (const2 (c#new-temp-variable #f 'tv)))
         (state-vec (vector '() (cons tv0 0)))
         (orig-ntv c#new-temp-variable)
         (orig-gtv c#gen-temp-vars)
         (orig-psa c#ptset-adjoin)
         (orig-ans c#add-not-safe)
         (orig-aptc c#add-proper-tail-calls)
         (orig-ncall c#new-call)
         (orig-nprc c#new-prc)
         (orig-ntst c#new-tst)
         (orig-gprc c#gen-prc))
    (vector-set!
     p 9
     (lambda (a1 a2 a3 a4 a5)
       (vector-set! p 9 orig)
       (let* ((orig-src (c#node-source a1))
              (cst-node (c#new-cst orig-src (c#node-env a1) #f))
              (c-gcall (const2 cst-node)))
         (c#node-source-set! a1 state-vec)
         (let rec ((k 2806))
           (if (##fx= k 0)
               (begin
                 (set! c#new-temp-variable c-ntv)
                 (set! c#gen-temp-vars ##vector-ref)
                 (set! c#ptset-adjoin ##first-argument)
                 (set! c#add-not-safe ##first-argument)
                 (set! c#add-proper-tail-calls ##first-argument)
                 (set! c#new-prc ##first-argument)
                 (set! c#new-tst ##first-argument)
                 (set! c#gen-prc ##first-argument)
                 (set! c#new-call ##first-argument)
                 (orig a1 a2 1 c-gcall #f)
                 (c#node-source-set! a1 orig-src)
                 (set! c#new-temp-variable orig-ntv)
                 (set! c#gen-temp-vars orig-gtv)
                 (set! c#ptset-adjoin orig-psa)
                 (set! c#add-not-safe orig-ans)
                 (set! c#add-proper-tail-calls orig-aptc)
                 (set! c#new-prc orig-nprc)
                 (set! c#new-tst orig-ntst)
                 (set! c#gen-prc orig-gprc)
                 (set! c#new-call orig-ncall)
                 cst-node)
               (let ((r (rec (##fx- k 1))))
                 (if r r #f))))))))
  '(begin))
(at-depth)
(define (w f x) (##map f x))
