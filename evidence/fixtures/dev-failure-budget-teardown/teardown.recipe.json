      "capability": "quint.test",
      "dependsOn": [
        "tear-parse"
      ],
      "budgetSeconds": 40,
      "arguments": {
        "source": "models/gambit/foreign_origin_vm_teardown.qnt",
        "parsed": "tear-parse",
        "main": "foreign_origin_vm_teardown",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "childP0BusyTest",
          "rootP0BusyTest",
          "partialCloseRollbackTest",
          "quiescentCommitTest"
        ]
