{
  "schema": "evidence-recipe.v2",
  "id": "dev-rest-caller-frame",
  "scope": "Sampled Quint controls for one rest caller-frame grant: exact fit, one-word-short refusal, collection only after a published caller frame, and one entry. Not a GSI trace, native admission, or family acceptance.",
  "budgetSeconds": 60,
  "inputs": [
    "dev/refactoring/modern-c/models/quint/smp_resume_closure_extent.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-rest-caller-frame/binding.json",
    "evidence/fixtures/dev-rest-caller-frame/observations.json",
    "evidence/fixtures/dev-rest-caller-frame/grant.recipe.json"
  ],
  "steps": [
    {
      "id": "parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "dev/refactoring/modern-c/models/quint/smp_resume_closure_extent.qnt"
      }
    },
    {
      "id": "qnt",
      "capability": "quint.test",
      "dependsOn": [
        "parse"
      ],
      "budgetSeconds": 30,
      "arguments": {
        "source": "dev/refactoring/modern-c/models/quint/smp_resume_closure_extent.qnt",
        "parsed": "parse",
        "main": "rest_caller_frame_grant",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "exactRetryAdmittedTest",
          "fastOneShortBoundaryTest",
          "oneShortRetryRefusedTest",
          "secondEntryControlTest",
          "windowCollectControlTest"
        ]
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "parse",
        "qnt"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "evidence/fixtures/dev-rest-caller-frame/binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField",
          "missing_step": "missing_step"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": [],
          "missing_step": []
        }
      }
    }
  ]
}
