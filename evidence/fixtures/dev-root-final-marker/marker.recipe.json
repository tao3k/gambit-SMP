{
  "schema": "evidence-recipe.v2",
  "id": "dev-root-final-marker",
  "scope": "Quint controls for one host-root refinement, one execution finalization, and one interrupted marker publication: protection without reload is not a moving allocation, a wall kill is not a completed commit, and a query does not replay an interrupted store. Not a GSI trace, native admission, or family acceptance.",
  "budgetSeconds": 240,
  "inputs": [
    "models/gambit/host_roots_refinement.qnt",
    "models/gambit/execution_finalization_custody.qnt",
    "models/gambit/marker_interrupted_publication.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-root-final-marker/binding.json",
    "evidence/fixtures/dev-root-final-marker/observations.json",
    "evidence/fixtures/dev-root-final-marker/marker.recipe.json"
  ],
  "steps": [
    {
      "id": "roots-parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/gambit/host_roots_refinement.qnt"
      }
    },
    {
      "id": "roots",
      "capability": "quint.test",
      "dependsOn": [
        "roots-parse"
      ],
      "budgetSeconds": 40,
      "arguments": {
        "source": "models/gambit/host_roots_refinement.qnt",
        "parsed": "roots-parse",
        "main": "host_roots_refinement",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "missingNonzeroScanControlTest",
          "activeNonzeroScanTest",
          "retainedDonorControlTest",
          "receiverCommitTest",
          "allocationReloadTest",
          "protectionWithoutReloadControlTest",
          "fixedSlotClobberControlTest",
          "lateProtectionControlTest",
          "allocationThrowTest",
          "nestedMatchedReturnTest",
          "nestedRethrowDrainTest",
          "wrongMarkerControlTest",
          "countIsNotBindingControlTest",
          "bindingRestoreTest"
        ]
      }
    },
    {
      "id": "final-parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/gambit/execution_finalization_custody.qnt"
      }
    },
    {
      "id": "final",
      "capability": "quint.test",
      "dependsOn": [
        "final-parse"
      ],
      "budgetSeconds": 30,
      "arguments": {
        "source": "models/gambit/execution_finalization_custody.qnt",
        "parsed": "final-parse",
        "main": "execution_finalization_custody",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "completedOverrunTest",
          "unfinishedTimeoutTest",
          "wallKillControlTest",
          "falsePassControlTest",
          "completedReviewDoesNotExpireOwnerTest",
          "oldReviewClockRejectsReapedOwnerTest",
          "stalledOwnerRemainsRejectedTest"
        ]
      }
    },
    {
      "id": "marker-parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/gambit/marker_interrupted_publication.qnt"
      }
    },
    {
      "id": "marker",
      "capability": "quint.test",
      "dependsOn": [
        "marker-parse"
      ],
      "budgetSeconds": 80,
      "arguments": {
        "source": "models/gambit/marker_interrupted_publication.qnt",
        "parsed": "marker-parse",
        "main": "marker_interrupted_publication",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "ordinaryCommitTest",
          "nextStoreAckLossTest",
          "headStoreAckLossTest",
          "interruptedNextReconstructionTest",
          "deathBeforeIssuedHeadTest",
          "storeAfterLogicalDeathTest",
          "generationDoesNotDrainTest",
          "lateStoreUnderRetainedLeaseTest",
          "unknownStopBlocksGcTest",
          "partialDecisionRebuiltTest",
          "commitStoreAckLossTest",
          "commitNotAppliedBeforeStopTest",
          "commitAppliedBeforeStopTest",
          "nullBeforeStopIsPendingTest",
          "queryDoesNotReplayTest",
          "helperWriterMustStopTest",
          "helperClosureAllowsGcTest",
          "metadataReaderDoesNotBlockGcTest",
          "recordRetirementTest",
          "journalLeadsDataCounterexampleTest",
          "repeatedHeadPushCounterexampleTest",
          "numericReplayCounterexampleTest",
          "decisionWithoutStopCounterexampleTest",
          "freeLinkedCounterexampleTest",
          "unrootedDecisionCounterexampleTest",
          "logicalDeathIsNotStopCounterexampleTest",
          "takeoverWithoutStopCounterexampleTest",
          "helperPendingStopCounterexampleTest",
          "reclaimPinnedRecordCounterexampleTest",
          "rawPointerAccessCounterexampleTest",
          "unexpectedHeadCounterexampleTest",
          "lateIssuedHeadAfterRevokeCounterexampleTest"
        ]
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "roots-parse",
        "roots",
        "final-parse",
        "final",
        "marker-parse",
        "marker"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "evidence/fixtures/dev-root-final-marker/binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField",
          "missing_step": "missing_step"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": [],
          "missing_step": []
        }
      }
    }
  ]
}
