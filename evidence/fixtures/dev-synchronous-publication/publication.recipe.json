{
  "schema": "evidence-recipe.v2",
  "id": "dev-synchronous-publication",
  "scope": "Quint controls for one synchronous publication across four sites: owner 0 is movable and owner 1 is a captured frame, an early return is not a published result, and an unknown fused site stays retained. Not a GSI trace, native admission, or family acceptance.",
  "budgetSeconds": 120,
  "inputs": [
    "models/gambit/synchronous_publication.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-synchronous-publication/binding.json",
    "evidence/fixtures/dev-synchronous-publication/observations.json",
    "evidence/fixtures/dev-synchronous-publication/publication.recipe.json"
  ],
  "steps": [
    {
      "id": "parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/gambit/synchronous_publication.qnt"
      }
    },
    {
      "id": "qnt",
      "capability": "quint.test",
      "dependsOn": [
        "parse"
      ],
      "budgetSeconds": 50,
      "arguments": {
        "source": "models/gambit/synchronous_publication.qnt",
        "parsed": "parse",
        "main": "synchronous_publication",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "allFourFusedTest",
          "callerResidualTest",
          "earlyReturnCounterexampleTest",
          "erasedUnknownKeepsIssuerTest",
          "escapedErasureCounterexampleTest",
          "fusedExplicitCostTest",
          "localBypassTest",
          "notifyLastUseTest",
          "referenceCostTest",
          "rejectRestoresPrivateTest",
          "residualCounterexampleTest",
          "resumeBeforeWorkTest",
          "unknownReconciledTest",
          "unknownRetainedTest",
          "unreadyFusionCounterexampleTest"
        ]
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "parse",
        "qnt"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "evidence/fixtures/dev-synchronous-publication/binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField",
          "missing_step": "missing_step"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": [],
          "missing_step": []
        }
      }
    }
  ]
}
