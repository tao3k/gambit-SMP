{
  "schema": "evidence-recipe.v2",
  "id": "dev-rest-half-capacity",
  "scope": "Quint check that an 8192-argument rest is 24576 words and fits an empty 65536-word half, while one word less does not. Not a GSI trace or the 295/300 campaign.",
  "budgetSeconds": 120,
  "inputs": [
    "dev/refactoring/modern-c/models/quint/rest_half_capacity.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-rest-half-capacity/binding.json",
    "evidence/fixtures/dev-rest-half-capacity/observations.json",
    "evidence/fixtures/dev-rest-half-capacity/half.recipe.json"
  ],
  "steps": [
    {
      "id": "parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "dev/refactoring/modern-c/models/quint/rest_half_capacity.qnt"
      }
    },
    {
      "id": "test",
      "capability": "quint.test",
      "dependsOn": [
        "parse"
      ],
      "budgetSeconds": 40,
      "arguments": {
        "source": "dev/refactoring/modern-c/models/quint/rest_half_capacity.qnt",
        "parsed": "parse",
        "main": "rest_half_capacity",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "argumentLimitBelowHalfTest",
          "fullBatchFitsEmptyHalfTest",
          "oneWordShortOfBatchRefusedTest",
          "shortCapacityPredicateOnlyTest"
        ]
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "parse",
        "test"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "evidence/fixtures/dev-rest-half-capacity/binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField",
          "missing_step": "missing_step"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": [],
          "missing_step": []
        }
      }
    }
  ]
}
