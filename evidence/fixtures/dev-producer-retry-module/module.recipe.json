{
  "schema": "evidence-recipe.v2",
  "id": "dev-producer-retry-module",
  "scope": "Joint non-overlapping formal gate: FrameContract.lean owns geometry/arithmetic; rest_frame_publication.qnt owns temporal retry/caller-callee custody. Source/native mapping, same-GSI A and original 295/300 family remain open; 5/12, runtimeAdmitted false.",
  "budgetSeconds": 180,
  "inputs": [
    "dev/refactoring/modern-c/models/quint/rest_frame_publication.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-producer-retry-module/binding.json",
    "evidence/fixtures/dev-producer-retry-module/observations.json",
    "evidence/fixtures/dev-producer-retry-module/module.recipe.json",
    "dev/refactoring/modern-c/models/lean/FrameContract.lean"
  ],
  "steps": [
    {
      "id": "parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "dev/refactoring/modern-c/models/quint/rest_frame_publication.qnt"
      }
    },
    {
      "id": "test",
      "capability": "quint.test",
      "dependsOn": [
        "parse"
      ],
      "budgetSeconds": 90,
      "arguments": {
        "source": "dev/refactoring/modern-c/models/quint/rest_frame_publication.qnt",
        "parsed": "parse",
        "main": "rest_frame_publication",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "backedRawSpillThenRefillTest",
          "cEntryRefillHasFreshEpochTest",
          "cEntryShortRetainsRootsTest",
          "callerDoneThenEntryFreshGrantTest",
          "callerGrantCannotAuthorizeEntryControlTest",
          "changedAttemptControlTest",
          "demandAwareHeapRetryTest",
          "demandAwareStackRetryTest",
          "duplicateCommitControlTest",
          "effectsBeforeServiceSettlementControlTest",
          "entryGrantBeforeStoreTest",
          "exhaustedRetainsMappedRootsTest",
          "expandedDemandUsesOneAttemptTest",
          "expansionAfterPublicationControlTest",
          "futureRefillCannotBackEarlierSpillControlTest",
          "gcEpochAloneIsNotEntryRoomTest",
          "globalGuardRecursionControlTest",
          "localProgressOrderTest",
          "missingReloadControlTest",
          "noSpillRoomBoundedFailureTest",
          "oldThresholdRetryCycleControlTest",
          "postAdjustmentLabelControlTest",
          "postPollArrivalCannotReuseGrantControlTest",
          "pregrantStoreControlTest",
          "priorCalleeFrameControlTest",
          "rawSpillNeedsExactMapControlTest",
          "restoredHandlerViewGrantControlTest",
          "sameEpochCursorReplayControlTest",
          "settledServiceAllowsNestedInterruptTest",
          "unknownRefillRetainsCustodyTest",
          "unqualifiedRefillKeepsCustodyTest",
          "unwoundButUncheckedRoomControlTest"
        ]
      }
    },
    {
      "id": "geometry",
      "capability": "lean.check",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "argv": [
          "dev/refactoring/modern-c/models/lean/FrameContract.lean"
        ]
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "parse",
        "test",
        "geometry"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "evidence/fixtures/dev-producer-retry-module/binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField",
          "missing_step": "missing_step"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": [],
          "missing_step": []
        }
      }
    }
  ]
}
