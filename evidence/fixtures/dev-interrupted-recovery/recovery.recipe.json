{
  "schema": "evidence-recipe.v2",
  "id": "dev-interrupted-recovery",
  "scope": "Quint controls for one interrupted producer recovery, one retained completion revalidation, one cleanup endpoint, and one still-init recovery: an interrupted producer is not a completed receipt, a retained completion must be revalidated, and cleanup does not take an endpoint it does not own. Not a GSI trace, native admission, or family acceptance.",
  "budgetSeconds": 280,
  "inputs": [
    "models/gambit/interrupted_producer_recovery.qnt",
    "models/gambit/retained_completion_revalidation.qnt",
    "models/gambit/cleanup_endpoint_ownership.qnt",
    "models/gambit/still_init_recovery.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-interrupted-recovery/binding.json",
    "evidence/fixtures/dev-interrupted-recovery/observations.json",
    "evidence/fixtures/dev-interrupted-recovery/recovery.recipe.json"
  ],
