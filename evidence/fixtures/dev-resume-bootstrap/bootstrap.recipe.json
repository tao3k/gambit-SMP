{
  "schema": "evidence-recipe.v2",
  "id": "dev-selected-full-bootstrap",
  "scope": "Locked DEV source and existing Bazel profile; source-core followed by mandatory known-failure preflight and unchanged 600-second two-pass bootstrap. Source, profile, retry lineage and all producer gates remain distinct from family acceptance.",
  "budgetSeconds": 600,
  "workspacePolicy": "in-place",
  "inputs": [
    "evidence/fixtures/dev-resume-selected-568e/source.lock.json",
    "patches/fixtures/dev-resume-selected-568e.patch",
    "evidence/research/retained/modern-c/activation-storage/qualified-existing-profile.json",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/native-failures.json",
    "evidence/dsl/suite-review-rules.ss",
    "evidence/fixtures/dev-resume-bootstrap/binding.json",
    "evidence/fixtures/dev-resume-bootstrap/observations.json"
  ],
  "steps": [
    {
      "id": "candidate",
      "capability": "gambit.materialize",
      "dependsOn": [],
      "arguments": {
        "sourceLock": "evidence/fixtures/dev-resume-selected-568e/source.lock.json",
        "buildWorkspace": "gambit-core"
      },
      "budgetSeconds": 30
    },
    {
      "id": "configure",
      "capability": "gambit.configure",
      "dependsOn": [
        "candidate"
      ],
      "arguments": {
        "source": {
          "step": "candidate",
          "output": "source"
        },
        "buildProfile": "evidence/research/retained/modern-c/activation-storage/qualified-existing-profile.json"
      },
      "budgetSeconds": 150
    },
    {
      "id": "seed",
      "capability": "gambit.seed-core",
      "dependsOn": [
        "configure"
      ],
      "arguments": {
        "source": {
          "step": "configure",
          "output": "source"
        }
      },
      "budgetSeconds": 600
    },
    {
      "id": "source-core",
      "capability": "gambit.source-core",
      "dependsOn": [
        "seed"
      ],
      "arguments": {
        "runtime": {
          "step": "seed",
          "output": "runtime"
        }
      },
      "budgetSeconds": 600
    },
    {
      "id": "bootstrap",
      "capability": "gambit.bootstrap",
      "dependsOn": [
        "source-core"
      ],
      "budgetSeconds": 600,
      "arguments": {
        "runtime": {
          "step": "source-core",
          "output": "runtime"
        },
        "identity": {
          "step": "source-core",
          "output": "identity"
        },
        "failures": "evidence/native-failures.json",
        "reviewRules": "evidence/dsl/suite-review-rules.ss"
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "candidate",
        "configure",
        "seed",
        "source-core",
        "bootstrap"
      ],
      "budgetSeconds": 30,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "evidence/fixtures/dev-resume-bootstrap/binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField",
          "missing_step": "missing_step"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": [],
          "missing_step": []
        }
      }
    }
  ]
}
