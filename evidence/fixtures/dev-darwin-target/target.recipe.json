{
  "schema": "evidence-recipe.v2",
  "id": "dev-darwin-target",
  "scope": "Quint arithmetic controls for one synthetic target projection: overhead, floor, cohort, parity, and acceleration bounds are unit-normalized checks. They are not measurements, a second scheduler, or the 295/300 original campaign. Not a GSI trace, native admission, or family acceptance.",
  "budgetSeconds": 120,
  "inputs": [
    "models/build/incremental_build.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-darwin-target/binding.json",
    "evidence/fixtures/dev-darwin-target/observations.json",
    "evidence/fixtures/dev-darwin-target/target.recipe.json"
  ],
  "steps": [
    {
      "id": "parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/build/incremental_build.qnt"
      }
    },
    {
      "id": "qnt",
      "capability": "quint.test",
      "dependsOn": [
        "parse"
      ],
      "budgetSeconds": 40,
      "arguments": {
        "source": "models/build/incremental_build.qnt",
        "parsed": "parse",
        "main": "darwin_development_work",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "targetAccelerationOverheadRejectsTest",
          "targetCohortRejectsTest",
          "targetFiveToThreeHalvesTest",
          "targetFiveToTwoTest",
          "targetFloorRejectsTest",
          "targetFourToThreeHalvesTest",
          "targetFourToTwoTest",
          "targetLinuxMovesTest",
          "targetOverheadRejectsTest",
          "targetParityRejectsTest",
          "targetRegressionRejectsTest",
          "targetTwofoldAccelerationTest"
        ]
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "parse",
        "qnt"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "evidence/fixtures/dev-darwin-target/binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField",
          "missing_step": "missing_step"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": [],
          "missing_step": []
        }
      }
    }
  ]
}
