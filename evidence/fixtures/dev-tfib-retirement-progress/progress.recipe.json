{
  "schema": "evidence-recipe.v2",
  "id": "dev-tfib-retirement-progress",
  "scope": "Quint controls for TFIB retirement correspondence and one GSI child progress cursor: a Scheme join is not processor retirement, a timeout symptom does not authorize attribution, and a quiet child can hide either work or no work. Not a GSI trace, native admission, or family acceptance.",
  "budgetSeconds": 180,
  "inputs": [
    "models/gambit/retirement_pre_exit.qnt",
    "models/gambit/tfib_retirement_correspondence.qnt",
    "models/gambit/gsi_child_progress.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-tfib-retirement-progress/binding.json",
    "evidence/fixtures/dev-tfib-retirement-progress/observations.json",
    "evidence/fixtures/dev-tfib-retirement-progress/progress.recipe.json"
  ],
  "steps": [
    {
      "id": "tfib-parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/gambit/tfib_retirement_correspondence.qnt"
      }
    },
    {
      "id": "tfib",
      "capability": "quint.test",
      "dependsOn": [
        "tfib-parse"
      ],
      "budgetSeconds": 50,
      "arguments": {
        "source": "models/gambit/tfib_retirement_correspondence.qnt",
        "parsed": "tfib-parse",
        "main": "tfib_retirement_correspondence",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "schemeJoinIsNotRetirementTest",
          "completeSteadyIntervalExcludesRetirementTest",
          "activatedWithoutWitnessIsUnknownTest",
          "entryDoesNotProveCallbackHazardTest",
          "foreignAndIncompleteWitnessesStayUnknownTest",
          "conflictingCensusDoesNotAuthorizeAttributionTest",
          "currentWithdrawBeforeCallbackControlTest",
          "stagedCallbackHandoffCompletesTest",
          "currentNormalJoinIsNotMissingBarrierTest",
          "stagedFailedJoinRetainsRootsTest",
          "currentFailedJoinRootGapControlTest",
          "symptomCannotJustifyAttributionControlTest"
        ]
      }
    },
    {
      "id": "child-parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/gambit/gsi_child_progress.qnt"
      }
    },
    {
      "id": "child",
      "capability": "quint.test",
      "dependsOn": [
        "child-parse"
      ],
      "budgetSeconds": 50,
      "arguments": {
        "source": "models/gambit/gsi_child_progress.qnt",
        "parsed": "child-parse",
        "main": "gsi_child_progress",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "quietCanHideWorkTest",
          "quietHostCpuAdvancesWithoutInbandRowTest",
          "hostCpuAndUnflushedSleepShareOneCursorTest",
          "bufferedSleepReturnStaysUnpublishedTest",
          "flushedSleepMarkerAdvancesCursorTest",
          "quietCanHideNoWorkTest",
          "hostValidationCannotBeChildGcTest",
          "generalNoBufferingFillsUnsetFileSlotTest",
          "fileSlotFullKeepsFilePortTest",
          "countReturnCanShareTheAbsentDigitObservationTest",
          "writerEntryCanShareTheAbsentDigitObservationTest"
        ]
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "tfib-parse",
        "tfib",
        "child-parse",
        "child"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "evidence/fixtures/dev-tfib-retirement-progress/binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField",
          "missing_step": "missing_step"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": [],
          "missing_step": []
        }
      }
    }
  ]
}
