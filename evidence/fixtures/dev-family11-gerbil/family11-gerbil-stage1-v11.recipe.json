{
  "schema": "evidence-recipe.v2",
  "id": "family11-gerbil-stage1-v11",
  "scope": "Family 11 (11/12: gerbil) downstream consumer stage1 closure (boot-gxi, stage0, stage1) bound directly to the sealed v11 Gambit producer under strict <8 GiB RSS; resuming from 128/185 durable stage0 module checkpoints with GERBIL_BUILD_CORES=4.",
  "timeoutPolicy": {
    "mode": "per-stage",
    "overheadSeconds": 30
  },
  "workspacePolicy": "in-place",
  "inputs": [
    "evidence/fixtures/dev-family8-10-unified/family8-10-v11.lock.json",
    "evidence/fixtures/dev-family8-10-unified/family8-10-v11.patch",
    "evidence/research/retained/modern-c/family8-10-v11/completed-producer.json",
    "evidence/fixtures/dev-family11-gerbil/gerbil-v11.lock.json",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-family11-gerbil/observations.json",
    "evidence/fixtures/dev-family11-gerbil/binding.json"
  ],
  "steps": [
    {
      "id": "source",
      "capability": "gambit.materialize",
      "dependsOn": [],
      "budgetSeconds": 60,
      "arguments": {
        "sourceLock": "evidence/fixtures/dev-family8-10-unified/family8-10-v11.lock.json"
      }
    },
    {
      "id": "producer",
      "capability": "gambit.completed-runtime",
      "dependsOn": [
        "source"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "source": {
          "step": "source",
          "output": "source"
        },
        "producer": "evidence/research/retained/modern-c/family8-10-v11/completed-producer.json"
      }
    },
    {
      "id": "gerbil",
      "capability": "gerbil.build",
      "dependsOn": [
        "producer"
      ],
      "budgetSeconds": 1800,
      "arguments": {
        "sourceLock": "evidence/fixtures/dev-family11-gerbil/gerbil-v11.lock.json",
        "runtime": {
          "step": "producer",
          "output": "runtime"
        },
        "identity": {
          "step": "producer",
          "output": "identity"
        },
        "throughStage": "stage1"
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "source",
        "producer",
        "gerbil"
      ],
      "budgetSeconds": 30,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "evidence/fixtures/dev-family11-gerbil/binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField",
          "missing_step": "missing_step"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": [],
          "missing_step": []
        }
      }
    }
  ]
}
