{
  "schema": "evidence-recipe.v2",
  "id": "dev-still-admission",
  "scope": "Quint controls for one still receipt, one still-init safepoint, and one materialization custody: a receipt is admitted only after the still point, init cannot pass the safepoint early, and materialization keeps custody until the frame is published. Not a GSI trace, native admission, or family acceptance.",
  "budgetSeconds": 280,
  "inputs": [
    "models/gambit/still_receipt_admission.qnt",
    "models/gambit/still_init_safepoint.qnt",
    "models/gambit/still_materialization_custody.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-still-admission/binding.json",
    "evidence/fixtures/dev-still-admission/observations.json",
    "evidence/fixtures/dev-still-admission/admission.recipe.json"
  ],
  "steps": [
