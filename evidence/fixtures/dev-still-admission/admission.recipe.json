      "id": "receipt-parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/gambit/still_receipt_admission.qnt"
      }
    },
    {
      "id": "receipt",
      "capability": "quint.test",
      "dependsOn": [
        "receipt-parse"
      ],
      "budgetSeconds": 70,
      "arguments": {
        "source": "models/gambit/still_receipt_admission.qnt",
        "parsed": "receipt-parse",
        "main": "still_receipt_admission",
        "seed": "0x11",
