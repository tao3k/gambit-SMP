{
  "schema": "evidence-recipe.v2",
  "id": "dev-rest-root-publication",
  "scope": "Quint controls for one rest allocator root publication: a known denial keeps the roots, a grant does not move the cursor, and a stale reload or a dropped root is refused. Not a GSI trace, native admission, or family acceptance.",
  "budgetSeconds": 120,
  "inputs": [
    "models/gambit/rest_allocator_root_publication.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-rest-root-publication/binding.json",
    "evidence/fixtures/dev-rest-root-publication/observations.json",
    "evidence/fixtures/dev-rest-root-publication/publication.recipe.json"
  ],
  "steps": [
    {
      "id": "parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/gambit/rest_allocator_root_publication.qnt"
      }
    },
    {
      "id": "qnt",
      "capability": "quint.test",
      "dependsOn": [
        "parse"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "source": "models/gambit/rest_allocator_root_publication.qnt",
        "parsed": "parse",
        "main": "rest_allocator_root_publication",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "knownDenyKeepsRootsTest",
          "grantDoesNotAdvanceCursorTest",
          "closeWaitsForLayoutTest",
          "closeCancelsUnusedTest",
          "enteredWriterDrainsTest",
          "unknownResultRemainsEscrowedTest",
          "reconcileAfterCloseTest",
          "relocateReloadReissueTest",
          "directCallProfileTest",
          "nativeCallProfileTest",
          "fullFrameScanTest",
          "rootPublicationCounterexampleTest",
          "concurrentLayoutScanCounterexampleTest",
          "partialFrameScanCounterexampleTest",
          "unknownRefundCounterexampleTest",
          "layoutAbaCounterexampleTest",
          "rootDropOnDenyCounterexampleTest",
          "staleRootReloadCounterexampleTest",
          "closeEnterSplitCounterexampleTest"
        ]
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "parse",
        "qnt"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
