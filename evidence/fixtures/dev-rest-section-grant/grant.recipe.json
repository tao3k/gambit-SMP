{
  "schema": "evidence-recipe.v2",
  "id": "dev-rest-section-grant",
  "scope": "Quint check that one eligible section grants one rest batch, and a short final extent publishes no partial batch. The two-owner histories distinguish a stale rollback from rejection before claim. Not a GSI trace, native admission, or the 295/300 campaign.",
  "budgetSeconds": 120,
  "inputs": [
    "dev/refactoring/modern-c/models/quint/rest_section_grant.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-rest-section-grant/binding.json",
    "evidence/fixtures/dev-rest-section-grant/observations.json",
    "evidence/fixtures/dev-rest-section-grant/grant.recipe.json"
  ],
  "steps": [
    {
      "id": "parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "dev/refactoring/modern-c/models/quint/rest_section_grant.qnt"
      }
    },
    {
      "id": "test",
      "capability": "quint.test",
      "dependsOn": [
        "parse"
      ],
      "budgetSeconds": 40,
      "arguments": {
        "source": "dev/refactoring/modern-c/models/quint/rest_section_grant.qnt",
        "parsed": "parse",
        "main": "rest_section_grant",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "exactExtentKeepsOneAssignmentTest",
          "failedExtentRefundsLedgerTest",
          "insufficientBudgetDoesNotClaimTest",
          "oneSectionOneGrantTest",
          "partialBatchStaysZeroTest",
          "preLockSnapshotCanUndoOtherGrantTest",
          "rejectBeforeClaimPreservesOtherGrantTest"
        ]
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "parse",
        "test"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "evidence/fixtures/dev-rest-section-grant/binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField",
          "missing_step": "missing_step"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": [],
          "missing_step": []
        }
      }
    }
  ]
}
