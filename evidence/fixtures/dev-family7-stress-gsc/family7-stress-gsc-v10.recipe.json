      "budgetSeconds": 295,
      "arguments": {
        "runtime": {
          "step": "producer",
          "output": "runtime"
        },
        "identity": {
          "step": "producer",
          "output": "identity"
        },
        "mode": "gsc",
        "regime": "whole-parallel",
        "inventory": "stress",
        "selection": [
          "."
        ],
        "expectedFiles": [
          "06-thread/tfib_stress.scm",
          "06-thread/thread_interrupt2_stress.scm",
          "06-thread/thread_interrupt_stress.scm",
          "06-thread/thread_terminate_stress.scm"
        ],
        "failures": "evidence/native-failures.json",
        "reviewRules": "evidence/dsl/suite-review-rules.ss",
        "orderedStress": {
          "manifest": "evidence/research/retained/modern-c/stress-gsc/manifest.json",
          "inputReceipt": "evidence/research/retained/modern-c/stress-gsi/dev-family6-receipt-audit.json",
          "profile": "evidence/research/retained/modern-c/activation-storage/qualified-existing-profile.json",
          "compiledHostReceipt": "evidence/fixtures/dev-family7-stress-gsc/link4-compiled-host-validation.json",
