    "evidence/research/retained/modern-c/stress-gsc/manifest.json",
    "evidence/research/retained/modern-c/stress-gsi/dev-family6-receipt-audit.json",
    "evidence/fixtures/dev-family7-stress-gsc/link4-compiled-host-validation.json",
    "evidence/native-failures.json",
