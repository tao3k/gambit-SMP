    "models/build/native_wake_channel.qnt",
    "models/build/gate_empty_root_materialization.qnt",
    "models/build/foreign_cleanup_closure.qnt",
    "models/build/marker_audit_quiescence.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
