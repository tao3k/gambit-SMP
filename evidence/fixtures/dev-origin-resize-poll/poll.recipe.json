      "budgetSeconds": 100,
      "arguments": {
        "source": "models/gambit/resize_bootstrap_admission.qnt",
        "parsed": "resize-parse",
        "main": "resize_bootstrap_admission",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "mappedOriginRegistrationTest",
          "closeWinnerRetainsCallerTest",
          "deferMoveReopenReloadRegisterTest",
          "registerWinnerIncludedInGcTest",
          "creationBeforeCloseRetainsRootTest",
          "childBeforeCreateReturnTest",
          "fullSuccessGenerationCommitTest",
          "partialFailureKeepsSuccessfulSiblingTest",
          "partialFailureDrainAndCleanupTest",
          "unknownChildKeepsEscrowTest",
          "unknownChildLateEntryTest",
          "unknownSettlesSuccessThenDrainsTest",
          "unknownConfirmedNoChildTest",
          "partialSetupIdentityCleanupTest",
          "neverAttemptedPreparedChildCleanupTest",
          "gcDuringPartialRollbackTest",
          "readyChildrenCannotCommitDuringClosedGcCounterexampleTest",
          "lateRegistrationMissingSnapshotCounterexampleTest",
