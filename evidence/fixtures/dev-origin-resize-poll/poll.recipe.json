          "unknownResultReclaimCounterexampleTest",
          "partialInitReceiptMissingCounterexampleTest",
          "retrySameCreateGenerationCounterexampleTest",
          "duplicatePstateCleanupCounterexampleTest"
        ]
      }
    },
    {
      "id": "poll-parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/gambit/structure_poll_still_envelope.qnt"
      }
    },
    {
      "id": "poll",
      "capability": "quint.test",
      "dependsOn": [
        "poll-parse"
      ],
      "budgetSeconds": 100,
      "arguments": {
        "source": "models/gambit/structure_poll_still_envelope.qnt",
        "parsed": "poll-parse",
        "main": "structure_poll_still_envelope",
        "seed": "0x11",
