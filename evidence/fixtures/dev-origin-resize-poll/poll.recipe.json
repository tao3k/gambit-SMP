{
  "schema": "evidence-recipe.v2",
  "id": "dev-origin-resize-poll",
  "scope": "Quint controls for one origin bind commit, one resize bootstrap admission, and one structure-poll still envelope: a bind journal commits one candidate slot, a moving epoch keeps the required child view, and a still envelope does not forward an unpinned poll. Not a GSI trace, native admission, or family acceptance.",
  "budgetSeconds": 360,
  "inputs": [
    "models/gambit/origin_bind_commit.qnt",
    "models/gambit/resize_bootstrap_admission.qnt",
    "models/gambit/structure_poll_still_envelope.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-origin-resize-poll/binding.json",
    "evidence/fixtures/dev-origin-resize-poll/observations.json",
    "evidence/fixtures/dev-origin-resize-poll/poll.recipe.json"
  ],
  "steps": [
    {
      "id": "origin-parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/gambit/origin_bind_commit.qnt"
      }
    },
    {
      "id": "origin",
      "capability": "quint.test",
      "dependsOn": [
        "origin-parse"
      ],
      "budgetSeconds": 100,
      "arguments": {
        "source": "models/gambit/origin_bind_commit.qnt",
        "parsed": "origin-parse",
        "main": "origin_bind_commit",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "fullNormalBindCommitTest",
          "admittedDuringCloseKeepsFrozenSourceTest",
          "firstHostWithoutRegisteredSourceRefusesTest",
          "stopBeforeCasSealsNoEffectTest",
          "lostCasReplyReconcilesOwnedHeaderTest",
          "delayedCasAfterObservedExitStillOwnedTest",
          "competitorWinsNeverInitializesOtherSlotTest",
          "firstFieldStoreWithoutProgressCanRepairTest",
          "secondFieldStoreWithoutLogCanRepairTest",
          "locatorPublishedReplyLostReusesSameCellTest",
          "exitBeforeLocatorHelperPublishesItTest",
          "privateMetadataCanInitializeDuringGcCloseTest",
          "staleSourceReloadBeforeRootAdmissionTest",
          "acceptedRootMovesBeforeCommitTest",
          "stoppedHelperNeverReplaysOldPayloadTest",
          "committedReplyLostOnlyQueriesTest",
          "sourceAckDuringScanKeepsPhysicalViewTest",
          "unknownExitStillAllowsGcFromFrozenViewTest",
          "abortedBeforeAcceptanceCanReleaseAfterScanTest",
          "committedFinishRequiresSeparateResultAckTest",
          "cellQueryPinDrainsBeforeReuseTest",
          "missingPortCannotAdmitCounterexampleTest",
          "unregisteredSourceCannotAdmitCounterexampleTest",
          "observedExitNotControlStopCounterexampleTest",
          "liveCasCannotBeDeclaredClosedCounterexampleTest",
          "liveDataStoreCannotBeDeclaredClosedCounterexampleTest",
          "incompleteFieldsCannotCommitCounterexampleTest",
          "locatorMissingCannotCommitCounterexampleTest",
          "sideEffectBeforeCommitCounterexampleTest",
          "movedRootCannotReceiveCachedPayloadCounterexampleTest",
          "descriptorCoverageCannotDropSourceScannerCounterexampleTest",
          "sourceOnlyCannotBeDroppedCounterexampleTest",
          "resultUnknownCannotFreeCounterexampleTest",
          "queryPinCannotBeFreedCounterexampleTest",
          "competitorMetadataCannotBeRepairedCounterexampleTest",
          "latePrivateStoreAfterExitObservationTest",
          "gcWhileUnknownPrivateStoreStillInFlightTest",
          "failedClaimRecyclesJournalButNotCompetitorSlotTest",
          "progressBeforeActualStoreCounterexampleTest"
        ]
      }
    },
    {
      "id": "resize-parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/gambit/resize_bootstrap_admission.qnt"
      }
    },
    {
      "id": "resize",
      "capability": "quint.test",
      "dependsOn": [
        "resize-parse"
