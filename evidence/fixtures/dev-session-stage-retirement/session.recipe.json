      "budgetSeconds": 60,
      "arguments": {
        "source": "models/build/alias_workspace_reconstruction.qnt",
        "parsed": "alias-parse",
        "main": "alias_workspace_reconstruction",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "reconstructionTest",
          "twoPrivateTest",
          "sharingPreservedTest",
          "unknownRecipeDeniedTest",
          "partialUnknownRetainsTest",
          "failureDrainTest",
          "originRejectsTest",
          "identityRejectsTest",
          "canonicalTagTest",
          "lateFailureBeforePublishTest",
          "shallowTargetControlTest",
          "shallowSelfControlTest",
          "copiedTagControlTest",
          "collapsedIdentityControlTest",
          "ignoredOriginControlTest",
          "unknownReleaseControlTest"
        ]
      }
