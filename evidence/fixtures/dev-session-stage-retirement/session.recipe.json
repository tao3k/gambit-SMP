{
  "schema": "evidence-recipe.v2",
  "id": "dev-session-stage-retirement",
  "scope": "Quint controls for one session closure, one target-stage seal, one alias-workspace reconstruction, and one retirement root handler: two sessions do not share an address, a snapshot is not admission, identity and origin stay distinct, and a destination root is not the source root. Not a GSI trace, native admission, or family acceptance.",
  "budgetSeconds": 280,
  "inputs": [
    "models/build/gerbil_session_closure.qnt",
    "models/build/target_stage_sealing.qnt",
    "models/build/alias_workspace_reconstruction.qnt",
    "models/experimental/retirement_root_handler_composition.qnt",
    "models/build/gerbil_session_topology.qnt",
    "models/build/target_sealing_parameters.qnt",
    "models/build/alias_workspace_parameters.qnt",
    "models/gambit/public_vm_retirement_composition.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-session-stage-retirement/binding.json",
    "evidence/fixtures/dev-session-stage-retirement/observations.json",
    "evidence/fixtures/dev-session-stage-retirement/session.recipe.json"
  ],
  "steps": [
    {
      "id": "session-parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/build/gerbil_session_closure.qnt"
      }
    },
    {
      "id": "session",
      "capability": "quint.test",
      "dependsOn": [
        "session-parse"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "source": "models/build/gerbil_session_closure.qnt",
        "parsed": "session-parse",
        "main": "gerbil_session_closure",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "sourceCensusBlocksTest",
          "unknownEffectsBlockTest",
          "missingSsxiBlocksTest",
          "emittedRuntimeExcludedTest",
          "independentWritesTest",
          "oppositeOrderTest",
          "cancellationPinsTest",
          "physicalExitStillPinsTest",
          "finalReleaseTest",
          "staleSupportBlocksNewSessionTest",
          "sameEpochPublicationTest",
          "deepAliasControlTest",
          "mutableSharedControlTest",
          "staleCommitControlTest",
          "pinnedEvictionControlTest",
          "liftedSyntaxQuoteAliasControlTest"
        ]
      }
    },
    {
      "id": "stage-parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/build/target_stage_sealing.qnt"
      }
    },
    {
      "id": "stage",
      "capability": "quint.test",
      "dependsOn": [
        "stage-parse"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "source": "models/build/target_stage_sealing.qnt",
        "parsed": "stage-parse",
        "main": "target_stage_sealing",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "writerDrainTest",
          "lateWriterDeniedTest",
          "twoPrivateConsumersTest",
          "releaseAfterSealTest",
          "exclusiveSingleTest",
          "unknownHoldsTest",
          "errorDeliveryTest",
          "originRejectTest",
          "declarationRejectTest",
          "identityRejectTest",
          "activeWriterSealControlTest",
          "retainedAliasSealControlTest",
          "snapshotMutationControlTest",
          "exclusiveCacheControlTest",
          "originIgnoredControlTest",
          "unknownReleaseControlTest"
        ]
      }
    },
    {
      "id": "alias-parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/build/alias_workspace_reconstruction.qnt"
      }
    },
