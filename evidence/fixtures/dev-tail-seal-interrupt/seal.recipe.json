  "inputs": [
    "models/gambit/guaranteed_tail_placement.qnt",
    "models/gambit/resume_seal_cleanup.qnt",
    "models/gambit/procedural_interrupt_retirement.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
