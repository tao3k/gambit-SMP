      "arguments": {
        "source": "models/gambit/native_failure_scope.qnt"
      }
    },
    {
      "id": "fail",
      "capability": "quint.test",
      "dependsOn": [
        "fail-parse"
      ],
      "budgetSeconds": 40,
      "arguments": {
        "source": "models/gambit/native_failure_scope.qnt",
        "parsed": "fail-parse",
