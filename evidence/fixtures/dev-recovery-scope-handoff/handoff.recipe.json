        "source": "models/gambit/registry_capacity_writer_replay.qnt"
      }
    },
    {
      "id": "replay",
      "capability": "quint.test",
      "dependsOn": [
        "replay-parse"
      ],
      "budgetSeconds": 40,
      "arguments": {
        "source": "models/gambit/registry_capacity_writer_replay.qnt",
