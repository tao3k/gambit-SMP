      "arguments": {
        "source": "models/gambit/host_environment_recovery.qnt"
      }
    },
    {
      "id": "host",
      "capability": "quint.test",
      "dependsOn": [
        "host-parse"
      ],
      "budgetSeconds": 40,
      "arguments": {
        "source": "models/gambit/host_environment_recovery.qnt",
        "parsed": "host-parse",
        "main": "host_environment_recovery",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
