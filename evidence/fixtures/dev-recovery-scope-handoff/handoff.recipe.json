{
  "schema": "evidence-recipe.v2",
  "id": "dev-recovery-scope-handoff",
  "scope": "Quint controls for one host-environment recovery, one native failure scope, one registry capacity replay, and one seed checkpoint handoff: a successful bind is not a native admission, a containing campaign does not enlarge a case cap, two slots bound one writer replay, and an exact checkpoint is not a resumed bypass. Not a GSI trace, native admission, or family acceptance.",
  "budgetSeconds": 200,
  "inputs": [
    "models/gambit/host_environment_recovery.qnt",
    "models/gambit/native_failure_scope.qnt",
    "models/gambit/registry_capacity_writer_replay.qnt",
    "models/gambit/seed_checkpoint_handoff.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-recovery-scope-handoff/binding.json",
    "evidence/fixtures/dev-recovery-scope-handoff/observations.json",
    "evidence/fixtures/dev-recovery-scope-handoff/handoff.recipe.json"
  ],
  "steps": [
