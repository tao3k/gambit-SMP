{
  "schema": "evidence-recipe.v2",
  "id": "dev-bootstrap-root-recovery",
  "scope": "Quint controls for one bootstrap root recovery: a lost accepted reply is queried by the same identity, a restored frame must be reloaded, and an old acknowledgment cannot drop the new pin. Not a GSI trace, native admission, or family acceptance.",
  "budgetSeconds": 180,
  "inputs": [
    "models/gambit/bootstrap_root_recovery.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-bootstrap-root-recovery/binding.json",
    "evidence/fixtures/dev-bootstrap-root-recovery/observations.json",
    "evidence/fixtures/dev-bootstrap-root-recovery/recovery.recipe.json"
  ],
  "steps": [
    {
      "id": "parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/gambit/bootstrap_root_recovery.qnt"
      }
    },
    {
      "id": "qnt",
      "capability": "quint.test",
      "dependsOn": [
        "parse"
      ],
      "budgetSeconds": 110,
      "arguments": {
        "source": "models/gambit/bootstrap_root_recovery.qnt",
        "parsed": "parse",
        "main": "bootstrap_root_recovery",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "acceptedReplyLostQuerySameIdentityTest",
          "pendingReplyLostDuplicateNoAllocationTest",
          "acceptedDuplicateNoSecondRootTest",
          "mismatchedIntentRejectedTest",
          "absentWithInflightKeepsSourceTest",
          "closedPendingKeepsSourceTest",
          "closedPendingMoveReloadAcceptTest",
          "acceptedQueryBeforeMoveAckAfterMoveTest",
          "logicalAckKeepsScanningPinTest",
          "lostAckReplayDropsOnceTest",
          "restoreThenOldSourceAckKeepsNewPinTest",
          "ackThenRestoreReloadNewBindingTest",
          "pendingExceptionVmKeepsRootViewTest",
          "acceptedExceptionQueriesFromVmTest",
          "nestedBorrowFinishesBeforeAckTest",
          "cancelWinsBeforeAcceptanceTest",
          "staleQueryAfterCancelRetainsSourceTest",
          "acceptedCancelWaitsConsumerDrainTest",
          "terminalAckAndTombstonePurgeTest",
          "delayedDuplicateBeforePurgeSettledTest",
          "queryPinDelaysPurgeTest",
          "cancelUnseenBlocksDelayedAdmissionTest",
          "exceptionBeforeArrivalVmCancelsTest",
          "wrongQueryKeyCannotAuthorizeAckCounterexampleTest",
          "staleQueryAfterCancelCannotAckCounterexampleTest",
          "exceptionMustCloseFutureAdmissionCounterexampleTest",
          "sourceAckAloneKeepsOutcomeTombstoneTest",
          "queryRetiredFenceCannotRecreateRootTest",
          "sourceAckCannotReplaceResultAckCounterexampleTest",
          "deadCActivationCannotBorrowAgainCounterexampleTest",
          "repeatRegisterAllocatesTwiceCounterexampleTest",
          "missingQueryDoesNotMeanNoEffectCounterexampleTest",
          "ackCannotDropActiveScanPinCounterexampleTest",
          "ackCannotEraseSchemeFrameMapCounterexampleTest",
          "oldAckCannotDropRestoredPinCounterexampleTest",
          "restoredFrameNeedsReloadCounterexampleTest",
          "logicalAckCannotApplyTwiceCounterexampleTest",
          "activeConsumerPreventsRootRetireCounterexampleTest",
          "terminalKeyCannotPublishAgainCounterexampleTest",
          "forgottenFrontierAllowsStaleIdentityCounterexampleTest",
          "queryPinPreventsTombstoneFreeCounterexampleTest"
        ]
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "parse",
        "qnt"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "evidence/fixtures/dev-bootstrap-root-recovery/binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField",
          "missing_step": "missing_step"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": [],
          "missing_step": []
        }
      }
    }
  ]
}
