{
  "schema": "evidence-recipe.v2",
  "id": "dev-park-root-reentry",
  "scope": "Quint controls for one participating park root view and one future-epoch reentry: the collector may rewrite a frozen cell, the native frame stays live while scanning, and a parked resume does not start the callee again. Not a GSI trace, native admission, or family acceptance.",
  "budgetSeconds": 220,
  "inputs": [
    "models/gambit/participating_park_root_view.qnt",
    "models/gambit/future_epoch_reentry_gate.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-park-root-reentry/binding.json",
    "evidence/fixtures/dev-park-root-reentry/observations.json",
    "evidence/fixtures/dev-park-root-reentry/reentry.recipe.json"
  ],
  "steps": [
