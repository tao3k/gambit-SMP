        "source": "models/gambit/future_epoch_reentry_gate.qnt"
      }
    },
    {
      "id": "epoch",
      "capability": "quint.test",
      "dependsOn": [
        "epoch-parse"
      ],
      "budgetSeconds": 80,
      "arguments": {
        "source": "models/gambit/future_epoch_reentry_gate.qnt",
        "parsed": "epoch-parse",
        "main": "future_epoch_reentry_gate",
        "seed": "0x11",
