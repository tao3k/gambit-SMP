      "capability": "quint.test",
      "dependsOn": [
        "park-parse"
      ],
      "budgetSeconds": 80,
      "arguments": {
        "source": "models/gambit/participating_park_root_view.qnt",
        "parsed": "park-parse",
        "main": "participating_park_root_view",
        "seed": "0x11",
