{
  "schema": "evidence-recipe.v2",
  "id": "dev-rest-park-resume",
  "scope": "Quint controls for one rest park cut and one GC resume envelope: one body entry, preserved rest order, and refusal of a partial frame or an early collection. Not a GSI trace, native admission, or family acceptance.",
  "budgetSeconds": 200,
  "inputs": [
    "models/gambit/rest_frame_park_cut.qnt",
    "models/gambit/rest_gc_resume_envelope.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-rest-park-resume/binding.json",
    "evidence/fixtures/dev-rest-park-resume/observations.json",
    "evidence/fixtures/dev-rest-park-resume/park.recipe.json"
  ],
  "steps": [
    {
      "id": "park-parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/gambit/rest_frame_park_cut.qnt"
      }
    },
    {
      "id": "park",
      "capability": "quint.test",
      "dependsOn": [
        "park-parse"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "source": "models/gambit/rest_frame_park_cut.qnt",
        "parsed": "park-parse",
        "main": "rest_frame_park_cut",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "originalCallResumeTest",
          "restOrderPreservedTest",
          "localLeaseDuringRepairTest",
          "vectorIncompleteStillSourceTest",
          "frameBeforeParkTest",
          "lateWriterBeforeSpillTest",
          "unknownWriteRetainsCustodyTest",
          "reconciledWriteCanParkTest",
          "lostAckNoReplayTest",
          "collectorUpdatesPackedRootsTest",
          "exitWhilePartialIsPendingTest",
          "exitWhileScanningWaitsTest",
          "exitBeforeAcceptUsesSameAttemptTest",
          "fullFixedArgumentProfileTest",
          "partialFrameParkCounterexampleTest",
          "partialFrameGcCounterexampleTest",
          "incompleteVectorCounterexampleTest",
          "localLeaseDroppedCounterexampleTest",
          "borrowedNativeAliasCounterexampleTest",
          "preCloseWriterStillLiveCounterexampleTest",
          "unknownWriterCannotParkCounterexampleTest",
          "missingFrameMapCounterexampleTest",
          "publicationNotAcceptanceCounterexampleTest",
          "lateWriteAfterReceiptCounterexampleTest",
          "nativeFrameDeathCounterexampleTest",
          "scanExitOverlapCounterexampleTest",
          "scanNormalOverlapCounterexampleTest",
          "missingWholeRoundCounterexampleTest",
          "contextMissingCounterexampleTest",
          "staleRootAfterNextCounterexampleTest",
          "nativeReplayCounterexampleTest",
          "duplicateRestConsCounterexampleTest",
          "badRestOrderingCounterexampleTest",
          "nargsSentinelMissingCounterexampleTest",
          "normalExitBothClaimCounterexampleTest",
          "secondNormalClaimCounterexampleTest",
          "entryStillOpenCounterexampleTest",
          "missingPhysicalReservationCounterexampleTest",
          "pendingExitMustWinCounterexampleTest",
          "inventedExitCounterexampleTest"
        ]
      }
    },
    {
      "id": "envelope-parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "models/gambit/rest_gc_resume_envelope.qnt"
      }
    },
    {
      "id": "envelope",
      "capability": "quint.test",
      "dependsOn": [
        "envelope-parse"
      ],
      "budgetSeconds": 40,
      "arguments": {
        "source": "models/gambit/rest_gc_resume_envelope.qnt",
        "parsed": "envelope-parse",
        "main": "rest_gc_resume_envelope",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "completionAndResumeTest",
          "exactSuffixTest",
          "zeroHeapRestoreTest",
          "unknownCustodyTest",
          "afterForwardFailureTest",
          "capturedCarrierTest",
          "deadAndDrainedTest",
          "lateRefundTest",
          "refusalTest",
          "smallCompletionControlTest",
          "earlyGcControlTest",
          "unknownResumeControlTest",
          "carrierFreeControlTest",
          "doubleCreditControlTest",
          "lostInitializerControlTest",
          "peakRewriteControlTest"
        ]
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "park-parse",
        "park",
        "envelope-parse",
        "envelope"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "evidence/fixtures/dev-rest-park-resume/binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField",
          "missing_step": "missing_step"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": [],
          "missing_step": []
        }
      }
    }
  ]
}
