        "source": "dev/refactoring/modern-c/models/quint/smp_interpreter_source_order.qnt"
      }
    },
    {
      "id": "qnt",
      "capability": "quint.test",
      "dependsOn": ["parse"],
      "budgetSeconds": 30,
      "arguments": {
        "source": "dev/refactoring/modern-c/models/quint/smp_interpreter_source_order.qnt",
        "parsed": "parse",
        "main": "smp_interpreter_source_order",
        "seed": "0x51",
