{
  "schema": "evidence-recipe.v2",
  "id": "dev-interpreter-source-order",
  "scope": "Quint controls for the current interpreter source order and the generated alloc-before-check shape. A hook can suppress or repeat the RTE vector; removing that vector does not remove app1-red or app2-sub. Parent passage requires the sync call and no held reader. CHECK_HEAP does not evaluate its reservation. The 1973*5000*(6000+2) figure remains conditional arithmetic. No interpreter edit, measured speedup, native barrier, or generated allocation witness is claimed.",
  "budgetSeconds": 70,
  "inputs": [
