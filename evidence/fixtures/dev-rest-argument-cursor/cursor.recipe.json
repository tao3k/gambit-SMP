{
  "schema": "evidence-recipe.v2",
  "id": "dev-rest-argument-cursor",
  "scope": "Quint check that a rest refusal keeps the caller argument word, the free-cursor sentinel, and zero pops and pair writes. Not a GSI trace, native admission, or the 295/300 campaign.",
  "budgetSeconds": 120,
  "inputs": [
    "dev/refactoring/modern-c/models/quint/rest_argument_cursor.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-rest-argument-cursor/binding.json",
    "evidence/fixtures/dev-rest-argument-cursor/observations.json",
    "evidence/fixtures/dev-rest-argument-cursor/cursor.recipe.json"
  ],
  "steps": [
    {
      "id": "parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "dev/refactoring/modern-c/models/quint/rest_argument_cursor.qnt"
      }
    },
    {
      "id": "test",
      "capability": "quint.test",
      "dependsOn": [
        "parse"
      ],
      "budgetSeconds": 40,
      "arguments": {
        "source": "dev/refactoring/modern-c/models/quint/rest_argument_cursor.qnt",
        "parsed": "parse",
        "main": "rest_argument_cursor",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "cutArgMatchesEntryTest",
          "heapWordIsSentinelTest",
          "keyRestArgumentHeldTest",
          "ordinaryArgumentHeldTest",
          "poppedCursorIsNotHeldTest",
          "restKeyArgumentHeldTest",
          "taggedCallArgumentsTest"
        ]
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "parse",
        "test"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "evidence/fixtures/dev-rest-argument-cursor/binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField",
          "missing_step": "missing_step"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": [],
          "missing_step": []
        }
      }
    }
  ]
}
