{
  "schema": "evidence-recipe.v2",
  "id": "dev-rest-slot-repair",
  "scope": "Quint controls for one rest refusal after a moving collection: a heap root word may change, an immediate word stays, and the argument cursor is not popped. Not a GSI trace, native admission, or the 295/300 campaign.",
  "budgetSeconds": 120,
  "inputs": [
    "dev/refactoring/modern-c/models/quint/rest_slot_repair.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-rest-slot-repair/binding.json",
    "evidence/fixtures/dev-rest-slot-repair/observations.json",
    "evidence/fixtures/dev-rest-slot-repair/repair.recipe.json"
  ],
  "steps": [
    {
      "id": "parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {
        "source": "dev/refactoring/modern-c/models/quint/rest_slot_repair.qnt"
      }
    },
    {
      "id": "test",
      "capability": "quint.test",
      "dependsOn": [
        "parse"
      ],
      "budgetSeconds": 40,
      "arguments": {
        "source": "dev/refactoring/modern-c/models/quint/rest_slot_repair.qnt",
        "parsed": "parse",
        "main": "rest_slot_repair",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "cursorUnchangedOnRefusalTest",
          "exactFitIsNotRefusalTest",
          "heapSlotRewrittenTest",
          "immediateSlotStableTest",
          "keywordCursorUnchangedTest"
        ]
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "parse",
        "test"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "evidence/fixtures/dev-rest-slot-repair/binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField",
          "missing_step": "missing_step"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": [],
          "missing_step": []
        }
      }
    }
  ]
}
