{
  "schema": "evidence-recipe.v2",
  "id": "dev-rest-soft-grant",
  "scope": "Quint check that a two-pair rest fits six words at the soft limit and does not take the fast grant at five or four. Not a GSI trace, native admission, or the 295/300 campaign.",
  "budgetSeconds": 120,
  "inputs": [
    "dev/refactoring/modern-c/models/quint/rest_soft_grant.qnt",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss",
    "evidence/fixtures/dev-rest-soft-grant/binding.json",
    "evidence/fixtures/dev-rest-soft-grant/observations.json",
    "evidence/fixtures/dev-rest-soft-grant/soft.recipe.json"
  ],
  "steps": [
    {
      "id": "parse",
      "capability": "quint.parse",
      "dependsOn": [],
      "budgetSeconds": 20,
      "arguments": {"source": "dev/refactoring/modern-c/models/quint/rest_soft_grant.qnt"}
    },
    {
      "id": "test",
      "capability": "quint.test",
      "dependsOn": ["parse"],
      "budgetSeconds": 40,
      "arguments": {
        "source": "dev/refactoring/modern-c/models/quint/rest_soft_grant.qnt",
        "parsed": "parse",
        "main": "rest_soft_grant",
        "seed": "0x11",
        "maxSamples": 1,
        "expectedTests": [
          "exactSoftFitTest",
          "oneWordShortIsNotFastTest",
          "slackStillFitsTest"
        ]
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": ["parse", "test"],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "evidence/fixtures/dev-rest-soft-grant/binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField",
          "missing_step": "missing_step"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": [],
          "missing_step": []
        }
      }
    }
  ]
}
