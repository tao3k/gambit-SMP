# pyDatalog rule syntax; fixed trusted repository input, not user report code.
has_model(P) <= pr_model(P, M)
known_pr(P) <= pr(P, H, S)
context_needs_report(M, P) <= model_context_pr(M, P) & ~known_pr(P)
needs_model(P) <= pr(P, H, S) & ~has_model(P)
has_native(M) <= native_adapter(M, F)
needs_native(M) <= model(M, H, K) & ~has_native(M)
dependency_path(P, D) <= dependency(P, D)
dependency_path(P, D) <= dependency(P, X) & dependency_path(X, D)
shared_obligation(P, D, M) <= pr_model(P, M) & pr_model(D, M) & (P < D)
