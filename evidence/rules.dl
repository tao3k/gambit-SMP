# pyDatalog rule syntax; fixed trusted repository input, not user report code.
has_model(P) <= pr_model(P, M)
known_pr(P) <= pr(P, H, S)
context_needs_report(M, P) <= model_context_pr(M, P) & ~known_pr(P)
needs_model(P) <= pr(P, H, S) & report_kind(P, 'runtime-repair') & ~has_model(P)
has_snapshot(P) <= report_snapshot(P, H, D, N)
needs_snapshot(P) <= pr(P, H, S) & ~has_snapshot(P)
has_native(M) <= native_adapter(M, F)
needs_native(M) <= model(M, H, K) & ~has_native(M)
dependency_path(P, D) <= dependency(P, D)
dependency_path(P, D) <= dependency(P, X) & dependency_path(X, D)
shared_obligation(P, D, M) <= pr_model(P, M) & pr_model(D, M) & (P < D)
triage_open(P) <= window_disposition(P, 'adjacent-source-overlap-review-open')
local_has_model(F) <= local_failure_model(F, M)
local_needs_model(F) <= local_native_failure(F, 'assertion', S, D) & ~local_has_model(F)
local_environment(F) <= local_native_failure(F, 'environment', S, D)
local_budget(F) <= local_native_failure(F, 'budget', S, D)
local_has_control(F) <= local_control_pass(F, K, M, D)
local_budget_uncontrolled(F) <= local_budget(F) & ~local_has_control(F)
local_signal(F) <= local_native_failure(F, 'signal', S, D)
contract_path(M, D) <= model_contract(M, D, O)
contract_path(M, D) <= model_contract(M, X, O) & contract_path(X, D)
paper_needs_native(M) <= model_paper(M, P, S) & ~has_native(M)
contract_needs_native(M, D) <= contract_path(M, D) & ~has_native(D)
has_model_receipt(M) <= model_receipt(M, H, E)
contract_needs_receipt(M, D) <= contract_path(M, D) & ~has_model_receipt(D)
progress_has_check(M) <= model_progress_checked(M, R)
progress_needs_check(M) <= model_progress_obligation(M, H, S) & ~progress_has_check(M)
protocol_has_check(M) <= protocol_checked(M, R)
protocol_needs_check(M) <= protocol_model(M, H) & ~protocol_has_check(M)
