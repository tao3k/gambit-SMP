((displayBytes 65536) (selector "(define-evidence (query) (sources clue factor binding) (outputs question dxProjectedInvalidation dxUnmappedInput dxActualReusePermit dxM8Retired dxFullBuildGain) (include clue-selection-schema)\n;; SysML owns the question inventory; source-bound configuration observations\n;; identify a difference, never a new speedup or a completed M8 retirement.\n(relation dxQuestion (id status) ((\"DX-SPEC\" \"conditional-development-contract\") (\"DX-ATTRIBUTION\" \"historical-component-evidence\") (\"DX-LOWERING\" \"architecture-hypothesis-native-open\") (\"DX-REUSE\" \"historical-regression-and-conditional-design\") (\"DX-ADMISSION\" \"conditional-whole-request-admission\") (\"DX-CURRENT-COST\" \"observed-envelope-and-source; inner-attribution-open\") (\"DX-C23-DARWIN\" \"required-C23-modernization-target; runtime-and-speedup-open\") (\"DX-FEEDBACK-PATH\" \"incremental-projection-and-retirement-open\") (\"DX-NATIVE-POLICY\" \"source-replacement; selected-native-chain-pass; M8-retirement-open\")))\n(relation dxClosedStatus (status) ((\"closed\")))\n(relation dxOpen (id))\n((dxOpen I) <-- (dxQuestion I S) (not (dxClosedStatus S)))\n(relation dxEvidenceIdentity (digest))\n(relation dxConfigured (digest id macroPolicy))\n(relation dxRetained (digest id macroPolicy))\n(relation dxMacroPolicyDifference (current retained))\n((dxMacroPolicyDifference C R) <-- (dxEvidenceIdentity H)\n (dxConfigured H C \"absent\") (dxRetained H R \"enabled\"))\n;; Actual paired full-build acceptance is a separate, presently absent fact.\n(relation dxFullBuildGain (source))\n\n;; These are projected dependencies owned by SysML. They are not permission\n;; to reuse a concrete output: the stable read/effect snapshot remains separate.\n(relation dxArtifactInput (role input) ((\"Scheme generation\" \"scheme-source\") (\"Scheme generation\" \"macro-read\") (\"Scheme generation\" \"compiler-stage\") (\"Scheme generation\" \"generation-option\") (\"Scheme generation\" \"generation-path\") (\"Scheme generation\" \"generation-effect\") (\"Native compilation\" \"generated-c\") (\"Native compilation\" \"handwritten-c\") (\"Native compilation\" \"header-abi\") (\"Native compilation\" \"native-policy\") (\"Native compilation\" \"native-toolchain\") (\"Native compilation\" \"target\") (\"Native linking\" \"native-object\") (\"Native linking\" \"native-runtime\") (\"Native linking\" \"link-policy\") (\"Native linking\" \"link-toolchain\") (\"Native linking\" \"module-binding\")))\n(relation dxArtifactEdge (upstream downstream) ((\"Scheme generation\" \"Native compilation\") (\"Native compilation\" \"Native linking\")))\n(relation dxChangedInput (input) ())\n(relation dxKnownArtifactInput (input))\n((dxKnownArtifactInput I) <-- (dxArtifactInput _ I))\n(relation dxUnmappedInput (input))\n((dxUnmappedInput I) <-- (dxChangedInput I) (not (dxKnownArtifactInput I)))\n(relation dxProjectedInvalidation (role))\n((dxProjectedInvalidation R) <-- (dxChangedInput I) (dxArtifactInput R I))\n((dxProjectedInvalidation D) <-- (dxProjectedInvalidation U) (dxArtifactEdge U D))\n(relation dxActualReusePermit (role))\n(relation dxM8Retired (source))\n\n;; Constructor coverage is source/test evidence, separate from native admission.\n(relation dxCtorLaw (aspect text))\n(relation dxCtorSource (digest))\n(relation dxCtorWitness (aspect digest))\n(relation dxCtorSourceCovered (aspect))\n((dxCtorSourceCovered A) <-- (dxCtorLaw A _) (dxCtorSource H) (dxCtorWitness A H))\n(relation dxCtorOpen (aspect))\n((dxCtorOpen A) <-- (dxCtorLaw A _) (not (dxCtorSourceCovered A)))\n\n(relation question (claim))\n((question I) <-- (dxQuestion I _))\n)"))
