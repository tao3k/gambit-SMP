(require 'json)
(require 'seq)
(require 'cl-lib)
(defun control-symbol-p (x) (if (consp x) (or (control-symbol-p (car x)) (control-symbol-p (cdr x))) (memq x '(controlBad controlDenied))))
(defun read-tree (p) (with-temp-buffer (insert-file-contents p) (read (current-buffer))))
(let* ((r ".cache/tasks/still-ledger-snapshot/")
       (full (read-tree "dev/modeling/ascent/assurance-planner.ss"))
       (actual (read-tree (concat r "case-current.ss")))
       (expected nil) (removed 0) (subjects nil))
  (dolist (f full)
    (let* ((decl (and (listp f) (eq (car f) 'relation)
      (memq (cadr f) '(sourceRouteFact sourceRoutePairFact contractFact dependencyTripleFact dependencyQuintFact receiptPairFact sourceRoute sharedContract))))
      (rule (and (listp f) (listp (car f))
       (or (memq (caar f) '(sourceRouteFact sourceRoute sharedContract))
        (and (memq (caar f) '(dependencyFact receiptFact))
          (seq-some (lambda(x)(and(listp x)(memq(car x)'(dependencyTripleFact dependencyQuintFact receiptPairFact)))) (cddr f)))))))
      (if (or decl rule) (setq removed (1+ removed))
        (push (if (and(listp f)(eq(car f)'outputs))
          (cons 'outputs (seq-remove(lambda(n)(memq n '(sourceRoute sharedContract)))(cdr f))) f) expected))))
  (setq expected (nreverse expected))
  (unless (and (= removed 22) (equal expected (seq-take actual (length expected))))
    (error "Pruned core does not match allowed empty-form elision"))
  (dolist (f (seq-drop actual (length expected)))
    (unless (and (listp f) (eq (car f) 'fact)) (error "Unexpected current control/semantic form"))
    (let ((row (cadr f)))
      (when (memq (car row) '(sourceRouteFact sourceRoutePairFact contractFact receiptPairFact controlBad controlDenied))
        (error "Elided input is nonempty"))
      (when (eq (car row) 'availableSubjectSeptFact)
        (dotimes (i 7) (push (seq-subseq row (+ 2 (* i 2)) (+ 4 (* i 2))) subjects)))
      (when (eq (car row) 'availableSubjectFact) (push (seq-subseq row 2) subjects))))
  (let ((raw (length subjects)))
    (setq subjects (delete-dups subjects))
    (with-temp-file (concat r "unpacked-subjects.json") (insert (json-encode (vconcat (mapcar #'vconcat subjects)))))
    (with-temp-file (concat r "specialization-controls.json")
      (insert (json-encode `((emptyFormsElided . 22) (emptyMetadataOutputNamesElided . 2)
        (currentControlInjectionAbsent . t) (qualificationCoreUnchanged . t)
        (rawSubjects . ,raw) (uniqueSubjects . ,(length subjects))
        (currentTopLevelForms . ,(length actual)) (parserBoundEnlarged . :json-false))))))
  ;; Matched full-schema controls use the small complete ancestor-closed build cut.
  (dolist (id '("current" "all-scoped-control"))
    (let* ((tree (read-tree (concat r "build-cut/case-" id ".ss")))
       (extra (seq-filter (lambda(f) (or (and(listp f)(eq(car f)'fact))
           (and(listp f)(eq(car f)'relation)(memq(cadr f)'(controlBad controlDenied)))
           (and(listp f)(listp(car f))(eq(caar f)'receiptFact)
             (seq-some #'control-symbol-p (cddr f))))) tree)))
      (with-temp-file (concat r "build-cut/schema-full-" id ".ss")
        (insert (prin1-to-string (append full extra)))))))
