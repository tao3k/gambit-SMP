part transition11:Transition { ref part :>> need=GambitBootstrapRootRecovery::retireDuty; attribute :>> fromPhase="TerminalDrained"; attribute :>> toPhase="RetiredKey"; attribute :>> qntStep="sealKey / purge"; attribute :>> guardContract="Result/source ACK plus lookup/scanner/delivery drain; persistent old-key rejection"; attribute :>> leanLaw="retiredKeyNeverAllocates"; attribute :>> sourceAnchors="setup.c:763-803;proposed registry retirement"; }
part transition12:Transition { ref part :>> need=GambitBootstrapRootRecovery::retireDuty; attribute :>> fromPhase="RetiredKey"; attribute :>> toPhase="ExpiredQuery"; attribute :>> qntStep="queryRetiredFence / replayAckFromFence"; attribute :>> guardContract="Return retired/settled disposition without recreation; full old outcome need not remain after proven delivery"; attribute :>> leanLaw="retiredKeyNeverAllocates"; attribute :>> sourceAnchors="proposed generation/frontier gate"; }
part def SourceRoute { ref part need:GambitAssuranceRouting::ModelNeed; attribute sourceAnchors:String; attribute projection:String; attribute failureCustodian:String; attribute status:String; }
part route0:SourceRoute { ref part :>> need=GambitBootstrapRootRecovery::identityDuty; attribute :>> sourceAnchors="_kernel.c:6258-6288;setup.c:1155-1178"; attribute :>> projection="Allocate key before publication; insert-or-find one canonical immutable-intent record; duplicate submits reuse it"; attribute :>> failureCustodian="Live NativeActivation/source lease until VM record custody is known"; attribute :>> status="source-and-C-order-refinement-open"; }
part route1:SourceRoute { ref part :>> need=GambitBootstrapRootRecovery::lookupDuty; attribute :>> sourceAnchors="setup.c:1050-1112;gambit.h.in:11599-11603"; attribute :>> projection="Pin canonical record, read key/descriptor/revision/status only; ACK later revalidates under same control domain"; attribute :>> failureCustodian="VM owns canonical entry/root and lookup lifetime; caller retains exact old source lease"; attribute :>> status="source-and-C-order-refinement-open"; }
part route2:SourceRoute { ref part :>> need=GambitBootstrapRootRecovery::ackDuty; attribute :>> sourceAnchors="mem.c:3898-3965;_kernel.c:26358-26368;gambit.h.in:10402"; attribute :>> projection="Logical ACK closes exact extra origin lease once; physical old-view pin waits for its scanner/borrowers"; attribute :>> failureCustodian="VM descriptor or terminal no-future-effect record owns operation; natural GVM frame retains language roots"; attribute :>> status="source-and-C-order-refinement-open"; }
part route3:SourceRoute { ref part :>> need=GambitBootstrapRootRecovery::restoreDuty; attribute :>> sourceAnchors="mem.c:4529-4561;_thread.scm:4990-5021,5047-5077"; attribute :>> projection="Keep old operation/source token separate from restored binding token; reload current generation/epoch before use"; attribute :>> failureCustodian="Original source backing/VM escrow plus independent restored-parent pin"; attribute :>> status="source-and-C-order-refinement-open"; }
part route4:SourceRoute { ref part :>> need=GambitBootstrapRootRecovery::unwindDuty; attribute :>> sourceAnchors="_ptree2.scm:3238-3251;setup.c:1109-1111,3350-3423"; attribute :>> projection="Before exit, transfer stable view/key, close future publication; pending request cancels, accepted root stays VM owned until drain"; attribute :>> failureCustodian="VM canonical escrow, not stack local progress or unwound owner"; attribute :>> status="source-and-C-order-refinement-open"; }
part route5:SourceRoute { ref part :>> need=GambitBootstrapRootRecovery::retireDuty; attribute :>> sourceAnchors="setup.c:763-803,1155-1178;_kernel.scm:1026-1066"; attribute :>> projection="Keep terminal outcome until delivered/acknowledged; then drain query/scanner/delivery readers and retain anti-replay frontier"; attribute :>> failureCustodian="VM record/result acceptor; per-child native custody remains imported RB-MEMBERS duty"; attribute :>> status="source-and-C-order-refinement-open"; }
part route6:SourceRoute { ref part :>> need=GambitBootstrapRootRecovery::orderDuty; attribute :>> sourceAnchors="setup.c:763-803,1155-1178;_kernel.scm:1026-1066"; attribute :>> projection="Insert/close/query/ACK/restore/purge actual C order and lifetime"; attribute :>> failureCustodian="VM record/result acceptor; per-child native custody remains imported RB-MEMBERS duty"; attribute :>> status="source-and-C-order-refinement-open"; }
part def DiagramNode {  attribute nodeId:String; attribute labelText:String; }
part node0:DiagramNode { attribute :>> nodeId="origin"; attribute :>> labelText="Generated mapped origin and invocation key"; }
part node1:DiagramNode { attribute :>> nodeId="ledger"; attribute :>> labelText="Canonical record and immutable intent"; }
part node2:DiagramNode { attribute :>> nodeId="close"; attribute :>> labelText="GC close: frozen source remains"; }
part node3:DiagramNode { attribute :>> nodeId="accept"; attribute :>> labelText="One accepted descriptor root"; }
part node4:DiagramNode { attribute :>> nodeId="query"; attribute :>> labelText="Pinned status query; revalidate ACK"; }
part node5:DiagramNode { attribute :>> nodeId="ack"; attribute :>> labelText="One extra source lease ACK"; }
part node6:DiagramNode { attribute :>> nodeId="pin"; attribute :>> labelText="Old scanner/borrowers drain"; }
part node7:DiagramNode { attribute :>> nodeId="restore"; attribute :>> labelText="Restored binding and reload"; }
part node8:DiagramNode { attribute :>> nodeId="exitGuard"; attribute :>> labelText="VM escrow and close before exit"; }
part node9:DiagramNode { attribute :>> nodeId="result"; attribute :>> labelText="Terminal result accepted"; }
part node10:DiagramNode { attribute :>> nodeId="fence"; attribute :>> labelText="Drain readers; keep retired-key fence"; }
part node11:DiagramNode { attribute :>> nodeId="late"; attribute :>> labelText="Late retry rejected; no recreation"; }
part def DiagramEdge { ref part producer:DiagramNode; ref part consumer:DiagramNode; attribute labelText:String; }
part edge0:DiagramEdge { ref part :>> producer=node0; ref part :>> consumer=node1; attribute :>> labelText="reserve before possible effect"; }
part edge1:DiagramEdge { ref part :>> producer=node1; ref part :>> consumer=node2; attribute :>> labelText="close wins"; }
part edge2:DiagramEdge { ref part :>> producer=node2; ref part :>> consumer=node1; attribute :>> labelText="same key after reload"; }
part edge3:DiagramEdge { ref part :>> producer=node1; ref part :>> consumer=node3; attribute :>> labelText="register wins"; }
part edge4:DiagramEdge { ref part :>> producer=node3; ref part :>> consumer=node4; attribute :>> labelText="reply lost or status needed"; }
part edge5:DiagramEdge { ref part :>> producer=node1; ref part :>> consumer=node4; attribute :>> labelText="query pending or absent"; }
part edge6:DiagramEdge { ref part :>> producer=node4; ref part :>> consumer=node5; attribute :>> labelText="exact canonical custody"; }
part edge7:DiagramEdge { ref part :>> producer=node5; ref part :>> consumer=node6; attribute :>> labelText="logical is not physical release"; }
part edge8:DiagramEdge { ref part :>> producer=node0; ref part :>> consumer=node7; attribute :>> labelText="same live invocation restores"; }
part edge9:DiagramEdge { ref part :>> producer=node7; ref part :>> consumer=node4; attribute :>> labelText="old source and new pin differ"; }
part edge10:DiagramEdge { ref part :>> producer=node0; ref part :>> consumer=node8; attribute :>> labelText="exception or native escape"; }
part edge11:DiagramEdge { ref part :>> producer=node8; ref part :>> consumer=node4; attribute :>> labelText="VM queries or cancels"; }
part edge12:DiagramEdge { ref part :>> producer=node6; ref part :>> consumer=node9; attribute :>> labelText="separate result handoff"; }
part edge13:DiagramEdge { ref part :>> producer=node9; ref part :>> consumer=node10; attribute :>> labelText="all lifetime gates"; }
part edge14:DiagramEdge { ref part :>> producer=node10; ref part :>> consumer=node11; attribute :>> labelText="persistent rejection after purge"; }
part def ResearchGate { attribute gateId:String; }
part def GateNeed { ref part gate:ResearchGate; ref part need:GambitAssuranceRouting::ModelNeed; }
part gateRow0:ResearchGate { attribute :>> gateId="registration-recovery"; }
part gateNeed0:GateNeed { ref part :>> gate=gateRow0; ref part :>> need=GambitBootstrapRootRecovery::identityDuty; }
part gateNeed1:GateNeed { ref part :>> gate=gateRow0; ref part :>> need=GambitBootstrapRootRecovery::lookupDuty; }
part gateNeed2:GateNeed { ref part :>> gate=gateRow0; ref part :>> need=GambitBootstrapRootRecovery::ackDuty; }
part gateNeed3:GateNeed { ref part :>> gate=gateRow0; ref part :>> need=GambitBootstrapRootRecovery::orderDuty; }
part gateNeed4:GateNeed { ref part :>> gate=gateRow0; ref part :>> need=GambitBootstrapRootRecovery::priorGate; }
part gateNeed5:GateNeed { ref part :>> gate=gateRow0; ref part :>> need=GambitBootstrapRootRecovery::priorView; }
part gateRow1:ResearchGate { attribute :>> gateId="parent-exit-restore"; }
part gateNeed6:GateNeed { ref part :>> gate=gateRow1; ref part :>> need=GambitBootstrapRootRecovery::restoreDuty; }
part gateNeed7:GateNeed { ref part :>> gate=gateRow1; ref part :>> need=GambitBootstrapRootRecovery::unwindDuty; }
part gateNeed8:GateNeed { ref part :>> gate=gateRow1; ref part :>> need=GambitBootstrapRootRecovery::ackDuty; }
part gateNeed9:GateNeed { ref part :>> gate=gateRow1; ref part :>> need=GambitBootstrapRootRecovery::priorScope; }
part gateRow2:ResearchGate { attribute :>> gateId="first-cut"; }
part gateNeed10:GateNeed { ref part :>> gate=gateRow2; ref part :>> need=GambitBootstrapRootRecovery::identityDuty; }
part gateNeed11:GateNeed { ref part :>> gate=gateRow2; ref part :>> need=GambitBootstrapRootRecovery::lookupDuty; }
part gateNeed12:GateNeed { ref part :>> gate=gateRow2; ref part :>> need=GambitBootstrapRootRecovery::ackDuty; }
part gateNeed13:GateNeed { ref part :>> gate=gateRow2; ref part :>> need=GambitBootstrapRootRecovery::restoreDuty; }
part gateNeed14:GateNeed { ref part :>> gate=gateRow2; ref part :>> need=GambitBootstrapRootRecovery::unwindDuty; }
part gateNeed15:GateNeed { ref part :>> gate=gateRow2; ref part :>> need=GambitBootstrapRootRecovery::retireDuty; }
part gateNeed16:GateNeed { ref part :>> gate=gateRow2; ref part :>> need=GambitBootstrapRootRecovery::orderDuty; }
part gateNeed17:GateNeed { ref part :>> gate=gateRow2; ref part :>> need=GambitBootstrapRootRecovery::priorMembers; }
part def AckCut { attribute acceptedOwned:Boolean; attribute terminalSafe:Boolean; attribute keyMatches:Boolean; attribute revisionMatches:Boolean; attribute sourceLeasePending:Boolean; attribute oldBorrow:Boolean; attribute ackRecorded:Boolean; attribute sourceReaders:Integer; attribute sourcePinHeld:Boolean; attribute resultAck:Boolean; attribute retiredKeyGate:Boolean; attribute queryOrDeliveryReaders:Integer; attribute canAck:Boolean=(acceptedOwned or terminalSafe) and keyMatches and revisionMatches and sourceLeasePending and not oldBorrow; attribute canReleaseOldPin:Boolean=ackRecorded and sourcePinHeld and sourceReaders==0 and not oldBorrow; attribute canPurge:Boolean=terminalSafe and ackRecorded and not sourcePinHeld and resultAck and retiredKeyGate and sourceReaders==0 and queryOrDeliveryReaders==0; attribute naturalSchemeSlotsCleared:Integer=0; attribute restoredPinsDroppedByOldAck:Integer=0; }
part accepted:AckCut { attribute :>> acceptedOwned=true; attribute :>> terminalSafe=false; attribute :>> keyMatches=true; attribute :>> revisionMatches=true; attribute :>> sourceLeasePending=true; attribute :>> oldBorrow=false; attribute :>> ackRecorded=false; attribute :>> sourceReaders=0; attribute :>> sourcePinHeld=true; attribute :>> resultAck=false; attribute :>> retiredKeyGate=false; attribute :>> queryOrDeliveryReaders=0; }
part wrongKey:AckCut { attribute :>> acceptedOwned=true; attribute :>> terminalSafe=false; attribute :>> keyMatches=false; attribute :>> revisionMatches=true; attribute :>> sourceLeasePending=true; attribute :>> oldBorrow=false; attribute :>> ackRecorded=false; attribute :>> sourceReaders=0; attribute :>> sourcePinHeld=true; attribute :>> resultAck=false; attribute :>> retiredKeyGate=false; attribute :>> queryOrDeliveryReaders=0; }
part staleQuery:AckCut { attribute :>> acceptedOwned=true; attribute :>> terminalSafe=false; attribute :>> keyMatches=true; attribute :>> revisionMatches=false; attribute :>> sourceLeasePending=true; attribute :>> oldBorrow=false; attribute :>> ackRecorded=false; attribute :>> sourceReaders=0; attribute :>> sourcePinHeld=true; attribute :>> resultAck=false; attribute :>> retiredKeyGate=false; attribute :>> queryOrDeliveryReaders=0; }
part scanAfterAck:AckCut { attribute :>> acceptedOwned=true; attribute :>> terminalSafe=false; attribute :>> keyMatches=true; attribute :>> revisionMatches=true; attribute :>> sourceLeasePending=false; attribute :>> oldBorrow=false; attribute :>> ackRecorded=true; attribute :>> sourceReaders=1; attribute :>> sourcePinHeld=true; attribute :>> resultAck=false; attribute :>> retiredKeyGate=false; attribute :>> queryOrDeliveryReaders=0; }
part restoredOldPin:AckCut { attribute :>> acceptedOwned=true; attribute :>> terminalSafe=false; attribute :>> keyMatches=true; attribute :>> revisionMatches=true; attribute :>> sourceLeasePending=false; attribute :>> oldBorrow=false; attribute :>> ackRecorded=true; attribute :>> sourceReaders=0; attribute :>> sourcePinHeld=true; attribute :>> resultAck=false; attribute :>> retiredKeyGate=false; attribute :>> queryOrDeliveryReaders=0; }
part sourceAckOnly:AckCut { attribute :>> acceptedOwned=false; attribute :>> terminalSafe=true; attribute :>> keyMatches=true; attribute :>> revisionMatches=true; attribute :>> sourceLeasePending=false; attribute :>> oldBorrow=false; attribute :>> ackRecorded=true; attribute :>> sourceReaders=0; attribute :>> sourcePinHeld=false; attribute :>> resultAck=false; attribute :>> retiredKeyGate=true; attribute :>> queryOrDeliveryReaders=0; }
part fullyDelivered:AckCut { attribute :>> acceptedOwned=false; attribute :>> terminalSafe=true; attribute :>> keyMatches=true; attribute :>> revisionMatches=true; attribute :>> sourceLeasePending=false; attribute :>> oldBorrow=false; attribute :>> ackRecorded=true; attribute :>> sourceReaders=0; attribute :>> sourcePinHeld=false; attribute :>> resultAck=true; attribute :>> retiredKeyGate=true; attribute :>> queryOrDeliveryReaders=0; }
requirement def PhysicalAckLaw { subject cut:AckCut; require constraint { not cut.canReleaseOldPin or (cut.ackRecorded and cut.sourceReaders==0 and not cut.oldBorrow) } }
part def RetryPayload { attribute deliveries:Integer; attribute wordBytes:Integer=8; attribute duplicateBytes:Integer=deliveries*wordBytes; attribute canonicalBytes:Integer=wordBytes; attribute slotSavingBytes:Integer=duplicateBytes-canonicalBytes; }
part flat:RetryPayload { attribute :>> deliveries=1; }
part retried:RetryPayload { attribute :>> deliveries=8; }
}
