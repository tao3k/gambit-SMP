part transition8:Transition { ref part :>> need=GambitBootstrapRootRecovery::unwindDuty; attribute :>> fromPhase="PendingOrAccepted"; attribute :>> toPhase="VmOwnedClosing"; attribute :>> qntStep="takeVmCustody / exitParent"; attribute :>> guardContract="Stable VM view/key accepted and future publication closed before nonlocal exit"; attribute :>> leanLaw="exitRequiresEscrow"; attribute :>> sourceAnchors="_ptree2.scm:3238-3251;setup.c:1109-1111,3350-3423"; }
part transition9:Transition { ref part :>> need=GambitBootstrapRootRecovery::unwindDuty; attribute :>> fromPhase="VmOwnedClosing"; attribute :>> toPhase="TerminalOrRootHeld"; attribute :>> qntStep="cancelPending / observeConsumerDrain / retireAccepted"; attribute :>> guardContract="No root retirement over consumer or collector read; preserve original status"; attribute :>> leanLaw="releasedPinNeedsRootOrNoValue"; attribute :>> sourceAnchors="setup.c:763-835;c_intf.c:6511-6564"; }
