;; Admission of evidence for existing causal factors, not another GC model.
;; SysML owns conditions/dependencies. QNT and Lean retain their original owners.
(relation smpIdentity (source profile))
(relation smpFactor (id))
(relation smpNeed (factor condition method contract))
(relation smpDependency (dependent prerequisite))
(relation smpRecord (condition method source profile contract outcome))
(relation smpPass (outcome) (("pass")))
(relation smpRejected (condition))
((smpRejected C) <-- (smpNeed _ C M H) (smpIdentity S P)
 (smpRecord C M S P H O) (not (smpPass O)))
(relation smpSupplied (condition))
((smpSupplied C) <-- (smpNeed _ C M H) (smpIdentity S P)
 (smpRecord C M S P H "pass") (not (smpRejected C)))
(relation smpLocalGap (factor condition))
((smpLocalGap F C) <-- (smpNeed F C _ _) (not (smpSupplied C)))
(relation smpGap (factor condition))
((smpGap F C) <-- (smpLocalGap F C))
((smpGap F C) <-- (smpDependency F P) (smpGap P C))
(relation smpBlocked (factor))
((smpBlocked F) <-- (smpGap F _))
(relation smpLocalReady (factor))
((smpLocalReady F) <-- (smpFactor F) (not (smpBlocked F)))
(relation smpCandidate (id))
(relation smpGate (id))
(relation smpGateEvidence (id source profile outcome))
(relation smpGateRejected (id))
((smpGateRejected G) <-- (smpGate G) (smpIdentity S P)
 (smpGateEvidence G S P O) (not (smpPass O)))
(relation smpGateMissing (id))
((smpGateMissing G) <-- (smpGate G) (smpIdentity S P)
 (not (smpGateEvidence G S P "pass")))
((smpGateMissing G) <-- (smpGateRejected G))
;; Synthetic local coverage cannot issue original source/native obligations.
(relation smpModernReady (id))
((smpModernReady C) <-- (smpCandidate C) (not (smpBlocked _))
 (verificationReady C) (not (smpGateMissing _)))
