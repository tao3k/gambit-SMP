(require 'cl-lib)
(require 'json)
(require 'seq)
(defun read-tree (f) (with-temp-buffer (insert-file-contents f) (read (current-buffer))))
(let* ((r ".cache/tasks/still-authority-handoff/")
       (ast (read-tree (concat r "case-current.ss")))
       (old (read-tree (concat r "assurance-planner-before.ss")))
       (now (read-tree "dev/modeling/ascent/assurance-planner.ss"))
       (added '(subjectIdentityFact receiptRefPairFact dependencyOwnerQuintFact))
       (removed nil) (needs nil) (edges nil) (receipts nil) (pairs 0))
  ;; Project only added lossless input/expansion forms; original policy AST must match.
(cl-labels ((new-form (f) (if (consp f) (or (new-form (car f)) (new-form (cdr f))) (memq f added))))
  (let ((base (seq-remove #'new-form now)))
    (unless (and (= (- (length now) (length base)) 11) (equal base old))
      (error "Qualification policy or transport AST drift"))))
  (dolist (f ast)
    (when (and (listp f) (eq (car f) 'fact))
      (let* ((row (cadr f)) (kind (car row)))
        (cond
         ((eq kind 'needFact) (push (cdr row) needs))
         ((eq kind 'needTripleFact)
          (dotimes (i 3) (push (cons (nth 1 row) (seq-subseq row (+ 2 (* i 5)) (+ 7 (* i 5)))) needs)))
         ((eq kind 'dependencyFact) (push (cdr row) edges))
         ((eq kind 'dependencyOwnerQuintFact)
          (unless (= (length row) 17) (error "Owner edge arity"))
          (dotimes (i 5) (push (cons (nth 1 row) (seq-subseq row (+ 2 (* i 3)) (+ 5 (* i 3)))) edges)))))))
  (let ((dict (make-hash-table :test 'equal)))
    (dolist (n needs)
      (when (gethash (nth 1 n) dict) (error "Nonunique obligation identity"))
      (puthash (nth 1 n) (list (nth 4 n) (nth 5 n)) dict))
    (dolist (f ast)
      (when (and (listp f) (eq (car f) 'fact))
        (let ((row (cadr f)))
          (cond
           ((eq (car row) 'receiptRefPairFact)
            (unless (= (length row) 15) (error "Subject receipt arity"))
            (setq pairs (1+ pairs))
            (dotimes (i 2)
              (let* ((v (seq-subseq row (+ 3 (* i 6)) (+ 9 (* i 6))))
                     (sub (gethash (nth 3 v) dict)))
                (unless sub (error "Unbound receipt subject"))
                (push (list (nth 1 row) (nth 0 v) (nth 1 v) (nth 2 v)
                            (nth 0 sub) (nth 4 v) (nth 5 v) (nth 1 sub) (nth 2 row)) receipts))))
           ((eq (car row) 'receiptFact) (push (cdr row) receipts)))))))
  (let ((raw (length edges)))
    (setq edges (delete-dups edges))
    (with-temp-file (concat r "edge-padding.json")
      (insert (json-encode `((rawExpandedEdges . ,raw) (uniqueNativeEdges . ,(length edges))
        (duplicatePadding . ,(- raw (length edges))) (qualificationRulesChanged . :json-false))))))

  (unless (and (= pairs 20) (= (length receipts) 40) (= (length needs) 112) (= (length edges) 372)) (error "Transport cardinality drift"))
  (dolist (entry `(("unpacked-needs.raw.json" . ,needs) ("unpacked-edges.json" . ,edges) ("unpacked-receipts.json" . ,receipts)))
    (with-temp-file (concat r (car entry)) (insert (json-encode (vconcat (mapcar #'vconcat (cdr entry)))))))
  (with-temp-file (concat r "transport-policy.json")
    (insert (json-encode '((inheritedTransportForms . 11) (qualificationAstUnchanged . t) (globalObligationIdsUnique . t) (runtimeNeeds . 112) (runtimeEdges . 372) (runtimeReceiptPairs . 20) (runtimeReceipts . 40)))))
  (princ "Policy AST unchanged; 112 needs, 372 unique edges and 40 exact receipts independently unpacked.\n"))
