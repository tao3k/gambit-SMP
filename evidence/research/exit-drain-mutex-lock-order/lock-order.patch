 ;; the mutex's owner.
 
+(define-prim (##mutex-lock-threads-revalidate! mutex current-thread new-owner timeout owner class)
+
+  (##declare (not interrupts-enabled))
+
+  ;; The mutex lock is held and the thread locks are not.  class is
+  ;; the symbol free or wait.  On contention, drop the mutex, acquire
+  ;; the thread locks in ##lock-2-threads! order, reacquire the mutex,
+  ;; and recheck.  Return the owner to use when the class is unchanged
+  ;; and the thread locks are held.  Return #f after releasing every
+  ;; lock when the class changed.  The caller returns ##void so the
+  ;; outer lock loop restarts.
+
+  (define (class-of owner-now)
+    (cond ((or (##eq? owner-now (macro-mutex-state-not-abandoned))
+               (##eq? owner-now (macro-mutex-state-abandoned)))
+           'free)
+          ((##not timeout)
+           'timeout)
+          (else
+           'wait)))
+
+  (define (try-ordered a b)
+    (if (macro-trylock-thread! a)
+        (if (or (##eq? a b)
+                (macro-trylock-thread! b))
+            #t
+            (begin
+              (macro-unlock-thread! a)
+              #f))
+        #f))
+
+  (define (ordered-trylock t1 t2)
+    (if (##object-before? t1 t2)
+        (try-ordered t1 t2)
+        (try-ordered t2 t1)))
+
+  (define (lock-blocking!)
+    (if new-owner
+        (##lock-2-threads! current-thread new-owner)
+        (macro-lock-thread! current-thread)))
+
+  (define (unlock-held!)
+    (if new-owner
+        (##unlock-2-threads! current-thread new-owner)
+        (macro-unlock-thread! current-thread)))
+
+  (let ((acquired
+         (if new-owner
+             (ordered-trylock current-thread new-owner)
+             (macro-trylock-thread! current-thread))))
+    (if acquired
+        owner
+        (begin
+          (macro-unlock-mutex! mutex)
+          (lock-blocking!)
+          (macro-lock-mutex! mutex)
+          (let ((owner-now (macro-btq-owner mutex)))
+            (if (##eq? (class-of owner-now) class)
+                owner-now
+                (begin
+                  (unlock-held!)
+                  (macro-unlock-mutex! mutex)
+                  #f)))))))
+
