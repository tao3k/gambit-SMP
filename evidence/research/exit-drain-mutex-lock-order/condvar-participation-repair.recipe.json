{
  "schema": "evidence-recipe.v2",
  "id": "join-condvar-participation-repair",
  "scope": "In-place incremental rebuild of the retained gambit-core generation from the condvar-participation source lock. Then the qualified participation arrival fixture in both cohort modes at the existing 12-second diagnostic cap. Arrival is participation-observed-held, not the baseline reserved second ticket. A timeout is a failed run, not a passed negative. No bootstrap. The 12-second cap is not the 3600-second original acceptance window and this is not original TFIB.",
  "workspacePolicy": "in-place",
  "timeoutPolicy": {"mode": "progress", "overheadSeconds": 30},
  "inputs": [
    "evidence/research/exit-drain-mutex-lock-order/condvar-participation.lock.json",
    "evidence/research/exit-drain-mutex-lock-order/condvar-participation.patch",
    "evidence/fixtures/gerbil-bazel-build-profile/profile.json",
    "models/gambit/native/join_condvar_gc_cohort_participation.scm",
    "evidence/research/execution/entry.json",
    "evidence/dsl/execution.ss"
  ],
  "steps": [
    {"id": "candidate", "capability": "gambit.materialize", "dependsOn": [], "budgetSeconds": 180,
     "arguments": {"sourceLock": "evidence/research/exit-drain-mutex-lock-order/condvar-participation.lock.json",
                   "buildWorkspace": "gambit-core"}},
    {"id": "configure", "capability": "gambit.configure", "dependsOn": ["candidate"], "budgetSeconds": 180,
     "arguments": {"source": {"step": "candidate", "output": "source"},
                   "buildProfile": "evidence/fixtures/gerbil-bazel-build-profile/profile.json"}},
    {"id": "seed", "capability": "gambit.seed-core", "dependsOn": ["configure"], "budgetSeconds": 3600,
     "arguments": {"source": {"step": "configure", "output": "source"}}},
    {"id": "source-core", "capability": "gambit.source-core", "dependsOn": ["seed"], "budgetSeconds": 3600,
     "arguments": {"runtime": {"step": "seed", "output": "runtime"}}},
    {"id": "release-control", "capability": "gambit.executable-test", "dependsOn": ["source-core"], "budgetSeconds": 120,
     "arguments": {"runtime": {"step": "source-core", "output": "runtime"},
                   "identity": {"step": "source-core", "output": "identity"},
                   "program": "models/gambit/native/join_condvar_gc_cohort_participation.scm",
                   "mode": "gsc", "processorTopology": "host-managed", "executionBudgetSeconds": 12,
                   "parameters": {"GAMBIT_SMP_JOIN_COHORT_MODE": 1},
                   "stdout": "JOIN-CONDVAR-GC:PASS\n"}},
    {"id": "retained-lock", "capability": "gambit.executable-test", "dependsOn": ["source-core", "release-control"], "budgetSeconds": 120,
     "arguments": {"runtime": {"step": "source-core", "output": "runtime"},
                   "identity": {"step": "source-core", "output": "identity"},
                   "program": "models/gambit/native/join_condvar_gc_cohort_participation.scm",
                   "mode": "gsc", "processorTopology": "host-managed", "executionBudgetSeconds": 12,
                   "parameters": {"GAMBIT_SMP_JOIN_COHORT_MODE": 2},
                   "stdout": "JOIN-CONDVAR-GC:PASS\n"}},
    {"id": "verdict", "capability": "evidence.evaluate",
     "dependsOn": ["candidate", "configure", "seed", "source-core", "release-control", "retained-lock"],
     "budgetSeconds": 30,
     "arguments": {"dsl": "evidence/research/execution/entry.json",
                   "queries": {"checked": "checked_step", "missing": "missing_step"},
                   "expected": {"missing": []}, "recordedQueries": ["checked"]}}
  ]
}
