{
  "schema": "evidence-recipe.v2",
  "id": "join-condvar-participation-stress",
  "scope": "Reuse the completed condvar-participation source-core in place. Original four upstream stress files in gsi and gsc. Host-derived topology, jobs 1, unchanged 3600-second genuine completed-work inactivity window. The public-API probe stays a diagnostic. Not a second configure, seed, or source-core, not a bootstrap, not a changed (go 15 5000), and not native acceptance by itself.",
  "workspacePolicy": "in-place",
  "timeoutPolicy": {"mode": "progress", "overheadSeconds": 30},
  "inputs": [
    "evidence/research/exit-drain-mutex-lock-order/condvar-participation.lock.json",
    "evidence/research/exit-drain-mutex-lock-order/condvar-participation.patch",
    "evidence/research/exit-drain-mutex-lock-order/condvar-participation-runtime.local.json",
    "evidence/research/exit-drain-mutex-lock-order/mutex-exit-lock-order.scm",
    "evidence/research/execution/entry.json",
    "evidence/dsl/execution.ss",
    "evidence/native-failures.json",
    "evidence/research/suite-review-rules.ss"
  ],
  "steps": [
    {"id": "candidate", "capability": "gambit.materialize", "dependsOn": [], "budgetSeconds": 180,
     "arguments": {"sourceLock": "evidence/research/exit-drain-mutex-lock-order/condvar-participation.lock.json"}},
    {"id": "runtime", "capability": "gambit.runtime-import", "dependsOn": ["candidate"], "budgetSeconds": 180,
     "arguments": {"source": {"step": "candidate", "output": "source"},
                   "archive": "evidence/research/exit-drain-mutex-lock-order/condvar-participation-runtime.local.json"}},
    {"id": "probe", "capability": "gambit.executable-test", "dependsOn": ["runtime"], "budgetSeconds": 180,
     "arguments": {"runtime": {"step": "runtime", "output": "runtime"},
                   "identity": {"step": "runtime", "output": "identity"},
                   "program": "evidence/research/exit-drain-mutex-lock-order/mutex-exit-lock-order.scm",
                   "mode": "gsi", "processorTopology": "host-managed", "executionBudgetSeconds": 120,
                   "stdout": "LOCK-ORDER-EXIT-PASS\n"}},
    {"id": "stress-gsi", "capability": "gambit.suite", "dependsOn": ["runtime"], "budgetSeconds": 3600,
     "arguments": {"runtime": {"step": "runtime", "output": "runtime"},
                   "identity": {"step": "runtime", "output": "identity"},
                   "failures": "evidence/native-failures.json",
                   "reviewRules": "evidence/research/suite-review-rules.ss",
                   "mode": "gsi", "regime": "whole-parallel", "inventory": "stress", "jobs": 1,
                   "selection": ["06-thread/tfib_stress.scm", "06-thread/thread_interrupt_stress.scm",
                                 "06-thread/thread_interrupt2_stress.scm", "06-thread/thread_terminate_stress.scm"],
                   "expectedFiles": ["06-thread/tfib_stress.scm", "06-thread/thread_interrupt_stress.scm",
                                     "06-thread/thread_interrupt2_stress.scm", "06-thread/thread_terminate_stress.scm"]}},
    {"id": "stress-gsc", "capability": "gambit.suite", "dependsOn": ["runtime", "stress-gsi"], "budgetSeconds": 3600,
     "arguments": {"runtime": {"step": "runtime", "output": "runtime"},
                   "identity": {"step": "runtime", "output": "identity"},
                   "failures": "evidence/native-failures.json",
                   "reviewRules": "evidence/research/suite-review-rules.ss",
                   "mode": "gsc", "regime": "whole-parallel", "inventory": "stress", "jobs": 1,
                   "selection": ["06-thread/tfib_stress.scm", "06-thread/thread_interrupt_stress.scm",
                                 "06-thread/thread_interrupt2_stress.scm", "06-thread/thread_terminate_stress.scm"],
                   "expectedFiles": ["06-thread/tfib_stress.scm", "06-thread/thread_interrupt_stress.scm",
                                     "06-thread/thread_interrupt2_stress.scm", "06-thread/thread_terminate_stress.scm"]}},
    {"id": "verdict", "capability": "evidence.evaluate",
     "dependsOn": ["candidate", "runtime", "probe", "stress-gsi", "stress-gsc"],
     "budgetSeconds": 30,
     "arguments": {"dsl": "evidence/research/execution/entry.json",
                   "queries": {"checked": "checked_step", "missing": "missing_step"},
                   "expected": {"missing": []}, "recordedQueries": ["checked"]}}
  ]
}
