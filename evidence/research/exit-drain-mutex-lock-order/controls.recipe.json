{
  "schema": "evidence-recipe.v2",
  "id": "exit-drain-mutex-lock-order-controls",
  "scope": "Fresh locked-source materialization, seven deterministic trajectories, decoded original/entry-only negative TLC controls and exhaustive candidate safety/temporal checking. No source refinement, native failure, runtime repair or execution admission.",
  "budgetSeconds": 90,
  "inputs": [
    "models/gambit/exit_drain_mutex_lock_order.qnt",
    "evidence/fixtures/thread-completion-contract/source.lock.json",
    "patches/fixtures/thread-completion-contract.patch",
    "evidence/research/execution-rules.ss"
  ],
  "steps": [
    {
      "id": "source",
      "capability": "gambit.materialize",
      "dependsOn": [],
      "budgetSeconds": 30,
      "arguments": {"sourceLock": "evidence/fixtures/thread-completion-contract/source.lock.json"}
    },
    {
      "id": "parse",
      "capability": "quint.parse",
      "dependsOn": ["source"],
      "budgetSeconds": 15,
      "arguments": {"source": "models/gambit/exit_drain_mutex_lock_order.qnt"}
    },
    {
      "id": "typecheck",
      "capability": "quint.typecheck",
      "dependsOn": ["parse"],
      "budgetSeconds": 15,
      "arguments": {"source": "models/gambit/exit_drain_mutex_lock_order.qnt", "parsed": "parse"}
    },
    {
      "id": "trajectories",
      "capability": "quint.test",
      "dependsOn": ["typecheck", "parse"],
      "budgetSeconds": 15,
      "arguments": {
        "source": "models/gambit/exit_drain_mutex_lock_order.qnt",
        "parsed": "parse",
        "main": "exit_drain_mutex_lock_order",
        "seed": "0x1510",
        "maxSamples": 1,
        "expectedTests": ["originalCycleTest", "candidateEscapeTest", "peerFirstTest", "targetFirstTest", "logicalOwnershipTest", "entryOnlyStillCyclesTest", "slowEscapeTest"]
      }
    },
    {
      "id": "original-cycle",
      "capability": "quint.verify",
      "dependsOn": ["parse", "typecheck", "trajectories"],
      "budgetSeconds": 15,
      "arguments": {"source": "models/gambit/exit_drain_mutex_lock_order.qnt", "parsed": "parse",
                    "initializer": "initOld", "step": "step", "invariant": "checked", "negative": true}
    },
    {
      "id": "entry-only-cycle",
      "capability": "quint.verify",
      "dependsOn": ["parse", "typecheck", "trajectories"],
      "budgetSeconds": 15,
      "arguments": {"source": "models/gambit/exit_drain_mutex_lock_order.qnt", "parsed": "parse",
                    "initializer": "initEntryOnly", "step": "step", "invariant": "checked", "negative": true}
    },
    {
      "id": "candidate-protocol",
      "capability": "quint.verify",
      "dependsOn": ["parse", "typecheck", "trajectories"],
      "budgetSeconds": 15,
      "arguments": {"source": "models/gambit/exit_drain_mutex_lock_order.qnt", "parsed": "parse",
                    "initializer": "initFixed", "step": "step", "invariant": "checked", "negative": false,
                    "temporal": "progress"}
    },
    {
      "id": "verdict",
      "capability": "evidence.evaluate",
      "dependsOn": ["source", "parse", "typecheck", "trajectories", "original-cycle", "entry-only-cycle", "candidate-protocol"],
      "budgetSeconds": 10,
      "arguments": {
        "rules": ["evidence/research/execution-rules.ss"],
        "queries": {"missing": "missing_step", "bindings": "bound_source", "controls": "bound_control"},
        "expected": {"missing": [], "bindings": [], "controls": []}
      }
    }
  ]
}
