prelude: :gerbil/base
package: std/iter
namespace: std/iter/macros

(%#begin (%#import
          :std/interface
          :std/list/list-builder
          :std/iter/interface
          :std/iter/iterators)
         (%#export #t)
         (%#begin-syntax
          (%#call (%#ref load-module) (%#quote "std/iter/macros~1"))
          (%#define-runtime
           binding-contract?
           |std/iter/macros[1]#binding-contract?|)
          (%#define-runtime for-binding? |std/iter/macros[1]#for-binding?|))
         (%#define-syntax for |std/iter/macros[:0:]#for|)
         (%#define-syntax for1 |std/iter/macros[:0:]#for1|)
         (%#define-syntax for1-dispatch |std/iter/macros[:0:]#for1-dispatch|)
         (%#define-syntax for1-in-range |std/iter/macros[:0:]#for1-in-range|)
         (%#define-syntax
          for1-in-range-inclusive
          |std/iter/macros[:0:]#for1-in-range-inclusive|)
         (%#define-syntax
          for1-in-range-generic
          |std/iter/macros[:0:]#for1-in-range-generic|)
         (%#define-syntax
          for1-in-integers
          |std/iter/macros[:0:]#for1-in-integers|)
         (%#define-syntax
          for1-in-numbers
          |std/iter/macros[:0:]#for1-in-numbers|)
         (%#define-syntax for1-generic |std/iter/macros[:0:]#for1-generic|)
         (%#define-syntax forN |std/iter/macros[:0:]#forN|)
         (%#define-syntax for* |std/iter/macros[:0:]#for*|)
         (%#define-syntax for/collect |std/iter/macros[:0:]#for/collect|)
         (%#define-syntax for/fold |std/iter/macros[:0:]#for/fold|))
