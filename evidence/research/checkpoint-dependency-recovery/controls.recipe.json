{
  "schema": "evidence-recipe.v2",
  "id": "checkpoint-dependency-recovery-controls",
  "scope": "Composition of producer interruption and prerequisite checkpoint validity. Five trajectories, positive exhaustive safety, three decoded faulty dependency controls and native ASCENT terminal observation. No runtime or recovery implementation admission.",
  "budgetSeconds": 90,
  "inputs": ["models/gambit/checkpoint_dependency_recovery.qnt", "models/gambit/interrupted_producer_recovery.qnt",
    "evidence/research/execution-rules.ss", "evidence/fixtures/thread-completion-contract/source.lock.json",
    "patches/fixtures/thread-completion-contract.patch"],
  "steps": [
    {"id": "source", "capability": "gambit.materialize", "dependsOn": [], "budgetSeconds": 30,
     "arguments": {"sourceLock": "evidence/fixtures/thread-completion-contract/source.lock.json"}},
    {"id": "parse", "capability": "quint.parse", "dependsOn": ["source"], "budgetSeconds": 15,
     "arguments": {"source": "models/gambit/checkpoint_dependency_recovery.qnt"}},
    {"id": "typecheck", "capability": "quint.typecheck", "dependsOn": ["parse"], "budgetSeconds": 15,
     "arguments": {"source": "models/gambit/checkpoint_dependency_recovery.qnt", "parsed": "parse"}},
    {"id": "trajectories", "capability": "quint.test", "dependsOn": ["parse", "typecheck"], "budgetSeconds": 15,
     "arguments": {"source": "models/gambit/checkpoint_dependency_recovery.qnt", "parsed": "parse",
       "main": "checkpoint_dependency_recovery", "seed": "0x1510", "maxSamples": 1,
       "expectedTests": ["R::resumedCommittedTest", "R::interruptedRunningTest", "R::expiredCheckpointTest",
         "R::postRecoveryDriftTest", "R::missingReceiptControlTest", "R::staleOutputControlTest",
         "R::liveProcessControlTest", "R::deadlineResetControlTest", "dependencyClosedTest", "staleParentControlTest", "missingParentControlTest",
         "cycleControlTest", "postRecoveryParentDriftTest"]}},
    {"id": "safe-recovery", "capability": "quint.verify", "dependsOn": ["parse", "typecheck", "trajectories"], "budgetSeconds": 15,
     "arguments": {"source": "models/gambit/checkpoint_dependency_recovery.qnt", "parsed": "parse",
       "initializer": "init", "step": "step", "invariant": "safe", "negative": false}},
    {"id": "stale-parent", "capability": "quint.verify", "dependsOn": ["parse", "typecheck", "trajectories"], "budgetSeconds": 15,
     "arguments": {"source": "models/gambit/checkpoint_dependency_recovery.qnt", "parsed": "parse",
       "initializer": "initStale", "step": "step", "invariant": "safe", "negative": true}},
    {"id": "missing-parent", "capability": "quint.verify", "dependsOn": ["parse", "typecheck", "trajectories"], "budgetSeconds": 15,
     "arguments": {"source": "models/gambit/checkpoint_dependency_recovery.qnt", "parsed": "parse",
       "initializer": "initMissing", "step": "step", "invariant": "safe", "negative": true}},
    {"id": "dependency-cycle", "capability": "quint.verify", "dependsOn": ["parse", "typecheck", "trajectories"], "budgetSeconds": 15,
     "arguments": {"source": "models/gambit/checkpoint_dependency_recovery.qnt", "parsed": "parse",
       "initializer": "initCycle", "step": "step", "invariant": "safe", "negative": true}},
    {"id": "verdict", "capability": "evidence.evaluate",
     "dependsOn": ["source", "parse", "typecheck", "trajectories", "safe-recovery", "stale-parent", "missing-parent", "dependency-cycle"],
     "budgetSeconds": 10, "arguments": {"rules": ["evidence/research/execution-rules.ss"],
       "queries": {"missing": "missing_step", "bindings": "bound_source", "controls": "bound_control"},
       "expected": {"missing": [], "bindings": [], "controls": []}}}
  ]
}
