;;; Data-only native rules over observed executions, not an authorization policy.
(ascent-fragment
  (relation observed_step ((step symbol?) (outcome symbol?) (capability symbol?)))
  (relation required_step ((step symbol?)))
  (relation step_dependency ((step symbol?) (parent symbol?)))
  (relation source_binding ((binding symbol?) (workspace symbol?)))
  (relation workspace_projection ((workspace symbol?) (source symbol?)))
  (relation compiled_workspace ((build symbol?) (binding symbol?)))
  (relation tested_executable ((test symbol?) (build symbol?)))
  (relation control_case ((test symbol?) (case symbol?) (negative boolean?)))
  (relation native_process ((step symbol?) (stage symbol?) (exit exact-integer?) (timeout boolean?)))
  (relation checked_step ((step symbol?)))
  (relation missing_step ((step symbol?)))
  (relation bound_source ((binding symbol?) (source symbol?)))
  (relation bound_control ((test symbol?) (case symbol?) (negative boolean?) (binding symbol?)))
  ((checked_step S) <-- (observed_step S (lit 'PASS) C))
  ((missing_step S) <-- (required_step S) (not (checked_step S)))
  ((bound_source B S) <-- (source_binding B W) (workspace_projection W S))
  ((bound_control T C N B) <-- (control_case T C N) (tested_executable T X)
                            (compiled_workspace X B) (bound_source B S)))
