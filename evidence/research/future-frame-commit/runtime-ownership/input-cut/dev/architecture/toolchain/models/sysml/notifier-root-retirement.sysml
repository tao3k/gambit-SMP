 part gate2 : Gate { attribute :>> key = "capture-effect-closure"; attribute :>> qualified = false; attribute :>> condition = "No root-bearing capture or publication through direct/indirect calls, interrupt, thread-save, denv, handlers or StackTrace"; }
 part gate3 : Gate { attribute :>> key = "retirement-cut"; attribute :>> qualified = false; attribute :>> condition = "Issuer executes after verified last invocation-root use with no future restoration edge; source-to-model simulation required"; }
