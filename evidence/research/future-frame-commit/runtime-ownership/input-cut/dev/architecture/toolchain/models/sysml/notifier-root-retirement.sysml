 part def Gain { attribute key : String; attribute avoided : String; attribute added : String; attribute condition : String; }
 part gain0 : Gain { attribute :>> key = "dead-root-retention"; attribute :>> avoided = "Eliminate notifier-attributable retention after a certified cut; no forced extra GC assumed"; attribute :>> added = "Compile-time root/effect proof plus point-specific retirement work"; attribute :>> condition = "Retiring K proven-dead root locations costs O(K); no whole-heap walk per notice; K and runtime speed unmeasured"; }
 part gain1 : Gain { attribute :>> key = "repeated-control"; attribute :>> avoided = "One canonical attempt slot prevents replayed notices from repeating action or granting another receipt"; attribute :>> added = "O(W) live slots and constant identity checks per delivery; retry/error custody"; attribute :>> condition = "Root-bearing multi-shot captures stay legal outside restricted profile but cannot qualify this attempt"; }
 part gain2 : Gain { attribute :>> key = "failure-isolation"; attribute :>> avoided = "No false release from after-thunk, slot clear, saved-slot clear or caught exception"; attribute :>> added = "Monotone capture/failure taint and separate returned/root-retired/sealed states"; attribute :>> condition = "No bounded retention or guaranteed notification latency; failed attempts may retain resources indefinitely"; }
 part gain3 : Gain { attribute :>> key = "modern-c-and-zig"; attribute :>> avoided = "Reuse Scheme semantic completion and generated modern-C FrameSpec/PointId contract"; attribute :>> added = "Both languages need identical GC/control/effect, root-map and publication obligations"; attribute :>> condition = "No additional positive Zig net benefit established; avoid a second handwritten runtime or duplicate root maps"; }
 attribute receiptGeneration : Integer = 17;
 attribute actualAdmitted : Boolean = false;
