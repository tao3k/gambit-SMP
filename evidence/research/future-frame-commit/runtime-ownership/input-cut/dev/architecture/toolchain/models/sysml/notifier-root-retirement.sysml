 part root3 : RootBoundary { attribute :>> key = "active-and-internal-frames"; attribute :>> anchor = "mem.c:3898-3966; _kernel.scm:1284-1344; _t-c-1.scm:1947-1963,1986-2008"; attribute :>> actualEdge = "RETI/RETN descriptors choose live frame slots; internal returns save/restore GVM registers"; attribute :>> requiredChange = "Bind receipt to generated PointId/FrameSpec and backend/configuration; no receipt inside restorable save region"; }
 part root4 : RootBoundary { attribute :>> key = "captured-frames-and-denv"; attribute :>> anchor = "gambit.h.in:6314-6330,6378-6388,6589-6606,6715-6735; _kernel.scm:3613-3635; mem.c:3667-3895,4096-4145"; attribute :>> actualEdge = "Capture stores frame/denv; continuation-copy shares fields; thread-save retains frame in thread continuation; return/restore installs frames again"; attribute :>> requiredChange = "No exported root-bearing capture in restricted profile, including interrupt/exception/thread paths; dropping one continuation is insufficient"; }
