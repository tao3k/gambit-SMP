 part source : GambitAssuranceRouting::ModelNeed { ref part :>> owner = GambitBuildAssurance::scheduler.component; attribute :>> obligationId = "RA-S"; attribute :>> kind = "source-refinement"; attribute :>> subjectPath = "dev/architecture/toolchain/stream-release-authority-design.org"; attribute :>> subjectScope = "RA-S:release-issuer-source"; attribute :>> premise = "Current will/RC/exception/callback sources identified; no existing composite credential issuer; alias/token coverage and proposed notifier/registry simulation open"; }
 part platform : GambitAssuranceRouting::ModelNeed { ref part :>> owner = GambitBuildAssurance::scheduler.component; attribute :>> obligationId = "RA-E"; attribute :>> kind = "environment-refinement"; attribute :>> subjectPath = "dev/architecture/toolchain/stream-release-authority-design.org"; attribute :>> subjectScope = "RA-E:release-native-order"; attribute :>> premise = "All-processor root closure, C reserve/commit ordering, pin rollback, notification grace and thread-affine resource cleanup unqualified"; }
