  attribute gerbilHeaderPublication : String = GambitHeaderOrganization::publication;
  attribute selectedAdmissionModel:String="dev/refactoring/modern-c/models/sysml/memory-delivery.sysml";
  attribute legacyNeedBoundary:String="The31 Need/Question records in this package retain mixed-candidate programme scope; actual first-submission facts are projected from GambitSourceOrganization, never auto-waived or asserted passed here.";
  attribute candidateStatus : String = "MIXED-RESEARCH-TREE; DELIVERY-PARTITION-REQUIRED; NO-SUBMISSION-TREE-SELECTED; NOT-ADMITTED";
  attribute currentStage : String = "The first structural submission is GambitMemoryDelivery:27 paths,25 private memory fragments, one driver and existing Make rules. Header organization remains blocked by alternative template consumers. The unpublished role prototype and all GC/FFI/lifecycle research are outside this selected tree. Eight selected obligations across the same five gates must close.";
  attribute vmRegistryProtocolId : String = "vm-registry";
  attribute vmRegistryModel : String = "dev/refactoring/modern-c/models/quint/vm_registry.qnt";
  attribute vmRegistryEvidence : String = "evidence/research/revision-admission/vm-lifecycle-results.json";
  attribute vmRegistryModelDuty : String = "QNT alone checks finite writer/reader/acknowledgement/interrupt schedules, with retained-effect and late-publication negative controls. No new Lean proof is introduced for this finite protocol; unchanged root/round algebra stays with its owning component. No duplicate schedule or new universal C theorem is claimed. LLM source review checks owner/TLS, signal backend, constructor stage and native-stop premises. Native tests exercise actual initialized secondary VM lifecycle, not secondary Scheme execution or secondary GC.";
  attribute custodyRefinementEvidence : String = "evidence/research/revision-admission/runtime-custody-refinement.json";
  attribute custodyRefinementBoundary : String = "Seven real source routes and27 anchors locate root publication, RC scanning, task completion, R-context restoration before owner cleanup, join-dependent still transfer and retained-state cleanup refusal. These are conditional source observations, not complete C memory-order or stopped-writer proofs. Supported synchronous lifetime and changed callers must close in this REV; independent carrier retirement, universal foreign recovery, collector generations and frontend performance remain later programme work.";
  attribute globalCleanupFrontier : String = "Implemented candidate: allocator no longer edits VM membership; setup publishes after initialization. A stable atomic registry admission word separates signal readers from exclusive setup/retirement/global shutdown. Other owners explicitly retire their VM and receive BOOL acknowledgement; global cleanup refuses while any secondary remains. Effectful still teardown retains a VM-owned cursor/payload on failed/unknown return and never grants global free or replays it. Native qualification and C refinement remain required; no universal foreign-stop claim.";
  attribute testedSourceLock : String = "evidence/research/revision-admission/reconstruction-source.lock.json; partial11-input consumer frontier; full1228 production-core manifest and exact bootstrap witness remain separately bound";
  attribute prospectiveCommitTree : String = "Structural unit db7e3425152c7036aec4cc30b20dd188d034773a is delivered; no next behavioral submission is selected. The135 pending vendor paths remain mixed research, not a single accepted REV.";
  attribute revisionScope : String = "Continue from the delivered memory organization. Partition the existing role/root/round/lifecycle and CFFI research through complete actual callers; do not restart the foreign-service study or classify it as untouched future work. Freeze each behavioral tree before its original and affected tests. Existing working files and another lane remain intact.";
  attribute revisionTests : String = "Select required tests from the actual submitted tree and its supported contracts before execution. Keep600-second bootstrap and existing per-case limits, exact source/profile and Gerbil-facing build boundaries. Historical16-case and seven-role results retain their executed tree/runtime identities; a new submission requires explicit input equivalence or actual revalidation.";
  attribute revisionBlockers : String = "First blocker is a fixed coherent submission tree and its applicable source/consumer/test obligations. The retained31-obligation matrix belongs to the preceding mixed candidate and is not an unconditional checklist for every delivery step. No existing failed applicable regression is waived; no missing later service is counted as a pass.";
  attribute revisionObservations : String = "VM lifecycle runtime source on c9258cba passed a full406.118-second two-pass bootstrap, sixteen-case218.683-second campaign and seven W/R/fault observations. The Make source-distribution-only successor2c5d161b passed a separate358.346-second whole bootstrap within600. No native lifecycle campaign is retagged onto its rebuilt binaries. Earlier600-second failure remains failed. These observations do not select a submission tree or solve the programme twelve gates.";
  attribute buildResourceBoundary : String = "Make -j11 with inherited p11 formerly permitted 121 initial Scheme processor contexts. Qualified native gsc-boot actions now specify -:p1, so initial processor sum <= active jobs <= 11 while target SMP features remain unchanged. Not an OS-thread quota, matched speedup or arbitrary macro/interpreted-adapter guarantee.";
  attribute baselineDefinition : String = "The twelve semantic requirement labels are comparison targets. The recorded8/12 belongs to the patch-repair evidence line in evidence/source-results/current-checkpoint-qualification/summary.json; it is not a modern-c branch checkpoint or inherited credit.";
  attribute baselineAcceptance : String = "MODERN-C-PROGRESS-NOT-ESTABLISHED: no8/12 or9/12 claim is supported on published modern-c HEAD db7e3425152c7036aec4cc30b20dd188d034773a. The branch must establish its own exact-revision requirement coverage using the original acceptance contracts. Never begin from eight inherited patch-line completions and add one.";
  attribute comparisonHistoricalScope:String="patch-repair-line; not-modern-c-branch";
  attribute comparisonCreditInherited:Boolean=false;
  attribute comparisonBranchProgress:String="not-established; no-branch9-of12-evidence";
  attribute comparisonClassification:String="evidence/research/modern-c-mainline-comparison/progress-classification.json";
  attribute comparisonEvidence:String="evidence/research/modern-c-mainline-comparison/official-results.json";
  attribute comparisonSource:String="0b16c5bd5138decf478599c163c3735056cd3436";
  attribute comparisonPublishedCommit:String="db7e3425152c7036aec4cc30b20dd188d034773a";
  attribute comparisonAppliesToPublishedCommit:Boolean=false;
  attribute comparisonNewMilestoneCredit:Boolean=false;
  attribute comparisonPassed:Boolean=true;
  attribute comparisonSameRecipes:Boolean=true;
  attribute comparisonSameFixtures:Boolean=true;
  attribute comparisonSameLimits:Boolean=false;
  attribute comparisonFullGate:Boolean=false;
  attribute comparisonBranchCoverageEstablished:Boolean=false;
  attribute comparisonInputs:String="Six original mem/server/client/expected-output files and the complete test7-test9 Make recipe block are byte-identical to the recorded patch-repair observation. The whole Make template differs outside these recipes.";
  attribute comparisonLimits:String="This is the original three-target support observation, not the complete GC/FFI inventory. The baseline receipt does not record the numerical cap here and its raw log is unavailable at the declared path; no budget-equivalence, performance or ninth-gate claim. The caller epilogue failed after successful native completion; terminal receipts and streams are checked without executing the command again.";
  attribute comparisonNextProof:String="Establish the modern-c branch acceptance inventory and exact revision/profile/artifacts, then independently execute and review the applicable original tests and full required contracts. Prior patch outcomes are problem evidence and comparison inputs only. The research-tree three-target observation is not branch-HEAD proof.";
  attribute modularSuite : String = "Sixteen named vendor Scheme catalog/CI cases, including owner retirement and global reclamation. Local executions, source equivalence, remote CI and twelve-milestone acceptance remain separate.";
  attribute revisionFfiBoundary : String = "CFFI refactoring is already ongoing in the existing source and concurrent research. Inseparable changed SFUN/RC/marker/root consumers belong to the selected ownership cut; broad service work is coordinated through its actual contracts and receipts. Do not relabel that lane as unstarted, claim its progress, or import its completion without source-bound original-test evidence.";
  attribute roadmapBoundary : String = "DeliveryStep and DeliveryDependency in runtime-role-realization.sysml define an ordered refactoring programme. Global12-milestone acceptance and complete future CFFI/generation services do not become unconditional early-REV gates. Scope must be frozen before tests, not narrowed afterwards to hide a failure. An intermediate synchronous adapter is an explicit bounded architecture stage, not a claim of the final independent-worker design.";
  attribute originalInventoryBoundary : String = "Original379 assertion bodies and PR fixtures stay unchanged. Bounded p3 and p2 compiled observations remain incomplete. The shared-support and byte-order experiments failed to establish whole-inventory closure and are retired. Complete current GSI/GSC native inventories remain separate mandatory checks.";
  attribute producerAdmissionBoundary : String = "The preceding37aaf01a bootstrap and producer/map/verdict import remain historical bound events. VM lifecycle source changes invalidate their use as the current mutable SDK reference. New bootstrap, explicit input/core/native qualification and real consumer admission are required. The600-second failed attempt is retained; compiler-seed custody is separate from native source/runtime admission. No ancestor or failure is retagged.";
  attribute semanticBoundary:String="Preserve Scheme observable evaluation, exception and dynamic-wind behaviour, proper tail calls, shared object identity and multi-shot continuation/GC restoration; effects may be extended explicitly without silently weakening these guarantees.";
  attribute representationBoundary:String="Replace internal PSTATE/carrier bindings, frame/root representations, C helper signatures, function tables, ownership and allocation protocols as complete producer/consumer migrations. No duplicate namespace, alias or compatibility facade is required.";
  attribute binaryArtifactBoundary:String="A rebuilt generator/header/runtime/module cohort is the default migration. Unrebuilt old binary extensions are not promised to load. setup.c currently checks compiler version and selected structure sizes; this is not a complete same-size layout or function-signature fingerprint. Reject or rebuild uncertain artifacts; a size check alone is not admission.";
  attribute originalCompilerCostBoundary : String = "Keep unchanged GSC300 and numeric90 limits and the existing profile. single-host=0 is unlimited single-host, not disabled. The8008-label/5.60MB module finishes generation then times out in native construction; preprocessing alone1.98s/21.49MB does not account for the whole phase. Structural host partition must preserve PointId/FrameSpec/tail/root/multi-shot contracts, not tune a test threshold.";
  attribute gerbilBuildBoundary : String = "Pinned Gerbil source and existing SourceLock/build.sh consume one owned workspace.185 stage0 modules completed under explicit p1/J5 context. Stage1 failed70 in47.379901 seconds on partial-source lookup; withdrawing unpublished outputs preserves bootstrap and advances to Bach, but300-second old-runtime diagnostic still times out.186 native files are not independent completed-action receipts. Full current-runtime producer/consumer qualification and runtime-ABI invalidation remain open; no new source copy was created.";
  attribute reconstructionBoundary:String="Text and binary table decoders share strong construction roots before committing weak/index flags and reconstruction debt. Real roundtrip plus concurrent GC and explicit between-store GC controls pass on the new bootstrap. This closes an observed construction window, not all GC/FFI root producers or native stop recovery.";
  attribute checkedIncrementBoundary:String="Safe vector-inc specialization must check vector, mutability, index, increment and existing element before the unsafe atomic fetch-add. Checks short circuit before vector-ref and preserve the Scheme fallback and old-value result. Original invalid-delta assertion and independent invalid-element/no-write controls pass; no concurrent arbitrary-type mutation claim.";
  attribute testSupportDecision:String="REJECTED-FOR-THIS-REV: corrected nine-file inline13.618715s/shared13.396316s does not establish sufficient net return. Current original inline driver and namespace restored; no shared support feature or byte-order scheduler retained.";
  attribute gitExecutionAuthorized : Boolean = false;

