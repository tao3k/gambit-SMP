  part def Question { ref part gate : GambitCommitGates::Gate = questions; attribute id : String; attribute method : String="paper-source-analysis"; attribute artifact : String="dev/refactoring/modern-c/commit-admission.org"; attribute scope : String; attribute prompt : String; attribute answer : String; attribute status : String; attribute evidence : String; attribute counterexample : String; }
  part qPvm : Question { attribute :>> id="Q-PVM"; attribute :>> scope="gvm-semantic-ownership-and-c-portability"; attribute :>> prompt="Which PVM idea is amplified, and which Scheme semantic decisions must stay out of C layout helpers?"; attribute :>> answer="Retain GVM target cooperation; one explicit frame/root origin feeds collectors and continuation consumers. The C role cut is groundwork, not a completed generator rewrite or LLVM backend."; attribute :>> status="answered-scoped"; attribute :>> evidence="FeeleyMillerLFP90 sections 1-2; gambit.h.in context accessors; mem.c mark_execution_roots; frame-consumers.org"; attribute :>> counterexample="Recreating Scheme control semantics independently in a new backend duplicates the semantic authority; moving C fields alone does not amplify PVM optimization."; }
  part qPoll : Question { attribute :>> id="Q-POLL"; attribute :>> scope="bounded-safepoint-and-participation-progress"; attribute :>> prompt="Does the new root participant prove progress for nonallocating loops, foreign blocking calls and collector cooperation?"; attribute :>> answer="No. This cut keeps the existing synchronous safepoint mechanism; phase guards establish ordering only. A bounded-progress claim needs generator placement, root freeze and foreign participation together."; attribute :>> status="answered-scoped"; attribute :>> evidence="Feeley1993 via retro-parallel section 3.4; mem.c require_gc_phase and garbage_collect_pstate; modernization-target.org"; attribute :>> counterexample="A nonallocating spin loop can avoid allocation checks and prevent a collective; new phase enums cannot force it to participate."; }
  part qMulti : Question { attribute :>> id="Q-MULTISHOT"; attribute :>> scope="map-capture-and-repeated-resume-with-gc"; attribute :>> prompt="Can captured map frames be resumed repeatedly after GC without consuming roots or imposing one-shot ownership?"; attribute :>> answer="Fresh current-runtime catalog passes map multi-shot, eleven forced-GC wide-root controls at one and host processors, and dynamic-wind multi-shot. Fresh role controls exercise three roots with one/two/three workers and owner cleanup. Arbitrary continuation/FFI writer coverage remains open; a full bounded bootstrap has passed; earlier p11 failures retain their identities."; attribute :>> status="answered-scoped"; attribute :>> evidence="bootstrap-validation.org; mem.c mark_continuation/shared frame decoder; frame-continuation-roots.scm; retro-concurrency sections 4-5 distinguish one-shot fibers"; attribute :>> counterexample="Treating a captured frame as uniquely consumed after its first resume preserves an OCaml-style use case but breaks Scheme multi-shot behavior. A one-context pass cannot qualify failed multi-processor startup."; }
  part qLifetime : Question { attribute :>> id="Q-LIFETIME"; attribute :>> scope="touched-context-participant-worker-lifetime-under-supported-synchronous-adapter"; attribute :>> prompt="Do all changed context, participant and arena consumers retain valid storage through supported synchronous GC, resize and cleanup; which independent retirement remains outside this cut?"; attribute :>> answer="VM-owned origins and worker arenas separate storage from carrier fields, with current W<R/owner-cleanup controls. The supported adapter remains synchronous and borrows work->carrier; cleanup_pstate still owns resource lifetime. Complete touched-path storage/borrow/exit refinement remains open. Independent carrier retirement is a later claim and is not demanded merely by this question."; attribute :>> status="unresolved"; attribute :>> evidence="setup.c cleanup_pstate; mem.c worker carrier uses; runtime-role-realization.sysml RR-LIFETIME"; attribute :>> counterexample="Clearing carrier bytes leaves a VM array intact but does not prove that a thread or context can retire while users remain."; }
  part qFfi : Question { attribute :>> id="Q-FFI"; attribute :>> scope="changed-foreign-consumer-migration-coherence-and-root-exit-custody"; attribute :>> prompt="Do the changed generator, C declarations/function tables/definitions and actual SFUN/RC/Tcl callers agree on the new result, root and exit contracts, without retaining obsolete interfaces?"; attribute :>> answer="Internal ABI/layout preservation is not required. Source evidence already shows set_data_rc changes from void to BOOL, with declarations/function table and Tcl result checks migrated. This REV owes complete touched-consumer migration and root/error/exit safety under the new design. Old binary extensions require rebuild or verified rejection; setup version/size checks are not a full ABI fingerprint. Universal CFFI/foreign-thread/destructor redesign remains later. Native touched-path safety is still open."; attribute :>> status="unresolved"; attribute :>> evidence="include/_gambit/runtime_protocols.h.in and global_state.h.in set_data_rc; lib/_mem/rc-allocation.inc; examples/tcltk/tcltk.scm; gsc/_t-c-1.scm; setup.c setup_module/run/catcher"; attribute :>> counterexample="Keeping a void function-table entry while a migrated caller consumes a success result is incoherent even if structure size is unchanged. Conversely, freezing the old signature prevents the new admission result contract. GC waiting for an owner callback can still form an independent cycle."; }
  part qFailure : Question { attribute :>> id="Q-FAILURE"; attribute :>> scope="closed-census-result-and-unknown-exit-custody"; attribute :>> prompt="Who retains roots and work after partial startup, failed join, unknown exit or a missing final acknowledgement?"; attribute :>> answer="Earlier calibrated empty-unpublished-abort control preserves a healthy three-root/one-worker cohort through three GCs. Root-bearing or published unknown members remain refused. The new registry/owner/global protocol replaces that ignored-refusal path; prototype native host and retained-effect controls pass. Final current-cohort tests, complete barrier/failure custody and source refinement remain open. Unqualified published/root-bearing unknown exits remain refused."; attribute :>> status="unresolved"; attribute :>> evidence="mem.c gc_round and final barrier; runtime_roles.qnt; setup.c resize cleanup; registered repair-9-12 evidence"; attribute :>> counterexample="A two-participant model assumes both members reach their barriers; a failed native participant can prevent that premise."; }
  part qCost : Question { attribute :>> id="Q-COST"; attribute :>> scope="structural-benefit-versus-runtime-cost"; attribute :>> prompt="Which work is removed now, what is added, and what would refute a net-benefit claim?"; attribute :>> answer="Old carrier payload fields, implicit origin and queue selection are replaced. Earlier role-only +3080 VM bytes is historical. Current configured storage control reports context584, worker408, participant120, carrier648 and VM122824 bytes at word64; no matched complete-candidate delta or speedup is established. Root indirection, coordination, capacity reservations and writer obligations remain costs."; attribute :>> status="answered-scoped"; attribute :>> evidence="matched parent/current sizeof; runtime-role-matrix.org; source commit diff; verification.json"; attribute :>> counterexample="A smaller carrier is not a smaller VM. If downstream retirement never occurs, extra indirection and coordination can exceed the value of the split."; }
  part qRetire : Question { attribute :>> id="Q-RETIRE"; attribute :>> scope="old-path-retirement-and-historical-evidence-separation"; attribute :>> prompt="Which old responsibilities actually disappear, and is any patch result being presented as refactoring acceptance?"; attribute :>> answer="Direct carrier root/memory fields and old visitor trio are removed; embedded C consumers change. Cleanup lifecycle remains open; source-generated bootstrap and product reconciliation now have scoped evidence. Bazel provides configuration; patch receipts retain their own identities and no historical score is inherited by this candidate."; attribute :>> status="answered-scoped"; attribute :>> evidence="negative old-field compile; source diff; runtime-role-realization.org; historical SMP observation"; attribute :>> counterexample="Importing patch candidates or labeling historical passes with the new source SHA does not retire ownership or establish native acceptance."; }


