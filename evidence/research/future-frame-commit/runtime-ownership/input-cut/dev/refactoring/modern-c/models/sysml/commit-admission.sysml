  part baselineStressGsc:BaselineAssessment { attribute :>> label="Stress GSC"; attribute :>> currentStatus="Not executed on this current candidate"; attribute :>> remaining="Original full compiled SMP stress workloads; no shortened workloads promoted to this gate"; }
  part baselineRegistry:BaselineAssessment { attribute :>> label="Registry lifetime"; attribute :>> currentStatus="Selected root domains and isolated startup controls pass; full grid open"; attribute :>> remaining="Actual shared registry readers, resource incarnations, retirement and complete supported population grid"; }
  part baselineFaults:BaselineAssessment { attribute :>> label="Lifecycle faults"; attribute :>> currentStatus="Fresh calibrated empty unpublished abort: healthy 3-root/1-worker cohort completes three GCs; full fault inventory open"; attribute :>> remaining="Root-bearing or published unknown members, real failure/rollback, retained resources and complete supported recovery"; }
  part baselineFfi:BaselineAssessment { attribute :>> label="GC/FFI"; attribute :>> currentStatus="On research tree0b16c5bd5138decf478599c163c3735056cd3436 the unchanged official test7/test8/test9 pass in17.238s, exit0, no timeout. The patch-repair line already passed these same three targets; full GC/FFI remains open and no aggregate credit is granted."; attribute :>> remaining="Official interface inventory, actual FFI writers and bounded participation/source refinement; unknown raw writers are not silently admitted"; }
  part baselineGerbil:BaselineAssessment { attribute :>> label="Gerbil correctness"; attribute :>> currentStatus="Pinned source-facing build contract audited; actual current-candidate Gerbil build/test not executed; T-GERBIL remains required"; attribute :>> remaining="Actual downstream producer binding, complete required build and tests"; }
  part baselinePerformance:BaselineAssessment { attribute :>> label="Release performance"; attribute :>> currentStatus="Not qualified; validation elapsed time is not a performance result"; attribute :>> remaining="Matched accepted producers, declared workloads and complete measurement populations; scope before making release/speed claims"; }

