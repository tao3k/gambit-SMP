module native_entry_admission {
// Source root eligibility, joint host facts and scanner enrollment are native refinement premises.
type State={phase:int,host:int,sourcePin:int,sourceRoot:int,carrierRoot:int,registry:int,guard:int,inflight:int,nested:int,unknown:int,outcome:int,epoch:int,sourceEpoch:int,carrierEpoch:int,frozen:int,scanned:int,entryOpen:int,writeOpen:int,written:int,marker:int,receipt:int,registrationUnknown:int,scanAdmission:int,grace:int,rejected:int,holder:int}
pure val initial:State={phase:0,host:0,sourcePin:0,sourceRoot:0,carrierRoot:0,registry:0,guard:0,inflight:0,nested:0,unknown:0,outcome:0,epoch:0,sourceEpoch:0,carrierEpoch:0,frozen:0,scanned:0,entryOpen:1,writeOpen:1,written:0,marker:0,receipt:0,registrationUnknown:0,scanAdmission:1,grace:0,rejected:0,holder:0}
var s:State
action init=s'=initial
val safe=all{s.phase>=0,s.phase<=7,s.holder>=0,s.holder<=2,s.host>=0,s.host<=1,s.sourcePin>=0,s.sourcePin<=1,s.sourceRoot>=0,s.sourceRoot<=1,s.carrierRoot>=0,s.carrierRoot<=1,s.registry>=0,s.registry<=1,s.guard>=0,s.guard<=1,s.inflight>=0,s.inflight<=1,s.nested>=0,s.nested<=1,s.unknown>=0,s.unknown<=1,s.outcome>=0,s.outcome<=1,s.epoch>=0,s.sourceEpoch>=0,s.carrierEpoch>=0,s.frozen>=0,s.frozen<=1,s.scanned>=0,s.scanned<=1,s.entryOpen>=0,s.entryOpen<=1,s.writeOpen>=0,s.writeOpen<=1,s.written>=0,s.written<=1,s.marker>=0,s.marker<=1,s.receipt>=0,s.receipt<=1,s.registrationUnknown>=0,s.registrationUnknown<=1,s.scanAdmission>=0,s.scanAdmission<=1,s.grace>=0,s.grace<=1,s.rejected>=0,s.rejected<=1,s.sourcePin==s.sourceRoot,s.registry==s.carrierRoot,s.registry==s.guard,s.sourceEpoch<=s.epoch,s.carrierEpoch<=s.epoch,s.phase>=1 and s.phase<=6 implies s.sourceRoot+s.carrierRoot>=1,s.phase>=3 and s.phase<=5 implies all{s.host==1,s.registry==1,s.carrierRoot==1,s.guard==1,s.holder>=1},s.phase>=4 and s.phase<=5 implies s.inflight==1,s.inflight==1 implies all{s.phase>=4,s.phase<=5,s.registry==1},s.unknown==1 implies all{s.phase==5,s.inflight==1,s.registry==1,s.carrierRoot==1,s.guard==1,s.holder==2},s.nested==1 implies all{s.phase==5,s.inflight==1},s.marker==1 and s.phase<=5 implies s.registry==1,s.registrationUnknown==1 implies all{s.phase==3,s.registry==1,s.sourceRoot==1},s.receipt==1 implies all{s.sourceRoot==1,s.carrierRoot==1,s.registry==1,s.carrierEpoch==s.epoch,s.frozen==0},s.phase==7 implies all{s.sourceRoot==0,s.sourcePin==0,s.carrierRoot==0,s.registry==0,s.guard==0,s.inflight==0,s.nested==0,s.unknown==0,s.holder==0,s.entryOpen==0,s.scanAdmission==0,s.grace==1,s.frozen==0,s.receipt==0},s.frozen==1 implies all{s.writeOpen==0,s.epoch>=1,s.phase>=1,s.phase<=6},s.frozen==0 and s.sourceRoot==1 implies s.sourceEpoch==s.epoch,s.frozen==0 and s.carrierRoot==1 implies s.carrierEpoch==s.epoch,s.scanned==1 and s.sourceRoot==1 implies s.sourceEpoch==s.epoch,s.scanned==1 and s.carrierRoot==1 implies s.carrierEpoch==s.epoch,s.grace==1 implies all{s.phase>=6,s.entryOpen==0,s.scanAdmission==0,s.frozen==0},s.phase==0 implies all{s.epoch==0,s.sourceRoot==0,s.registry==0,s.inflight==0},s.phase>=1 and s.phase<=3 implies s.sourceRoot==1,s.phase<=2 implies all{s.registry==0,s.inflight==0,s.registrationUnknown==0},s.phase==6 implies all{s.inflight==0,s.nested==0,s.unknown==0},s.phase<=3 implies all{s.written==0,s.marker==0},s.phase==4 implies s.marker==0}
action pinSource=all{s.phase==0 and s.entryOpen==1,s'={...s,phase:1,sourcePin:1,sourceRoot:1}}
action reserveCarrier=all{s.phase==1 and s.frozen==0,s'={...s,phase:2}}
action qualifyHost=all{s.phase==2 and s.frozen==0,s'={...s,host:1}}
action publishCarrier=all{s.phase==2 and s.host==1 and s.writeOpen==1 and s.frozen==0 and s.sourceRoot==1,s'={...s,phase:3,carrierRoot:1,registry:1,guard:1,carrierEpoch:s.sourceEpoch,holder:1}}
action loseRegistrationAck=all{s.phase==3 and s.registrationUnknown==0,s'={...s,registrationUnknown:1}}
action confirmSameRegistration=all{s.phase==3 and s.registrationUnknown==1 and s.registry==1,s'={...s,registrationUnknown:0}}
action jointIssue=all{s.phase==3 and s.entryOpen==1 and s.writeOpen==1 and s.frozen==0 and s.registrationUnknown==0 and s.host==1 and s.registry==1 and s.guard==1 and s.carrierRoot==1 and s.carrierEpoch==s.epoch,s'={...s,phase:4,inflight:1}}
action writeEntryState=all{s.phase==4 and s.frozen==0 and s.writeOpen==1 and s.written==0,s'={...s,written:1}}
action allocateMarker=all{s.phase==4 and s.frozen==0 and s.writeOpen==1 and s.written==1,s'={...s,phase:5,marker:1}}
action certifyTransfer=all{s.phase>=4 and s.phase<=6 and s.sourcePin==1 and s.sourceRoot==1 and s.registry==1 and s.carrierRoot==1 and s.carrierEpoch==s.epoch and s.frozen==0,s'={...s,receipt:1}}
action releaseSource=all{s.phase>=4 and s.phase<=6 and s.receipt==1 and s.sourcePin==1 and s.frozen==0,s'={...s,sourcePin:0,sourceRoot:0,receipt:0}}
action closeIngress=all{s.phase<7 and s.entryOpen==1,s'={...s,entryOpen:0}}
action exhaustCarrier=all{s.phase==1 and s.frozen==0,s'={...s,phase:6,rejected:1}}
action rejectClosed=all{s.phase>=1 and s.phase<=3 and s.entryOpen==0 and s.frozen==0 and s.registrationUnknown==0,s'={...s,phase:6,rejected:1}}
action freezeWriters=all{s.phase>=1 and s.phase<=6 and s.frozen==0 and s.scanAdmission==1,s'={...s,epoch:s.epoch+1,frozen:1,writeOpen:0,scanned:0,receipt:0}}
action scanSource=all{s.frozen==1 and s.sourceRoot==1 and s.carrierRoot==0,s'={...s,sourceEpoch:s.epoch,scanned:1}}
action scanBoth=all{s.frozen==1 and s.sourceRoot==1 and s.carrierRoot==1,s'={...s,sourceEpoch:s.epoch,carrierEpoch:s.epoch,scanned:1}}
action scanCarrier=all{s.frozen==1 and s.sourceRoot==0 and s.carrierRoot==1,s'={...s,carrierEpoch:s.epoch,scanned:1}}
action thawWriters=all{s.frozen==1 and s.scanned==1,s'={...s,frozen:0,writeOpen:1}}
action enterNested=all{s.phase==5 and s.entryOpen==1 and s.frozen==0 and s.unknown==0 and s.nested==0,s'={...s,nested:1}}
action leaveNested=all{s.phase==5 and s.nested==1 and s.frozen==0,s'={...s,nested:0}}
action recordOutcome=all{s.phase==5 and s.unknown==0 and s.frozen==0 and s.outcome==0,s'={...s,outcome:1}}
action loseCompletion=all{s.phase==5 and s.unknown==0,s'={...s,unknown:1,holder:2}}
action landNested=all{s.phase==5 and s.nested==1 and s.unknown==1 and s.frozen==0,s'={...s,nested:0}}
action settleKnown=all{s.phase==5 and s.outcome==1 and s.unknown==0 and s.nested==0 and s.frozen==0,s'={...s,phase:6,inflight:0}}
action recoverRecorded=all{s.phase==5 and s.outcome==1 and s.unknown==1 and s.nested==0 and s.frozen==0,s'={...s,phase:6,inflight:0,unknown:0,holder:1}}
action closeScanAdmission=all{s.phase==6 and s.entryOpen==0 and s.scanAdmission==1,s'={...s,scanAdmission:0}}
action confirmGrace=all{s.phase==6 and s.entryOpen==0 and s.scanAdmission==0 and s.frozen==0 and s.inflight==0 and s.nested==0 and s.unknown==0 and s.registrationUnknown==0,s'={...s,grace:1}}
action retireCarrier=all{s.phase==6 and s.entryOpen==0 and s.scanAdmission==0 and s.grace==1 and s.frozen==0 and s.registrationUnknown==0 and s.unknown==0 and s.inflight==0 and s.nested==0,s'={...s,phase:7,sourcePin:0,sourceRoot:0,carrierRoot:0,registry:0,guard:0,holder:0,receipt:0,writeOpen:0}}
action step=any{pinSource,reserveCarrier,qualifyHost,publishCarrier,loseRegistrationAck,confirmSameRegistration,jointIssue,writeEntryState,allocateMarker,certifyTransfer,releaseSource,closeIngress,exhaustCarrier,rejectClosed,freezeWriters,scanSource,scanBoth,scanCarrier,thawWriters,enterNested,leaveNested,recordOutcome,loseCompletion,landNested,settleKnown,recoverRecorded,closeScanAdmission,confirmGrace,retireCarrier,all{s'=s}}
run registeredTransferTest=init.then(pinSource).then(reserveCarrier).then(qualifyHost).then(publishCarrier).then(jointIssue).then(writeEntryState).then(certifyTransfer).then(releaseSource).then(allocateMarker).then(recordOutcome).then(settleKnown).then(closeIngress).then(closeScanAdmission).then(confirmGrace).then(retireCarrier).then(all{assert(s.phase==7),assert(safe),s'=s})
run gcBeforeRegistrationTest=init.then(pinSource).then(freezeWriters).then(scanSource).then(thawWriters).then(reserveCarrier).then(qualifyHost).then(publishCarrier).then(jointIssue).then(all{assert(s.carrierEpoch==1),assert(safe),s'=s})
run gcAfterTransferTest=init.then(pinSource).then(reserveCarrier).then(qualifyHost).then(publishCarrier).then(jointIssue).then(certifyTransfer).then(releaseSource).then(freezeWriters).then(scanCarrier).then(thawWriters).then(writeEntryState).then(allocateMarker).then(all{assert(s.marker==1 and s.carrierEpoch==1),assert(safe),s'=s})
run closeWithBorrowTest=init.then(pinSource).then(reserveCarrier).then(qualifyHost).then(publishCarrier).then(jointIssue).then(writeEntryState).then(allocateMarker).then(enterNested).then(closeIngress).then(freezeWriters).then(scanBoth).then(thawWriters).then(leaveNested).then(recordOutcome).then(settleKnown).then(all{assert(s.phase==6 and s.sourcePin==1),assert(safe),s'=s})
run unknownRecordedTest=init.then(pinSource).then(reserveCarrier).then(qualifyHost).then(publishCarrier).then(jointIssue).then(writeEntryState).then(allocateMarker).then(recordOutcome).then(enterNested).then(loseCompletion).then(closeIngress).then(freezeWriters).then(scanBoth).then(thawWriters).then(landNested).then(recoverRecorded).then(all{assert(s.phase==6),assert(safe),s'=s})
run unknownNoRecordTest=init.then(pinSource).then(reserveCarrier).then(qualifyHost).then(publishCarrier).then(jointIssue).then(writeEntryState).then(allocateMarker).then(loseCompletion).then(closeIngress).then(freezeWriters).then(scanBoth).then(thawWriters).then(all{assert(s.phase==5 and s.unknown==1 and s.carrierRoot==1),assert(safe),s'=s})
run exhaustedTest=init.then(pinSource).then(exhaustCarrier).then(closeIngress).then(closeScanAdmission).then(confirmGrace).then(retireCarrier).then(all{assert(s.phase==7 and s.marker==0),assert(safe),s'=s})
run lostRegistrationTest=init.then(pinSource).then(reserveCarrier).then(qualifyHost).then(publishCarrier).then(loseRegistrationAck).then(closeIngress).then(freezeWriters).then(scanBoth).then(thawWriters).then(confirmSameRegistration).then(rejectClosed).then(closeScanAdmission).then(confirmGrace).then(retireCarrier).then(all{assert(s.phase==7),assert(safe),s'=s})
run repeatedRoundsTest=init.then(pinSource).then(reserveCarrier).then(qualifyHost).then(publishCarrier).then(jointIssue).then(freezeWriters).then(scanBoth).then(thawWriters).then(certifyTransfer).then(releaseSource).then(freezeWriters).then(scanCarrier).then(thawWriters).then(writeEntryState).then(allocateMarker).then(all{assert(s.epoch==2 and s.carrierEpoch==2 and s.sourceRoot==0),assert(safe),s'=s})
}
