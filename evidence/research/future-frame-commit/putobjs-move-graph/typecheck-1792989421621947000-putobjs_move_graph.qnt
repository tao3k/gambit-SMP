module putobjs_move_graph {
// Selected post-PutObjs publication: retained401, batch800, previous shared suffix1.
type State={p:int,c:int,knowledge:int,mutex:int,walk:int,cursor:int,sharedHead:int,sharedCount:int,destHead:int,destTail:int,destCount:int,tailNext:int,localTail:int,pops:int,popPtr:int,nMove:int,tailReturned:int,tailReused:int,receipt:int,held:int,gate:int,readers:int,ready:int,generation:int,stamp:int,opaqueOnly:int,oldRead:int}
pure val initial:State={p:0,c:0,knowledge:0,mutex:1,walk:0,cursor:402,sharedHead:402,sharedCount:801,destHead:0,destTail:0,destCount:0,tailNext:1202,localTail:1201,pops:0,popPtr:0,nMove:0,tailReturned:0,tailReused:0,receipt:0,held:1,gate:1,readers:1,ready:0,generation:1,stamp:1,opaqueOnly:0,oldRead:0}
var s:State
action init=s'=initial
val safe=all{all{s.p>=0,s.p<=5},all{s.c>=0,s.c<=13},all{s.knowledge>=0,s.knowledge<=2},all{s.mutex>=0,s.mutex<=2},all{s.walk>=0,s.walk<=799},all{s.cursor>=0,s.cursor<=1201},all{s.sharedHead>=0,s.sharedHead<=1202},all{s.sharedCount>=0,s.sharedCount<=801},all{s.destHead>=0,s.destHead<=1201},all{s.destTail>=0,s.destTail<=1201},all{s.destCount>=0,s.destCount<=800},all{s.tailNext>=0,s.tailNext<=1202},all{s.localTail>=0,s.localTail<=1201},all{s.pops>=0,s.pops<=800},all{s.popPtr>=0,s.popPtr<=1201},all{s.nMove>=0,s.nMove<=800},all{s.tailReturned>=0,s.tailReturned<=1},all{s.tailReused>=0,s.tailReused<=1},all{s.receipt>=0,s.receipt<=1},all{s.held>=0,s.held<=1},all{s.gate>=0,s.gate<=1},all{s.readers>=0,s.readers<=1},all{s.ready>=0,s.ready<=1},all{s.generation>=0,s.generation<=2},all{s.stamp>=0,s.stamp<=1},all{s.opaqueOnly>=0,s.opaqueOnly<=1},all{s.oldRead>=0,s.oldRead<=1},s.generation>=1,s.stamp==1,s.cursor==402+s.walk,s.c<=4 implies s.walk==0,s.c>=6 implies s.walk==799,s.c<=4 implies s.sharedCount==801,s.c>=5 implies s.sharedCount==1,s.c<=5 implies s.sharedHead==402,s.c>=6 implies s.sharedHead==1202,s.c<=6 implies s.destTail==0,s.c>=7 implies s.destTail==1201,s.c<=7 implies s.tailNext==1202,s.c>=8 implies s.tailNext==0,s.c<=3 implies s.destCount==0,s.c>=4 and s.c<=9 implies s.destCount==800,s.c>=10 and s.c<=12 implies s.destCount+s.pops==800,s.c==13 implies s.destCount+s.pops==799,s.c<=9 implies s.pops==0,s.c>=11 implies s.pops<800,s.c>=11 implies s.popPtr==402+s.pops,s.c<=8 implies s.destHead==0,s.c==9 implies s.destHead==402,s.c==10 and s.pops<800 implies s.destHead==402+s.pops,s.c==10 and s.pops==800 implies s.destHead==0,s.c==11 implies s.destHead==402+s.pops,(s.c==12 or s.c==13) and s.pops==799 implies s.destHead==0,(s.c==12 or s.c==13) and s.pops<799 implies s.destHead==403+s.pops,s.c>=1 and s.c<=9 implies s.mutex==2,s.c>=10 implies s.mutex==0,s.c==0 and s.knowledge==0 implies s.mutex==1,s.c==0 and s.knowledge==1 implies s.mutex==0,s.p==0 implies all{s.knowledge==0,s.opaqueOnly==0,s.localTail==1201,s.receipt==0,s.c==0},s.p>=1 implies all{s.knowledge>=1,s.opaqueOnly==1},s.knowledge==2 implies all{s.p==1,s.localTail==1201,s.held==1,s.receipt==0,s.gate==1,s.readers==1,s.ready==0,s.generation==1},s.p==1 implies s.localTail==1201,s.p>=2 implies all{s.localTail==401,s.knowledge==1},s.p<=2 implies s.receipt==0,s.p>=3 implies s.receipt==1,s.p<=3 implies all{s.gate==1,s.readers==1},s.p>=4 implies s.gate==0,s.p<=4 implies all{s.held==1,s.generation==1},s.p==5 implies all{s.held==0,s.generation==2,s.readers==0,s.ready==1},s.ready==1 implies all{s.p>=4,s.c>=10,s.readers==0},s.tailReturned==1 implies s.pops==800,s.pops==800 implies s.tailReturned==1,s.tailReused==1 implies s.tailReturned==1}
action knownProducerUnlock=all{s.p==0,s'={...s,p:1,knowledge:1,mutex:0,opaqueOnly:1}}
action unknownReleased=all{s.p==0,s'={...s,p:1,knowledge:2,mutex:0,opaqueOnly:1}}
action unknownStillHeld=all{s.p==0,s'={...s,p:1,knowledge:2,mutex:1,opaqueOnly:1}}
action fixProducerLast=all{s.p==1 and s.knowledge==1,s'={...s,p:2,localTail:401}}
action publishReceipt=all{s.p==2 and s.knowledge==1,s'={...s,p:3,receipt:1}}
action closeSourceAdmission=all{s.p==3,s'={...s,p:4,gate:0}}
action sourceReadersDetached=all{s.p==4 and s.readers==1,s'={...s,readers:0}}
action attestSourceFinalized=all{s.p==4 and s.readers==0 and s.c>=10 and s.ready==0,s'={...s,ready:1}}
action reuseSourceCache=all{s.p==4 and s.readers==0 and s.ready==1 and s.held==1,s'={...s,p:5,held:0,generation:2}}
action borrowOldTail=all{s.p==0 and s.knowledge==0 and s.mutex==1 and s.oldRead==0,s'={...s,oldRead:1}}
action acquireConsumer=all{s.c==0 and s.mutex==0,s'={...s,c:1,mutex:2}}
action selectMove800=all{s.c==1,s'={...s,c:2,nMove:800}}
action loadMoveHead=all{s.c==2,s'={...s,c:3,cursor:402}}
action creditDestination=all{s.c==3,s'={...s,c:4,destCount:800}}
action debitShared=all{s.c==4,s'={...s,c:5,sharedCount:1}}
action walkMovedNext=all{s.c==5 and s.walk<799,s'={...s,walk:s.walk+1,cursor:s.cursor+1}}
action detachSharedHead=all{s.c==5 and s.walk==799,s'={...s,c:6,sharedHead:s.tailNext}}
action assignDestinationTail=all{s.c==6,s'={...s,c:7,destTail:s.cursor}}
action cutMovedTail=all{s.c==7,s'={...s,c:8,tailNext:s.destHead}}
action publishDestinationHead=all{s.c==8,s'={...s,c:9,destHead:402}}
action releaseConsumer=all{s.c==9,s'={...s,c:10,mutex:0}}
action loadPopHead=all{s.c==10 and s.destCount>0,s'={...s,c:11,popPtr:s.destHead}}
action advanceInteriorHead=all{s.c==11 and s.popPtr<1201,s'={...s,c:12,destHead:s.popPtr+1}}
action advanceLastHead=all{s.c==11 and s.popPtr==1201,s'={...s,c:12,destHead:0}}
action decrementDestination=all{s.c==12,s'={...s,c:13,destCount:s.destCount-1}}
action returnInterior=all{s.c==13 and s.popPtr<1201,s'={...s,c:10,pops:s.pops+1}}
action returnTail=all{s.c==13 and s.popPtr==1201,s'={...s,c:10,pops:s.pops+1,tailReturned:1}}
action initializeTailPayload=all{s.tailReturned==1 and s.tailReused==0,s'={...s,tailReused:1}}
action step=any{knownProducerUnlock,unknownReleased,unknownStillHeld,fixProducerLast,publishReceipt,closeSourceAdmission,sourceReadersDetached,attestSourceFinalized,reuseSourceCache,borrowOldTail,acquireConsumer,selectMove800,loadMoveHead,creditDestination,debitShared,walkMovedNext,detachSharedHead,assignDestinationTail,cutMovedTail,publishDestinationHead,releaseConsumer,loadPopHead,advanceInteriorHead,advanceLastHead,decrementDestination,returnInterior,returnTail,initializeTailPayload,all{s'=s}}
run consumeBeforeFixTest=init.then(knownProducerUnlock).then(acquireConsumer.then(selectMove800).then(loadMoveHead).then(creditDestination).then(debitShared).then(799.reps(i=>walkMovedNext)).then(detachSharedHead).then(assignDestinationTail).then(cutMovedTail).then(publishDestinationHead).then(releaseConsumer)).then(799.reps(i=>loadPopHead.then(advanceInteriorHead).then(decrementDestination).then(returnInterior)).then(loadPopHead).then(advanceLastHead).then(decrementDestination).then(returnTail).then(initializeTailPayload)).then(fixProducerLast).then(publishReceipt).then(all{assert(safe),s'=s})
run fixBeforeMoveTest=init.then(knownProducerUnlock).then(fixProducerLast).then(acquireConsumer.then(selectMove800).then(loadMoveHead).then(creditDestination).then(debitShared).then(799.reps(i=>walkMovedNext)).then(detachSharedHead).then(assignDestinationTail).then(cutMovedTail).then(publishDestinationHead).then(releaseConsumer)).then(799.reps(i=>loadPopHead.then(advanceInteriorHead).then(decrementDestination).then(returnInterior)).then(loadPopHead).then(advanceLastHead).then(decrementDestination).then(returnTail).then(initializeTailPayload)).then(publishReceipt).then(all{assert(safe),s'=s})
run fixWhileConsumerLockedTest=init.then(knownProducerUnlock).then(acquireConsumer).then(fixProducerLast).then(selectMove800).then(loadMoveHead).then(creditDestination).then(debitShared).then(799.reps(i=>walkMovedNext)).then(detachSharedHead).then(assignDestinationTail).then(cutMovedTail).then(publishDestinationHead).then(releaseConsumer).then(all{assert(safe),s'=s})
run unknownReleasedConsumesTest=init.then(unknownReleased).then(acquireConsumer.then(selectMove800).then(loadMoveHead).then(creditDestination).then(debitShared).then(799.reps(i=>walkMovedNext)).then(detachSharedHead).then(assignDestinationTail).then(cutMovedTail).then(publishDestinationHead).then(releaseConsumer)).then(799.reps(i=>loadPopHead.then(advanceInteriorHead).then(decrementDestination).then(returnInterior)).then(loadPopHead).then(advanceLastHead).then(decrementDestination).then(returnTail).then(initializeTailPayload)).then(all{assert(safe),s'=s})
run unknownHeldBlocksTest=init.then(unknownStillHeld).then(all{assert(safe),s'=s})
run retireAfterConsumerTest=init.then(knownProducerUnlock).then(acquireConsumer.then(selectMove800).then(loadMoveHead).then(creditDestination).then(debitShared).then(799.reps(i=>walkMovedNext)).then(detachSharedHead).then(assignDestinationTail).then(cutMovedTail).then(publishDestinationHead).then(releaseConsumer)).then(fixProducerLast).then(publishReceipt).then(closeSourceAdmission).then(sourceReadersDetached).then(attestSourceFinalized).then(reuseSourceCache).then(all{assert(safe),s'=s})
run oldTailReuseNoBorrowTest=init.then(knownProducerUnlock).then(acquireConsumer.then(selectMove800).then(loadMoveHead).then(creditDestination).then(debitShared).then(799.reps(i=>walkMovedNext)).then(detachSharedHead).then(assignDestinationTail).then(cutMovedTail).then(publishDestinationHead).then(releaseConsumer)).then(799.reps(i=>loadPopHead.then(advanceInteriorHead).then(decrementDestination).then(returnInterior)).then(loadPopHead).then(advanceLastHead).then(decrementDestination).then(returnTail).then(initializeTailPayload)).then(all{assert(not(s.p==0 and s.knowledge==0 and s.mutex==1 and s.oldRead==0)),assert(safe),s'=s})
run unknownNoFixTest=init.then(unknownReleased).then(acquireConsumer.then(selectMove800).then(loadMoveHead).then(creditDestination).then(debitShared).then(799.reps(i=>walkMovedNext)).then(detachSharedHead).then(assignDestinationTail).then(cutMovedTail).then(publishDestinationHead).then(releaseConsumer)).then(799.reps(i=>loadPopHead.then(advanceInteriorHead).then(decrementDestination).then(returnInterior)).then(loadPopHead).then(advanceLastHead).then(decrementDestination).then(returnTail).then(initializeTailPayload)).then(all{assert(not(s.p==1 and s.knowledge==1)),assert(safe),s'=s})
run unknownNoRetireTest=init.then(unknownReleased).then(acquireConsumer.then(selectMove800).then(loadMoveHead).then(creditDestination).then(debitShared).then(799.reps(i=>walkMovedNext)).then(detachSharedHead).then(assignDestinationTail).then(cutMovedTail).then(publishDestinationHead).then(releaseConsumer)).then(799.reps(i=>loadPopHead.then(advanceInteriorHead).then(decrementDestination).then(returnInterior)).then(loadPopHead).then(advanceLastHead).then(decrementDestination).then(returnTail).then(initializeTailPayload)).then(all{assert(not(s.p==4 and s.readers==0 and s.ready==1 and s.held==1)),assert(safe),s'=s})
run unknownHeldNoConsumerTest=init.then(unknownStillHeld).then(all{assert(not(s.c==0 and s.mutex==0)),assert(safe),s'=s})
run beforeConsumerNoFinalizeTest=init.then(knownProducerUnlock).then(fixProducerLast).then(publishReceipt).then(closeSourceAdmission).then(sourceReadersDetached).then(all{assert(not(s.p==4 and s.readers==0 and s.c>=10 and s.ready==0)),assert(safe),s'=s})
}
