module cache_ready_publication {
// RuntimeServiceReady and pre-reserved NativeThreadDomain guard are external premises.
type State={stage:int,owned:int,busy:int,owner:int,tls:int,fast:int,listed:int,ready:int,ack:int,builder:int,readerPin:int,diagPin:int,diagState:int,snapshot:int,statsOK:int,formatted:int,rollbackUnknown:int,pendingSeen:int,cleanupOK:int,generation:int,snapshotGen:int,allocations:int}
pure val initial:State={stage:0,owned:0,busy:0,owner:0,tls:0,fast:0,listed:0,ready:0,ack:0,builder:1,readerPin:0,diagPin:0,diagState:0,snapshot:0,statsOK:0,formatted:0,rollbackUnknown:0,pendingSeen:0,cleanupOK:0,generation:1,snapshotGen:0,allocations:0}
var s:State
action init=s'=initial
val safe=all{all{s.stage>=0,s.stage<=10},all{s.owned>=0,s.owned<=1},all{s.busy>=0,s.busy<=1},all{s.owner>=0,s.owner<=1},all{s.tls>=0,s.tls<=2},all{s.fast>=0,s.fast<=1},all{s.listed>=0,s.listed<=1},all{s.ready>=0,s.ready<=1},all{s.ack>=0,s.ack<=3},all{s.builder>=0,s.builder<=1},all{s.readerPin>=0,s.readerPin<=1},all{s.diagPin>=0,s.diagPin<=1},all{s.diagState>=0,s.diagState<=5},all{s.snapshot>=0,s.snapshot<=1},all{s.statsOK>=0,s.statsOK<=1},all{s.formatted>=0,s.formatted<=1},all{s.rollbackUnknown>=0,s.rollbackUnknown<=1},all{s.pendingSeen>=0,s.pendingSeen<=1},all{s.cleanupOK>=0,s.cleanupOK<=1},all{s.generation>=0,s.generation<=2},all{s.snapshotGen>=0,s.snapshotGen<=1},all{s.allocations>=0,s.allocations<=1},s.generation>=1,s.stage==0 implies all{s.owned==0,s.busy==0,s.owner==0,s.tls==0,s.listed==0,s.ready==0,s.ack==0,s.allocations==0},s.stage>=1 and s.stage<=7 implies s.busy==1,s.stage==9 implies s.busy==1,s.stage==1 implies all{s.owned==0,s.owner==0,s.tls==0,s.listed==0,s.ready==0,s.ack==0,s.allocations==0},s.stage>=2 and s.stage<=7 implies all{s.owned==1,s.allocations==1},s.stage==2 implies all{s.owner==0,s.tls==0,s.listed==0,s.ready==0,s.ack==0},s.stage>=3 and s.stage<=7 implies s.owner==1,s.stage==3 implies all{s.tls!=1,s.listed==0,s.ready==0,s.ack==0},s.stage==4 implies all{s.tls==1,s.listed==0,s.ready==0,s.ack==0},s.stage==5 implies all{s.tls==1,s.listed==1,s.ready==0,(s.ack==0 or s.ack==2)},s.stage==6 implies all{s.ready==1,s.owned==1,s.owner==1,s.tls==1,s.listed==1,(s.ack==1 or s.ack==2)},s.ready==1 implies s.stage==6,s.stage==7 implies all{s.ready==0,(s.ack==1 or s.ack==2)},s.stage==8 implies all{s.owned==0,s.busy==0,s.ready==0,s.ack==1,s.builder==0,s.readerPin==0,s.diagPin==0,s.tls==0,s.fast==0,s.listed==0,s.cleanupOK==1,s.generation==2},s.stage==9 implies all{s.ready==0,s.ack==3,s.builder==1,s.readerPin==0,s.diagPin==0,s.diagState==0,s.fast==0},s.stage==10 implies all{s.owned==0,s.busy==0,s.ready==0,s.builder==0,s.readerPin==0,s.diagPin==0,s.tls==0,s.fast==0,s.listed==0,s.ack==3},s.stage!=8 implies s.generation==1,s.stage<=5 implies all{s.builder==1,s.readerPin==0,s.diagPin==0,s.diagState==0,s.fast==0,s.cleanupOK==0},s.ack==2 implies all{s.builder==1,(s.stage==5 or s.stage==6 or s.stage==7)},s.tls==2 implies all{s.stage==3,s.owned==1,s.builder==1,s.ready==0},s.readerPin==1 implies all{(s.stage==6 or s.stage==7),s.owned==1,s.tls==1},s.diagPin==1 implies all{(s.stage==6 or s.stage==7),s.owned==1,s.tls==1,s.diagState>=1,s.diagState<=3},s.diagState>=1 and s.diagState<=3 implies s.diagPin==1,s.diagState==0 implies all{s.diagPin==0,s.snapshot==0,s.snapshotGen==0,s.formatted==0},(s.diagState==1 or s.diagState==2) implies all{s.snapshot==0,s.snapshotGen==0,s.formatted==0},s.diagState>=3 implies all{s.snapshot==1,s.snapshotGen==1},s.diagState>=4 implies s.diagPin==0,s.diagState==5 implies s.formatted==1,s.formatted==1 implies all{s.diagState==5,s.diagPin==0},s.snapshot==1 implies s.diagState>=3,s.cleanupOK==1 implies all{(s.stage==7 or s.stage==8),s.builder==0,s.ack==1,s.readerPin==0,s.diagPin==0,s.tls==0,s.fast==0,s.listed==0},s.rollbackUnknown==1 implies all{s.stage==9,s.ready==0,s.builder==1,s.listed==0,s.tls==0,s.fast==0},s.stage<=5 implies s.statsOK==0,s.stage==9 or s.stage==10 implies s.statsOK==0}
action reserveConstruction=all{s.stage==0,s'={...s,stage:1,busy:1}}
action allocateCandidate=all{s.stage==1 and s.allocations==0,s'={...s,stage:2,owned:1,allocations:1}}
action allocationRejected=all{s.stage==1 and s.allocations==0,s'={...s,stage:9,ack:3}}
action initializeOwner=all{s.stage==2,s'={...s,stage:3,owner:1}}
action installTlsKnown=all{s.stage==3 and s.tls==0,s'={...s,stage:4,tls:1}}
action installTlsUnknown=all{s.stage==3 and s.tls==0,s'={...s,tls:2}}
action stageRegistryEntry=all{s.stage==4,s'={...s,stage:5,listed:1}}
action publishKnown=all{s.stage==5 and s.ack==0,s'={...s,stage:6,ready:1,ack:1}}
action publishUnknownCommitted=all{s.stage==5 and s.ack==0,s'={...s,stage:6,ready:1,ack:2}}
action publishUnknownAbsent=all{s.stage==5 and s.ack==0,s'={...s,ack:2}}
action rejectPublication=all{s.stage==5 and s.ack==0,s'={...s,stage:9,ack:3}}
action reconcileCommitted=all{(s.stage==6 or s.stage==7) and s.ack==2,s'={...s,ack:1}}
action reconcileAbsent=all{s.stage==5 and s.ack==2,s'={...s,stage:9,ack:3}}
action finishBuilder=all{(s.stage==6 or s.stage==7) and s.ack==1 and s.builder==1,s'={...s,builder:0}}
action publishFastHandle=all{s.stage==6 and s.ready==1 and s.fast==0,s'={...s,fast:1}}
action constructionReentry=all{s.stage>=1 and s.stage<=5 and s.busy==1 and s.ready==0 and s.pendingSeen==0,s'={...s,pendingSeen:1}}
action closingReentry=all{s.stage==7 and s.ready==0 and s.pendingSeen==0,s'={...s,pendingSeen:1}}
action acquireReader=all{s.stage==6 and s.ready==1 and s.readerPin==0,s'={...s,readerPin:1}}
action releaseReader=all{s.readerPin==1,s'={...s,readerPin:0}}
action qualifyStats=all{s.stage==6 and s.statsOK==0,s'={...s,statsOK:1}}
action beginDiagnostic=all{s.stage==6 and s.ready==1 and s.statsOK==1 and s.diagState==0,s'={...s,diagState:1,diagPin:1}}
action requestOwnerSnapshot=all{s.diagState==1,s'={...s,diagState:2}}
action ownerSnapshotAck=all{s.diagState==2 and s.statsOK==1,s'={...s,diagState:3,snapshot:1,snapshotGen:1}}
action releaseDiagnosticPin=all{s.diagState==3 and s.snapshot==1,s'={...s,diagState:4,diagPin:0}}
action formatSnapshot=all{s.diagState==4 and s.snapshot==1 and s.formatted==0,s'={...s,diagState:5,formatted:1}}
action closeReady=all{s.stage==6,s'={...s,stage:7,ready:0}}
action unlinkEntry=all{(s.stage==7 or s.stage==9) and s.listed==1,s'={...s,listed:0}}
action clearTlsKnown=all{(s.stage==7 or s.stage==9) and s.tls==1 and s.readerPin==0 and s.diagPin==0,s'={...s,tls:0}}
action clearFastKnown=all{s.stage==7 and s.fast==1 and s.readerPin==0 and s.diagPin==0,s'={...s,fast:0}}
action attestNativeCleanup=all{s.stage==7 and s.builder==0 and s.ack==1 and s.readerPin==0 and s.diagPin==0 and s.tls==0 and s.fast==0 and s.listed==0 and s.rollbackUnknown==0 and s.cleanupOK==0,s'={...s,cleanupOK:1}}
action retireKnown=all{s.stage==7 and s.builder==0 and s.ack==1 and s.readerPin==0 and s.diagPin==0 and s.tls==0 and s.fast==0 and s.listed==0 and s.rollbackUnknown==0 and s.cleanupOK==1,s'={...s,stage:8,owned:0,busy:0,generation:2}}
action rollbackUnknown=all{s.stage==9 and s.ack==3 and s.listed==0 and s.tls==0 and s.fast==0 and s.readerPin==0 and s.diagPin==0 and s.rollbackUnknown==0,s'={...s,rollbackUnknown:1}}
action rollbackKnown=all{s.stage==9 and s.ack==3 and s.listed==0 and s.tls==0 and s.fast==0 and s.readerPin==0 and s.diagPin==0 and s.rollbackUnknown==0,s'={...s,stage:10,owned:0,busy:0,builder:0}}
action step=any{reserveConstruction,allocateCandidate,allocationRejected,initializeOwner,installTlsKnown,installTlsUnknown,stageRegistryEntry,publishKnown,publishUnknownCommitted,publishUnknownAbsent,rejectPublication,reconcileCommitted,reconcileAbsent,finishBuilder,publishFastHandle,constructionReentry,closingReentry,acquireReader,releaseReader,qualifyStats,beginDiagnostic,requestOwnerSnapshot,ownerSnapshotAck,releaseDiagnosticPin,formatSnapshot,closeReady,unlinkEntry,clearTlsKnown,clearFastKnown,attestNativeCleanup,retireKnown,rollbackUnknown,rollbackKnown,all{s'=s}}
run knownTest=init.then(reserveConstruction).then(allocateCandidate).then(initializeOwner).then(installTlsKnown).then(stageRegistryEntry).then(publishKnown).then(finishBuilder).then(all{assert(safe),s'=s})
run earlyReentryTest=init.then(reserveConstruction).then(constructionReentry).then(allocateCandidate).then(all{assert(safe),s'=s})
run unknownTlsTest=init.then(reserveConstruction).then(allocateCandidate).then(initializeOwner).then(installTlsUnknown).then(constructionReentry).then(all{assert(safe),s'=s})
run unknownCommittedTest=init.then(reserveConstruction).then(allocateCandidate).then(initializeOwner).then(installTlsKnown).then(stageRegistryEntry).then(publishUnknownCommitted).then(acquireReader).then(releaseReader).then(reconcileCommitted).then(finishBuilder).then(all{assert(safe),s'=s})
run unknownAbsentTest=init.then(reserveConstruction).then(allocateCandidate).then(initializeOwner).then(installTlsKnown).then(stageRegistryEntry).then(publishUnknownAbsent).then(constructionReentry).then(reconcileAbsent).then(unlinkEntry).then(clearTlsKnown).then(rollbackKnown).then(all{assert(safe),s'=s})
run rejectedTest=init.then(reserveConstruction).then(allocateCandidate).then(initializeOwner).then(installTlsKnown).then(stageRegistryEntry).then(rejectPublication).then(unlinkEntry).then(clearTlsKnown).then(rollbackKnown).then(all{assert(safe),s'=s})
run unknownRollbackTest=init.then(reserveConstruction).then(allocateCandidate).then(initializeOwner).then(installTlsKnown).then(stageRegistryEntry).then(rejectPublication).then(unlinkEntry).then(clearTlsKnown).then(rollbackUnknown).then(all{assert(safe),s'=s})
run lateFormatTest=init.then(reserveConstruction).then(allocateCandidate).then(initializeOwner).then(installTlsKnown).then(stageRegistryEntry).then(publishKnown).then(finishBuilder).then(qualifyStats.then(beginDiagnostic).then(requestOwnerSnapshot).then(ownerSnapshotAck).then(releaseDiagnosticPin)).then(closeReady).then(unlinkEntry).then(clearTlsKnown).then(attestNativeCleanup).then(retireKnown).then(formatSnapshot).then(all{assert(safe),s'=s})
run snapshotDuringCloseTest=init.then(reserveConstruction).then(allocateCandidate).then(initializeOwner).then(installTlsKnown).then(stageRegistryEntry).then(publishKnown).then(finishBuilder).then(qualifyStats).then(beginDiagnostic).then(requestOwnerSnapshot).then(closeReady).then(unlinkEntry).then(ownerSnapshotAck).then(releaseDiagnosticPin).then(clearTlsKnown).then(attestNativeCleanup).then(retireKnown).then(formatSnapshot).then(all{assert(safe),s'=s})
run fastCloseTest=init.then(reserveConstruction).then(allocateCandidate).then(initializeOwner).then(installTlsKnown).then(stageRegistryEntry).then(publishKnown).then(finishBuilder).then(publishFastHandle).then(acquireReader).then(closeReady).then(closingReentry).then(releaseReader).then(unlinkEntry).then(clearFastKnown).then(clearTlsKnown).then(attestNativeCleanup).then(retireKnown).then(all{assert(safe),s'=s})
run noReadyDuringTlsUnknownTest=init.then(reserveConstruction).then(allocateCandidate).then(initializeOwner).then(installTlsUnknown).then(all{assert(not(s.stage==4)),assert(safe),s'=s})
run pendingNoSecondAllocationTest=init.then(reserveConstruction).then(allocateCandidate).then(constructionReentry).then(all{assert(not(s.stage==1 and s.allocations==0)),assert(safe),s'=s})
run noStatsFromReadyTest=init.then(reserveConstruction).then(allocateCandidate).then(initializeOwner).then(installTlsKnown).then(stageRegistryEntry).then(publishKnown).then(finishBuilder).then(all{assert(not(s.stage==6 and s.ready==1 and s.statsOK==1 and s.diagState==0)),assert(safe),s'=s})
run unknownNoRollbackTest=init.then(reserveConstruction).then(allocateCandidate).then(initializeOwner).then(installTlsKnown).then(stageRegistryEntry).then(publishUnknownAbsent).then(all{assert(not(s.stage==9 and s.ack==3 and s.listed==0 and s.tls==0 and s.fast==0 and s.readerPin==0 and s.diagPin==0 and s.rollbackUnknown==0)),assert(safe),s'=s})
run readerPinsBlockTlsClearTest=init.then(reserveConstruction).then(allocateCandidate).then(initializeOwner).then(installTlsKnown).then(stageRegistryEntry).then(publishKnown).then(finishBuilder).then(acquireReader).then(closeReady).then(all{assert(not((s.stage==7 or s.stage==9) and s.tls==1 and s.readerPin==0 and s.diagPin==0)),assert(safe),s'=s})
run copyPendingNoUnpinTest=init.then(reserveConstruction).then(allocateCandidate).then(initializeOwner).then(installTlsKnown).then(stageRegistryEntry).then(publishKnown).then(finishBuilder).then(qualifyStats).then(beginDiagnostic).then(requestOwnerSnapshot).then(all{assert(not(s.diagState==3 and s.snapshot==1)),assert(safe),s'=s})
run noRollbackRetryTest=init.then(reserveConstruction).then(allocateCandidate).then(initializeOwner).then(installTlsKnown).then(stageRegistryEntry).then(rejectPublication).then(unlinkEntry).then(clearTlsKnown).then(rollbackUnknown).then(all{assert(not(s.stage==9 and s.ack==3 and s.listed==0 and s.tls==0 and s.fast==0 and s.readerPin==0 and s.diagPin==0 and s.rollbackUnknown==0)),assert(safe),s'=s})
run closedFastNoReaderTest=init.then(reserveConstruction).then(allocateCandidate).then(initializeOwner).then(installTlsKnown).then(stageRegistryEntry).then(publishKnown).then(finishBuilder).then(publishFastHandle).then(closeReady).then(all{assert(not(s.stage==6 and s.ready==1 and s.readerPin==0)),assert(safe),s'=s})
}
