import FrameActivationAst
import FrameCommit
import LazySplit
namespace FrameActivation
open FrameActivationAst
def native (q : State) : FrameCommitAst.State := {decision:=q.n_decision, claims:=q.n_claims, done:=q.n_done, resultRoot:=q.n_resultRoot, sourceRoot:=q.n_sourceRoot, destRoot:=q.n_destRoot, childRoot:=q.n_childRoot, copyReady:=q.n_copyReady, copyRev:=q.n_copyRev, viewRev:=q.n_viewRev, viewGen:=q.n_viewGen, viewLease:=q.n_viewLease, patchReady:=q.n_patchReady, patchRev:=q.n_patchRev, patchGen:=q.n_patchGen, patchLease:=q.n_patchLease, gate:=q.n_gate, admitted:=q.n_admitted, generation:=q.n_generation, grantGen:=q.n_grantGen, lease:=q.n_lease, revision:=q.n_revision, sourceHeap:=q.n_sourceHeap, localGrants:=q.n_localGrants, remoteGrants:=q.n_remoteGrants, copyOps:=q.n_copyOps, validations:=q.n_validations, probes:=q.n_probes}
def queue (q : State) : LazySplitAst.State := {phase:=q.p_phase, eligible:=q.p_eligible, claims:=q.p_claims, probes:=q.p_probes, childRuns:=q.p_childRuns, childDone:=q.p_childDone, sourceRoot:=q.p_sourceRoot, copyRoot:=q.p_copyRoot, ready:=q.p_ready, queueRoot:=q.p_queueRoot, restoreRoot:=q.p_restoreRoot, contextRoot:=q.p_contextRoot, resultRoot:=q.p_resultRoot, placeholder:=q.p_placeholder, materialized:=q.p_materialized, split:=q.p_split, parentOwner:=q.p_parentOwner, prefixRuns:=q.p_prefixRuns, parentRuns:=q.p_parentRuns, captured:=q.p_captured, captureRoot:=q.p_captureRoot, exited:=q.p_exited, descriptor:=q.p_descriptor, gcOpen:=q.p_gcOpen, frozen:=q.p_frozen, scanning:=q.p_scanning, scanned:=q.p_scanned, epoch:=q.p_epoch, vSource:=q.p_vSource, vCopy:=q.p_vCopy, vQueue:=q.p_vQueue, vRestore:=q.p_vRestore, vContext:=q.p_vContext, vResult:=q.p_vResult, vCapture:=q.p_vCapture, resultPublished:=q.p_resultPublished}
def Aligned (q : State) : Prop := ((q.n_done=q.p_childDone) ∧ (q.n_resultRoot=q.p_resultRoot) ∧ (q.n_claims=q.p_claims) ∧ (q.n_sourceRoot=q.p_sourceRoot) ∧ (q.n_destRoot=(q.p_copyRoot+q.p_contextRoot)) ∧ (q.n_copyReady=q.p_ready) ∧ (((q.n_decision=(2)) → (q.p_split=(1))) ∧ ((q.p_split=(1)) → (q.n_decision=(2)))) ∧ ((q.n_decision=(0)) → ((q.p_phase=(0)) ∨ (q.p_phase=(6)))) ∧ ((q.n_decision=(1)) → ((q.p_phase≥(1)) ∧ (q.p_phase≤(3)))) ∧ ((q.n_decision=(3)) → ((q.p_phase=(0)) ∨ (q.p_phase=(6)))) ∧ (q.p_phase≤(7)) ∧ (q.p_parentRuns=(q.n_localGrants+q.n_remoteGrants)) ∧ (((q.n_gate=(2)) → (q.p_gcOpen=(0))) ∧ ((q.p_gcOpen=(0)) → (q.n_gate=(2)))) ∧ (q.publication≥(0)) ∧ (q.publication≤(3)) ∧ (q.active≥(0)) ∧ (q.active≤(1)) ∧ (q.attempts≥(0)) ∧ ((q.publication=(1)) → (((q.n_decision=(1)) ∧ (q.p_phase=(2))) ∧ (q.n_destRoot=(1)))) ∧ (((q.publication=(2)) → ((((q.p_phase=(3)) ∨ (q.p_phase=(4))) ∨ (q.p_phase=(5))) ∨ (q.p_phase=(7)))) ∧ (((((q.p_phase=(3)) ∨ (q.p_phase=(4))) ∨ (q.p_phase=(5))) ∨ (q.p_phase=(7))) → (q.publication=(2)))) ∧ ((q.n_decision=(2)) → (q.publication=(2))) ∧ ((q.active=(1)) → (q.n_decision=(2))) ∧ (((q.p_phase=(5)) ∨ (q.p_phase=(7))) → (q.active=(1))) ∧ (q.p_captured=(0)) ∧ (q.p_exited=(0)))
theorem safeEquivalent (q : State) : Safe q ↔ FrameCommitAst.Safe (native q) ∧ LazySplitAst.Safe (queue q) ∧ Aligned q := by rfl
end FrameActivation
