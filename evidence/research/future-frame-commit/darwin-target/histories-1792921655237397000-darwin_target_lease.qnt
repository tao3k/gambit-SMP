module darwin_target_lease {
// One old provider bundle, one allocation origin and one nested invocation.
// Publication certificates and backend receipts are native refinement premises.
type State={published:int,gate:int,current:int,oldLive:int,certificate:int,mayAbandon:int,outer:int,nested:int,maintenance:int,origin:int,allocFamily:int,freeFamily:int,operation:int,pointer:int,recorded:int,unknown:int,custodian:int,freeApplied:int,freeReceipt:int,retired:int}
pure val initial:State={published:0,gate:0,current:0,oldLive:0,certificate:0,mayAbandon:0,outer:0,nested:0,maintenance:0,origin:0,allocFamily:0,freeFamily:0,operation:0,pointer:0,recorded:0,unknown:0,custodian:0,freeApplied:0,freeReceipt:0,retired:0}
var s:State
action init=s'=initial
val safe=all{s.current>=0,s.current<=2,s.allocFamily>=0,s.allocFamily<=1,s.freeFamily>=0,s.freeFamily<=1,s.operation>=0,s.operation<=7,s.custodian>=0,s.custodian<=2,s.published>=0,s.published<=1,s.gate>=0,s.gate<=1,s.oldLive>=0,s.oldLive<=1,s.certificate>=0,s.certificate<=1,s.mayAbandon>=0,s.mayAbandon<=1,s.outer>=0,s.outer<=1,s.nested>=0,s.nested<=1,s.maintenance>=0,s.maintenance<=1,s.origin>=0,s.origin<=1,s.pointer>=0,s.pointer<=1,s.recorded>=0,s.recorded<=1,s.unknown>=0,s.unknown<=1,s.freeApplied>=0,s.freeApplied<=1,s.freeReceipt>=0,s.freeReceipt<=1,s.retired>=0,s.retired<=1,s.published==0 implies all{s.gate==0,s.current==0,s.oldLive==0,s.certificate==0,s.outer==0,s.nested==0,s.maintenance==0,s.origin==0,s.operation==0,s.pointer==0,s.recorded==0,s.unknown==0,s.retired==0},s.gate==1 implies all{s.published==1,s.current==1,s.oldLive==1,s.certificate==1},s.outer+s.nested+s.maintenance+s.origin+s.unknown>=1 implies all{s.oldLive==1,s.certificate==1,s.published==1},s.origin==1 implies s.allocFamily==1,s.operation>=1 and s.operation<=6 implies s.origin==1,s.operation>=1 and s.operation<=2 implies s.outer==1,s.operation>=1 and s.operation<=4 implies all{s.maintenance==0,s.freeFamily==0,s.freeApplied==0,s.freeReceipt==0},s.operation==0 implies all{s.origin==0,s.pointer==0,s.recorded==0,s.freeApplied==0,s.freeReceipt==0,s.allocFamily==0,s.freeFamily==0,s.unknown==0,s.maintenance==0},s.nested==1 implies (s.outer==1 or s.maintenance==1),s.operation==1 implies all{s.pointer==0,s.recorded==0},s.operation==2 implies all{s.pointer==1,s.recorded==0},s.operation==3 implies all{s.pointer==1,s.recorded==1},s.operation==4 implies all{(s.recorded==1 implies s.pointer==1),s.unknown==1,s.origin==1,s.outer==1,s.custodian==2},s.operation>=5 and s.operation<=6 implies all{s.maintenance==1,s.recorded==1,s.freeFamily==s.allocFamily,s.freeFamily==1},s.operation==6 implies all{s.unknown==1,s.custodian==2},s.unknown==1 implies all{(s.operation==4 or s.operation==6),s.origin==1,s.custodian==2},s.operation==7 implies all{s.origin==0,s.pointer==0,s.unknown==0},s.freeReceipt==1 implies all{s.freeApplied==1,s.pointer==0,s.recorded==1},s.freeApplied==1 implies all{s.freeFamily==1,s.pointer==0},s.retired==1 implies all{s.oldLive==0,s.certificate==0,s.gate==0,s.outer==0,s.nested==0,s.maintenance==0,s.origin==0,s.unknown==0},s.oldLive==0 and s.published==1 implies s.retired==1}
action publishPlain=all{s.published==0,s'={...s,published:1,gate:1,current:1,oldLive:1,certificate:1}}
action publishAdmittedHooks=all{s.published==0,s'={...s,published:1,gate:1,current:1,oldLive:1,certificate:1,mayAbandon:1}}
action acquireOuter=all{s.published==1 and s.gate==1 and s.current==1 and s.oldLive==1 and s.certificate==1 and s.outer==0 and s.operation==0,s'={...s,outer:1,custodian:1}}
action closeOrdinary=all{s.published==1 and s.gate==1,s'={...s,gate:0}}
action publishReplacement=all{s.published==1 and s.gate==0 and s.current==1,s'={...s,current:2}}
action beginMalloc=all{s.outer==1 and s.operation==0 and s.origin==0 and s.nested==0,s'={...s,origin:1,allocFamily:1,operation:1}}
action obtainPointer=all{s.operation==1,s'={...s,operation:2,pointer:1}}
action recordSuccess=all{s.operation==2 and s.nested==0,s'={...s,operation:3,recorded:1}}
action recordNull=all{s.operation==1 and s.nested==0,s'={...s,operation:7,recorded:1,origin:0}}
action enterNested=all{s.oldLive==1 and s.mayAbandon==1 and (s.outer==1 or s.maintenance==1) and s.nested==0,s'={...s,nested:1}}
action leaveNested=all{s.nested==1,s'={...s,nested:0}}
action loseBeforeCapture=all{(s.operation==1 or s.operation==2) and s.mayAbandon==1,s'={...s,operation:4,unknown:1,custodian:2}}
action loseRecordedAck=all{s.operation==3 and s.outer==1,s'={...s,operation:4,unknown:1,custodian:2}}
action recoverRecorded=all{s.operation==4 and s.recorded==1 and s.nested==0,s'={...s,operation:3,unknown:0,custodian:1}}
action releaseOuter=all{s.outer==1 and (s.operation==0 or s.operation==3 or s.operation==7) and s.unknown==0 and s.nested==0,s'={...s,outer:0}}
action beginOriginFree=all{s.operation==3 and s.recorded==1 and s.origin==1 and s.oldLive==1 and s.outer==0 and s.maintenance==0,s'={...s,maintenance:1,operation:5,freeFamily:s.allocFamily,custodian:1}}
action applyFree=all{s.operation==5 and s.freeApplied==0 and s.nested==0,s'={...s,pointer:0,freeApplied:1}}
action recordFreeBackend=all{s.operation==5 and s.freeApplied==1 and s.nested==0,s'={...s,freeReceipt:1}}
action loseFreeReturn=all{s.operation==5,s'={...s,operation:6,unknown:1,custodian:2}}
action settleFree=all{s.operation==5 and s.freeReceipt==1 and s.nested==0,s'={...s,operation:7,origin:0}}
action reconcileFree=all{s.operation==6 and s.freeReceipt==1 and s.nested==0,s'={...s,operation:7,origin:0,unknown:0,custodian:1}}
action releaseMaintenance=all{s.operation==7 and s.maintenance==1 and s.unknown==0 and s.nested==0,s'={...s,maintenance:0}}
action retireOldBundle=all{s.published==1 and s.gate==0 and s.outer==0 and s.nested==0 and s.maintenance==0 and s.origin==0 and s.unknown==0 and s.oldLive==1,s'={...s,oldLive:0,certificate:0,retired:1}}
action step=any{publishPlain,publishAdmittedHooks,acquireOuter,closeOrdinary,publishReplacement,beginMalloc,obtainPointer,recordSuccess,recordNull,enterNested,leaveNested,loseBeforeCapture,loseRecordedAck,recoverRecorded,releaseOuter,beginOriginFree,applyFree,recordFreeBackend,loseFreeReturn,settleFree,reconcileFree,releaseMaintenance,retireOldBundle,all{s'=s}}
run oldOriginAfterSwapTest=init.then(publishPlain).then(acquireOuter).then(beginMalloc).then(obtainPointer).then(recordSuccess).then(releaseOuter).then(closeOrdinary).then(publishReplacement).then(beginOriginFree).then(applyFree).then(recordFreeBackend).then(settleFree).then(releaseMaintenance).then(retireOldBundle).then(all{assert(s.current==2 and s.freeFamily==1 and s.retired==1),assert(safe),s'=s})
run nestedCloseTest=init.then(publishAdmittedHooks).then(acquireOuter).then(beginMalloc).then(enterNested).then(closeOrdinary).then(publishReplacement).then(leaveNested).then(obtainPointer).then(recordSuccess).then(releaseOuter).then(all{assert(s.oldLive==1 and s.origin==1),assert(safe),s'=s})
run unknownPointerTest=init.then(publishAdmittedHooks).then(acquireOuter).then(beginMalloc).then(obtainPointer).then(enterNested).then(loseBeforeCapture).then(closeOrdinary).then(leaveNested).then(publishReplacement).then(all{assert(s.operation==4 and s.recorded==0 and s.oldLive==1),assert(safe),s'=s})
run capturedAckTest=init.then(publishPlain).then(acquireOuter).then(beginMalloc).then(obtainPointer).then(recordSuccess).then(loseRecordedAck).then(closeOrdinary).then(recoverRecorded).then(releaseOuter).then(all{assert(s.operation==3 and s.origin==1),assert(safe),s'=s})
run unknownFreeTest=init.then(publishAdmittedHooks).then(acquireOuter).then(beginMalloc).then(obtainPointer).then(recordSuccess).then(releaseOuter).then(closeOrdinary).then(beginOriginFree).then(applyFree).then(loseFreeReturn).then(all{assert(s.operation==6 and s.origin==1 and s.freeReceipt==0),assert(safe),s'=s})
run knownFreeReceiptTest=init.then(publishAdmittedHooks).then(acquireOuter).then(beginMalloc).then(obtainPointer).then(recordSuccess).then(releaseOuter).then(closeOrdinary).then(beginOriginFree).then(applyFree).then(recordFreeBackend).then(loseFreeReturn).then(reconcileFree).then(releaseMaintenance).then(retireOldBundle).then(all{assert(s.retired==1),assert(safe),s'=s})
run nullResultTest=init.then(publishPlain).then(acquireOuter).then(beginMalloc).then(recordNull).then(releaseOuter).then(closeOrdinary).then(retireOldBundle).then(all{assert(s.origin==0 and s.retired==1),assert(safe),s'=s})
run closeNoReadersTest=init.then(publishPlain).then(closeOrdinary).then(retireOldBundle).then(all{assert(s.retired==1),assert(safe),s'=s})
}
