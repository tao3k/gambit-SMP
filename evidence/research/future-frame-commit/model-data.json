      "validateCopy": "s.decision==1 and s.destRoot==1 and s.copyReady==1 and s.copyRev==s.revision and s.gate==1 and s.grantGen==s.generation and s.viewGen==s.generation and s.viewLease==s.lease and s.viewRev==s.revision",
      "prepareReturn": "s.decision==1 and s.destRoot==1 and s.copyReady==1 and s.copyRev==s.revision and s.gate==1 and s.grantGen==s.generation and s.viewGen==s.generation and s.viewLease==s.lease and s.viewRev==s.revision",
      "commitSplit": "s.decision==1 and s.copyReady==1 and s.destRoot==1 and s.copyRev==s.revision and s.patchReady==1 and s.patchRev==s.revision and s.patchGen==s.generation and s.patchLease==s.lease and s.gate==1 and s.grantGen==s.generation and s.viewGen==s.generation and s.viewLease==s.lease and s.viewRev==s.revision",
      "abortSplit": "s.decision==1 and s.gate==1 and s.grantGen==s.generation and s.viewGen==s.generation and s.viewLease==s.lease and s.viewRev==s.revision",
      "grantLocal": "s.decision==3 and s.done==1 and s.localGrants==0 and s.gate==1 and s.grantGen==s.generation and s.viewGen==s.generation and s.viewLease==s.lease and s.viewRev==s.revision",
      "grantRemote": "s.decision==2 and s.done==1 and s.remoteGrants==0 and s.copyReady==1 and s.copyRev==s.revision and s.gate==1 and s.grantGen==s.generation and s.viewGen==s.generation and s.viewLease==s.lease and s.viewRev==s.revision",
      "leaveRuntime": "s.gate==1",
      "enterGc": "s.gate==0 and s.admitted==1",
      "forwardNoCopy": "s.gate==2 and s.copyReady==0",
      "forwardWithCopy": "s.gate==2 and s.copyReady==1 and s.destRoot==1",
      "leaveGc": "s.gate==2",
      "closeDomain": "s.admitted==1",
      "resetDomain": "s.admitted==0 and s.gate==0",
      "failedProbe": "s.decision!=0"
