module runtime_tls_ready {
// Single admitted owner/epoch; native outcome receipts and all-owner roster are premises.
type State={g:int,locks:int,tables:int,genericKey:int,allocKey:int,initOwner:int,bootPin:int,cache:int,tls:int,fast:int,owner:int,usePin:int,finalizer:int,late:int,roster:int,observed:int,epoch:int,reentrySeen:int,rawSeen:int}
pure val initial:State={g:0,locks:0,tables:0,genericKey:0,allocKey:0,initOwner:0,bootPin:0,cache:0,tls:0,fast:0,owner:0,usePin:0,finalizer:0,late:0,roster:0,observed:0,epoch:1,reentrySeen:0,rawSeen:0}
var s:State
action init=s'=initial
val safe=all{all{s.g>=0,s.g<=4},all{s.locks>=0,s.locks<=1},all{s.tables>=0,s.tables<=1},all{s.genericKey>=0,s.genericKey<=1},all{s.allocKey>=0,s.allocKey<=2},all{s.initOwner>=0,s.initOwner<=1},all{s.bootPin>=0,s.bootPin<=1},all{s.cache>=0,s.cache<=4},all{s.tls>=0,s.tls<=2},all{s.fast>=0,s.fast<=1},all{s.owner>=0,s.owner<=1},all{s.usePin>=0,s.usePin<=1},all{s.finalizer>=0,s.finalizer<=1},all{s.late>=0,s.late<=1},all{s.roster>=0,s.roster<=1},all{s.observed>=0,s.observed<=1},all{s.epoch>=0,s.epoch<=2},all{s.reentrySeen>=0,s.reentrySeen<=1},all{s.rawSeen>=0,s.rawSeen<=1},s.epoch>=1,s.g==0 implies all{s.locks==0,s.tables==0,s.genericKey==0,s.allocKey==0,s.initOwner==0,s.cache==0,s.observed==0},s.g==1 implies all{s.initOwner==1,s.cache==0,s.observed==0,s.roster==0},s.g==2 implies all{s.locks==1,s.tables==1,s.genericKey==1,s.allocKey==1,s.initOwner==0,s.roster==0},s.g>=2 implies s.initOwner==0,s.g==4 implies all{s.cache==4,s.locks==0,s.tables==0,s.allocKey==0,s.genericKey==0,s.roster==1,s.epoch==2},s.g!=4 implies s.epoch==1,s.tables==1 implies s.locks==1,s.bootPin==1 implies all{s.g==1,s.locks==1},s.cache==0 implies all{s.tls==0,s.fast==0,s.owner==0,s.usePin==0,s.finalizer==0,s.late==0,s.rawSeen==0},s.cache>=1 implies all{s.g>=2,s.observed==1},s.cache>=1 and s.cache<=3 implies s.owner==1,s.cache==1 implies all{s.g==2,s.fast==0,s.usePin==0,s.finalizer==0,s.late==0},s.cache==2 implies all{(s.g==2 or s.g==3),s.tls==1},s.cache==3 implies all{s.g==3,s.finalizer==0,s.late==0},s.cache==4 implies all{s.g>=3,s.tls==0,s.fast==0,s.owner==0,s.usePin==0,s.finalizer==0,s.late==0},s.tls==2 implies all{(s.cache==1 or s.cache==3),s.owner==1},s.usePin==1 implies all{(s.cache==2 or s.cache==3),s.owner==1,s.tls==1},s.finalizer==1 implies all{s.cache==2,s.owner==1},s.late==1 implies all{s.g==3,s.cache==2,s.finalizer==1},s.roster==1 implies all{s.g>=3,s.cache==4,s.owner==0,s.usePin==0,s.finalizer==0,s.late==0},s.allocKey==2 implies (s.g==1 or s.g==3),s.g<=1 implies all{s.roster==0,s.finalizer==0,s.late==0},s.observed==1 implies s.g>=2}
action reserveRuntime=all{s.g==0,s'={...s,g:1,initOwner:1}}
action initializeLocks=all{s.g==1 and s.locks==0,s'={...s,locks:1}}
action initializeTables=all{s.g==1 and s.locks==1 and s.tables==0,s'={...s,tables:1}}
action createGenericKey=all{s.g==1 and s.genericKey==0,s'={...s,genericKey:1}}
action createAllocKeyKnown=all{s.g==1 and s.allocKey==0,s'={...s,allocKey:1}}
action createAllocKeyUnknown=all{s.g==1 and s.allocKey==0,s'={...s,allocKey:2}}
action bootstrapBorrow=all{s.g==1 and s.locks==1 and s.bootPin==0,s'={...s,bootPin:1}}
action bootstrapReturn=all{s.bootPin==1,s'={...s,bootPin:0}}
action initializationReentry=all{s.g==1 and s.reentrySeen==0,s'={...s,reentrySeen:1}}
action publishRuntime=all{s.g==1 and s.locks==1 and s.tables==1 and s.genericKey==1 and s.allocKey==1 and s.bootPin==0,s'={...s,g:2,initOwner:0}}
action observeRuntime=all{s.g==2 and s.observed==0,s'={...s,observed:1}}
action beginCacheInstall=all{s.g==2 and s.observed==1 and s.cache==0,s'={...s,cache:1,owner:1}}
action rawSetterReturned=all{s.cache==1 and s.tls==0 and s.rawSeen==0,s'={...s,rawSeen:1}}
action recordKnownInstall=all{s.cache==1 and s.tls==0,s'={...s,tls:1}}
action installUnknown=all{s.cache==1 and s.tls==0,s'={...s,tls:2}}
action publishCache=all{s.g==2 and s.cache==1 and s.tls==1,s'={...s,cache:2}}
action publishFast=all{s.g==2 and s.cache==2 and s.fast==0,s'={...s,fast:1}}
action acquireNormal=all{s.g==2 and s.cache==2 and s.observed==1 and s.usePin==0,s'={...s,usePin:1}}
action releaseNormal=all{s.usePin==1,s'={...s,usePin:0}}
action admitFinalizer=all{s.g==2 and s.cache==2 and s.finalizer==0,s'={...s,finalizer:1}}
action beginGlobalClose=all{s.g==2,s'={...s,g:3}}
action deriveLateTsdWork=all{s.g==3 and s.cache==2 and s.finalizer==1 and s.late==0,s'={...s,late:1}}
action drainLateTsdWork=all{s.g==3 and s.finalizer==1 and s.late==1,s'={...s,late:0}}
action finishFinalizer=all{s.g==3 and s.finalizer==1 and s.late==0,s'={...s,finalizer:0}}
action closeCache=all{s.g==3 and s.cache==2 and s.finalizer==0 and s.late==0,s'={...s,cache:3}}
action clearFastKnown=all{s.cache==3 and s.usePin==0 and s.fast==1,s'={...s,fast:0}}
action clearTlsKnown=all{s.cache==3 and s.usePin==0 and s.tls==1,s'={...s,tls:0}}
action clearTlsUnknown=all{s.cache==3 and s.usePin==0 and s.tls==1,s'={...s,tls:2}}
action freeCacheKnown=all{s.cache==3 and s.tls==0 and s.fast==0 and s.usePin==0 and s.owner==1,s'={...s,cache:4,owner:0}}
action attestRosterClosed=all{s.g==3 and s.cache==4 and s.owner==0 and s.usePin==0 and s.finalizer==0 and s.late==0 and s.roster==0,s'={...s,roster:1}}
action deleteGenericKey=all{s.g==3 and s.roster==1 and s.genericKey==1,s'={...s,genericKey:0}}
action deleteAllocKeyKnown=all{s.g==3 and s.roster==1 and s.allocKey==1,s'={...s,allocKey:0}}
action deleteAllocKeyUnknown=all{s.g==3 and s.roster==1 and s.allocKey==1,s'={...s,allocKey:2}}
action freeGlobalLocks=all{s.g==3 and s.roster==1 and s.genericKey==0 and s.allocKey==0 and s.cache==4 and s.bootPin==0,s'={...s,locks:0,tables:0}}
action retireRuntime=all{s.g==3 and s.roster==1 and s.genericKey==0 and s.allocKey==0 and s.cache==4 and s.locks==0 and s.tables==0,s'={...s,g:4,epoch:2}}
action step=any{reserveRuntime,initializeLocks,initializeTables,createGenericKey,createAllocKeyKnown,createAllocKeyUnknown,bootstrapBorrow,bootstrapReturn,initializationReentry,publishRuntime,observeRuntime,beginCacheInstall,rawSetterReturned,recordKnownInstall,installUnknown,publishCache,publishFast,acquireNormal,releaseNormal,admitFinalizer,beginGlobalClose,deriveLateTsdWork,drainLateTsdWork,finishFinalizer,closeCache,clearFastKnown,clearTlsKnown,clearTlsUnknown,freeCacheKnown,attestRosterClosed,deleteGenericKey,deleteAllocKeyKnown,deleteAllocKeyUnknown,freeGlobalLocks,retireRuntime,all{s'=s}}
run normalTest=init.then(reserveRuntime).then(initializeLocks).then(initializeTables).then(createGenericKey).then(createAllocKeyKnown).then(publishRuntime).then(observeRuntime).then(beginCacheInstall).then(recordKnownInstall).then(publishCache).then(publishFast).then(beginGlobalClose).then(closeCache).then(clearFastKnown).then(clearTlsKnown).then(freeCacheKnown).then(attestRosterClosed).then(deleteGenericKey).then(deleteAllocKeyKnown).then(freeGlobalLocks).then(retireRuntime).then(all{assert(safe),s'=s})
run bootstrapReentryTest=init.then(reserveRuntime).then(initializeLocks).then(initializeTables).then(createGenericKey).then(createAllocKeyKnown).then(bootstrapBorrow).then(initializationReentry).then(bootstrapReturn).then(publishRuntime).then(all{assert(safe),s'=s})
run unknownKeyTest=init.then(reserveRuntime).then(initializeLocks).then(createAllocKeyUnknown).then(all{assert(safe),s'=s})
run rawReturnTest=init.then(reserveRuntime).then(initializeLocks).then(initializeTables).then(createGenericKey).then(createAllocKeyKnown).then(publishRuntime).then(observeRuntime).then(beginCacheInstall).then(rawSetterReturned).then(all{assert(safe),s'=s})
run unknownInstallTest=init.then(reserveRuntime).then(initializeLocks).then(initializeTables).then(createGenericKey).then(createAllocKeyKnown).then(publishRuntime).then(observeRuntime).then(beginCacheInstall).then(installUnknown).then(all{assert(safe),s'=s})
run lateCleanupTest=init.then(reserveRuntime).then(initializeLocks).then(initializeTables).then(createGenericKey).then(createAllocKeyKnown).then(publishRuntime).then(observeRuntime).then(beginCacheInstall).then(recordKnownInstall).then(publishCache).then(admitFinalizer).then(beginGlobalClose).then(deriveLateTsdWork).then(drainLateTsdWork).then(finishFinalizer).then(closeCache).then(all{assert(safe),s'=s})
run unknownClearTest=init.then(reserveRuntime).then(initializeLocks).then(initializeTables).then(createGenericKey).then(createAllocKeyKnown).then(publishRuntime).then(observeRuntime).then(beginCacheInstall).then(recordKnownInstall).then(publishCache).then(beginGlobalClose).then(closeCache).then(clearTlsUnknown).then(all{assert(safe),s'=s})
run unknownDeleteTest=init.then(reserveRuntime).then(initializeLocks).then(initializeTables).then(createGenericKey).then(createAllocKeyKnown).then(publishRuntime).then(observeRuntime).then(beginCacheInstall).then(recordKnownInstall).then(publishCache).then(publishFast).then(beginGlobalClose).then(closeCache).then(clearFastKnown).then(clearTlsKnown).then(freeCacheKnown).then(attestRosterClosed).then(deleteGenericKey).then(deleteAllocKeyUnknown).then(all{assert(safe),s'=s})
run pinDrainsTest=init.then(reserveRuntime).then(initializeLocks).then(initializeTables).then(createGenericKey).then(createAllocKeyKnown).then(publishRuntime).then(observeRuntime).then(beginCacheInstall).then(recordKnownInstall).then(publishCache).then(acquireNormal).then(beginGlobalClose).then(closeCache).then(releaseNormal).then(clearTlsKnown).then(freeCacheKnown).then(all{assert(safe),s'=s})
run partialNotReadyTest=init.then(reserveRuntime).then(initializeLocks).then(all{assert(not(s.g==1 and s.locks==1 and s.tables==1 and s.genericKey==1 and s.allocKey==1 and s.bootPin==0)),assert(safe),s'=s})
run borrowNotFullReadyTest=init.then(reserveRuntime).then(initializeLocks).then(initializeTables).then(createGenericKey).then(createAllocKeyKnown).then(bootstrapBorrow).then(all{assert(not(s.g==1 and s.locks==1 and s.tables==1 and s.genericKey==1 and s.allocKey==1 and s.bootPin==0)),assert(safe),s'=s})
run rawNotInstalledTest=init.then(reserveRuntime).then(initializeLocks).then(initializeTables).then(createGenericKey).then(createAllocKeyKnown).then(publishRuntime).then(observeRuntime).then(beginCacheInstall).then(rawSetterReturned).then(all{assert(not(s.g==2 and s.cache==1 and s.tls==1)),assert(safe),s'=s})
run unknownInstallNoReadyTest=init.then(reserveRuntime).then(initializeLocks).then(initializeTables).then(createGenericKey).then(createAllocKeyKnown).then(publishRuntime).then(observeRuntime).then(beginCacheInstall).then(installUnknown).then(all{assert(not(s.g==2 and s.cache==1 and s.tls==1)),assert(safe),s'=s})
run lateWorkBlocksCloseTest=init.then(reserveRuntime).then(initializeLocks).then(initializeTables).then(createGenericKey).then(createAllocKeyKnown).then(publishRuntime).then(observeRuntime).then(beginCacheInstall).then(recordKnownInstall).then(publishCache).then(admitFinalizer).then(beginGlobalClose).then(deriveLateTsdWork).then(all{assert(not(s.g==3 and s.cache==2 and s.finalizer==0 and s.late==0)),assert(safe),s'=s})
run fastBlocksFreeTest=init.then(reserveRuntime).then(initializeLocks).then(initializeTables).then(createGenericKey).then(createAllocKeyKnown).then(publishRuntime).then(observeRuntime).then(beginCacheInstall).then(recordKnownInstall).then(publishCache).then(publishFast).then(beginGlobalClose).then(closeCache).then(clearTlsKnown).then(all{assert(not(s.cache==3 and s.tls==0 and s.fast==0 and s.usePin==0 and s.owner==1)),assert(safe),s'=s})
run closedNoNormalTest=init.then(reserveRuntime).then(initializeLocks).then(initializeTables).then(createGenericKey).then(createAllocKeyKnown).then(publishRuntime).then(observeRuntime).then(beginCacheInstall).then(recordKnownInstall).then(publishCache).then(publishFast).then(beginGlobalClose).then(all{assert(not(s.g==2 and s.cache==2 and s.observed==1 and s.usePin==0)),assert(safe),s'=s})
run unknownClearNoFreeTest=init.then(reserveRuntime).then(initializeLocks).then(initializeTables).then(createGenericKey).then(createAllocKeyKnown).then(publishRuntime).then(observeRuntime).then(beginCacheInstall).then(recordKnownInstall).then(publishCache).then(beginGlobalClose).then(closeCache).then(clearTlsUnknown).then(all{assert(not(s.cache==3 and s.tls==0 and s.fast==0 and s.usePin==0 and s.owner==1)),assert(safe),s'=s})
run unknownKeyNoLocksTest=init.then(reserveRuntime).then(initializeLocks).then(initializeTables).then(createGenericKey).then(createAllocKeyKnown).then(publishRuntime).then(observeRuntime).then(beginCacheInstall).then(recordKnownInstall).then(publishCache).then(publishFast).then(beginGlobalClose).then(closeCache).then(clearFastKnown).then(clearTlsKnown).then(freeCacheKnown).then(attestRosterClosed).then(deleteGenericKey).then(deleteAllocKeyUnknown).then(all{assert(not(s.g==3 and s.roster==1 and s.genericKey==0 and s.allocKey==0 and s.cache==4 and s.bootPin==0)),assert(safe),s'=s})
}
