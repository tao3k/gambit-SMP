{
  "schema": "evidence-recipe.v2",
  "id": "interrupted-producer-recovery-controls",
  "scope": "Finite durable-checkpoint recovery protocol, positive exhaustive safety and four decoded faulty-policy controls. No filesystem, native runtime, SMP or recovery implementation admission.",
