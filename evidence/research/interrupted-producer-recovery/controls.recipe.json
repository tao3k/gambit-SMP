    {"id": "safe-recovery", "capability": "quint.verify", "dependsOn": ["parse", "typecheck", "trajectories"], "budgetSeconds": 15,
     "arguments": {"source": "models/gambit/interrupted_producer_recovery.qnt", "parsed": "parse",
       "initializer": "init", "step": "step", "invariant": "safe", "negative": false}},
    {"id": "missing-receipt", "capability": "quint.verify", "dependsOn": ["parse", "typecheck", "trajectories"], "budgetSeconds": 15,
     "arguments": {"source": "models/gambit/interrupted_producer_recovery.qnt", "parsed": "parse",
       "initializer": "initMissing", "step": "step", "invariant": "safe", "negative": true}},
    {"id": "stale-output", "capability": "quint.verify", "dependsOn": ["parse", "typecheck", "trajectories"], "budgetSeconds": 15,
     "arguments": {"source": "models/gambit/interrupted_producer_recovery.qnt", "parsed": "parse",
       "initializer": "initStale", "step": "step", "invariant": "safe", "negative": true}},
    {"id": "live-process", "capability": "quint.verify", "dependsOn": ["parse", "typecheck", "trajectories"], "budgetSeconds": 15,
     "arguments": {"source": "models/gambit/interrupted_producer_recovery.qnt", "parsed": "parse",
       "initializer": "initLive", "step": "step", "invariant": "safe", "negative": true}},
    {"id": "deadline-reset", "capability": "quint.verify", "dependsOn": ["parse", "typecheck", "trajectories"], "budgetSeconds": 15,
     "arguments": {"source": "models/gambit/interrupted_producer_recovery.qnt", "parsed": "parse",
       "initializer": "initReset", "step": "step", "invariant": "safe", "negative": true}},
    {"id": "verdict", "capability": "evidence.evaluate",
     "dependsOn": ["source", "parse", "typecheck", "trajectories", "safe-recovery", "missing-receipt", "stale-output", "live-process", "deadline-reset"],
     "budgetSeconds": 10, "arguments": {"rules": ["evidence/research/execution-rules.ss"],
       "queries": {"missing": "missing_step", "bindings": "bound_source", "controls": "bound_control"},
       "expected": {"missing": [], "bindings": [], "controls": []}}}
