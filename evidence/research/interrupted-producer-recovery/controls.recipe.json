    {"id": "trajectories", "capability": "quint.test", "dependsOn": ["parse", "typecheck"], "budgetSeconds": 15,
     "arguments": {"source": "models/gambit/interrupted_producer_recovery.qnt", "parsed": "parse",
       "main": "interrupted_producer_recovery", "seed": "0x1510", "maxSamples": 1,
       "expectedTests": ["resumedCommittedTest", "interruptedRunningTest", "expiredCheckpointTest", "postRecoveryDriftTest", "missingReceiptControlTest",
