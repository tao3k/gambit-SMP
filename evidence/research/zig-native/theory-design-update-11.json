  "boundedSourceFindings": {
    "rc": "Per-processor registration/header.data; inspected P0-only mark_rc; managed closure versus byte-only payload callers separated; per-processor scan refinement not implemented or qualified",
    "marker": "Actual still allocator can GC before marker initialization; direct proc/thunk needs protected updateable slot and reload, input roots separate; no defect reproduction",
    "identity": "Global c_closure_self read after allocation; architecture-limited generator has no arm64 branch; invocation-local capture provider and supported cohort unresolved",
    "binding": "Startup setter initializes TLS/binding and affinity; bounded vendor search no BEGIN/END binding invocations; same-owner design preserves selection, not generic VM switching",
    "wait": "Actual wrapper/abort/interrupt/collective chain exists; C cached aliases, virtual methods, locks, OS abort races and disabled-interrupt callers service cuts remain unresolved",
    "fdset": "Selected select/poll add_fd sets bits/entries only; reviewed pipe constructor invokes capacity admission through fdset_resize, whose insufficient-capacity branch enters collective operations; device creation separated from cached wait interval"
  },
