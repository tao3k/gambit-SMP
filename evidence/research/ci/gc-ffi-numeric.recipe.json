{
  "schema": "evidence-recipe.v2",
  "id": "ci-gc-ffi-numeric",
  "scope": "Current three-flag producer. Compile the original 03-number/_num.scm under the unchanged 90-second phase cap with default-control scheduling, then run official test7, test8 and test9. A raised cap, a rejected scheduling grouping, the numeric file alone, or this recipe's model is not acceptance.",
  "timeoutPolicy": {
    "mode": "progress",
    "overheadSeconds": 30
  },
  "inputs": [
    "models/gambit/native/numeric-alias/outline-assertions.scm",
    "evidence/fixtures/darwin-stack-trip-owner-limit/source.lock.json",
    "patches/fixtures/darwin-stack-trip-owner-limit.patch",
    "evidence/research/ci/runtime-input.json",
    "evidence/research/execution/entry.json",
    "evidence/dsl/execution.ss",
    "evidence/native-failures.json",
    "evidence/research/suite-review-rules.ss",
    "evidence/research/ci/upstream-tests.json",
    "evidence/research/ci/test-scope.entry.json",
    "evidence/dsl/upstream-test-scope.ss"
  ],
  "steps": [
    {
      "id": "candidate",
      "capability": "gambit.materialize",
      "dependsOn": [],
      "arguments": {
        "sourceLock": "evidence/fixtures/darwin-stack-trip-owner-limit/source.lock.json"
      },
      "budgetSeconds": 30
    },
    {
      "id": "runtime",
      "capability": "gambit.runtime-import",
      "dependsOn": [
        "candidate"
      ],
      "arguments": {
        "source": {
          "step": "candidate",
          "output": "source"
        },
        "archive": "evidence/research/ci/runtime-input.json"
      },
      "budgetSeconds": 30
    },
    {
      "id": "numeric",
      "capability": "gambit.compiler-observation",
      "dependsOn": [
        "runtime"
      ],
      "arguments": {
        "runtime": {
          "step": "runtime",
          "output": "runtime"
        },
        "identity": {
          "step": "runtime",
          "output": "identity"
        },
        "selection": "03-number/_num.scm",
        "scheduling": "default-control",
        "phaseBudgetSeconds": 90,
        "loader": "original-gsi",
        "numericGrouping": {
          "source": "models/gambit/native/numeric-alias/outline-assertions.scm",
          "sha256": "4bf384b92bd647fdec9641444702198b5b0f9ceaa2f40b5ae6bf43e677c46604",
          "fixtureSha256": "b757a18805a38f48e55055907a983d53f0e50d1acb627c462fe6d34924bd0d9d"
        }
      },
      "budgetSeconds": 300
    },
    {
      "id": "official",
      "capability": "gambit.upstream-tests",
      "dependsOn": [
        "runtime",
        "numeric"
      ],
      "arguments": {
        "runtime": {
          "step": "runtime",
          "output": "runtime"
        },
        "identity": {
          "step": "runtime",
          "output": "identity"
        },
        "failures": "evidence/native-failures.json",
        "reviewRules": "evidence/research/suite-review-rules.ss",
        "targets": [
          "test7",
          "test8",
          "test9"
        ]
      },
      "budgetSeconds": 250
    },
    {
      "id": "verdict",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "candidate",
        "runtime",
        "numeric",
        "official"
      ],
      "arguments": {
        "dsl": "evidence/research/execution/entry.json",
        "queries": {
          "checked": "checked_step",
          "missing": "missing_step"
        },
        "expected": {
          "missing": []
        },
        "recordedQueries": [
          "checked"
        ]
      },
      "budgetSeconds": 10
    }
  ]
}
