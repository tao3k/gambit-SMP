{
  "schema": "evidence-recipe.v2",
  "id": "ci-three-flag-source-core",
  "scope": "GNU GCC O3 locked-source build observations with SMP, multiple VMs and multiple threaded VMs together. Seed plus one source-regeneration pass only; not full bootstrap, suite, runtime acceptance or performance admission.",
  "budgetSeconds": 600,
  "inputs": [
    "evidence/research/ci/candidate.json",
    "evidence/fixtures/darwin-stack-trip-owner-limit/source.lock.json",
    "patches/fixtures/darwin-stack-trip-owner-limit.patch",
    "evidence/research/execution/entry.json",
    "evidence/dsl/execution.ss"
  ],
  "steps": [
    {
      "id": "candidate",
      "capability": "gambit.materialize",
      "dependsOn": [],
      "arguments": {
        "sourceLock": "evidence/fixtures/darwin-stack-trip-owner-limit/source.lock.json",
        "buildWorkspace": "gambit-core"
      },
      "budgetSeconds": 30
    },
    {
      "id": "configure",
      "capability": "gambit.configure",
      "dependsOn": [
        "candidate"
      ],
      "arguments": {
        "source": {
          "step": "candidate",
          "output": "source"
        },
        "cOptimization": 3,
        "rtsOptimization": 3
      },
      "budgetSeconds": 150
    },
    {
      "id": "seed",
      "capability": "gambit.seed-core",
      "dependsOn": [
        "configure"
      ],
      "arguments": {
        "source": {
          "step": "configure",
          "output": "source"
        }
      },
      "budgetSeconds": 600
    },
    {
      "id": "source-core",
      "capability": "gambit.source-core",
      "dependsOn": [
        "seed"
      ],
      "arguments": {
        "runtime": {
          "step": "seed",
          "output": "runtime"
        }
      },
      "budgetSeconds": 600
    },
    {
      "id": "verdict",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "candidate",
        "configure",
        "seed",
        "source-core"
      ],
      "arguments": {
        "dsl": "evidence/research/execution/entry.json",
        "queries": {
          "checked": "checked_step",
          "missing": "missing_step"
        },
        "expected": {
          "missing": []
        },
        "recordedQueries": [
          "checked"
        ]
      },
      "budgetSeconds": 10
    }
  ],
  "workspacePolicy": "in-place"
}
