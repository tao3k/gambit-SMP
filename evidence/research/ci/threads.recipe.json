{
  "schema": "evidence-recipe.v2",
  "id": "ci-threads",
  "scope": "Exact locked three-flag source-core consumption and full GSI/GSC unit suites, including threads. Inventory derives from the same materialized source; original per-mode and group budgets remain unchanged. No build resumption or performance admission.",
  "timeoutPolicy": {"mode": "per-stage", "overheadSeconds": 30},
  "inputs": [
    "evidence/fixtures/darwin-stack-trip-owner-limit/source.lock.json",
    "patches/fixtures/darwin-stack-trip-owner-limit.patch",
    "evidence/research/ci/runtime-input.json",
    "evidence/research/execution/entry.json",
    "evidence/dsl/execution.ss",
    "evidence/native-failures.json",
    "evidence/research/suite-review-rules.ss",
    "evidence/research/current-source-full-bootstrap/interpreted-intent.json",
    "evidence/research/smp-threaded-vm-native-grid/global-cleanup-interpreted-causal-evidence.json",
    "evidence/research/current-source-full-bootstrap/compiled-complete-intent.json",
    "evidence/research/current-source-full-bootstrap/compiled-semantic-review.json",
    "models/gambit/native/host_environment_probe.scm",
    "evidence/research/smp-threaded-vm-native-grid/environment-causal-evidence.json"
  ],
  "steps": [
    {
      "id": "candidate",
      "capability": "gambit.materialize",
      "dependsOn": [],
      "arguments": {
        "sourceLock": "evidence/fixtures/darwin-stack-trip-owner-limit/source.lock.json"
      },
      "budgetSeconds": 20
    },
    {
      "id": "runtime",
      "capability": "gambit.runtime-import",
      "dependsOn": [
        "candidate"
      ],
      "arguments": {
        "source": {
          "step": "candidate",
          "output": "source"
        },
        "archive": "evidence/research/ci/runtime-input.json"
      },
      "budgetSeconds": 20
    },
    {
      "id": "environment-probe",
      "capability": "gambit.probe",
      "dependsOn": ["runtime"],
      "arguments": {
        "runtime": {"step": "runtime", "output": "runtime"},
        "identity": {"step": "runtime", "output": "identity"},
        "program": "models/gambit/native/host_environment_probe.scm",
        "operations": ["udp-open", "process-pipe-sort", "user-info"]
      },
      "budgetSeconds": 10
    },
    {
      "id": "review-gsi",
      "capability": "gambit.review",
      "dependsOn": ["candidate", "runtime", "environment-probe"],
      "arguments": {
        "runtime": {"step": "runtime", "output": "runtime"},
        "identity": {"step": "runtime", "output": "identity"},
        "intent": "evidence/research/current-source-full-bootstrap/interpreted-intent.json",
        "target": "gsi",
        "failureIds": ["018-thread-interrupt", "018-write-shared", "018-table-search", "018-suite-budget", "018-udp-permission", "019-prim-port-budget", "current-host-identity-environment"],
        "environmentProbe": {"step": "environment-probe", "output": "observation"}
      },
      "budgetSeconds": 15
    },
    {
      "id": "gsi",
      "capability": "gambit.suite",
      "dependsOn": [
        "candidate",
        "runtime",
        "environment-probe",
        "review-gsi"
      ],
      "arguments": {
        "runtime": {
          "step": "runtime",
          "output": "runtime"
        },
        "identity": {
          "step": "runtime",
          "output": "identity"
        },
        "failures": "evidence/native-failures.json",
        "reviewRules": "evidence/research/suite-review-rules.ss",
        "retryReview": {"step": "review-gsi", "output": "review"},
        "mode": "gsi",
        "regime": "whole-parallel",
        "selection": ["."],
        "expectedSource": {"step": "candidate", "output": "source"},
        "inventory": "unit",
        "fileBudgetSeconds": {"13-modules/prim_port.scm": 20},
        "environmentProbe": {"step": "environment-probe", "output": "observation"}
      },
      "budgetSeconds": 300
    },
    {
      "id": "review-gsc",
      "capability": "gambit.review",
      "dependsOn": ["candidate", "runtime", "environment-probe"],
      "arguments": {
        "runtime": {"step": "runtime", "output": "runtime"},
        "identity": {"step": "runtime", "output": "identity"},
        "intent": "evidence/research/current-source-full-bootstrap/compiled-complete-intent.json",
        "target": "gsc",
        "failureIds": ["019-fxmul-compiled", "021-thread-start-completion", "026-compiled-atomic-num-budget", "026-vector-family-budget", "023-compiled-atomic-budget", "023-vector-increment-type", "023-compiled-atomic-udp-permission", "019-compiled-parallel-budget", "021-numeric-compiler-phase-budget", "020-compiled-balanced-budget"],
        "environmentProbe": {"step": "environment-probe", "output": "observation"}
      },
      "budgetSeconds": 15
    },
    {
      "id": "gsc",
      "capability": "gambit.suite",
      "dependsOn": [
        "candidate",
        "runtime",
        "environment-probe",
        "review-gsc"
      ],
      "arguments": {
        "runtime": {
          "step": "runtime",
          "output": "runtime"
        },
        "identity": {
          "step": "runtime",
          "output": "identity"
        },
        "failures": "evidence/native-failures.json",
        "reviewRules": "evidence/research/suite-review-rules.ss",
        "retryReview": {"step": "review-gsc", "output": "review"},
        "mode": "gsc",
        "regime": "whole-parallel",
        "selection": ["."],
        "expectedSource": {"step": "candidate", "output": "source"},
        "inventory": "unit",
        "fileBudgetSeconds": {
          "01-fixnum/fxmul.scm": 20,
          "03-number/_num.scm": 90
        },
        "environmentProbe": {"step": "environment-probe", "output": "observation"},
        "groupBudgetSeconds": {
          "thread-completion": {
            "files": [
              "06-thread/thread_init.scm",
              "06-thread/thread_interrupt.scm",
              "06-thread/thread_join.scm",
              "06-thread/thread_start.scm",
              "06-thread/thread_state.scm",
              "06-thread/thread_terminate.scm"
            ],
            "budgetSeconds": 120
          }
        }
      },
      "budgetSeconds": 300
    },
    {
      "id": "verdict",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "candidate",
        "runtime",
        "environment-probe",
        "review-gsi",
        "gsi",
        "review-gsc",
        "gsc"
      ],
      "arguments": {
        "dsl": "evidence/research/execution/entry.json",
        "queries": {
          "checked": "checked_step",
          "missing": "missing_step"
        },
        "expected": {
          "missing": []
        },
        "recordedQueries": [
          "checked"
        ]
      },
      "budgetSeconds": 10
    }
  ]
}
