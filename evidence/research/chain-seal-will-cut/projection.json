{
  "source": [
    {
      "key": "capacity-before-fixup",
      "path": "vendor/gambit/lib/mem.c",
      "needle": "while (alloc + words + ___SUBTYPED_BODY > limit)",
      "obligation": "Next fresh frame can publish previous chunk before writing previous ptr"
    },
    {
      "key": "frame-ready",
      "path": "vendor/gambit/lib/mem.c",
      "needle": "publish_object_scan (work, copy_header);",
      "obligation": "All publisher call sites inventoried; frame publisher follows initial copied payload"
    },
    {
      "key": "pending-link",
      "path": "vendor/gambit/lib/mem.c",
      "needle": "ptr = &___FP_STK(alloc,link+1);",
      "obligation": "Cursor retains preceding copied-frame link address"
    },
    {
      "key": "already-forwarded-fixup",
      "path": "vendor/gambit/lib/mem.c",
      "needle": "*ptr = ra2; /* already copied, replace by forwarding pointer */",
      "obligation": "Separate fixup branch exists; capacity witness uses the fresh-frame branch"
    },
    {
      "key": "copy-lock",
      "path": "vendor/gambit/lib/mem.c",
      "needle": "MISC_MEM_LOCK();\n\n      next_frame:",
      "obligation": "Copier holds global memory lock; this alone does not exclude frame scanner"
    },
    {
      "key": "strong-weak-barrier",
      "path": "vendor/gambit/lib/mem.c",
      "needle": "garbage_collect_mark_strong_phase (work);\n\n  BARRIER();",
      "obligation": "Strong closure precedes weak phase but does not serialize weak classification against weak marking"
    },
    {
      "key": "will-repair",
      "path": "vendor/gambit/lib/mem.c",
      "needle": "mark_array (work, tail_exec+___WILL_TESTATOR, 1);",
      "obligation": "Executable and moved-to-executable paths directly repair testator"
    },
    {
      "key": "chunk-authority",
      "path": "vendor/gambit/lib/mem.c",
      "needle": "if (alloc_heap_chunk_start != work->local_scan_chunk_)",
      "obligation": "Current source uses explicit local chunk identity; parent range guard is historical"
    },
    {
      "key": "terminal",
      "path": "vendor/gambit/lib/mem.c",
      "needle": "if (___FIXNUMP(cf) && cf != ___END_OF_CONT_MARKER)",
      "obligation": "Seal last link without successor"
    },
    {
      "key": "retag",
      "path": "vendor/gambit/lib/mem.c",
      "needle": "*orig_ptr = ___TAG(___UNTAG_AS(*orig_ptr, ___tFIXNUM), ___tSUBTYPED);",
      "obligation": "Retag follows all link resolution"
    },
    {
      "key": "custom",
      "path": "vendor/gambit/lib/mem.c",
      "needle": "return custom_msection_alloc ();",
      "obligation": "Custom grant unknown"
    },
    {
      "key": "grant",
      "path": "vendor/gambit/lib/mem.c",
      "needle": "alloc_heap_limit = alloc_heap_start + (___MSECTION_SIZE>>1);",
      "obligation": "Standard half section"
    },
    {
      "key": "shared",
      "path": "vendor/gambit/lib/mem.c",
      "needle": "space = (space - 2*___MSECTION_FUDGE) >> 2;",
      "obligation": "Shared stack remaining grant"
    },
    {
      "key": "markers",
      "path": "vendor/gambit/lib/mem.c",
      "needle": "alloc_heap_limit_ -= 2;",
      "obligation": "Two end markers plus first link word"
    },
    {
      "key": "frame-max",
      "path": "vendor/gambit/lib/mem.h",
      "needle": "#define ___MAX_NB_FRAME_SLOTS   8192",
      "obligation": "Static slot limit"
    },
    {
      "key": "threshold",
      "path": "vendor/gambit/lib/mem.h",
      "needle": "#define ___MSECTION_BIGGEST     255",
      "obligation": "Threshold not maximum chunk size"
    },
    {
      "key": "end-value",
      "path": "vendor/gambit/include/gambit.h.in",
      "needle": "#define ___END_OF_CONT_MARKER ___VOID",
      "obligation": "Nonfixnum terminal"
    },
    {
      "key": "callcc",
      "path": "vendor/gambit/lib/_thread.scm",
      "needle": "(receiver (reify-continuation cont))",
      "obligation": "Captured continuation retained by closure"
    },
    {
      "key": "capture",
      "path": "vendor/gambit/gsc/_t-c-2.scm",
      "needle": "(targ-emit-jump-inline \"CONTINUATION_CAPTURE\" safe? nb-args)",
      "obligation": "Actual capture emitter"
    },
    {
      "key": "public-will",
      "path": "vendor/gambit/lib/_nonstd.scm",
      "needle": "(define-prim (make-will testator action)",
      "obligation": "Distinct wills may share testator"
    },
    {
      "key": "will-list",
      "path": "vendor/gambit/include/gambit.h.in",
      "needle": "___ADD_SUBTYPED_ELEM(___WILL_NEXT,___ps->context->mem.nonexecutable_wills_)",
      "obligation": "Per-context registration"
    },
    {
      "key": "will-decision",
      "path": "vendor/gambit/lib/mem.c",
      "needle": "UNMARKED(testator)) /* testator was not marked? */",
      "obligation": "Mutable mark observation"
    },
    {
      "key": "will-local",
      "path": "vendor/gambit/lib/mem.c",
      "needle": "determine_will_executability (nonexecutable_wills);",
      "obligation": "Local decide immediately followed by retention"
    }
  ],
  "footprint": [
