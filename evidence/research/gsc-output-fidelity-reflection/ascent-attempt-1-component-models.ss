 (fact (contractFactor "incremental-build" "correctness-open-premise" "B-CLOSURE:Prove read mediation and producer extensionality; finite trace completion is not semantic closure; dependency cycles require rejection or an independently proved evaluator"))
 (fact (contractFactor "incremental-build" "correctness-open-premise" "B-CUTOFF:Prove each actual consumer factors through its projection; the integer meta field is not a proof of actual targ-link-info equivalence"))
 (fact (contractFactor "incremental-build" "correctness-open-premise" "B-GROUP:Prove successful producer exit, expected-group completeness, unique writer, retained-reader lifetime and crash recovery; Lean does not prove filesystem commit"))
 (fact (contractFactor "incremental-build" "correctness-open-premise" "B-POPULATION:Related initial cache origins; ordered boundary observations; omitted-step stutter; simulation of selected transitions; full budget includes omitted running jobs; shared macro invalidates boundary certification until omitted groups revalidate; output equality is not refuted by source change alone"))
 (fact (contractFactor "incremental-build" "correctness-open-premise" "B-PROGRESS:Discovery may restart arbitrarily; separate finite safety from liveness and work minimality; preserve recursive jobserver ownership"))
 (fact (contractFactor "incremental-build" "correctness-open-premise" "B-SNAPSHOT:All relevant writes must revoke authority before visibility; same epoch number does not prove isolation; no unmanaged-live-path fallback"))
 (fact (contractFactor "incremental-build" "correctness-status" "B-CLOSURE:open-source-refinement; conditional-algebra"))
 (fact (contractFactor "incremental-build" "correctness-status" "B-CUTOFF:open-consumer-factorization; conditional-algebra"))
 (fact (contractFactor "incremental-build" "correctness-status" "B-GROUP:open-publication-refinement"))
 (fact (contractFactor "incremental-build" "correctness-status" "B-POPULATION:open-forward-simulation; inventory-established"))
 (fact (contractFactor "incremental-build" "correctness-status" "B-PROGRESS:open-progress-and-native-scheduler-refinement"))
 (fact (contractFactor "incremental-build" "correctness-status" "B-SNAPSHOT:open-issuer-and-filesystem-refinement; conditional-algebra"))
 (fact (contractFactor "incremental-build" "fidelity-failure-map" "L-ARTIFACT:Header-only truncation is source-reachable as an acceptance gap; no native truncation experiment is claimed"))
 (fact (contractFactor "incremental-build" "fidelity-failure-map" "L-CHAIN:No successful group from a file left by failed recipe; make prerequisites alone cannot issue provenance"))
 (fact (contractFactor "incremental-build" "fidelity-failure-map" "L-CLEAN:Unknown clean result, optional side-output failure, cancelled attempt or mutable provider yields no reference success"))
 (fact (contractFactor "incremental-build" "fidelity-failure-map" "L-FAIL:No exception/#f/nonzero/signal/unknown outcome becomes successful empty bytes; external process exit mapping remains open"))
 (fact (contractFactor "incremental-build" "fidelity-failure-map" "L-FIELDS:A managed twelve-field schema may reject legacy-accepted extension records; this is reuse qualification, not a change to legacy language acceptance"))
 (fact (contractFactor "incremental-build" "fidelity-failure-map" "L-HEADER:A two-element list with matching version and target-list passes shown checks yet lacks fields 2-11; malformed read may raise; accepted metadata may precede incomplete C body"))
 (fact (contractFactor "incremental-build" "fidelity-failure-map" "L-ISSUE:All seven non-success outcomes and incomplete record block admission by definition; no executed state explorer proof claimed"))
 (fact (contractFactor "incremental-build" "fidelity-failure-map" "L-ORDER:Unknown duplicate/identity semantics or reordered flags/resources refuses coarse equality"))
 (fact (contractFactor "incremental-build" "fidelity-failure-map" "L-READ:Missing/invalid info calls compiler-error; reader or vector exceptions remain distinct from false; cleanup is not guaranteed by these normal-return paths"))
 (fact (contractFactor "incremental-build" "fidelity-failure-map" "L-REFLECT:Abstract safe flag with no actual failure reflection cannot prove concrete success/currentness; safety stutter does not prove termination"))
 (fact (contractFactor "incremental-build" "fidelity-failure-map" "L-WORK:A refusal or changed body can increase necessary work even when metadata is stable"))
 (fact (contractFactor "incremental-build" "fidelity-failure-map" "L-WRITE:Unrepresentable/unreadable datum, unknown charset or conversion error refuses typed credential; raw-byte comparison has a separate scope"))
