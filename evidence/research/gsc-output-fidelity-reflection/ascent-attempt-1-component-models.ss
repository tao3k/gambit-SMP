 (fact (contractFactor "incremental-build" "capability-refusal" "C-BUFFER:Live/inherited mutable device, shared offset race, untracked wait callback or unsettled buffered output"))
 (fact (contractFactor "incremental-build" "capability-refusal" "C-C-OPEN:Live namespace bypass, native pointer escape, failed wrapper ownership not settled"))
 (fact (contractFactor "incremental-build" "capability-refusal" "C-C-READ:Unbound backend/foreign device or active unqualified read pump, live fd reuse/alias, missing source/image lifetime or unknown result"))
 (fact (contractFactor "incremental-build" "capability-refusal" "C-CHAR:Unknown handler or mutable state not included in producer context; missing callback trace"))
 (fact (contractFactor "incremental-build" "capability-refusal" "C-COMMENT:Dropping comments as semantically irrelevant while comment callback effects are untracked"))
 (fact (contractFactor "incremental-build" "capability-refusal" "C-EMIT:Partial/truncated output, unknown write/close result or publication without success/group custody"))
 (fact (contractFactor "incremental-build" "capability-refusal" "C-EVAL:Unmanaged evaluator replacement, namespace state or native capability; symbol allowlist alone is insufficient"))
 (fact (contractFactor "incremental-build" "capability-refusal" "C-FFI:Unknown native symbol/provider or transitive syscall, inherited capability or unsupervised callback"))
 (fact (contractFactor "incremental-build" "capability-refusal" "C-LOAD:Unknown native object, constructor/initialization effects, unresolved dependent library or callback ownership"))
 (fact (contractFactor "incremental-build" "capability-refusal" "C-MACRO:Unknown/replaced expander or effects outside controlled trace; an include-only trace cannot certify it"))
 (fact (contractFactor "incremental-build" "capability-refusal" "C-NATIVE-TEXT:Do not reject just for C text; reject reusable execution only when an actual unmanaged build-time effect occurs"))
 (fact (contractFactor "incremental-build" "capability-refusal" "C-REQUIRE:Unregistered module resolution, initialization, dynamic library closure or unknown load outcome"))
 (fact (contractFactor "incremental-build" "capability-refusal" "C-SHARP-DOT:Enabled read-time eval with unmanaged effects; do not assume selected profile enables the branch"))
 (fact (contractFactor "incremental-build" "capability-refusal" "C-SHARP:Unknown sharp procedure or effect bypass, even if source file bytes match"))
