 (fact (contractFactor "incremental-build" "capability-admission" "C-BUFFER:View-bound device/offset/decoder ownership, preserved EOF/error behavior and governed wait/timeout callbacks"))
 (fact (contractFactor "incremental-build" "capability-admission" "C-C-OPEN:Resolved logical namespace maps to image; device and GC/VM lifetime tied to same attempt"))
 (fact (contractFactor "incremental-build" "capability-admission" "C-C-READ:Bound backend flags, immutable-view handle identity, file position and raw result conversion"))
 (fact (contractFactor "incremental-build" "capability-admission" "C-CHAR:Freeze handler table identity and govern handler closure, state and nested capabilities"))
 (fact (contractFactor "incremental-build" "capability-admission" "C-COMMENT:Record exact handler/context and governed callback trace when procedure-valued"))
 (fact (contractFactor "incremental-build" "capability-admission" "C-EMIT:Attempt-owned staged group, successful close/exit, complete manifest and linearized admission"))
 (fact (contractFactor "incremental-build" "capability-admission" "C-EVAL:Bind actual eval hooks/environment and all module/effect dependencies before reusable success"))
 (fact (contractFactor "incremental-build" "capability-admission" "C-FFI:Qualified C ABI/provider and approved transitive capability behavior; use runtime root/VM contracts"))
 (fact (contractFactor "incremental-build" "capability-admission" "C-LOAD:Only qualified loaded closure with audited initialization and mediated transitive effects"))
 (fact (contractFactor "incremental-build" "capability-admission" "C-MACRO:Bind procedure code, evaluator globals and all called capabilities to same admitted context; include caller and callback trace"))
 (fact (contractFactor "incremental-build" "capability-admission" "C-NATIVE-TEXT:Include exact text, phase role and ABI/profile in output observation; separately qualify native compile/load phases"))
 (fact (contractFactor "incremental-build" "capability-admission" "C-REQUIRE:Module demand resolver, loaded code and initialization effects belong to same producer/capability closure"))
 (fact (contractFactor "incremental-build" "capability-admission" "C-SHARP-DOT:Admit only when compile feature and actual readtable flag are bound and eval closure is qualified"))
 (fact (contractFactor "incremental-build" "capability-admission" "C-SHARP:Bind sharp handler, reader parameters and all nested effect answers"))
