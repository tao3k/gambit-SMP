{
  "schema": "evidence-recipe.v2",
  "id": "host-environment-recovery-controls",
  "scope": "Finite prelaunch host environment observation recovery, immutable old denial and unchanged budgets. Not source causality, interrupted native resumption or runtime admission.",
  "budgetSeconds": 90,
  "inputs": [
    "models/gambit/host_environment_recovery.qnt",
    "evidence/fixtures/thread-completion-contract/source.lock.json",
    "patches/fixtures/thread-completion-contract.patch",
    "evidence/research/execution-rules.ss"
  ],
  "steps": [
    {
      "id": "source",
      "capability": "gambit.materialize",
      "dependsOn": [],
      "budgetSeconds": 30,
      "arguments": {
        "sourceLock": "evidence/fixtures/thread-completion-contract/source.lock.json"
      }
    },
    {
      "id": "parse",
      "capability": "quint.parse",
      "dependsOn": [
        "source"
      ],
      "budgetSeconds": 15,
      "arguments": {
        "source": "models/gambit/host_environment_recovery.qnt"
      }
    },
    {
      "id": "typecheck",
      "capability": "quint.typecheck",
      "dependsOn": [
        "parse"
      ],
      "budgetSeconds": 15,
      "arguments": {
        "source": "models/gambit/host_environment_recovery.qnt",
        "parsed": "parse"
      }
    },
    {
      "id": "trajectories",
      "capability": "quint.test",
      "dependsOn": [
        "parse",
        "typecheck"
      ],
      "budgetSeconds": 15,
      "arguments": {
        "source": "models/gambit/host_environment_recovery.qnt",
        "parsed": "parse",
        "main": "host_environment_recovery",
        "seed": "0x1510",
        "maxSamples": 1,
        "expectedTests": [
          "observedTransitionTest",
          "unknownFailureTest",
          "missingCurrentProbeTest",
          "bypassControlTest"
        ]
      }
    },
    {
      "id": "checked-handoff",
      "capability": "quint.verify",
      "dependsOn": [
        "parse",
        "typecheck",
        "trajectories"
      ],
      "budgetSeconds": 15,
      "arguments": {
        "source": "models/gambit/host_environment_recovery.qnt",
        "parsed": "parse",
        "initializer": "init",
        "step": "step",
        "invariant": "safe",
        "negative": false
      }
    },
    {
      "id": "bypass-control",
      "capability": "quint.verify",
      "dependsOn": [
        "parse",
        "typecheck",
        "trajectories"
      ],
      "budgetSeconds": 15,
      "arguments": {
        "source": "models/gambit/host_environment_recovery.qnt",
        "parsed": "parse",
        "initializer": "initBypass",
        "step": "step",
        "invariant": "safe",
        "negative": true
      }
    },
    {
      "id": "verdict",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "source",
        "parse",
        "typecheck",
        "trajectories",
        "checked-handoff",
        "bypass-control"
      ],
      "budgetSeconds": 10,
      "arguments": {
        "rules": [
          "evidence/research/execution-rules.ss"
        ],
        "queries": {
          "missing": "missing_step",
          "controls": "bound_control"
        },
        "expected": {
          "missing": [],
          "controls": []
        }
      }
    }
  ]
}
