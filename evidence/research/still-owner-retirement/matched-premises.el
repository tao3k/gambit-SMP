(require 'cl-lib)
(require 'json)
(require 'seq)
(let* ((r ".cache/tasks/still-owner-retirement/")
       (p (with-temp-buffer (insert-file-contents (concat r "planner-full.json")) (json-parse-buffer :object-type 'alist :array-type 'list)))
       (dict (make-hash-table :test 'equal)))
  (dolist (n (alist-get 'needs p))
    (puthash (concat "@premise/" (alist-get 'obligationId n)) (alist-get 'premise n) dict))
  (dolist (case '("current" "all-scoped-control"))
    (let* ((input (concat r "build-cut/case-" case ".ss"))
           (tree (with-temp-buffer (insert-file-contents input) (read (current-buffer)))))
      (cl-labels ((decode (x) (cond ((consp x) (cons (decode (car x)) (decode (cdr x))))
                                   ((and (stringp x) (string-prefix-p "@premise/" x))
                                    (or (gethash x dict) (error "Unbound premise"))) (t x))))
        (with-temp-file (concat r "build-cut/full-" case ".ss") (insert (prin1-to-string (decode tree))))))))
