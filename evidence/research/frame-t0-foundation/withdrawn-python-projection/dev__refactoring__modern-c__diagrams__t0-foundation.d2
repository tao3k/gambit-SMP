# DEV target architecture only; cycles are rely/guarantee dependencies, not proofs.
direction: right
T0_EXECUTION: "T0-EXECUTION\nExecution and participation\nseparation"
T0_ROOTS: "T0-ROOTS\nGenerated root and frame\ncontract"
T0_WORK: "T0-WORK\nCollector work independent\nof mutator storage"
T0_HEAP: "T0-HEAP\nAllocation, generations and\ncapacity ownership"
T0_CONTROL: "T0-CONTROL\nContinuation and frame\nlifetime independent of\ncarrier"
T0_FOREIGN: "T0-FOREIGN\nRoot-safe host ownership and\nresource release"
T0_PROGRESS: "T0-PROGRESS\nWhole SMP safety plus\nprogress and scalability"
T0_EXECUTION -> T0_ROOTS: "Final roots and stopped mutation\nunder an epoch-bound context\ngrant"
T0_ROOTS -> T0_WORK: "Admitted FrameSpec root view and\nmetadata lease, independent of\nworker ID"
T0_WORK -> T0_HEAP: "Phase closure and one accepted\ncapacity/promotion grant"
T0_HEAP -> T0_CONTROL: "Relocated roots and governed\nwrite/barrier policy"
T0_CONTROL -> T0_ROOTS: "Current/saved/captured origins\nand all controlled mutations"
T0_FOREIGN -> T0_EXECUTION: "Legal host ownership,\npark/reentry and acquired-effect\ndisposition"
T0_FOREIGN -> T0_ROOTS: "External roots and alias/borrow\nclosure"
T0_WORK -> T0_PROGRESS: "Complete\nproducer/task/descendant census"
T0_PROGRESS -> T0_EXECUTION: "Common completion/reload or\nretained-failure outcome, never\nlocal-empty alone"
