# interconnection rendering (no view declared; rendering GambitRuntimeComposition::T0TargetGraph directly)
classes: {
  definition: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14 } }
  usage: { style: { fill: white; stroke: "#181818"; stroke-width: 1; font-color: black; font-size: 14; border-radius: 8 } }
  connection: { style: { stroke: "#181818"; font-size: 13; font-color: black; stroke-width: 3 } }
}
n0: "«part def»\nT0TargetGraph" {
  class: definition
  n1: "«part»\nexecution : T0FoundationLane" { class: usage }
  n2: "«part»\nroots : T0FoundationLane" { class: usage }
  n3: "«part»\nwork : T0FoundationLane" { class: usage }
  n4: "«part»\nheap : T0FoundationLane" { class: usage }
  n5: "«part»\ncontrol : T0FoundationLane" { class: usage }
  n6: "«part»\nforeign : T0FoundationLane" { class: usage }
  n7: "«part»\nprogress : T0FoundationLane" { class: usage }
}
n0.n1 -- n0.n2: "executionRootCut" { class: connection }
n0.n2 -- n0.n3: "rootsScanGrant" { class: connection }
n0.n3 -- n0.n4: "workCapacity" { class: connection }
n0.n4 -- n0.n1: "heapCompletion" { class: connection }
n0.n5 -- n0.n2: "controlOrigins" { class: connection }
n0.n6 -- n0.n1: "foreignParticipation" { class: connection }
n0.n6 -- n0.n2: "foreignRoots" { class: connection }
n0.n3 -- n0.n7: "workClosure" { class: connection }
n0.n7 -- n0.n1: "commonCompletion" { class: connection }
