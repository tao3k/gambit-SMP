direction: down
input: { label: "Stable input + activation roots + operation identity" }
write: { label: "Sole initializer; reserved write may be in flight" }
cut: { label: "Committed cursor; writer idle; exact physical prefix" }
freeze: { label: "Frozen owner transfer; authoritative generation commit" }
unknown: { label: "Unknown: query same operation; no replay/refund" }
complete: { label: "Body complete + service result root + remembered coverage" }
offer: { label: "Offer result to exact recipient activation" }
admit: { label: "Atomic receiver root + acceptance receipt; duplicate is read-only" }
cleanup: { label: "Retire sender roots after receipt and reader drain" }
peak: { label: "Full backing + input + root/init/receipt phase peak" }
input -> write: "allocate once"
write -> cut: "publish progress only after writes"
cut -> write: "resume remaining suffix"
cut -> freeze: "freeze at idle cut"
freeze -> write: "new generation; old owner revoked"
write -> unknown: "lost reply; original owner may continue"
complete -> unknown: "complete but response unknown"
unknown -> cut: "authoritative idle readback"
unknown -> complete: "validate completed/rooted identity"
cut -> complete: "all fields done; publish result root"
complete -> offer: "no reconstruction"
offer -> admit: "linearized accept or reject"
admit -> cleanup: "query receipt, then release"
admit -> admit: "same identity\nreturns\nprior receipt"
unknown -> peak: "retain full possible block"
cleanup -> peak: "receipt retirement adds lifetime"
input -> peak: "input lease/snapshot bytes"
