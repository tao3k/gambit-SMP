+;;; Distinguish publication from sender/receiver root repair. Counterfactual GC
+;;; modes are controls; they never replace the original both-GC acceptance case.
+(##namespace ("gambit#tests#smp#scheduler#mailbox#"
+              mode receiver sender verify collect?))
+(define mode (getenv "GAMBIT_MAILBOX_GC" "both"))
+(define receiver (current-thread))
+(define (collect? side i)
+  (and (= (modulo i 8) 0)
+       (or (string=? mode "both") (string=? mode side))))
+(define (verify phase i message)
+  (if (not (and (vector? message) (= (vector-length message) 2)
+                (= (vector-ref message 0) i)
+                (equal? (vector-ref message 1) (list i (+ i 1)))))
+      (begin
+        (write (list 'MAILBOX-BOUNDARY-FAIL phase 'expected i 'observed message))
+        (newline) (force-output)
+        (exit 1))))
+(define sender
+  (make-thread
+   (lambda ()
+     (let loop ((i 0))
+       (if (= i 64) i
+           (let ((message (vector i (list i (+ i 1)))))
+             (verify 'sender-before-gc i message)
+             (if (collect? "sender" i) (##gc))
+             (verify 'sender-before-publish i message)
+             (thread-send receiver message)
+             (loop (+ i 1))))))))
+(thread-start! sender)
+(let loop ((i 0))
+  (if (< i 64)
+      (let ((message (thread-receive 5 'timeout)))
+        (if (eq? message 'timeout) (error "mailbox failed to make progress" i))
+        (verify 'receiver-before-gc i message)
+        (if (collect? "receiver" i) (##gc))
+        (verify 'receiver-after-gc i message)
+        (loop (+ i 1)))))
+(if (not (= (thread-join! sender) 64)) (error "sender did not complete"))
+(write (list 'MAILBOX-BOUNDARIES-PASS mode 64)) (newline)
