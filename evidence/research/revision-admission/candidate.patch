+    ___WORD flag=primary->intr_flag[___INTR_USER];
+    ___raise_interrupt(___INTR_USER);
+    REQUIRE(___GSTATE->vm_pending_interrupts & (1<<___INTR_USER),10);
+    REQUIRE(!___cleanup() && ___GSTATE->setup_state==1,11);
+    registry_release(); held=0;
+    REQUIRE(!(___GSTATE->vm_pending_interrupts & (1<<___INTR_USER)),12);
+    REQUIRE(primary->intr_flag[___INTR_USER]!=0,13);
+    primary->intr_flag[___INTR_USER]=flag;
