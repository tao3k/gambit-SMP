+      if: "${{ !cancelled() && steps.bootstrap.outcome == 'success' }}"
+      env:
+        GAMBIT_SMP_CASE: gambit.smp.control.callback.nonlocal-exit
+        GAMBIT_SMP_OUT: ".smp-ci/gambit.smp.control.callback.nonlocal-exit"
