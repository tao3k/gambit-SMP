+
+#define ___BEGIN_ALLOC_U8VECTOR(n) \
+___BEGIN_ALLOC_SUBTYPED(___MAKE_HD_BYTES(n,___sU8VECTOR));
+#define ___ADD_U8VECTOR_ELEM_RAW(i,val)___STORE_U8(___BODY0_FROM_HP(),i,val);
+#define ___ADD_U8VECTOR_ELEM(i,val)___ADD_U8VECTOR_ELEM_RAW(i,___INT(val))
