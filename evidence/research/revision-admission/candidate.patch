+    {
+      /* expansion of the msections */
+
+      int i, j;
+
+      while (ns < n)
+        {
+          ___msection *s = ___CAST(___msection*,
+                                   alloc_mem_aligned_heap
+                                     (___WORDS(___sizeof_msection(___MSECTION_SIZE)),
