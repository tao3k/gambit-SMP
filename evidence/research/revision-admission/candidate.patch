diff --git a/tests/smp/control/dynamic-wind-multishot.scm b/tests/smp/control/dynamic-wind-multishot.scm
new file mode 100644
index 0000000000000000000000000000000000000000..b445a2add375c342dc06198f73ae6dc51a86bfdc
--- /dev/null
+++ b/tests/smp/control/dynamic-wind-multishot.scm
@@ -0,0 +1,25 @@
+;;; Full multi-shot continuation; GC separates each restoration and wind pair.
+(define saved #f)
+(define shot 0)
+(define events '())
+(define payload (vector (make-string 256 #\p)))
+(define (record event) (set! events (cons event events)))
+(define (exercise)
+  (let ((answer
+         (dynamic-wind
+          (lambda () (record 'enter))
+          (lambda ()
+            (call-with-current-continuation
+             (lambda (k) (set! saved k) 'first)))
+          (lambda () (record 'leave)))))
+    (if (not (= (string-length (vector-ref payload 0)) 256))
+        (error "resume root lost"))
+    (cond ((= shot 0) (set! shot 1) (##gc) (saved 'second))
+          ((= shot 1) (set! shot 2) (##gc) (saved 'third))
+          (else
+           (if (not (and (eq? answer 'third)
+                         (equal? (reverse events)
+                                 '(enter leave enter leave enter leave))))
+               (error "multi-shot winding mismatch" answer events))
+           (display "WIND-RESUME-GC-PASS shots=3\n")))))
+(exercise)
diff --git a/tests/smp/gc/index-traversal.scm b/tests/smp/gc/index-traversal.scm
new file mode 100644
index 0000000000000000000000000000000000000000..db231cd6113a8189283aec737ddbd27f90191786
--- /dev/null
+++ b/tests/smp/gc/index-traversal.scm
@@ -0,0 +1,69 @@
+(declare (standard-bindings) (extended-bindings))
+(##namespace ("gambit#tests#smp#gc#index_traversal#" table seen count exercise-moving-keys))
+;; The producer has one Scheme writer. GC may run during the visitor, but
+;; collection must not make an unchanged table visit a key twice or skip it.
+(define table (make-table test: eq?))
+(let fill ((i 0))
+  (if (< i 97)
+      (begin
+        (table-set! table (string->symbol (string-append "index-traversal-" (number->string i))) i)
+        (fill (+ i 1)))))
+(define seen '())
+(define count 0)
+(table-for-each
+ (lambda (key value)
+   (if (memq key seen) (error "GC repeated an unchanged table entry" key count))
+   (set! seen (cons key seen))
+   (set! count (+ count 1))
+   (##gc))
+ table)
+(if (not (= count 97)) (error "GC skipped an unchanged table entry" count))
+
+;; Moving keys exercise invalid address placement as well as a stable cursor.
+;; The private native read below has no public table-access prelude. This does
+;; not lift the manual's restriction on public same-table operations in a
+;; table-for-each visitor, nor admit a concurrent or reentrant writer.
+(define (exercise-moving-keys weak?)
+  (let* ((keys (let fill ((i 0) (xs '()))
+                 (if (= i 97) xs (fill (+ i 1) (cons (vector i) xs)))))
+         (tbl (make-table test: eq? weak-keys: weak? weak-values: weak?))
+         (seen '())
+         (count 0))
+    (for-each (lambda (key) (table-set! tbl key key)) keys)
+    (let ((gcht (##table-get-eq-gcht tbl (car keys))))
+      (table-for-each
+       (lambda (key value)
+         (if (or (memq key seen) (not (eq? key value)))
+             (error "moving-key traversal lost identity" weak? count))
+         (set! seen (cons key seen))
+         (set! count (+ count 1))
+         (##gc)
+         (if (not (eq? (##gc-hash-table-ref gcht key) key))
+             (error "read-only address-debt lookup failed" weak? count)))
+       tbl))
+    (if (not (and (= count 97) (= (length keys) 97)
+                  (= (length (table->list tbl)) 97)))
+        (error "moving-key traversal skipped an entry" weak? count))
+    (for-each (lambda (key)
+                (if (not (eq? (table-ref tbl key #f) key))
+                    (error "relocated key not found" weak?))) keys)
+    (if (table-ref tbl (vector -1) #f) (error "missing key was found"))
+    ;; The first write, including a value replacement, owns reconstruction.
+    ;; Retain all weak keys/values while checking the table and its copy.
+    (##gc)
+    (table-set! tbl (car keys) 'replacement)
+    (if (not (eq? (table-ref tbl (car keys)) 'replacement))
+        (error "writer-owned reconstruction lost replacement"))
+    (table-set! tbl (car keys))
+    (if (or (table-ref tbl (car keys) #f) (not (= (table-length tbl) 96)))
+        (error "writer-owned deletion failed"))
+    (table-set! tbl (car keys) (car keys))
+    (let ((copy (table-copy tbl)))
+      (##gc)
+      (for-each (lambda (key)
+                  (if (not (eq? (table-ref copy key #f) key))
+                      (error "copy lost relocated identity key"))) keys))
+    (if (not (= (length keys) 97)) (error "weak fixture root retention failed"))))
+(exercise-moving-keys #f)
+(exercise-moving-keys #t)
+(display "INDEX-TRAVERSAL-PASS entries=97\n")
diff --git a/tests/smp/gc/mailbox-epoch-handoff.scm b/tests/smp/gc/mailbox-epoch-handoff.scm
new file mode 100644
index 0000000000000000000000000000000000000000..6b9ad341d007d90519319eebd71d8b61f92583d4
--- /dev/null
+++ b/tests/smp/gc/mailbox-epoch-handoff.scm
@@ -0,0 +1,54 @@
+(##include "~~lib/_gambit#.scm")
+(##include "~~lib/_thread#.scm")
+(##namespace ("gambit#tests#smp#gc#stop#mailbox-handoff#"
+              receiver mailbox permit senders shared seen deadline before after))
+(define receiver (current-thread))
+(define mailbox (##thread-mailbox-get! receiver))
+(define permit (macro-mailbox-mutex mailbox))
+(define shared (vector 'original-shared-value (list 31 32)))
+(define seen (make-vector 4 0))
+(mutex-lock! permit)
+(define before (f64vector-ref (##process-statistics) 6))
+(define senders
+  (let make ((id 0))
+    (if (= id 4) '()
+        (cons (let ((id id))
+                (thread-start!
+                 (make-thread
+                  (lambda ()
+                    (let send ((n 0))
+                      (if (< n 32)
+                          (let ((value (vector id n (list n (+ n 1)) shared)))
+                            (if (= (modulo n 8) 0) (##gc))
+                            (thread-send receiver value)
+                            (send (+ n 1)))))))))
+              (make (+ id 1))))))
+(define deadline (+ 5 (time->seconds (current-time))))
+(let wait ()
+  (if (not (let all ((ts senders))
+             (or (null? ts)
+                 (let ((state (thread-state (car ts))))
+                   (and (thread-state-waiting? state)
+                        (eq? (thread-state-waiting-for state) permit)
+                        (all (cdr ts)))))))
+      (if (> (time->seconds (current-time)) deadline)
+          (error "publishers did not reach mailbox permit")
+          (begin (thread-yield!) (wait)))))
+(##gc)
+(mutex-unlock! permit)
+(let receive ((n 0))
+  (if (< n 128)
+      (let ((m (thread-receive 5 'timeout)))
+        (if (not (and (vector? m) (= (vector-length m) 4))) (error "missing epoch message" n m))
+        (let ((id (vector-ref m 0)) (i (vector-ref m 1)))
+          (if (not (and (= i (vector-ref seen id))
+                        (equal? (vector-ref m 2) (list i (+ i 1)))
+                        (eq? (vector-ref m 3) shared)))
+              (error "stop/publication root handoff lost" n m))
+          (vector-set! seen id (+ i 1)))
+        (if (= (modulo n 16) 0) (##gc))
+        (receive (+ n 1)))))
+(for-each (lambda (t) (if (eq? (thread-join! t 5 'timeout) 'timeout) (error "publisher did not exit"))) senders)
+(define after (f64vector-ref (##process-statistics) 6))
+(if (not (and (> after before) (equal? seen '#(32 32 32 32)))) (error "incomplete stop history" seen))
+(display "MAILBOX-EPOCH-HANDOFF-PASS workers=4 messages=128\n")
diff --git a/tests/smp/gc/native-fault-adapter.c b/tests/smp/gc/native-fault-adapter.c
new file mode 100644
index 0000000000000000000000000000000000000000..77f45a5347f52ca824ad833c897d46ed4bc576bf
--- /dev/null
+++ b/tests/smp/gc/native-fault-adapter.c
@@ -0,0 +1,66 @@
+/* Darwin qualification adapter only. Never linked into the runtime/profile. */
+/* Bind this control to the configured native word ABI. No Gambit runtime
+ * function is invoked by the independent interposition calibration. */
+#include "gambit.h"
+static_assert(sizeof(___WORD) == sizeof(void *), "native control word ABI");
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <errno.h>
+#include <dlfcn.h>
+#include <malloc/malloc.h>
+#include <sched.h>
+static _Atomic int create_at, join_at, allocation_at;
+static _Atomic int creates, joins, allocations, hold_start, held_starts;
+struct held_entry { void *(*fn)(void *); void *arg; };
+void resize_test_hold_start(int hold) { atomic_store(&hold_start,hold); }
+static void *held_entry(void *p) {
+  struct held_entry *e=p;
+  atomic_fetch_add(&held_starts,1);
+  while(atomic_load(&hold_start)) sched_yield();
+  void *result=e->fn(e->arg);
+  atomic_fetch_sub(&held_starts,1);
+  free(e);
+  return result;
+}
+
+void resize_test_arm(int c, int j, int a) {
+  atomic_store(&creates,0);atomic_store(&joins,0);atomic_store(&allocations,0);
+  atomic_store(&create_at,c);atomic_store(&join_at,j);atomic_store(&allocation_at,a);
+}
+int resize_test_count(int kind) {
+  return kind==3 ? atomic_load(&held_starts) : kind==0 ? atomic_load(&creates) : kind==1 ? atomic_load(&joins) : atomic_load(&allocations);
+}
+static int create_thread(pthread_t *id,const pthread_attr_t *attr,
+                         void *(*fn)(void *),void *arg) {
+  int at=atomic_load(&create_at);
+  if(at && atomic_fetch_add(&creates,1)+1==at) {errno=0;return EAGAIN;}
+  /* dyld excludes the interposer image from its own replacement tuples. */
+  if(atomic_load(&hold_start)) {
+    struct held_entry *e=malloc_zone_malloc(malloc_default_zone(),sizeof(*e));
+    if(!e) return ENOMEM;
+    e->fn=fn;e->arg=arg;
+    int error=pthread_create(id,attr,held_entry,e);
+    if(error) free(e);
+    return error;
+  }
+  return pthread_create(id,attr,fn,arg);
+
+}
+static int join_thread(pthread_t id,void **result) {
+  int at=atomic_load(&join_at);
+  if(at && atomic_fetch_add(&joins,1)+1==at) {errno=0;return ESRCH;}
+  return pthread_join(id,result);
+}
+static void *allocate(size_t bytes) {
+  int at=atomic_load(&allocation_at);
+  if(at && bytes>=1048576 && bytes<1052672 &&
+     atomic_fetch_add(&allocations,1)+1==at) {errno=ENOMEM;return NULL;}
+  return malloc_zone_malloc(malloc_default_zone(),bytes);
+}
+#define INTERPOSE(replacement,original) \
+  __attribute__((used)) static struct {const void *r,*o;} map_##original \
+  __attribute__((section("__DATA,__interpose")))={(const void *)&replacement,(const void *)&original}
+INTERPOSE(create_thread,pthread_create);
+INTERPOSE(join_thread,pthread_join);
+INTERPOSE(allocate,malloc);
diff --git a/tests/smp/gc/native-fault-calibration.c b/tests/smp/gc/native-fault-calibration.c
new file mode 100644
index 0000000000000000000000000000000000000000..6e2ced48efb5430d1d5a7f7ccd82f60612718698
--- /dev/null
+++ b/tests/smp/gc/native-fault-calibration.c
@@ -0,0 +1,36 @@
+/* Independent qualification of the Darwin injection adapter; no Gambit code. */
+/* Bind this control to the configured native word ABI. No Gambit runtime
+ * function is invoked by the independent interposition calibration. */
+#include "gambit.h"
+static_assert(sizeof(___WORD) == sizeof(void *), "native control word ABI");
+#include <pthread.h>
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sched.h>
+#include <stdatomic.h>
+static _Atomic int invoked; static void *entry(void *p) {atomic_fetch_add(&invoked,1);return p;}
+int main(void) {
+  void (*arm)(int,int,int)=dlsym(RTLD_DEFAULT,"resize_test_arm");
+  int (*count)(int)=dlsym(RTLD_DEFAULT,"resize_test_count");
+  if (!arm || !count) return 2;
+  pthread_t first,second;arm(2,1,0);
+  int a=pthread_create(&first,0,entry,0),b=pthread_create(&second,0,entry,0);
+  int c=a==0?pthread_join(first,0):-1;
+  int creates=count(0),joins=count(1);
+  printf("create_first=%d create_second=%d join_first=%d creates=%d joins=%d\n",a,b,c,creates,joins);
+  arm(0,0,0);if(a==0&&c!=0)pthread_join(first,0);if(b==0)pthread_join(second,0);
+  if(!(a==0&&b==EAGAIN&&c==ESRCH&&creates==2&&joins==1)) return 1;
+  void (*hold)(int)=dlsym(RTLD_DEFAULT,"resize_test_hold_start");
+  if(!hold) return 3;
+  atomic_store(&invoked,0);hold(1);
+  if(pthread_create(&first,0,entry,0)) return 4;
+  while(count(3)!=1) sched_yield();
+  int before=atomic_load(&invoked);
+  hold(0);if(pthread_join(first,0)) return 5;
+  int after=atomic_load(&invoked),pending=count(3);
+  printf("held_invocations=%d released_invocations=%d held_remaining=%d\n",before,after,pending);
+  return before==0&&after==1&&pending==0?0:6;
+
+}
diff --git a/tests/smp/gc/shared-roots.scm b/tests/smp/gc/shared-roots.scm
new file mode 100644
index 0000000000000000000000000000000000000000..bf0b8f7b95f66c50e92d6cedcc16785e9204cdf1
--- /dev/null
+++ b/tests/smp/gc/shared-roots.scm
@@ -0,0 +1,28 @@
+;;; Real same-VM Scheme workers, shared aliases, cyclic objects and completed GC.
+(define nodes
+  (map (lambda (id)
+         (let ((v (vector id #f (make-string 128 #\x))))
+           (vector-set! v 1 v)
+           v))
+       '(0 1 2 3)))
+(define workers
+  (map (lambda (node)
+         (make-thread
+          (lambda ()
+            (let loop ((n 0))
+              (if (= n 8) n
+                  (begin
+                    (##gc)
+                    (if (not (and (eq? node (vector-ref node 1))
+                                  (= (string-length (vector-ref node 2)) 128)))
+                        (error "shared root or cycle lost" n))
+                    (loop (+ n 1))))))))
+       nodes))
+(for-each thread-start! workers)
+(define completed (apply + (map thread-join! workers)))
+(if (not (= completed 32)) (error "worker collection completion lost"))
+(##gc)
+(for-each (lambda (node)
