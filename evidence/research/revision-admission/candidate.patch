+          ms->sections[i] = s;
+
+          if (tl == 0)
+            {
+              hd = s;
+              s->index = 0;
+            }
+          else
+            {
+              tl->next = s;
+              s->index = tl->index + 1;
+            }
+
+          s->pos = i;
+          s->prev = tl;
+          s->next = 0;
+
+          tl = s;
