index 0000000000000000000000000000000000000000..f00c098ee265495eae2a498821d1c163bfdb5e47
--- /dev/null
+++ b/tests/sfun-exit.scm
@@ -0,0 +1,49 @@
+;;; A nonlocal Scheme exit must close each generated C callback root bank.
+(declare (standard-bindings) (extended-bindings))
+(##namespace ("gambit#tests#smp#control#callback_exit#"
+              body invoke borrow-count check run))
+(c-declare "___SCMOBJ gambit_smp_callback_exit(void);")
+(define body #f)
+(c-define (callback) () scheme-object "gambit_smp_callback_exit" "" (body))
+(define invoke (c-lambda () scheme-object "gambit_smp_callback_exit"))
+(define borrow-count
+  (c-lambda () int "___return(___ps->context->mem.rc_root_borrows_);"))
+(define (check expected actual)
+  (if (not (equal? expected actual))
+      (error "callback exit contract" expected actual)))
+(define (run depth)
+  (let ((before (borrow-count)) (levels (+ depth 1)) (winds '()))
+    (check 'escaped
+      (call-with-current-continuation
+        (lambda (escape)
+          (set! body
+            (lambda ()
+              (dynamic-wind
+                (lambda () (set! winds (cons 'enter winds)))
+                (lambda ()
+                  (##gc)
+                  (if (= depth 0)
+                      (escape 'escaped)
+                      (begin
+                        (set! depth (- depth 1))
+                        (invoke))))
+                (lambda () (set! winds (cons 'leave winds))))))
+          (invoke)
+          (error "nonlocal callback returned"))))
+    ;; Scheme may execute the target continuation before reaching the return
+    ;; to C handler. These physical callback frames still own their banks.
+    ;; Immediate zero would drop live native roots. Process exit below must
+    ;; unwind them all before context teardown (which refuses any live bank).
+    (check (+ before levels) (borrow-count))
+    (check 0 (let loop ((xs winds) (balance 0))
+               (if (null? xs) balance
+                   (loop (cdr xs) (+ balance (if (eq? (car xs) 'enter) 1 -1))))))
+    (##gc)
+    (check (+ before levels) (borrow-count))))
+(run 0)
+(run 2)
+(let ((before (borrow-count)))
+  (set! body (lambda () 'returned))
+  (check 'returned (invoke))
+  (check before (borrow-count)))
+(display "CALLBACK-EXIT-PASS direct nested normal gc dynamic-wind\n")
diff --git a/tests/smp/campaign.scm b/tests/smp/campaign.scm
new file mode 100644
index 0000000000000000000000000000000000000000..6df57eaeab7103464aab75926a6dde934fbf97d3
--- /dev/null
+++ b/tests/smp/campaign.scm
@@ -0,0 +1,52 @@
+;;; Native Scheme composition of the independent named suite cases. The suite
+;;; owns each case's original budgets and raw receipts; failures do not skip
+;;; siblings and cannot be erased by retrying inside this campaign.
+(##namespace ("gambit#tests#smp#campaign#"
+              root runtime out names statuses run-case write-status suite timeout-tool))
+(define root (path-expand (getenv "GAMBIT_SMP_ROOT" ".")))
+(define runtime (path-expand (getenv "GAMBIT_SMP_RUNTIME" root)))
+(define out (path-expand (getenv "GAMBIT_SMP_CAMPAIGN_OUT")))
+(define timeout-tool (getenv "GAMBIT_SMP_TIMEOUT" #f))
+(if (not (and timeout-tool (file-exists? timeout-tool)))
+    (error "GAMBIT_SMP_TIMEOUT must name the environment-selected timeout tool"))
+(define statuses '())
+(load (path-expand "tests/smp/catalog.scm" (string-append root "/")))
+(define names
+  (let partition ((rows gambit#tests#smp#cases) (mailbox '()) (others '()))
+    (if (null? rows) (append (reverse mailbox) (reverse others))
+        (if (string=? (list-ref (car rows) 6) "gambit.smp.scheduler.mailbox")
+            (partition (cdr rows) (cons (caar rows) mailbox) others)
+            (partition (cdr rows) mailbox (cons (caar rows) others))))))
+(define suite (path-expand "tests/smp/suite.scm" (string-append root "/")))
+(define (write-status)
+  (call-with-output-file (string-append out "/campaign.scm")
+    (lambda (p) (write (reverse statuses) p) (newline p))))
+(define (run-case name)
+  (setenv "GAMBIT_SMP_CASE" name)
+  (setenv "GAMBIT_SMP_OUT" (string-append out "/" name))
+  (setenv "GAMBOPT" (string-append "p1,~~lib=" runtime "/lib,~~bin=" runtime "/bin,~~include=" runtime "/include"))
+  (let* ((p (open-process
+             (list path: timeout-tool
+                   arguments: (list "--kill-after=2s" "120s" (string-append runtime "/gsi/gsi") suite)
+                   directory: root stderr-redirection: #t)))
+         (reader (make-thread
+                  (lambda ()
+                    (call-with-output-file (string-append out "/" name ".output")
+                      (lambda (log)
+                        (let loop ((b (read-u8 p)))
+                          (if (not (eof-object? b))
+                              (begin (write-u8 b log) (loop (read-u8 p)))))))))))
+    (close-output-port p) (thread-start! reader)
+    (let ((status (process-status p 123 'unknown))
+          (joined (thread-join! reader 2 'unknown)))
+      (close-input-port p)
+      (set! statuses (cons (list name status (not (eq? joined 'unknown))) statuses))
+      (write-status)
+      (write (car statuses)) (newline))))
+(create-directory out)
+(for-each run-case names)
+(exit (let all ((rows statuses))
+        (if (null? rows) 0
+            (let ((row (car rows)))
+              (if (and (number? (cadr row)) (= (cadr row) 0) (caddr row))
+                  (all (cdr rows)) 1)))))
