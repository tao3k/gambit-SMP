diff --git a/include/_gambit/runtime_roles.h.in b/include/_gambit/runtime_roles.h.in
new file mode 100644
index 0000000000000000000000000000000000000000..52a24cd6a34d5e8904377caef41c5e473818977a
--- /dev/null
+++ b/include/_gambit/runtime_roles.h.in
@@ -0,0 +1,226 @@
+/* Processor structure */
+
+/* Execution roots, GC membership and collector work have distinct owners.
+ * Storage is VM-owned.  The synchronous carrier assignment does not grant
+ * asynchronous worker migration or native-callback admission. */
+typedef struct ___execution_context_struct
+  {
+    ___WORD *stack_limit;
+    ___WORD *fp;
+    ___WORD *stack_start;
+    ___WORD *stack_break;
+
+    ___WORD *heap_limit;
+    ___WORD *hp;
+
+    ___WORD r[___NB_GVM_REGS]; /* GVM registers */
+
+    ___WORD pc;
+    ___WORD na;
+
+    ___WORD saved[3]; /* Scheme objects protected from GC */
+
+    ___WORD type_cache[2];
+#define ___CHAR_INPUT_PORT_TYPE_CACHE  0
+#define ___CHAR_OUTPUT_PORT_TYPE_CACHE 1
+
+    ___SCMOBJ startup_thunk; /* published entry root; reloaded after sync/GC */
+    ___SCMOBJ entry_marker;  /* startup activation, invalidated before retirement */
+    ___WORD startup_generation; /* immutable for this native activation */
+
+    ___WORD processor_scmobj[___SUBTYPED_BODY+___PROCESSOR_SIZE+___PADDING_SIZE]; /* Scheme processor object */
+    ___context_mem mem;
+  } ___execution_context;
+
+/* Root identity and task ownership do not name a host carrier. Descriptors
+ * remain pinned until the collective/round has drained every old reader. */
+typedef struct ___gc_root_origin_struct
+  {
+    ___execution_context *context;
+    ___WORD incarnation;
+    ___WORD epoch;
+    ___VOLATILE ___WORD state; /* 0 running, 1 publishing, 2 frozen */
+  } ___gc_root_origin;
+
+typedef enum ___gc_root_phase_enum
+  {
+    ___GC_ROOT_PREPARE, ___GC_ROOT_STRONG, ___GC_ROOT_WEAK, ___GC_ROOT_CLEANUP
+  } ___gc_root_phase;
+
+typedef struct ___gc_root_task_struct
+  {
+    ___gc_root_origin *origin;
+    ___WORD incarnation;
+    ___WORD epoch;
+    ___gc_root_phase phase; /* coordinator advances only after phase drain */
+    ___VOLATILE ___WORD claim; /* 0 private, 1 ready, 2 done, >=4 owner */
+  } ___gc_root_task;
+
+/* A stopped context reserves its restoration stack before any destination
+ * writes. A worker may consume its explicitly bounded bottom loan once;
+ * neither that loan nor a carrier address grants root-domain authority. */
+typedef struct ___gc_resume_space_struct
+  {
+    ___execution_context *context;
+    ___WORD epoch;
+    ___msection *stack_section;
+    ___WORD *loan_base;
+    ___WORD *loan_limit;
+    ___WORD *stack_floor;
+    int loan_used;
+    int accepted;
+    int restored; /* active stack restored, before owner-affine cleanup */
+    int source_worker; /* -1: independent empty span; otherwise unique W tail */
+  } ___gc_resume_space;
+
+typedef struct ___gc_worker_arena_struct
+  {
+    ___WORD *base;
+    ___WORD *cursor;
+    ___WORD *limit;
+    ___WORD *pending;
+    ___WORD *pending_past;
+    ___msection *section;
+    ___WORD epoch;
+    ___SIZE_TS retired_words;
+    ___SIZE_TS refills;
+    int handed_off;
+  } ___gc_worker_arena;
+
+typedef enum ___gc_worker_phase_enum
+  {
+    ___GC_WORKER_IDLE, ___GC_WORKER_PREPARED, ___GC_WORKER_STRONG_COMPLETE,
+    ___GC_WORKER_WEAK_COMPLETE, ___GC_WORKER_COMPLETE
+  } ___gc_worker_phase;
+
