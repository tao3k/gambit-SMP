+        GAMBIT_SMP_OUT: ".smp-ci/gambit.smp.gc.vm-lifecycle.custody"
+      run: gsi/gsi -:p1,~~lib=lib,~~bin=bin,~~include=include tests/smp/suite.scm
+    - id: gambit_smp_gc_vm_lifecycle_global_reclaim
