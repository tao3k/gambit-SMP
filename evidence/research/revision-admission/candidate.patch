+  pthread_t thread;
+  void *rc=NULL;
+  int code=0, held=0;
+#define REQUIRE(x,n) do { if (!(x)) {code=n;goto done;} } while(0)
+  REQUIRE(extra && rejected && retained,1);
+  REQUIRE(___setup_vmstate(extra)==___FIX(___NO_ERR),2);
+  secondary=___PSTATE_FROM_PROCESSOR_ID(0,extra);
