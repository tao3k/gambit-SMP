+  if (___GSTATE->setup_state != 1 || vm_registry_contains(vm))
+    { vm_registry_open(); return ___FIX(___UNKNOWN_ERR); }
+#ifdef ___SINGLE_VM
+  vm_registry_open(); return ___FIX(___UNKNOWN_ERR);
+#else
+  result = setup_vmstate_owned(vm);
+  if (result != ___FIX(___NO_ERR))
+    {
+      /* Before PSTATE construction no user/native producer has entered.
+       * Unknown partially constructed contexts keep their control storage. */
+      if (!(vm->setup_stages & ___VM_SETUP_PROCESSOR_STARTED))
+        {
