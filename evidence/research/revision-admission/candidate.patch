+(*___CAST(___FAKEHOST*,___SUBTYPED_TO(lbl,___LABEL_HOST)))
+
+    ___WORD header;
+
+    ___WORD entry_or_descr;
+#define ___LABEL_ENTRY_OR_DESCR 0
