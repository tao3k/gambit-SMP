+/* The VM owner supplies a stopped, single-context domain. Registry membership
+ * is removed only after every destructive stage returns a known success. A
+ * void early return can no longer be mistaken for a global reclamation seal. */
+static int vm_cleanup_admitted (___virtual_machine_state vm, int terminal)
+{
+  int i;
+  ___processor_state ps = ___PSTATE_FROM_PROCESSOR_ID(0,vm);
+  if (___PSTATE != ps || vm->lifecycle != ___VM_LIVE ||
+      vm->processor_count != 1 || vm->resize.phase != ___RESIZE_IDLE ||
+      vm->gc_participants[0].phase != ___GC_RUNNING ||
+      !___gc_cleanup_empty(&vm->gc_participants[0].cleanup)) return 0;
+#ifdef ___USE_SETJMP
+  if (!terminal && ps->catcher != 0) return 0;
+#endif
+  for (i=0; i<___MAX_PROCESSORS; i++)
+    if (___gc_atomic_load(&vm->resize_requests[i].state) != ___RESIZE_SOURCE_IDLE)
+      return 0;
+  ___SPINLOCK_LOCK(ps->context->mem.rc_gate_);
+  i = ps->context->mem.rc_root_borrows_ == 0;
+  ___SPINLOCK_UNLOCK(ps->context->mem.rc_gate_);
+  return i;
+}
+
+static ___BOOL cleanup_vmstate_owned (___virtual_machine_state vm, int terminal)
+{
+  ___processor_state ___ps = ___PSTATE_FROM_PROCESSOR_ID(0,vm);
+  ___SCMOBJ ___err;
+  ___VOLATILE ___BOOL completed = 0;
+  if (!vm_cleanup_admitted(vm,terminal)) return 0;
+  ___WORD_STORE_RELEASE(&vm->lifecycle,___VM_CLOSING);
+  vm->gc_participants[0].phase = ___GC_OWNER_CLEANUP;
+  ___BEGIN_TRY
+    if (___prepare_pstate_cleanup(___ps))
+      {
+        ___cleanup_pstate(___ps); /* exactly once; VM memory no longer repeats it */
+        vm->setup_stages &= ~___VM_SETUP_PROCESSOR;
+        cleanup_os_and_mem_vmstate(vm);
+        vm->setup_stages &= ~___VM_SETUP_MEMORY;
+        ___cleanup_actlog_vmstate(vm);
+        vm->setup_stages &= ~___VM_SETUP_ACTLOG;
+#ifndef ___SINGLE_THREADED_VMS
+        if (vm->resize.gate_initialized)
+          {
+            ___CONDVAR_DESTROY(vm->resize.changed);
+            ___MUTEX_DESTROY(vm->resize.gate);
+            vm->resize.gate_initialized = 0;
+          }
+#endif
+        vm->setup_stages = 0;
+        completed = 1;
+      }
+  ___END_TRY
+  if (!completed)
+    {
+      vm->resize.phase = ___RESIZE_RETAINED;
+      ___WORD_STORE_RELEASE(&vm->lifecycle,___VM_RETAINED);
+      return 0; /* escrow and registry keep unknown effects; never replay */
+    }
+  vm_registry_remove(vm);
+  return 1;
+}
