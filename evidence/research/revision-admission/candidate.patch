new file mode 100644
index 0000000000000000000000000000000000000000..1b285046f763fcca99f5e300f2395d850bdb2068
--- /dev/null
+++ b/lib/write_authority.c
@@ -0,0 +1,217 @@
+/* Bounded native write-authority records; no allocation, callbacks or GC. */
+#define ___INCLUDED_FROM_WRITE_AUTHORITY
+#define ___VERSION 409008
+#include "gambit.h"
+#include "write_authority.h"
+
+#if ___WORD_WIDTH < 32
+#error "write authority requires at least a 32-bit word"
+#endif
+typedef char authority_one_word[(sizeof (___write_authority) == sizeof (___WORD)) ? 1 : -1];
+
+/* Sequential sync macros use PSTATE scratch space.  Keep this service free of
+ * PSTATE: use ordinary accesses only in that explicitly single-thread backend.
+ * Other backends use Gambit's existing full-barrier RMW/CAS operations.  The
+ * emulated backend is not asynchronous lock-owner-death recovery.
+ */
+static ___WORD authority_read (___write_authority *scope)
+{
+#ifdef ___USE_sequential_sync
+  return scope->gate;
+#else
+  return ___FETCH_AND_ADD_WORD(&scope->gate,0);
+#endif
+}
+
+static ___WORD authority_cas (___write_authority *scope, ___WORD old, ___WORD next)
+{
+#ifdef ___USE_sequential_sync
+  ___WORD found = scope->gate;
+  if (found == old)
+    scope->gate = next;
+  return found;
+#else
+  return ___COMPARE_AND_SWAP_WORD(&scope->gate,old,next);
+#endif
+}
+
+static int authority_valid_tag (___WORD tag)
+{
+  if (tag < 0 || (tag & ~___WRITE_AUTHORITY_TAG_MASK) != 0)
+    return 0;
+  if (tag == 0)
+    return 1;
+  return (tag >> ___WRITE_AUTHORITY_GENERATION_SHIFT) != 0 &&
+         ((tag >> ___WRITE_AUTHORITY_ACTOR_SHIFT) & 255) != 0;
+}
+
+void ___write_authority_init (___write_authority *scope)
+{
+  scope->gate = ___WRITE_AUTHORITY_CLOSED;
+}
+
+void ___write_authority_init_vmstate (___virtual_machine_state vms)
+{
+  unsigned int i;
+  for (i=0; i<___WRITE_AUTHORITY_CAPACITY; i++)
+    ___write_authority_init (&vms->write_authorities[i]);
+}
+
+___WORD ___write_authority_snapshot (___write_authority *scope)
+{
+  return authority_read (scope);
+}
+
+int ___write_authority_prepare
+  (___WORD previous, unsigned int actor, ___WORD *candidate)
+{
+  ___UWORD generation;
+  if (!authority_valid_tag (previous) || actor == 0 || actor > 255)
+    return ___WRITE_AUTHORITY_INVALID;
+  generation = ___CAST(___UWORD,previous) >> ___WRITE_AUTHORITY_GENERATION_SHIFT;
+  if (generation == ___WRITE_AUTHORITY_MAX_GENERATION)
+    return ___WRITE_AUTHORITY_EXHAUSTED;
+  *candidate = ___CAST(___WORD,((generation+1) << ___WRITE_AUTHORITY_GENERATION_SHIFT) |
+                         (___CAST(___UWORD,actor) << ___WRITE_AUTHORITY_ACTOR_SHIFT));
+  return ___WRITE_AUTHORITY_OK;
+}
+
+int ___write_authority_try_handoff
+  (___write_authority *scope, ___WORD previous, ___WORD candidate)
+{
+  ___WORD old, next, expected;
+  unsigned int actor;
+  int status;
+  if (!authority_valid_tag (candidate) || candidate == 0)
+    return ___WRITE_AUTHORITY_INVALID;
+  actor = ___CAST(unsigned int,(candidate >> ___WRITE_AUTHORITY_ACTOR_SHIFT) & 255);
+  status = ___write_authority_prepare (previous, actor, &expected);
+  if (status != ___WRITE_AUTHORITY_OK)
+    return status;
+  if (candidate != expected)
+    return ___WRITE_AUTHORITY_INVALID;
+  old = authority_read (scope);
+  for (;;)
+    {
+      if ((old & ___WRITE_AUTHORITY_TAG_MASK) == candidate)
+        return ___WRITE_AUTHORITY_REPLAY;
+      if ((old & ___WRITE_AUTHORITY_TAG_MASK) != previous)
+        return ___WRITE_AUTHORITY_STALE;
+      if (!(old & ___WRITE_AUTHORITY_CLOSED) || (old & ___WRITE_AUTHORITY_LIVE_MASK))
+        return ___WRITE_AUTHORITY_BUSY;
+      /* The new owner starts with BOTH class permits.  There is no open,
+       * unaccounted writer window before a possibly lost acquisition reply.
+       */
+      next = candidate |
+             (___CAST(___WORD,17)<<___WRITE_AUTHORITY_LIVE_SHIFT) |
+             (___CAST(___WORD,17)<<___WRITE_AUTHORITY_USED_SHIFT);
+      expected = authority_cas (scope, old, next);
+      if (expected == old)
+        return ___WRITE_AUTHORITY_OK;
+      old = expected;
+    }
+}
+
+int ___write_authority_try_acquire
+  (___write_authority *scope, ___WORD tag, unsigned int role)
+{
+  ___WORD old, found, used, live;
+  if (!authority_valid_tag (tag) || tag == 0 || role >= ___WRITE_AUTHORITY_ROLES)
+    return ___WRITE_AUTHORITY_INVALID;
+  used = ___CAST(___WORD,1) << (___WRITE_AUTHORITY_USED_SHIFT+role);
+  live = ___CAST(___WORD,1) << (___WRITE_AUTHORITY_LIVE_SHIFT+role);
+  old = authority_read (scope);
+  for (;;)
+    {
+      if ((old & ___WRITE_AUTHORITY_TAG_MASK) != tag)
+        return ___WRITE_AUTHORITY_STALE;
+      if (old & ___WRITE_AUTHORITY_CLOSED)
+        return ___WRITE_AUTHORITY_BUSY;
+      if (old & used)
+        return ___WRITE_AUTHORITY_USED;
+      found = authority_cas (scope, old, old | used | live);
+      if (found == old)
+        return ___WRITE_AUTHORITY_OK;
+      old = found;
+    }
+}
+
+int ___write_authority_close (___write_authority *scope, ___WORD tag)
+{
+  ___WORD old, found;
+  if (!authority_valid_tag (tag) || tag == 0)
+    return ___WRITE_AUTHORITY_INVALID;
+  old = authority_read (scope);
+  for (;;)
+    {
+      if ((old & ___WRITE_AUTHORITY_TAG_MASK) != tag)
+        return ___WRITE_AUTHORITY_STALE;
+      if (old & ___WRITE_AUTHORITY_CLOSED)
+        return ___WRITE_AUTHORITY_REPLAY;
+      found = authority_cas (scope, old, old | ___WRITE_AUTHORITY_CLOSED);
+      if (found == old)
+        return ___WRITE_AUTHORITY_OK;
+      old = found;
+    }
+}
+
+int ___write_authority_release
+  (___write_authority *scope, ___WORD tag, unsigned int role)
+{
+  ___WORD old, found, used, live;
+  if (!authority_valid_tag (tag) || tag == 0 || role >= ___WRITE_AUTHORITY_ROLES)
+    return ___WRITE_AUTHORITY_INVALID;
+  used = ___CAST(___WORD,1) << (___WRITE_AUTHORITY_USED_SHIFT+role);
+  live = ___CAST(___WORD,1) << (___WRITE_AUTHORITY_LIVE_SHIFT+role);
+  old = authority_read (scope);
+  for (;;)
+    {
+      if ((old & ___WRITE_AUTHORITY_TAG_MASK) != tag)
+        return ___WRITE_AUTHORITY_STALE;
+      if (!(old & used))
+        return ___WRITE_AUTHORITY_INVALID;
+      if (!(old & live))
+        return ___WRITE_AUTHORITY_REPLAY;
+      /* Only the producer, AFTER its last actual write/borrow, may release.
+       * Catcher observation/failed join does not authorize clearing this bit.
+       */
+      found = authority_cas (scope, old, old & ~live);
+      if (found == old)
+        return ___WRITE_AUTHORITY_OK;
+      old = found;
+    }
+}
+
+int ___write_authority_class_quiescent
+  (___write_authority *scope, ___WORD tag, unsigned int first_role)
+{
+  ___WORD old, mask;
+  if (!authority_valid_tag (tag) || tag == 0 ||
+      (first_role != ___WRITE_AUTHORITY_CONTROL &&
+       first_role != ___WRITE_AUTHORITY_DATA))
+    return ___WRITE_AUTHORITY_INVALID;
+  old = authority_read (scope);
+  if ((old & ___WRITE_AUTHORITY_TAG_MASK) != tag)
+    return ___WRITE_AUTHORITY_STALE;
+  mask = ___CAST(___WORD,15) << (___WRITE_AUTHORITY_LIVE_SHIFT+first_role);
+  if (!(old & ___WRITE_AUTHORITY_CLOSED) || (old & mask))
+    return ___WRITE_AUTHORITY_BUSY;
+  return ___WRITE_AUTHORITY_OK;
+}
+
+int ___write_authority_quiescent (
+___write_authority *scope, ___WORD tag)
+{
+  ___WORD old;
+  if (!authority_valid_tag (tag) || tag == 0)
+    return ___WRITE_AUTHORITY_INVALID;
+  old = authority_read (scope);
+  if ((old & ___WRITE_AUTHORITY_TAG_MASK) != tag)
+    return ___WRITE_AUTHORITY_STALE;
+  if (!(old & ___WRITE_AUTHORITY_CLOSED) || (old & ___WRITE_AUTHORITY_LIVE_MASK))
+    return ___WRITE_AUTHORITY_BUSY;
+  /* Covers registered permits ONLY.  Not a physical stop/root/VM-free seal.
+   * Another qualified actor can already have advanced after this snapshot.
+   */
+  return ___WRITE_AUTHORITY_OK;
+}
diff --git a/lib/write_authority.h b/lib/write_authority.h
new file mode 100644
index 0000000000000000000000000000000000000000..cc2537dff2302f559dd2645dc5467b1a0d0421d0
--- /dev/null
+++ b/lib/write_authority.h
@@ -0,0 +1,62 @@
+/* Internal write-authority protocol.  Not a Scheme root or thread-stop API. */
+#ifndef ___WRITE_AUTHORITY_H
+#define ___WRITE_AUTHORITY_H
+
+#define ___WRITE_AUTHORITY_OK         0
+#define ___WRITE_AUTHORITY_REPLAY     1
+#define ___WRITE_AUTHORITY_BUSY       2
+#define ___WRITE_AUTHORITY_STALE      3
+#define ___WRITE_AUTHORITY_USED       4
+#define ___WRITE_AUTHORITY_EXHAUSTED  5
+#define ___WRITE_AUTHORITY_INVALID    6
+
+/* Four control roles (0..3), four data roles (4..7).  Role 0 and role 4
+ * belong to the generation owner.  Delegated roles have exactly one producer.
+ * A role is spent until the next generation, even after release.  This makes
+ * release idempotent without allowing a late release to clear a newer permit.
+ */
+#define ___WRITE_AUTHORITY_CONTROL 0
+#define ___WRITE_AUTHORITY_DATA    4
+#define ___WRITE_AUTHORITY_ROLES   8
+#define ___WRITE_AUTHORITY_CLOSED ___CAST(___WORD,1)
+#define ___WRITE_AUTHORITY_LIVE_SHIFT 1
+#define ___WRITE_AUTHORITY_USED_SHIFT 9
+#define ___WRITE_AUTHORITY_ACTOR_SHIFT 17
+#define ___WRITE_AUTHORITY_GENERATION_SHIFT 25
+#define ___WRITE_AUTHORITY_LIVE_MASK (___CAST(___WORD,255)<<1)
+#define ___WRITE_AUTHORITY_USED_MASK (___CAST(___WORD,255)<<9)
+#define ___WRITE_AUTHORITY_TAG_MASK (~((___CAST(___WORD,1)<<17)-1))
+/* Reserve the sign bit: all C shifts/conversions stay representable in WORD. */
+#define ___WRITE_AUTHORITY_MAX_GENERATION \
+  ((___CAST(___UWORD,1)<<(___WORD_WIDTH-26))-1)
+
+/* All APIs require a live VM/storage borrow.  Tokens do not extend VM lifetime.
+ * Actor identities 1..255 are exclusive, pre-registered activation identities,
+ * not processor ids.  Their registration and root lifetime are separate work.
+ * Prepare and retain the candidate in stable storage BEFORE try_handoff.  A
+ * lost response can then be queried without repeating Scheme/native effects.
+ * REPLAY only observes the current tag; it grants no second initialization.
+ * STALE says nothing about past result delivery; retain the external journal.
+ */
+extern void ___write_authority_init ___P((___write_authority *scope), ());
+extern ___WORD ___write_authority_snapshot ___P((___write_authority *scope), ());
+extern int ___write_authority_prepare
+  ___P((___WORD previous, unsigned int actor, ___WORD *candidate), ());
+extern int ___write_authority_try_handoff
+  ___P((___write_authority *scope, ___WORD previous, ___WORD candidate), ());
+extern int ___write_authority_try_acquire
+  ___P((___write_authority *scope, ___WORD tag, unsigned int role), ());
+extern int ___write_authority_close
+  ___P((___write_authority *scope, ___WORD tag), ());
+extern int ___write_authority_release
+  ___P((___write_authority *scope, ___WORD tag, unsigned int role), ());
+extern int ___write_authority_class_quiescent
+  ___P((___write_authority *scope, ___WORD tag, unsigned int first_role), ());
+extern int ___write_authority_quiescent
+  ___P((___write_authority *scope, ___WORD tag), ());
+
+/* Initialization is exclusive, before VM publication, never concurrent reset. */
+extern void ___write_authority_init_vmstate
+  ___P((___virtual_machine_state vms), ());
+
+#endif
