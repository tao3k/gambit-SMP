+  ;; Decoded slot order still owes reconstruction to the semantic index owner.
+  (macro-gc-hash-table-flags-set!
+   gcht
+   (##fxior flags
+            (##fx+ (macro-gc-hash-table-flag-key-moved)
+                   (macro-gc-hash-table-flag-need-rehash))))
