+  ___ps=secondary;
+  rc=___alloc_rc(___PSP 0);
+  REQUIRE(rc && ___borrow_rc_root(secondary,rc),14);
+  REQUIRE(!___cleanup_vmstate(extra) && extra->lifecycle==___VM_LIVE,15);
