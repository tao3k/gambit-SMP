new file mode 100644
index 0000000000000000000000000000000000000000..4f47479e30ffa8630d4def66d32f70446e341265
--- /dev/null
+++ b/tests/ordered-sync.c
@@ -0,0 +1,97 @@
+/* Exercise the actual word, ticket and sync-slot service, not a copied lock.
+ * Finite native observations do not prove all weak-memory executions. */
+#include <stdio.h>
+#include <pthread.h>
+#include "gambit.h"
+#define CHECK(x) do { if (!(x)) { fprintf(stderr,"ordered-sync:%d: %s\n",__LINE__,#x); return 1; } } while (0)
+#define ROUNDS 4096
+static ___TICKETLOCK lock = ___TICKETLOCK_INIT_STATIC;
+static ___WORD count, complement;
+static int bad;
+static ___sync_slot slot;
+struct prior_sync_pair_layout { int id; ___sync_op_struct payload; };
+static pthread_mutex_t gate = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t changed = PTHREAD_COND_INITIALIZER;
+static int ready, go;
+static void *locker(void *unused)
+{
+  int i;
+  pthread_mutex_lock(&gate);
+  ready++;
+  pthread_cond_broadcast(&changed);
+  while (!go) pthread_cond_wait(&changed,&gate);
+  pthread_mutex_unlock(&gate);
+  for (i=0;i<ROUNDS;i++)
+    {
+      ___TICKETLOCK_LOCK(lock);
+      if (complement != ~count) bad = 1;
+      count++;
+      complement = ~count;
+      ___TICKETLOCK_UNLOCK(lock);
+    }
+  return 0;
+}
+static void *publisher(void *unused)
+{
+  ___sync_op_struct op;
+  int i;
+  for (i=0;i<4*ROUNDS;i++)
+    {
+      while (___SYNC_SLOT_STATE(&slot) != ___SYNC_SLOT_EMPTY) ___CPU_RELAX();
+      op.op = 12;
+      op.arg[0] = i;
+      op.arg[1] = ~op.arg[0];
+      ___SYNC_SLOT_PUBLISH(&slot,op,i);
+    }
+  return 0;
+}
+static void *consumer(void *unused)
+{
+  ___sync_op_struct op;
+  ___WORD id;
+  int i;
+  for (i=0;i<4*ROUNDS;i++)
+    {
+      while (___SYNC_SLOT_STATE(&slot) == ___SYNC_SLOT_EMPTY) ___CPU_RELAX();
+      ___SYNC_SLOT_READ(&slot,op,id);
+      if (id != i || op.op != 12 || op.arg[0] != i || op.arg[1] != ~op.arg[0]) bad = 1;
+      /* Reuse permission follows the full payload read, not just id capture. */
+      ___SYNC_SLOT_ACK(&slot);
+    }
+  return 0;
+}
+int main(void)
+{
+  pthread_t workers[4], producer, reader;
+  ___WORD ___temp;
+  int i;
+  complement = ~count;
+  for (i=0;i<4;i++) CHECK(pthread_create(&workers[i],0,locker,0)==0);
+  pthread_mutex_lock(&gate);
+  while (ready!=4) pthread_cond_wait(&changed,&gate);
+  go=1;
+  pthread_cond_broadcast(&changed);
+  pthread_mutex_unlock(&gate);
+  for (i=0;i<4;i++) CHECK(pthread_join(workers[i],0)==0);
+  CHECK(!bad && count==4*ROUNDS && complement==~count);
+  ___TICKETLOCK_LOCK(lock);
+  CHECK(!___TICKETLOCK_TRYLOCK2(lock.next_ticket,lock.current_ticket,___temp));
+  ___TICKETLOCK_UNLOCK(lock);
+  CHECK(___TICKETLOCK_TRYLOCK2(lock.next_ticket,lock.current_ticket,___temp));
+  ___TICKETLOCK_UNLOCK(lock);
+  /* Last encoded ticket wraps modulo the word, retaining the tag bits. */
+  lock.current_ticket=lock.next_ticket=___CAST(___WORD,~___CAST(___UWORD,___FIX(1)-1));
+  ___TICKETLOCK_LOCK(lock);
+  ___TICKETLOCK_UNLOCK(lock);
+  CHECK(___WORD_LOAD_ACQUIRE(&lock.current_ticket)==0 && ___WORD_LOAD_ACQUIRE(&lock.next_ticket)==0);
+  ___SYNC_SLOT_INIT(&slot);
+  CHECK(pthread_create(&producer,0,publisher,0)==0);
+  CHECK(pthread_create(&reader,0,consumer,0)==0);
+  CHECK(pthread_join(producer,0)==0 && pthread_join(reader,0)==0);
+  CHECK(!bad && ___SYNC_SLOT_STATE(&slot)==___SYNC_SLOT_EMPTY);
+  puts("ORDERED-SYNC-PASS locks=16384 slots=16384 trylock=2 wrap=1");
+  printf("ORDERED-SYNC-LAYOUT word=%d slot=%lu prior-pair=%lu\n",
+    ___WORD_WIDTH,(unsigned long)sizeof(___sync_slot),
+    (unsigned long)sizeof(struct prior_sync_pair_layout));
+  return 0;
+}
