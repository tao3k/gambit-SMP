index 0000000000000000000000000000000000000000..545287065c0b41570d9ae91dfac6fc0095a17297
--- /dev/null
+++ b/lib/_setup/vm-registry.inc
@@ -0,0 +1,133 @@
+___EXP_FUNC(void,___raise_interrupt_pstate)
+  ___P((___processor_state ps, int code), ());
+___EXP_FUNC(void,___raise_interrupt_vmstate)
+  ___P((___virtual_machine_state vm, int code), ());
+
+/* Async signal qualification requires the native full-word atomic backend.
+ * Emulated CAS backends need a separate signal adapter and are not admitted by
+ * the Darwin/GCC controls. Registry visibility and lifetime share one admission
+ * word. Signal readers
+ * never wait for an interrupted mutator. Exclusive setup/retirement/shutdown
+ * succeeds only with no readers; busy is a refusal, not a guessed stop seal. */
+#define ___VM_SETUP_GATE 1
+#define ___VM_SETUP_ACTLOG 2
+#define ___VM_SETUP_MEMORY 4
+#define ___VM_SETUP_PROCESSOR_STARTED 8
+#define ___VM_SETUP_PROCESSOR 16
+
+static void vm_registry_flush_interrupts (void);
+
+static int vm_registry_try_write (void)
+{
+  return ___gc_cas(&___GSTATE->vm_registry,___VM_REGISTRY_OPEN,
+                  ___VM_REGISTRY_WRITER) == ___VM_REGISTRY_OPEN;
+}
+
+static int vm_registry_borrow (void)
+{
+  ___WORD old = ___gc_atomic_load(&___GSTATE->vm_registry);
+  for (;;)
+    {
+      ___WORD found;
+      if ((old & 3) != ___VM_REGISTRY_OPEN || old > ___MAX_FIX-4) return 0;
+      found = ___gc_cas(&___GSTATE->vm_registry,old,old+___VM_REGISTRY_READER);
+      if (found == old) return 1;
+      old = found;
+    }
+}
+
+static void vm_registry_return (void)
+{
+  ___WORD old = ___gc_atomic_load(&___GSTATE->vm_registry);
+  while (___gc_cas(&___GSTATE->vm_registry,old,old-___VM_REGISTRY_READER) != old)
+    old = ___gc_atomic_load(&___GSTATE->vm_registry);
+}
+
+static void vm_registry_open (void)
+{
+  ___WORD_STORE_RELEASE(&___GSTATE->vm_registry,___VM_REGISTRY_OPEN);
+  vm_registry_flush_interrupts();
+}
+
+static void vm_registry_closed (void)
+{ ___WORD_STORE_RELEASE(&___GSTATE->vm_registry,___VM_REGISTRY_CLOSED); }
+
+static void vm_registry_flush_interrupts (void)
+{
+  ___WORD bits;
+  int code;
+  ___virtual_machine_state vm = &___GSTATE->vmstate0;
+  if (!vm_registry_borrow()) return;
+#ifdef ___SINGLE_THREADED_VMS
+  bits = ___GSTATE->vm_pending_interrupts;
+  ___GSTATE->vm_pending_interrupts = 0;
+#else
+  bits = ___FETCH_AND_CLEAR_WORD(&___GSTATE->vm_pending_interrupts);
+#endif
+  for (code=0; code<___NB_INTRS; code++)
+    if (bits & (___CAST(___WORD,1)<<code))
+      {
+        if (code == ___INTR_USER)
+          {
+            if (___gc_atomic_load(&vm->lifecycle) == ___VM_LIVE)
+              ___raise_interrupt_pstate(___PSTATE_FROM_PROCESSOR_ID(0,vm),code);
+          }
+        else
+          {
+            ___virtual_machine_state cursor = vm;
+            do {
+              if (___gc_atomic_load(&cursor->lifecycle) == ___VM_LIVE)
+                ___raise_interrupt_vmstate(cursor,code);
+#ifndef ___SINGLE_VM
+              cursor = cursor->next;
+#endif
+            } while (cursor != vm);
+          }
+      }
+  vm_registry_return();
+}
+
+static void vm_registry_interrupt (int code)
+{
+  ___WORD old, next;
+  if (code<0 || code>=___NB_INTRS) return;
+  old = ___gc_atomic_load(&___GSTATE->vm_pending_interrupts);
+  do {
+    next = old | (___CAST(___WORD,1)<<code);
+    if (___gc_cas(&___GSTATE->vm_pending_interrupts,old,next) == old) break;
+    old = ___gc_atomic_load(&___GSTATE->vm_pending_interrupts);
+  } while (1);
+  vm_registry_flush_interrupts();
+}
+
+/* Only the exclusive registry owner follows or edits these links. Failed
+ * constructors with unknown teardown remain linked, so they deny global free. */
+static int vm_registry_contains (___virtual_machine_state vm)
+{
+  ___virtual_machine_state cursor = &___GSTATE->vmstate0;
+  do {
+    if (cursor == vm) return 1;
+#ifndef ___SINGLE_VM
+    cursor = cursor->next;
+#endif
+  } while (cursor != &___GSTATE->vmstate0);
+  return 0;
+}
+
+static void vm_registry_publish (___virtual_machine_state vm)
+{
+#ifndef ___SINGLE_VM
+  ___virtual_machine_state head = &___GSTATE->vmstate0;
+  vm->prev = head->prev; vm->next = head;
+  head->prev->next = vm; head->prev = vm;
+#endif
+}
+
+static void vm_registry_remove (___virtual_machine_state vm)
+{
+#ifndef ___SINGLE_VM
+  vm->next->prev = vm->prev; vm->prev->next = vm->next;
+  vm->next = vm; vm->prev = vm;
+#endif
+  ___WORD_STORE_RELEASE(&vm->lifecycle,___VM_CLOSED);
+}
