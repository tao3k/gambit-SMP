diff --git a/include/_gambit/synchronization.h.in b/include/_gambit/synchronization.h.in
new file mode 100644
index 0000000000000000000000000000000000000000..eb74b21f39b5051c645e29e5343f25bdfed5336d
--- /dev/null
+++ b/include/_gambit/synchronization.h.in
@@ -0,0 +1,28 @@
+/* For implementation of on_all_processors */
+
+typedef struct ___sync_op_struct
+  {
+    unsigned char op; /* owned locally or by one published sync slot */
+    ___WORD arg[2];
+  } ___sync_op_struct;
+
+/* Single-producer/single-consumer edge in the collective tree. Empty is an
+ * explicit reuse acknowledgement, published only after the payload copy.
+ * The wakeup mutex owns waiting; this ordered stamp owns payload visibility. */
+typedef struct ___sync_slot_struct
+  {
+    ___VOLATILE ___WORD stamp;
+    ___sync_op_struct payload;
+  } ___sync_slot;
+
+#define ___SYNC_SLOT_EMPTY ___CAST(___WORD,-1)
+/* Exclusive construction, before publication: never RMW uninitialized storage
+ * on the conservative backend. Concurrent reuse goes through ACK instead. */
+#define ___SYNC_SLOT_INIT(s) ((s)->stamp = ___SYNC_SLOT_EMPTY)
+#define ___SYNC_SLOT_STATE(s) ___WORD_LOAD_ACQUIRE(&(s)->stamp)
+#define ___SYNC_SLOT_PUBLISH(s,op,id) \
+do { (s)->payload = (op); ___WORD_STORE_RELEASE(&(s)->stamp,id); } while (0)
+#define ___SYNC_SLOT_READ(s,op,id) \
+do { (id) = ___SYNC_SLOT_STATE(s); (op) = (s)->payload; } while (0)
+#define ___SYNC_SLOT_ACK(s) ___WORD_STORE_RELEASE(&(s)->stamp,___SYNC_SLOT_EMPTY)
+
diff --git a/include/_gambit/temporary_roots.h.in b/include/_gambit/temporary_roots.h.in
new file mode 100644
index 0000000000000000000000000000000000000000..fba3698653728ff90c127ff4f6bd26a64ef93cc3
--- /dev/null
+++ b/include/_gambit/temporary_roots.h.in
@@ -0,0 +1,31 @@
+/*---------------------------------------------------------------------------*/
+
+/* These temporary roots belong to the execution context scanned by
+ * mark_execution_roots, not to the carrier executing the allocation. */
+#define ___GC_SAVE1(ps,a) \
+((ps)->context->saved[0] = (a))
+
+#define ___GC_RESTORE1(ps,a) \
+(a = (ps)->context->saved[0], \
+ ___GC_SAVE1(ps,___VOID))
+
+#define ___GC_SAVE2(ps,a,b) \
+((ps)->context->saved[0] = (a), \
+ (ps)->context->saved[1] = (b))
+
+#define ___GC_RESTORE2(ps,a,b) \
+(a = (ps)->context->saved[0], \
+ b = (ps)->context->saved[1], \
+ ___GC_SAVE2(ps,___VOID,___VOID))
+
+#define ___GC_SAVE3(ps,a,b,c) \
+((ps)->context->saved[0] = (a), \
+ (ps)->context->saved[1] = (b), \
+ (ps)->context->saved[2] = (c))
+
+#define ___GC_RESTORE3(ps,a,b,c) \
+(a = (ps)->context->saved[0], \
+ b = (ps)->context->saved[1], \
+ c = (ps)->context->saved[2], \
+ ___GC_SAVE3(ps,___VOID,___VOID,___VOID))
+
