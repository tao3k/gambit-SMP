+  REQUIRE(registry_hold(),6); held=1;
+  REQUIRE(pthread_create(&thread,NULL,try_setup,rejected)==0,7);
+  REQUIRE(pthread_join(thread,NULL)==0,8);
+  REQUIRE(denied_setup!=___FIX(___NO_ERR) && rejected->processor_count==0,9);
