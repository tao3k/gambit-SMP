+/*---------------------------------------------------------------------------*/
+
+/*
+ * Thread system inlined operations.
+ */
+
+#ifdef ___USE_POSIX_THREAD_SYSTEM
+
+#ifndef ___DONT_HAVE_PTHREAD_H
