+  REQUIRE(!___cleanup() && ___GSTATE->setup_state==1 && ___GSTATE->symbol_table==symbols,27);
+  REQUIRE(___setup_vmstate(rejected)==___FIX(___NO_ERR),28);
+  ___thread_set_pstate(___PSTATE_FROM_PROCESSOR_ID(0,rejected));
