+  push:
+    branches:
+    - modern-c
+  workflow_dispatch: {}
+permissions:
+  contents: read
+env:
+  HOMEBREW_NO_AUTO_UPDATE: '1'
+jobs:
+  smp:
+    runs-on: macos-15
+    timeout-minutes: 30
+    steps:
+    - uses: actions/checkout@v4
+      with:
+        fetch-depth: 0
+    - name: Install the declared native tools
+      run: |
+        brew install gcc autoconf automake pkgconf texinfo coreutils
+        program="${GAMBIT_SMP_SHASUM:-$(type -P shasum)}"
+        test -f "$program" && test -x "$program"
+        printf 'GAMBIT_SMP_SHASUM=%s\n' "$program" >> "$GITHUB_ENV"
+        program="${GAMBIT_SMP_CC:-$(type -P gcc-16)}"
+        test -f "$program" && test -x "$program"
+        printf 'GAMBIT_SMP_CC=%s\n' "$program" >> "$GITHUB_ENV"
+        program="${GAMBIT_SMP_TIMEOUT:-$(type -P gtimeout)}"
+        test -f "$program" && test -x "$program"
+        printf 'GAMBIT_SMP_TIMEOUT=%s\n' "$program" >> "$GITHUB_ENV"
+        program="${GAMBIT_SMP_MAKE:-$(type -P make)}"
+        test -f "$program" && test -x "$program"
+        printf 'GAMBIT_SMP_MAKE=%s\n' "$program" >> "$GITHUB_ENV"
+        program="${GAMBIT_SMP_KILL:-$(type -P kill)}"
+        test -f "$program" && test -x "$program"
+        printf 'GAMBIT_SMP_KILL=%s\n' "$program" >> "$GITHUB_ENV"
+        program="${GAMBIT_SMP_XCRUN:-$(type -P xcrun)}"
+        test -f "$program" && test -x "$program"
+        printf 'GAMBIT_SMP_XCRUN=%s\n' "$program" >> "$GITHUB_ENV"
+        program="${GAMBIT_SMP_SYSCTL:-$(type -P sysctl)}"
+        test -f "$program" && test -x "$program"
+        printf 'GAMBIT_SMP_SYSCTL=%s\n' "$program" >> "$GITHUB_ENV"
+    - name: Generate configure from its source
+      run: |
+        gtimeout 30s aclocal
+        gtimeout 30s autoconf -o configure configure.ac
+    - id: seed
+      name: Build the initial Gambit interpreter using existing Make targets
+      run: |
+        mkdir -p .smp-ci/seed
+        export CC="$(greadlink -f "$GAMBIT_SMP_CC")"
+        export PATH="$(dirname "$CC"):$PATH"
+        unset SDKROOT LIBRARY_PATH CPATH GAMBOPT
+        export CFLAGS=-pipe
+        workers=$("$GAMBIT_SMP_SYSCTL" -n hw.logicalcpu)
+        workers=$((workers > 1 ? workers - 1 : 1))
+        "$GAMBIT_SMP_TIMEOUT" 150s ./configure --enable-march= --enable-single-host=0 --enable-multiple-vms --enable-smp --enable-c-opt=-O1 --enable-c-opt-rts=yes --enable-gcc-opts --enable-inline-jumps --enable-dynamic-clib --enable-trust-c-tco --enable-multiple-threaded-vms > .smp-ci/seed/configure.output 2>&1
+        "$GAMBIT_SMP_TIMEOUT" 10s "$GAMBIT_SMP_MAKE" dummy-gsc-boot > .smp-ci/seed/seed-compiler.output 2>&1
+        "$GAMBIT_SMP_TIMEOUT" --kill-after=2s 600s "$GAMBIT_SMP_MAKE" -j"$workers" GAMBOPT="p$workers" core > .smp-ci/seed/build.output 2>&1
+    - id: bootstrap
+      name: Gambit owns complete two-pass bootstrap validation
+      env:
+        GAMBIT_SMP_CASE: gambit.smp.bootstrap.two-pass
+        GAMBIT_SMP_OUT: ".smp-ci/bootstrap"
+      run: gsi/gsi -:p1,~~lib=lib,~~bin=bin,~~include=include tests/smp/suite.scm
+    - id: gambit_smp_control_callback_nonlocal_exit
