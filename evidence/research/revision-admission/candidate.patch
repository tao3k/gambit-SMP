@@ -0,0 +1,63 @@
+;;; Body template for the source-projected actual receive procedure.
+(##namespace ("gambit#tests#smp#scheduler#interleave#"
+              gate changed stage excluded? armed receiver mailbox sender
+              signal-stage await-stage handoff receive before after result))
+(define gate (make-mutex))
+(define changed (make-condition-variable))
+(define stage 0)
+(define excluded? #f)
+(define armed #f)
+(define receiver (current-thread))
+(define mailbox (##thread-mailbox-get! receiver))
+(define (signal-stage n)
+  (mutex-lock! gate) (set! stage n)
+  (condition-variable-broadcast! changed) (mutex-unlock! gate))
+(define (await-stage n)
+  (let loop ()
+    (mutex-lock! gate)
+    (if (< stage n) (begin (mutex-unlock! gate changed 5) (loop))
+        (mutex-unlock! gate))))
+(define (handoff)
+  (if armed (begin (set! armed #f) (signal-stage 1) (await-stage 2))))
+(define sender
+  (make-thread
+   (lambda ()
+     (await-stage 1)
+     (let ((mutex (macro-mailbox-mutex mailbox)))
+       (if (mutex-lock! mutex 0)
+           (begin (mutex-unlock! mutex)
+                  (thread-send receiver (vector 32 '(32 33))))
+           (set! excluded? #t)))
+     (signal-stage 2)
+     (await-stage 3)
+     (if excluded? (thread-send receiver (vector 32 '(32 33))))
+     (let loop ((i 33))
+       (if (< i 64) (begin (thread-send receiver (vector i (list i (+ i 1))))
+                          (loop (+ i 1))))))))
+(let loop ((i 0))
+  (if (< i 32) (begin (thread-send receiver (vector i (list i (+ i 1)))) (loop (+ i 1)))))
+(let loop ((i 0))
+  (if (< i 31)
+      (begin (if (not (= (vector-ref (receive #t thread-receive 5 'timeout) 0) i)) (error "prefix mismatch" i))
+             (loop (+ i 1)))))
+(define before (f64vector-ref (##process-statistics) 6))
+(thread-start! sender)
+(set! armed #t)
+(if (not (= (vector-ref (receive #t thread-receive 5 'timeout) 0) 31)) (error "handoff prefix mismatch"))
+(signal-stage 3)
+(define result (thread-receive 5 'timeout))
+(define after (f64vector-ref (##process-statistics) 6))
+(thread-join! sender)
+(if (not (= before after)) (error "GC occurred inside publication witness" before after))
+(write (list 'SOURCE-MAILBOX-INTERLEAVE 'expected 32 'observed result
+             'writer-excluded excluded? 'gc-delta (- after before))) (newline)
+(if excluded?
+    (begin
+      (if (not (equal? result (vector 32 '(32 33)))) (error "excluded writer lost message" result))
+      (let loop ((i 33))
+        (if (< i 64)
+            (let ((m (thread-receive 5 'timeout)))
+              (if (not (equal? m (vector i (list i (+ i 1))))) (error "suffix mismatch" i m))
+              (loop (+ i 1)))))
+      (display "SOURCE-MAILBOX-EXCLUSION-PASS messages=64\n"))
+    (if (not (equal? result (vector 33 '(33 34)))) (error "source counterexample did not match" result)))
