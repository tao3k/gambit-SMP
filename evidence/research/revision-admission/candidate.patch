+++ b/tests/smp/suite.scm
@@ -0,0 +1,317 @@
+(##namespace ("gambit#tests#smp#" json-write file-text now assert join-path text-contains suffix? select occurrences small-process environment-tool hash-tool sha sha-files execute-case cases))
+;;; Native Gambit test orchestration. No Python or Shell test framework.
+;;; open-process/process-status own process I/O, waiting and result delivery.
+;;; GNU timeout supplies a bounded OS process group for compiler descendants;
+;;; pseudo-terminal mode is deliberately not used to manufacture a session.
+(define (json-write x p)
+  (define (sequence xs left right emit)
+    (display left p)
+    (let loop ((xs xs) (first? #t))
+      (if (pair? xs)
+          (begin (if (not first?) (display "," p))
+                 (emit (car xs)) (loop (cdr xs) #f))))
+    (display right p))
+  (cond ((string? x)
+         (write-char #\" p)
+         (string-for-each
+          (lambda (c)
+            (cond ((char=? c #\") (display "\\\"" p))
+                  ((char=? c #\\) (display "\\\\" p))
+                  ((char=? c #\newline) (display "\\n" p))
+                  ((char=? c #\return) (display "\\r" p))
+                  ((char=? c #\tab) (display "\\t" p))
+                  ((< (char->integer c) 32)
+                   (let ((s (number->string (char->integer c) 16)))
+                     (display "\\u" p) (display (make-string (- 4 (string-length s)) #\0) p)
+                     (display s p)))
+                  (else (write-char c p)))) x)
+         (write-char #\" p))
+        ((eq? x #t) (display "true" p))
+        ((eq? x #f) (display "false" p))
+        ;; Gambit may print finite flonums as .5 or 30.; JSON requires a digit
+        ;; on both sides of a decimal point. Receipt numbers are finite real
+        ;; clocks, budgets, statuses and integer counts, never Scheme ratios.
+        ((number? x)
+         (let loop ((cs (string->list (number->string x))) (previous #f))
+           (if (pair? cs)
+               (let ((c (car cs)))
+                 (if (char=? c #\.)
+                     (begin
+                       (if (or (not previous) (char=? previous #\-)) (display "0" p))
+                       (display "." p)
+                       (if (or (null? (cdr cs)) (not (char-numeric? (cadr cs)))) (display "0" p)))
+                     (write-char c p))
+                 (loop (cdr cs) c)))))
+        ((vector? x) (sequence (vector->list x) "[" "]" (lambda (v) (json-write v p))))
+        ((list? x) (sequence x "{" "}"
+                    (lambda (kv) (json-write (car kv) p) (display ":" p)
+                                 (json-write (cdr kv) p))))
+        (else (error "unsupported receipt value" x))))
+
+(define (file-text path) (call-with-input-file path (lambda (p) (read-line p #f))))
+(define (now) (time->seconds (current-time)))
+(define (assert p . context) (if (not p) (apply error context)))
+(define (join-path a b) (path-expand b (string-append a "/")))
+(define (text-contains text piece)
+  (let loop ((i 0))
+    (and (<= (+ i (string-length piece)) (string-length text))
+         (or (string=? piece (substring text i (+ i (string-length piece))))
+             (loop (+ i 1))))))
+(define (suffix? text ending)
+  (and (>= (string-length text) (string-length ending))
+       (string=? ending (substring text (- (string-length text) (string-length ending)) (string-length text)))))
+(define (select pred xs)
+  (cond ((null? xs) '()) ((pred (car xs)) (cons (car xs) (select pred (cdr xs))))
+        (else (select pred (cdr xs)))))
+(define (occurrences text piece)
+  (let loop ((i 0) (n 0))
+    (if (> (+ i (string-length piece)) (string-length text)) n
+        (if (string=? piece (substring text i (+ i (string-length piece))))
+            (loop (+ i (string-length piece)) (+ n 1)) (loop (+ i 1) n)))))
+
+;; This small bounded helper is also used for sha256 and process-group probes.
+;; Exit codes are the real wait status returned by Gambit's process consumer.
+(define (small-process path args)
+  (let* ((p (open-process (list path: path arguments: args stderr-redirection: #t)))
+         (reader (make-thread (lambda () (read-line p #f)))))
+    (close-output-port p)
+    (thread-start! reader)
+    (let ((status (process-status p 10 'unknown)))
+      (assert (number? status) "OS helper result unknown" path)
+      (let ((text (thread-join! reader 2 'unknown)))
+        (assert (string? text) "OS helper output unknown" path)
+        (close-input-port p)
+        (cons status text)))))
+(define hash-tool #f)
+(define (environment-tool variable)
+  (let ((tool (getenv variable #f)))
+    (assert (and (string? tool) (file-exists? tool)
+                 (string=? (path-expand tool) tool))
+            "environment must select an existing absolute tool path" variable)
+    tool))
+(define (sha-files paths)
+  (if (null? paths) '()
+      (let ((r (small-process hash-tool (append '("-a" "256" "--") paths))))
+        (assert (= (car r) 0) "sha256 failed" paths)
+        (call-with-input-string
+         (cdr r)
+         (lambda (p)
+           (let loop ((remaining paths) (rows '()))
+             (if (null? remaining)
+                 (begin (assert (eof-object? (read-line p)) "extra sha256 output")
+                        (reverse rows))
+                 (let ((line (read-line p)))
+                   (assert (and (string? line) (>= (string-length line) 66)
+                                (string->number (substring line 0 64) 16)
+                                (string=? (substring line 64 66) "  ")
+                                (string=? (substring line 66 (string-length line)) (car remaining)))
+                           "sha256 path/output mismatch" (car remaining))
+                   (loop (cdr remaining) (cons (cons (car remaining) (substring line 0 64)) rows))))))))))
+(define (sha path) (cdar (sha-files (list path))))
+
+(define (execute-case)
+  (let* ((root (path-expand (getenv "GAMBIT_SMP_ROOT" ".")))
+         (runtime (path-expand (getenv "GAMBIT_SMP_RUNTIME" root)))
+         (out (path-expand (getenv "GAMBIT_SMP_OUT")))
+         (id (getenv "GAMBIT_SMP_CASE"))
+         (cc #f) (timeout-tool #f) (make-tool #f)
+         (kill-tool #f) (xcrun-tool #f) (sysctl-tool #f)
+         (paths (string-append ",~~lib=" runtime "/lib,~~bin=" runtime "/bin,~~include=" runtime "/include"))
+         (commands '()) (identity '()) (outcome "FAIL") (started (now))
+         (deadline #f) (workers 1))
+    (define (add k v) (set! identity (cons (cons k v) identity)))
+    (define (check-source-hashes hashes)
+      (let ((actual (sha-files (map (lambda (row) (join-path runtime (car row))) hashes))))
+        (for-each (lambda (expected observed)
+                    (assert (equal? (cdr expected) (cdr observed)) "runtime source drift" (car expected)))
+                  hashes actual)))
+    (define (command name argv cap cwd)
+      (let* ((budget (if deadline (min cap (- deadline (now))) cap))
+             (output (join-path out (string-append name ".output")))
+             (start (now)))
+        (assert (> budget 0) "module deadline exhausted" id)
+        (let* ((p (open-process
+                   (list path: timeout-tool
+                         arguments: (append (list "--kill-after=2s" (number->string budget)) argv)
+                         directory: cwd stderr-redirection: #t)))
+               (pid (process-pid p))
+               (reader (make-thread
+                        (lambda ()
+                          (call-with-output-file output
+                            (lambda (log)
+                              (let loop ((b (read-u8 p)))
+                                (if (not (eof-object? b))
+                                    (begin (write-u8 b log) (loop (read-u8 p)))))))))))
+          (close-output-port p)
+          (thread-start! reader)
+          (let* ((status (process-status p (+ budget 3) 'unknown))
+                 (group (small-process kill-tool (list "-0" "--" (number->string (- pid)))))
+                 (quiet (= (car group) 256)))
+            (if (not quiet)
+                (small-process kill-tool (list "-KILL" "--" (number->string (- pid)))))
+            (let ((read-result (thread-join! reader 2 'unknown)))
+              (close-input-port p)
+              (set! commands
+                (cons (list (cons "stage" name) (cons "argv" (list->vector argv))
+                            (cons "cwd" cwd) (cons "budget" budget)
+                            (cons "rawWaitStatus" (if (number? status) status -1))
+                            (cons "exit" (if (number? status)
+                                             (if (= (modulo status 256) 0) (quotient status 256)
+                                                 (+ 128 (modulo status 128))) -1))
+                            (cons "timeout" (or (eq? status 'unknown) (and (memv status '(31744 35072)) #t)))
+                            (cons "parentReaped" (number? status))
+                            (cons "processGroupQuiescent" quiet)
+                            (cons "seconds" (- (now) start))
+                            (cons "output" (string-append name ".output"))
+                            (cons "outputSha256" (sha output))) commands))
+              (assert (and (number? status) (= status 0) quiet
+                           (not (eq? read-result 'unknown))) "command failed or unknown" name status)
+              (file-text output))))))
+    (create-directory out)
+    (with-exception-catcher
+     (lambda (e) (add "error" (call-with-output-string (lambda (p) (display-exception e p)))))
+     (lambda ()
+       (set! hash-tool (environment-tool "GAMBIT_SMP_SHASUM"))
+       (set! cc (environment-tool "GAMBIT_SMP_CC"))
+       (set! timeout-tool (environment-tool "GAMBIT_SMP_TIMEOUT"))
+       (set! make-tool (environment-tool "GAMBIT_SMP_MAKE"))
+       (set! kill-tool (environment-tool "GAMBIT_SMP_KILL"))
+       (set! xcrun-tool (environment-tool "GAMBIT_SMP_XCRUN"))
+       (set! sysctl-tool (environment-tool "GAMBIT_SMP_SYSCTL"))
+       (add "shasum" hash-tool) (add "shasumSha256" (sha hash-tool))
+       (let* ((selected (list (cons "cc" cc) (cons "timeout" timeout-tool)
+                              (cons "make" make-tool) (cons "kill" kill-tool)
+                              (cons "xcrun" xcrun-tool) (cons "sysctl" sysctl-tool)))
+              (hashes (sha-files (map cdr selected))))
+         (add "tools" (list->vector
+           (map (lambda (tool digest)
+                  (list (cons "name" (car tool)) (cons "path" (cdr tool))
+                        (cons "sha256" (cdr digest)))) selected hashes))))
+       (for-each (lambda (k) (setenv k))
+                 '("SDKROOT" "LIBRARY_PATH" "CPATH" "GAMBOPT" "GERBIL_HOME" "GERBIL_LOADPATH" "GERBIL_GSC"))
+       (let ((tool-dirs ""))
+         (for-each
+              (lambda (tool)
+                (let* ((found (small-process xcrun-tool (list "--find" tool)))
+                       (path (call-with-input-string (cdr found) (lambda (p) (read-line p)))))
+                  (assert (and (= (car found) 0) (string? path) (file-exists? path))
+                          "developer tool unavailable" tool)
+                  (add tool path) (add (string-append tool "Sha256") (sha path))
+                  (set! tool-dirs (string-append tool-dirs ":" (path-directory path)))))
+              '("as" "ld"))
+         (setenv "PATH" (string-append (path-directory cc) tool-dirs ":" (getenv "PATH" ""))))
+       (setenv "CC" cc)
+       (load (join-path root "tests/smp/catalog.scm"))
+       (add "module" id)
+       (add "runnerSha256" (sha (join-path root "tests/smp/suite.scm")))
+       (add "planSha256" (sha (join-path root "tests/smp/catalog.scm")))
+       (set! workers (max 1 (- (call-with-input-string
+                                (cdr (small-process sysctl-tool '("-n" "hw.logicalcpu"))) read) 1)))
+       (add "compilerProcessors" workers)
+       (setenv "GAMBOPT" (string-append "p" (number->string workers) paths))
+       (if (string=? id "gambit.smp.bootstrap.two-pass")
+        (begin
+         (add "namespace" "gambit.smp.bootstrap") (add "name" "two-pass")
+         (assert (equal? root runtime) "bootstrap must build this checkout")
+         (let* ((all-files (apply append
+                            (map (lambda (d) (map (lambda (p) (string-append d "/" p))
+                                                   (directory-files (join-path root d))))
+                                 '("lib" "gsi" "gsc"))))
+                (schemes (select (lambda (p) (suffix? p ".scm")) all-files))
+                (generated (select (lambda (p) (and (suffix? p ".c")
+                                                    (char=? (string-ref (path-strip-directory p) 0) #\_))) all-files))
+                (before (map cons schemes (map cdr (sha-files (map (lambda (p) (join-path root p)) schemes)))))
+                (generated-before (map cons generated (map cdr (sha-files (map (lambda (p) (join-path root p)) generated)))))
+                (configured (select (lambda (p) (or (suffix? p ".unix") (suffix? p ".bat.windows")))
+                                    (directory-files (join-path root "bin"))))
+                (tools-before (sha-files (map (lambda (p) (join-path root (string-append "bin/" p))) configured)))
+                (boot (join-path root "gsc-boot")))
+           (assert (pair? generated) "no generated C inventory")
+           (if (file-exists? boot) (delete-file boot))
+           (copy-file (join-path root "gsc/gsc") boot)
+           (command "bootclean" (list make-tool "bootclean") 10 root)
+           (for-each (lambda (p) (assert (not (file-exists? (join-path root p))) "generated C survived bootclean" p)) generated)
+           (let* ((log (command "bootstrap" (list make-tool (string-append "-j" (number->string workers))
+                                                  (string-append "GAMBOPT=p" (number->string workers)) "from-scratch") 600 root))
+                  (phases (map (lambda (p) (cons p (occurrences log (string-append "*** making " p "\n")))) '("phase1" "phase2" "phase3" "phase4"))))
+             (for-each (lambda (p) (assert (= (cdr p) 2) "incomplete two-pass bootstrap" p)) phases)
+             (add "phaseCounts" phases))
+           (for-each (lambda (p) (assert (file-exists? (join-path root p)) "generated C missing" p)) generated)
+           (let ((after (map cons schemes (map cdr (sha-files (map (lambda (p) (join-path root p)) schemes))))))
+             (assert (equal? before after) "Scheme source changed"))
+           (assert (equal? tools-before
+                           (sha-files (map (lambda (p) (join-path root (string-append "bin/" p))) configured)))
+                   "configured tools changed during bootstrap")
+           (add "configuredToolsReused" (length configured))
+           (add "generationProcessorsPerJob" 1)
+           (add "generatedBefore" generated-before)
+           (add "generatedAfter"
+                (map cons generated (map cdr (sha-files (map (lambda (p) (join-path root p)) generated)))))
+           (add "fullTwoPassBootstrapEstablished" #t)
+           (set! outcome "PASS")))
+       (let* ((case (assoc id cases))
+              (kind (cadr case)) (program (caddr case))
+              (expected (list-ref case 3)) (topology (list-ref case 4))
+              (source (join-path root program))
+              (files (append '("include/gambit.h.in" "lib/mem.c"
+                               "lib/_thread.scm" "lib/_thread#.scm" "lib/_fifo#.scm"
+                               "lib/setup.c" "lib/setup.h" "lib/os_thread.c"
+                               "lib/write_authority.c" "lib/write_authority.h"
+                               "tests/write-authority.c")
+                             (map (lambda (p) (string-append "lib/_setup/" p))
+                                  (directory-files (join-path root "lib/_setup")))
+                             (map (lambda (p) (string-append "lib/_mem/" p))
+                                  (directory-files (join-path root "lib/_mem")))
+                             (map (lambda (p) (string-append "include/_gambit/" p))
+                                  (directory-files (join-path root "include/_gambit")))))
+              (source-hashes (map cons files (map cdr (sha-files (map (lambda (f) (join-path root f)) files))))))
+         (add "namespace" (list-ref case 6)) (add "name" (list-ref case 7)) (add "program" program) (add "programSha256" (sha source))
+         (add "runtimeSource" source-hashes)
+         (add "compiler" cc) (add "compilerSha256" (sha cc))
+         (check-source-hashes source-hashes)
+         (set! deadline (+ (now) (list-ref case 5)))
+         (setenv "GAMBOPT" (string-append "p" (number->string workers) paths))
+         (cond
+          ((string=? kind "kernel")
+           (command "compile" (list cc "-std=c23" "-O1" "-pthread" "-DHAVE_CONFIG_H" "-I" (join-path runtime "include") "-I" (join-path runtime "lib") source "-o" (join-path out "kernel")) 30 runtime)
+           (let ((text (command "run" (list (join-path out "kernel")) 10 out)))
+             (if (string=? id "gambit.smp.runtime.roles.storage-layout")
+                 (assert (and (text-contains text "RUNTIME-ROLES-STORAGE-PASS word=")
+                              (text-contains text " context=") (text-contains text " vm=")) "invalid storage result")
+                 (assert (equal? expected text) "kernel result mismatch" text))))
+          ((string=? kind "make")
+           (command "unchanged" (list make-tool "-q" "mem.o") 10 (join-path runtime "lib"))
+           (let ((fragments (directory-files (join-path runtime "lib/_mem"))))
+             (assert (= (length fragments) 25) "incomplete memory inventory")
+             (for-each
+              (lambda (f)
+                (assert (text-contains
+                         (command (string-append "fragment-" f)
+                                  (list make-tool "-n" "-W" (string-append "_mem/" f) "mem.o")
+                                  10 (join-path runtime "lib")) "mem.c") "fragment does not invalidate mem.o" f)) fragments)))
+          ((or (string=? kind "scheme") (string=? kind "scheme-host"))
+           (let ((input (join-path out (if (string=? kind "scheme-host")
+                                         (path-strip-directory source) "fixture.scm"))))
+             (copy-file source input)
+             (command "compile" (list (join-path runtime "gsc/gsc") "-exe" "-o" (join-path out "fixture") "-cc-options"
+                                     (if (string=? kind "scheme-host") "-D___LIBRARY -pthread" "-pthread")
+                                     "-ld-options" "-pthread" input) 90 out))
+           (let ((population (if (string=? topology "host-managed") workers 1)))
+             (add "executionProcessors" population)
+             (setenv "GAMBOPT" (string-append "p" (number->string population) paths))
+             (setenv "GAMBIT_SMP_EXPECTED_PROCESSORS" (number->string population)))
+           (let ((text (command "run" (list (join-path out "fixture")) 30 out)))
+             (assert (equal? expected text) "Scheme result mismatch" text)))
+          (else (error "unknown module kind" kind)))
+         (check-source-hashes source-hashes)
+         (assert (equal? (sha source) (cdr (assoc "programSha256" identity))) "test source changed")
+         (set! outcome "PASS")))))
+    (call-with-output-file (join-path out "receipt.json")
+      (lambda (p) (json-write
+                  (append (list (cons "outcome" outcome) (cons "seconds" (- (now) started))
+                                (cons "commands" (list->vector (reverse commands)))
+                                (cons "wholeSmpAdmitted" #f) (cons "commitAdmitted" #f)) identity) p)
+                  (newline p)))
+    (display id) (display " ") (display outcome) (newline)
+    (exit (if (string=? outcome "PASS") 0 1))))
+(execute-case)
diff --git a/tests/vector-increment-contract.scm b/tests/vector-increment-contract.scm
new file mode 100644
index 0000000000000000000000000000000000000000..89daf7b8c309065c182b1606d0e029848a424137
--- /dev/null
+++ b/tests/vector-increment-contract.scm
@@ -0,0 +1,23 @@
+;;; Safe specialization must validate every operand before the atomic write.
+(##namespace ("gambit#tests#vector-increment#" rejects? v))
+
+(define (rejects? thunk)
+  (with-exception-catcher type-exception?
+    (lambda () (thunk) #f)))
+
+(define v (vector 12))
+(if (not (rejects? (lambda () (vector-inc! v 0 #f))))
+    (error "invalid delta reached the atomic operation"))
+(if (not (= (vector-ref v 0) 12))
+    (error "rejected delta changed the vector"))
+(vector-set! v 0 'not-a-fixnum)
+(if (not (rejects? (lambda () (vector-inc! v 0))))
+    (error "invalid old element reached the atomic operation"))
+(if (not (eq? (vector-ref v 0) 'not-a-fixnum))
+    (error "rejected old element changed the vector"))
+(vector-set! v 0 12)
+(if (not (and (= (vector-inc! v 0) 12) (= (vector-ref v 0) 13)))
+    (error "default delta or returned old value changed"))
+(if (not (and (= (vector-inc! v 0 -3) 13) (= (vector-ref v 0) 10)))
+    (error "explicit delta or returned old value changed"))
+(display "VECTOR-INCREMENT-CONTRACT-PASS\n")
diff --git a/tests/write-authority.c b/tests/write-authority.c
new file mode 100644
index 0000000000000000000000000000000000000000..bf0700a05f2436441f8574e1ebaf065f11e08ee9
--- /dev/null
+++ b/tests/write-authority.c
@@ -0,0 +1,69 @@
+/* Deterministic controls for the write-authority protocol; no Scheme execution.
+ * Link with lib/write_authority.c.  A whole-runtime/GC/SMP test is separate.
+ */
+#include <stdio.h>
+#include "gambit.h"
+#include "write_authority.h"
+
+#define CHECK(x) do { if (!(x)) { \
+  fprintf (stderr,"write-authority:%d: %s\n",__LINE__,#x); return 1; \
+} } while (0)
+
+static int check_write_authority (void)
+{
+  ___write_authority scope;
+  ___WORD a, b, c, other, exhausted, before;
+  unsigned int role;
+  ___write_authority_init (&scope);
+  CHECK(___write_authority_prepare (0,1,&a) == ___WRITE_AUTHORITY_OK);
+  CHECK(___write_authority_prepare (0,2,&other) == ___WRITE_AUTHORITY_OK);
+  CHECK(___write_authority_try_handoff (&scope,0,a) == ___WRITE_AUTHORITY_OK);
+  CHECK(___write_authority_try_handoff (&scope,0,a) == ___WRITE_AUTHORITY_REPLAY);
+  CHECK(___write_authority_try_handoff (&scope,0,other) == ___WRITE_AUTHORITY_STALE);
+  CHECK(___write_authority_try_acquire (&scope,a,1) == ___WRITE_AUTHORITY_OK);
+  CHECK(___write_authority_release (&scope,a,1) == ___WRITE_AUTHORITY_OK);
+  before = ___write_authority_snapshot (&scope);
+  CHECK(___write_authority_release (&scope,a,1) == ___WRITE_AUTHORITY_REPLAY);
+  CHECK(___write_authority_snapshot (&scope) == before);
+  CHECK(___write_authority_try_acquire (&scope,a,1) == ___WRITE_AUTHORITY_USED);
+  for (role=2; role<8; role++)
+    if (role != ___WRITE_AUTHORITY_DATA)
+      CHECK(___write_authority_try_acquire (&scope,a,role) == ___WRITE_AUTHORITY_OK);
+  CHECK(___write_authority_prepare (a,2,&b) == ___WRITE_AUTHORITY_OK);
+  CHECK(___write_authority_close (&scope,a) == ___WRITE_AUTHORITY_OK);
+  CHECK(___write_authority_try_acquire (&scope,a,2) == ___WRITE_AUTHORITY_BUSY);
+  CHECK(___write_authority_quiescent (&scope,a) == ___WRITE_AUTHORITY_BUSY);
+  CHECK(___write_authority_try_handoff (&scope,a,b) == ___WRITE_AUTHORITY_BUSY);
+  for (role=0; role<8; role++)
+    CHECK(___write_authority_release (&scope,a,role) == (role==1 ? ___WRITE_AUTHORITY_REPLAY : ___WRITE_AUTHORITY_OK));
+  CHECK(___write_authority_quiescent (&scope,a) == ___WRITE_AUTHORITY_OK);
+  CHECK(___write_authority_try_handoff (&scope,a,b) == ___WRITE_AUTHORITY_OK);
+  CHECK(___write_authority_release (&scope,a,0) == ___WRITE_AUTHORITY_STALE);
+  CHECK(___write_authority_quiescent (&scope,b) == ___WRITE_AUTHORITY_BUSY);
+  /* A second interrupted helper cannot be bypassed by old owner's closure. */
+  CHECK(___write_authority_prepare (b,3,&c) == ___WRITE_AUTHORITY_OK);
+  CHECK(___write_authority_close (&scope,b) == ___WRITE_AUTHORITY_OK);
+  CHECK(___write_authority_release (&scope,b,0) == ___WRITE_AUTHORITY_OK);
+  CHECK(___write_authority_try_handoff (&scope,b,c) == ___WRITE_AUTHORITY_BUSY);
+  CHECK(___write_authority_class_quiescent (&scope,b,0) == ___WRITE_AUTHORITY_OK);
+  CHECK(___write_authority_class_quiescent (&scope,b,4) == ___WRITE_AUTHORITY_BUSY);
+  CHECK(___write_authority_release (&scope,b,4) == ___WRITE_AUTHORITY_OK);
+  CHECK(___write_authority_try_handoff (&scope,b,c) == ___WRITE_AUTHORITY_OK);
+  CHECK(___write_authority_prepare (c,0,&a) == ___WRITE_AUTHORITY_INVALID);
+  CHECK(___write_authority_prepare (c,256,&a) == ___WRITE_AUTHORITY_INVALID);
+  CHECK(___write_authority_try_acquire (&scope,c,8) == ___WRITE_AUTHORITY_INVALID);
+  CHECK(___write_authority_release (&scope,c,7) == ___WRITE_AUTHORITY_INVALID);
+  exhausted = ___CAST(___WORD,___WRITE_AUTHORITY_MAX_GENERATION <<
+                                ___WRITE_AUTHORITY_GENERATION_SHIFT) |
+              (___CAST(___WORD,1)<<___WRITE_AUTHORITY_ACTOR_SHIFT);
+  CHECK(___write_authority_prepare (exhausted,1,&a) == ___WRITE_AUTHORITY_EXHAUSTED);
+  puts ("write-authority controls passed");
+  return 0;
+}
+
+#ifndef ___TEST_WRITE_AUTHORITY_EMBEDDED
+int main (void)
+{
+  return check_write_authority ();
+}
+#endif
