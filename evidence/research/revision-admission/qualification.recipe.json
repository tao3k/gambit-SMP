{
  "schema": "evidence-recipe.v2",
  "id": "modern-c-contract-qualification",
  "scope": "Reusable selected source-contract controls through existing capabilities. No original-inventory, native failure-review, complete REV or commit admission is claimed. Actual whole original GSI/GSC qualification remains a separate required path.",
  "workspacePolicy": "in-place",
  "timeoutPolicy": {
    "mode": "per-stage",
    "overheadSeconds": 30
  },
  "inputs": [
    "evidence/dsl/execution.ss",
    "evidence/research/execution/entry.json",
    "evidence/research/revision-admission/reconstruction-bootstrap-producer.json",
    "evidence/research/revision-admission/reconstruction-source.lock.json",
    "vendor/gambit/tests/frame-continuation.scm",
    "vendor/gambit/tests/hash-construction-roots.scm",
    "vendor/gambit/tests/vector-increment-contract.scm"
  ],
  "steps": [
    {
      "id": "producer",
      "capability": "gambit.generation-artifact",
      "dependsOn": [],
      "budgetSeconds": 45,
      "arguments": {
        "producer": "evidence/research/revision-admission/reconstruction-bootstrap-producer.json",
        "sourceLock": "evidence/research/revision-admission/reconstruction-source.lock.json"
      }
    },
    {
      "id": "map",
      "capability": "gambit.executable-test",
      "dependsOn": [
        "producer"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "runtime": {
          "step": "producer",
          "output": "runtime"
        },
        "identity": {
          "step": "producer",
          "output": "identity"
        },
        "program": "vendor/gambit/tests/frame-continuation.scm",
        "stdout": "FRAME-CONTINUATION-PASS\nHASH-INDEX-OWNER-PASS\n",
        "executionBudgetSeconds": 30
      }
    },
    {
      "id": "construction-roots",
      "capability": "gambit.executable-test",
      "dependsOn": [
        "producer"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "runtime": {
          "step": "producer",
          "output": "runtime"
        },
        "identity": {
          "step": "producer",
          "output": "identity"
        },
        "program": "vendor/gambit/tests/hash-construction-roots.scm",
        "stdout": "HASH-CONSTRUCTION-ROOTS-PASS\n",
        "executionBudgetSeconds": 30
      }
    },
    {
      "id": "checked-increment",
      "capability": "gambit.executable-test",
      "dependsOn": [
        "producer"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "runtime": {
          "step": "producer",
          "output": "runtime"
        },
        "identity": {
          "step": "producer",
          "output": "identity"
        },
        "program": "vendor/gambit/tests/vector-increment-contract.scm",
        "stdout": "VECTOR-INCREMENT-CONTRACT-PASS\n",
        "executionBudgetSeconds": 30
      }
    },
    {
      "id": "verdict",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "producer",
        "map",
        "construction-roots",
        "checked-increment"
      ],
      "budgetSeconds": 10,
      "arguments": {
        "dsl": "evidence/research/execution/entry.json",
        "queries": {
          "checked": "checked_step",
          "missing": "missing_step"
        },
        "expected": {
          "missing": []
        },
        "recordedQueries": [
          "checked"
        ]
      }
    }
  ]
}
