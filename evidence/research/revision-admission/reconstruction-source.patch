-___EXP_FUNC(void,___register_rc)
-   ___P((___PSD
-         void *ptr),
-        (___PSV
-         ptr)
-___PSDKR
-void *ptr;)
-{
-  ___PSGET
-  ___rc_header *h = ___CAST(___rc_header*, ptr) - 1;
-  ___rc_header *head = &rc_head;
-  ___rc_header *tail = head->prev;
-
-  h->prev = tail;
-  h->next = head;
-  head->prev = h;
-  tail->next = h;
-}
