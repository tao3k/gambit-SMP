+                             (begin
+
+                               ;; save current thread's timeout
+                               (macro-thread-timeout-set!
+                                current-thread
+                                timeout)
+
+                               ;; add current thread to timeout queue
+                               (##toq-insert!
+                                (macro-current-processor)
+                                current-thread)))
