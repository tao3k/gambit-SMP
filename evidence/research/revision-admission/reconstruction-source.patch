-      ___msections *new_ms;
-      int i;
-
-      while (n > max_ns) /* grow max_nb_sections until big enough */
-        max_ns = 2*max_ns + 1;
-
-      new_ms = ___CAST(___msections*,
-                       alloc_mem_aligned
-                         (___WORDS(___sizeof_msections(max_ns)),
-                          1,
-                          0));
