-  body = base + ___STILL_BODY;
-
-  base[___STILL_LINK] = still_objs;
-  still_objs = ___CAST(___WORD,base);
-  base[___STILL_REFCOUNT] = 1;
-  base[___STILL_LENGTH] = words;
-
-#ifdef ___USE_HANDLES
-  base[___STILL_HANDLE] = ___CAST(___WORD,body);
-#endif
-
