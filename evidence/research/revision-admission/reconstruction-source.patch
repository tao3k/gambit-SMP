+{ ___SCMOBJ proc; \
+  ___SCMOBJ thread; \
+  ___SCMOBJ frame; \
+  ___POP_ARGS1(proc) \
+  ___THREAD_SAVE \
+  ___PUSH_ARGS1(thread) \
+  jump(___SET_NARGS(1),proc) \
+}
