{
  "schema": "evidence-recipe.v2",
  "id": "modern-c-checked-predicate-ancestry-import",
  "scope": "Existing generation-artifact consumes original native bootstrap plus requalification; no invented Recipe bootstrap and no SDK copy",
  "budgetSeconds": 120,
  "workspacePolicy": "in-place",
  "inputs": [
    "evidence/research/revision-admission/checked-predicate-source.lock.json",
    "evidence/research/revision-admission/checked-predicate-bootstrap-producer.json",
    "vendor/gambit/tests/frame-continuation.scm",
    "evidence/research/execution/entry.json",
    "evidence/dsl/execution.ss"
  ],
  "steps": [
    {
      "id": "producer",
      "capability": "gambit.generation-artifact",
      "dependsOn": [],
      "budgetSeconds": 45,
      "arguments": {
        "producer": "evidence/research/revision-admission/checked-predicate-bootstrap-producer.json",
        "sourceLock": "evidence/research/revision-admission/checked-predicate-source.lock.json"
      }
    },
    {
      "id": "map",
      "capability": "gambit.executable-test",
      "dependsOn": [
        "producer"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "runtime": {
          "step": "producer",
          "output": "runtime"
        },
        "identity": {
          "step": "producer",
          "output": "identity"
        },
        "program": "vendor/gambit/tests/frame-continuation.scm",
        "stdout": "FRAME-CONTINUATION-PASS\nHASH-INDEX-OWNER-PASS\n",
        "executionBudgetSeconds": 30
      }
    },
    {
      "id": "verdict",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "producer",
        "map"
      ],
      "budgetSeconds": 10,
      "arguments": {
        "dsl": "evidence/research/execution/entry.json",
        "queries": {
          "checked": "checked_step",
          "missing": "missing_step"
        },
        "expected": {
          "missing": []
        },
        "recordedQueries": [
          "checked"
        ]
      }
    }
  ]
}
