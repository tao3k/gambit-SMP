(define-evidence (query) (sources clue factor binding) (outputs commitMigrationMissing commitMigrationSourceObserved commitOwnershipEvidenceMissing commitBoundaryCovered commitProtocolObserved commitCovered commitScenario commitReady commitBlocked commitGateReady commitMissing commitSourceMismatch controlFailure)
(relation clue (id document claim kind owner source))
(relation factor (id document name value))
(relation binding (name value))
;; SysML owns required gates and obligations. The caller supplies observations,
;; never authority to execute Git. Missing evidence is a reason to withhold.
;; Exact candidate tree, source manifest, profile, artifact and evidence digests
;; prevent reuse across source/profile changes; hashes do not attest truth.
(relation commitStudyFact (claim) (("revision-boundary")))
(relation commitPolicyFact (digest) (("ae5149d8a18fe68e16d107f291f9b05514631d0e8356fb2b29b6d05676585c8f")))
(relation commitBoundStudy (claim))
(relation commitGateFact (gate purpose) (("tests" "All tests required by this source cut must finish with exact source and profile receipts; missing, timeout, unknown and failed results block") ("learning" "State what the architecture taught us, what it amplifies, its actual retirement and added costs; no inferred speedup") ("process" "Disclose the current refactoring stage, dependencies, remaining steps and acceptance boundary") ("models" "Native SysML projection drives ASCENT; executable QNT and conditional Lean laws must be linked to the real consumers and source-refinement frontier") ("questions" "Answer the mandatory Gambit-paper, semantic, amplification and counterexample questions within the claimed cut; unresolved mandatory answers block")))
