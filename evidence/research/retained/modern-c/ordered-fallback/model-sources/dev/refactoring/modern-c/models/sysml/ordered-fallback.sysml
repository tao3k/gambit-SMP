 part tests:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="WORD-TESTS"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/ordered-fallback/qualification.json"; attribute :>> scope="Actual parent strict negative, native/emulated Make targets, fence output/litmus and new archive SFUN/PBT consumer; identity reuse distinct."; }
 part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="WORD-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/ordered-fallback.org"; attribute :>> scope="Primitive service owns wrap and order, not an unrelated compiler flag or empty fence. Capability-test ABI isolation explicit."; }
 part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="WORD-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/ordered-fallback.org"; attribute :>> scope="Two original queued paths retire; original nine groups retain eight nonempty owners and41 paths. Shared Make future hunks remain."; }
 part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="WORD-MODELS"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/ordered-fallback/qualification.json"; attribute :>> scope="Native SDK→ASCENT seven duties/three real adapters; root QNT reused with conditional acquire premises. No duplicate Lean law."; }
 part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="WORD-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/ordered-fallback.org"; attribute :>> scope="Unsigned/signed representation, actual backend, no mixed ABI, race freedom, physical last use, no heap change and A/A cost attribution explicit."; }
