package GambitOrderedFallback {
 private import ScalarValues::*;
 attribute stage:String="ordered-word-fallback";
 attribute baseline:String="5c0ff48959d612752705f324df7b0913069c43a5";
 attribute scope:String="Complete existing POSIX emulated word service: same-address mutex RMW, encoded-word wrap, actual module construction/drain and meaningful standalone fence. Qualify real standalone fallback units without mixed conditional ABI; production GCC builtin profile unchanged. No whole emulated Scheme VM or CAS-less machine admission.";
 attribute formalDuty:String="Reuse root result_mutex_ticket_grant_tests.qnt and visibility model for conditional grant-completion ordering. Current mutex-backed CAS already supplies an acquire; its old empty fence is not a claimed current ticket failure. C23 primitive arithmetic/representation and fence semantics are source premises, not duplicated Lean/QNT proofs. No native weak-memory/fairness theorem.";
 attribute sourceCases:String="word-law;source-mutex;lifecycle;fence;backend-isolation;source-custody";
 attribute requiredCases:String="strict-baseline;real-emulated;native-profile;litmus;emitted-code;production-pbt;model;aa-cost";
 part def Component { attribute source:String; attribute owns:String; attribute contract:String; }
 part word:Component { attribute :>> source="vendor/gambit/lib/os_thread.c: ___emulated_compare_and_swap_word / ___emulated_fetch_and_add_word / ___emulated_fetch_and_clear_word"; attribute :>> owns="Existing address-hashed mutex supplies RMW atomicity and same-address visibility. Addition uses unsigned modulo arithmetic and reconstructs the signed word representation with memcpy before the volatile store."; attribute :>> contract="No signed overflow or out-of-range signed cast dependence. Managed word has matching width/representation, C23 two's complement. Lock covers read/transform/write; no new mutex bucket, metadata or namespace. Current production -fwrapv is preserved; its old behavior is not mislabeled a native-profile UB failure."; }
 part fence:Component { attribute :>> source="vendor/gambit/lib/os_thread.c: ___emulated_shared_memory_barrier; C23 stdatomic.h"; attribute :>> owns="Replace empty hope-for-the-best implementation with sequentially consistent atomic_thread_fence."; attribute :>> contract="Fence orders eligible accesses; it does not stop a thread, repair a C data race or alone grant payload ownership. C23 atomic support is a managed prerequisite; actual arm64 code must emit a barrier. RMW publication still uses existing same-source mutex."; }
 part testBoundary:Component { attribute :>> source="vendor/gambit/tests/ordered-sync.c;vendor/gambit/tests/makefile.in;actual os_thread/os_base/os_setup source units"; attribute :>> owns="Native builtin and actual POSIX emulated constructors/RMW/ticket/fence consumers. Suppress compiler capability macros only for an isolated standalone test, never link the production archive across that conditional ABI."; attribute :>> contract="Existing queued fixture referred to nonexistent sync-slot macros; remove that unqualified assumption, not an official test. Test real current primitives and race-free atomic litmus. GNU/Clang POSIX native test variant uses existing build link-option parameter; production configuration/flags unchanged. Strict UBSan mode deliberately disables -fwrapv as a separate diagnostic."; }
 attribute refinements:String="rmwMap;grantMap;fenceMap";
 part def Refinement { attribute actions:String; attribute source:String; attribute guard:String; attribute obligation:String; attribute quint:String; attribute leanDuty:String default="No new arithmetic law proved in Lean; C23 primitive/representation premise and native boundary checks explicit. No duplicated protocol proof."; }
 part rmwMap:Refinement { attribute :>> actions="reserveTicket;acceptGrant"; attribute :>> source="Real CAS/add/clear word functions under address-hashed mutex; unchanged ordered word macros"; attribute :>> guard="Aligned valid word and live initialized thread module; all concurrent accesses use the same service, no racing raw word store. Unsigned wrap plus valid representation; no proof for arbitrary foreign memory."; attribute :>> obligation="WORD-LAW"; attribute :>> quint="models/gambit/result_mutex_ticket_grant_tests.qnt"; }
 part grantMap:Refinement { attribute :>> actions="acceptGrant;claimB;executeB"; attribute :>> source="Current ticket lock uses WORD_LOAD_ACQUIRE/CAS mutex handoff"; attribute :>> guard="Acquire at actual grant completion; bounded outstanding tickets and physical owner remain existing premises. Root model old-noop negative is an abstract missing-order scenario, not a reproduced current native CAS failure."; attribute :>> obligation="WORD-ORDER"; attribute :>> quint="models/gambit/result_mutex_ticket_visibility.qnt"; }
 part fenceMap:Refinement { attribute :>> actions="acceptGrant"; attribute :>> source="Actual standalone emulated fence and C23 atomic litmus"; attribute :>> guard="Sequentially consistent fence semantics are normative source premise; emitted dmb and4096 litmus observations do not prove all C weak-memory executions or GC stop."; attribute :>> obligation="WORD-FENCE"; attribute :>> quint="models/gambit/result_mutex_ticket_grant_tests.qnt"; }
