 attribute obligations:String="law;order;fenceProof;life;isolation;reuse;costProof";
 part law:Obligation { attribute :>> id="WORD-LAW"; attribute :>> status="CLOSED"; attribute :>> premise="Actual parent strict diagnostic detects overflow; candidate actual word boundary/CAS/clear and wrap pass, no narrowing cast."; }
 part order:Obligation { attribute :>> id="WORD-ORDER"; attribute :>> status="CLOSED"; attribute :>> premise="Real native/emulated ticket updates and two trylock controls preserve current source mutex/grant ordering."; }
 part fenceProof:Obligation { attribute :>> id="WORD-FENCE"; attribute :>> status="CLOSED"; attribute :>> premise="Old function empty, new sequentially consistent fence emits arm64 dmb and race-free litmus passes; no full memory-model theorem."; }
 part life:Obligation { attribute :>> id="WORD-LIFECYCLE"; attribute :>> status="CLOSED"; attribute :>> premise="Real thread-module setup and cleanup surround all users; constructor rollback code unchanged, no unknown-join permission."; }
 part isolation:Obligation { attribute :>> id="WORD-ISOLATION"; attribute :>> status="CLOSED"; attribute :>> premise="Standalone emulated variant links only consistent actual source units; no production archive with mismatched conditional ABI. No CAS-less host/whole-emulated-VM admission."; }
 part reuse:Obligation { attribute :>> id="WORD-REUSE"; attribute :>> status="CLOSED"; attribute :>> premise="Same production profile/cache, identical GSI/GSC/seed,51 generated products reused; real new archive serves SFUN/PBT."; }
 part costProof:Obligation { attribute :>> id="WORD-COST"; attribute :>> status="CLOSED"; attribute :>> premise="Zero new production storage, unchanged builtin executable code. Exact same-executable A/A costs measure noise, not an algorithm speedup; old1-arg attribution remains conditional."; }
 part submission:GambitCommitGates::SubmissionUnit { attribute :>> kind="integration"; attribute :>> result="ordered-word-fallback"; attribute :>> progressDelta=1; attribute :>> supportPaths=""; }
