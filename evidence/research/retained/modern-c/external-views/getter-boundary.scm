(for-each
 (lambda (get pred)
   (let* ((first (get)) (other (get)) (saved (vector-copy other)))
     (if (not (and (vector? first) (vector? other) (not (eq? first other))
                   (every pred (vector->list first)) (equal? first other)
                   (> (vector-length first) 0)
                   (not (fixnum? (vector-ref first 0)))))
         (error "owned getter/legacy-layout precondition differs"))
     (##gc)
     (vector-set! first 0 #f)
     (##gc)
     (if (not (and (equal? other saved)
                   (every pred (vector->list (get)))))
         (error "getter alias escaped into registry"))))
 (list ##symbol-table ##keyword-table) (list symbol? keyword?))
(display "OWNED-GETTER-EXTERNAL-BOUNDARY-PASS\n")
(exit)
