  "cTransform": "def specialize_cross_host(code):\n    assert \"#define ___HOST_LAYOUT ___HOST_LAYOUT_PROCEDURES\" in code\n    labels = code.split(\"\\n___BEGIN_LBL\\n\",1)[1].split(\"\\n___END_LBL\",1)[0].splitlines()\n    table = []\n    for label in labels:\n        entry = re.match(r\"\\s*,?___DEF_LBL_([A-Z_]+)\\((\\w+),\", label)\n        assert entry, label\n        table.append(entry.groups())\n    host = None\n    routes = dict(cross=0, local=0)\n    result = []\n    for line in code.splitlines(keepends=True):\n        if line.startswith(\"#define ___PH_PROC \"):\n            host = line.split()[-1]\n        elif line == \"___END_P_COD\\n\":\n            host = None\n        elif host and line.lstrip().startswith(\"___JUMPINT(\"):\n            edge = re.fullmatch(r\"(\\s*)___JUMPINT\\((___SET_NARGS\\([0-9]+\\)|___NOTHING),(___PRC\\(([0-9]+)\\)),(\\w+)\\)\\n\",line)\n            assert edge, line\n            indent, nargs, prc, ordinal, _ = edge.groups()\n            kind, destination = table[int(ordinal)]\n            assert kind in (\"PROC\",\"PROC_AT\")\n            if host != destination:\n                routes[\"cross\"] += 1\n                line = f\"{indent}___JUMPEXTPRM({nargs},{prc})\\n\"\n            else:\n                routes[\"local\"] += 1\n        result.append(line)\n    return \"\".join(result), routes\n",
