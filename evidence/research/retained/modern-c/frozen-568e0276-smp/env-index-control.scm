(define (next-var-stamp) 0)
(define (ptset-empty) '())
(define (pt-syntax-error . args) 'duplicate)
(define (compiler-internal-error . args) 'macro-error)
(load "vendor/gambit/gsc/_envadt.scm")

(define (load-environment path)
  (call-with-input-file path
    (lambda (port)
      (let loop ((active? #f))
        (let ((form (read port)))
          (if (eof-object? form)
              (error "missing environment definition" path)
              (let ((active? (or active? (equal? form '(define make-global-environment #f)))))
                (when active? (eval form))
                (unless (and active?
                             (eq? (car form) 'define)
                             (equal? (cadr form) '(env-lookup-macro env name)))
                  (loop active?)))))))))

(define (exercise)
  (let* ((root (make-global-environment))
         (namespace '("a#" (alias . target)))
         (view (env-declare (env-namespace root namespace) 'safe))
         (first (env-lookup-var view 'alias 'origin))
         (child (env-frame view '()))
         (macro (list 'macro))
         (macros (env-macro view 'alias macro))
         (local (env-define-var child 'a#target 'local))
         (newest (env-new-var! root 'a#target 'replacement))
         (seeded (env-frame #f (list first newest)))
         (symbol-a (string->uninterned-symbol "same"))
         (symbol-b (string->uninterned-symbol "same"))
         (one (env-lookup-global-var root symbol-a))
         (two (env-lookup-global-var root symbol-b)))
    (list (eq? (var-name first) 'a#target)
          (eq? (table-ref (env-externals-ref child) 'a#target) namespace)
          (eq? (env-lookup-macro macros 'alias) macro)
          (not (env-lookup-macro view 'alias))
          (eq? (env-lookup-var macros 'alias #f) 'macro-error)
          (eq? (env-lookup-var child 'a#target #f) local)
          (eq? (env-lookup-var (env-frame view '()) 'alias #f) newest)
          (eq? (env-define-var child 'a#target #f) 'duplicate)
          (eq? (env-lookup-global-var macros 'a#target) newest)
          (eq? (env-lookup-global-var seeded 'a#target) first)
          (equal? (env-global-variables child) (list two one newest first))
          (not (eq? one two))
          (eq? one (env-lookup-global-var root symbol-a)))))

(define names (list->vector (map (lambda (i) (string->symbol (number->string i)))
                                 (iota 512))))
(define (bench)
  (let* ((root (make-global-environment))
         (view (env-frame (env-declare root 'safe) '()))
         (begin (cpu-time))
         (vars (vector-map (lambda (name) (env-lookup-global-var root name)) names)))
    (do ((pass 0 (+ pass 1))) ((= pass 3))
      (do ((i 0 (+ i 1))) ((= i (vector-length names)))
        (unless (eq? (vector-ref vars i)
                     (env-lookup-var view (vector-ref names i) #f))
          (error "lookup lost identity" i))))
    (unless (equal? (env-global-variables view) (reverse (vector->list vars)))
      (error "lookup changed enumeration"))
    (- (cpu-time) begin)))

(define (run label path)
  (load-environment path)
  (let ((checks (exercise)))
    (unless (equal? checks (make-list 13 #t)) (error "lookup changed" label checks))
    (write (list label 'checks (length checks) 'cpu-seconds (bench)))
    (newline)))
(run 'baseline original)
(run 'indexed "vendor/gambit/gsc/_env.scm")
(run 'indexed "vendor/gambit/gsc/_env.scm")
(run 'baseline original)
