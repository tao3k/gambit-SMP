  "cTransform": "host_re = re.compile(r\"(^#define ___PH_PROC (\\w+)\\n.*?^___END_P_COD\\n)\",re.M|re.S)\ndef coalesce_dispatch(code):\n    hosts = list(host_re.finditer(code))\n    split = {m[2].rsplit(\"_cfg_\",1)[0] for m in hosts if re.search(r\"_cfg_[1-3]$\",m[2])}\n    assert split and \"#define ___INDEXED_HOST_ENTRIES 1\" in code\n    targets = {m[2] for m in hosts if m[2].rsplit(\"_cfg_\",1)[0] in split}\n    prefix = \"\"\"#pragma push_macro(\"___JUMPFAST\")\n#pragma push_macro(\"___END_SW\")\n#undef ___JUMPFAST\n#undef ___END_SW\n#define ___JUMPFAST(dest) {___pc=dest; goto ___shared_jump;}\n#define ___END_SW goto ___jumpext; ___shared_jump: if (___EXPECT_FALSE(___LABEL_HOST_GET(___pc) != ___HOST_PROC)) goto ___jumpext; goto *___LABEL_HOST_LABEL_GET(___pc); ___jumpext:\n\"\"\"\n    suffix = '#pragma pop_macro(\"___END_SW\")\\n#pragma pop_macro(\"___JUMPFAST\")\\n'\n    return host_re.sub(lambda m:prefix+m[1]+suffix if m[2] in targets else m[1],code), sorted(targets)\n"
