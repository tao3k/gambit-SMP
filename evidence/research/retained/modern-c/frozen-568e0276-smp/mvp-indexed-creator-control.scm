(declare (not inline))
(define saved #f)
(define visits '())
(define (check-creator cont)
  (let loop ((frame cont))
    (cond ((not frame) (error "missing probe frame"))
          ((eq? (##continuation-creator frame) probe)
           (if (not (= (##subprocedure-id (##continuation-ret frame)) 2))
               (error "wrong probe PointId"))
           (display "INDEXED-PROBE-CREATOR-AND-ID\n"))
          (else (loop (##continuation-next frame))))))
(define (capture)
  (##continuation-capture
   (lambda (k)
     (set! saved k)
     (check-creator k)
     10)))
(define (consume live value)
  (if (not (= (vector-ref live 0) 817))
      (error "lost live root"))
  (set! visits (cons value visits))
  value)
(define (probe live)
  (consume live (capture)))
(probe (vector 817))
(case (length visits)
  ((1) (##gc) (check-creator saved) (##continuation-return saved 20))
  ((2) (##gc) (check-creator saved) (##continuation-return saved 30))
  ((3) (if (equal? visits '(30 20 10))
           (display "INDEXED-FRAME-RESUMED-TWICE\n")
           (error "wrong resumes" visits)))
  (else (error "unexpected resume count")))
