  "cTransform": "def outline_binding_reads(code):\n    header = '#include \"gambit.h\"\\n'\n    assert code.count(header)==1\n    outlined = \"\"\"\n#if defined(___MODULE_NAME) && ___ORDERED_WORD_NATIVE\nstatic __attribute__((noinline)) ___SCMOBJ mvp_read_global(\n    ___processor_state ___ps, ___virtual_machine_state vm, ___glo_struct *global)\n{\n  if (vm)\n    return ___WORD_LOAD_ACQUIRE(___binding_global(vm,global));\n  return ___WORD_LOAD_ACQUIRE(&___GLOCELL(global->val));\n}\n\nstatic __attribute__((noinline)) ___SCMOBJ mvp_read_primitive(\n    ___processor_state ___ps, ___virtual_machine_state vm, ___glo_struct *global)\n{\n  if (vm)\n    return ___binding_primitive(vm,global);\n  return ___EXT(___primitive_ref)(___ps,global);\n}\n\n#undef ___GLO\n#undef ___PRM\n#define ___GLO(i,glo) mvp_read_global(___ps,___binding_vm,&___GLOSTRUCT(i,glo))\n#define ___PRM(i,glo) mvp_read_primitive(___ps,___binding_vm,&___GLOSTRUCT(i,glo))\n#endif\n\"\"\"\n    sites = {name:len(re.findall(r\"\\b___\"+name+r\"\\(\",code))\n             for name in (\"GLO\",\"PRM\",\"JUMPGLOSAFE\",\"JUMPGLONOTSAFE\")}\n    assert sites[\"GLO\"]+sites[\"PRM\"]+sites[\"JUMPGLOSAFE\"]+sites[\"JUMPGLONOTSAFE\"]>0\n    return code.replace(header,header+outlined), sites\n"
}
