 part globalIdentity:GlobalIdentity {
  attribute :>> role="globalIdentity";
  attribute :>> source="vendor/gambit/lib/_mem/global-bindings.inc:global_append/global_room/make_global_var";
  attribute :>> contract="Shared monotonic identity in the existing int domain. Identity publication does not allocate a dense slot in every live VM. The20000 backing-array admission rule retires, without raising heap/profile capacity options.";
  attribute :>> lifetime="GSTATE permanent arena; shared immutable code templates remain. Unpublished permanent metadata stays arena-owned until global cleanup; no per-attempt refund claim.";
 }
 part vmGlobals:VmGlobalCells {
  ref part :>> identities=GambitRequestProduct::globalIdentity;
  attribute :>> role="vmGlobals";
  attribute :>> source="vendor/gambit/lib/_mem/global-storage.inc;global-bindings.inc;memory-lifecycle.inc";
  attribute :>> contract="One VM-owned store. One page holds WORD_WIDTH ordinary and primitive cells plus one primitive-presence word. Page/cell addresses remain stable. A half-full append-only directory doubles geometrically; old directories remain VM-owned until the existing cleanup permit. Reads allocate nothing; binding prepares cells before generated writes.";
  attribute :>> allocationPolicy="Native malloc under the existing registry gate, no Scheme allocation/GC/callback. Failed page/directory preparation preserves the old directory and published cells. VM setup currently materializes the captured entire shared-registry prefix, not a minimal module-demand inventory: setup remains O(G) and no asymptotic startup saving is claimed. Later unrelated-VM registrations allocate no cells in this VM. Generated/admitted writes require prepared VM cells; raw cross-VM identity-only writers are not silently admitted. Native requested-storage measurements are separate from RSS and whole peak.";
 }
 part frozenGlobals:FrozenGlobalCells {
  ref part :>> cells=GambitRequestProduct::vmGlobals;
  attribute :>> role="frozenGlobals";
  attribute :>> source="vendor/gambit/lib/root.h;_mem/root-tasks.inc:root_globals_begin/root_globals_source/root_round_publish;_mem/root-origins.inc:mark_global_variables";
  attribute :>> contract="After writer closure, capture this VM's page head/count once. Partition dense page ordinals, never shared identity count. Both standalone and whole-round publishers initialize each shard cursor. RootTask owns ordinary cells and active primitive overrides in its exact page range. Scan metadata is not a Scheme root. No page/directory is reclaimed until VM cleanup admits all readers and tasks drained.";
  attribute :>> qualification="First self-host seed fault at page offset16 retained; whole-round publisher omitted its cursor and is corrected. Current from-scratch532.533884s passes both full phase sequences. Cold stock120 remains failed; no whole tools/release or4/4 admission follows.";
  attribute spatialRefinement:String="For word width W and identity i: pageKey=floor(i/W), offset=i mod W. Each published key has exactly one stable page. Concrete root cells are Ordinary(page,offset) for every0<=offset<W and Primitive(page,offset) when the frozen presence bit is set. Field arrays are disjoint C subobjects; aliases of Scheme values do not alias root-cell addresses. Floor page partitions cover each physical page once, including empty shards. Reuse existing Lean CompleteCensus/TaskCoverage laws only after these native premises hold; no new temporal theorem.";
  attribute writerCut:String="All own-VM RC domains reach FROZEN at the admitted collective before the global-gate snapshot; same-VM page preparation requires OPEN ownership and cannot overlap that cut. Unrelated VM registration may extend shared identities but does not append these pages. Acquire directory publication exposes fully initialized page payload; old directories and all pages outlive readers through existing VM cleanup permission.";
  attribute qualificationBoundary:String="The snapshot PBT oracle tracks a logical registry transaction stamp separately from physical page geometry. The C observer must independently match snapshot count/head to actual VM storage and source descriptors to that snapshot. Real moving-root tests establish address repair; native registration over20000 does not itself prove failure-injection, every writer, or whole SMP.";
  attribute nextBoundary:String="Future ModuleSpec/HostGraph work, excluded from this delivery: a statically bound GVM global may resolve its stable VM cell address once at a proven dominating host point and reload the mutable payload at each use. Do not mark the generic missing-binding lookup pure, cache the unbound sentinel, snapshot global values into continuations, or hoist an unbound-value error. FrameSpec reentry must reconstruct the correct VM/module scope for multi-shot restoration and tail dispatch; native pointer locals are not Scheme frame roots. Dynamic reflective globals retain checked lookup. Positive condition: eliminated hot lookups exceed binding/reentry/spill costs; counterexamples are cold branches, large host reference sets and frequent context switches. This is an IR address-invariance obligation reusable by generated C and a future MLIR lowering, not a new executor, namespace or implemented optimization.";
 }
 part globalRead:GlobalRole {
  attribute :>> role="globalRead";
  attribute :>> source="vendor/gambit/include/gambit.h.in:___global_page/___global_cell_address/___GLOCELL_IN_VM;vendor/gambit/lib/_mem/global-storage.inc:___global_cell";
  attribute :>> contract="Runtime and native ordered-word generated modules share one outlined address resolver. The exported service remains an ABI adapter; legacy/emulated generated targets retain that service. Preserve acquire loads, collision traversal, stable VM cell lifetime and fresh mutable payload loads. No address/value cache, purity annotation, allocation, poll, callback or layout change. Existing GC/cleanup ownership and QNT/Lean premises are unchanged. Native timing variation and lookup overhead remain empirical costs, not proven gains.";
 }
 part cellsToReads:GlobalOwnershipEdge {
  ref part :>> producer=vmGlobals; ref part :>> consumer=globalRead;
  attribute :>> contract="An acquired immutable directory denotes initialized stable pages through the VM cleanup permit; a read never prepares missing storage or retains a borrowed cell past VM lifetime.";
 }
 part identityToCells:GlobalOwnershipEdge {
  ref part :>> producer=globalIdentity; ref part :>> consumer=vmGlobals;
  attribute :>> contract="Binding transaction maps stable identity to VM storage before symbol/module publication; allocator failure leaves identity unpublished or retains existing binding responsibility.";
 }
 part cellsToRoots:GlobalOwnershipEdge {
  ref part :>> producer=vmGlobals; ref part :>> consumer=frozenGlobals;
  attribute :>> contract="Existing RC writer closure and global_gate publish one immutable page inventory; main-round and standalone adapters must refine the same cursor/range contract.";
 }
 part globalStorage:Adapter {
  ref part :>> need=GambitModernCOutcomes::executionNeed0;
  attribute members:String="globalIdentity;vmGlobals;frozenGlobals;globalRead";
  attribute links:String="identityToCells;cellsToRoots;cellsToReads";
  attribute :>> path="vendor/gambit/lib/_mem/global-storage.inc;global-bindings.inc;root-tasks.inc;root-origins.inc;memory-lifecycle.inc;vendor/gambit/include/gambit.h.in;vendor/gambit/tests/smp/gc/global-storage.scm";
  attribute :>> contract="Complete identity/storage/scan ownership replacement. Scheme names, tail/continuation representation and VM-local primitive override semantics remain. A native lookup and directory retention cost must be measured; no invisible allocation in a read or generated store.";
