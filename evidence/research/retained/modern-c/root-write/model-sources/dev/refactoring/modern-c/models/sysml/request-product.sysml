 part boundary:DeliveryBoundary {
  ref part :>> result=GambitModernCOutcomes::execution;
  attribute :>> replacement="Replace repeated waiter capture and ambiguous request/service/FIFO publication with explicit owned control flow. Include only actual compiler/product prerequisites needed to execute the declared consumers. Preserve multi-shot continuation, dynamic-wind, roots and scheduling policy.";
  attribute :>> caseEvidence="evidence/research/retained/modern-c/request-product/shared-slot-native-cases.json";
  attribute :>> caseEvidenceSha256="d51ceece70d84835d96175f62260273d5aa0cf2c1ca96ed0ec66098e8304d7c3";
  attribute :>> exclusions="No whole scheduler redesign, complete CFFI, generational GC, frontend optimization programme, new profile/executor, whole matched cold-build comparison, or independent SMP12-family admission. Cold cost stays unmeasured in the separate build workstream; no cold acceleration claim. Supporting build/model/CI work grants no architecture increment.";
  attribute :>> extensionRule="The requiredAcceptanceParts and pinned nonhistorical cases define the exact admission dependency set. New or removed blockers require a reviewed SysML contract change with causal source/test evidence and refreshed source-bound audit; a report, failed related test or new ASCENT fact cannot silently extend it. Existing reviewed-report/model digests must then invalidate. No boundary change can turn a prior failed or censored run into a pass.";
  attribute :>> failureRule="Retain failures and limits. Baseline-common failure requires matching inputs, artifacts and an independently checked failure signature; current-only or uncertain effects remain unresolved. A dependency can block a required consumer without becoming an unrelated runtime redesign. Historical case identities here retain8f7fd987 and do not qualify1b387add or the dirty checkout.";
 }
 attribute progressAxes:String="3/4 counts locally qualified complete architecture results; item5 of13 is a responsibility address, not5/13 completion;1/12 counts independent branch SMP families. Closure obligations below are not a new progress denominator. Supporting commits and four Gerbil Make stages advance none of these counters by themselves.";
 attribute closureDelay:String="Delivery4 mixed runtime ownership, necessary compiler/ABI consumer prerequisites and an unmeasured whole cold-build comparison. Current326/326/740 consumers and all19 differential functional cases are closed; original aggregate censoring and common failures remain baseline debt. User explicitly assigns cold-build comparison to the later build workstream. Current composed costs retain p1/p2 regressions; bounded owner-graph convergence, unique queue/write ownership and reproducible overhead disposition justify the responsibility replacement, not universal throughput superiority. The remaining step is exact source/commit audit, not another scheduler or frontend project.";
 part def ClosureObligation { ref part component:Adapter; attribute id:String; attribute status:String; attribute scope:String; attribute evidence:String; attribute qntDuty:String; attribute pbtDuty:String; attribute exitCondition:String; attribute exclusion:String; }
