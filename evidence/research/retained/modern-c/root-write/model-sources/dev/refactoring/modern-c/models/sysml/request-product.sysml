 part budgetCause:ClosureObligation {
  ref part :>> component=product;
  attribute :>> id="COVERAGE-CAUSE";
  attribute :>> status="CLOSED_MATCHED_CASE_REVIEW";
  attribute :>> scope="All95 originally unresolved candidate cases were attempted in both correctly bound SDK roles under300/90s:94 pass and only_num remains censored in each. All19 differential cases pass in both roles. Their original cohort had14 not started and5 interrupted at parent deadlines. This closes the case-specific functional gap; original cohort censoring and phase/timing uncertainty remain explicit cost evidence.";
  attribute :>> evidence="evidence/research/retained/modern-c/request-product/shared-slot-coverage.json";
  attribute :>> qntDuty="No new QNT timing machine. Phase/cwd/tool/source attribution is an empirical obligation.";
  attribute :>> pbtDuty="No random timing property. Reuse original case bytes; separate functional assertion checks from native phase measurements and shrinking.";
  attribute :>> exitCondition="Current326/740 consumers complete. Original408-file cohorts remain312PASS/1FAIL/95UNRESOLVED candidate and331/1/76 baseline; they are not relabeled. Fresh matched95-case follow-up yields94PASS/1UNRESOLVED in both, including19/19 differential positives. Independently checked SDK artifacts and identical fxmul source/assertion signatures establish common failure debt;_num is common90s censoring, never a passed test. Compiler-phase latency and whole-build cost are separate, without universal causal claims.";
  attribute :>> exclusion="Rejected full-inline and first-probe-inline experiments remain rejected. Production uses one actual lookup body in the header and runtime ABI adapter, with no value/address caching or new layout. Native ordered-word targets share the body; legacy generated backends keep the old service. Aggregate wall times cannot establish compiler macro or optimizer causality.";
 }
 part releasePopulation:ClosureObligation {
  ref part :>> component=release;
  attribute :>> id="MATCHED-COST";
  attribute :>> status="CLOSED_DECLARED_POPULATION";
  attribute :>> scope="Declared REV cost population: full408 interpreted ABBA and fixed4096-request compiled8-build/16-execution ABBA; exact inputs, source/ABI, all overheads retained. Whole matched cold Gerbil/build belongs to a separate follow-up per explicit user scope decision; no cold acceleration claim.";
  attribute :>> evidence="evidence/research/retained/modern-c/request-product/argument-only-cost.json";
