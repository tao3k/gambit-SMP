   attribute :>> sourceAnchor="gsc/_gsclib.scm:gambuild; configured gambuild-C; configure.ac:single-host; _gambit/configuration.h.in";
   attribute :>> requiredWitness="Original-profile natural compiler exit, exact object/dependencies and owned output identity";
   attribute :>> assuranceBoundary="Both timeouts are censored. One-second alias-solver observation does not establish whole-run pass percentages or all causes. Baseline clean Gerbil pipeline causality is open. Historical flag-only alternate-host output cannot enter original-profile products. The current producer-owned physical-unit declaration is a source change under the unchanged profile, not that diagnostic override.";
  }
  part settlement:CompilerPhaseBoundary {
   ref part :>> runtimeConsumer=product;
   attribute :>> stage="Module job drain, private SSI publication and whole-module witness";
   attribute :>> phaseStatus="Current d07f67b4/987c59dd ABI326 complete stdlib programs,740 static native units and natural stdlib/libgerbil/lang/tools exits. Prior partial/failed parents retain separate source periods and completion prefixes. Complete cost/coverage attribution remains a different gate.";
   attribute :>> sourceAnchor="gerbil_compile_products.ss:compile-product-drain/publish/module; gerbil_build/compiler_products.py:_stdlib_compile_products";
   attribute :>> requiredWitness="All native results and outputs verified before SSI publication; Python issuer additionally requires quiescent parent";
   attribute :>> assuranceBoundary="A disappeared private SSI can recover matching renamed bytes only into private generation custody; the original worker still joins native jobs before interface publication. Borrowed products must match original admission and immutable issuer witnesses in the same context. Later same-boot birth-bound empty group/session observation closes writer custody without repairing incomplete streams or failed parent outcomes. Settlement never grants whole-stage completion. Existing incremental_build.qnt owns temporal completion; these actual source adapters require refinement and native validation, not a duplicate Lean schedule proof";
  }
  part emissionToGeneration:CompilerPhaseTransfer {
   ref part :>> producer=managedEmission;
   ref part :>> consumer=generation;
   attribute :>> condition="Only source-bound closed generation witnesses may supply planning identity/dependencies before the original worker restores immutable code and private SSI into the same managed program. The coordinator always enqueues this work and never posts module completion for a generation prefix. Original native argv and CPU quota remain. All native work must succeed and source/dependency identities must still match before public SSI publication";
   attribute :>> proofOwner="Existing incremental_build.qnt owns temporal completion and custody; real helper capture/resume/source-guard controls refine the implementation boundary. Existing Lean FrameSpec scope is unchanged; no duplicate schedule proof";
  }
  part libraryOrder:CompilerPhaseBoundary {
   ref part :>> runtimeConsumer=product;
   attribute :>> stage="Library runtime dependency ordering before static compilation";
   attribute :>> phaseStatus="Current d07f67b4/987c59dd consumes326 complete program graphs and326 compact views; original stdlib/libgerbil/lang/tools all naturally exit under unchanged limits. Current incremental stage times15.974612/46.084959/8.684437/94.919886s;740 static units complete,686 reused and54 executed in the closing library attempt. Historical1b/7308 measurements remain distinct. Tools registration pressure is resolved by the real VM-storage/root-index separation, not a raised capacity. Historical119-root/58fe43 planning and20000-limit failures remain documentary controls. This is not a cold matched build or4/4 release admission.";
   attribute :>> sourceAnchor="gerbil_library_order.ss keeps the checked original traversal behind explicit getter operations. gerbil_initialization_view.ss owns the pure projection/slot adapter. initialization_views.py owns derived view custody; library_source.py installs only consumer-owned code, preserving the native producer identity.";
   attribute :>> requiredWitness="Same complete-program input graph and independently closed derived view; exact source/contract/output identities and ready transport. Native256 properties and three real SSI controls precede installed planning. No decoded expander scopes, replayed macro phase, guessed all-phase order or enlarged global table.";
   attribute :>> assuranceBoundary="Scoped119-root planning and one wall observation are not complete library/whole release admission. Global instrumentation has observer effects. Historical failures remain source-period-specific. Native construction continues under the original bounds and exact producer key.";
   attribute completionOwner:String="Each find-deps root owns an eq-keyed completion table over actual context objects. A module/prelude gets a token only after its children return. The original global module-ID fold remains after root completion. Distinct objects sharing an ID are not merged by the completion table.";
   attribute finiteOrderArgument:String="CONDITIONAL SOURCE ARGUMENT, not a Lean-checked theorem: with immutable outgoing context/phase edges and pure getters, each repeated completed object subtree emits only IDs already present in its first postorder trace. Erasing later copies preserves stable-first-ID projection. Induction on the first finite subtree establishes the original final initialization list, including distinct-context aliases. The global visited set is unchanged during each root walk. Exact phase and import-set-template bodies are pinned by the inverse.";
   attribute cycleArgument:String="Completion is black-only, after child return; no in-progress/gray node is skipped. An uncut active cycle cannot create a completion token and cannot return or publish an order. Phase/global exclusion cuts remain original. core-import-module still raises Cyclic expansion for its original path condition, and runtime loader loading/wait/error handling is untouched. This preserves existing cycle behavior; it does not solve cyclic initialization or invent an SCC order.";
   attribute costBoundary:String="For each finite root: one expansion per distinct context object, plus actual wrapper/template edge work. Additional managed hash storage is O(distinct contexts); dependency trace storage loses repeated completed subtrees. Total root/cold-build latency and peak memory are unmeasured. The14.307715s failed libgerbil process is not a performance improvement over its previous censored timeout.";
   attribute properties:String="Actual original/candidate function finite equivalence, graph encode/restore identity and order, phase/prelude/alias/forced-GC properties pass256 cases; ID-keyed mutation shrinks to3 edges. Actual build-config/time-timeout/socket source versus SSI initialization order comparisons pass with20/22/36 modules. Root phase-zero evaluation is not forced, matching compile-module/order-modules. Existing QNT owns completion/custody histories; Lean is not duplicated.";
   attribute rejectedShortcut:String="The existing current-expander-eval hook was tested only in a disposable diagnostic process. Suppressing evaluation with a trapping syntax value reaches QUERY-CALLED-UNQUALIFIED-MACRO during real module expansion. This disproves adopting a blanket no-eval query as an equivalent link graph. Production source retains the normal evaluator. Graph certificates must be produced from real semantic contexts, including alias identity and phase/template edges, rather than invented from all-phase reuse metadata.";
   attribute semanticArtifact:String="Each .init carries module-initialization tag, exact compiler context, module ID and an immutable slot graph. Slots are reserved before descending; shared references and back edges retain identity. The graph has no executable callbacks or invented import edges.";
   attribute issuerBoundary:String="Graph bytes are included in compile-product-output and original module-completed output identities. Native tasks drain and source/dependency checks precede SSI publication; Python additionally requires producer quiescence and immutable module completion witnesses before exposing a ready graph path. Failed or unknown native production cannot authorize graph-based whole completion.";
   attribute readerBoundary:String="The module_product_scope lease spans libgerbil, lang and tools and restores the existing compile-product fields only after the last consumer or failure. It requalifies complete programs, installs immutable slot views without reconstructing expander objects, and keeps the original ordering traversal. The first managed Make metadata read initializes the existing gxc catalogue only if absent; it must never overwrite an activated native driver writer. Every static native unit has an exact context/role/program/argv/cwd/source/output/contract request. The original invoke-process status and close precede immutable completion; native source-effect and header closure checks precede reuse. Unknown writers or failed whole parents cannot authorize completion. An AOT driver may replace repeated source activation only after the same-source original gxc returns, inputs remain unchanged, outputs have no aliases and a real compiled protocol smoke closes native jobs and module publication. A ready object path alone is insufficient. Unmanaged builds retain their original resolver.";
   attribute benefitCondition:String="Planning native global growth becomes independent of loaded library macro definitions: only the fixed driver/codec is executable, while graph contexts are managed data. Capture adds O(V+E) serialization and disk storage per generated module, plus managed restoration memory. Warm planning reuses the same graph/native/interface witness. Whole wall time and peak benefit remain unmeasured until complete native consumers and matched baseline pass.";
  }
  part settlementToLibraryOrder:CompilerPhaseTransfer {
   ref part :>> producer=settlement;
   ref part :>> consumer=libraryOrder;
   attribute :>> condition="Verified complete stdlib modules may supply stable interface identities. Their all-phase reuse dependency list does not authorize a phase-0 ordered link plan or public library completion";
   attribute :>> proofOwner="Existing incremental_build.qnt retains completion and invalidation custody. Library-order semantic refinement requires source and actual consumer evidence; existing FrameSpec Lean laws do not prove module ordering. No duplicate temporal or spatial model";
  }
  part generationToFrontend:CompilerPhaseTransfer {
   ref part :>> producer=generation;
   ref part :>> consumer=cFrontend;
   attribute :>> condition="Stable generated tokens and complete producer input cut; diagnostic retained-file access does not issue reuse";
   attribute :>> proofOwner="Existing incremental_build.qnt owns temporal reuse/custody; actual generator-to-file refinement remains source/native evidence";
  }
  part nativeToSettlement:CompilerPhaseTransfer {
   ref part :>> producer=nativeConstruction;
   ref part :>> consumer=settlement;
   attribute :>> condition="Every owned native request succeeds under the required profile; unknown or timed-out output retains custody and cannot publish";
   attribute :>> proofOwner="Existing incremental_build.qnt and publisher_contract.qnt; existing FrameSpec/RuntimeRoles Lean retain spatial and frame laws. No duplicate schedule proof.";
  }
 }

 attribute stage:String="Whole fourth responsibility replacement; all predecessor, source/native cases and five gates must be admitted before the single progress increment. Cold comparison is an explicitly separate build follow-up, never a speedup claim.";
 attribute sourceCases:String="owned-wait-state;fifo-write-authority;finite-priority-closure;vm-global-slots;consumer-prerequisites";
 attribute requiredCases:String="multi-shot-waits;mailbox-queue;priority-cycles;root-relocation;unknown-join;official-consumers;gerbil-consumers;matched-cost;native-replay-shrink";
 part submission:GambitCommitGates::SubmissionUnit {
  attribute :>> kind="integration";
  attribute :>> result=GambitModernCOutcomes::execution.id;
  attribute :>> progressDelta=1;
  attribute :>> supportPaths="";
 }
 part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
 part tests:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="REQUEST-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/request-product/submission/receipt.json"; attribute :>> scope="Exact canonical/native/generated source equivalence, all original and Gerbil consumers, real replay and predecessor regressions. Common baseline failures remain explicitly classified, never passed."; }
 part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="REQUEST-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/delivery-contract.org"; attribute :>> scope="Finite frozen owner solve, distinct waiting/service activations, single queue authority and VM-local mutable global storage; measured time and memory costs remain explicit."; }
 part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="REQUEST-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/delivery-contract.org"; attribute :>> scope="One whole fourth integration with12 programme obligations, five source and nine native groups; no independent SMP or cold-build progress."; }
 part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="REQUEST-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="evidence/research/retained/modern-c/request-product/submission/source-review.json"; attribute :>> scope="Native OpenSysML selects the complete unit and obligations; ASCENT checks actual evidence identities. Existing QNT owns histories, Lean only existing spatial laws; neither is duplicated."; }
 part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="REQUEST-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/delivery-contract.org"; attribute :>> scope="What terminates cyclic propagation, who owns every queue mutation and stopped writer, how are multi-shot roots preserved, what is actually faster or slower, and what remains outside this REV?"; }
}
