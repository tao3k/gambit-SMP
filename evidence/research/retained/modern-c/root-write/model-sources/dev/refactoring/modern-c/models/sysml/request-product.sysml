 }
 attribute closureEdges:String="ownerToAdmission;consumerToAdmission;budgetToAdmission;releaseToAdmission";
 part def ClosureDependency { ref part predecessor:ClosureObligation; ref part successor:ClosureObligation; attribute condition:String; }
