 part tests:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="SFUN-TESTS"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/sfun-entry/qualification.json"; attribute :>> scope="Full declared production/failure/root/continuation/layout/old-module and original population; retain baseline failures without relabeling them."; }
 part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="SFUN-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/sfun-entry.org"; attribute :>> scope="Raw-prefix root coverage, physical C lifetime versus logical escape, necessary zero-argument cost and failed oracle history."; }
 part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="SFUN-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/sfun-entry.org"; attribute :>> scope="One complete generated-entry owner; foundation4/4 and independent SMP1/12 unchanged; broad CFFI/role rename is separate."; }
 part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="SFUN-FORMAL"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/sfun-entry/qualification.json"; attribute :>> scope="Actual existing QNT scenarios, SDK projection and conditional C source/lock refinement. No duplicated Lean proof."; }
 part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="SFUN-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/sfun-entry.org"; attribute :>> scope="Actual no-poll/root source assumptions, zero/one/wide input cost, explicit scan overhead and ABI consumers; never infer universal benefit."; }
