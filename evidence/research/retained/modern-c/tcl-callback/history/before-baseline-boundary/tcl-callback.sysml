package GambitTclCallback {
  private import ScalarValues::*;
  ref part construction=GambitTclCommand::component;
  ref part coverage=GambitModernCDeliveryPlan::rootWriters;
  attribute auditNumber:String="3.5.2.4";
  attribute parentNumber:String="3.5.2";
  attribute requiredCases:String="public-api;entry-bridge;delete-dispatch;unchanged-core;constructor-regression;entry-gc;body-gc;nested-return;nested-delete;self-delete;empty-result;predecessor-replay;serialized-replay;binding-compile;producer;original-consumers";
  attribute sourceCases:String="public-api;entry-bridge;delete-dispatch;unchanged-core";
  part component:GambitRevisionDelivery::Revision {
    attribute :>> activeArchitecture=true;
    attribute :>> id="tcl-callback";
    attribute :>> responsibility="Replace Tcl command callback payload snapshots and command-only lifetime by a retained stable RC identity and post-conversion Scheme payload reload";
    attribute :>> sources="examples/tcltk/command.h;examples/tcltk/tcltk.scm;tests/root-task.scm;tests/makefile.in";
    attribute :>> tests="Existing optional Tcl target, real generated Scheme entry, entry/body moving GC, nested self-deletion, original construction PBT, exact predecessor control and exported replay/shrink, actual full binding compilation and stock producer/consumers";
    attribute :>> retired="Raw SCMOBJ argument loaded before SFUN allocation; command deletion releasing the sole record while callbacks remain active";
    attribute :>> excluded="Cross-thread ClientData, nonlocal exception/continuation escape through Tcl, arbitrary interpreter/global teardown, dynamic C closure ABI and whole ROOTS/SMP credit";
  }
  attribute scope:String="Base4b9d8656; leaf3.5.2.4 covers owner-thread Tcl string-command callbacks which return normally, command deletion nested within those callbacks and the generated entry argument bridge. Live global/VM owner and valid Tcl interpreter thread are premises. Nonlocal escape, interpreter/global teardown, cross-owner callbacks and dynamic C closure ABI remain separate.";
  attribute stage:String="BLOCKED_ORIGINAL_CONSUMERS; selected four-path implementation and callback PBT pass; final original GSI407/408 twice, retained without further retries. No publication/five-gate closure or approval of remaining mixed-feature prototype index.";
  attribute contract:String="Tcl owns ClientData on entry. Add one existing RC ownership before any payload read; pass only the stable native RC identity through the real SFUN pointer and string-list conversions. After those conversions and marker construction, Scheme reads the updated payload through the existing data_rc API and applies the contained procedure. Each normally returning callback releases its own RC owner once; command deletion releases only Tcl ownership. Zero-owner unlinks only after the last active callback returns.";
  attribute consumer:String="Production scheme_call_cmd in command.h and c-define tcltk_call in tcltk.scm form one changed private ABI. The Scheme tcltk-call name and Tcl result/string ownership remain. No direct SCMOBJ payload crosses argument conversion. Test header and Scheme entry are source-equal adapters around a real Tcl dispatcher and generated SFUN; no stub substitutes the Scheme callback.";
  attribute memoryOrder:String="Existing RC domain mutex serializes count add/release and unlink; no new atomic. Valid same interpreter thread serializes dispatch/deletion before first pin. RC ownership keeps the record in its existing scan domain during marker/string conversion and body GC. Existing moving collector updates data/vector cells. Reentrant nested delete cannot free an RC record held by any outer callback. Foreign concurrent calls or arbitrary external ClientData mutations are outside admission.";
  attribute cost:String="One extra RC add/release pair and two existing domain-gate intervals per callback; one pointer-to-Scheme foreign wrapper of9 accounted words/72 bytes on this8-byte profile and decoding per generated entry, with generator-owned refcount release on normal return and physical retirement at later still sweep. No new VM fields, root records, native table or per-command metadata. Existing still vector remains reachable until all callback owners return after deletion. Count wrapper allocation and overlapping existing roots; no measured throughput/RSS or worker-independence claim.";
  attribute benefit:String="Removes raw Scheme payload delivery across allocating native entry conversions and ownership inferred only from a Tcl command name. Command retirement and active callback lifetime become independently accounted using existing RC support; recursive calls and command self-deletion retain GC reachability without a second registry or compatibility namespace.";
  attribute unknown:String="A Scheme exception/nonlocal continuation escaping through Tcl, foreign cancellation or interpreter destruction is not proven to return the acquired pin. Such boundaries are not admitted by this leaf; result-style exception containment and activation cleanup remain open. No timeout or unknown return permits root/resource reclamation. Existing RC overflow terminates through contract failure rather than authorizing a phantom pin.";
  attribute formalDuty:String="SysML owns entry/borrow/delete/effect and cost premises. Source refinement checks pin/read order, exact production Scheme entry, original public API use, Tcl dispatcher/deletion source and real generated conversions. Native PBT covers actual Tcl nesting/deletion and moving GC, exact old-source no-pin control calibrated against the same probe with an externally supplied owner and serialized replay/shrink. Shared ASCENT separates four static premises from twelve native requirements. QNT keeps root/task competing histories and Lean distinct conditional laws; neither is duplicated or rerun for this synchronous owner-thread adapter.";
  part def Need { ref part gate:GambitCommitGates::Gate; attribute id:String; attribute method:String; attribute artifact:String; attribute scope:String; }
  part native:Need { ref part :>> gate=GambitCommitGates::tests; attribute :>> id="TCL-CALLBACK-NATIVE"; attribute :>> method="native"; attribute :>> artifact="evidence/research/retained/modern-c/tcl-callback/receipt.json"; attribute :>> scope="Actual Tcl dispatcher/header and generated Scheme entry, moving GC/nested delete and real predecessor replay/shrink; full binding compile, existing construction PBT, stock producer and original consumers"; }
  part learning:Need { ref part :>> gate=GambitCommitGates::learning; attribute :>> id="TCL-CALLBACK-LEARNING"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/tcl-callback.org"; attribute :>> scope="Native identity versus Scheme address, command ownership versus active callback lifetime; RC gate/wrapper costs and normal-return/thread premises"; }
  part process:Need { ref part :>> gate=GambitCommitGates::process; attribute :>> id="TCL-CALLBACK-PROCESS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/tcl-callback.org"; attribute :>> scope="One complete leaf, remaining whole-path inventory recomputed, parent ROOTS/SMP ledgers remain separate; no unqualified prototype admission"; }
  part models:Need { ref part :>> gate=GambitCommitGates::models; attribute :>> id="TCL-CALLBACK-MODELS"; attribute :>> method="source-refinement"; attribute :>> artifact="dev/refactoring/modern-c/tcl-callback.org"; attribute :>> scope="Native SysML and actual ASCENT source/native/case checks, exact C/header/Scheme entry bridge; QNT/Lean distinct and unchanged"; }
  part questions:Need { ref part :>> gate=GambitCommitGates::questions; attribute :>> id="TCL-CALLBACK-QUESTIONS"; attribute :>> method="source-analysis"; attribute :>> artifact="dev/refactoring/modern-c/tcl-callback.org"; attribute :>> scope="Who pins before payload access, which conversion may collect, how nested deletion leaves one owner, how wrappers retire and which nonlocal exits stay open"; }
}
