  "sourceCases": [
    {
      "id": "environmentQualification",
      "precondition": "Runtime owner selects exact source/compiler/profile/generated C/artifact subject; declare exposure boundary and preserve complete root/census/heap budgets.",
      "argument": "The existing req1 call allocates one three-field vector. Avoidable allocation can be claimed only for calls whose environment remains unexposed for the complete required lifetime. Exposed calls retain one canonical rooted materialization; partial or UNKNOWN materialization keeps source custody and forbids slot reuse. Closure and continuation observers must agree after movement and multiple restores.",
      "conclusion": "A complete source-adapter and native acceptance unit is specified. Neither literal coverage, component primitive success nor SDK validation proves an optimized environment or stress-family completion.",
      "missing": "Implement and qualify rooted transient representation, escape detection, exact alias-preserving materialization, GC rewrite/reentry and last-observer retirement as one runtime-owned responsibility. Measure eligible fraction rather than infer it from allocation-counter proximity.",
      "acceptance": "Ordinary/tail and non-tail calls; retained mutable closure; capture then mutate then restore twice across GC; reflective procedure/continuation access; hook retention and exception; serializer success/refusal and admitted native aliases; materialization result loss and late exit. Rerun unchanged original whole GSI/GSC stress in order on the selected producer. Compare allocation, scanned words, pause, throughput and physical peak without widening budgets.",
      "formalBoundary": "Existing QNT owns publication/query/ACK/retirement ordering. Existing Lean owns exact slots, relocation and shared lexical identity. Source adapters establish their premises; no second QNT or Lean proof is added.",
      "counterexample": "Tail-reusing one vector changes an escaped closure captured in an earlier iteration; copying its environment per continuation shot breaks set! sharing; preserving referent liveness while missing one alias still leaves a stale slot. A near allocation-statistic match is not proof of whole-TFIB speedup.",
      "clause": "environmentQualificationClause",
      "entrySite": "environmentAllocate",
      "exitSite": "environmentContinuationExposure"
    }
  ],
