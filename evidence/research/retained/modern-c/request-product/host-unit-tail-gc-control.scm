(define steps 0)
(define dispatch (vector #f #f))
(define (advance n target)
  (set! steps (+ steps 1))
  (if (= (modulo n 1000) 0) (##gc))
  (if (= n 0) steps ((vector-ref dispatch target) (- n 1))))
(vector-set! dispatch 0 (lambda (n) (advance n 1)))
(vector-set! dispatch 1 (lambda (n) (advance n 0)))
(if (not (= ((vector-ref dispatch 0) 100000) 100001))
    (error "cross-host tail/GC result" steps))
(display "HOST-TAIL-GC-PASS\n")
