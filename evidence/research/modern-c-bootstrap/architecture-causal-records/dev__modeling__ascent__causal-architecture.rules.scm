;; SysML drives requirements/dependencies. Exact-source, artifact and scope
;; matches preserve the distinction between conditional law and C refinement.
(relation causalArgument (component))
(relation causalIdentity (source profile))
(relation causalNeed (component method artifact digest scope))
(relation causalObservation (component method artifact digest scope source profile))
(relation causalDependency (dependent prerequisite))
(relation causalGateNeed (gate component))
(relation causalFailure (source profile receipt))
(relation causalMatched (component method))
((causalMatched C M) <-- (causalNeed C M A H T)
 (causalObservation C M A H T S P) (causalIdentity S P))
(relation causalGap (component method))
((causalGap C M) <-- (causalNeed C M _ _ _) (not (causalMatched C M)))
(relation causalDepends (dependent prerequisite))
((causalDepends C P) <-- (causalDependency C P))
((causalDepends C P) <-- (causalDepends C Q) (causalDependency Q P))
(relation causalBlocked (component))
((causalBlocked C) <-- (causalGap C _))
((causalBlocked C) <-- (causalArgument C) (causalDepends C P) (causalGap P _))
((causalBlocked C) <-- (causalArgument C) (causalIdentity S P) (causalFailure S P _))
(relation causalGateBlocked (gate component))
((causalGateBlocked G C) <-- (causalGateNeed G C) (causalBlocked C))
(relation causalReady (component))
((causalReady C) <-- (causalArgument C) (not (causalBlocked C)))
(relation question (claim))
((question C) <-- (causalArgument C))
