direction: right
vars: { d2-config: { layout-engine: elk } }
evidence: "Historical failure / patch evidence"
sysml: "SysML causal arguments and canonical owners"
ascent: "ASCENT: exact evidence + prerequisite gaps"
exit: "exit: architecture/runtime/execution"
sysml -> exit: conditional exclusion argument
exit -> ascent: C refinement / progress / retirement / benefit
work: "work: architecture/runtime/gc"
sysml -> work: conditional exclusion argument
work -> ascent: C refinement / progress / retirement / benefit
copy: "copy: architecture/runtime/interfaces"
sysml -> copy: conditional exclusion argument
copy -> ascent: C refinement / progress / retirement / benefit
ffi: "ffi: architecture/runtime/ffi"
sysml -> ffi: conditional exclusion argument
ffi -> ascent: C refinement / progress / retirement / benefit
release: "release: architecture/runtime/ffi"
sysml -> release: conditional exclusion argument
release -> ascent: C refinement / progress / retirement / benefit
frames: "frames: architecture/compiler"
sysml -> frames: conditional exclusion argument
frames -> ascent: C refinement / progress / retirement / benefit
profile: "profile: architecture/toolchain"
sysml -> profile: conditional exclusion argument
profile -> ascent: C refinement / progress / retirement / benefit
generation: "generation: architecture/compiler"
sysml -> generation: conditional exclusion argument
generation -> ascent: C refinement / progress / retirement / benefit
ffi -> work: "Worker independence needs a complete frozen root view and park/reload protocol"
frames -> copy: "Unique object authority alone does not prove frame coordinates or structural link completion"
work -> exit: "Participant withdrawal cannot discard private or descendant work"
release -> exit: "Final callbacks and resources can outlive execution admission"
generation -> frames: "Frame consumers share a Scheme-owned semantic source"
profile -> generation: "Native results qualify only the actual generated/header/object closure"
evidence -> sysml
formal: "QNT finite histories + conditional Lean laws"
native: "Exact-source bootstrap / roots / multi-shot / GC"
formal -> ascent
native -> ascent
open: "OPEN: composed C refinement, full inventories and measured net benefit" { style.fill: "#fff0dc" }
ascent -> open
