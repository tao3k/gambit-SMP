direction: right
COPY_FROZEN: "COPY-FROZEN: mem.c setup_stack_heap_vmstate; ___garbage_collect_pstate"
COPY_SOURCE: "COPY-SOURCE: mem.c require_fromspace_copy_source; change_object_scan_state; publish_object_scan; mark_array; mark_captured_continuation; scan"
ABORT_ISOLATION: "ABORT-ISOLATION: setup.c start_processor_execution; ___vm_resize_pstate; os_thread.c start_pthread_thread; mem.c ___isolate_aborted_resize"
CHUNK_TRANSPORT: "CHUNK-TRANSPORT: mem.c lock_chunk_fifo; unlock_chunk_fifo; take_heap_chunk; require_chunk_transition; end_heap_chunk; scan_complete_heap_chunk; scan_movable_objs_to_scan; mark_reachable_from_marked"
FRAME_ACCESS: "FRAME-ACCESS: mem.c acquire_frame_access; release_frame_access; mark_captured_continuation_locked; mark_captured_continuation; mark_continuation; mark_frame; scan; ___frame_ordinary_root_begin"
COPY_RESERVATION: "COPY-RESERVATION: mem.c reserve_copy; cancel_copy; commit_copy; finish_tail; mark_array; mark_captured_continuation_locked; garbage_collect_mark_weak_phase"
COPY_FROZEN -> COPY_SOURCE: "Source upper bound may become capacity evidence only after unique scanning and destination packing are proved."
ABORT_ISOLATION -> COPY_FROZEN: "Old collective publishes abort_isolated before healthy GC; detached empty intervals may be reused, stable native identity must not be overwritten."
CHUNK_TRANSPORT -> COPY_SOURCE: "Disjoint chunk traversal requests do not replace the per-object write claim; copy-winner Tail and special frame links retain separate custody."
FRAME_ACCESS -> COPY_SOURCE: "A scanner claiming a raw-ready frame must acquire the frame domain before reading the structural link or ordinary roots; constructor writes precede release."
COPY_RESERVATION -> COPY_FROZEN: "Private grants and known-result refunds provide physical accounting premises; they do not alone establish U, Amax or a pre-flip whole-round grant."
COPY_RESERVATION -> FRAME_ACCESS: "Captured-frame payload construction uses the same contiguous reservation and commit endpoints; frame/link publication does not erase allocation debt."
sysml: SysML contracts and handoffs
ascent: ASCENT identity and evidence-class joins
quint: QNT bounded custody / rejection histories
lean: Lean conditional bounds and isolation premises
source: Current Modern C source lock
native: Exact Bazel O1/O3 bootstrap and p11
open: "OPEN: C pointer/root/frame refinement, full-round packing and native failure; commit blocked" {style.fill: "#fff0dc"}
sysml -> ascent
ascent -> quint
ascent -> lean
ascent -> source
ascent -> native
COPY_SOURCE -> open
COPY_FROZEN -> open
ABORT_ISOLATION -> open
FRAME_ACCESS -> open
COPY_RESERVATION -> open
