index 3a845ffd..1f688458 100644
--- a/include/gambit.h.in
+++ b/include/gambit.h.in
@@ -8058,31 +8058,33 @@ switch (na) \
 
 /*---------------------------------------------------------------------------*/
 
+/* These temporary roots belong to the execution context scanned by
+ * mark_execution_roots, not to the carrier executing the allocation. */
 #define ___GC_SAVE1(ps,a) \
-((ps)->saved[0] = (a))
+((ps)->context->saved[0] = (a))
 
 #define ___GC_RESTORE1(ps,a) \
-(a = (ps)->saved[0], \
+(a = (ps)->context->saved[0], \
  ___GC_SAVE1(ps,___VOID))
 
 #define ___GC_SAVE2(ps,a,b) \
-((ps)->saved[0] = (a), \
- (ps)->saved[1] = (b))
+((ps)->context->saved[0] = (a), \
+ (ps)->context->saved[1] = (b))
 
 #define ___GC_RESTORE2(ps,a,b) \
-(a = (ps)->saved[0], \
- b = (ps)->saved[1], \
+(a = (ps)->context->saved[0], \
+ b = (ps)->context->saved[1], \
  ___GC_SAVE2(ps,___VOID,___VOID))
 
 #define ___GC_SAVE3(ps,a,b,c) \
-((ps)->saved[0] = (a), \
- (ps)->saved[1] = (b), \
- (ps)->saved[2] = (c))
+((ps)->context->saved[0] = (a), \
+ (ps)->context->saved[1] = (b), \
+ (ps)->context->saved[2] = (c))
 
 #define ___GC_RESTORE3(ps,a,b,c) \
-(a = (ps)->saved[0], \
- b = (ps)->saved[1], \
- c = (ps)->saved[2], \
+(a = (ps)->context->saved[0], \
+ b = (ps)->context->saved[1], \
+ c = (ps)->context->saved[2], \
  ___GC_SAVE3(ps,___VOID,___VOID,___VOID))
 
 /*---------------------------------------------------------------------------*/
