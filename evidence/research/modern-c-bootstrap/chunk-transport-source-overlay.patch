+                      (set! hash-calls (+ hash-calls 1))
+                      (vector-ref key 0))))
+(define native-index (make-table test: eq?))
+(for-each (lambda (key)
+            (table-set! scheme-index key (vector-ref key 0))
+            (table-set! native-index key (vector-ref key 0)))
+          index-keys)
