(define-evidence (query) (sources) (outputs rweProtocolTested rweProtocolScheduleChecked rweProtocolUnmapped rweProtocolNativeObserved rweProtocolSliceObserved rweProtocolCGap rweRetirementReady)
(relation smpModernReady (id))
;; Subordinate source-retirement criteria. No scheduler/algebra model duplicated.
(relation rweProtocol (id model digest status) (("capacity-publication" "dev/refactoring/modern-c/models/quint/round_capacity.qnt" "329a24814f436f17732a69b52fef6300c60d8aad052edfbb727069e63c65f123" "finite-model-check-required-C-adapter-open") ("sfun-writer-publication" "models/gambit/host_roots_contract.qnt" "c86e852022577fac2ad3fa05d387119ce949a9b5a4b9ee20b3d920fdea48355c" "finite-model-check-required-C-adapter-open") ("hash-layout-ownership" "dev/refactoring/modern-c/models/quint/hash_index_owner.qnt" "aae16931cf9859c2412b29c1b15969d71b46d41fb42eec5c948b2ac602e1e432" "finite-model-check-required-C-adapter-open")))
(relation rweProtocolTest (id modelDigest resultDigest outcome) (("capacity-publication" "329a24814f436f17732a69b52fef6300c60d8aad052edfbb727069e63c65f123" "30b7f18172660885170be52c43e8593751e8896f7b248b671b9a2fd68a4ded61" "pass") ("sfun-writer-publication" "c86e852022577fac2ad3fa05d387119ce949a9b5a4b9ee20b3d920fdea48355c" "cc639455521ba593139b78af79d2625bb2a3f7d7063efd13469d9ccb72090ae1" "pass") ("hash-layout-ownership" "aae16931cf9859c2412b29c1b15969d71b46d41fb42eec5c948b2ac602e1e432" "79d96a07f25dd1a21d2f75c2d785c09b2f8a018c7147d558134baab33bb6bd8f" "pass")))
(relation rweProtocolTested (id))
((rweProtocolTested I) <-- (rweProtocol I _ H _) (rweProtocolTest I H _ "pass"))
(relation rweProtocolSafety (id modelDigest resultDigest outcome) (("capacity-publication" "329a24814f436f17732a69b52fef6300c60d8aad052edfbb727069e63c65f123" "2a8472cf0b597f8c9a0f4fd2ee1624d721a6125906916e1ebee289918f69f112" "pass") ("sfun-writer-publication" "c86e852022577fac2ad3fa05d387119ce949a9b5a4b9ee20b3d920fdea48355c" "703f2f2480c5e754f65fc957100e61ca40b35f24cfbc9c946de498e45fb415dc" "pass") ("hash-layout-ownership" "aae16931cf9859c2412b29c1b15969d71b46d41fb42eec5c948b2ac602e1e432" "bb950d2b9aa10f87289661340fec35ca1cb05ef5d8efd1409724152d414363ef" "pass")))
(relation rweProtocolControl (id modelDigest resultDigest outcome) (("capacity-publication" "329a24814f436f17732a69b52fef6300c60d8aad052edfbb727069e63c65f123" "bf6ec688b532015dccb1728d81252dc21a755baf51cbea8e3a4a7220c65bc097" "pass") ("sfun-writer-publication" "c86e852022577fac2ad3fa05d387119ce949a9b5a4b9ee20b3d920fdea48355c" "4eacc56bb953f22a09c0dc68618e41b95e9f177b667056d1bbeb5bdf7dd6c581" "pass") ("hash-layout-ownership" "aae16931cf9859c2412b29c1b15969d71b46d41fb42eec5c948b2ac602e1e432" "189ddfa7766852d006085ba5cca4b62cadc8e51b4bcb2450f4eb2b55a9de70a1" "pass")))
(relation rweProtocolAction (id action) (("capacity-publication" "freeze") ("capacity-publication" "discover") ("capacity-publication" "closeCensus") ("capacity-publication" "reserveAt") ("capacity-publication" "acknowledge") ("capacity-publication" "publishPlan") ("capacity-publication" "flip") ("capacity-publication" "refuse") ("capacity-publication" "observe") ("capacity-publication" "returnRefused") ("capacity-publication" "unknownResult") ("capacity-publication" "retain") ("sfun-writer-publication" "protect") ("sfun-writer-publication" "acquireWriter") ("sfun-writer-publication" "convert") ("sfun-writer-publication" "releaseWriter") ("sfun-writer-publication" "closeWriters") ("sfun-writer-publication" "freeze") ("sfun-writer-publication" "acquire") ("sfun-writer-publication" "relocate") ("sfun-writer-publication" "reload") ("sfun-writer-publication" "allocateMarker") ("sfun-writer-publication" "storeArgument") ("sfun-writer-publication" "enter") ("sfun-writer-publication" "leave") ("sfun-writer-publication" "release") ("hash-layout-ownership" "beginRead") ("hash-layout-ownership" "visit") ("hash-layout-ownership" "finishRead") ("hash-layout-ownership" "freeze") ("hash-layout-ownership" "relocate") ("hash-layout-ownership" "repairStable") ("hash-layout-ownership" "resume") ("hash-layout-ownership" "lookup") ("hash-layout-ownership" "ownedRebuild") ("hash-layout-ownership" "deserialize")))
(relation rweProtocolStep (id action sourceDigest boundaryDigest progress) ())
(relation rweProtocolMapped (id action))
((rweProtocolMapped I A) <-- (rweProtocolAction I A) (rweProtocolStep I A _ _ _))
(relation rweProtocolUnmapped (id action))
((rweProtocolUnmapped I A) <-- (rweProtocolAction I A) (not (rweProtocolMapped I A)))
(relation rweProtocolScheduleChecked (id))
((rweProtocolScheduleChecked I) <-- (rweProtocol I _ H _) (rweProtocolTested I)
 (rweProtocolSafety I H _ "pass") (rweProtocolControl I H _ "pass")
 (not (rweProtocolUnmapped I _)))
;; Observed native qualification is separate from a mathematical C refinement.
;; The adapter reuses the framework's current source/tool/artifact inspector.
(relation rweProtocolNative (id sourceDigest profileDigest resultDigest outcome) (("hash-layout-ownership" "15ad64c1f0c7acfbc5cf7e35ee33f0f96fa1e54f7c38d368833007aa985984d4" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "307eb0425a5e7e82042b896f73b33e55c72e0defae24b59d934be642d7e76287" "pass")))
(relation rweProtocolNativeObserved (id))
((rweProtocolNativeObserved I) <-- (rweProtocol I _ _ _)
 (rweProtocolNative I _ _ _ "pass"))
(relation rweProtocolSliceObserved (id))
((rweProtocolSliceObserved I) <-- (rweProtocolScheduleChecked I)
 (rweProtocolNativeObserved I))
;; Model tests never manufacture a C refinement. An explicit adapter proof is
;; deliberately absent until its separate source/native premises close.
(relation rweProtocolCRefined (id))
(relation rweProtocolCGap (id))
((rweProtocolCGap I) <-- (rweProtocol I _ _ _) (not (rweProtocolCRefined I)))
(relation rweIdentity (source profile upstream))
(relation rweClause (id factor contract))
(relation rweWitness (id file digest))
(relation rweUse (clause witness))
(relation rweLocated (id))
((rweLocated C) <-- (rweClause C _ _) (rweUse C W) (rweWitness W _ _))
(relation rweDependency (dependent prerequisite))
(relation rweEvidence (id method source contract outcome))
(relation rwePass (outcome) (("pass")))
(relation rweRejected (id))
((rweRejected C) <-- (rweClause C _ H) (rweIdentity S _ _)
 (rweEvidence C "source" S H O) (not (rwePass O)))
(relation rweSupplied (id))
((rweSupplied C) <-- (rweClause C _ H) (rweIdentity S _ _)
 (rweEvidence C "source" S H "pass") (not (rweRejected C)))
(relation rweGap (clause cause))
((rweGap C C) <-- (rweClause C _ _) (not (rweSupplied C)))
((rweGap C G) <-- (rweDependency C P) (rweGap P G))
(relation rweBlocked (id))
((rweBlocked C) <-- (rweGap C _))
(relation rweLocalCovered (id))
((rweLocalCovered C) <-- (rweClause C _ _) (not (rweBlocked C)))
(relation rweNativeCase (id contract))
(relation rweNativeEvidence (id method source profile contract outcome))
(relation rweNativeRejected (id))
((rweNativeRejected C) <-- (rweNativeCase C H) (rweIdentity S P _)
 (rweNativeEvidence C "native" S P H O) (not (rwePass O)))
(relation rweNativeSupplied (id))
((rweNativeSupplied C) <-- (rweNativeCase C H) (rweIdentity S P _)
 (rweNativeEvidence C "native" S P H "pass") (not (rweNativeRejected C)))
(relation rweNativeMissing (id))
((rweNativeMissing C) <-- (rweNativeCase C _) (not (rweNativeSupplied C)))
(relation rweCandidate (id))
(relation rweRetirementReady (id))
((rweRetirementReady C) <-- (rweCandidate C) (not (rweBlocked _))
 (not (rweNativeMissing _)) (smpModernReady C))

;; A source-bound native slice, deliberately separate from whole retirement.
;; Guards are adapted from actual observations, never arbitrary proof flags.
(relation rwePhaseIdentity (source profile contract))
(relation rwePhaseGuard (source profile contract guard))
(relation rwePhaseReady (source profile contract))
((rwePhaseReady S P H) <-- (rwePhaseIdentity S P H)
 (rwePhaseGuard S P H "exact-source")
 (rwePhaseGuard S P H "original-profile")
 (rwePhaseGuard S P H "same-workspace")
 (rwePhaseGuard S P H "phase-kernel")
 (rwePhaseGuard S P H "topology-and-map")
 (rwePhaseGuard S P H "calibrated-unknown-join")
 (rwePhaseGuard S P H "fresh-processes")
 (rwePhaseGuard S P H "bounded-budgets"))

;; Independent-refill slice; deliberately grants no unequal-count admission.
(relation rweArenaIdentity (source profile contract))
(relation rweArenaGuard (source profile contract guard))
(relation rweArenaReady (source profile contract))
((rweArenaReady S P H) <-- (rweArenaIdentity S P H)
 (rweArenaGuard S P H "exact-source")
 (rweArenaGuard S P H "original-profile")
 (rweArenaGuard S P H "same-workspace")
 (rweArenaGuard S P H "arena-kernel")
 (rweArenaGuard S P H "topology-and-map")
 (rweArenaGuard S P H "refill-exercised")
 (rweArenaGuard S P H "calibrated-unknown-join")
 (rweArenaGuard S P H "authenticated-executions")
 (rweArenaGuard S P H "bounded-budgets"))

;; SysML owns the full unequal-count admission inventory. Empty proof facts
;; never imply completion: the adapter checks the exact required inventory.
(relation rweWorkerRequirement (id contract))
(relation rweWorkerCandidate (source profile contract))
(relation rweWorkerEvidence (source profile contract id obligation))
((rweWorkerEvidence S P H "independent-refill" C) <--
 (rweArenaReady S P H) (rweWorkerRequirement "independent-refill" C))
(relation rweWorkerMissing (source profile contract id))
((rweWorkerMissing S P H C) <-- (rweWorkerCandidate S P H)
 (rweWorkerRequirement C O) (not (rweWorkerEvidence S P H C O)))
(relation rweUnequalReady (source profile contract))
((rweUnequalReady S P H) <-- (rweWorkerCandidate S P H)
 (rweWorkerBase S P H) (not (rweWorkerMissing S P H _)))

;; W scan executors plus R owner-domain services. Source/native slice only.
(relation rweDomainsIdentity (source profile contract))
(relation rweDomainsGuard (source profile contract guard))
(relation rweDomainsReady (source profile contract))
((rweDomainsReady S P H) <-- (rweDomainsIdentity S P H)
 (rweDomainsGuard S P H "exact-source")
 (rweDomainsGuard S P H "original-profile")
 (rweDomainsGuard S P H "same-workspace")
 (rweDomainsGuard S P H "domain-kernel")
 (rweDomainsGuard S P H "topology-and-map")
 (rweDomainsGuard S P H "refill-exercised")
 (rweDomainsGuard S P H "calibrated-unknown-join")
 (rweDomainsGuard S P H "authenticated-executions")
 (rweDomainsGuard S P H "bounded-budgets")
 (rweDomainsGuard S P H "owner-domain-service"))
(relation rweDomainSupplied (id) (("independent-refill") ("resume-coverage")
 ("affine-cleanup") ("collective-split") ("descendant-termination")))
((rweWorkerEvidence S P H C O) <-- (rweDomainsReady S P H)
 (rweDomainSupplied C) (rweWorkerRequirement C O))

(relation rweWorkerBase (source profile contract))
((rweWorkerBase S P H) <-- (rweArenaReady S P H))
((rweWorkerBase S P H) <-- (rweDomainsReady S P H))

;; Owner-generation and rejection evidence supplies the existing five local
;; role conditions only. It never supplies native-writer-closure wholesale.
(relation rweOwnerIdentity (source profile contract))
(relation rweOwnerGuard (source profile contract guard))
(relation rweOwnerReady (source profile contract))
((rweOwnerReady S P H) <-- (rweOwnerIdentity S P H)
 (rweOwnerGuard S P H "exact-source")
 (rweOwnerGuard S P H "original-profile")
 (rweOwnerGuard S P H "same-workspace")
 (rweOwnerGuard S P H "domain-kernel")
 (rweOwnerGuard S P H "topology-and-map")
 (rweOwnerGuard S P H "refill-exercised")
 (rweOwnerGuard S P H "calibrated-unknown-join")
 (rweOwnerGuard S P H "authenticated-executions")
 (rweOwnerGuard S P H "bounded-budgets")
 (rweOwnerGuard S P H "owner-domain-service")
 (rweOwnerGuard S P H "fresh-still-generation")
 (rweOwnerGuard S P H "refusal-before-effects")
 (rweOwnerGuard S P H "native-run-abi")
 (rweOwnerGuard S P H "write-authority")
 (rweOwnerGuard S P H "copy-before-reserve")
 (rweOwnerGuard S P H "source-bounded-request")
 (rweOwnerGuard S P H "closed-root-domain"))
((rweWorkerBase S P H) <-- (rweOwnerReady S P H))
((rweWorkerEvidence S P H C O) <-- (rweOwnerReady S P H)
 (rweDomainSupplied C) (rweWorkerRequirement C O))
(relation rweNativeBoundary (id contract admission))
(relation rweNativeUnresolved (id))
((rweNativeUnresolved I) <-- (rweNativeBoundary I _ "unresolved"))

;; Source families are not a finite census of third-party raw native stores.
;; Located witnesses and a tested primitive never discharge writer closure.
(relation rweWriterBoundary (id source contract status))
(relation rweWriterEnforced (status) (("enforced")))
(relation rweWriterUnresolved (id))
((rweWriterUnresolved I) <-- (rweWriterBoundary I _ _ S)
 (not (rweWriterEnforced S)))

;; Capacity premises are source-refinement obligations, not another model.
(relation rweCapacityBoundary (id contract outcome))
(relation rweCapacityUnresolved (id))
((rweCapacityUnresolved I) <-- (rweCapacityBoundary I _ "unresolved"))

)
