{
  "schema": "evidence-recipe.v2",
  "id": "stack-call-preflight-bootstrap",
  "scope": "Two-pass bootstrap for the source-locked call-boundary preflight candidate. Original stage budgets and GNU GCC profile; diagnostic bootstrap is not native stress admission.",
  "workspacePolicy": "isolated",
  "timeoutPolicy": {"mode": "progress", "overheadSeconds": 30},
  "inputs": [
    "evidence/fixtures/darwin-stack-call-preflight/source.lock.json",
    "patches/fixtures/darwin-stack-call-preflight.patch",
    "evidence/fixtures/darwin-stack-call-preflight/review-contract.json",
    "evidence/fixtures/gerbil-bazel-build-profile/profile.json",
    "evidence/research/stack-check-poll-kind/bootstrap-intent.json",
    "evidence/native-failures.json",
    "evidence/research/suite-review-rules.ss",
    "evidence/research/execution-rules.ss",
    "evidence/fixtures/darwin-stack-write-boundary/native-observation-20261016.json"
  ],
  "steps": [
    {"id": "source", "capability": "gambit.materialize", "dependsOn": [], "budgetSeconds": 30,
      "arguments": {"sourceLock": "evidence/fixtures/darwin-stack-call-preflight/source.lock.json"}},
    {"id": "configure", "capability": "gambit.configure", "dependsOn": ["source"], "budgetSeconds": 60,
      "arguments": {"source": {"step": "source", "output": "source"},
        "buildProfile": "evidence/fixtures/gerbil-bazel-build-profile/profile.json"}},
    {"id": "seed", "capability": "gambit.seed-core", "dependsOn": ["configure"], "budgetSeconds": 130,
      "arguments": {"source": {"step": "configure", "output": "source"}}},
    {"id": "review", "capability": "gambit.review", "dependsOn": ["seed"], "budgetSeconds": 15,
      "arguments": {"runtime": {"step": "seed", "output": "runtime"},
        "identity": {"step": "seed", "output": "identity"},
        "intent": "evidence/research/stack-check-poll-kind/bootstrap-intent.json",
        "target": "bootstrap"}},
    {"id": "bootstrap", "capability": "gambit.bootstrap", "dependsOn": ["seed", "review"], "budgetSeconds": 270,
      "arguments": {"runtime": {"step": "seed", "output": "runtime"},
        "identity": {"step": "seed", "output": "identity"},
        "retryReview": {"step": "review", "output": "review"},
        "failures": "evidence/native-failures.json",
        "reviewRules": "evidence/research/suite-review-rules.ss"}},
    {"id": "verdict", "capability": "evidence.evaluate",
      "dependsOn": ["source", "configure", "seed", "review", "bootstrap"], "budgetSeconds": 10,
      "arguments": {"rules": ["evidence/research/execution-rules.ss"],
        "queries": {"missing": "missing_step"}, "expected": {"missing": []}}}
  ]
}
