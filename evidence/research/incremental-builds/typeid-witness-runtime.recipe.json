{
  "schema": "evidence-recipe.v2",
  "id": "typeid-witness-runtime-incremental",
  "scope": "Build the runtime whose ##wr-structure records the type word class and stops before TYPEID. This is an observation, not a repair and not 9/12.",
  "workspacePolicy": "in-place",
  "timeoutPolicy": {
    "mode": "progress",
    "overheadSeconds": 30
  },
  "inputs": [
    "evidence/research/processor-interrupt-collective-wait/handler-quiet-while-pending.lock.json",
    "patches/fixtures/handler-quiet-while-pending-cumulative.patch",
    "evidence/fixtures/gerbil-bazel-build-profile/profile.json",
    "evidence/research/execution-rules.ss",
    "evidence/research/incremental-builds/migration.json"
  ],
  "steps": [
    {
      "id": "source",
      "capability": "gambit.materialize",
      "dependsOn": [],
      "budgetSeconds": 60,
      "arguments": {
        "sourceLock": "evidence/research/processor-interrupt-collective-wait/handler-quiet-while-pending.lock.json",
        "buildWorkspace": "gambit-core"
      }
    },
    {
      "id": "configure",
      "capability": "gambit.configure",
      "dependsOn": [
        "source"
      ],
      "budgetSeconds": 120,
      "arguments": {
        "source": {
          "step": "source",
          "output": "source"
        },
        "buildProfile": "evidence/fixtures/gerbil-bazel-build-profile/profile.json"
      }
    },
    {
      "id": "seed",
      "capability": "gambit.seed-core",
      "dependsOn": [
        "configure"
      ],
      "budgetSeconds": 180,
      "arguments": {
        "source": {
          "step": "configure",
          "output": "source"
        }
      }
    },
    {
      "id": "core",
      "capability": "gambit.source-core",
      "dependsOn": [
        "seed"
      ],
      "budgetSeconds": 600,
      "arguments": {
        "runtime": {
          "step": "seed",
          "output": "runtime"
        }
      }
    },
    {
      "id": "verdict",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "source",
        "configure",
        "seed",
        "core"
      ],
      "budgetSeconds": 10,
      "arguments": {
        "rules": [
          "evidence/research/execution-rules.ss"
        ],
        "queries": {
          "missing": "missing_step"
        },
        "expected": {
          "missing": []
        }
      }
    }
  ],
  "buildMigration": "evidence/research/incremental-builds/migration.json"
}
