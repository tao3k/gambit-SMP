{
  "schema": "evidence-recipe.v2",
  "id": "stack-floor-push-controls",
  "scope": "Finite check that a one-word push from the tospace floor is refused before it writes byte offset 16 of the 24-byte header, and that the 32-byte reservation under stack_break is not that header. The omitted push damages the header. A check that services interrupts is a counterexample. Relations 24-8=16, 4*8=32>24, and 8*8=64>32 are invariant conjuncts. No native bootstrap, stress, runtime, or milestone admission.",
  "budgetSeconds": 400,
  "workspacePolicy": "isolated",
  "inputs": [
    "models/gambit/stack_floor_push_check.qnt",
    "evidence/research/execution-rules.ss",
    "evidence/fixtures/darwin-stack-floor-push/source.lock.json",
    "evidence/fixtures/darwin-stack-floor-push/review-contract.json",
    "patches/fixtures/darwin-stack-floor-push.patch",
    "evidence/fixtures/darwin-stack-write-boundary/native-observation-20261016.json"
  ],
  "steps": [
