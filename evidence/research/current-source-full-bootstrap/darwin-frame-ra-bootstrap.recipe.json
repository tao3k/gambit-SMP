    "evidence/research/current-source-full-bootstrap/darwin-ticket-bootstrap-intent.json",
    "evidence/research/current-source-full-bootstrap/darwin-ticket-bootstrap-causal-review.json",
    "evidence/research/continuation-current-bootstrap/intent.json",
    "evidence/research/continuation-current-bootstrap/causal-review.json",
    "evidence/native-failures.json",
    "evidence/research/suite-review-rules.ss",
    "evidence/research/execution-rules.ss",
