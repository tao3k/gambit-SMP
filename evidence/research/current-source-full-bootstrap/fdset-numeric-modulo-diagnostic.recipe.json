{
  "schema": "evidence-recipe.v2",
  "id": "fdset-numeric-modulo-only-diagnostic",
  "scope": "Same frozen fdset producer and original numerical assertions; isolate GNU modulo scheduling from the already observed no-scheduling diagnostic. Disable modulo scheduling and loop rescheduling only, retaining second instruction scheduling, O1, RTS O3, SMP, multiple threaded VMs and ABI. Independent 90-second phase inactivity windows; no speedup, full-suite or release admission.",
  "workspacePolicy": "in-place",
  "inputs": [
    "models/gambit/compiler_scheduling_diagnostic.qnt",
    "evidence/research/execution-rules.ss",
    "evidence/fixtures/fdset-abort-owned-rollback/source.lock.json",
    "patches/fixtures/fdset-abort-owned-rollback.patch",
    "evidence/research/current-source-full-bootstrap/fdset-completed-producer.json"
  ],
  "steps": [
    {
      "id": "source",
      "capability": "gambit.materialize",
      "dependsOn": [],
      "budgetSeconds": 30,
      "arguments": {
        "sourceLock": "evidence/fixtures/fdset-abort-owned-rollback/source.lock.json",
        "workspace": ".data/fixtures/foreign-origin-public-cleanup-contract-candidate"
      }
    },
    {
      "id": "parse",
      "capability": "quint.parse",
      "dependsOn": [
        "source"
      ],
      "budgetSeconds": 15,
      "arguments": {
        "source": "models/gambit/compiler_scheduling_diagnostic.qnt"
      }
    },
    {
      "id": "typecheck",
      "capability": "quint.typecheck",
      "dependsOn": [
        "parse"
      ],
      "budgetSeconds": 15,
      "arguments": {
        "source": "models/gambit/compiler_scheduling_diagnostic.qnt",
        "parsed": "parse"
      }
    },
    {
      "id": "contract",
      "capability": "quint.verify",
      "dependsOn": [
        "parse",
        "typecheck"
      ],
      "budgetSeconds": 15,
      "arguments": {
        "source": "models/gambit/compiler_scheduling_diagnostic.qnt",
        "parsed": "parse",
        "initializer": "init",
        "step": "step",
        "invariant": "safe",
        "negative": false
      }
    },
    {
      "id": "producer",
      "capability": "gambit.completed-runtime",
      "dependsOn": [
        "source",
        "contract"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "source": {
          "step": "source",
          "output": "source"
        },
        "producer": "evidence/research/current-source-full-bootstrap/fdset-completed-producer.json"
      }
    },
    {
      "id": "numeric",
      "capability": "gambit.compiler-observation",
      "dependsOn": [
        "producer"
      ],
      "budgetSeconds": 300,
      "arguments": {
        "runtime": {
          "step": "producer",
          "output": "runtime"
        },
        "identity": {
          "step": "producer",
          "output": "identity"
        },
        "selection": "03-number/_num.scm",
        "scheduling": "no-modulo",
        "phaseBudgetSeconds": 90
      }
    },
    {
      "id": "verdict",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "source",
        "parse",
        "typecheck",
        "contract",
        "producer",
        "numeric"
      ],
      "budgetSeconds": 10,
      "arguments": {
        "rules": [
          "evidence/research/execution-rules.ss"
        ],
        "queries": {
          "missing": "missing_step"
        },
        "expected": {
          "missing": []
        }
      }
    }
  ],
  "timeoutPolicy": {
    "mode": "progress",
    "overheadSeconds": 30
  }
}
