{
  "schema": "evidence-recipe.v2",
  "id": "original-gsi-loader-numeric-phase-control",
  "scope": "Original numeric fixture under the exact current dynamic-modulo completed producer. Emit identical module-ref/linker-name and original target path; retain configured GNU defaults and execute the unmodified original GSI CLI/exit protocol. Three independently observed real compiler/loader phases with unchanged 90-second inactivity windows. Atomic diagnostic only, not a full-suite or performance PASS.",
  "workspacePolicy": "in-place",
  "inputs": [
    "models/gambit/compiled_phase_loader_contract.qnt",
    "evidence/research/execution-rules.ss",
    "evidence/fixtures/darwin-dynamic-modulo-scope/source.lock.json",
    "patches/fixtures/darwin-dynamic-modulo-scope.patch",
    "evidence/research/current-source-full-bootstrap/dynamic-modulo-completed-producer.json",
    "vendor/gambit/gsc/_gsclib.scm",
    "vendor/gambit/tests/run-unit-tests.scm",
    "vendor/gambit/tests/unit-tests/#.scm"
  ],
  "steps": [
    {
      "id": "source",
      "capability": "gambit.materialize",
      "dependsOn": [],
      "budgetSeconds": 30,
      "arguments": {
        "sourceLock": "evidence/fixtures/darwin-dynamic-modulo-scope/source.lock.json",
        "workspace": ".data/fixtures/foreign-origin-public-cleanup-contract-candidate"
      }
    },
    {
      "id": "parse",
      "capability": "quint.parse",
      "dependsOn": [
        "source"
      ],
      "budgetSeconds": 15,
      "arguments": {
        "source": "models/gambit/compiled_phase_loader_contract.qnt"
      }
    },
    {
      "id": "typecheck",
      "capability": "quint.typecheck",
      "dependsOn": [
        "parse"
      ],
      "budgetSeconds": 15,
      "arguments": {
        "source": "models/gambit/compiled_phase_loader_contract.qnt",
        "parsed": "parse"
      }
    },
    {
      "id": "contract",
      "capability": "quint.verify",
      "dependsOn": [
        "parse",
        "typecheck"
      ],
      "budgetSeconds": 15,
      "arguments": {
        "source": "models/gambit/compiled_phase_loader_contract.qnt",
        "parsed": "parse",
        "initializer": "init",
        "step": "step",
        "invariant": "safe",
        "negative": false,
        "temporal": "completion"
      }
    },
    {
      "id": "producer",
      "capability": "gambit.completed-runtime",
      "dependsOn": [
        "source",
        "contract"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "source": {
          "step": "source",
          "output": "source"
        },
        "producer": "evidence/research/current-source-full-bootstrap/dynamic-modulo-completed-producer.json"
      }
    },
    {
      "id": "numeric",
      "capability": "gambit.compiler-observation",
      "dependsOn": [
        "producer"
      ],
      "budgetSeconds": 300,
      "arguments": {
        "runtime": {
          "step": "producer",
          "output": "runtime"
        },
        "identity": {
          "step": "producer",
          "output": "identity"
        },
        "selection": "03-number/_num.scm",
        "scheduling": "default-control",
        "phaseBudgetSeconds": 90,
        "loader": "original-gsi"
      }
    },
    {
      "id": "verdict",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "source",
        "parse",
        "typecheck",
        "contract",
        "producer",
        "numeric"
      ],
      "budgetSeconds": 10,
      "arguments": {
        "rules": [
          "evidence/research/execution-rules.ss"
        ],
        "queries": {
          "missing": "missing_step"
        },
        "expected": {
          "missing": []
        }
      }
    }
  ],
  "timeoutPolicy": {
    "mode": "progress",
    "overheadSeconds": 30
  }
}
