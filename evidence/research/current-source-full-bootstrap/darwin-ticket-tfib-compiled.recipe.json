{
  "schema": "evidence-recipe.v2",
  "id": "darwin-ticket-tfib-compiled",
  "scope": "Unchanged upstream compiled tfib on the exact newly bootstrapped ticket ownership-acquire runtime. Host-auto topology and original completed-work inactivity window. Single-file result is not full stress, crash-causality or performance qualification.",
  "workspacePolicy": "in-place",
  "timeoutPolicy": {
    "mode": "progress",
    "overheadSeconds": 30
  },
  "inputs": [
    "evidence/fixtures/darwin-ticket-ownership-acquire/source.lock.json",
    "patches/fixtures/darwin-ticket-ownership-acquire.patch",
    "evidence/fixtures/darwin-ticket-ownership-acquire/review-contract.json",
    "evidence/research/current-source-full-bootstrap/darwin-ticket-completed-producer.json",
    "evidence/native-failures.json",
    "evidence/research/suite-review-rules.ss",
    "evidence/research/execution-rules.ss"
  ],
  "steps": [
    {
      "id": "source",
      "capability": "gambit.materialize",
      "dependsOn": [],
      "budgetSeconds": 30,
      "arguments": {
        "sourceLock": "evidence/fixtures/darwin-ticket-ownership-acquire/source.lock.json",
        "workspace": ".data/fixtures/vm-pending-join-retention/source"
      }
    },
    {
      "id": "producer",
      "capability": "gambit.completed-runtime",
      "dependsOn": [
        "source"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "source": {
          "step": "source",
          "output": "source"
        },
        "producer": "evidence/research/current-source-full-bootstrap/darwin-ticket-completed-producer.json"
      }
    },
    {
      "id": "tfib-gsc",
      "capability": "gambit.suite",
      "dependsOn": [
        "producer"
      ],
      "budgetSeconds": 300,
      "arguments": {
        "runtime": {
          "step": "producer",
          "output": "runtime"
        },
        "identity": {
          "step": "producer",
          "output": "identity"
        },
        "mode": "gsc",
        "regime": "whole-parallel",
        "inventory": "stress",
        "selection": [
          "06-thread/tfib_stress.scm"
        ],
        "expectedFiles": [
          "06-thread/tfib_stress.scm"
        ],
        "failures": "evidence/native-failures.json",
        "reviewRules": "evidence/research/suite-review-rules.ss"
      }
    },
    {
      "id": "verdict",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "source",
        "producer",
        "tfib-gsc"
      ],
      "budgetSeconds": 10,
      "arguments": {
        "rules": [
          "evidence/research/execution-rules.ss"
        ],
        "queries": {
          "missing": "missing_step"
        },
        "expected": {
          "missing": []
        }
      }
    }
  ]
}
