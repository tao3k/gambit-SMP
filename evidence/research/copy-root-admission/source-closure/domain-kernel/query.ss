(define-evidence (query) (sources) (outputs rweOwnerReady rweRetirementReady rweNativeUnresolved rweWriterUnresolved rweCapacityUnresolved rweUnequalReady rweWorkerMissing)
(relation smpModernReady (id))
;; Subordinate source-retirement criteria. No scheduler/algebra model duplicated.
(relation rweIdentity (source profile upstream))
(relation rweClause (id factor contract))
(relation rweWitness (id file digest))
(relation rweUse (clause witness))
(relation rweLocated (id))
((rweLocated C) <-- (rweClause C _ _) (rweUse C W) (rweWitness W _ _))
(relation rweDependency (dependent prerequisite))
(relation rweEvidence (id method source contract outcome))
(relation rwePass (outcome) (("pass")))
(relation rweRejected (id))
((rweRejected C) <-- (rweClause C _ H) (rweIdentity S _ _)
 (rweEvidence C "source" S H O) (not (rwePass O)))
(relation rweSupplied (id))
((rweSupplied C) <-- (rweClause C _ H) (rweIdentity S _ _)
 (rweEvidence C "source" S H "pass") (not (rweRejected C)))
(relation rweGap (clause cause))
((rweGap C C) <-- (rweClause C _ _) (not (rweSupplied C)))
((rweGap C G) <-- (rweDependency C P) (rweGap P G))
(relation rweBlocked (id))
((rweBlocked C) <-- (rweGap C _))
(relation rweLocalCovered (id))
((rweLocalCovered C) <-- (rweClause C _ _) (not (rweBlocked C)))
(relation rweNativeCase (id contract))
(relation rweNativeEvidence (id method source profile contract outcome))
(relation rweNativeRejected (id))
((rweNativeRejected C) <-- (rweNativeCase C H) (rweIdentity S P _)
 (rweNativeEvidence C "native" S P H O) (not (rwePass O)))
(relation rweNativeSupplied (id))
((rweNativeSupplied C) <-- (rweNativeCase C H) (rweIdentity S P _)
 (rweNativeEvidence C "native" S P H "pass") (not (rweNativeRejected C)))
(relation rweNativeMissing (id))
((rweNativeMissing C) <-- (rweNativeCase C _) (not (rweNativeSupplied C)))
(relation rweCandidate (id))
(relation rweRetirementReady (id))
((rweRetirementReady C) <-- (rweCandidate C) (not (rweBlocked _))
 (not (rweNativeMissing _)) (smpModernReady C))

;; A source-bound native slice, deliberately separate from whole retirement.
;; Guards are adapted from actual observations, never arbitrary proof flags.
(relation rwePhaseIdentity (source profile contract))
(relation rwePhaseGuard (source profile contract guard))
(relation rwePhaseReady (source profile contract))
((rwePhaseReady S P H) <-- (rwePhaseIdentity S P H)
 (rwePhaseGuard S P H "exact-source")
 (rwePhaseGuard S P H "original-profile")
 (rwePhaseGuard S P H "same-workspace")
 (rwePhaseGuard S P H "phase-kernel")
 (rwePhaseGuard S P H "topology-and-map")
 (rwePhaseGuard S P H "calibrated-unknown-join")
 (rwePhaseGuard S P H "fresh-processes")
 (rwePhaseGuard S P H "bounded-budgets"))

;; Independent-refill slice; deliberately grants no unequal-count admission.
(relation rweArenaIdentity (source profile contract))
(relation rweArenaGuard (source profile contract guard))
(relation rweArenaReady (source profile contract))
((rweArenaReady S P H) <-- (rweArenaIdentity S P H)
 (rweArenaGuard S P H "exact-source")
 (rweArenaGuard S P H "original-profile")
 (rweArenaGuard S P H "same-workspace")
 (rweArenaGuard S P H "arena-kernel")
 (rweArenaGuard S P H "topology-and-map")
 (rweArenaGuard S P H "refill-exercised")
 (rweArenaGuard S P H "calibrated-unknown-join")
 (rweArenaGuard S P H "authenticated-executions")
 (rweArenaGuard S P H "bounded-budgets"))

;; SysML owns the full unequal-count admission inventory. Empty proof facts
;; never imply completion: the adapter checks the exact required inventory.
(relation rweWorkerRequirement (id contract) (("independent-refill" "d64464ab20699f5f72c075f20a55eceb7fb0e8fd7cb462a84b2a8447a700142a") ("resume-coverage" "d0d058ccba5478706e63cd7e58a7cce49598ecf72d038b4402c71d856802e4e3") ("affine-cleanup" "cb8d6757c9238f93d95a35b625f37e2dbcbfc633365d5750985f5176761b93f6") ("collective-split" "2ed330c66b782c5ee8fdae52b0a81925dd08ec466c2c8d669a7c257953bc57bf") ("descendant-termination" "9c24c0e3615bc2b181a879b5ad506a07fc3f7b49d7feec3559fd4c664b871118") ("physical-packing" "0db49faa5f6cfc0b771f6e69e011bfbf2ff7de20e27dc5cdff81bb4370656ee6") ("native-writer-closure" "e5774fe13340423ffd0205c772706cab78921b60ddeb087f63a4ad0eed70ade4")))
(relation rweWorkerCandidate (source profile contract) (("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902")))
(relation rweWorkerEvidence (source profile contract id obligation))
((rweWorkerEvidence S P H "independent-refill" C) <--
 (rweArenaReady S P H) (rweWorkerRequirement "independent-refill" C))
(relation rweWorkerMissing (source profile contract id))
((rweWorkerMissing S P H C) <-- (rweWorkerCandidate S P H)
 (rweWorkerRequirement C O) (not (rweWorkerEvidence S P H C O)))
(relation rweUnequalReady (source profile contract))
((rweUnequalReady S P H) <-- (rweWorkerCandidate S P H)
 (rweWorkerBase S P H) (not (rweWorkerMissing S P H _)))

;; W scan executors plus R owner-domain services. Source/native slice only.
(relation rweDomainsIdentity (source profile contract))
(relation rweDomainsGuard (source profile contract guard))
(relation rweDomainsReady (source profile contract))
((rweDomainsReady S P H) <-- (rweDomainsIdentity S P H)
 (rweDomainsGuard S P H "exact-source")
 (rweDomainsGuard S P H "original-profile")
 (rweDomainsGuard S P H "same-workspace")
 (rweDomainsGuard S P H "domain-kernel")
 (rweDomainsGuard S P H "topology-and-map")
 (rweDomainsGuard S P H "refill-exercised")
 (rweDomainsGuard S P H "calibrated-unknown-join")
 (rweDomainsGuard S P H "authenticated-executions")
 (rweDomainsGuard S P H "bounded-budgets")
 (rweDomainsGuard S P H "owner-domain-service"))
(relation rweDomainSupplied (id) (("independent-refill") ("resume-coverage")
 ("affine-cleanup") ("collective-split") ("descendant-termination")))
((rweWorkerEvidence S P H C O) <-- (rweDomainsReady S P H)
 (rweDomainSupplied C) (rweWorkerRequirement C O))

(relation rweWorkerBase (source profile contract))
((rweWorkerBase S P H) <-- (rweArenaReady S P H))
((rweWorkerBase S P H) <-- (rweDomainsReady S P H))

;; Owner-generation and rejection evidence supplies the existing five local
;; role conditions only. It never supplies native-writer-closure wholesale.
(relation rweOwnerIdentity (source profile contract) (("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902")))
(relation rweOwnerGuard (source profile contract guard) (("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902" "exact-source") ("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902" "original-profile") ("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902" "same-workspace") ("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902" "topology-and-map") ("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902" "calibrated-unknown-join") ("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902" "authenticated-executions") ("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902" "bounded-budgets") ("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902" "refill-exercised") ("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902" "owner-domain-service") ("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902" "fresh-still-generation") ("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902" "refusal-before-effects") ("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902" "native-run-abi") ("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902" "write-authority") ("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902" "copy-before-reserve") ("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902" "source-bounded-request") ("0458a171e0b6b0492b484e5ea9c46c60c7dedd138deee53a1d1b04e5fcc98c46" "884fa4a48e7550e2e9e1ddc62ec575927b37a5d81716d45d4a5684731d6b7f69" "e307384b392fc248d1b4445ce245a98011957cbe15493aa654a575e6ac8f2902" "closed-root-domain")))
(relation rweOwnerReady (source profile contract))
((rweOwnerReady S P H) <-- (rweOwnerIdentity S P H)
 (rweOwnerGuard S P H "exact-source")
 (rweOwnerGuard S P H "original-profile")
 (rweOwnerGuard S P H "same-workspace")
 (rweOwnerGuard S P H "domain-kernel")
 (rweOwnerGuard S P H "topology-and-map")
 (rweOwnerGuard S P H "refill-exercised")
 (rweOwnerGuard S P H "calibrated-unknown-join")
 (rweOwnerGuard S P H "authenticated-executions")
 (rweOwnerGuard S P H "bounded-budgets")
 (rweOwnerGuard S P H "owner-domain-service")
 (rweOwnerGuard S P H "fresh-still-generation")
 (rweOwnerGuard S P H "refusal-before-effects")
 (rweOwnerGuard S P H "native-run-abi")
 (rweOwnerGuard S P H "write-authority")
 (rweOwnerGuard S P H "copy-before-reserve")
 (rweOwnerGuard S P H "source-bounded-request")
 (rweOwnerGuard S P H "closed-root-domain"))
((rweWorkerBase S P H) <-- (rweOwnerReady S P H))
((rweWorkerEvidence S P H C O) <-- (rweOwnerReady S P H)
 (rweDomainSupplied C) (rweWorkerRequirement C O))
(relation rweNativeBoundary (id contract admission) (("owner-new-still" "13d4d8b3fe87f9b26a50ee97aaf34d8b7d68bb4a1d333feda9f09e260f4e1c13" "selected-source-native-control") ("nested-gc" "933ecc6b04534495d426f43603484451a1450572eb6453b83924a4652a54d903" "explicit-rejection") ("managed-entry" "b95e4ac9b19fb3312705b086e00938fd31cbe94a52fcb787767978eb005f676c" "explicit-rejection") ("raw-rc-and-payload" "3025345b00e556ea2de7b8ceee3d2d76eb1b64aec29436f1cb5a7d72cdd9bb16" "unresolved") ("nonlocal-native-exit" "d8bf608678b04ac61e3fa93e06fd7fb4858e5d5b1ecf5076a511ab349cca7e60" "unresolved") ("teardown-producer" "d5521c8e54b24396c35daf8102d7af13ab7b821db730110233a9a804cd882655" "unresolved") ("native-run-abi" "7a1a0a3d572fac3ea3a336b2f2a670f8aae629ad5879d33894a76af73c2c5dcd" "selected-source-native-control") ("write-authority" "a54bc3f3c893488d14c748a0efbe5add17a0875a2875f64b9d0b4353127102aa" "selected-source-native-control")))
(relation rweNativeUnresolved (id))
((rweNativeUnresolved I) <-- (rweNativeBoundary I _ "unresolved"))

;; Source families are not a finite census of third-party raw native stores.
;; Located witnesses and a tested primitive never discharge writer closure.
(relation rweWriterBoundary (id source contract status) (("rc-chain" "d915987d2e53dbe5f263cd5cbc6788f03efbef89c6e6ca8f0bf8d888b9ee295f" "abca85cca8c502dd5eb671a67184ea71a93d4a3602b2a465d2b219519b613ce8" "source-replacement") ("rc-payload" "d1781997846231025c71cdd92e322b7f7299f3b64da967940c9aa8c13b6f95cb" "c5d128933d81d637278e36354df9abddd7b5323a87a2da1fc0f439c885c68c72" "source-replacement") ("generated-entry" "9b82944804b86bc467c40dde0e34c269778cae8c62914daebb48d74507d8fc43" "0ba7f4406e70532b7fc0a599bcd26f8ddc5a4bfb7d187b49331066079325b8ae" "unresolved") ("callback-client-data" "cebf87ac03efc008d6422b13ee1cd9d53fb27a9d564fbbaffc0a9366dafa99c0" "b8eb03180374cc45dabec0035f16af312e828d01701b8ada48c7258ee803ac72" "unresolved") ("still-release" "82bc1abc813130ea37841d1d414c9484e178e007da1b2fadd5669cdf93fc2e02" "f1e3749a586b760edda2a8d67c03d119b415573d698c15947a40ad466a91b2e1" "partial") ("copy-forwarding" "aac8302900051ed83c77c9734f138fff8a6d7e5b1476b03886615b2e33462b2d" "8045ca866b67f0c43c36cfe6bd29f34a59fbe24a27c232c23111bd8ed29619ba" "source-replacement")))
(relation rweWriterEnforced (status) (("enforced")))
(relation rweWriterUnresolved (id))
((rweWriterUnresolved I) <-- (rweWriterBoundary I _ _ S)
 (not (rweWriterEnforced S)))

;; Capacity premises are source-refinement obligations, not another model.
(relation rweCapacityBoundary (id contract outcome) (("copy-charge" "e23595657794a0a155bc0b9ab36437c3c9d75c00198acd91b53d7cbe47153ddd" "unresolved") ("request-envelope" "8de7ba4551622ef3ba1e79a80af30f009d18ffc4ec4c6b8c5ea256fd0b76cb9b" "unresolved") ("attempt-fragmentation" "ac13681b5803fac5c2f91fd492cc42ebc1874e1251806c61f1009c050f15e25c" "unresolved") ("physical-source-pool" "eeaec6c4a91b4d311adbca56aa9eeb0dc67054ffe08f1b7b4cfc50b95b086fb1" "unresolved") ("restore-fudge" "d06c947b10e7db31adc40b0927e0e775d99ae617c415b2f7e9284a572db1bef5" "selected-source-native-control") ("known-refusal" "e23bd6d7b574189fdaa4fe1d72f0038dbf654f06bdcd1a93ad7e10016fd58647" "unresolved")))
(relation rweCapacityUnresolved (id))
((rweCapacityUnresolved I) <-- (rweCapacityBoundary I _ "unresolved"))

)
