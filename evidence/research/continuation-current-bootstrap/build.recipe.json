{
  "schema": "evidence-recipe.v2",
  "id": "continuation-current-bootstrap",
  "scope": "Current locked successor, same directory and original remaining cumulative budget. No old seed or completed producer reuse. Native preflight required; all failures retained.",
  "budgetSeconds": 180,
  "workspacePolicy": "in-place",
  "continuationRequest": "evidence/research/continuation-current-bootstrap/request.json",
  "continuationLedger": "evidence/research/continuation-current-bootstrap/ledger.json",
  "inputs": [
    "evidence/fixtures/continuation-segment-wake-budget/source.lock.json",
    "patches/fixtures/continuation-segment-wake-budget.patch",
    "evidence/fixtures/continuation-segment-wake-budget/cache-custody.json",
    "evidence/fixtures/gerbil-bazel-build-profile/profile.json",
    "evidence/research/continuation-current-bootstrap/request.json",
    "evidence/research/continuation-current-bootstrap/ledger.json",
    "evidence/research/continuation-current-bootstrap/intent.json",
    "evidence/research/continuation-current-bootstrap/causal-review.json",
    "evidence/native-failures.json",
    "evidence/research/suite-review-rules.ss",
    "docs/continuation-segment-wake-budget.md",
    "docs/continuation-private-chunk-segment.md",
    "models/gambit/continuation_segment_wake_budget.qnt",
    "evidence/research/execution-rules.ss"
  ],
  "steps": [
    {
      "id": "source",
      "capability": "gambit.materialize",
      "dependsOn": [],
      "budgetSeconds": 30,
      "arguments": {
        "sourceLock": "evidence/fixtures/continuation-segment-wake-budget/source.lock.json",
        "workspace": ".data/fixtures/foreign-origin-public-cleanup-contract-candidate",
        "cacheReceipt": "evidence/fixtures/continuation-segment-wake-budget/cache-custody.json"
      }
    },
    {
      "id": "configure",
      "capability": "gambit.configure",
      "dependsOn": [
        "source"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "source": {
          "step": "source",
          "output": "source"
        },
        "buildProfile": "evidence/fixtures/gerbil-bazel-build-profile/profile.json"
      }
    },
    {
      "id": "seed",
      "capability": "gambit.seed-core",
      "dependsOn": [
        "configure"
      ],
      "budgetSeconds": 130,
      "arguments": {
        "source": {
          "step": "configure",
          "output": "source"
        }
      }
    },
    {
      "id": "review",
      "capability": "gambit.review",
      "dependsOn": [
        "seed"
      ],
      "budgetSeconds": 15,
      "arguments": {
        "runtime": {
          "step": "seed",
          "output": "runtime"
        },
        "identity": {
          "step": "seed",
          "output": "identity"
        },
        "intent": "evidence/research/continuation-current-bootstrap/intent.json",
        "target": "bootstrap"
      }
    },
    {
      "id": "bootstrap",
      "capability": "gambit.bootstrap",
      "dependsOn": [
        "seed",
        "review"
      ],
      "budgetSeconds": 180,
      "arguments": {
        "runtime": {
          "step": "seed",
          "output": "runtime"
        },
        "identity": {
          "step": "seed",
          "output": "identity"
        },
        "retryReview": {
          "step": "review",
          "output": "review"
        },
        "failures": "evidence/native-failures.json",
        "reviewRules": "evidence/research/suite-review-rules.ss"
      }
    },
    {
      "id": "verdict",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "source",
        "configure",
        "seed",
        "review",
        "bootstrap"
      ],
      "budgetSeconds": 10,
      "arguments": {
        "rules": [
          "evidence/research/execution-rules.ss"
        ],
        "queries": {
          "missing": "missing_step"
        },
        "expected": {
          "missing": []
        }
      }
    }
  ]
}
