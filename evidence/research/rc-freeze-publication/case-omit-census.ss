;; Native SysML owns component needs, exact subjects/scopes and prerequisite edges.
;; This DSL derives finite-snapshot evidence gaps; it never authorizes execution.
(define-evidence (query)
 (sources clue factor binding)
 (outputs question modelRequired qualifiedSlice locallyChecked assuranceReady componentReady componentFrontier missingModel pendingCheck nextAction openPremise unmetDependency dependencyCycle unroutedNeed danglingDependency unboundDependency sharedContract sourceRoute)
 (include clue-selection-schema)
 (relation question (claim))
 (relation componentFact (component claim sysmlSource))
 (relation needFact (component obligation kind premise artifact scope))
 ;; Lossless transport of three needs sharing one component; each stays conjunctive.
 (relation needTripleFact (component o1 k1 p1 a1 t1 o2 k2 p2 a2 t2 o3 k3 p3 a3 t3))
 ((needFact C O K P A T) <-- (needTripleFact C O K P A T _ _ _ _ _ _ _ _ _ _))
 ((needFact C O K P A T) <-- (needTripleFact C _ _ _ _ _ O K P A T _ _ _ _ _))
 ((needFact C O K P A T) <-- (needTripleFact C _ _ _ _ _ _ _ _ _ _ O K P A T))
 (relation methodFact (kind method requiredCheck))
 (relation dependencyFact (component obligation prerequisiteComponent prerequisite))
 ;; Lossless transport of native edges in triples; no new dependency policy.
 (relation dependencyTripleFact (component obligation p1 q1 p2 q2 p3 q3))
 ;; Five edges per native record keep larger composed graphs within parser limits.
 (relation dependencyQuintFact (component obligation p1 q1 p2 q2 p3 q3 p4 q4 p5 q5))
 ((dependencyFact C O P Q) <-- (dependencyQuintFact C O P Q _ _ _ _ _ _ _ _))
 ((dependencyFact C O P Q) <-- (dependencyQuintFact C O _ _ P Q _ _ _ _ _ _))
 ((dependencyFact C O P Q) <-- (dependencyQuintFact C O _ _ _ _ P Q _ _ _ _))
 ((dependencyFact C O P Q) <-- (dependencyQuintFact C O _ _ _ _ _ _ P Q _ _))
 ((dependencyFact C O P Q) <-- (dependencyQuintFact C O _ _ _ _ _ _ _ _ P Q))
 (relation contractFact (contract producer consumer scope guarantee rely failureCustodian))
 (relation sourceRouteFact (component obligation sourceAnchors patchAnchors projection failureCustodian status))
 (relation sourceRoute (component obligation sourceAnchors patchAnchors projection failureCustodian status))
 (relation scenarioFact (scenario scope))
 (relation artifactFact (scenario component obligation method artifact digest))
 (relation receiptFact (scenario component obligation method artifact digest check scope status))
 (relation boundComponent (component claim))
 (relation knownNeed (component obligation))
 (relation hasNeed (component))
 (relation knownKind (kind))
 (relation dependsOn (component obligation prerequisiteComponent prerequisite))
 (relation dependencyCycle (component obligation))
 (relation unroutedNeed (scenario component obligation kind))
 (relation danglingDependency (scenario component obligation prerequisiteComponent prerequisite))
 (relation unboundDependency (scenario component obligation prerequisiteComponent prerequisite))
 (relation modelRequired (scenario component obligation method check artifact scope premise))
 (relation qualifiedSlice (scenario component obligation method artifact check scope))
 (relation missingExpected (scenario component obligation))
 (relation locallyChecked (scenario component obligation))
 (relation unmetDependency (scenario component obligation prerequisiteComponent prerequisite))
 (relation blockedNeed (scenario component obligation))
 (relation assuranceReady (scenario component obligation))
 (relation componentFrontier (scenario component obligation))
 (relation componentReady (scenario component))
 (relation missingModel (scenario component obligation method))
 (relation pendingCheck (scenario component obligation method artifact check scope))
 (relation nextAction (scenario component obligation action method subject))
 (relation openPremise (scenario component obligation premise))
 (relation sharedContract (contract producer consumer scope guarantee rely failureCustodian))
 ((boundComponent C K) <-- (componentFact C K _)
  (clue I D K _ _ _)
  (factor I D (lit "target-model-bundle-sha256") B) (binding (lit "target-model-bundle-sha256") B)
  (factor I D (lit "native-output-sha256") N) (binding (lit "native-output-sha256") N)
  (factor I D (lit "planner-dsl-sha256") P) (binding (lit "planner-dsl-sha256") P))
 ((knownNeed C O) <-- (needFact C O _ _ _ _))
 ((hasNeed C) <-- (knownNeed C _))
 ((knownKind T) <-- (methodFact T _ _))
 ((modelRequired S C O M K A T P) <-- (boundComponent C _) (scenarioFact S _)
  (needFact C O Kind P A T) (methodFact Kind M K))
 ((unroutedNeed S C O T) <-- (boundComponent C _) (scenarioFact S _)
  (needFact C O T _ _ _) (not (knownKind T)))
 ((dependsOn C O P Q) <-- (dependencyFact C O P Q))
 ((dependencyFact C O P Q) <-- (dependencyTripleFact C O P Q _ _ _ _))
 ((dependencyFact C O P Q) <-- (dependencyTripleFact C O _ _ P Q _ _))
 ((dependencyFact C O P Q) <-- (dependencyTripleFact C O _ _ _ _ P Q))
 ((dependsOn C O P Q) <-- (dependsOn C O X Y) (dependencyFact X Y P Q))
 ((dependencyCycle C O) <-- (dependsOn C O C O))
 ((danglingDependency S C O P Q) <-- (boundComponent C _) (scenarioFact S _)
  (dependsOn C O P Q) (not (knownNeed P Q)))
 ((unboundDependency S C O P Q) <-- (boundComponent C _) (scenarioFact S _)
  (dependsOn C O P Q) (knownNeed P Q) (not (boundComponent P _)))
 ((qualifiedSlice S C O M A K T) <-- (modelRequired S C O M K A T _)
  (artifactFact S C O M A H) (receiptFact S C O M A H K T (lit "pass")))
 ;; All declared method/check demands for this need must match, not just one.
 ((missingExpected S C O) <-- (modelRequired S C O M K A T _)
  (not (qualifiedSlice S C O M A K T)))
 ((missingExpected S C O) <-- (unroutedNeed S C O _))
 ((locallyChecked S C O) <-- (modelRequired S C O _ _ _ _ _)
  (not (missingExpected S C O)))
 ((unmetDependency S C O P Q) <-- (boundComponent C _) (scenarioFact S _)
  (dependsOn C O P Q) (not (locallyChecked S P Q)))
 ((blockedNeed S C O) <-- (unmetDependency S C O _ _))
 ((blockedNeed S C O) <-- (scenarioFact S _) (dependencyCycle C O))
 ((blockedNeed S C O) <-- (scenarioFact S _) (dependsOn C O P Q) (dependencyCycle P Q))
 ((blockedNeed S C O) <-- (danglingDependency S C O _ _))
 ((blockedNeed S C O) <-- (unboundDependency S C O _ _))
 ((assuranceReady S C O) <-- (locallyChecked S C O) (not (blockedNeed S C O)))
 ((componentFrontier S C O) <-- (boundComponent C _) (scenarioFact S _)
  (knownNeed C O) (not (assuranceReady S C O)))
 ((componentReady S C) <-- (boundComponent C _) (scenarioFact S _) (hasNeed C)
  (not (componentFrontier S C _)))
 ((missingModel S C O M) <-- (modelRequired S C O M _ A _ _)
  (not (artifactFact S C O M A _)))
 ((pendingCheck S C O M A K T) <-- (modelRequired S C O M K A T _)
  (artifactFact S C O M A _) (not (qualifiedSlice S C O M A K T)))
 ((nextAction S C O (lit "construct-model") M (lit "declared-subject")) <-- (missingModel S C O M))
 ((nextAction S C O (lit "perform-scoped-check") M K) <--
  (pendingCheck S C O M _ K _) (not (blockedNeed S C O)))
 ((nextAction S C O (lit "resolve-prerequisite") P Q) <-- (unmetDependency S C O P Q))
 ((nextAction S C O (lit "define-method-policy") (lit "Unassigned") T) <-- (unroutedNeed S C O T))
 ((nextAction S C O (lit "repair-dependency-cycle") C O) <--
  (boundComponent C _) (scenarioFact S _) (dependencyCycle C O))
 ((openPremise S C O P) <-- (needFact C O _ P _ _) (componentFrontier S C O))
 ((sharedContract I P C S G R F) <-- (contractFact I P C S G R F)
  (boundComponent P _) (boundComponent C _))
 ((question K) <-- (boundComponent _ K))
 ;; A source census/projection is visible evidence, never a checked receipt.
 ((sourceRoute C O A P X F T) <-- (boundComponent C _) (knownNeed C O)
  (sourceRouteFact C O A P X F T))
