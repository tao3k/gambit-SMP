diff --git a/tests/compiler-environment.scm b/tests/compiler-environment.scm
new file mode 100644
index 0000000000000000000000000000000000000000..c0786e7edbbecb33c44ea526a2dcbaa8171456b5
--- /dev/null
+++ b/tests/compiler-environment.scm
@@ -0,0 +1,53 @@
+;;; Run with the built GSC: -f -e '(load "tests/compiler-environment.scm")'.
+;;; Binding views share variables, while macros/namespaces retain their order.
+(##namespace ("gambit#tests#compiler#environment#" check lookup root first
+               macro-view late local child replacement duplicate alias-view
+               namespace-entry bound index branch-a branch-b private declaration-view))
+(define (check expected actual)
+  (if (not (eq? expected actual))
+      (error "compiler environment binding identity" expected actual)))
+(define (lookup env name)
+  (c#env-lookup env name #f (lambda (owner name value) value)))
+(c#env.begin!)
+(define root (c#env-frame #f '()))
+(define first (c#env-new-var! root 'first #f))
+(check first (lookup root 'first))
+(define index (cdr (vector-ref root 0)))
+(if (not (vector? index)) (error "global lookup did not construct its index"))
+(define macro-view (c#env-macro root 'first '(test-macro)))
+(define declaration-view (c#env-declare root '(test-declaration)))
+(check 'test-macro (car (lookup macro-view 'first)))
+(define late (c#env-new-var! macro-view 'late #f))
+(check late (lookup root 'late))
+(check late (lookup declaration-view 'late))
+(check index (cdr (vector-ref root 0)))
+(check late (c#env-lookup-global-var macro-view 'late))
+(define local (c#make-temp-var 'first))
+(define child (c#env-frame root (list local)))
+(check local (lookup child 'first))
+(check late (lookup child 'late))
+(check #f (cdr (vector-ref child 0)))
+(define replacement (c#make-temp-var 'replacement))
+(define duplicate (c#make-temp-var 'replacement))
+(c#env-vars-set! root (list replacement duplicate))
+(check #f (vector-ref (cdr (vector-ref root 0)) 0))
+(check replacement (lookup root 'replacement))
+(check #f (lookup root 'first))
+(check 'test-macro (car (lookup macro-view 'first)))
+(define branch-a (c#env-macro root 'private '(branch-a)))
+(define branch-b (c#env-macro root 'other '(branch-b)))
+(check #f (lookup root 'private))
+(define private (c#env-new-var! root 'private #f))
+(check private (lookup branch-b 'private))
+(check 'branch-a (car (lookup branch-a 'private)))
+(define namespace-entry (cons "pkg#" (list (cons 'alias 'bound))))
+(define alias-view (c#env-namespace root namespace-entry))
+(define bound (c#env-new-var! alias-view 'pkg#bound #f))
+(check bound (lookup alias-view 'alias))
+(check namespace-entry (table-ref (c#env-externals-ref alias-view) 'pkg#bound))
+(check bound (lookup root 'pkg#bound))
+(##gc)
+(check bound (lookup alias-view 'alias))
+(check replacement (lookup root 'replacement))
+(c#env.end!)
+(display "COMPILER-ENVIRONMENT-PASS shared-binding macro local namespace replacement gc\n")
