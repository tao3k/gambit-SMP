      "capability": "gambit.configure",
      "dependsOn": [
        "source"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "source": {
          "step": "source",
          "output": "source"
        },
        "buildProfile": "evidence/fixtures/gerbil-bazel-build-profile/profile.json"
      }
    },
    {
      "id": "seed",
      "capability": "gambit.seed-core",
      "dependsOn": [
        "configure"
      ],
      "budgetSeconds": 130,
      "arguments": {
        "source": {
          "step": "configure",
          "output": "source"
        }
      }
    },
    {
      "id": "review",
      "capability": "gambit.review",
      "dependsOn": [
        "seed"
      ],
      "budgetSeconds": 15,
      "arguments": {
        "runtime": {
          "step": "seed",
          "output": "runtime"
        },
        "identity": {
          "step": "seed",
          "output": "identity"
        },
        "intent": "evidence/research/stack-check-poll-kind/bootstrap-intent.json",
        "target": "bootstrap"
      }
    },
    {
      "id": "bootstrap",
      "capability": "gambit.bootstrap",
