+(declare (standard-bindings) (extended-bindings))
+(##namespace ("gambit#tests#smp#gc#worker_role_handoff#" coherent? roots check))
+(define coherent?
+  (c-lambda () bool #<<c-end
+___virtual_machine_state vm = ___VMSTATE_FROM_PSTATE(___ps);
+int count = vm->processor_count;
+if (count < 1 || vm->gc_round.participant_count != count ||
+    vm->gc_round.worker_count != count) ___return(0);
+for (int i=0; i<count; ++i) {
+  ___processor_state carrier = ___PSTATE_FROM_PROCESSOR_ID(i,vm);
+  ___collector_worker *worker = carrier->collector;
+  if (worker->vm != vm || worker->id != (i+1)%count ||
+      worker->phase != ___GC_WORKER_IDLE || worker->context != carrier->context ||
+      vm->gc_participants[i].context != carrier->context ||
+      vm->gc_participants[i].phase != ___GC_RUNNING ||
+      vm->gc_origins[i].state != 0) ___return(0);
+}
+___return(1);
+c-end
+))
+(define roots
+  (let loop ((i 79) (result '()))
+    (if (< i 0) result
+        (loop (- i 1) (cons (vector i (cons i i)) result)))))
+(define (check)
+  (if (not (coherent?)) (error "worker/root/carrier authority conflated"))
+  (for-each (lambda (v)
+              (if (not (= (vector-ref v 0) (car (vector-ref v 1))))
+                  (error "worker handoff lost a shared root")))
+            roots))
+(##gc) (check)
+(##gc) (check)
