+          ___fatal_error(msgs);
+        }
+
+#ifdef SHOW_FRAMES
+        ___printf ("fs=%d link=%d fp=%p ra=", fs, link, fp);
+        print_value (ra1);
+        ___printf ("\n");
+#endif
+
