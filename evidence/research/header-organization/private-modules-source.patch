+              (macro-thread-denv (macro-current-thread))))
+            (new-dynwind
+             (macro-make-dynwind
+              (##fx+ (macro-dynwind-level dynwind) 1)
+              before
+              after
+              cont))
+            (results ;; may get bound to a multiple-values object
+             (macro-dynamic-bind dynwind
+              new-dynwind
+              thunk)))
+       (after)
+       results))))
