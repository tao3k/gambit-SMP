+   ___P((___SIZE_TS words,
+         unsigned int multiplier,
+         unsigned int modulus,
+         ___BOOL heap),
+        (words,
+         multiplier,
+         modulus,
+         heap)
+___SIZE_TS words;
+unsigned int multiplier;
+unsigned int modulus;
+___BOOL heap;)
