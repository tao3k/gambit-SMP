-     floats
-     (macro-boosted-priority floats))
-
-    (let loop ((btq (macro-btq-deq-next thread)))
-      (if (##not (##eq? btq thread))
-        (let ((leftmost (macro-btq-leftmost btq)))
-          (if (##not (##eq? leftmost btq))
