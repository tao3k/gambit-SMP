+          ___WORD *copy_header;
+          ___SIZE_TS words;
+          ___copy_reservation grant;
+
+          ___COVER_MARK_CAPTURED_CONTINUATION_COPY;
+
+          words = fs + ___FRAME_EXTRA_SLOTS;
+
+          grant = reserve_copy(work,alloc,words,0);
+          alloc = grant.header;
+
