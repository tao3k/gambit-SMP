+#else
+#define ___WORD_LOAD_ACQUIRE(p) ___COMPARE_AND_SWAP_WORD(p,0,0)
+#define ___WORD_LOAD_RELAXED(p) ___WORD_LOAD_ACQUIRE(p)
+#define ___WORD_FETCH_ADD_RELAXED(p,v) ___FETCH_AND_ADD_WORD(p,v)
