+#define ___WORD_FETCH_ADD_RELAXED(p,v) ___FETCH_AND_ADD_WORD(p,v)
+#define ___WORD_FETCH_ADD_RELEASE(p,v) ___FETCH_AND_ADD_WORD(p,v)
+#define ___WORD_CAS_ACQUIRE(p,expected,v) \
