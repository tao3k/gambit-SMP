+#define ___ORDERED_WORD_NATIVE 0
+#ifdef ___USE_sequential_sync
+#define ___WORD_LOAD_ACQUIRE(p) (*(p))
+#define ___WORD_LOAD_RELAXED(p) (*(p))
+#define ___WORD_STORE_RELEASE(p,v) (*(p)=(v))
+#define ___WORD_STORE_RELAXED(p,v) (*(p)=(v))
