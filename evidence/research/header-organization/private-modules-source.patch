+/* For implementation of on_all_processors */
+
+typedef struct ___sync_op_struct
+  {
+    unsigned char op; /* owned locally or by one published sync slot */
+    ___WORD arg[2];
+  } ___sync_op_struct;
+
+/* Single-producer/single-consumer edge in the collective tree. Empty is an
+ * explicit reuse acknowledgement, published only after the payload copy.
+ * The wakeup mutex owns waiting; this ordered stamp owns payload visibility. */
+typedef struct ___sync_slot_struct
+  {
+    ___VOLATILE ___WORD stamp;
+    ___sync_op_struct payload;
+  } ___sync_slot;
+
+#define ___SYNC_SLOT_EMPTY ___CAST(___WORD,-1)
+/* Exclusive construction, before publication: never RMW uninitialized storage
+ * on the conservative backend. Concurrent reuse goes through ACK instead. */
+#define ___SYNC_SLOT_INIT(s) ((s)->stamp = ___SYNC_SLOT_EMPTY)
+#define ___SYNC_SLOT_STATE(s) ___WORD_LOAD_ACQUIRE(&(s)->stamp)
+#define ___SYNC_SLOT_PUBLISH(s,op,id) \
+do { (s)->payload = (op); ___WORD_STORE_RELEASE(&(s)->stamp,id); } while (0)
+#define ___SYNC_SLOT_READ(s,op,id) \
+do { (id) = ___SYNC_SLOT_STATE(s); (op) = (s)->payload; } while (0)
+#define ___SYNC_SLOT_ACK(s) ___WORD_STORE_RELEASE(&(s)->stamp,___SYNC_SLOT_EMPTY)
