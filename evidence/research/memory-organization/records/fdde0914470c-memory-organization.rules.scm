;; SysML owns the ordered responsibilities. Source adapters supply observations.
;; This policy does not duplicate QNT scheduling or Lean coherence theorems.
(relation moIdentity (source))
(relation moPart (id ordinal path digest))
(relation moObservedPart (id ordinal path digest))
(relation moRejectedPart (id))
((moRejectedPart I) <-- (moObservedPart I N P H) (not (moPart I N P H)))
(relation moCoveredPart (id))
((moCoveredPart I) <-- (moPart I N P H) (moObservedPart I N P H)
 (not (moRejectedPart I)))
(relation moMissingPart (id))
((moMissingPart I) <-- (moPart I _ _ _) (not (moCoveredPart I)))
(relation moRequired (id contract))
(relation moObservation (id source contract outcome))
(relation moPass (outcome) (("pass")))
(relation moRejectedCheck (id))
((moRejectedCheck I) <-- (moIdentity S) (moRequired I H)
 (moObservation I S H O) (not (moPass O)))
(relation moCoveredCheck (id))
((moCoveredCheck I) <-- (moIdentity S) (moRequired I H)
 (moObservation I S H "pass") (not (moRejectedCheck I)))
(relation moMissingCheck (id))
((moMissingCheck I) <-- (moRequired I _) (not (moCoveredCheck I)))
(relation moCandidate (id))
(relation moReady (id))
((moReady C) <-- (moCandidate C) (not (moMissingPart _))
 (not (moRejectedPart _)) (not (moMissingCheck _)))
;; Linked runtime acceptance remains independently owned and is not supplied
;; by byte reconstruction, preprocessing, object identity or make evidence.
(relation moSemanticAcceptance (id source))
(relation moRuntimeReady (id))
((moRuntimeReady C) <-- (moReady C) (moIdentity S) (moSemanticAcceptance C S))
