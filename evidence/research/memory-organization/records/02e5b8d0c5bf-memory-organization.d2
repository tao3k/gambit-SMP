direction: down
vars: { d2-config: { layout-engine: elk } }
model: "SysML: ordered responsibilities"
driver: "mem.c: unchanged preamble + 25 ordered includes"
modules: {
  label: "Private memory-runtime source modules; one translation unit"
  grid-columns: 4
  m0: "configuration.inc\nRepresentation, budgets and internal macro environment"
  m1: "aligned-allocation.inc\nAligned native allocation and reclamation"
  m2: "rc-allocation.inc\nRC registration, payload and lifetime"
  m3: "movable-sections.inc\nMovable section inventory and physical allocation"
  m4: "permanent-allocation.inc\nPermanent sections and allocation"
  m5: "global-bindings.inc\nGlobal variable identity and lookup"
  m6: "still-refcount.inc\nStill object external reference counts"
  m7: "object-allocation.inc\nPermanent and still constructors; pair and vector APIs"
  m8: "symbols.inc\nSymbol and keyword interning; shared scan macros"
  m9: "diagnostics.inc\nConditional GC consistency and debugging"
  m10: "heap-sections.inc\nStack and heap sections; chunk FIFO publication; round setup"
  m11: "copy-reservations.inc\nObject scan authority, copy reservations and Tail"
  m12: "continuation-roots.inc\nCaptured frames, continuations and root repair"
  m13: "rc-roots.inc\nRC root scanning"
  m14: "object-scanning.inc\nObject fields, still queues, chunk and frontier scanning"
  m15: "still-sweep.inc\nStill object sweep and destruction"
  m16: "memory-lifecycle.inc\nCapacity history, setup and cleanup"
  m17: "wills.inc\nWeak will execution eligibility and processing"
  m18: "weak-tables.inc\nWeak table GC processing and in-place rehash"
  m19: "hash-table-api.inc\nHash lookup, mutation and union-find APIs"
  m20: "capacity-resize.inc\nContinuation movement, capacity, resize and retirement"
  m21: "root-origins.inc\nContext, VM and global root enumeration"
  m22: "collection-round.inc\nStrong and weak traversal, cleanup and GC round driver"
  m23: "allocation-limits.inc\nMutator stack and heap checks; overflow undo"
  m24: "allocation-statistics.inc\nAllocation accounting query and final delimiter"
}
proof: "Byte reconstruction / 8 preprocessing pairs / release object identity"
ascent: "ASCENT: exact source, order, contracts and negative controls"
formal: "Existing QNT schedules + Lean coherence: reused; no duplicated model"
open: "Bootstrap / Scheme GC + multi-shot control / five commit gates: OPEN"
model -> driver
driver -> modules: inclusion order preserved
modules -> proof
model -> ascent
proof -> ascent
formal -> open
ascent -> open: structural acceptance cannot supply runtime acceptance
