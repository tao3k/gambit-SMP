{
  "schema": "evidence-recipe.v2",
  "id": "stack-padding-step-compiled-stress-inplace",
  "scope": "All four unchanged compiled stress files on the padding-step bootstrap runtime, leased in place. Original inventory, host topology and 300-second inactivity budget. A file DENY stays a native DENY. Bootstrap PASS is not this gate.",
  "workspacePolicy": "in-place",
  "timeoutPolicy": {
    "mode": "progress",
    "overheadSeconds": 30
  },
  "inputs": [
    "evidence/fixtures/darwin-stack-padding-step/source.lock.json",
    "patches/fixtures/darwin-stack-padding-step.patch",
    "evidence/fixtures/darwin-stack-padding-step/review-contract.json",
    "evidence/research/stack-padding-step/completed-producer.json",
    "evidence/native-failures.json",
    "evidence/research/suite-review-rules.ss",
    "evidence/research/execution-rules.ss",
    "evidence/fixtures/darwin-stack-write-boundary/native-observation-20261016.json"
  ],
  "steps": [
    {
      "id": "source",
      "capability": "gambit.materialize",
      "dependsOn": [],
      "budgetSeconds": 30,
      "arguments": {
        "sourceLock": "evidence/fixtures/darwin-stack-padding-step/source.lock.json"
      }
    },
    {
      "id": "producer",
      "capability": "gambit.completed-runtime",
      "dependsOn": [
        "source"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "source": {
          "step": "source",
          "output": "source"
        },
        "producer": "evidence/research/stack-padding-step/completed-producer.json"
      }
    },
    {
      "id": "stress-gsc",
      "capability": "gambit.suite",
      "dependsOn": [
        "producer"
      ],
      "budgetSeconds": 300,
      "arguments": {
        "runtime": {
          "step": "producer",
          "output": "runtime"
        },
        "identity": {
          "step": "producer",
          "output": "identity"
        },
        "mode": "gsc",
        "regime": "whole-parallel",
        "inventory": "stress",
        "selection": [
          "."
        ],
        "expectedFiles": [
          "06-thread/tfib_stress.scm",
          "06-thread/thread_interrupt2_stress.scm",
          "06-thread/thread_interrupt_stress.scm",
          "06-thread/thread_terminate_stress.scm"
        ],
        "failures": "evidence/native-failures.json",
        "reviewRules": "evidence/research/suite-review-rules.ss"
      }
    },
    {
      "id": "verdict",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "source",
        "producer",
        "stress-gsc"
      ],
      "budgetSeconds": 10,
      "arguments": {
        "rules": [
          "evidence/research/execution-rules.ss"
        ],
        "queries": {
          "missing": "missing_step"
        },
        "expected": {
          "missing": []
        }
      }
    }
  ]
}
