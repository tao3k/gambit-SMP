    "guards": {
      "enterNative": "s.nativeOpen==1 and s.control==1 and s.scope==0 and s.phase==0",
      "enterOther": "s.nativeOpen==1 and s.control==1",
      "leaveOther": "s.others>=1",
      "selectHandle": "s.scope==1 and s.phase==1 and s.nativeOpen==1 and s.storage==1 and s.selected==0",
      "deleteCommand": "s.nativeOpen==1",
      "reserveRoot": "s.phase==1 and s.scope==1 and s.selected==1 and s.nativeOpen==1 and s.gcOpen==1 and s.frozen==0 and s.root==1 and s.lease==0",
      "rejectBeforeReserve": "s.phase==1 and s.scope==1 and s.selected==1 and (s.nativeOpen==0 or s.gcOpen==0)",
      "commitJoint": "s.phase==2 and s.lease==1 and s.rootAuth==1 and s.nativeOpen==1 and s.root==1 and s.storage==1",
      "rejectReservedDelete": "s.phase==2 and s.lease==1 and s.nativeOpen==0",
      "abortPreparation": "s.phase==2 and s.lease==1 and s.committed==0",
      "loseReply": "s.pending==1 and s.known==0 and (s.phase==2 or s.phase==3)",
      "resolveReservedAbort": "s.phase==2 and s.unknown==1 and s.lease==1 and s.committed==0",
      "ackCommit": "s.phase==3 and s.committed==1 and s.pending==1 and s.borrow==1",
      "readSelected": "s.phase==3 and s.known==1 and s.borrow==1 and s.rootAuth==1 and s.gcOpen==1 and s.frozen==0 and s.dataReads==0",
      "finishUse": "s.phase==3 and s.known==1 and s.borrow==1",
      "retireBorrow": "s.phase==3 and s.finished==1 and s.known==1 and s.borrow==1",
      "deliverOutcome": "s.phase==4 and s.known==1 and s.pending==0 and s.borrow==0 and s.lease==0",
      "leaveScope": "s.phase==4 and s.delivered==1 and s.pending==0 and s.borrow==0 and s.lease==0 and s.scope==1",
      "leaveEmptyScope": "s.phase==1 and s.selected==0 and s.pending==0 and s.scope==1",
      "removeRoot": "s.nativeOpen==0 and s.scope==0 and s.others==0 and s.borrow==0 and s.lease==0 and s.pending==0 and s.gcOpen==1 and s.frozen==0 and s.root==1",
      "freeStorage": "s.nativeOpen==0 and s.root==0 and s.scope==0 and s.others==0 and s.borrow==0 and s.pending==0 and s.lease==0 and s.gcOpen==1 and s.frozen==0 and s.storage==1",
      "freeControl": "s.storage==0 and s.scope==0 and s.others==0 and s.pending==0 and s.nativeAuth==0 and s.gcOpen==1 and s.frozen==0 and s.control==1",
      "closeGc": "s.gcOpen==1",
      "freezeRoots": "s.gcOpen==0 and s.lease==0 and s.frozen==0",
      "beginScan": "s.frozen==1 and s.scanning==0 and s.scanned==0",
      "endScan": "s.scanning==1",
      "resumeGc": "s.frozen==1 and s.scanning==0 and s.scanned==1"
    },
    "updates": {
      "enterNative": {
        "scope": 1,
        "nativeAuth": 1,
        "phase": 1
      },
      "enterOther": {
