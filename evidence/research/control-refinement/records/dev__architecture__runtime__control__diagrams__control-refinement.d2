direction: down
vars: { d2-config: { layout-engine: elk } }
bridge: "CS-BRIDGE / source / SOURCE MAPPED; CLOSURE OPEN"
writers: "CS-WRITERS / source / SOURCE MAPPED; CLOSURE OPEN"
hooks: "CS-HOOKS / source / SOURCE MAPPED; CLOSURE OPEN"
prompts: "CS-PROMPTS / source / SOURCE MAPPED; CLOSURE OPEN"
native: "CS-NATIVE / native / SOURCE MAPPED; CLOSURE OPEN"
frames: "CS-FRAMES / source / SOURCE MAPPED; CLOSURE OPEN"
bridge -> source_refinement: requires source correspondence
writers -> source_refinement: requires source correspondence
hooks -> source_refinement: requires source correspondence
prompts -> source_refinement: requires source correspondence
frames -> source_refinement: requires source correspondence
source_refinement: "Source refinement: authentic issuance / all writers / semantic relation / coordinates"
native -> native_acceptance: sole execution owner
native_acceptance: "CS-NATIVE: exact source + profile + case receipts"
case_bootstrap_map: "bootstrap-map [full-control]"
case_bootstrap_map -> native_acceptance: scoped evidence
case_alias_rebuild: "alias-rebuild [full-control]"
case_alias_rebuild -> native_acceptance: scoped evidence
case_hook_reentry: "hook-reentry [full-control]"
case_hook_reentry -> native_acceptance: scoped evidence
case_native_origins: "native-origins [full-control]"
case_native_origins -> native_acceptance: scoped evidence
case_context_worker: "context-worker [full-control]"
case_context_worker -> native_acceptance: scoped evidence
case_layout_lifetime: "layout-lifetime [full-control]"
case_layout_lifetime -> native_acceptance: scoped evidence
case_capacity_benefit: "capacity-benefit [full-control]"
case_capacity_benefit -> native_acceptance: scoped evidence
case_prompt_operators: "prompt-operators [prompt-extension]"
case_prompt_operators -> native_acceptance: scoped evidence
source_refinement -> ascent: unique source obligations
native_acceptance -> ascent: one native obligation
ascent: "SysML-driven ASCENT closure; audits and formal endpoints cannot substitute for refinement/native evidence"
existing_quint: "CS-SCHEDULE / unchanged quint evidence reused"
existing_quint -> ascent: distinct obligation; no duplicate model
source_refinement -> existing_quint: establish concrete interface premises
existing_lean: "CS-COHERENCE / unchanged lean evidence reused"
existing_lean -> ascent: distinct obligation; no duplicate model
source_refinement -> existing_lean: establish concrete interface premises
gate_tests: "tests"
ascent -> gate_tests: conjunctive gate
gate_architecture: "architecture"
ascent -> gate_architecture: conjunctive gate
gate_process: "process"
ascent -> gate_process: conjunctive gate
gate_models: "models"
ascent -> gate_models: conjunctive gate
gate_questions: "questions"
ascent -> gate_questions: conjunctive gate
