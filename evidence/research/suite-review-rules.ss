;;; -*- Gerbil -*-
;;; Pure restricted DSL loaded by the upstream native engine.
(ascent-fragment
  (relation known_failure ((route symbol?) (mode symbol?)))
  (relation selected_failure ((route symbol?)))
  (relation failure_category ((route symbol?) (category symbol?)))
  (relation review_present ((route symbol?)))
  (relation campaign_bound ((route symbol?)))
  (relation budget_regime ((route symbol?) (old symbol?) (new symbol?)))
  (relation required_budget ((route symbol?) (axis symbol?)))
  (relation original_budget ((route symbol?) (axis symbol?) (ms integer?)))
  (relation requested_budget ((route symbol?) (axis symbol?) (ms integer?)))
  (relation changed_input ((route symbol?) (change symbol?) (kind symbol?) (path symbol?) (before symbol?) (after symbol?)))
  (relation claim_evidence ((route symbol?) (claim symbol?) (domain symbol?) (status symbol?) (receipt symbol?)))
  (relation claim_dependency ((route symbol?) (claim symbol?) (premise symbol?)))
  (relation claim_change ((route symbol?) (claim symbol?) (change symbol?)))
  (relation selected_known_failure ((route symbol?) (mode symbol?)))
  (relation needed_claim ((route symbol?) (claim symbol?)))
  (relation reviewed_claim ((route symbol?) (claim symbol?)))
  (relation missing_claim ((route symbol?) (claim symbol?)))
  (relation claim_path ((route symbol?) (claim symbol?) (premise symbol?)))
  (relation matching_regime ((route symbol?)))
  (relation observed_change ((route symbol?)))
  (relation covered_change ((route symbol?)))
  (relation compatible_change ((route symbol?) (change symbol?)))
  (relation comparable_budget ((route symbol?) (axis symbol?)))
  (relation retry_denied ((route symbol?) (reason symbol?)))
  (relation has_denial ((route symbol?)))
  (relation retry_eligible ((route symbol?) (mode symbol?)))
  (relation review_required ((route symbol?) (mode symbol?)))
  (relation retry_marker ((flag boolean?)))
  (relation retry_any_selected ((flag boolean?)))
  (relation retry_any_denied ((flag boolean?)))
  (relation retry_any_review ((flag boolean?)))
  (relation retry_decision ((decision symbol?)))
  ((selected_known_failure R M) <-- (known_failure R M) (selected_failure R))
  ((needed_claim R (lit 'failure-scope-review)) <-- (selected_known_failure R M))
  ((needed_claim R (lit 'change-relevance-review)) <-- (selected_known_failure R M))
  ((needed_claim R (lit 'assumptions-review)) <-- (selected_known_failure R M))
  ((needed_claim R P) <-- (needed_claim R C) (claim_dependency R C P))
  ((claim_path R C P) <-- (claim_dependency R C P))
  ((claim_path R C Q) <-- (claim_path R C P) (claim_dependency R P Q))
  ((reviewed_claim R C) <-- (claim_evidence R C (lit 'causal-review) (lit 'reviewed) D))
  ((missing_claim R C) <-- (needed_claim R C) (not (reviewed_claim R C)))
  ((matching_regime R) <-- (budget_regime R G G))
  ((observed_change R) <-- (changed_input R C K P B A))
  ((compatible_change R C) <-- (failure_category R (lit 'assertion)) (changed_input R C (lit 'source) P B A))
  ((compatible_change R C) <-- (failure_category R (lit 'assertion)) (changed_input R C (lit 'fixture) P B A))
  ((compatible_change R C) <-- (failure_category R (lit 'signal)) (changed_input R C (lit 'source) P B A))
  ((compatible_change R C) <-- (failure_category R (lit 'budget)) (changed_input R C (lit 'source) P B A))
  ((compatible_change R C) <-- (failure_category R (lit 'budget)) (changed_input R C (lit 'fixture) P B A))
  ((covered_change R) <-- (claim_change R (lit 'change-relevance-review) C)
    (reviewed_claim R (lit 'change-relevance-review)) (compatible_change R C))
  ((comparable_budget R A) <-- (original_budget R A O) (requested_budget R A N))
  ((retry_denied R (lit 'budget-expanded)) <-- (original_budget R A O) (requested_budget R A N) (if (O N) (< O N)))
  ((retry_denied R (lit 'budget-unbound)) <-- (review_present R) (required_budget R A) (not (comparable_budget R A)))
  ((retry_denied R (lit 'budget-regime-changed)) <-- (review_present R) (not (matching_regime R)))
  ((retry_denied R (lit 'campaign-unbound)) <-- (review_present R) (not (campaign_bound R)))
  ((retry_denied R (lit 'unchanged-inputs)) <-- (review_present R) (not (observed_change R)))
  ((retry_denied R (lit 'change-not-causally-reviewed)) <-- (review_present R) (not (covered_change R)))
  ((retry_denied R (lit 'missing-premise)) <-- (review_present R) (missing_claim R C))
  ((retry_denied R (lit 'circular-review)) <-- (review_present R) (needed_claim R C) (claim_path R C C))
  ((has_denial R) <-- (retry_denied R Reason))
  ((retry_eligible R M) <-- (selected_known_failure R M) (review_present R) (not (has_denial R)))
  ((review_required R M) <-- (selected_known_failure R M) (not (retry_eligible R M)))
  ((retry_any_selected (lit #t)) <-- (selected_known_failure R M))
  ((retry_any_denied (lit #t)) <-- (retry_denied R Reason))
  ((retry_any_review (lit #t)) <-- (review_required R M))
  ((retry_decision (lit 'DENY)) <-- (retry_any_denied (lit #t)))
  ((retry_decision (lit 'REVIEW_REQUIRED)) <-- (retry_any_review (lit #t)) (not (retry_any_denied (lit #t))))
  ((retry_decision (lit 'RETRY_ELIGIBLE)) <-- (retry_any_selected (lit #t))
   (not (retry_any_denied (lit #t))) (not (retry_any_review (lit #t))))
  ((retry_decision (lit 'NOT_REQUIRED)) <-- (retry_marker (lit #t)) (not (retry_any_selected (lit #t)))))
