;;; -*- Gerbil -*-
;;; Pure restricted DSL loaded by the upstream native engine.
(ascent-fragment
  (relation known_failure ((route symbol?) (mode symbol?)))
  (relation selected_failure ((route symbol?)))
  (relation failure_category ((route symbol?) (category symbol?)))
  (relation failure_scope ((route symbol?) (file symbol?)))
  (relation failure_campaign_file ((route symbol?) (file string?)))
  (relation failure_campaign_closed ((route symbol?)))
  (relation current_campaign_file ((file string?)))
  (relation failure_campaign_overlap ((route symbol?)))
  (relation failure_campaign_disjoint ((route symbol?) (mode symbol?)))
  (relation environment_requirement ((route symbol?) (operation symbol?)))
  (relation review_present ((route symbol?)))
  (relation observation_bridge ((route symbol?) (schema symbol?)))
  (relation observation_equal_pointer ((route symbol?) (field symbol?) (original symbol?) (observed symbol?)))
  (relation observation_matching_field ((route symbol?) (field symbol?)))
  (relation observation_required_field ((route symbol?) (field symbol?)))
  (relation campaign_bound ((route symbol?)))
  (relation budget_regime ((route symbol?) (old symbol?) (new symbol?)))
  (relation required_budget ((route symbol?) (axis symbol?)))
  (relation original_budget ((route symbol?) (axis symbol?) (ms integer?)))
  (relation requested_budget ((route symbol?) (axis symbol?) (ms integer?)))
  (relation scoped_single_file ((route symbol?) (file symbol?)))
  (relation compiler_probe_failure ((route symbol?) (phase symbol?)))
  (relation compiler_probe_phase ((phase symbol?)))
  (relation compiler_options_observation ((route symbol?) (old-level integer?) (new-level integer?)))
  (relation compiler_configuration_observation ((route symbol?) (old-level integer?) (new-level integer?)))
  (relation exact_whole_inventory ((route symbol?)))
  (relation exact_atomic_inventory ((route symbol?)))
  (relation whole_budget_interval ((route symbol?)))
  (relation review_original_file ((route symbol?) (file symbol?)))
  (relation review_current_file ((route symbol?) (file symbol?)))
  (relation original_inventory_present ((route symbol?)))
  (relation original_file_missing ((route symbol?) (file symbol?)))
  (relation original_inventory_gap ((route symbol?)))
  (relation whole_covers_original ((route symbol?)))
  (relation whole_dominates_atomic ((route symbol?)))
  (relation scoped_file_group ((route symbol?) (group symbol?)))
  (relation environment_observation ((route symbol?) (operation symbol?)))
  (relation resource_plan_observation ((route symbol?) (old-child-demand integer?)
    (new-total-demand integer?) (host-capacity integer?)))
  (relation environment_control ((route symbol?) (operation symbol?) (old-status symbol?) (new-status symbol?)
    (exit integer?) (timeout boolean?) (accepted boolean?) (same-identity boolean?)
    (same-selection boolean?) (same-source boolean?) (same-config boolean?) (old-budget integer?) (new-budget integer?)))
  (relation changed_input ((route symbol?) (change symbol?) (kind symbol?) (path symbol?) (before symbol?) (after symbol?)))
  (relation claim_evidence ((route symbol?) (claim symbol?) (domain symbol?) (status symbol?) (receipt symbol?)))
  (relation claim_dependency ((route symbol?) (claim symbol?) (premise symbol?)))
  (relation claim_change ((route symbol?) (claim symbol?) (change symbol?)))
  (relation selected_known_failure ((route symbol?) (mode symbol?)))
  (relation needed_claim ((route symbol?) (claim symbol?)))
  (relation reviewed_claim ((route symbol?) (claim symbol?)))
  (relation missing_claim ((route symbol?) (claim symbol?)))
  (relation claim_path ((route symbol?) (claim symbol?) (premise symbol?)))
  (relation matching_regime ((route symbol?)))
  (relation observed_change ((route symbol?)))
  (relation covered_change ((route symbol?)))
  (relation compatible_change ((route symbol?) (change symbol?)))
  (relation comparable_budget ((route symbol?) (axis symbol?)))
  (relation retry_denied ((route symbol?) (reason symbol?)))
  (relation has_denial ((route symbol?)))
  (relation retry_eligible ((route symbol?) (mode symbol?)))
  (relation review_required ((route symbol?) (mode symbol?)))
  (relation retry_marker ((flag boolean?)))
  (relation retry_any_selected ((flag boolean?)))
  (relation retry_any_denied ((flag boolean?)))
  (relation retry_any_review ((flag boolean?)))
  (relation retry_decision ((decision symbol?)))
  ((failure_campaign_overlap R) <-- (failure_campaign_file R F) (current_campaign_file F))
  ((failure_campaign_disjoint R M) <-- (known_failure R M) (selected_failure R)
    (failure_category R (lit 'budget)) (failure_scope R (lit 'tests/run-unit-tests.scm))
    (failure_campaign_closed R) (current_campaign_file F) (not (failure_campaign_overlap R)))
  ((selected_known_failure R M) <-- (known_failure R M) (selected_failure R)
    (not (failure_campaign_disjoint R M)))
  ((environment_requirement R (lit 'udp-open)) <-- (failure_scope R (lit '11-network)))
  ((environment_requirement R (lit 'udp-open)) <-- (failure_scope R (lit '11-network/udp_close.scm)))
  ((environment_requirement R (lit 'process-pipe-sort)) <-- (failure_scope R (lit '13-modules/prim_port.scm)))
  ((environment_requirement R (lit 'user-info)) <-- (failure_scope R (lit '12-os/user_info.scm)))
  ((needed_claim R (lit 'failure-scope-review)) <-- (selected_known_failure R M))
  ((needed_claim R (lit 'change-relevance-review)) <-- (selected_known_failure R M))
  ((needed_claim R (lit 'assumptions-review)) <-- (selected_known_failure R M))
  ((needed_claim R (lit 'build-driver-cause-review)) <-- (selected_known_failure R M)
    (changed_input R C (lit 'build-driver) P B A))
  ((needed_claim R (lit 'environment-cause-review)) <-- (selected_known_failure R M)
    (changed_input R C (lit 'environment) O B A))
  ((needed_claim R (lit 'resource-plan-cause-review)) <-- (selected_known_failure R M)
    (changed_input R C (lit 'resource-plan) P B A))
  ((needed_claim R (lit 'compiler-options-cause-review)) <-- (selected_known_failure R M)
    (changed_input R C (lit 'compiler-options) P B A))
  ((needed_claim R (lit 'compiler-command-association-review)) <-- (selected_known_failure R M)
    (changed_input R C (lit 'compiler-options) P B A))
  ((needed_claim R (lit 'compiler-configuration-cause-review)) <-- (selected_known_failure R M)
    (changed_input R C (lit 'compiler-configuration) P B A))
  ((needed_claim R (lit 'compiler-configuration-association-review)) <-- (selected_known_failure R M)
    (changed_input R C (lit 'compiler-configuration) P B A))
  ((needed_claim R (lit 'historical-log-association-review)) <-- (selected_known_failure R M) (observation_bridge R S))
  ((observation_required_field R (lit 'status)) <-- (observation_bridge R S))
  ((observation_required_field R (lit 'exit)) <-- (observation_bridge R S))
  ((observation_required_field R (lit 'timeout)) <-- (observation_bridge R S))
  ((observation_required_field R (lit 'duration)) <-- (observation_bridge R S))
  ((observation_required_field R (lit 'budget)) <-- (observation_bridge R S))
  ((observation_matching_field R (lit 'status)) <--
    (observation_bridge R (lit 'gambit-two-pass-bootstrap-denial-summary.v1))
    (observation_equal_pointer R (lit 'status) (lit '/status) (lit '/status)))
  ((observation_matching_field R (lit 'exit)) <--
    (observation_bridge R (lit 'gambit-two-pass-bootstrap-denial-summary.v1))
    (observation_equal_pointer R (lit 'exit) (lit '/exit) (lit '/steps/0/exit)))
  ((observation_matching_field R (lit 'timeout)) <--
    (observation_bridge R (lit 'gambit-two-pass-bootstrap-denial-summary.v1))
    (observation_equal_pointer R (lit 'timeout) (lit '/timeout) (lit '/steps/0/timeout)))
  ((observation_matching_field R (lit 'duration)) <--
    (observation_bridge R (lit 'gambit-two-pass-bootstrap-denial-summary.v1))
    (observation_equal_pointer R (lit 'duration) (lit '/seconds) (lit '/steps/0/seconds)))
  ((observation_matching_field R (lit 'budget)) <--
    (observation_bridge R (lit 'gambit-two-pass-bootstrap-denial-summary.v1))
    (observation_equal_pointer R (lit 'budget) (lit '/wholeBootstrapBudget) (lit '/wholeBootstrapBudget)))
  ((observation_required_field R (lit 'mode)) <-- (observation_bridge R (lit 'gambit-native-suite-denial-summary.v1)))
  ((observation_required_field R (lit 'denominator)) <-- (observation_bridge R (lit 'gambit-native-suite-denial-summary.v1)))
  ((observation_required_field R (lit 'candidate)) <-- (observation_bridge R (lit 'gambit-native-suite-denial-summary.v1)))
  ((observation_matching_field R (lit 'status)) <--
    (observation_bridge R (lit 'gambit-native-suite-denial-summary.v1))
    (observation_equal_pointer R (lit 'status) (lit '/status) (lit '/status)))
  ((observation_matching_field R (lit 'exit)) <--
    (observation_bridge R (lit 'gambit-native-suite-denial-summary.v1))
    (observation_equal_pointer R (lit 'exit) (lit '/exit) (lit '/results/0/exit)))
  ((observation_matching_field R (lit 'timeout)) <--
    (observation_bridge R (lit 'gambit-native-suite-denial-summary.v1))
    (observation_equal_pointer R (lit 'timeout) (lit '/timeout) (lit '/results/0/timeout)))
  ((observation_matching_field R (lit 'duration)) <--
    (observation_bridge R (lit 'gambit-native-suite-denial-summary.v1))
    (observation_equal_pointer R (lit 'duration) (lit '/seconds) (lit '/results/0/seconds)))
  ((observation_matching_field R (lit 'budget)) <--
    (observation_bridge R (lit 'gambit-native-suite-denial-summary.v1))
    (observation_equal_pointer R (lit 'budget) (lit '/wholeSuiteBudget) (lit '/wholeSuiteBudgetPerMode)))
  ((observation_matching_field R (lit 'mode)) <--
    (observation_bridge R (lit 'gambit-native-suite-denial-summary.v1))
    (observation_equal_pointer R (lit 'mode) (lit '/mode) (lit '/results/0/mode)))
  ((observation_matching_field R (lit 'denominator)) <--
    (observation_bridge R (lit 'gambit-native-suite-denial-summary.v1))
    (observation_equal_pointer R (lit 'denominator) (lit '/selectedFiles) (lit '/filesPerMode)))
  ((observation_matching_field R (lit 'candidate)) <--
    (observation_bridge R (lit 'gambit-native-suite-denial-summary.v1))
    (observation_equal_pointer R (lit 'candidate) (lit '/candidateReceiptSha256) (lit '/candidateReceiptSha256)))
  ((needed_claim R P) <-- (needed_claim R C) (claim_dependency R C P))
  ((claim_path R C P) <-- (claim_dependency R C P))
  ((claim_path R C Q) <-- (claim_path R C P) (claim_dependency R P Q))
  ((reviewed_claim R C) <-- (claim_evidence R C (lit 'causal-review) (lit 'reviewed) D))
  ((missing_claim R C) <-- (needed_claim R C) (not (reviewed_claim R C)))
  ((matching_regime R) <-- (budget_regime R (lit 'build-step) (lit 'build-step)))
  ((compiler_probe_phase (lit 'scheme-to-c)) <-- (compiler_probe_failure R (lit 'scheme-to-c)))
  ((compiler_probe_phase (lit 'c-to-dynamic-module)) <-- (compiler_probe_failure R (lit 'c-to-dynamic-module)))
  ((compiler_probe_phase (lit 'compiled-assertions)) <-- (compiler_probe_failure R (lit 'compiled-assertions)))
  ((matching_regime R) <-- (compiler_probe_failure R P) (compiler_probe_phase P)
    (known_failure R (lit 'gsc)) (scoped_single_file R F)
    (budget_regime R (lit 'compiler-probe) (lit 'whole-parallel)))
  ((matching_regime R) <-- (compiler_probe_failure R P) (compiler_probe_phase P)
    (known_failure R (lit 'gsc)) (scoped_single_file R F)
    (budget_regime R (lit 'compiler-probe) (lit 'whole-sequential)))
  ((matching_regime R) <-- (scoped_file_group R F)
    (budget_regime R (lit 'whole-sequential) (lit 'whole-sequential)))
  ((matching_regime R) <-- (scoped_file_group R F)
    (budget_regime R (lit 'whole-parallel) (lit 'whole-parallel)))
  ((matching_regime R) <-- (scoped_file_group R F)
    (budget_regime R (lit 'whole-sequential) (lit 'whole-parallel)))
  ((matching_regime R) <-- (scoped_file_group R F)
    (budget_regime R (lit 'whole-parallel) (lit 'whole-sequential)))
  ((matching_regime R) <-- (exact_atomic_inventory R)
    (budget_regime R (lit 'atomic-coverage) (lit 'atomic-coverage)))
  ((original_inventory_present R) <-- (review_original_file R F))
  ((original_file_missing R F) <-- (review_original_file R F) (not (review_current_file R F)))
  ((original_inventory_gap R) <-- (original_file_missing R F))
  ((whole_covers_original R) <-- (whole_budget_interval R)
    (original_inventory_present R) (not (original_inventory_gap R)))
  ((matching_regime R) <-- (whole_covers_original R)
    (budget_regime R (lit 'whole-sequential) (lit 'whole-parallel)))
  ((matching_regime R) <-- (whole_covers_original R)
    (budget_regime R (lit 'whole-parallel) (lit 'whole-parallel)))
  ((matching_regime R) <-- (whole_covers_original R)
    (budget_regime R (lit 'whole-sequential) (lit 'whole-sequential)))
  ((matching_regime R) <-- (whole_covers_original R)
    (budget_regime R (lit 'whole-parallel) (lit 'whole-sequential)))
  ((whole_dominates_atomic R) <-- (whole_covers_original R)
    (original_budget R (lit 'atomic-batch) O) (requested_budget R (lit 'suite-step) N)
    (if (O N) (<= N O)))
  ((matching_regime R) <-- (whole_dominates_atomic R)
    (budget_regime R (lit 'atomic-coverage) (lit 'whole-parallel)))
  ((matching_regime R) <-- (whole_dominates_atomic R)
    (budget_regime R (lit 'atomic-coverage) (lit 'whole-sequential)))
  ((matching_regime R) <-- (exact_whole_inventory R)
    (budget_regime R (lit 'whole-sequential) (lit 'whole-sequential)))
  ((matching_regime R) <-- (exact_whole_inventory R)
    (budget_regime R (lit 'whole-parallel) (lit 'whole-parallel)))
  ((matching_regime R) <-- (scoped_single_file R F)
    (budget_regime R (lit 'whole-sequential) (lit 'whole-sequential)))
  ((matching_regime R) <-- (scoped_single_file R F)
    (budget_regime R (lit 'whole-parallel) (lit 'whole-parallel)))
  ((matching_regime R) <-- (scoped_single_file R F)
    (budget_regime R (lit 'whole-sequential) (lit 'whole-parallel)))
  ((matching_regime R) <-- (scoped_single_file R F)
    (budget_regime R (lit 'whole-parallel) (lit 'whole-sequential)))
  ((matching_regime R) <-- (exact_whole_inventory R)
    (budget_regime R (lit 'whole-sequential) (lit 'whole-parallel)))
  ((matching_regime R) <-- (exact_whole_inventory R)
    (budget_regime R (lit 'whole-parallel) (lit 'whole-sequential)))
  ((observed_change R) <-- (changed_input R C K P B A))
  ((compatible_change R C) <-- (failure_category R (lit 'assertion)) (changed_input R C (lit 'source) P B A))
  ((compatible_change R C) <-- (failure_category R (lit 'assertion)) (changed_input R C (lit 'fixture) P B A))
  ((compatible_change R C) <-- (failure_category R (lit 'signal)) (changed_input R C (lit 'source) P B A))
  ((compatible_change R C) <-- (failure_category R (lit 'budget)) (changed_input R C (lit 'source) P B A))
  ((compatible_change R C) <-- (failure_category R (lit 'budget)) (changed_input R C (lit 'fixture) P B A))
  ((compatible_change R C) <-- (failure_category R (lit 'budget))
    (known_failure R (lit 'gsc))
    (changed_input R C (lit 'compiler-configuration) (lit 'image-build-configuration) B A)
    (compiler_configuration_observation R O N)
    (if (O N) (and (>= N 0) (< N O) (<= O 3)))
    (reviewed_claim R (lit 'compiler-configuration-cause-review))
    (reviewed_claim R (lit 'compiler-configuration-association-review)))
  ((compatible_change R C) <-- (failure_category R (lit 'budget))
    (changed_input R C (lit 'compiler-options) (lit 'dynamic-c-optimization) B A)
    (compiler_probe_failure R (lit 'c-to-dynamic-module))
    (compiler_options_observation R O N)
    (if (O N) (and (>= N 0) (< N O) (<= O 3)))
    (reviewed_claim R (lit 'compiler-options-cause-review))
    (reviewed_claim R (lit 'compiler-command-association-review)))
  ((compatible_change R C) <-- (failure_category R (lit 'budget))
    (changed_input R C (lit 'build-driver) (lit 'bin/gambuild-C) B A)
    (reviewed_claim R (lit 'build-driver-cause-review)))
  ((compatible_change R C) <-- (failure_category R (lit 'budget))
    (changed_input R C (lit 'resource-plan) (lit 'shared-cpu-capacity) B A)
    (resource_plan_observation R O N H)
    (if (O N H) (and (> N 0) (<= N H) (< N O)))
    (reviewed_claim R (lit 'resource-plan-cause-review)))
  ((compatible_change R C) <-- (failure_category R (lit 'environment))
    (changed_input R C (lit 'environment) O B A) (environment_observation R O) (environment_requirement R O))
  ((compatible_change R C) <-- (failure_category R (lit 'budget))
    (changed_input R C (lit 'environment) O B A) (environment_observation R O) (environment_requirement R O)
    (environment_control R O (lit 'DENY) (lit 'PASS) (lit 0) (lit #f) (lit #t)
      (lit #t) (lit #t) (lit #t) (lit #t) CAP CAP))
  ((covered_change R) <-- (claim_change R (lit 'change-relevance-review) C)
    (reviewed_claim R (lit 'change-relevance-review)) (compatible_change R C))
  ((comparable_budget R A) <-- (original_budget R A O) (requested_budget R A N))
  ((comparable_budget R (lit 'atomic-batch)) <-- (whole_dominates_atomic R))
  ((retry_denied R (lit 'budget-expanded)) <-- (whole_covers_original R)
    (budget_regime R (lit 'atomic-coverage) M)
    (original_budget R (lit 'atomic-batch) O) (requested_budget R (lit 'suite-step) N)
    (if (O N) (< O N)))
  ((retry_denied R (lit 'budget-expanded)) <-- (original_budget R A O) (requested_budget R A N) (if (O N) (< O N)))
  ((retry_denied R (lit 'historical-field-unbound)) <-- (observation_required_field R F) (not (observation_matching_field R F)))
  ((retry_denied R (lit 'budget-unbound)) <-- (review_present R) (required_budget R A) (not (comparable_budget R A)))
  ((retry_denied R (lit 'budget-regime-changed)) <-- (review_present R) (not (matching_regime R)))
  ((retry_denied R (lit 'campaign-unbound)) <-- (review_present R) (not (campaign_bound R)))
  ((retry_denied R (lit 'unchanged-inputs)) <-- (review_present R) (not (observed_change R)))
  ((retry_denied R (lit 'change-not-causally-reviewed)) <-- (review_present R) (not (covered_change R)))
  ((retry_denied R (lit 'missing-premise)) <-- (review_present R) (missing_claim R C))
  ((retry_denied R (lit 'circular-review)) <-- (review_present R) (needed_claim R C) (claim_path R C C))
  ((has_denial R) <-- (retry_denied R Reason))
  ((retry_eligible R M) <-- (selected_known_failure R M) (review_present R) (not (has_denial R)))
  ((review_required R M) <-- (selected_known_failure R M) (not (retry_eligible R M)))
  ((retry_any_selected (lit #t)) <-- (selected_known_failure R M))
  ((retry_any_denied (lit #t)) <-- (retry_denied R Reason))
  ((retry_any_review (lit #t)) <-- (review_required R M))
  ((retry_decision (lit 'DENY)) <-- (retry_any_denied (lit #t)))
  ((retry_decision (lit 'REVIEW_REQUIRED)) <-- (retry_any_review (lit #t)) (not (retry_any_denied (lit #t))))
  ((retry_decision (lit 'RETRY_ELIGIBLE)) <-- (retry_any_selected (lit #t))
   (not (retry_any_denied (lit #t))) (not (retry_any_review (lit #t))))
  ((retry_decision (lit 'NOT_REQUIRED)) <-- (retry_marker (lit #t)) (not (retry_any_selected (lit #t)))))
