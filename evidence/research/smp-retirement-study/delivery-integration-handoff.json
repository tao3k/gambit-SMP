  "sourceExcerpts": {
    "hint": "(define-prim (##thread-intr-make-hint! thread)\n  (##declare (not interrupts-enabled))\n  (and (##delivery-pin!)\n       (##vector '() (lambda (hint)\n                       (##thread-intr-wake! thread)\n                       (##delivery-unpin!)))))\n\n",
    "wake": "(define-prim (##thread-intr-wake! thread)\n  (##declare (not interrupts-enabled))\n  (let ((hint (##thread-intr-make-hint! thread)))\n    (##thread-lock-remove-btq-toq!\n     thread\n     (lambda (thread)\n       (if (or (macro-terminated-thread-given-initialized? thread)\n               (##null? (macro-thread-interrupts-head thread)))\n           (macro-unlock-thread! thread)\n           (if (##eq? thread (macro-current-thread))\n               (begin\n                 (macro-unlock-thread! thread)\n                 (##thread-intr-drain!))\n               (begin\n                 (##thread-intr-route-locked! thread hint)\n                 (macro-unlock-thread! thread)))))\n     thread\n     (lambda (thread)\n       (and (##not (macro-terminated-thread-given-initialized? thread))\n            (##not (##null? (macro-thread-interrupts-head thread))))))))\n\n",
    "abandon": "(define-prim (##thread-intr-abandon-owned! interrupt target)\n  (##declare (not interrupts-enabled))\n  (let ((mutex (##vector-ref interrupt 1)))\n    (macro-lock-thread! target)\n    (if (##not (macro-trylock-btq! mutex))\n        (##lock-scheduler-object-with-sync-participation! mutex))\n    ;; Revalidate under the locks that protect mutation. Owner equality\n    ;; alone is not enough: slow unlock can drop the owner-list link\n    ;; before it stores the new owner. A self-linked mutex with the old\n    ;; owner is a partial commit and must not be unlinked again.\n    (let ((owner (macro-btq-owner mutex))\n          (linked? (##not (##eq? (macro-btq-deq-next mutex) mutex)))\n          (waiter (macro-btq-deq-next mutex)))\n      (cond ((and (##eq? owner target) linked?)\n             (##c-code \"___RESULT = ___thread_intr_release_commit (___ARG1, ___ARG2, ___ARG3, ___ARG4);\"\n                       mutex\n                       interrupt\n                       (macro-mutex-state-abandoned)\n                       4)\n             (macro-unlock-btq! mutex)\n             (macro-unlock-thread! target)\n             (if (and (macro-thread? waiter)\n                      (##not (##eq? waiter mutex)))\n                 (##mutex-signal-no-reschedule! mutex waiter #t)))\n            ((##eq? owner target)\n             (##vector-set! interrupt 3 5)\n             (macro-unlock-btq! mutex)\n             (macro-unlock-thread! target))\n            (else\n             (macro-unlock-btq! mutex)\n             (macro-unlock-thread! target))))))\n\n",
    "releaseLeaf": "___SCMOBJ ___thread_intr_release_commit\n   ___P((___SCMOBJ mutex,\n         ___SCMOBJ interrupt,\n         ___SCMOBJ new_owner,\n         ___SCMOBJ new_phase),\n        (mutex,\n         interrupt,\n         new_owner,\n         new_phase)\n___SCMOBJ mutex;\n___SCMOBJ interrupt;\n___SCMOBJ new_owner;\n___SCMOBJ new_phase;)\n{\n  /*\n   * Prepared stores only. This is not an audited no-GC leaf: the field\n   * macros are not a preprocess or object-code certificate.\n   */\n  if (mutex == ___FAL || interrupt == ___FAL)\n    return ___FIX(___UNKNOWN_ERR);\n  ___BTQ_DEQ_NEXT_FIELD(mutex) = mutex;\n  ___BTQ_DEQ_PREV_FIELD(mutex) = mutex;\n  ___BTQ_OWNER_FIELD(mutex) = new_owner;\n  ___FIELD(VECTOR,interrupt,3) = new_phase;\n  return ___FIX(___NO_ERR);\n}"
  },
