+/* POSIX close EINTR does not authorize another close of the same number.
+   Device ownership retains the first error rather than retrying a reused fd. */
+#ifdef USE_POSIX
+#define DEVICE_CLOSE_SOCKET_ONCE(s) close(s)
+#else
+#define DEVICE_CLOSE_SOCKET_ONCE(s) CLOSE_SOCKET(s)
+#endif
 
 ___SCMOBJ ___device_group_cleanup_checked
    ___P((___device_group *dgroup),(dgroup)
@@ -1787,6 +1795,7 @@
 
       devs[0] = self;
       e = ___device_select (devs, 1, 0, 0, ___time_mod.time_pos_infinity);
+      if (e == ___FIX(___ERRNO_ERR(EINTR))) continue;
       if (e != ___FIX(___NO_ERR))
         { self->cleanup_error = e; return e; }
     }
@@ -1801,6 +1810,7 @@
 
       devs[0] = self;
