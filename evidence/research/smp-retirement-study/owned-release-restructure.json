      "sha256": "6081cd912e5903e19cba808fbe646a846ad49459bab73e79b4d67d6ff59c1c72",
      "snapshot": ".cache/tasks/repair-9-12/processes/audit/runs/8ec10fd653e847d794b64c4071886166/outputs/owned-release-research/references/chez/c/thread.c",
      "excerpts": [
        {
          "start": 261,
          "end": 279,
          "text": "static IBOOL destroy_thread(ptr tc) {\n  ptr *ls; IBOOL status;\n\n  status = 0;\n  tc_mutex_acquire();\n  ls = &S_threads;\n  while (*ls != Snil) {\n    ptr thread = Scar(*ls);\n    if (THREADTC(thread) == (uptr)tc) {\n      *ls = Scdr(*ls);\n      S_nthreads -= 1;\n\n      alloc_mutex_acquire();\n\n     /* process remembered set before dropping allocation area */\n      S_scan_dirty((ptr *)TO_VOIDP(EAP(tc)), (ptr *)TO_VOIDP(REAL_EAP(tc)));\n\n     /* close off thread-local allocation */\n      S_thread_start_code_write(tc, 0, 1, NULL, 0);"
        }
      ],
      "notGambitImplementationProof": true
