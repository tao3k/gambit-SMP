    "lib/_thread.scm:1439-1461": {
      "1439": "(define-prim (##thread-intr! thread async? thunk)",
      "1440": "",
      "1441": "  (##declare (not interrupts-enabled))",
      "1442": "",
      "1443": "  ;; Construct a \"result mutex\" to manage the transfer of the",
      "1444": "  ;; interrupt request to the interrupted thread and, when async? is",
      "1445": "  ;; #f, to transfer the result back to the requesting thread.  The",
      "1446": "  ;; mutex's name is the thunk to call and the specific field is the",
      "1447": "  ;; target thread and the thunk's result. Note that if the target",
      "1448": "  ;; thread is terminated or it terminates while the interrupt is",
      "1449": "  ;; being sent, an abandoned mutex exception will be raised.",
      "1450": "",
      "1451": "  (let* ((result-mutex (##make-mutex thunk))",
      "1452": "         (interrupt (##vector '() result-mutex)))",
      "1453": "    (macro-mutex-specific-set! result-mutex thread)",
      "1454": "    (macro-mutex-lock! result-mutex #f thread)",
      "1455": "    (##thread-intr-propagate! interrupt)",
      "1456": "    (if async?",
      "1457": "        (##void)",
      "1458": "        (begin",
      "1459": "          (macro-mutex-lock! result-mutex #f (macro-current-thread))",
      "1460": "          (macro-mutex-unlock! result-mutex)",
      "1461": "          (macro-mutex-specific result-mutex)))))"
    },
