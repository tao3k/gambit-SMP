  "sourceFindings": [
    "vm_native_consumers_clear lacks per-VM retirement/finalizer ledger condition",
    "setup_publish_clean is too late to substitute for pre-destructor admission",
    "current fatal_error calls host/display and exit_process uses exit",
    "raw RC/still APIs shown do not themselves acquire misc lock",
    "same resource pin must cover joined worker tail and subsequent finalizer"
  ],
  "decisions": {
    "lifetime": "pre-registered per-donor resource pin survives keyed tail-to-finalizer phase CAS; aggregate tails are not resource debt",
    "teardown": "seal enrollment and check full registry/borrower debt before destructive cleanup",
    "knownRefusal": "preserve keyed debt, complete common result, skip blocked donor",
    "localFault": "quarantine only after common exit and proved dependency cut; retain slot/VM pin",
    "sharedUnknown": "independent callback-free direct process termination; not successful cleanup or recovery",
    "embedding": "process-fatal compatibility must be reviewed; no host-preserving in-process fallback proven"
  },
