-___HIDDEN void free_psections ___PVOID
-{
-  void *base = ___GSTATE->mem.psections;
-
-  ___GSTATE->mem.psections = 0;
-
-  while (base != 0)
-    {
-      void *link = *___CAST(void**,base);
-      free_mem_aligned_heap (base);
-      base = link;
-    }
-}
