-  ___WORD obj = ___alloc_scmobj (___ps, ___sPAIR, ___PAIR_SIZE<<___LWS);
-
-  if (!___FIXNUMP(obj))
-    {
-      ___CAR_FIELD(obj) = car;
-      ___CDR_FIELD(obj) = cdr;
-    }
-
-  return obj;
-}
