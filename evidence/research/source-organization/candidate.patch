-#define ___MACOS_ERR(oserr) \
-((oserr)==0?___NO_ERR:___ERR_CODE_BUILD(___ERR_CODE_FACILITY_MACOS,oserr))
-
-#define ___MACOS_FROM_ERR_CODE(err) \
-((err)==___NO_ERR?0:((err)-___ERR_CODE_BUILD(___ERR_CODE_FACILITY_MACOS,0)))
