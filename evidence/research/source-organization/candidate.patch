+
+  alloc_stack_ptr = ___ps->context->fp;
+  alloc_heap_ptr  = ___ps->context->hp;
+
+#ifdef ___DEBUG_STACK_LIMIT
+  ___ps->stack_limit_line = line;
+  ___ps->stack_limit_file = file;
+  ___printf ("___POLL caused ___stack_limit call at %s:%d\n",
+             ___ps->poll_file,
+             ___ps->poll_line);
+#endif
