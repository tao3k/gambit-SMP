+       * Get a new stack msection.
+       */
+
+      ___msection *ms = msection_free_list;
+
+      if (stack_msection != heap_msection &&
+          ms != NULL)
+        {
+          /* we can reuse an existing one */
+
+          msection_free_list = ___CAST(___msection*,ms->base[0]);
