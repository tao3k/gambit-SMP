(ascent-fragment (relation scenarioFact ((scenario string?) (role string?)))
(relation targetWriterFact ((key string?) (anchor string?)))
(relation targetRefinementFact ((key string?) (qntScope string?) (leanScope string?)))
(relation targetGateFact ((scenario string?) (key string?) (qualified string?)))
(relation targetSourceFact ((scenario string?) (qualified string?)))
(relation targetWriter ((scenario string?) (key string?) (anchor string?)))
(relation targetRefinement ((scenario string?) (key string?) (qntScope string?) (leanScope string?)))
(relation targetMissing ((scenario string?) (gate string?)))
(relation targetBlocked ((scenario string?) (reason string?)))
(relation targetCandidate ((scenario string?)))
((targetWriter S K A) <-- (scenarioFact S _) (targetWriterFact K A))
((targetRefinement S K Q L) <-- (scenarioFact S _) (targetRefinementFact K Q L))
((targetMissing S G) <-- (targetGateFact S G (lit "false")))
((targetBlocked S G) <-- (targetMissing S G))
((targetBlocked S (lit "source-refinement-open")) <-- (targetSourceFact S (lit "false")))
((targetCandidate S) <-- (scenarioFact S _) (targetSourceFact S (lit "true")) (not (targetBlocked S _)))
)