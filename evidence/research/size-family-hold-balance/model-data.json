  "invariants": [
    "s.phase>=0",
    "s.phase<=6",
    "s.direction>=0",
    "s.direction<=1",
    "s.created>=0",
    "s.created<=1",
    "s.hold>=0",
    "s.hold<=1",
    "s.effects>=0",
    "s.effects<=1",
    "s.root>=0",
    "s.root<=1",
    "s.captured>=0",
    "s.captured<=1",
    "s.gc>=0",
