(##namespace ("gambit#tests#smp#" json-write file-text now assert join-path text-contains suffix? select occurrences small-process sha execute-case cases))
;;; Native Gambit test orchestration. No Python or Shell test framework.
;;; open-process/process-status own process I/O, waiting and result delivery.
;;; GNU timeout supplies a bounded OS process group for compiler descendants;
;;; pseudo-terminal mode is deliberately not used to manufacture a session.
(define (json-write x p)
  (define (sequence xs left right emit)
    (display left p)
    (let loop ((xs xs) (first? #t))
      (if (pair? xs)
          (begin (if (not first?) (display "," p))
                 (emit (car xs)) (loop (cdr xs) #f))))
    (display right p))
  (cond ((string? x)
         (write-char #\" p)
         (string-for-each
          (lambda (c)
            (cond ((char=? c #\") (display "\\\"" p))
                  ((char=? c #\\) (display "\\\\" p))
                  ((char=? c #\newline) (display "\\n" p))
                  ((char=? c #\return) (display "\\r" p))
                  ((char=? c #\tab) (display "\\t" p))
                  ((< (char->integer c) 32)
                   (let ((s (number->string (char->integer c) 16)))
                     (display "\\u" p) (display (make-string (- 4 (string-length s)) #\0) p)
                     (display s p)))
                  (else (write-char c p)))) x)
         (write-char #\" p))
        ((eq? x #t) (display "true" p))
        ((eq? x #f) (display "false" p))
        ;; Gambit may print finite flonums as .5 or 30.; JSON requires a digit
        ;; on both sides of a decimal point. Receipt numbers are finite real
        ;; clocks, budgets, statuses and integer counts, never Scheme ratios.
        ((number? x)
         (let loop ((cs (string->list (number->string x))) (previous #f))
           (if (pair? cs)
               (let ((c (car cs)))
                 (if (char=? c #\.)
                     (begin
                       (if (or (not previous) (char=? previous #\-)) (display "0" p))
                       (display "." p)
                       (if (or (null? (cdr cs)) (not (char-numeric? (cadr cs)))) (display "0" p)))
                     (write-char c p))
                 (loop (cdr cs) c)))))
        ((vector? x) (sequence (vector->list x) "[" "]" (lambda (v) (json-write v p))))
        ((list? x) (sequence x "{" "}"
                    (lambda (kv) (json-write (car kv) p) (display ":" p)
                                 (json-write (cdr kv) p))))
        (else (error "unsupported receipt value" x))))

(define (file-text path) (call-with-input-file path (lambda (p) (read-line p #f))))
(define (now) (time->seconds (current-time)))
(define (assert p . context) (if (not p) (apply error context)))
(define (join-path a b) (path-expand b (string-append a "/")))
(define (text-contains text piece)
  (let loop ((i 0))
    (and (<= (+ i (string-length piece)) (string-length text))
         (or (string=? piece (substring text i (+ i (string-length piece))))
             (loop (+ i 1))))))
(define (suffix? text ending)
  (and (>= (string-length text) (string-length ending))
       (string=? ending (substring text (- (string-length text) (string-length ending)) (string-length text)))))
(define (select pred xs)
  (cond ((null? xs) '()) ((pred (car xs)) (cons (car xs) (select pred (cdr xs))))
        (else (select pred (cdr xs)))))
(define (occurrences text piece)
  (let loop ((i 0) (n 0))
    (if (> (+ i (string-length piece)) (string-length text)) n
        (if (string=? piece (substring text i (+ i (string-length piece))))
            (loop (+ i (string-length piece)) (+ n 1)) (loop (+ i 1) n)))))

;; This small bounded helper is also used for sha256 and process-group probes.
;; Exit codes are the real wait status returned by Gambit's process consumer.
(define (small-process path args)
  (let* ((p (open-process (list path: path arguments: args stderr-redirection: #t)))
         (reader (make-thread (lambda () (read-line p #f)))))
    (close-output-port p)
    (thread-start! reader)
    (let ((status (process-status p 10 'unknown)))
      (assert (number? status) "OS helper result unknown" path)
      (let ((text (thread-join! reader 2 'unknown)))
        (assert (string? text) "OS helper output unknown" path)
        (close-input-port p)
        (cons status text)))))
(define (sha path)
  (let* ((r (small-process "/usr/bin/shasum" (list "-a" "256" path))))
    (assert (= (car r) 0) "sha256 failed" path)
    (substring (cdr r) 0 64)))

(define (execute-case)
  (let* ((root (path-expand (getenv "GAMBIT_SMP_ROOT" ".")))
         (runtime (path-expand (getenv "GAMBIT_SMP_RUNTIME" root)))
         (out (path-expand (getenv "GAMBIT_SMP_OUT")))
         (id (getenv "GAMBIT_SMP_CASE"))
         (cc (getenv "GAMBIT_SMP_CC" "/opt/homebrew/bin/gcc-16"))
         (timeout-tool (getenv "GAMBIT_SMP_TIMEOUT" "/opt/homebrew/bin/gtimeout"))
         (paths (string-append ",~~lib=" runtime "/lib,~~bin=" runtime "/bin,~~include=" runtime "/include"))
         (commands '()) (identity '()) (outcome "FAIL") (started (now))
         (deadline #f) (workers 1))
    (define (add k v) (set! identity (cons (cons k v) identity)))
    (define (command name argv cap cwd)
      (let* ((budget (if deadline (min cap (- deadline (now))) cap))
             (output (join-path out (string-append name ".output")))
             (start (now)))
        (assert (> budget 0) "module deadline exhausted" id)
        (let* ((p (open-process
                   (list path: timeout-tool
                         arguments: (append (list "--kill-after=2s" (number->string budget)) argv)
                         directory: cwd stderr-redirection: #t)))
               (pid (process-pid p))
               (reader (make-thread
                        (lambda ()
                          (call-with-output-file output
                            (lambda (log)
                              (let loop ((b (read-u8 p)))
                                (if (not (eof-object? b))
                                    (begin (write-u8 b log) (loop (read-u8 p)))))))))))
          (close-output-port p)
          (thread-start! reader)
          (let* ((status (process-status p (+ budget 3) 'unknown))
                 (group (small-process "/bin/kill" (list "-0" "--" (number->string (- pid)))))
                 (quiet (= (car group) 256)))
            (if (not quiet)
                (small-process "/bin/kill" (list "-KILL" "--" (number->string (- pid)))))
            (let ((read-result (thread-join! reader 2 'unknown)))
              (close-input-port p)
              (set! commands
                (cons (list (cons "stage" name) (cons "argv" (list->vector argv))
                            (cons "cwd" cwd) (cons "budget" budget)
                            (cons "rawWaitStatus" (if (number? status) status -1))
                            (cons "exit" (if (number? status)
                                             (if (= (modulo status 256) 0) (quotient status 256)
                                                 (+ 128 (modulo status 128))) -1))
                            (cons "timeout" (or (eq? status 'unknown) (and (memv status '(31744 35072)) #t)))
                            (cons "parentReaped" (number? status))
                            (cons "processGroupQuiescent" quiet)
                            (cons "seconds" (- (now) start))
                            (cons "output" (string-append name ".output"))
                            (cons "outputSha256" (sha output))) commands))
              (assert (and (number? status) (= status 0) quiet
                           (not (eq? read-result 'unknown))) "command failed or unknown" name status)
              (file-text output))))))
    (create-directory out)
    (with-exception-catcher
     (lambda (e) (add "error" (call-with-output-string (lambda (p) (display-exception e p)))))
     (lambda ()
       (for-each (lambda (k) (setenv k))
                 '("SDKROOT" "LIBRARY_PATH" "CPATH" "GAMBOPT" "GERBIL_HOME" "GERBIL_LOADPATH" "GERBIL_GSC"))
       (setenv "PATH" (string-append (path-directory cc) ":/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin"))
       (setenv "CC" cc)
       (load (join-path root "tests/smp/catalog.scm"))
       (add "module" id)
       (add "runnerSha256" (sha (join-path root "tests/smp/suite.scm")))
       (add "planSha256" (sha (join-path root "tests/smp/catalog.scm")))
       (set! workers (max 1 (- (call-with-input-string
                                (cdr (small-process "/usr/sbin/sysctl" '("-n" "hw.logicalcpu"))) read) 1)))
       (add "compilerProcessors" workers)
       (setenv "GAMBOPT" (string-append "p" (number->string workers) paths))
       (if (string=? id "gambit.smp.bootstrap.two-pass")
        (begin
         (add "namespace" "gambit.smp.bootstrap") (add "name" "two-pass")
         (assert (equal? root runtime) "bootstrap must build this checkout")
         (let* ((all-files (apply append
                            (map (lambda (d) (map (lambda (p) (string-append d "/" p))
                                                   (directory-files (join-path root d))))
                                 '("lib" "gsi" "gsc"))))
                (schemes (select (lambda (p) (suffix? p ".scm")) all-files))
                (generated (select (lambda (p) (and (suffix? p ".c")
                                                    (char=? (string-ref (path-strip-directory p) 0) #\_))) all-files))
                (before (map (lambda (p) (cons p (sha (join-path root p)))) schemes))
                (boot (join-path root "gsc-boot")))
           (assert (pair? generated) "no generated C inventory")
           (if (file-exists? boot) (delete-file boot))
           (copy-file (join-path root "gsc/gsc") boot)
           (command "bootclean" '("/usr/bin/make" "bootclean") 10 root)
           (for-each (lambda (p) (assert (not (file-exists? (join-path root p))) "generated C survived bootclean" p)) generated)
           (let* ((log (command "bootstrap" (list "/usr/bin/make" (string-append "-j" (number->string workers))
                                                  (string-append "GAMBOPT=p" (number->string workers)) "from-scratch") 600 root))
                  (phases (map (lambda (p) (cons p (occurrences log (string-append "*** making " p "\n")))) '("phase1" "phase2" "phase3" "phase4"))))
             (for-each (lambda (p) (assert (= (cdr p) 2) "incomplete two-pass bootstrap" p)) phases)
             (add "phaseCounts" phases))
           (for-each (lambda (p) (assert (file-exists? (join-path root p)) "generated C missing" p)) generated)
           (for-each (lambda (p) (assert (equal? (cdr p) (sha (join-path root (car p)))) "Scheme source changed" (car p))) before)
           (add "fullTwoPassBootstrapEstablished" #t)
           (set! outcome "PASS")))
       (let* ((case (assoc id cases))
              (kind (cadr case)) (program (caddr case))
              (expected (list-ref case 3)) (topology (list-ref case 4))
              (source (join-path root program))
              (files (append '("include/gambit.h.in" "lib/mem.c")
                             (map (lambda (p) (string-append "lib/memory/" p))
                                  (directory-files (join-path root "lib/memory")))))
              (source-hashes (map (lambda (f) (cons f (sha (join-path root f)))) files)))
         (add "namespace" (list-ref case 6)) (add "name" (list-ref case 7)) (add "program" program) (add "programSha256" (sha source))
         (add "runtimeSource" source-hashes)
         (add "compiler" cc) (add "compilerSha256" (sha cc))
         (for-each (lambda (row) (assert (equal? (cdr row) (sha (join-path runtime (car row)))) "runtime source drift" (car row))) source-hashes)
         (set! deadline (+ (now) (list-ref case 5)))
         (setenv "GAMBOPT" (string-append "p" (number->string workers) paths))
         (cond
          ((string=? kind "kernel")
           (command "compile" (list cc "-std=c23" "-O1" "-pthread" "-DHAVE_CONFIG_H" "-I" (join-path runtime "include") source "-o" (join-path out "kernel")) 30 runtime)
           (let ((text (command "run" (list (join-path out "kernel")) 10 out)))
             (if (string=? id "gambit.smp.runtime.roles.storage-layout")
                 (assert (and (text-contains text "RUNTIME-ROLES-STORAGE-PASS word=")
                              (text-contains text " context=") (text-contains text " vm=")) "invalid storage result")
                 (assert (equal? expected text) "kernel result mismatch" text))))
          ((string=? kind "make")
           (command "unchanged" '("/usr/bin/make" "-q" "mem.o") 10 (join-path runtime "lib"))
           (let ((fragments (directory-files (join-path runtime "lib/memory"))))
             (assert (= (length fragments) 25) "incomplete memory inventory")
             (for-each
              (lambda (f)
                (assert (text-contains
                         (command (string-append "fragment-" f)
                                  (list "/usr/bin/make" "-n" "-W" (string-append "memory/" f) "mem.o")
                                  10 (join-path runtime "lib")) "mem.c") "fragment does not invalidate mem.o" f)) fragments)))
          ((string=? kind "scheme")
           (copy-file source (join-path out "fixture.scm"))
           (command "compile" (list (join-path runtime "gsc/gsc") "-exe" "-o" (join-path out "fixture") "-cc-options" "-pthread" "-ld-options" "-pthread" (join-path out "fixture.scm")) 90 out)
           (let ((population (if (string=? topology "host-managed") workers 1)))
             (add "executionProcessors" population)
             (setenv "GAMBOPT" (string-append "p" (number->string population) paths))
             (setenv "GAMBIT_SMP_EXPECTED_PROCESSORS" (number->string population)))
           (let ((text (command "run" (list (join-path out "fixture")) 30 out)))
             (assert (equal? expected text) "Scheme result mismatch" text)))
          (else (error "unknown module kind" kind)))
         (for-each (lambda (row) (assert (equal? (cdr row) (sha (join-path runtime (car row)))) "runtime changed" (car row))) source-hashes)
         (assert (equal? (sha source) (cdr (assoc "programSha256" identity))) "test source changed")
         (set! outcome "PASS")))))
    (call-with-output-file (join-path out "receipt.json")
      (lambda (p) (json-write
                  (append (list (cons "outcome" outcome) (cons "seconds" (- (now) started))
                                (cons "commands" (list->vector (reverse commands)))
                                (cons "wholeSmpAdmitted" #f) (cons "commitAdmitted" #f)) identity) p)
                  (newline p)))
    (display id) (display " ") (display outcome) (newline)
    (exit (if (string=? outcome "PASS") 0 1))))
(execute-case)
