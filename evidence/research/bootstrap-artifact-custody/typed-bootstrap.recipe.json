{
  "schema": "evidence-recipe.v2",
  "id": "modern-c-entry-custody-bootstrap",
  "scope": "Exact current generator host -> two target source passes; immutable completed artifacts and private destructive rebuild; original profile and whole/step budgets retained",
  "budgetSeconds": 600,
  "workspacePolicy": "in-place",
  "inputs": [
    "evidence/research/ordered-sync/initialization/source.lock.json",
    "evidence/research/ordered-sync/initialization/source-overlay.patch",
    "evidence/fixtures/gerbil-bazel-build-profile/profile.json",
    "evidence/research/execution/entry.json",
    "evidence/dsl/execution.ss",
    "evidence/research/ordered-sync/initialization/host.json",
    "evidence/native-failures.json",
    "evidence/research/suite-review-rules.ss",
    "evidence/research/ordered-sync/initialization/intent.json",
    "vendor/gambit/tests/frame-continuation.scm",
    "vendor/gambit/tests/frame-continuation-roots.scm",
    "evidence/research/modern-c-bootstrap/historical-log-restoration.json",
    "evidence/research/ordered-sync/initialization/causal-review.json",
    "dev/refactoring/modern-c/models/sysml/copy-custody.sysml",
    "dev/refactoring/modern-c/models/sysml/memory-organization.sysml",
    "evidence/research/memory-organization/validation.json",
    "evidence/research/modern-c-bootstrap/request-custody-records/model__dev__refactoring__modern-c__models__sysml__copy-custody.sysml",
    "evidence/research/modular-smp-bootstrap/fragment-admission.json",
    "evidence/research/bootstrap-artifact-custody/contract.json",
    "evidence/research/bootstrap-artifact-custody/typed-transport.json"
  ],
  "steps": [
    {
      "id": "candidate",
      "capability": "gambit.materialize",
      "dependsOn": [

      ],
      "arguments": {
        "sourceLock": "evidence/research/ordered-sync/initialization/source.lock.json",
        "buildWorkspace": "gambit-core"
      },
      "budgetSeconds": 30
    },
    {
      "id": "configure",
      "capability": "gambit.configure",
      "dependsOn": [
        "candidate"
      ],
      "arguments": {
        "source": {
          "step": "candidate",
          "output": "source"
        },
        "buildProfile": "evidence/fixtures/gerbil-bazel-build-profile/profile.json"
      },
      "budgetSeconds": 150
    },
    {
      "id": "compiler-input",
      "capability": "gambit.bootstrap-input",
      "dependsOn": [
        "configure"
      ],
      "budgetSeconds": 30,
      "arguments": {
        "source": {
          "step": "configure",
          "output": "source"
        },
        "bootstrapHost": "evidence/research/ordered-sync/initialization/host.json"
      }
    },
    {
      "id": "review",
      "capability": "gambit.review",
      "dependsOn": [
        "compiler-input"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "runtime": {
          "step": "compiler-input",
          "output": "source"
        },
        "identity": {
          "step": "compiler-input",
          "output": "identity"
        },
        "intent": "evidence/research/ordered-sync/initialization/intent.json",
        "target": "bootstrap"
      }
    },
    {
      "id": "bootstrap",
      "capability": "gambit.bootstrap",
      "dependsOn": [
        "compiler-input",
        "review"
      ],
      "budgetSeconds": 600,
      "arguments": {
        "runtime": {
          "step": "compiler-input",
          "output": "source"
        },
        "identity": {
          "step": "compiler-input",
          "output": "identity"
        },
        "retryReview": {
          "step": "review",
          "output": "review"
        },
        "failures": "evidence/native-failures.json",
        "reviewRules": "evidence/research/suite-review-rules.ss"
      }
    },
    {
      "id": "map",
      "capability": "gambit.executable-test",
      "dependsOn": [
        "bootstrap"
      ],
      "budgetSeconds": 90,
      "arguments": {
        "runtime": {
          "step": "bootstrap",
          "output": "runtime"
        },
        "identity": {
          "step": "bootstrap",
          "output": "identity"
        },
        "program": "vendor/gambit/tests/frame-continuation.scm",
        "stdout": "FRAME-CONTINUATION-PASS\nHASH-INDEX-OWNER-PASS\n",
        "processorTopology": "fixture-managed",
        "executionBudgetSeconds": 30
      }
    },
    {
      "id": "wide-map",
      "capability": "gambit.executable-test",
      "dependsOn": [
        "bootstrap"
      ],
      "budgetSeconds": 90,
      "arguments": {
        "runtime": {
          "step": "bootstrap",
          "output": "runtime"
        },
        "identity": {
          "step": "bootstrap",
          "output": "identity"
        },
        "program": "vendor/gambit/tests/frame-continuation-roots.scm",
        "stdout": "FRAME-CONTINUATION-ROOTS-PASS\nFORCED-GC-COMPLETE count=11\n",
        "processorTopology": "fixture-managed",
        "executionBudgetSeconds": 30
      }
    },
    {
      "id": "wide-map-host",
      "capability": "gambit.executable-test",
      "dependsOn": [
        "bootstrap"
      ],
      "budgetSeconds": 90,
      "arguments": {
        "runtime": {
          "step": "bootstrap",
          "output": "runtime"
        },
        "identity": {
          "step": "bootstrap",
          "output": "identity"
        },
        "program": "vendor/gambit/tests/frame-continuation-roots.scm",
        "stdout": "FRAME-CONTINUATION-ROOTS-PASS\nFORCED-GC-COMPLETE count=11\n",
        "processorTopology": "host-managed",
        "executionBudgetSeconds": 30
      }
    },
    {
      "id": "verdict",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "candidate",
        "configure",
        "compiler-input",
        "review",
        "bootstrap",
        "map",
        "wide-map",
        "wide-map-host"
      ],
      "budgetSeconds": 10,
      "arguments": {
        "dsl": "evidence/research/execution/entry.json",
        "queries": {
          "checked": "checked_step",
          "missing": "missing_step"
        },
        "expected": {
          "missing": [

          ]
        },
        "recordedQueries": [
          "checked"
        ]
      }
    }
  ]
}
