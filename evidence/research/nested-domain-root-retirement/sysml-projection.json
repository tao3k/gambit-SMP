  "gain": [
    {
      "key": "G1",
      "avoided": "Capture/restoration remains Scheme control independent of native stack return",
      "added": "One fresh execution guard and ticket for each managed resumption",
      "condition": "Two modeled resumptions; no baseline OS-thread-count saving claimed"
    },
    {
      "key": "G2",
      "avoided": "Outer unwind cannot silently abandon admitted inner root/code custody",
      "added": "O(d) descendant closure and lease transfer for d affected native domains",
      "condition": "No claim that sequential END_SFUN cleanup already covers every unwind"
    },
    {
      "key": "G3",
      "avoided": "Retirement checks can reuse one subtree/root/code ledger",
      "added": "Ledger publication, pinning and acknowledgement traffic",
      "condition": "Only if it replaces duplicated adapter state; layering it over old ownership has no demonstrated work saving"
    },
    {
      "key": "G4",
      "avoided": "Known native frame expiry need not force retention of whole execution context",
      "added": "Separate RootBundle, captured frames and image leases",
      "condition": "Safe separation is conditional; object bytes and exact root/descriptor closure remain unresolved"
    },
    {
      "key": "G5",
      "avoided": "Independent compilation contexts can share the same explicit entry schema",
      "added": "Native owner pin occupancy and per-context root registry support",
      "condition": "Parallel gxi/gxc throughput is not proved by this lifetime model"
    },
    {
      "key": "G6",
      "avoided": "Roots may retire while descriptor lease still protects a captured frame or scanner in a general design",
      "added": "This bounded conservative model waits for captures then root readers; descriptor release follows",
      "condition": "No prompt-reclamation or reduced scan-count claim without a less conservative product proof"
    },
    {
      "key": "G7",
      "avoided": "C23 can express the whole contract; no extra language is required for it",
      "added": "C23 ABI adapters, atomic publication and reader retirement remain necessary",
      "condition": "Zig adds the same semantic work; incremental net benefit remains unproved"
    }
  ],
  "memory": [
    {
      "key": "root-publication",
      "publication": "Initialize bundle slots and descriptor leases before release publication",
      "observation": "Acquire registry snapshot or registration lock, then pin actual slots",
      "obligation": "Source release requires a qualifying root-round receipt; sampling reader count zero is not a receipt"
    },
    {
      "key": "subtree-escrow",
      "publication": "Fill stable operation record and retain descendant roots/code before release publishing escrow",
      "observation": "Owning thread acquires/validates exact closed subtree before longjmp",
      "obligation": "Atomic abstract escrow requires a native refinement; two separate guard stores are not an atomic transaction"
    },
    {
      "key": "landing-reply",
      "publication": "Release commit landing record after exact target catcher is reached",
      "observation": "Acquire same operation identity; missing reply remains unknown",
      "obligation": "No timeout can substitute for a landing or failure receipt"
    },
    {
      "key": "root-retirement",
      "publication": "Close bundle admission acq_rel and release last admitted scanner pin",
      "observation": "Acquire observes closed admission and scanner grace",
      "obligation": "GC must not wait on a guard that waits for that same GC; existing scanners finish while guards stay rooted"
    },
    {
      "key": "image-retirement",
      "publication": "Retain image/code leases for captured frames and admitted scanners",
      "observation": "Acquire aggregate root/code/native-owner closure across all VMs",
      "obligation": "Marker invalidation and frame_access gate release alone are not global unload permission"
    }
  ],
