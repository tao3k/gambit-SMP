+/* Diagnostic only. Fetch-add, acquire load, unlock fetch-add and the
+   barrier message sequence are unchanged. Slots record a held ticket
+   word; a later unlock advances current, so a match is the live holder. */
+#ifndef ___TICKET_OBS_SLOTS
+#define ___TICKET_OBS_SLOTS 8192
+#endif
+
+static struct ___ticket_obs_slot
+  {
+    uint64_t sequence;
+    void *return_address;
+    ___WORD served;
+    void *lock;
+    unsigned long epoch;
+    uint64_t thread;
+  } ___ticket_obs_slots[___TICKET_OBS_SLOTS];
+static uint64_t ___ticket_obs_next;
+static volatile int ___ticket_obs_reported;
+static unsigned ___ticket_obs_dropped;
+static int ___ticket_obs_op_incomplete;
+static struct ___ticket_barrier_slot
+  {
+    uint64_t sequence;
+    int active;
+    int proposal;
+    void *vm;
+    void *return_address;
+    uint64_t thread;
+  } ___ticket_obs_barrier[___MAX_PROCESSORS];
+
+static uint64_t ___ticket_obs_thread(void)
+{
+#ifdef __APPLE__
+  uint64_t id = 0;
+  int saved_errno = errno;
+  int result = pthread_threadid_np(NULL, &id);
+  errno = saved_errno;
+  if (result != 0)
+    return 0;
+  return id;
+#else
+  return (uint64_t)(uintptr_t)pthread_self();
+#endif
+}
+
+static void ___ticket_obs_barrier_update(int id, void *vm, int active,
+                                        int proposal, void *return_address)
+{
+  struct ___ticket_barrier_slot *slot;
+  uint64_t sequence;
+  if ((unsigned)id >= ___MAX_PROCESSORS)
+    {
+      __atomic_store_n(&___ticket_obs_op_incomplete, 1, __ATOMIC_RELEASE);
+      return;
+    }
+  slot = &___ticket_obs_barrier[id];
+  sequence = __atomic_load_n(&slot->sequence, __ATOMIC_ACQUIRE);
+  if (sequence >= UINT64_MAX - 2 || (sequence & 1u) ||
+      !__atomic_compare_exchange_n(&slot->sequence, &sequence, sequence + 1u,
+                                   0, __ATOMIC_ACQ_REL, __ATOMIC_RELAXED))
+    {
+      __atomic_store_n(&___ticket_obs_op_incomplete, 1, __ATOMIC_RELEASE);
+      return;
+    }
+  __atomic_store_n(&slot->active, active, __ATOMIC_RELAXED);
+  __atomic_store_n(&slot->proposal, proposal, __ATOMIC_RELAXED);
+  __atomic_store_n(&slot->vm, vm, __ATOMIC_RELAXED);
+  __atomic_store_n(&slot->return_address, return_address, __ATOMIC_RELAXED);
+  __atomic_store_n(&slot->thread, ___ticket_obs_thread(), __ATOMIC_RELAXED);
+  __atomic_store_n(&slot->sequence, sequence + 2u, __ATOMIC_RELEASE);
+}
+
+static const char *___ticket_obs_op_name(int op)
+{
+  switch (op)
+    {
+    case OP_PROCESSOR_0_THROW_ERROR: return "OP_PROCESSOR_0_THROW_ERROR";
+    case OP_SET_PROCESSOR_COUNT: return "OP_SET_PROCESSOR_COUNT";
+    case OP_VM_RESIZE: return "OP_VM_RESIZE";
+    case OP_GARBAGE_COLLECT: return "OP_GARBAGE_COLLECT";
+    case OP_VM_RESIZE_RESULT: return "OP_VM_RESIZE_RESULT";
+    case OP_VM_RESIZE_HEAP_GUARD: return "OP_VM_RESIZE_HEAP_GUARD";
+    case OP_PROCESSOR_STARTUP_READY: return "OP_PROCESSOR_STARTUP_READY";
+    case OP_FDSET_RESIZE: return "OP_FDSET_RESIZE";
+    case OP_ACTLOG_START: return "OP_ACTLOG_START";
+    case OP_ACTLOG_STOP: return "OP_ACTLOG_STOP";
+    case OP_NOOP: return "OP_NOOP";
+    default: return "OP_UNLISTED";
+    }
+}
+
+__attribute__((noinline))
+void ___ticket_holder_note(void *lock, ___WORD served, void *return_address)
+{
+  uint64_t index, sequence, thread;
+  unsigned long epoch;
+  struct ___ticket_obs_slot *slot;
+  if (__atomic_load_n(&___ticket_obs_constructing, __ATOMIC_ACQUIRE) != 0)
+    return;
+  epoch = __atomic_load_n(&___ticket_obs_epoch, __ATOMIC_ACQUIRE);
+  thread = ___ticket_obs_thread();
+  if (thread == 0)
+    return;
+  if (return_address == NULL)
+    return_address = __builtin_extract_return_addr(__builtin_return_address(0));
+  index = __atomic_fetch_add(&___ticket_obs_next, UINT64_C(1), __ATOMIC_RELAXED);
+  if (index >= UINT64_MAX / 2)
+    return;
+  slot = &___ticket_obs_slots[index % ___TICKET_OBS_SLOTS];
+  sequence = __atomic_load_n(&slot->sequence, __ATOMIC_ACQUIRE);
+  if ((sequence & 1u) ||
+      !__atomic_compare_exchange_n(&slot->sequence, &sequence, (index + 1) * 2 - 1,
+                                   0, __ATOMIC_ACQ_REL, __ATOMIC_RELAXED))
+    {
+      __atomic_fetch_add(&___ticket_obs_dropped, 1u, __ATOMIC_RELAXED);
+      return;
+    }
+  __atomic_store_n(&slot->return_address, return_address, __ATOMIC_RELAXED);
+  __atomic_store_n(&slot->served, served, __ATOMIC_RELAXED);
+  __atomic_store_n(&slot->epoch, epoch, __ATOMIC_RELAXED);
+  __atomic_store_n(&slot->thread, thread, __ATOMIC_RELAXED);
+  __atomic_store_n(&slot->lock, lock, __ATOMIC_RELAXED);
+  __atomic_store_n(&slot->sequence, (index + 1) * 2, __ATOMIC_RELEASE);
+}
+
+__attribute__((noinline))
+int ___ticket_obs_after_trylock(___SCMOBJ obj, ___SCMOBJ current_index, int acquired, void *return_address)
+{
+  if (acquired)
+    {
+      ___WORD *current = &___FIELD(STRUCTURE,obj,___INT(current_index));
+      if (return_address == NULL)
+        return_address = __builtin_extract_return_addr(__builtin_return_address(0));
+      ___ticket_holder_note(current, ___TICKETLOCK_READ_CURRENT(*current), return_address);
+    }
+  return acquired;
+}
+
+__attribute__((noinline))
+void ___ticket_holder_report(void *lock, ___WORD ticket, void *waiter_return_address)
+{
+  char barriers[1400];
+  char line[1800];
+  void *holder_ra = NULL;
+  uint64_t holder_thread = 0;
+  ___processor_state observer = ___PSTATE;
+  ___virtual_machine_state vm = observer == NULL ? NULL : ___VMSTATE_FROM_PSTATE(observer);
+  int target = -1;
+  int population;
+  unsigned long epoch;
+  ___WORD live;
+  uint64_t next;
+  uint64_t count;
+  uint64_t cursor;
+  unsigned used;
+  int id;
+  int length;
+  int saved_errno = errno;
+
+  if (__atomic_load_n(&___ticket_obs_reported, __ATOMIC_RELAXED) >= 2 ||
+      __atomic_load_n(&___ticket_obs_constructing, __ATOMIC_ACQUIRE) != 0 ||
+      __atomic_load_n(&___ticket_obs_pid, __ATOMIC_ACQUIRE) != (int)getpid())
+    return;
+
+  epoch = __atomic_load_n(&___ticket_obs_epoch, __ATOMIC_ACQUIRE);
+  population = vm == NULL ? 0 : vm->processor_count;
+  if (population <= 0 || population > ___MAX_PROCESSORS)
+    return;
+  for (id = 0; id < population; id++)
+    {
+      ___processor_state ps = ___PSTATE_FROM_PROCESSOR_ID(id, vm);
+      if (ps != NULL && lock == &___FIELD(STRUCTURE,___PROCESSOR_SCMOBJ(ps),___OBJ_LOCK2))
+        {
+          target = id;
+          break;
+        }
+    }
+  if (target < 0)
+    return;
+  if (waiter_return_address == NULL)
+    waiter_return_address = __builtin_extract_return_addr(__builtin_return_address(0));
+  live = ___TICKETLOCK_READ_CURRENT(*(___WORD *)lock);
+  next = __atomic_load_n(&___ticket_obs_next, __ATOMIC_ACQUIRE);
+  if (next >= UINT64_MAX / 2)
+    return;
+  count = next < ___TICKET_OBS_SLOTS ? next : ___TICKET_OBS_SLOTS;
+  for (cursor = 0; cursor < count; cursor++)
+    {
+      uint64_t absolute = next - 1u - cursor;
+      unsigned index = absolute % ___TICKET_OBS_SLOTS;
+      struct ___ticket_obs_slot *slot = &___ticket_obs_slots[index];
+      uint64_t sequence = __atomic_load_n(&slot->sequence, __ATOMIC_ACQUIRE);
+      void *noted, *address;
+      ___WORD served;
+      unsigned long noted_epoch;
+      uint64_t thread;
+      if (sequence != (absolute + 1) * 2)
+        continue;
+      noted = __atomic_load_n(&slot->lock, __ATOMIC_RELAXED);
+      served = __atomic_load_n(&slot->served, __ATOMIC_RELAXED);
+      noted_epoch = __atomic_load_n(&slot->epoch, __ATOMIC_RELAXED);
+      address = __atomic_load_n(&slot->return_address, __ATOMIC_RELAXED);
+      thread = __atomic_load_n(&slot->thread, __ATOMIC_RELAXED);
+      __atomic_thread_fence(__ATOMIC_ACQ_REL);
+      if (__atomic_load_n(&slot->sequence, __ATOMIC_ACQUIRE) != sequence)
+        continue;
+      if (noted == lock && served == live && noted_epoch == epoch && live != ___FIX(0))
+        {
+          holder_ra = address;
+          holder_thread = thread;
+          break;
+        }
+    }
+
+  used = 0;
+  barriers[0] = '\0';
+  for (id = 0; id < ___MAX_PROCESSORS; id++)
+    {
+      struct ___ticket_barrier_slot *slot = &___ticket_obs_barrier[id];
+      uint64_t sequence = __atomic_load_n(&slot->sequence, __ATOMIC_ACQUIRE);
+      int active, proposal;
+      void *observed_vm, *address;
+      uint64_t thread;
+      if ((sequence & 1u) || __atomic_load_n(&___ticket_obs_op_incomplete, __ATOMIC_ACQUIRE))
+        continue;
+      active = __atomic_load_n(&slot->active, __ATOMIC_RELAXED);
+      proposal = __atomic_load_n(&slot->proposal, __ATOMIC_RELAXED);
+      observed_vm = __atomic_load_n(&slot->vm, __ATOMIC_RELAXED);
+      address = __atomic_load_n(&slot->return_address, __ATOMIC_RELAXED);
+      thread = __atomic_load_n(&slot->thread, __ATOMIC_RELAXED);
+      __atomic_thread_fence(__ATOMIC_ACQ_REL);
+      if (!active || observed_vm != vm ||
+          __atomic_load_n(&slot->sequence, __ATOMIC_ACQUIRE) != sequence)
+        continue;
+      length = snprintf(barriers + used, sizeof barriers - used, "%s%d:thread=%llu:proposal=%s@%p",
+                        used == 0 ? "" : ",", id,
+                        (unsigned long long)thread, ___ticket_obs_op_name(proposal), address);
+      if (length < 0 || (unsigned)length >= sizeof barriers - used)
+        break;
+      used += (unsigned)length;
+    }
+  if (used == 0)
+    snprintf(barriers, sizeof barriers, "NONE");
+
+  if (___TICKETLOCK_READ_CURRENT(*(___WORD *)lock) != live ||
+      __atomic_load_n(&___ticket_obs_epoch, __ATOMIC_ACQUIRE) != epoch ||
+      __atomic_load_n(&___ticket_obs_constructing, __ATOMIC_ACQUIRE) != 0)
+    return;
+  if (__atomic_fetch_add(&___ticket_obs_reported, 1, __ATOMIC_RELAXED) >= 2)
+    return;
+
+  length = snprintf(line, sizeof line,
+                    "TICKET-HOLDER-DISCRIMINATOR epoch=%lu vm=%p target=%d population=%d current=%ld ticket=%ld waiter_ra=%p holder_thread=%llu holder_return=%p active_barrier_proposals=%s\n",
+                    epoch, (void *)vm, target, population,
+                    (long)___INT(live), (long)___INT(ticket), waiter_return_address,
+                    (unsigned long long)holder_thread, holder_ra, barriers);
+  if (length > 0)
+    {
+      if ((unsigned)length >= sizeof line)
+        length = (int)sizeof line - 1;
+      write(2, line, (size_t)length);
+    }
+  errno = saved_errno;
+}
