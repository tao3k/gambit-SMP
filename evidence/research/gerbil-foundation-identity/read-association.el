(require 'json)
(setq enable-local-variables nil)
(let ((input (getenv "ASSURANCE_READ")) (output (getenv "ASSURANCE_JSON")))
  (with-temp-buffer
    (insert-file-contents input)
    (emacs-lisp-mode)
    (goto-char (point-min))
    ;; Only Scheme Boolean reader tokens outside strings are normalized.
    (while (re-search-forward "#[tf]\\_>" nil t)
      (let ((pos (match-beginning 0)) (token (match-string 0)))
        (unless (nth 3 (syntax-ppss pos))
          (replace-match (if (equal token "#t") "t" "nil") t t))))
    (goto-char (point-min))
    (let* ((wire (read (current-buffer)))
           (brief (cadr (assoc "brief" wire)))
           (association (cadr (assoc "association" brief))) (result nil))
      (dolist (name '("imageCandidate" "canonicalDefinition" "reconstructionRequired" "serializedInstanceRequired" "foundationAdmissionBlocked" "supportClosure" "opaqueSupport" "stateOwnership" "sourceAdmissionBlocked" "modelRequired" "qualifiedSlice" "locallyChecked" "assuranceReady" "componentReady" "componentFrontier" "danglingDependency" "unboundDependency" "sharedContract" "sourceRoute" "missingModel" "pendingCheck" "nextAction"
                      "openPremise" "unmetDependency" "dependencyCycle" "unroutedNeed"))
        (push (cons name (vconcat (mapcar #'vconcat (cadr (assoc name association))))) result))
      (push (cons "counts" (mapcar (lambda (x) (cons (car x) (cadr x))) (cadr (assoc "counts" brief)))) result)
      (unless (assoc "runtimeAdmitted" brief) (error "Missing runtime-admission field"))
      (push (cons "runtimeAdmitted" (if (cadr (assoc "runtimeAdmitted" brief)) t :json-false)) result)
      (push (cons "presentationComplete" (if (cadr (assoc "presentationComplete" brief)) t :json-false)) result)
      (push (cons "retainedTaskHypotheses" (cadr (assoc "retainedHypotheses" (cadr (assoc "hypothesisJournal" brief))))) result)
      (with-temp-file output (insert (json-encode result))))))
