+/*
+ * 'free_msections (msp)' releases all memory associated with the
+ * msections pointed to by 'msp'.
+ */
+
+___HIDDEN void free_msections
+   ___P((___msections **msp),
+        (msp)
+___msections **msp;)
+{
+  ___msections *ms = *msp;
+
+  if (ms != 0)
+    {
+      int i;
+
+      for (i=ms->nb_sections-1; i>=0; i--)
+        free_mem_aligned_heap (ms->sections[i]);
