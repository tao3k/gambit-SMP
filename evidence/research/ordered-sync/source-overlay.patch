+#ifdef ___ALLOC_MEM_UP
+          i++;
+#endif
+
+          for (j=ns; j>i; j--)
+            {
+              ms->sections[j] = ms->sections[j-1];
+              ms->sections[j]->pos = j;
+            }
+
+          ms->sections[i] = s;
+
+          if (tl == 0)
+            {
+              hd = s;
+              s->index = 0;
+            }
+          else
+            {
+              tl->next = s;
+              s->index = tl->index + 1;
+            }
+
+          s->pos = i;
+          s->prev = tl;
+          s->next = 0;
+
+          tl = s;
+
+          ms->nb_sections = ++ns;
+          ms->head = hd;
+          ms->tail = tl;
+        }
+    }
+}
