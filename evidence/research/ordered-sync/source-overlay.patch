+  base = ___CAST(___WORD*,
+                 alloc_mem_aligned_psection
+                   (___PSECTION_SIZE,
+                    multiplier,
+                    modulus));
+
+  if (base != 0)
+    {
+      ___GSTATE->mem.palloc_ptr = base + words;
+      ___GSTATE->mem.palloc_limit = base + ___PSECTION_SIZE;
+    }
