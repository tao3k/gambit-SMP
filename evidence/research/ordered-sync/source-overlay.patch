-___SCMOBJ ___hash_scheme_string
-   ___P((___SCMOBJ str),
-        (str)
-___SCMOBJ str;)
-{
-  ___SIZE_T i, n = ___INT(___STRINGLENGTH(str));
-  ___UM32 h = FN1a_offset_basis;
-
-  for (i=0; i<n; i++)
-    h = HASH_STEP(h,___ORD(___STRINGREF(str,___FIX(i))));
-
-  return ___FIX(h);
-}
