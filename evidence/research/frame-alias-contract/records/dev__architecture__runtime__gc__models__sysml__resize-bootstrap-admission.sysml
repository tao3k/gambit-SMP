part def DiagramNode { attribute nodeId:String; attribute labelText:String; }
part def DiagramEdge { ref part producer:DiagramNode; ref part consumer:DiagramNode; attribute labelText:String; }
part node0:DiagramNode { attribute :>> nodeId="rootView"; attribute :>> labelText="Generated frame and full caller view"; }
part node1:DiagramNode { attribute :>> nodeId="freeze"; attribute :>> labelText="Freeze caller and stop raw borrows"; }
part node2:DiagramNode { attribute :>> nodeId="gate"; attribute :>> labelText="Register versus GC close"; }
part node3:DiagramNode { attribute :>> nodeId="pending"; attribute :>> labelText="Frozen caller retains late descriptor"; }
part node4:DiagramNode { attribute :>> nodeId="reload"; attribute :>> labelText="GC update and source reload"; }
part node5:DiagramNode { attribute :>> nodeId="root"; attribute :>> labelText="VM bootstrap root and child ledger"; }
part node6:DiagramNode { attribute :>> nodeId="routing"; attribute :>> labelText="Prepared routing; old GC membership"; }
part node7:DiagramNode { attribute :>> nodeId="create"; attribute :>> labelText="Per-child OS creation and binding"; }
part node8:DiagramNode { attribute :>> nodeId="commit"; attribute :>> labelText="All-ready generation commit"; }
part node9:DiagramNode { attribute :>> nodeId="run"; attribute :>> labelText="Post-sync reload to activation"; }
part node10:DiagramNode { attribute :>> nodeId="abort"; attribute :>> labelText="Partial failure; close and retain"; }
part node11:DiagramNode { attribute :>> nodeId="drain"; attribute :>> labelText="Exact no-child or stop; reader drain"; }
part node12:DiagramNode { attribute :>> nodeId="retire"; attribute :>> labelText="Cleanup exact child then retire root"; }
part edge0:DiagramEdge { ref part :>> producer=node0; ref part :>> consumer=node1; attribute :>> labelText="reuse precise stack slots"; }
part edge1:DiagramEdge { ref part :>> producer=node1; ref part :>> consumer=node2; attribute :>> labelText="single admission cut"; }
part edge2:DiagramEdge { ref part :>> producer=node2; ref part :>> consumer=node3; attribute :>> labelText="close wins"; }
part edge3:DiagramEdge { ref part :>> producer=node3; ref part :>> consumer=node4; attribute :>> labelText="no raw borrow while waiting"; }
part edge4:DiagramEdge { ref part :>> producer=node4; ref part :>> consumer=node2; attribute :>> labelText="same identity retry"; }
part edge5:DiagramEdge { ref part :>> producer=node2; ref part :>> consumer=node5; attribute :>> labelText="register wins"; }
part edge6:DiagramEdge { ref part :>> producer=node5; ref part :>> consumer=node6; attribute :>> labelText="root before routing"; }
part edge7:DiagramEdge { ref part :>> producer=node6; ref part :>> consumer=node7; attribute :>> labelText="one attempt per child"; }
part edge8:DiagramEdge { ref part :>> producer=node7; ref part :>> consumer=node8; attribute :>> labelText="all requested ready"; }
part edge9:DiagramEdge { ref part :>> producer=node8; ref part :>> consumer=node9; attribute :>> labelText="shared membership generation"; }
part edge10:DiagramEdge { ref part :>> producer=node7; ref part :>> consumer=node10; attribute :>> labelText="known failure or unknown"; }
part edge11:DiagramEdge { ref part :>> producer=node10; ref part :>> consumer=node11; attribute :>> labelText="no bulk rollback"; }
part edge12:DiagramEdge { ref part :>> producer=node11; ref part :>> consumer=node12; attribute :>> labelText="only proven stopped children"; }
part edge13:DiagramEdge { ref part :>> producer=node10; ref part :>> consumer=node5; attribute :>> labelText="unknown stays VM owned"; }
