part def AdmissionCut { attribute completeView:Boolean; attribute frozen:Boolean; attribute sourceHeld:Boolean; attribute registered:Boolean; attribute gcClosed:Boolean; attribute includedInSnapshot:Boolean; attribute allRequestedReady:Boolean; attribute outcomeUnknown:Boolean; attribute memberCommitted:Boolean; attribute stopOrNoChild:Boolean; attribute readersDrained:Boolean; attribute canAdmitRoot:Boolean=not registered and not gcClosed and completeView and frozen and sourceHeld; attribute rootCovered:Boolean=(registered and (not gcClosed or includedInSnapshot)) or (sourceHeld and completeView and frozen); attribute canCommit:Boolean=registered and not gcClosed and allRequestedReady and not outcomeUnknown; attribute canReclaim:Boolean=not memberCommitted and not outcomeUnknown and stopOrNoChild and readersDrained; }
part openFrozen:AdmissionCut { attribute :>> completeView=true; attribute :>> frozen=true; attribute :>> sourceHeld=true; attribute :>> registered=false; attribute :>> gcClosed=false; attribute :>> includedInSnapshot=false; attribute :>> allRequestedReady=false; attribute :>> outcomeUnknown=false; attribute :>> memberCommitted=false; attribute :>> stopOrNoChild=false; attribute :>> readersDrained=false; }
part uncoveredLate:AdmissionCut { attribute :>> completeView=true; attribute :>> frozen=false; attribute :>> sourceHeld=false; attribute :>> registered=true; attribute :>> gcClosed=true; attribute :>> includedInSnapshot=false; attribute :>> allRequestedReady=false; attribute :>> outcomeUnknown=false; attribute :>> memberCommitted=false; attribute :>> stopOrNoChild=false; attribute :>> readersDrained=false; }
part lateFrozen:AdmissionCut { attribute :>> completeView=true; attribute :>> frozen=true; attribute :>> sourceHeld=true; attribute :>> registered=false; attribute :>> gcClosed=true; attribute :>> includedInSnapshot=false; attribute :>> allRequestedReady=false; attribute :>> outcomeUnknown=false; attribute :>> memberCommitted=false; attribute :>> stopOrNoChild=false; attribute :>> readersDrained=false; }
part registeredSnapshot:AdmissionCut { attribute :>> completeView=true; attribute :>> frozen=true; attribute :>> sourceHeld=false; attribute :>> registered=true; attribute :>> gcClosed=true; attribute :>> includedInSnapshot=true; attribute :>> allRequestedReady=false; attribute :>> outcomeUnknown=false; attribute :>> memberCommitted=false; attribute :>> stopOrNoChild=false; attribute :>> readersDrained=false; }
part unknownReady:AdmissionCut { attribute :>> completeView=true; attribute :>> frozen=true; attribute :>> sourceHeld=false; attribute :>> registered=true; attribute :>> gcClosed=false; attribute :>> includedInSnapshot=false; attribute :>> allRequestedReady=true; attribute :>> outcomeUnknown=true; attribute :>> memberCommitted=false; attribute :>> stopOrNoChild=false; attribute :>> readersDrained=true; }
part allReady:AdmissionCut { attribute :>> completeView=true; attribute :>> frozen=true; attribute :>> sourceHeld=false; attribute :>> registered=true; attribute :>> gcClosed=false; attribute :>> includedInSnapshot=false; attribute :>> allRequestedReady=true; attribute :>> outcomeUnknown=false; attribute :>> memberCommitted=false; attribute :>> stopOrNoChild=false; attribute :>> readersDrained=true; }
part knownStopped:AdmissionCut { attribute :>> completeView=true; attribute :>> frozen=true; attribute :>> sourceHeld=false; attribute :>> registered=true; attribute :>> gcClosed=false; attribute :>> includedInSnapshot=false; attribute :>> allRequestedReady=false; attribute :>> outcomeUnknown=false; attribute :>> memberCommitted=false; attribute :>> stopOrNoChild=true; attribute :>> readersDrained=true; }
requirement def RootCoverageLaw { subject cut:AdmissionCut; require constraint { not cut.registered or cut.rootCovered } }
part def CapacityArithmetic { attribute processors:Integer; attribute minSectionsPerProcessor:Integer=2; attribute sectionWords:Integer=131072; attribute wordBytes:Integer=8; attribute minWords:Integer=processors*minSectionsPerProcessor*sectionWords; attribute payloadBytes:Integer=minWords*wordBytes; }
part capacityOne:CapacityArithmetic { attribute :>> processors=1; }
part capacityTwo:CapacityArithmetic { attribute :>> processors=2; }
part def CarrierArithmetic { attribute carriers:Integer; attribute wordBytes:Integer=8; attribute separateBytes:Integer=carriers*wordBytes; attribute sharedBytes:Integer=wordBytes; attribute slotSavingBytes:Integer=separateBytes-sharedBytes; }
part flat:CarrierArithmetic { attribute :>> carriers=1; }
part shared:CarrierArithmetic { attribute :>> carriers=8; }
}
