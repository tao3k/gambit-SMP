part memberRole0:MembershipRole { ref part :>> need=membership; attribute :>> roleId="REQUESTED-CAPACITY"; attribute :>> sourceAnchors="setup.c:892-913;mem.c:508-509,6330-6335"; attribute :>> currentResponsibility="mem.target_processor_count_ already drives GC minimum msection reservation"; attribute :>> targetContract="Keep requested capacity distinct from committed collectors; failed resize releases demand only when dependent children/loans settle"; attribute :>> boundary="Reuse existing capacity concept, add transaction/generation custody"; }
part memberRole1:MembershipRole { ref part :>> need=membership; attribute :>> roleId="PREPARED-PSTATE"; attribute :>> sourceAnchors="setup.c:941-955,4675-4755;mem.c:4601-4700"; attribute :>> currentResponsibility="PSTATE initialization and private stack/heap setup before create"; attribute :>> targetContract="Safe root/resource maps and exact setup phase before a native start can use it"; attribute :>> boundary="Prepared is not collector membership"; }
part memberRole2:MembershipRole { ref part :>> need=membership; attribute :>> roleId="BARRIER-ROUTING"; attribute :>> sourceAnchors="setup.c:550-712,962-964"; attribute :>> currentResponsibility="processor_count determines tree edges and is changed during OP_SET_PROCESSOR_COUNT"; attribute :>> targetContract="Keep old committed rendezvous intact while staging bootstrap routes; collective generation switch once requested children ready"; attribute :>> boundary="Requires barrier topology redesign; a field rename is insufficient"; }
part memberRole3:MembershipRole { ref part :>> need=membership; attribute :>> roleId="BOUND-CHILD"; attribute :>> sourceAnchors="setup.c:805-835;os_thread.c:426-439,493-512"; attribute :>> currentResponsibility="OS child sets PSTATE TLS then enters resize synchronization"; attribute :>> targetContract="Bootstrap wait is outside committed collector set; source/root epoch reloaded before Scheme entry"; attribute :>> boundary="Binding, result publication and resume readiness are independent"; }
part memberRole4:MembershipRole { ref part :>> need=membership; attribute :>> roleId="COLLECTOR-MEMBERS"; attribute :>> sourceAnchors="mem.c:6590-6632,6790-6868"; attribute :>> currentResponsibility="processor_count partitions globals and worker root/scan participation"; attribute :>> targetContract="One immutable per-round member generation with full root/worker authorization; bootstrap registry scanned independently"; attribute :>> boundary="Existing PSTATE/member-index coupling must be migrated explicitly"; }
part def SourceRoute { ref part need:GambitAssuranceRouting::ModelNeed; attribute sourceAnchors:String; attribute projection:String; attribute failureCustodian:String; attribute status:String; }
part route0:SourceRoute { ref part :>> need=rootView; attribute :>> sourceAnchors="_ptree2.scm:2850-2869;_t-c-2.scm:157-224;_kernel.c:26338-26368,30819-30821"; attribute :>> projection="Freeze complete location/context view; acquire origin before first sync/GC; reload source location after relocation"; attribute :>> failureCustodian="Caller view until VM descriptor accepted; then VM overlap until child activation acceptance"; attribute :>> status="source-and-C-order-refinement-open"; }
part route1:SourceRoute { ref part :>> need=gate; attribute :>> sourceAnchors="setup.c:1132-1178;mem.c:6790-6868"; attribute :>> projection="Accept-before-close enters pinned snapshot; close-before-accept leaves only safe metadata pending and frozen caller authoritative"; attribute :>> failureCustodian="Frozen caller map/VM-held view pin, not unregistered native slot"; attribute :>> status="source-and-C-order-refinement-open"; }
part route2:SourceRoute { ref part :>> need=membership; attribute :>> sourceAnchors="setup.c:655-656,941-1003;mem.c:6590-6632"; attribute :>> projection="Prepare -> root/routing descriptor -> OS outcome+binding -> collective generation commit"; attribute :>> failureCustodian="Resize transaction/VM until exact all-child ready commit or explicit abort/drain"; attribute :>> status="source-and-C-order-refinement-open"; }
part route3:SourceRoute { ref part :>> need=rollback; attribute :>> sourceAnchors="setup.c:941-1003;os_thread.c:493-539"; attribute :>> projection="Per-child ledger Prepared/Creating/Success/Failure/Unknown/Stopped/Retired; cancel admission then drain known starts"; attribute :>> failureCustodian="VM holds each successful or unknown child resource until exact stop/no-child and scanner drain"; attribute :>> status="source-and-C-order-refinement-open"; }
