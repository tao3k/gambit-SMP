part def DiagramNode {  attribute nodeId:String; attribute labelText:String; }
part node0:DiagramNode { attribute :>> nodeId="port"; attribute :>> labelText="Preinstalled safe empty root port"; }
part node1:DiagramNode { attribute :>> nodeId="source"; attribute :>> labelText="Complete registered source frozen"; }
part node2:DiagramNode { attribute :>> nodeId="intent"; attribute :>> labelText="Immutable intent and source custody"; }
part node3:DiagramNode { attribute :>> nodeId="claim"; attribute :>> labelText="Ownership CAS may execute late"; }
part node4:DiagramNode { attribute :>> nodeId="private"; attribute :>> labelText="Private control fields and progress logs"; }
part node5:DiagramNode { attribute :>> nodeId="locator"; attribute :>> labelText="Exact locator; safe false payload"; }
part node6:DiagramNode { attribute :>> nodeId="root"; attribute :>> labelText="GC-aware current root admission"; }
part node7:DiagramNode { attribute :>> nodeId="commit"; attribute :>> labelText="Final release commit before native effect"; }
part node8:DiagramNode { attribute :>> nodeId="exit"; attribute :>> labelText="Owner exit observed: still unknown"; }
part node9:DiagramNode { attribute :>> nodeId="stop"; attribute :>> labelText="Data and control writers verifiably closed"; }
part node10:DiagramNode { attribute :>> nodeId="help"; attribute :>> labelText="Exclusive helper repairs private control only"; }
part node11:DiagramNode { attribute :>> nodeId="gc"; attribute :>> labelText="GC scans old view or canonical moved root"; }
part node12:DiagramNode { attribute :>> nodeId="ack"; attribute :>> labelText="Separate source/result/reader settlement"; }
part node13:DiagramNode { attribute :>> nodeId="free"; attribute :>> labelText="Recycle only exact owned support"; }
part def DiagramEdge { ref part producer:DiagramNode; ref part consumer:DiagramNode; attribute labelText:String; }
part edge0:DiagramEdge { ref part :>> producer=node0; ref part :>> consumer=node1; attribute :>> labelText="no marker before root coverage"; }
part edge1:DiagramEdge { ref part :>> producer=node1; ref part :>> consumer=node2; attribute :>> labelText="bounded first origin admission"; }
part edge2:DiagramEdge { ref part :>> producer=node2; ref part :>> consumer=node3; attribute :>> labelText="journal precedes possible CAS"; }
part edge3:DiagramEdge { ref part :>> producer=node3; ref part :>> consumer=node4; attribute :>> labelText="exact header lease owns init"; }
part edge4:DiagramEdge { ref part :>> producer=node4; ref part :>> consumer=node5; attribute :>> labelText="store and progress are separate"; }
part edge5:DiagramEdge { ref part :>> producer=node5; ref part :>> consumer=node6; attribute :>> labelText="current source reload after close"; }
part edge6:DiagramEdge { ref part :>> producer=node6; ref part :>> consumer=node7; attribute :>> labelText="metadata and root receipt required"; }
part edge7:DiagramEdge { ref part :>> producer=node3; ref part :>> consumer=node8; attribute :>> labelText="missing return or interrupted owner"; }
part edge8:DiagramEdge { ref part :>> producer=node4; ref part :>> consumer=node8; attribute :>> labelText="partial store outcome unknown"; }
part edge9:DiagramEdge { ref part :>> producer=node8; ref part :>> consumer=node9; attribute :>> labelText="observation is not stop proof"; }
part edge10:DiagramEdge { ref part :>> producer=node9; ref part :>> consumer=node10; attribute :>> labelText="no old control or data writes"; }
part edge11:DiagramEdge { ref part :>> producer=node10; ref part :>> consumer=node5; attribute :>> labelText="idempotent metadata; no payload replay"; }
part edge12:DiagramEdge { ref part :>> producer=node1; ref part :>> consumer=node11; attribute :>> labelText="old source remains scanned"; }
part edge13:DiagramEdge { ref part :>> producer=node6; ref part :>> consumer=node11; attribute :>> labelText="collector updates accepted root"; }
part edge14:DiagramEdge { ref part :>> producer=node7; ref part :>> consumer=node12; attribute :>> labelText="commit is not final ACK"; }
part edge15:DiagramEdge { ref part :>> producer=node11; ref part :>> consumer=node12; attribute :>> labelText="physical scan view must drain"; }
part edge16:DiagramEdge { ref part :>> producer=node12; ref part :>> consumer=node13; attribute :>> labelText="checked lease and reader closure"; }
