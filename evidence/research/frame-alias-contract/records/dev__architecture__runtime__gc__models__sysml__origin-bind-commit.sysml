part def CommitCut { attribute portInstalled:Boolean; attribute registered:Boolean; attribute frozen:Boolean; attribute dataClosed:Boolean; attribute controlClosed:Boolean; attribute dataInFlight:Boolean; attribute controlInFlight:Boolean; attribute exactOwner:Boolean; attribute fieldsReady:Boolean; attribute locator:Boolean; attribute rootAccepted:Boolean; attribute rootCurrent:Boolean; attribute sourceReaders:Integer; attribute terminal:Boolean; attribute resultAck:Boolean; attribute queryReaders:Integer; attribute committed:Boolean default = false; attribute sourceAckRecorded:Boolean default = false; attribute sourceHeld:Boolean default = true; attribute canAdmit:Boolean=portInstalled and registered and frozen; attribute canHelp:Boolean=dataClosed and controlClosed and not dataInFlight and not controlInFlight; attribute canCommit:Boolean=exactOwner and fieldsReady and locator and rootAccepted and rootCurrent and not dataInFlight and not controlInFlight; attribute canReleaseSource:Boolean=sourceAckRecorded and sourceReaders==0 and ((committed and rootAccepted and rootCurrent) or terminal); attribute canRecycle:Boolean=terminal and resultAck and sourceAckRecorded and not sourceHeld and not rootAccepted and queryReaders==0 and sourceReaders==0 and canHelp; }
