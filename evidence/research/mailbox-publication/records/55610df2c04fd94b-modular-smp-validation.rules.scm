;; One native producer identity. Existing QNT/Lean ownership is unchanged.
(relation msIdentity (source profile))
(relation msLane (id kind contract))
(relation msMethod (kind method) (("make" "native-build-graph") ("kernel" "native-kernel") ("scheme" "native-scheme")))
(relation msObservation (id method source profile contract outcome))
(relation msPass (outcome) (("pass")))
(relation msRejected (id))
((msRejected C) <-- (msLane C K H) (msIdentity S P) (msMethod K M)
 (msObservation C M S P H O) (not (msPass O)))
(relation msSupplied (id))
((msSupplied C) <-- (msLane C K H) (msIdentity S P) (msMethod K M)
 (msObservation C M S P H "pass") (not (msRejected C)))
(relation msMissing (id))
((msMissing C) <-- (msLane C _ _) (not (msSupplied C)))
(relation msBootstrapObservation (source profile phases outcome))
(relation msBootstrapRejected (source))
((msBootstrapRejected S) <-- (msIdentity S P)
 (msBootstrapObservation S P "phase1=2,phase2=2,phase3=2,phase4=2" O) (not (msPass O)))
(relation msBootstrap (source))
((msBootstrap S) <-- (msIdentity S P)
 (msBootstrapObservation S P "phase1=2,phase2=2,phase3=2,phase4=2" "pass") (not (msBootstrapRejected S)))
(relation msGate (id) (("tests") ("architecture") ("process") ("models") ("questions")))
(relation msGateEvidence (id source outcome))
(relation msGateRejected (id))
((msGateRejected G) <-- (msGate G) (msIdentity S _) (msGateEvidence G S O) (not (msPass O)))
(relation msGateSupplied (id))
((msGateSupplied G) <-- (msGate G) (msIdentity S _) (msGateEvidence G S "pass") (not (msGateRejected G)))
(relation msGateMissing (id))
((msGateMissing G) <-- (msGate G) (not (msGateSupplied G)))
(relation msCandidate (id))
;; Supplied only by the canonical complete RootWorkerExit/source refinement,
;; not by these module observations or by a copied QNT/Lean result.
(relation msArchitectureReady (id source profile))
(relation msCommitReady (id))
((msCommitReady C) <-- (msCandidate C) (msIdentity S P) (msBootstrap S)
 (msArchitectureReady C S P)
 (not (msMissing _)) (not (msGateMissing _)))
