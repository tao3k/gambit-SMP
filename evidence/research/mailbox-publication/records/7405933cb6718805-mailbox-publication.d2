direction: down
vars: { d2-config: { layout-engine: elk } }
authority: "Native SysML: responsibilities / transfer / obligation"
identity: "identity\n##thread-mailbox-get!"
authority -> identity
cell: "cell\n##thread-send"
authority -> cell
queue: "queue\nmacro-fifo-link-tail-cell!"
authority -> queue
roots: "roots\nmark_execution_roots"
authority -> roots
scan: "scan\nscan"
authority -> scan
timeout: "timeout\n##thread-mailbox-next-or-receive"
authority -> timeout
cell -> queue: "Cell initialized and rooted before permit; two nonallocating\nstores publish it; no mailbox read/mutation outside permit"
queue -> roots: "GC physically stops writers; graph complete at poll/check;\nroots include blocked sender and target. No mailbox lock\nacquisition by collector"
roots -> scan: "RootTask claims root repair, object scan claims payload;\nsharing does not grant a second mutator or duplicate scan\nauthority"
source: "Actual SMP receive AST\nold: observes33 / GC0\ncandidate: excludes writer / gets32 /64 messages"
native: "Built-in mailbox / blocked-cell GC / first publishers\nexact source and native process receipts"
ascent: "ASCENT: method, identity, conflicts and missing evidence"
formal: "Existing continuation QNT / root-view Lean
no mailbox queue theorem or duplicated models"
open: "Historical schedule unknown / portable lock proof open\nwhole SMP and five commit gates remain open"
authority -> ascent
source -> ascent
native -> ascent
formal -> ascent
ascent -> open
