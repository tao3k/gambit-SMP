;;; Bounded native Scheme evidence campaign; compile once, retain every trial.
(##namespace ("gambit#tests#smp#scheduler#publication-evidence#"
              root runtime out compiler records capture stamp write-record mode
              populations trial-count original boundaries executable transcript hash-file))
(define root (path-expand (getenv "GAMBIT_SMP_ROOT")))
(define runtime (path-expand (getenv "GAMBIT_SMP_RUNTIME")))
(define out (path-expand (getenv "GAMBIT_SMP_OUT")))
(define compiler (getenv "GAMBIT_SMP_CC"))
(define records '())
(define (stamp) (time->seconds (current-time)))
(define (write-record path value)
  (call-with-output-file path (lambda (p) (write value p) (newline p))))
(define (capture name executable args population)
  (let* ((start (stamp))
         (options (string-append "p" (number->string population)
                                ",~~lib=" runtime "/lib,~~bin=" runtime "/bin,~~include=" runtime "/include")))
    (setenv "GAMBOPT" options)
    (let* ((port (open-process (list path: "/opt/homebrew/bin/gtimeout"
                                    arguments: (append '("--kill-after=2s" "30s") (list executable) args)
                                    directory: out stderr-redirection: #t)))
           (reader (make-thread
                    (lambda ()
                      (call-with-output-file (string-append out "/" name ".output")
                        (lambda (p)
                          (let loop ((b (read-u8 port)))
                            (if (not (eof-object? b))
                                (begin (write-u8 b p) (loop (read-u8 port)))))))))))
      (close-output-port port)
      (thread-start! reader)
      (let* ((status (process-status port 33 'unknown))
             (joined (thread-join! reader 2 'unknown))
             (row (list (cons 'name name) (cons 'gc-mode (getenv "GAMBIT_MAILBOX_GC" "both"))
                        (cons 'processors population) (cons 'argv (cons executable args))
                        (cons 'raw-wait-status status) (cons 'reader-completed (not (eq? joined 'unknown)))
                        (cons 'seconds (- (stamp) start)))))
        (close-input-port port)
        (set! records (cons row records))
        (write-record (string-append out "/observations.scm") (reverse records))
        (if (or (not (number? status)) (eq? joined 'unknown))
            (error "unknown native result retains campaign failure" name))
        status))))
(create-directory out)
(for-each (lambda (k) (setenv k)) '("SDKROOT" "LIBRARY_PATH" "CPATH"))
(setenv "PATH" (string-append (path-directory compiler) ":/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin"))
(setenv "CC" compiler)
(define (hash-file path)
  (let* ((p (open-process (list path: "/usr/bin/shasum" arguments: (list "-a" "256" path)
                              stderr-redirection: #t)))
         (reader (make-thread (lambda () (read-line p #f)))))
    (close-output-port p) (thread-start! reader)
    (let ((status (process-status p 10 'unknown))
          (line (thread-join! reader 2 'unknown)))
      (close-input-port p)
      (if (not (and (number? status) (= status 0) (string? line) (>= (string-length line) 64)))
          (error "runtime identity could not be observed" path))
      (cons path (substring line 0 64)))))
(define original (getenv "GAMBIT_MAILBOX_ORIGINAL"))
(define boundaries (string-append out "/boundaries"))
(write-record (string-append out "/inputs.scm")
              (list (cons 'runtime runtime) (cons 'root root) (cons 'compiler compiler)
                    (cons 'original original) (cons 'seed "unchanged 64-message both-GC predicate")
                    (cons 'runtime-identities
                          (map hash-file (list compiler (string-append runtime "/gsc/gsc")
                                               (string-append runtime "/gsi/gsi")
                                               (string-append runtime "/lib/libgambit.a")
                                               (string-append runtime "/lib/_thread.c")
                                               (string-append runtime "/lib/_thread.scm")
                                               (string-append runtime "/lib/_fifo#.scm"))))
                    (cons 'heap-override #f) (cons 'execution-cap 30) (cons 'receive-wait 5)))
(if (not (= (capture "compile-boundaries" (string-append runtime "/gsc/gsc")
                    (list "-exe" "-o" boundaries "-cc-options" "-pthread" "-ld-options" "-pthread"
                          (string-append root "/tests/smp/scheduler/mailbox-boundaries.scm")) 11) 0))
    (error "boundary fixture compilation failed"))
(for-each
 (lambda (group)
   (let ((name (car group)) (executable (cadr group)) (mode (caddr group)) (population (cadddr group)))
     (setenv "GAMBIT_MAILBOX_GC" mode)
     (let loop ((i 0))
       (if (< i 12)
           (begin (capture (string-append name "-" (number->string i)) executable '() population)
                  (loop (+ i 1)))))))
 (list (list "original" original "both" 11)
       (list "serial" boundaries "both" 1)
       (list "no-gc" boundaries "none" 11)
       (list "sender-gc" boundaries "sender" 11)
       (list "receiver-gc" boundaries "receiver" 11)
       (list "both-gc" boundaries "both" 11)))
(let complete ((rows records))
  (if (pair? rows)
      (let ((row (car rows)))
        (if (not (= (cdr (assq 'raw-wait-status row)) 0))
            (error "retained native failure in campaign" (cdr (assq 'name row))))
        (complete (cdr rows)))))
(display "MAILBOX-PUBLICATION-EVIDENCE-COMPLETE\n")
