  "contract": [
    {
      "fromNode": "CallerA",
      "toNode": "OwnerTransaction",
      "custody": "reserve A after exact revision and generation validation"
    },
    {
      "fromNode": "CallerB",
      "toNode": "OwnerTransaction",
      "custody": "reserve B checks pending live and draining intervals"
    },
    {
      "fromNode": "OwnerTransaction",
      "toNode": "Reserved",
      "custody": "commit interval plus exact lease custody"
    },
    {
      "fromNode": "Reserved",
      "toNode": "RootPreparation",
      "custody": "keep source rooted through allocation"
    },
    {
      "fromNode": "RootPreparation",
      "toNode": "LiveBundle",
      "custody": "publish complete bundle and operation result atomically"
    },
    {
      "fromNode": "LiveBundle",
      "toNode": "LostReply",
      "custody": "response may be absent; commit remains"
    },
    {
      "fromNode": "LostReply",
      "toNode": "ExactQuery",
      "custody": "same immutable request and OperationId"
    },
    {
      "fromNode": "ExactQuery",
      "toNode": "Closing",
      "custody": "observed result permits coordinated revoke"
    },
    {
      "fromNode": "LiveBundle",
      "toNode": "Closing",
      "custody": "close new lookups; retain accepted readers"
    },
    {
      "fromNode": "Closing",
      "toNode": "Drain",
      "custody": "reader scan and lookup grace"
    },
    {
      "fromNode": "Drain",
      "toNode": "LeaseSettlement",
      "custody": "known result plus exact generation and LeaseId"
    },
    {
      "fromNode": "LeaseSettlement",
      "toNode": "Unlinked",
      "custody": "atomic lease return and occupancy removal"
    },
    {
      "fromNode": "Unlinked",
      "toNode": "Reuse",
      "custody": "all storage users native pins and GC grace settled"
    },
    {
      "fromNode": "Reuse",
      "toNode": "StaleRejection",
      "custody": "advance without wrap; keep old result tombstones"
    },
    {
      "fromNode": "LiveBundle",
      "toNode": "GCScanner",
      "custody": "pinned descriptor; exclusive update slot ownership"
    }
  ],
  "gain": [
    {
      "key": "overlap-authority",
      "avoided": "duplicate physical slot identities and duplicate scan writes",
      "added": "one owner transaction per reserve and unlink; O(n) reference overlap search",
      "condition": "all allocation and view authorities participate; current native retirements zero"
    },
    {
      "key": "lost-reply",
      "avoided": "duplicate allocation registration and premature source release on retry",
      "added": "one stable operation record per request; exact query; replay tombstone storage",
      "condition": "same request identity; no process-crash recovery promised"
    },
    {
      "key": "source-writer",
      "avoided": "holding source after a proved independent copy is covered",
      "added": "alias path blocks writes for full lifetime; copy adds roots and storage",
      "condition": "copy branch inherited only from parent; not proved in new product"
    },
    {
      "key": "parallelism",
      "avoided": "serial preparation of disjoint rooted candidates",
      "added": "serialized metadata mutation and contention; no fairness guarantee",
      "condition": "only preparation outside lock; physical non-overlap and isolated root slots proved"
    },
    {
      "key": "cleanup",
      "avoided": "processor-local cleanup guessing whether shared header is live",
      "added": "VM owner drain and retained unknown-result work",
      "condition": "cleanup_rc bypass must retire only after all exported callers migrate"
    },
    {
      "key": "language-choice",
      "avoided": "duplicating registry ownership across C and Zig",
      "added": "Zig would still need allocator index GC bridge transaction ledger and FFI admission",
      "condition": "no demonstrated incremental Zig benefit over shared modern C contract"
    }
  ],
  "memory": [
    {
      "key": "mutex",
      "publication": "initialize candidate outside owner lock under scan-visible source root",
      "observation": "lock owner then revalidate revision generation extent and request identity",
      "obligation": "no Scheme callback allocator or GC safepoint while holding index lock; unlock synchronizes later successful lock",
      "overhead": "short serialized reserve commit unlink operations"
    },
    {
      "key": "publication",
      "publication": "single owner transaction publishes immutable descriptor plus root-cell registration and result",
      "observation": "scanner and lookup use same lock or proved acquire-load pinned snapshot",
      "obligation": "release/acquire only publishes initialization; does not pin storage or synchronize moving GC cell writes",
      "overhead": "bundle root plus descriptor pin and GC round participation"
    },
    {
      "key": "CAS-alternative",
      "publication": "CAS whole pinned snapshot with exact expected revision",
      "observation": "failed CAS updates expected; inspect only after acquire and lifetime protection",
      "obligation": "cannot CAS separate list root and receipt independently; retry overlap check; no weak CAS failure interpreted as rejection",
      "overhead": "snapshot allocation retries reclamation and possible contention"
    },
    {
      "key": "settlement",
      "publication": "same owner transaction validates exact lease then removes occupancy and records completed result",
      "observation": "old or duplicate token returns already-settled or stale without decrement",
      "obligation": "never decrement then independently record; cancellation no nonlocal exit inside commit; stable owner retains unknown outcome",
      "overhead": "one exact ledger mutation no blind counter decrement"
    },
    {
      "key": "generation",
      "publication": "close drain unpublish grace then advance checked generation",
      "observation": "all old keys and operation receipts compare complete identity",
      "obligation": "generation is not index revision or semantic payload version; exhaust refuses new issuance",
      "overhead": "checked counters tombstones delayed reuse"
    },
    {
      "key": "GC",
      "publication": "candidate source pin precedes first movable allocation; descriptor registered before visible publication",
      "observation": "one canonical physical slot per round; GC updates through registered cell",
      "obligation": "alias metadata immutability does not make root cell immutable; no duplicate scanner writes",
      "overhead": "root enumeration pin scan ownership; integration unresolved"
    }
  ],
  "proof": [
    {
      "key": "checkedInsert",
      "lemma": "StorageIndexAlgebra.checkedInsert"
    },
    {
      "key": "overlapRejects",
      "lemma": "StorageIndexAlgebra.overlapRejects"
    },
    {
      "key": "intervalAdjacency",
      "lemma": "StorageIndexAlgebra.intervalAdjacency"
    },
    {
      "key": "differentGenerationDifferentLease",
      "lemma": "StorageIndexAlgebra.differentGenerationDifferentLease"
    },
    {
      "key": "differentOperationDifferentLease",
      "lemma": "StorageIndexAlgebra.differentOperationDifferentLease"
    },
    {
      "key": "settlementCannotConsumeNew",
      "lemma": "StorageIndexAlgebra.settlementCannotConsumeNew"
    }
  ]
