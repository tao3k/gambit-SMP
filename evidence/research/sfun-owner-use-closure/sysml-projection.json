      "condition": "No Zig-specific net return is established by this study"
    },
    {
      "key": "watermark-support",
      "avoided": "Observation-only stale invocation handling can avoid adding one retained outcome record for every retry",
      "added": "Per-owner current epoch/completed watermark and closure tombstone plus query-record pins",
      "condition": "Bounded identity metadata O(E) for E owners, versus O(Q) retained per-call outcomes for Q calls, only if queries need no historical payload; this avoids new support cost and does not retire an existing ledger"
    }
