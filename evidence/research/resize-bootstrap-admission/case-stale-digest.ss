(define-evidence (query) (sources clue factor binding)
 (outputs question modelRequired qualifiedSlice locallyChecked assuranceReady componentFrontier componentReady unmetDependency dependencyCycle sourceRoute researchGateReady researchGateMissing)
 (include clue-selection-schema)
;; Modern C resize admission; SysML owns need, view, transition and gate requirements.
;; Exact artifact, digest, method, check and scope all join conjunctively.
(relation studyFact (claim))
(relation needFact (component obligation kind premise artifact scope))
(relation dependencyFact (dependent prerequisite))
(relation methodFact (kind method requiredCheck))
(relation scenarioFact (scenario))
(relation artifactFact (artifact digest))
(relation receiptFact (scenario obligation method artifact digest check scope status))
(relation routeFact (obligation anchors custodian status))
(relation boundStudy (claim))
(relation modelRequired (scenario component obligation method check artifact scope premise))
(relation qualifiedSlice (scenario component obligation method artifact check scope))
(relation locallyChecked (scenario component obligation))
(relation dependsOn (dependent prerequisite))
(relation missingExpected (scenario obligation))
(relation unmetDependency (scenario dependent prerequisite))
(relation dependencyCycle (obligation))
(relation assuranceReady (scenario component obligation))
(relation componentFrontier (scenario component obligation))
(relation componentReady (scenario component))
(relation sourceRoute (obligation anchors custodian status))
((boundStudy C) <-- (studyFact C) (clue I D C _ _ _)
 (factor I D (lit "target-model-bundle-sha256") B) (binding (lit "target-model-bundle-sha256") B)
 (factor I D (lit "native-output-sha256") N) (binding (lit "native-output-sha256") N)
 (factor I D (lit "planner-dsl-sha256") P) (binding (lit "planner-dsl-sha256") P))
((modelRequired S C O M K A T P) <-- (boundStudy _) (scenarioFact S)
 (needFact C O Kind P A T) (methodFact Kind M K))
((qualifiedSlice S C O M A K T) <-- (modelRequired S C O M K A T _)
 (artifactFact A H) (receiptFact S O M A H K T (lit "pass")))
((missingExpected S O) <-- (modelRequired S _ O M K A T _) (not (qualifiedSlice S _ O M A K T)))
((locallyChecked S C O) <-- (modelRequired S C O _ _ _ _ _) (not (missingExpected S O)))
((dependsOn O P) <-- (dependencyFact O P))
((dependsOn O P) <-- (dependsOn O Q) (dependencyFact Q P))
((dependencyCycle O) <-- (dependsOn O O))
((unmetDependency S O P) <-- (modelRequired S _ O _ _ _ _ _) (dependsOn O P) (missingExpected S P))
((assuranceReady S C O) <-- (locallyChecked S C O) (not (unmetDependency S O _)) (not (dependencyCycle O)))
((componentFrontier S C O) <-- (modelRequired S C O _ _ _ _ _) (not (assuranceReady S C O)))
((componentReady S C) <-- (modelRequired S C _ _ _ _ _ _) (not (componentFrontier S C _)))
((sourceRoute O A F T) <-- (boundStudy _) (routeFact O A F T))

(relation question (claim))
((question C) <-- (boundStudy C))

(relation gateNeedFact (gate obligation))
(relation researchGateMissing (scenario gate obligation))
(relation researchGateReady (scenario gate))
((researchGateMissing S G O) <-- (scenarioFact S) (gateNeedFact G O) (modelRequired S C O _ _ _ _ _) (not (assuranceReady S C O)))
((researchGateReady S G) <-- (boundStudy _) (scenarioFact S) (gateNeedFact G _) (not (researchGateMissing S G _)))
