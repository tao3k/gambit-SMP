  "paper": [
    {
      "key": "gambit-pvm",
      "title": "Feeley and Miller: A parallel virtual machine for efficient Scheme compilation",
      "url": "https://www.iro.umontreal.ca/~feeley/papers/FeeleyMillerLFP90.pdf",
      "section": "2",
      "basis": "Front/back-end contract carries machine-specific facts",
      "boundary": "Historical PVM is not a current C23 ABI proof"
    },
    {
      "key": "gambit-c-segments",
      "title": "Feeley: Portable first-class continuations with C",
      "url": "https://www.schemeworkshop.org/2000/feeley.ps",
      "section": "1-5",
      "basis": "Unlimited Scheme extent differs from dynamic C extent; independent native segments proposed",
      "boundary": "Section 5 says not implemented then; preserve arbitrary C local state; no historical timings transferred"
    },
    {
      "key": "ocaml-effects",
      "title": "Retrofitting Effect Handlers onto OCaml",
      "url": "https://anil.recoil.org/papers/2021-pldi-retroeff.pdf",
      "section": "3.1 and 5.3",
      "basis": "Separate system/fiber stacks and explicit callback transitions",
      "boundary": "One-shot effects do not cross C frames; neither restriction is silently applied to Gambit"
    },
    {
      "key": "c23-draft",
      "title": "WG14 N3096 C23 working draft",
      "url": "https://www.open-std.org/jtc1/sc22/wg14/www/docs/n3096.pdf",
      "section": "5.1.2.4; 7.13.2.1",
      "basis": "Release/acquire publication; longjmp requires same thread and live setjmp invocation",
      "boundary": "Working draft, not purchased final ISO text; atomics do not extend C automatic lifetime"
    }
  ],
