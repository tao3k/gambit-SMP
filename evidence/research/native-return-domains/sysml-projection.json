  "gain": [
    {
      "key": "G1",
      "avoided": "No current C-stack-copying work removed; zero-copying constraint retained",
      "added": "Pinned native carrier and explicit segment registry",
      "condition": "No arbitrary C-stack copying; thread-affine libraries remain on owner"
    },
    {
      "key": "G2",
      "avoided": "No current thread-count saving established; avoid an N-thread-per-resumption redesign",
      "added": "N fresh resumption guards/tickets plus initial entry; active segments K, receipt history Q and pinned time",
      "condition": "Sharing is by live native segment, not by continuation shot; pool reuse only after full native exit"
    },
    {
      "key": "G3",
      "avoided": "No existing conservative C-stack scanning saving established; account actual root slots",
      "added": "Registered mutable root slots; per-round S visits plus descriptor pins",
      "condition": "All foreign Scheme references are declared; raw aliases reject managed qualification"
    },
    {
      "key": "G4",
      "avoided": "Potential independent Scheme scheduling through isolated native ownership",
      "added": "Per-domain serialization; no global registry CAS required by design",
      "condition": "Pure Scheme scheduler remains free; live native return paths stay thread-bound"
    },
    {
      "key": "G5",
      "avoided": "Proposed per-ticket settlement rejects duplicate completion; no measured baseline saving",
      "added": "Stable receipt storage and replay retention",
      "condition": "Delivery retry uses same ticket; a genuine continuation resumption receives a new ticket"
    },
    {
      "key": "G6",
      "avoided": "Legacy marker-as-lifetime-proxy responsibility can retire",
      "added": "NativeEntrySpec lowering and ModuleSpec/FrameSpec leases",
      "condition": "Only after every SFUN/run/generated entry and FFI alias is covered"
    },
    {
      "key": "G7",
      "avoided": "Zig required language/runtime supports eliminated: none proven",
      "added": "Zig would still need the same root, stack and return contracts",
      "condition": "C23 is baseline; no incremental semantic gain from language substitution established"
    },
    {
      "key": "G8",
      "avoided": "Unknown outcomes never authorize eager free",
      "added": "Retained bytes and blocked retirement may be unbounded",
      "condition": "Correctness gain only; requires observable reconciliation before a liveness or memory bound claim"
    }
  ],
  "memory": [
    {
      "key": "registry",
      "publication": "Initialize stable domain then release-publish generation/state",
      "observation": "Acquire+pin before dereferencing",
      "obligation": "Lookup load alone is not lifetime protection; close admission and drain readers"
    },
    {
      "key": "return-lease",
      "publication": "Owner-serialized live-to-claimed transition; pin native owner",
      "observation": "Acquire observes segment generation and catcher validity",
      "obligation": "CAS claim alone is not physical return receipt; unknown remains owned"
    },
    {
      "key": "root-transfer",
      "publication": "Publish target slots release; GC acquire snapshot and updates",
      "observation": "Collector round acknowledgement before source slot release",
      "obligation": "Atomic pointer publication is not GC root registration; moving collector rewrites actual slot"
    },
    {
      "key": "settlement",
      "publication": "Ticket-scoped completion state acq_rel",
      "observation": "Duplicate observation uses acquire and exact activation incarnation",
      "obligation": "Captured guard cannot settle newer activation; no winding-only release"
    },
    {
      "key": "retirement",
      "publication": "Close gates acq_rel then drain pins/GC/code readers",
      "observation": "Acquire observes last release and known native exit",
      "obligation": "A zero counter alone does not imply no late entrant; atomic lock-free support not assumed"
    }
  ],
