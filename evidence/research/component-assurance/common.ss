 (fact (contractFact "INPUT-CUT" "build-planner" "build-scheduler" "build request/image identity" "Complete mediated dynamic read/effect closure and stable producer image" "Consumer uses the sealed image and admits all unknown capabilities" "Planner retains incomplete cut; scheduler cannot issue reuse"))
 (fact (contractFact "OUTPUT-GROUP" "build-publisher" "build-planner" "build request/output group and source generation" "All C/link metadata/diagnostic/effect observations reflect a successful complete producer group" "Planner validates full consumer projections, not only file length/hash at endpoints" "Publisher owns staged/partial results until accepted commit/discard"))
 (fact (contractFact "CREDIT-RETURN" "build-scheduler" "build-publisher" "one host budget with child ownership distinct from GC counts" "Cancel request does not release a running job credit; physical completion returns it once" "Publisher terminal acknowledgement distinguishes exit request from settled child effects" "Scheduler retains credit for unknown child; publisher retains staged data"))
 (fact (contractFact "ROOT-HANDOFF" "host-roots" "gc-work" "VM/processor/context/collection epoch" "Final registered slots are frozen, acquired, scanned and relocated values reloaded" "GC does not infer participation from RC record publication or callback entry" "Root custodian retains slots and old backing until accepted scan/reentry"))
 (fact (contractFact "CONTROL-ORIGIN" "continuation" "gc-work" "captured origin/frame/collection identity" "Every saved raw origin and precise frame root survives until traversal and lease drain" "Current stack scan does not imply captured closure; GC honors FrameSpec coordinates" "Control retains origin/backing on unknown traversal"))
 (fact (contractFact "CALLBACK-BORROW" "host-roots" "continuation" "entry depth and VM ownership" "Nested callbacks preserve root protection and exception/continuation cleanup ownership" "Control restores VM binding and reloads moved slots before user code" "Entry custodian retains borrowed resources until exact exit acknowledgement"))
 (fact (contractFact "RETIRE-FRONTIER" "gc-work" "resource-exit" "phase/target-specific generation" "Producer and descendant closure plus strong/weak/cleanup completion precede reclaim permission" "Resource consumer additionally closes target ingress and drains actual non-GC users" "GC owns unfinished tasks; release coordinator owns accepted destructor debt"))
 (fact (contractFact "RESOURCE-DELIVERY" "resource-exit" "build-publisher" "compiler output handle/owner/request lifetime" "Release completion is an owner-scoped acknowledgement rather than a call to free/close" "Publisher cannot deliver success while handle cleanup or unknown I/O remains" "Release owner retains unacknowledged handles; publisher retains result debt"))
