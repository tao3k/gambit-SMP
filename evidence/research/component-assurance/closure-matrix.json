  "sharedContracts": [
    {
      "contractId": "INPUT-CUT",
      "producer": {
        "componentId": "build-planner"
      },
      "consumer": {
        "componentId": "build-scheduler"
      },
      "phaseScope": "build request/image identity",
      "guarantee": "Complete mediated dynamic read/effect closure and stable producer image",
      "rely": "Consumer uses the sealed image and admits all unknown capabilities",
      "failureCustodian": "Planner retains incomplete cut; scheduler cannot issue reuse"
    },
    {
      "contractId": "OUTPUT-GROUP",
      "producer": {
        "componentId": "build-publisher"
      },
      "consumer": {
        "componentId": "build-planner"
      },
      "phaseScope": "build request/output group and source generation",
      "guarantee": "All C/link metadata/diagnostic/effect observations reflect a successful complete producer group",
      "rely": "Planner validates full consumer projections, not only file length/hash at endpoints",
      "failureCustodian": "Publisher owns staged/partial results until accepted commit/discard"
    },
    {
      "contractId": "CREDIT-RETURN",
      "producer": {
        "componentId": "build-scheduler"
      },
      "consumer": {
        "componentId": "build-publisher"
      },
      "phaseScope": "one host budget with child ownership distinct from GC counts",
      "guarantee": "Cancel request does not release a running job credit; physical completion returns it once",
      "rely": "Publisher terminal acknowledgement distinguishes exit request from settled child effects",
      "failureCustodian": "Scheduler retains credit for unknown child; publisher retains staged data"
    },
    {
      "contractId": "ROOT-HANDOFF",
      "producer": {
        "componentId": "host-roots"
      },
      "consumer": {
        "componentId": "gc-work"
      },
      "phaseScope": "VM/processor/context/collection epoch",
      "guarantee": "Final registered slots are frozen, acquired, scanned and relocated values reloaded",
      "rely": "GC does not infer participation from RC record publication or callback entry",
      "failureCustodian": "Root custodian retains slots and old backing until accepted scan/reentry"
    },
    {
      "contractId": "CONTROL-ORIGIN",
      "producer": {
        "componentId": "continuation"
      },
      "consumer": {
        "componentId": "gc-work"
      },
      "phaseScope": "captured origin/frame/collection identity",
      "guarantee": "Every saved raw origin and precise frame root survives until traversal and lease drain",
      "rely": "Current stack scan does not imply captured closure; GC honors FrameSpec coordinates",
      "failureCustodian": "Control retains origin/backing on unknown traversal"
    },
    {
      "contractId": "CALLBACK-BORROW",
      "producer": {
        "componentId": "host-roots"
      },
      "consumer": {
        "componentId": "continuation"
      },
      "phaseScope": "entry depth and VM ownership",
      "guarantee": "Nested callbacks preserve root protection and exception/continuation cleanup ownership",
      "rely": "Control restores VM binding and reloads moved slots before user code",
      "failureCustodian": "Entry custodian retains borrowed resources until exact exit acknowledgement"
    },
    {
      "contractId": "RETIRE-FRONTIER",
      "producer": {
        "componentId": "gc-work"
      },
      "consumer": {
        "componentId": "resource-exit"
      },
      "phaseScope": "phase/target-specific generation",
      "guarantee": "Producer and descendant closure plus strong/weak/cleanup completion precede reclaim permission",
      "rely": "Resource consumer additionally closes target ingress and drains actual non-GC users",
      "failureCustodian": "GC owns unfinished tasks; release coordinator owns accepted destructor debt"
    },
    {
      "contractId": "RESOURCE-DELIVERY",
      "producer": {
        "componentId": "resource-exit"
      },
      "consumer": {
        "componentId": "build-publisher"
      },
      "phaseScope": "compiler output handle/owner/request lifetime",
      "guarantee": "Release completion is an owner-scoped acknowledgement rather than a call to free/close",
      "rely": "Publisher cannot deliver success while handle cleanup or unknown I/O remains",
      "failureCustodian": "Release owner retains unacknowledged handles; publisher retains result debt"
    }
  ]
}
