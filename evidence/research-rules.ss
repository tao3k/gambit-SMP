;;; -*- Gerbil -*-
;;; Pure restricted DSL loaded by the upstream native engine.
(ascent-fragment
   (relation audit_blocker ((c0 symbol?) (c1 symbol?)))
   (relation audit_contract_gap ((c0 symbol?) (c1 symbol?)))
   (relation audit_issue ((c0 symbol?) (c1 symbol?) (c2 exact-integer?)))
   (relation audit_legacy_known ((c0 symbol?)))
   (relation audit_legacy_receipt ((c0 symbol?) (c1 symbol?) (c2 symbol?)))
   (relation audit_legacy_review ((c0 symbol?) (c1 symbol?) (c2 symbol?)))
   (relation audit_model ((c0 symbol?) (c1 symbol?)))
   (relation audit_model_gap ((c0 symbol?) (c1 symbol?)))
   (relation audit_paper ((c0 symbol?) (c1 symbol?) (c2 symbol?)))
   (relation audit_paper_path ((c0 symbol?) (c1 symbol?) (c2 symbol?) (c3 symbol?)))
   (relation audit_pr ((c0 symbol?) (c1 exact-integer?)))
   (relation audit_receipt_known ((c0 symbol?)))
   (relation audit_reusable_receipt ((c0 symbol?) (c1 symbol?) (c2 symbol?)))
   (relation audit_value_path ((c0 symbol?) (c1 exact-integer?) (c2 symbol?) (c3 symbol?)))
   (relation contract_path ((c0 symbol?) (c1 symbol?)))
   (relation has_model_receipt ((c0 symbol?)))
   (relation model_context_pr ((c0 symbol?) (c1 exact-integer?)))
   (relation protocol_ancestor ((c0 symbol?) (c1 symbol?)))
   (relation protocol_checked ((c0 symbol?) (c1 symbol?)))
   (relation protocol_composes ((c0 symbol?) (c1 symbol?)))
   (relation protocol_evidence_known ((c0 symbol?)))
   (relation protocol_gap ((c0 symbol?)))
   (relation protocol_model ((c0 symbol?) (c1 symbol?)))
   (relation protocol_source ((c0 symbol?) (c1 symbol?)))
   (relation protocol_upstream ((c0 symbol?) (c1 exact-integer?)))
   (relation protocol_value_path ((c0 symbol?) (c1 symbol?) (c2 symbol?)))
   (relation reflection_acceptance_pending ((c0 symbol?) (c1 symbol?) (c2 exact-integer?) (c3 symbol?)))
   (relation reflection_condition ((c0 symbol?) (c1 symbol?) (c2 exact-integer?) (c3 symbol?)))
   (relation reflection_reference ((c0 symbol?) (c1 symbol?) (c2 symbol?) (c3 symbol?) (c4 symbol?) (c5 symbol?)))
   (relation reflection_reference_path ((c0 symbol?) (c1 symbol?) (c2 symbol?) (c3 symbol?) (c4 symbol?) (c5 symbol?) (c6 symbol?)))
   (relation reflection_requirement ((c0 symbol?) (c1 symbol?) (c2 symbol?) (c3 symbol?)))
   (relation reflection_requirement_reference ((c0 symbol?) (c1 symbol?) (c2 symbol?)))
   (relation reflection_unclosed ((c0 symbol?) (c1 symbol?) (c2 symbol?) (c3 symbol?)))
   (relation retry_budget_expanded ((c0 symbol?)))
   (relation retry_delta ((c0 symbol?)))
   (relation retry_denied ((c0 symbol?) (c1 symbol?)))
   (relation retry_has_denial ((c0 symbol?)))
   (relation retry_hypothesis ((c0 symbol?)))
   (relation retry_review_required ((c0 symbol?)))
   (relation retry_route ((c0 symbol?)))
   (relation retry_scope_mismatch ((c0 symbol?)))
   (relation retry_aggregate_review ((c0 symbol?)))
   (relation retry_aggregate_reviewed ((c0 symbol?)))
   (relation retry_unbound ((c0 symbol?)))
   (relation source_native_pending ((c0 symbol?)))
   (relation source_obligation ((c0 symbol?) (c1 symbol?)))
   (relation source_origin_needed ((c0 symbol?) (c1 symbol?)))
   (relation source_repair_needed ((c0 symbol?) (c1 symbol?)))
   (relation source_review ((c0 symbol?) (c1 symbol?) (c2 symbol?)))

   ((audit_value_path I P M S) <-- (audit_pr I P) (audit_model I M) (source_obligation M S))
   ((audit_receipt_known M) <-- (has_model_receipt M))
   ((audit_receipt_known M) <-- (audit_reusable_receipt M P D))
   ((audit_legacy_known M) <-- (audit_legacy_receipt M P D))
   ((audit_legacy_review M P D) <-- (audit_legacy_receipt M P D) (not (audit_receipt_known M)))
   ((audit_model_gap I M) <-- (audit_model I M) (not (audit_receipt_known M)) (not (audit_legacy_known M)))
   ((audit_contract_gap I D) <-- (audit_model I M) (contract_path M D) (not (audit_receipt_known D)) (not (audit_legacy_known D)))
   ((audit_paper_path I P S M) <-- (audit_paper I P S) (audit_model I M))
   ((audit_blocker I B) <-- (audit_issue I B Priority))
   ((reflection_unclosed I R Status Gap) <-- (reflection_requirement I R Status Gap))
   ((reflection_acceptance_pending I R N Condition) <-- (reflection_unclosed I R Status Gap) (reflection_condition I R N Condition))
   ((reflection_reference_path I R Ref Kind Path Locator Scope) <-- (reflection_requirement_reference I R Ref) (reflection_reference I Ref Kind Path Locator Scope))
   ((protocol_evidence_known M) <-- (protocol_checked M D))
   ((protocol_gap M) <-- (protocol_model M D) (not (protocol_evidence_known M)))
   ((protocol_value_path M Prior Source) <-- (protocol_composes M Prior) (protocol_source M Source))
   ((protocol_ancestor M Prior) <-- (protocol_composes M Prior))
   ((protocol_ancestor M Prior) <-- (protocol_composes M Intermediate) (protocol_ancestor Intermediate Prior))
   ((protocol_upstream M P) <-- (protocol_ancestor M Prior) (model_context_pr Prior P))
   ((source_repair_needed M I) <-- (source_review M I (lit 'repair-required)))
   ((source_origin_needed M I) <-- (source_review M I (lit 'unresolved-origin)))
   ((retry_denied R (lit 'unchanged-tested-inputs)) <-- (retry_route R) (not (retry_delta R)))
   ((retry_denied R (lit 'budget-expanded)) <-- (retry_budget_expanded R))
   ((retry_denied R (lit 'failure-scope-mismatch)) <-- (retry_scope_mismatch R))
   ((retry_denied R (lit 'missing-causal-hypothesis)) <-- (retry_route R) (not (retry_hypothesis R)))
   ((retry_denied R (lit 'unreviewed-artifact-identity)) <-- (retry_unbound R))
   ((retry_has_denial R) <-- (retry_denied R Reason))
   ((retry_aggregate_reviewed R) <-- (retry_aggregate_review R))
   ((retry_review_required R) <-- (retry_route R) (retry_delta R) (not (retry_has_denial R))))
