;;; The semantic producer owns context identity; consumers never run macros.
;;; Slot references preserve aliases and cycles, including phase wrappers.
(def (semantic-context-graph root)
  (def slots (make-hash-table-eq))
  (def rows [])
  (def next 0)
  (def (identity ctx)
    (let (id (expander-context-id ctx)) (and id (symbol->string id))))
  (def (visit value)
    (if (not value) #f
      (or (hash-get slots value)
          (let (slot next)
            (set! next (+ next 1))
            ;; Reserve before descending: even a back edge has an owner.
            (hash-put! slots value slot)
            (let (row
                  (cond
                   ((module-context? value)
                    [slot "module" (identity value)
                     (visit (core-context-prelude value))
                     (map visit (module-context-import value))])
                   ((prelude-context? value)
                    [slot "prelude" (identity value)
                     (map visit (prelude-context-import value))])
                   ((module-import? value)
                    [slot "import" (visit (module-import-source value))
                     (module-import-phi value)])
                   ((module-export? value)
                    [slot "export" (visit (module-export-context value))])
                   ((import-set? value)
                    [slot "set" (visit (import-set-source value))
                     (import-set-phi value)])
                   (else (error "unsupported semantic graph node" value))))
              (set! rows (cons row rows)))
            slot))))
  (let* ((start (visit root)) (ordered (make-vector next)))
    (for-each (lambda (row) (vector-set! ordered (car row) row)) rows)
    ["semantic-context-graph" start (vector->list ordered)]))

(def (semantic-context-restore graph)
  (unless (and (list? graph) (= (length graph) 3)
               (equal? (car graph) "semantic-context-graph")
               (list? (caddr graph)))
    (error "invalid semantic graph envelope" graph))
  (let* ((rows (list->vector (caddr graph)))
         (size (vector-length rows)) (nodes (make-vector size #f)))
    (def (reference? id)
      (and (integer? id) (exact? id) (<= 0 id) (< id size)))
    (def (name value)
      (cond ((not value) #f) ((string? value) (string->symbol value))
            (else (error "invalid semantic context name" value))))
    (def (get id)
      (unless (reference? id) (error "invalid semantic graph reference" id))
      (or (vector-ref nodes id)
          (error "semantic graph node has no allocated shell" id)))
    ;; Validate every row and allocate all shells before installing any edge.
    (for-each
     (lambda (i)
       (let (row (vector-ref rows i))
         (unless (and (list? row) (pair? row) (equal? (car row) i)
                      (pair? (cdr row)) (string? (cadr row)))
           (error "invalid semantic graph slot" i row))
         (let* ((tag (cadr row))
                (arity (cond ((equal? tag "module") 5)
                             ((equal? tag "prelude") 4)
                             ((member tag '("import" "set")) 4)
                             ((equal? tag "export") 3)
                             (else (error "unknown semantic graph tag" tag)))))
           (unless (= (length row) arity) (error "invalid semantic graph arity" row))
           (vector-set! nodes i
             (cond
              ((equal? tag "module") (make-module-context (name (caddr row)) #f #f #f))
              ((equal? tag "prelude")
               (let (p (make-prelude-context #f))
                 (expander-context-id-set! p (name (caddr row))) p))
              ((equal? tag "import") (make-module-import #f #f 0 #t))
              ((equal? tag "export") (make-module-export #f #f 0 #f #f))
              (else (make-import-set #f 0 [])))))))
     (iota size))
    (for-each
     (lambda (i)
       (let* ((row (vector-ref rows i)) (tag (cadr row)) (node (get i)))
         (cond
          ((equal? tag "module")
           (let ((pre (list-ref row 3)) (imports (list-ref row 4)))
             (unless (list? imports) (error "invalid module import list" row))
             (when pre (phi-context-super-set! node (get pre)))
             (module-context-import-set! node (map get imports))))
          ((equal? tag "prelude")
           (unless (list? (cadddr row)) (error "invalid prelude import list" row))
           (prelude-context-import-set! node (map get (cadddr row))))
          ((equal? tag "export") (module-export-context-set! node (get (caddr row))))
          (else
           (unless (fixnum? (cadddr row)) (error "invalid semantic phase" row))
           (if (equal? tag "import")
             (begin (module-import-source-set! node (get (caddr row)))
                    (module-import-phi-set! node (cadddr row)))
             (begin (import-set-source-set! node (get (caddr row)))
                    (import-set-phi-set! node (cadddr row))))))))
     (iota size))
    (get (cadr graph))))
