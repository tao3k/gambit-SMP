;;; Immutable graph views for planning, without expander object construction.
(def (initialization-node-row node) (cdr node))
(def (initialization-node-tag node) (cadr (initialization-node-row node)))
(def (initialization-node? node tag) (equal? (initialization-node-tag node) tag))
(def (initialization-node-ref node slot) (vector-ref (car node) slot))
(def (initialization-node-field node tag index)
  (unless (initialization-node? node tag) (error "initialization graph type mismatch" tag))
  (list-ref (initialization-node-row node) index))
(def (initialization-node-imports node tag index)
  (let* ((table (car node)) (cache (vector-ref table (- (vector-length table) 1)))
         (slot (car (initialization-node-row node))))
    (or (hash-get cache slot)
        (let (imports (map (lambda (slot) (initialization-node-ref node slot))
                          (initialization-node-field node tag index)))
          (hash-put! cache slot imports) imports))))

(def initialization-graph-operations
  (hash
   (expander-context-id
    (lambda (node)
      (let (id (list-ref (initialization-node-row node) 2))
        (and id (string->symbol id)))))
   (module-context? (lambda (node) (initialization-node? node "module")))
   (prelude-context? (lambda (node) (initialization-node? node "prelude")))
   (module-import? (lambda (node) (initialization-node? node "import")))
   (module-export? (lambda (node) (initialization-node? node "export")))
   (import-set? (lambda (node) (initialization-node? node "set")))
   (core-context-prelude
    (lambda (node)
      (let (slot (initialization-node-field node "module" 3))
        (and slot (initialization-node-ref node slot)))))
   (module-context-import (lambda (node) (initialization-node-imports node "module" 4)))
   (prelude-context-import (lambda (node) (initialization-node-imports node "prelude" 3)))
   (module-import-source
    (lambda (node) (initialization-node-ref node (initialization-node-field node "import" 2))))
   (module-import-phi (lambda (node) (initialization-node-field node "import" 3)))
   (module-export-context
    (lambda (node) (initialization-node-ref node (initialization-node-field node "export" 2))))
   (import-set-source
    (lambda (node) (initialization-node-ref node (initialization-node-field node "set" 2))))
   (import-set-phi (lambda (node) (initialization-node-field node "set" 3)))))

(def (initialization-graph-view graph)
  (unless (and (list? graph) (= (length graph) 3)
               (equal? (car graph) "semantic-context-graph") (list? (caddr graph)))
    (error "invalid initialization graph"))
  (let* ((rows (caddr graph)) (size (length rows))
         (nodes (make-vector (+ size 1))))
    (def (reference? id) (and (fixnum? id) (<= 0 id) (< id size)))
    (def (references? ids) (and (list? ids) (andmap reference? ids)))
    (def (identity? id) (or (not id) (string? id)))
    (unless (reference? (cadr graph)) (error "invalid initialization root"))
    (for-each
     (lambda (row index)
       (unless (and (list? row) (>= (length row) 3) (equal? (car row) index)
                    (let (tag (cadr row))
                      (cond
                       ((equal? tag "module")
                        (and (= (length row) 5) (identity? (caddr row))
                             (or (not (list-ref row 3)) (reference? (list-ref row 3)))
                             (references? (list-ref row 4))))
                       ((equal? tag "prelude")
                        (and (= (length row) 4) (identity? (caddr row))
                             (references? (cadddr row))))
                       ((member tag '("import" "set"))
                        (and (= (length row) 4) (reference? (caddr row)) (fixnum? (cadddr row))))
                       ((equal? tag "export")
                        (and (= (length row) 3) (reference? (caddr row))))
                       (else #f))))
         (error "invalid initialization node" index))
       ;; One identity handle per row; no scopes, bindings or class instances.
       (vector-set! nodes index (cons nodes row)))
     rows (iota size))
    (vector-set! nodes size (make-hash-table-eq))
    (vector-ref nodes (cadr graph))))

;;; Lower only the initializer's observable dependency cone. Keep context
;;; identity, signed phases and the library's existing template arithmetic.
;;; This is a derived data artifact, not another native/module completion.
(def (initialization-graph-project graph)
  (unless (and (list? graph) (= (length graph) 3)
               (equal? (car graph) "semantic-context-graph") (list? (caddr graph)))
    (error "invalid semantic projection input"))
  (let ((source (list->vector (caddr graph)))
        (slots (make-hash-table-eq)) (rows []) (next 0))
    (def (node slot)
      (unless (and (fixnum? slot) (<= 0 slot) (< slot (vector-length source)))
        (error "invalid semantic projection reference" slot))
      (let (row (vector-ref source slot))
        (unless (and (list? row) (>= (length row) 3) (equal? (car row) slot))
          (error "invalid semantic projection row" slot))
        row))
    (def (imports slot)
      (let (row (node slot))
        (unless (and (equal? (cadr row) "module") (= (length row) 5)
                     (list? (list-ref row 4)))
          (error "template source is not a module" slot))
        (list-ref row 4)))
    (def (template slot phi)
      (let* ((row (node slot)) (iphi (fx+ phi (cadddr row))))
        (let lp ((rest (imports (caddr row))) (r []))
          (if (null? rest) r
            (let* ((in (car rest)) (edge (node in)) (tag (cadr edge)))
              (cond
               ((equal? tag "module")
                (lp (cdr rest) (if (fxzero? iphi) (cons in r) r)))
               ((equal? tag "import")
                ;; Deliberately phi, not iphi: preserve the original library
                ;; template rule, including its difference from gxc's walker.
                (let (iphi (fx+ phi (cadddr edge)))
                  (if (fxzero? iphi)
                    (let (export (node (caddr edge)))
                      (unless (equal? (cadr export) "export") (error "invalid template export"))
                      (lp (cdr rest) (cons (caddr export) r)))
                    (lp (cdr rest) r))))
               ((equal? tag "set")
                (let (xphi (fx+ iphi (cadddr edge)))
                  (lp (cdr rest) (if (fxzero? xphi) (cons (caddr edge) r) r))))
               (else (lp (cdr rest) r))))))))
    (def (targets slot)
      (let* ((row (node slot)) (tag (cadr row)))
        (cond
         ((member tag '("module" "prelude")) [slot])
         ((equal? tag "import")
          (if (fxzero? (cadddr row)) (targets (caddr row)) []))
         ((equal? tag "export") [(caddr row)])
         ((equal? tag "set")
          (cond ((fxzero? (cadddr row)) [(caddr row)])
                ((fxpositive? (cadddr row)) (reverse (template slot 0)))
                (else [])))
         (else (error "unsupported initializer dependency" slot)))))
    (def (visit slot)
      (or (hash-get slots slot)
          (let* ((row (node slot)) (tag (cadr row)) (id (caddr row)) (index next))
            (unless (and (member tag '("module" "prelude")) (or (not id) (string? id)))
              (error "initializer target is not a context" slot))
            (set! next (+ next 1))
            ;; Reserve before children: cycles retain a back edge, not an
            ;; invented initialization order or a premature completion token.
            (hash-put! slots slot index)
            (let* ((excluded? (or (not id) (string-prefix? "gerbil/core" id)))
                   (pre (and (not excluded?) (equal? tag "module") (list-ref row 3)))
                   (pre (and pre (visit pre)))
                   (children (if excluded? []
                               (if (equal? tag "module") (list-ref row 4) (cadddr row))))
                   (seen (make-hash-table-eq))
                   (edges
                    (let lp ((rest children) (r []))
                      (if (null? rest) (reverse r)
                        (let add ((xs (targets (car rest))) (r r))
                          (if (null? xs) (lp (cdr rest) r)
                            (let (child (car xs))
                              (if (hash-get seen child) (add (cdr xs) r)
                                (begin (hash-put! seen child #t)
                                       (add (cdr xs) (cons (visit child) r)))))))))))
              (set! rows (cons (if (equal? tag "module") [index tag id pre edges]
                                  [index tag id edges]) rows)))
            index)))
    (let* ((root (visit (cadr graph))) (result (make-vector next)))
      (for-each (lambda (row) (vector-set! result (car row) row)) rows)
      ["semantic-context-graph" root (vector->list result)])))

(def (initialization-views-materialize requests)
  (for-each
   (lambda (request index)
     (let* ((input (car request)) (output (cadr request))
            (raw (call-with-input-file input read)))
       (unless (and (list? raw) (= (length raw) 4)
                    (equal? (car raw) "module-initialization"))
         (error "invalid semantic producer envelope" input))
       (let* ((graph (initialization-graph-project (cadddr raw)))
              (_ (initialization-graph-view graph)))
         (call-with-output-file output
           (lambda (port)
             (write ["initialization-view" (cadr raw) (caddr raw)
                     (caddr request) (cadddr request) graph] port)
             (newline port))))
       ;; A prefix is independently observable only after its file is closed.
       (displayln "INITIALIZATION-VIEW-COMPLETE " index) (force-output)))
   requests (iota (length requests))))

(def (initialization-graph-resolve id)
  (let* ((name (symbol->string id))
         (name (if (string-prefix? ":" name) (substring name 1 (string-length name)) name))
         (root (path-directory (getenv "GERBIL_BUILD_PREFIX")))
         (source (path-expand (string-append "src/" name ".ss") root))
         (plan (gxc#compile-product-module-plan source)))
    (unless (and plan (= (length plan) 3) (list? (caddr plan))
                 (= (length (caddr plan)) 4)
                 (equal? (car (caddr plan)) "initialization-view"))
      (error "initialization graph has no issued program" id))
    (let* ((view (caddr plan)) (data (call-with-input-file (cadr view) read)))
      (unless (and (list? data) (= (length data) 6)
                   (equal? (car data) "initialization-view")
                   (equal? (cadr data) (getenv "GERBIL_COMPILE_CONTEXT"))
                   (equal? (caddr data) (car plan))
                   (equal? (list-ref data 3) (list-ref view 2))
                   (equal? (list-ref data 4) (list-ref view 3)))
        (error "initialization graph differs from issued program" id))
      (initialization-graph-view (list-ref data 5)))))
