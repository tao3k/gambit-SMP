{
  "schema": "evidence-recipe.v2",
  "id": "ci-upstream-check",
  "scope": "Exact locked three-flag source-core consumption and upstream-check observations. Independent module budget; no build resumption, native acceptance or performance admission.",
  "budgetSeconds": 375,
  "inputs": [
    "evidence/fixtures/dev-modern-c-three-flag-ci/source.lock.json",
    "patches/fixtures/dev-modern-c-three-flag-ci.patch",
    "tests/recipes/ci/runtime-input.json",
    "tests/recipes/execution/entry.json",
    "evidence/dsl/execution.ss",
    "evidence/native-failures.json",
    "evidence/dsl/suite-review-rules.ss",
    "tests/recipes/ci/dev-modern-c-upstream-tests.json",
    "tests/recipes/ci/test-scope.entry.json",
    "evidence/dsl/upstream-test-scope.ss",
    "tests/recipes/support/modern-c-ci/interpreted-intent.json",
    "evidence/review/ci/current-source-full-bootstrap/interpreted-causal-review.json",
    "evidence/review/ci/modern-c/environment-causal-evidence.json",
    "evidence/review/ci/modern-c/global-cleanup-interpreted-causal-evidence.json",
    "models/gambit/native/host_environment_probe.scm",
    "models/gambit/native/process_spawn.scm"
  ],
  "steps": [
    {
      "id": "candidate",
      "capability": "gambit.materialize",
      "dependsOn": [],
      "arguments": {
        "sourceLock": "evidence/fixtures/dev-modern-c-three-flag-ci/source.lock.json"
      },
      "budgetSeconds": 20
    },
    {
      "id": "runtime",
      "capability": "gambit.runtime-import",
      "dependsOn": [
        "candidate"
      ],
      "arguments": {
        "source": {
          "step": "candidate",
          "output": "source"
        },
        "archive": "tests/recipes/ci/runtime-input.json"
      },
      "budgetSeconds": 20
    },
    {
      "id": "environment-probe",
      "capability": "gambit.probe",
      "dependsOn": [
        "runtime"
      ],
      "arguments": {
        "runtime": {
          "step": "runtime",
          "output": "runtime"
        },
        "identity": {
          "step": "runtime",
          "output": "identity"
        },
        "program": "models/gambit/native/host_environment_probe.scm",
        "operations": [
          "udp-open",
          "process-pipe-sort",
          "user-info"
        ]
      },
      "budgetSeconds": 10
    },
    {
      "id": "review-gsi",
      "capability": "gambit.review",
      "dependsOn": [
        "runtime",
        "environment-probe"
      ],
      "arguments": {
        "runtime": {
          "step": "runtime",
          "output": "runtime"
        },
        "identity": {
          "step": "runtime",
          "output": "identity"
        },
        "intent": "tests/recipes/support/modern-c-ci/interpreted-intent.json",
        "target": "official",
        "mode": "gsi",
        "failureIds": [
          "018-thread-interrupt",
          "018-write-shared",
          "018-table-search",
          "018-suite-budget",
          "018-udp-permission",
          "019-prim-port-budget",
          "current-host-identity-environment"
        ],
        "environmentProbe": {
          "step": "environment-probe",
          "output": "observation"
        }
      },
      "budgetSeconds": 15
    },
    {
      "id": "official",
      "capability": "gambit.upstream-tests",
      "dependsOn": [
        "runtime",
        "environment-probe",
        "review-gsi"
      ],
      "arguments": {
        "runtime": {
          "step": "runtime",
          "output": "runtime"
        },
        "identity": {
          "step": "runtime",
          "output": "identity"
        },
        "failures": "evidence/native-failures.json",
        "reviewRules": "evidence/dsl/suite-review-rules.ss",
        "additionalFixtures": {
          "12-os/process_spawn.scm": {
            "source": "models/gambit/native/process_spawn.scm",
            "sha256": "eba139d1aa995cc78e53891d5bcf93fd7ce33eff08f6080f52efb78a8f5c98c7"
          }
        },
        "environmentProbe": {
          "step": "environment-probe",
          "output": "observation"
        },
        "reviews": {
          "gsi": {
            "step": "review-gsi",
            "output": "review"
          }
        },
        "targets": [
          "check"
        ],
        "scopeContract": "tests/recipes/ci/dev-modern-c-upstream-tests.json"
      },
      "budgetSeconds": 300
    },
    {
      "id": "verdict",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "candidate",
        "runtime",
        "environment-probe",
        "review-gsi",
        "official"
      ],
      "arguments": {
        "dsl": "tests/recipes/execution/entry.json",
        "queries": {
          "checked": "checked_step",
          "missing": "missing_step"
        },
        "expected": {
          "missing": []
        },
        "recordedQueries": [
          "checked"
        ]
      },
      "budgetSeconds": 10
    }
  ],
  "workspacePolicy": "in-place"
}
