{
  "schema": "evidence-recipe.v2",
  "id": "structural-api",
  "scope": "Native structure and conditional architecture view checks only; missing source is denial, not proof",
  "budgetSeconds": 120,
  "inputs": [
    "tests/fixtures/sysml-api/structure.sysml",
    "tests/fixtures/sysml-api/structure-reference.json",
    "tests/recipes/framework-contracts/service-entry.json",
    "evidence/dsl/sysml-service.ss",
    "evidence/dsl/observation-contract.ss",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "tests/recipes/framework-contracts/structural-api-observations.json",
    "tests/recipes/framework-contracts/structural-api-binding.json"
  ],
  "steps": [
    {
      "id": "model",
      "capability": "sysml.structure",
      "dependsOn": [],
      "budgetSeconds": 60,
      "arguments": {
        "models": [
          "tests/fixtures/sysml-api/structure.sysml"
        ],
        "baseline": "tests/fixtures/sysml-api/structure-reference.json"
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "model"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "tests/recipes/framework-contracts/structural-api-binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": []
        }
      }
    }
  ]
}
