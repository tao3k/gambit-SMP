{
  "schema": "evidence-recipe.v2",
  "id": "scientific-formal-services",
  "scope": "Installed provider and shared process qualification only; no exhaustive model or source-refinement acceptance",
  "budgetSeconds": 120,
  "inputs": [
    "tests/fixtures/induction_gate.qnt",
    "models/build/RegistryAtomicCommit.lean",
    "tests/recipes/framework-contracts/formal-binding.json",
    "tests/recipes/framework-contracts/formal-observations.json",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "evidence/dsl/observation-contract.ss"
  ],
  "steps": [
    {
      "id": "quint",
      "capability": "quint.observe",
      "dependsOn": [],
      "budgetSeconds": 60,
      "arguments": {
        "argv": [
          "typecheck",
          "tests/fixtures/induction_gate.qnt"
        ]
      }
    },
    {
      "id": "lean",
      "capability": "lean.check",
      "dependsOn": [],
      "budgetSeconds": 60,
      "arguments": {
        "argv": [
          "models/build/RegistryAtomicCommit.lean"
        ]
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "quint",
        "lean"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "tests/recipes/framework-contracts/formal-binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": []
        }
      }
    }
  ]
}
