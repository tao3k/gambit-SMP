{
  "schema": "evidence-recipe.v2",
  "id": "research-policy-flow",
  "scope": "Native policy, finite negative controls, source flow and index admission only; no runtime acceptance",
  "budgetSeconds": 120,
  "inputs": [
    "dev/modeling/models/sysml/research-storage.sysml",
    "dev/modeling/models/sysml/scientific-studies.sysml",
    "evidence/dsl/observation-contract.ss",
    "evidence/dsl/research-flow.ss",
    "evidence/dsl/research-publication.ss",
    "evidence/dsl/sysml-service.ss",
    "tests/fixtures/sysml-api/clue-inference-controls.json",
    "tests/fixtures/sysml-api/research-policy-baseline.json",
    "tests/fixtures/sysml-api/scientific-cohort-migration.json",
    "tests/fixtures/sysml-api/stdout-cohort-migration.json",
    "tests/fixtures/sysml-api/three-study-evolution.json",
    "tests/fixtures/sysml-api/three-study-selection.json",
    "tests/fixtures/sysml-api/workspace-context-migration.json",
    "tests/recipes/framework-contracts/audit-binding.json",
    "tests/recipes/framework-contracts/audit-observations.json",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "tests/recipes/framework-contracts/flow-entry.json",
    "tests/recipes/framework-contracts/publication-entry.json",
    "tests/recipes/framework-contracts/service-entry.json"
  ],
  "steps": [
    {
      "id": "model",
      "capability": "sysml.project",
      "dependsOn": [],
      "budgetSeconds": 60,
      "arguments": {
        "models": [
          "dev/modeling/models/sysml/research-storage.sysml",
          "dev/modeling/models/sysml/scientific-studies.sysml"
        ],
        "parts": [
          "GambitResearchStorage::policy",
          "GambitResearchStorage::category0",
          "GambitResearchStorage::category1",
          "GambitResearchStorage::category2",
          "GambitResearchStorage::category3",
          "GambitResearchStorage::category4",
          "GambitResearchStorage::category5",
          "GambitResearchStorage::artifactFlow",
          "GambitResearchStorage::audit",
          "ScientificStudies::catalog"
        ]
      }
    },
    {
      "id": "audit",
      "capability": "research.audit",
      "dependsOn": [
        "model"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "projection": {
          "step": "model",
          "output": "projection"
        }
      }
    },
    {
      "id": "inference",
      "capability": "research.audit",
      "dependsOn": [
        "model",
        "audit"
      ],
      "budgetSeconds": 60,
      "arguments": {
        "projection": {
          "step": "model",
          "output": "projection"
        },
        "controls": {
          "step": "audit",
          "output": "observation"
        }
      }
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "model",
        "audit",
        "inference"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "tests/recipes/framework-contracts/audit-binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": []
        }
      }
    }
  ]
}
