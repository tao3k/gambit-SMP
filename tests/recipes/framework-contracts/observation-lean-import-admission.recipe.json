{
  "schema": "evidence-recipe.v2",
  "id": "observation-lean-import-admission",
  "scope": "Explicit missing import-closure refusal; a denied Lean request is not successful proof or native admission",
  "budgetSeconds": 120,
  "inputs": [
    "evidence/dsl/observation-contract.ss",
    "models/gambit/lean/RepairConsumerInterfaces.lean",
    "models/gambit/lean/WorkAccounting.lean",
    "models/gambit/lean/lakefile.toml",
    "models/gambit/lean/lean-toolchain",
    "tests/recipes/framework-contracts/evidence-entry.json",
    "tests/recipes/framework-contracts/lean-import-binding.json",
    "tests/recipes/framework-contracts/lean-import-observations.json"
  ],
  "steps": [
    {
      "id": "lean",
      "capability": "lean.check",
      "budgetSeconds": 60,
      "arguments": {
        "argv": [
          "models/gambit/lean/RepairConsumerInterfaces.lean"
        ]
      },
      "dependsOn": []
    },
    {
      "id": "evidence",
      "capability": "evidence.evaluate",
      "dependsOn": [
        "lean"
      ],
      "budgetSeconds": 20,
      "arguments": {
        "dsl": "tests/recipes/framework-contracts/evidence-entry.json",
        "observationBinding": "tests/recipes/framework-contracts/lean-import-binding.json",
        "queries": {
          "MissingCase": "MissingCase",
          "UnknownCase": "UnknownCase",
          "DuplicateCase": "DuplicateCase",
          "MissingField": "MissingField",
          "WrongField": "WrongField",
          "ExtraField": "ExtraField"
        },
        "expected": {
          "MissingCase": [],
          "UnknownCase": [],
          "DuplicateCase": [],
          "MissingField": [],
          "WrongField": [],
          "ExtraField": []
        }
      }
    }
  ]
}
