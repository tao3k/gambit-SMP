;;; Explicit graph observations are data, not Scheme closures or host execution.
(define-evidence (make-graph-values)
  (sources) (outputs input)
  (relation input (value)
    (((object-graph (ref 0) ((0 vector (ref 0)))))
     ((object-graph (ref 0) ((0 vector (ref 1) (ref 1)) (1 vector 17))))
     ((object-graph (ref 0) ((0 table ((ref 1) (ref 2)))
                           (1 symbol "same" #t) (2 vector 17))))
     ((object-graph (ref 0) ((0 opaque "external-resource"))))
     ((object-graph (ref 0) ((0 symbol "scoped" #f))))
     ((object-graph (ref 0) ((0 symbol "scoped" #f))))))
  (explain (lambda (program result query scope)
    (hash ("status" "recorded-only")
          ("gap" "graph observations do not grant external-resource access")))))
