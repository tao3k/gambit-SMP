(define-evidence (make-recursive-audit)
  (sources edge bad blocked unrelated)
  (outputs path usable)
  (relation edge ((from symbol?) (to symbol?)))
  (relation bad ((value symbol?)))
  (relation blocked ((value symbol?)))
  (relation unrelated ((value symbol?)))
  (relation path ((from symbol?) (to symbol?)))
  (relation usable ((from symbol?) (to symbol?)))
  ((path X Y) <-- (edge X Y))
  ((path X Y) <-- (edge X Z) (path Z Y))
  ((usable X Y) <-- (path X Y) (not (bad Y)) (not (blocked Y))))
