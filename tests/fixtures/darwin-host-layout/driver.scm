(define (require! x tag) (if (not x) (error "host layout control" tag)))
(require! (= (hp-tail-a 50000 0) 50000) 'cross-module-tail)
(require! (= (hp-return (lambda (x) (##gc) (+ x 10)) 7) 25) 'non-tail-return)
(require! (equal? (map (lambda (x) (##gc) (list x)) '(1 2 3))
                  '((1) (2) (3))) 'map-roots)
(define hp-results '())
(define hp-phase 0)
(let ((value (hp-capture)))
  (set! hp-results (cons value hp-results))
  (cond ((= hp-phase 0) (set! hp-phase 1) (##gc) (hp-saved 200))
        ((= hp-phase 1) (set! hp-phase 2) (##gc) (hp-saved 300))))
(require! (equal? hp-results
  '((300 8 "root-live") (200 8 "root-live") (20 8 "root-live"))) 'multi-shot-roots)
(display "GVM-HOST-MODULE-GC-CONTINUATION-TAIL-PASS\n")
