    "GambitResearchStorage::category0": {
      "category": "maintained-source",
      "gitAllowed": true,
      "meaning": "Canonical maintained programs, models, DSL and deterministic Org/D2/SVG design views",
      "restriction": "Declared source roots; no generated snapshot/IR or runtime-result names"
    },
    "GambitResearchStorage::category1": {
      "category": "maintained-input",
      "gitAllowed": true,
      "meaning": "Reviewed static test/scenario/schema input consumed by maintained programs",
      "restriction": "Declared input roots; not automatically inferred from a JSON extension"
    },
    "GambitResearchStorage::category2": {
      "category": "curated-reference",
      "gitAllowed": true,
      "meaning": "Pinned primary source text or upstream source needed by research",
      "restriction": "Reviewed reference root and preserved source identity; never an entire run directory"
    },
    "GambitResearchStorage::category3": {
      "category": "curated-publication",
      "gitAllowed": true,
      "meaning": "Small reviewed conclusions or source-bound documentary receipts",
      "restriction": "Declared curated roots or exact exceptions; metadata size bound; no run streams/snapshots"
    },
    "GambitResearchStorage::category4": {
      "category": "execution-output",
      "gitAllowed": false,
      "meaning": "Command/status records, logs, compiler IR, extracted AST, samples, result projections, duplicate sources and binaries",
      "restriction": "Task run cache only; immutable local locator/hash does not make it portable Git evidence"
    },
    "GambitResearchStorage::category5": {
      "category": "state-and-workspace",
      "gitAllowed": false,
      "meaning": "Lifecycle journals, leases, worktrees and installed runtimes",
      "restriction": "State/cache/worktree owners; no outer-repository tracking"
    },
    "GambitResearchStorage::artifactFlow": {
      "requiredSourceMustShip": true,
      "missingEvidenceCanPass": false,
      "exitStatusAloneAdmits": false,
      "freshExecutionRequired": true,
      "nativeWriterClosureProved": false
    }
  },
