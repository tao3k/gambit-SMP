;;; Exercise the installed reader and coordinator, without granting completion.
(import :gerbil/expander :std/iter)
(export verify-generation-planning)

(def (verify-generation-planning make-source issued-markers copied-marker)
  (eval '(import :std/iter))
  (def forms (call-with-input-file make-source read-all))
  (def (definition name)
    (let (found [])
      (def (walk x)
        (when (pair? x)
          (if (and (eq? (car x) 'def) (pair? (cdr x))
                   (pair? (cadr x)) (eq? (caadr x) name))
            (set! found (cons x found))
            (begin (walk (car x)) (walk (cdr x))))))
      (walk forms)
      (unless (= (length found) 1) (error "ambiguous installed owner" name))
      (car found)))
  (def query (definition 'module-generation-plan))
  (def coordinator (definition 'build-coordinator))
  (def execute
    (eval
     `(lambda (source marker run-coordinator?)
        (let ((events []) (settings #f) (workch #f) (build-barrier #f)
              (completions (make-hash-table-eq)))
          (def (forbidden . args) (error "generation granted an unrelated operation" args))
          (def (record! event) (set! events (cons event events)))
          (def (compile-product-marker _) marker)
          (def (spec-file _ settings) source)
          (def (plan/mx _) #f)
          (def (wait-for-id dependency self) (record! ['wait dependency self]))
          (def (channel-put _ spec) (record! ['enqueue spec]))
          (def (barrier-post! _) (record! ['barrier]))
          (def import/mx forbidden)
          (def module-context-import forbidden)
          (def expander-context-id forbidden)
          (def consider forbidden)
          (def build? forbidden)
          (def build-dependent? forbidden)
          (def spec-outputs forbidden)
          (def settings-libdir forbidden)
          (def file-timestamp forbidden)
          (def compile-product-module-used forbidden)
          (def compile-product-interface forbidden)
          (def completion-post! forbidden)
          (def module-id forbidden)
          ,query
          ,coordinator
          (let (plan (module-generation-plan source))
            (when run-coordinator? (build-coordinator 'original-spec))
            [plan (reverse events)])))))
  (def path (string-append copied-marker ".generation"))
  (def (put datum)
    (call-with-output-file path (lambda (port) (write datum port) (newline port))))
  (def (rejected? source)
    (with-catch (lambda (_) #t)
      (lambda () (execute source copied-marker #t) #f)))
  (def cases 0)
  (for-each
   (lambda (original)
     (let* ((data (call-with-input-file original read)) (source (cadr data))
            (id (list-ref data 3)) (dependencies (list-ref data 4)))
       (when (file-exists? path) (delete-file path))
       (unless (equal? (execute source copied-marker #f) [#f []])
         (error "missing generation acquired a plan"))
       ;; Rotate the actual dependency population: exact order must survive.
       (for (seed (iota 64))
         (let* ((n (length dependencies)) (cut (if (zero? n) 0 (modulo seed n)))
                (deps (append (drop dependencies cut) (take dependencies cut)))
                (datum (list-copy data)))
           (set-car! (list-tail datum 4) deps)
           (put datum)
           (let* ((actual (execute source copied-marker #t))
                  (expected-events
                   (append (map (lambda (dep) ['wait (string->symbol dep) (string->symbol id)]) deps)
                           [['enqueue 'original-spec] ['barrier]])))
             (unless (equal? actual [[id deps] expected-events])
               (error "generation query changed order or granted completion" seed actual)))
           (set! cases (+ cases 1))))
       (for (mutation [[0 "wrong-context"] [1 "wrong-source"] [3 42]
                      [4 [42]] [8 #f] [9 "wrong-cwd"]])
         (let (datum (list-copy data))
           (set-car! (list-tail datum (car mutation)) (cadr mutation))
           (put datum)
           (unless (rejected? source) (error "invalid generation admitted" mutation))))))
   issued-markers)
  (when (file-exists? path) (delete-file path))
  (displayln "GENERATION-PLANNING-PASS sources=" (length issued-markers)
             " cases=" cases " ordered-waits enqueue-only no-import no-completion"))
