;;; Execute both ordering implementations over real expander context objects.
(import :gerbil/expander)
(export verify-library-order)
(include "../../src/gambit_smp/gerbil_semantic_graph.ss")
(include "../../src/gambit_smp/gerbil_initialization_view.ss")

(def (verify-library-order original candidate first-seed cases)
  (eval '(import :gerbil/expander))
  (def (implementation path (mutant? #f))
    (def (fault form)
      (if (pair? form)
        (if (and (memq (car form) '(hash-get hash-put!))
                 (pair? (cdr form)) (eq? (cadr form) 'completed-contexts)
                 (eq? (caddr form) 'hd))
          (cons (car form) (cons (cadr form) (cons '(expander-context-id hd) (cdddr form))))
          (cons (fault (car form)) (fault (cdr form))))
        form))
    (let* ((raw (call-with-input-file path read)) (form (if mutant? (fault raw) raw)))
      (eval `(lambda (import-module module-context-import)
               ,form order-modules))))
  (def old (implementation original))
  (def new (implementation candidate))
  (def (execute implementation seed edges (roundtrip? #f) (data? #f) (project? #f))
    (let* ((nodes (make-vector 8)) (preludes (make-vector 8 #f))
           (calls 0))
      (for-each
       (lambda (i)
         (vector-set! nodes i
           (make-module-context
            (string->symbol (if (and (zero? (modulo seed 7)) (memv i '(4 6)))
                              "case/shared" (string-append "case/" (number->string i))))
            #f #f #f)))
       (iota 8))
      (for-each
       (lambda (edge)
         (let* ((i (car edge)) (j (cadr edge)) (kind (caddr edge)) (phi (cadddr edge))
                (parent (vector-ref nodes i)) (child (vector-ref nodes j))
                (entry
                 (case kind
                   ((0) child)
                   ((1) (make-module-export child #f 0 #f #f))
                   ((2) (make-module-import (make-module-export child #f 0 #f #f) #f phi #t))
                   ((3) (make-import-set child phi []))
                   (else child))))
           (if (= kind 4)
             (let (pre (or (vector-ref preludes i)
                          (let (p (make-prelude-context #f))
                            (expander-context-id-set! p (string->symbol (string-append "pre/" (number->string i))))
                            (vector-set! preludes i p)
                            (phi-context-super-set! parent p) p)))
               (prelude-context-import-set! pre (append (prelude-context-import pre) [entry])))
             (module-context-import-set! parent (append (module-context-import parent) [entry])))))
       edges)
      (let* ((resolve
              (lambda (path)
                (let* ((name (symbol->string path))
                       (index (string->number (substring name 6 (string-length name)))))
                  (let (ctx (vector-ref nodes index))
                    (if roundtrip?
                      (let* ((data (semantic-context-graph ctx))
                             (restored (semantic-context-restore data)))
                        (unless (equal? data (semantic-context-graph restored))
                          (error "semantic graph identity/phase roundtrip changed" seed))
                        restored)
                      ctx)))))
             (get-imports
              (lambda (ctx)
                (set! calls (+ calls 1))
                (when (and (= seed 17) (= calls 5)) (##gc))
                (module-context-import ctx)))
             (result (let (names (map (lambda (i) (string-append "case/" (number->string i))) '(7 6 5 4 3 2 1 0)))
                       (if data?
                         (let (reader (hash-ref initialization-graph-operations 'module-context-import))
                           (dynamic-wind
                            (lambda ()
                              (hash-put! initialization-graph-operations 'module-context-import
                                (lambda (node)
                                  ;; Preserve the observer/forced-GC seam while
                                  ;; values come only from immutable graph rows.
                                  (get-imports (vector-ref nodes 7)) (reader node))))
                            (lambda ()
                              ((implementation resolve get-imports) names
                               (lambda (path) (let (graph (semantic-context-graph (resolve path))) (initialization-graph-view (if project? (initialization-graph-project graph) graph))))
                               initialization-graph-operations))
                            (lambda ()
                              (hash-put! initialization-graph-operations 'module-context-import reader))))
                         ((implementation resolve get-imports) names)))))
        result)))
  (def (mismatch? seed edges (comparison new))
    (let (expected (execute old seed edges))
      (or (not (equal? expected (execute comparison seed edges)))
          (and (eq? comparison new)
               (or (not (equal? expected (execute comparison seed edges #t)))
                   (not (equal? expected (execute comparison seed edges #f #t)))
                   (not (equal? expected (execute comparison seed edges #f #t #t))))))))
  (def (shrink seed edges (comparison new))
    (let loop ((best edges))
      (let try ((before []) (rest best))
        (if (null? rest) best
          (let (trial (append (reverse before) (cdr rest)))
            (if (mismatch? seed trial comparison) (loop trial)
                (try (cons (car rest) before) (cdr rest))))))))
  (let seeds ((seed first-seed) (left cases))
    (unless (zero? left)
      (let ((state seed) (edges []))
        (def (draw n)
          (set! state (modulo (+ (* state 1103515245) 12345) 2147483648))
          (modulo state n))
        (for-each
         (lambda (i)
           (for-each
            (lambda (j)
              (when (zero? (draw 2))
                (set! edges (cons [i j (draw 5) (- (draw 3) 1)] edges))))
            (iota i)))
         (iota 8))
        (set! edges (reverse edges))
        (when (mismatch? seed edges)
          (displayln "LIBRARY-ORDER-COUNTEREXAMPLE " seed " " (shrink seed edges))
          (error "library initialization order changed" seed))
        (seeds (+ seed 1) (- left 1)))))
  ;; Call5 revisits the shared child after its first completion, forcing GC
  ;; while the candidate completion table already contains that object key.
  (when (mismatch? 17 '((7 4 0 0) (7 6 0 0) (4 3 0 0) (6 3 0 0)))
    (error "GC changed the shared-context order"))
  (displayln "LIBRARY-ORDER-GC-DIAMOND-PASS")
  (displayln "SEMANTIC-GRAPH-ROUNDTRIP-PASS cases=" cases)
  (displayln "INITIALIZATION-PROJECTION-PASS cases=" cases)
  ;; A deliberately wrong ID-keyed completion must be caught and shrunk.
  (let* ((bad (implementation candidate #t))
         (edges '((7 4 0 0) (7 6 0 0) (4 3 0 0) (6 5 0 0)))
         (minimal (shrink 7 edges bad)))
    (unless (mismatch? 7 minimal bad) (error "property missed the identity mutation"))
    (let check ((before []) (rest minimal))
      (unless (null? rest)
        (when (mismatch? 7 (append (reverse before) (cdr rest)) bad)
          (error "counterexample is not deletion-minimal" minimal))
        (check (cons (car rest) before) (cdr rest))))
    (displayln "LIBRARY-ORDER-MUTANT-CAUGHT seed=7 minimal=" minimal))
  ;; Completion-only memoization must not turn an active cycle into a result.
  (for-each
   (lambda (implementation)
     (let* ((a (make-module-context 'cycle/a #f #f #f))
            (b (make-module-context 'cycle/b #f #f #f)) (calls 0))
       (module-context-import-set! a [b])
       (module-context-import-set! b [a])
       (unless
        (with-catch (lambda (e) (if (eq? e 'library-cycle-bound) #t (raise e)))
          (lambda ()
            ((implementation (lambda (_) a)
              (lambda (ctx)
                (set! calls (+ calls 1))
                (when (= calls 128) (raise 'library-cycle-bound))
                (module-context-import ctx))) '("cycle/a"))
            #f))
        (error "active cycle was silently assigned an initialization order"))))
   (append [old new] (map (lambda (project?)
    (lambda (resolve observe)
      (lambda (names)
        (let (reader (hash-ref initialization-graph-operations 'module-context-import))
          (dynamic-wind
           (lambda ()
             (hash-put! initialization-graph-operations 'module-context-import
               (lambda (node) (observe (resolve ':cycle/a)) (reader node))))
           (lambda ()
             ((new resolve observe) names
              (lambda (path) (let (graph (semantic-context-graph (resolve path))) (initialization-graph-view (if project? (initialization-graph-project graph) graph))))
              initialization-graph-operations))
           (lambda () (hash-put! initialization-graph-operations 'module-context-import reader))))))
) '(#f #t))))
  (displayln "LIBRARY-ORDER-PBT-PASS first=" first-seed " cases=" cases
             " aliases prelude phase-imports weak-imports gc cycles replay shrink"))
