(def (verify)
  (unless (equal? (list (left-value) (right-value) (shared-loads)) '(3 6 1))
    (error "dependency hygiene or shared loading changed"))
  #t)
(define-evidence (make-investigation)
  (begin (verify)
   (gerbil-ascent-program
   (list (gerbil-ascent-relation 'checked 1 '((#t)))
         (gerbil-ascent-relation 'input 1 [])
         (gerbil-ascent-relation 'output 1 []))
   (list (copying 'input 'output)) +inf.0 +inf.0 +inf.0 '(input)))
  (lambda (program result query scope)
    (hash ("status" "recorded-only") ("dependencies" (.ref program 'rules))
          ("scope" scope) ("gap" "not a per-row proof"))))
