+   ___P((___SCMOBJ thread),
+        (thread)
+___SCMOBJ thread;)
+{
+  if (!__atomic_load_n (&___delivery_obs_configured, __ATOMIC_ACQUIRE))
+    return ___delivery_c1_arm != 0;
+  return delivery_obs_is_subject (thread) &&
+    __atomic_load_n (&___delivery_obs_constructed, __ATOMIC_ACQUIRE) == 1 &&
+    (__atomic_load_n (&___delivery_obs_invalid, __ATOMIC_ACQUIRE) & 1) == 0;
 }
 
