+  if (mode == 2 && atomic_load(&dev_p0_before) && !atomic_load(&dev_barrier_passed)) {
+    fprintf(stderr, "DEV-FIRST-CLOSURE-NEGATIVE premature words=%ld free=%ld\n",
+            (long)words, (long)free_vars);
