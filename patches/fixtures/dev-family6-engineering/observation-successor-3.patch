+  s = &dev_alloc_tls;
+  /* The claimed closure keeps its binding until its four fields complete.
+   * A later closure must not replace that binding or clear it. */
+  if (s->pending || s->init_armed) return;
+  if (!dev_window(ps, s)) {
+    s->intent = DEV_INTENT_NONE;
+    return;
+  }
+  if (!s->hp_defined) {
