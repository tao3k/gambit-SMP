+{
+  ___WORD word_max = (___WORD)((~(___UWORD)0) >> 1);
+  ___WORD pair_words = (___WORD)REST_PAIR_WORDS;
+  ___WORD pairs;
+  ___WORD payload;
+
+  if (i < 0 || np < 0 || pair_words < 0)
+    return 0;
+  if (i != 0 && pair_words > word_max / i)
+    return 0;
