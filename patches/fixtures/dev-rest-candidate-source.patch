@@ -0,0 +1,41 @@
+;;; The forms under test are evaluated by the interpreter, including nested
+;;; escaped closures and multiple invocations of one captured continuation.
+(declare (standard-bindings) (block))
+(display "PROCESSORS:")
+(display (##current-vm-processor-count))
+(newline)
+
+(define (check value expected label)
+  (if (not (equal? value expected))
+      (error "interpreter RTE identity mismatch" label value expected)))
+
+(check
+ (eval
+  '(let ((read-location #f) (write-location #f))
+     (let ((x 10))
+       (set! read-location (lambda () x))
+       (set! write-location (lambda (v) (set! x v))))
+     (##gc)
+     (write-location 41)
+     (##gc)
+     (read-location)))
+ 41 'escaped-mutable-location)
+
+(check
+ (eval
+  '(let ((saved #f) (round 0) (seen '()))
+     (let ((x 10))
+       (call-with-current-continuation (lambda (k) (set! saved k) #f))
+       (set! seen (cons x seen))
+       (set! x (+ x 1))
+       (cond ((= round 0) (set! round 1) (##gc) (saved #f))
+             ((= round 1) (set! round 2) (##gc) (saved #f))
+             (else (reverse seen))))))
+ '(10 11 12) 'multishot-mutable-location)
+
+(check
+ (eval '(with-exception-catcher (lambda (x) (if (eq? x #f) 'false-value 'wrong))
+          (lambda () (raise #f))))
+ 'false-value 'false-exception)
+
+(display "INTERPRETED-RTE-IDENTITY-PASS\n")
diff --git a/tests/smp/gc/interpreter-rte-interrupt.scm b/tests/smp/gc/interpreter-rte-interrupt.scm
new file mode 100644
index 00000000..d583d329
--- /dev/null
+++ b/tests/smp/gc/interpreter-rte-interrupt.scm
@@ -0,0 +1,40 @@
+;;; Baseline for asynchronous interruption of interpreted code. The handler
+;;; accesses a lexical location created inside the target and triggers GC.
+(declare (standard-bindings) (block))
+(display "PROCESSORS:")
+(display (##current-vm-processor-count))
+(newline)
+
+(define result
+  (eval
+   '(let ((gate (make-mutex)) (callback #f) (seen #f))
+      (let ((target
+             (make-thread
+              (lambda ()
+                (let ((x 41) (done #f))
+                  (mutex-lock! gate)
+                  (set! callback
+                        (lambda ()
+                          (let ((before x))
+                            (##gc)
+                            (set! x (+ x 1))
+                            (set! seen (list before x))
+                            (set! done #t))))
+                  (mutex-unlock! gate)
+                  (let loop ()
+                    (if (not done)
+                        (begin (thread-yield!) (loop))
+                        x)))))))
+        (thread-start! target)
+        (let wait ()
+          (mutex-lock! gate)
+          (let ((handler callback))
+            (mutex-unlock! gate)
+            (if handler
+                (thread-interrupt! target handler)
+                (begin (thread-yield!) (wait)))))
+        (list (thread-join! target) seen)))))
+
+(if (not (equal? result '(42 (41 42))))
+    (error "interpreter interrupt RTE mismatch" result))
+(display "INTERPRETED-RTE-INTERRUPT-PASS\n")
diff --git a/tests/smp/gc/interpreter-rte-progress-probe.h b/tests/smp/gc/interpreter-rte-progress-probe.h
new file mode 100644
index 00000000..987c74c3
--- /dev/null
+++ b/tests/smp/gc/interpreter-rte-progress-probe.h
@@ -0,0 +1,40 @@
+/* Diagnostic-only periodic site count. Atomic increments and output perturb
+ * scheduling. No counter or workload result is acceptance evidence. */
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+static _Atomic unsigned long long dev_rte_normal_count;
+static _Atomic unsigned long long dev_rte_hook_count;
+static int dev_rte_enabled;
+
+static void dev_rte_report(void)
+{
+  fprintf(stderr,"DEV-RTE-FINAL normal=%llu hook=%llu\n",
+          atomic_load_explicit(&dev_rte_normal_count,memory_order_relaxed),
+          atomic_load_explicit(&dev_rte_hook_count,memory_order_relaxed));
+  fflush(stderr);
+}
+
+__attribute__((constructor)) static void dev_rte_start(void)
+{
+  if (getenv("GAMBIT_DEV_RTE_COUNT")) {
+    dev_rte_enabled=1;
+    if (atexit(dev_rte_report)!=0) _Exit(77);
+  }
+}
+
+static void dev_rte_normal(void)
+{
+  unsigned long long n;
+  if (!dev_rte_enabled) return;
+  n=atomic_fetch_add_explicit(&dev_rte_normal_count,1,memory_order_relaxed)+1;
+  if ((n & 0xffffffULL)==0) {
+    fprintf(stderr,"DEV-RTE-PROGRESS normal=%llu\n",n);
+    fflush(stderr);
+  }
+}
+
+#define DEV_RTE_NORMAL() dev_rte_normal()
+#define DEV_RTE_HOOK() do { if(dev_rte_enabled) \
+  atomic_fetch_add_explicit(&dev_rte_hook_count,1,memory_order_relaxed); } while(0)
