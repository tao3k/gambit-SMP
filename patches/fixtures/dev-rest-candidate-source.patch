+++ b/tests/smp/gc/interpreter-step-callback.scm
@@ -0,0 +1,27 @@
+;;; Exercise the actual interpreter call-step callback, including changed
+;;; arguments and multiple invocations.  The handler selects only public -.
+(declare (standard-bindings) (block))
+(display "PROCESSORS:")
+(display (##current-vm-processor-count))
+(newline)
+
+(define seen '())
+(define target -)
+(define handlers (make-vector 7 #f))
+(define stepper (vector handlers #f #f #f #f #f #f #f handlers))
+(vector-set!
+ stepper 1
+ (lambda (leap code rte execute proc . args)
+   (if (and (eq? proc target) (= (length args) 2))
+       (let ((a (execute code rte proc 9 4))
+             (b (execute code rte proc 20 3)))
+         (set! seen (list a b))
+         b)
+       (apply execute code rte proc args))))
+
+(define answer
+  (parameterize ((##current-stepper stepper))
+    (eval '(- 10 3))))
+(if (not (and (= answer 17) (equal? seen '(5 17))))
+    (error "step callback mismatch" answer seen))
+(display "INTERPRETER-STEP-CALLBACK-PASS\n")
diff --git a/tests/smp/gc/native-fault-adapter.c b/tests/smp/gc/native-fault-adapter.c
new file mode 100644
index 00000000..77f45a53
--- /dev/null
+++ b/tests/smp/gc/native-fault-adapter.c
@@ -0,0 +1,66 @@
+/* Darwin qualification adapter only. Never linked into the runtime/profile. */
+/* Bind this control to the configured native word ABI. No Gambit runtime
+ * function is invoked by the independent interposition calibration. */
+#include "gambit.h"
+static_assert(sizeof(___WORD) == sizeof(void *), "native control word ABI");
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <errno.h>
+#include <dlfcn.h>
+#include <malloc/malloc.h>
+#include <sched.h>
+static _Atomic int create_at, join_at, allocation_at;
+static _Atomic int creates, joins, allocations, hold_start, held_starts;
+struct held_entry { void *(*fn)(void *); void *arg; };
+void resize_test_hold_start(int hold) { atomic_store(&hold_start,hold); }
+static void *held_entry(void *p) {
+  struct held_entry *e=p;
+  atomic_fetch_add(&held_starts,1);
+  while(atomic_load(&hold_start)) sched_yield();
+  void *result=e->fn(e->arg);
+  atomic_fetch_sub(&held_starts,1);
+  free(e);
+  return result;
+}
+
+void resize_test_arm(int c, int j, int a) {
+  atomic_store(&creates,0);atomic_store(&joins,0);atomic_store(&allocations,0);
+  atomic_store(&create_at,c);atomic_store(&join_at,j);atomic_store(&allocation_at,a);
+}
+int resize_test_count(int kind) {
+  return kind==3 ? atomic_load(&held_starts) : kind==0 ? atomic_load(&creates) : kind==1 ? atomic_load(&joins) : atomic_load(&allocations);
+}
+static int create_thread(pthread_t *id,const pthread_attr_t *attr,
+                         void *(*fn)(void *),void *arg) {
+  int at=atomic_load(&create_at);
+  if(at && atomic_fetch_add(&creates,1)+1==at) {errno=0;return EAGAIN;}
+  /* dyld excludes the interposer image from its own replacement tuples. */
+  if(atomic_load(&hold_start)) {
+    struct held_entry *e=malloc_zone_malloc(malloc_default_zone(),sizeof(*e));
+    if(!e) return ENOMEM;
+    e->fn=fn;e->arg=arg;
+    int error=pthread_create(id,attr,held_entry,e);
+    if(error) free(e);
+    return error;
+  }
+  return pthread_create(id,attr,fn,arg);
+
+}
+static int join_thread(pthread_t id,void **result) {
+  int at=atomic_load(&join_at);
+  if(at && atomic_fetch_add(&joins,1)+1==at) {errno=0;return ESRCH;}
+  return pthread_join(id,result);
+}
+static void *allocate(size_t bytes) {
+  int at=atomic_load(&allocation_at);
+  if(at && bytes>=1048576 && bytes<1052672 &&
+     atomic_fetch_add(&allocations,1)+1==at) {errno=ENOMEM;return NULL;}
+  return malloc_zone_malloc(malloc_default_zone(),bytes);
+}
+#define INTERPOSE(replacement,original) \
+  __attribute__((used)) static struct {const void *r,*o;} map_##original \
+  __attribute__((section("__DATA,__interpose")))={(const void *)&replacement,(const void *)&original}
+INTERPOSE(create_thread,pthread_create);
+INTERPOSE(join_thread,pthread_join);
+INTERPOSE(allocate,malloc);
diff --git a/tests/smp/gc/native-fault-calibration.c b/tests/smp/gc/native-fault-calibration.c
new file mode 100644
index 00000000..6e2ced48
--- /dev/null
+++ b/tests/smp/gc/native-fault-calibration.c
@@ -0,0 +1,36 @@
+/* Independent qualification of the Darwin injection adapter; no Gambit code. */
+/* Bind this control to the configured native word ABI. No Gambit runtime
+ * function is invoked by the independent interposition calibration. */
+#include "gambit.h"
+static_assert(sizeof(___WORD) == sizeof(void *), "native control word ABI");
+#include <pthread.h>
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sched.h>
+#include <stdatomic.h>
+static _Atomic int invoked; static void *entry(void *p) {atomic_fetch_add(&invoked,1);return p;}
+int main(void) {
+  void (*arm)(int,int,int)=dlsym(RTLD_DEFAULT,"resize_test_arm");
+  int (*count)(int)=dlsym(RTLD_DEFAULT,"resize_test_count");
+  if (!arm || !count) return 2;
+  pthread_t first,second;arm(2,1,0);
+  int a=pthread_create(&first,0,entry,0),b=pthread_create(&second,0,entry,0);
+  int c=a==0?pthread_join(first,0):-1;
+  int creates=count(0),joins=count(1);
+  printf("create_first=%d create_second=%d join_first=%d creates=%d joins=%d\n",a,b,c,creates,joins);
+  arm(0,0,0);if(a==0&&c!=0)pthread_join(first,0);if(b==0)pthread_join(second,0);
+  if(!(a==0&&b==EAGAIN&&c==ESRCH&&creates==2&&joins==1)) return 1;
+  void (*hold)(int)=dlsym(RTLD_DEFAULT,"resize_test_hold_start");
+  if(!hold) return 3;
+  atomic_store(&invoked,0);hold(1);
+  if(pthread_create(&first,0,entry,0)) return 4;
+  while(count(3)!=1) sched_yield();
+  int before=atomic_load(&invoked);
+  hold(0);if(pthread_join(first,0)) return 5;
+  int after=atomic_load(&invoked),pending=count(3);
+  printf("held_invocations=%d released_invocations=%d held_remaining=%d\n",before,after,pending);
+  return before==0&&after==1&&pending==0?0:6;
+
+}
diff --git a/tests/smp/gc/rest-parameter-cuts.scm b/tests/smp/gc/rest-parameter-cuts.scm
new file mode 100644
index 00000000..abe7f784
--- /dev/null
+++ b/tests/smp/gc/rest-parameter-cuts.scm
@@ -0,0 +1,151 @@
+;;; DEV driver and trace oracle for actual generated handlers 7 and 9.
+;;; An observer emits one ordered event stream per activation. It must
+;;; supply independently decoded frame/slot expectations, not copy the
+;;; producer's slot count into the expected field.
+(define (rest-cut-check form mode token events)
+  (define (take tag)
+    (if (and (pair? events)
+             (pair? (car events))
+             (eq? tag (caar events))
+             (pair? (cdar events))
+             (equal? token (cadar events)))
+        (let ((payload (cddar events)))
+          (set! events (cdr events))
+          payload)
+        (error "missing, reordered or unrelated rest cut" tag)))
+  (define (check condition label)
+    (if (not condition) (error "invalid rest cut" label)))
+  (define (grant-covers? grant)
+    (and (= (length grant) 3) (>= (caddr grant) (cadr grant))))
+  (check (memq form '(ordinary keyword-rest rest-keyword)) 'handler)
+  (check (memq mode '(exact one-short)) 'mode)
+  (let ((before (take 'preflight)))
+    (check (and (= (length before) 3)
+                (> (cadr before) 0)
+                (= (caddr before) (- (cadr before) (if (eq? mode 'exact) 0 1))))
+           'initial-grant)
+    (if (eq? mode 'one-short)
+        (begin
+          (check (equal? (take 'refused) '(0 0)) 'writes-or-pops-on-refusal)
+          (let* ((installed (take 'roots-installed))
+                 (repaired (take 'gc-repaired))
+                 (reload (take 'roots-reloaded))
+                 (plan (take 'write-plan))
+                 (fresh (take 'grant)))
+            ;; installed = mapped frame, expected slots, registered slots
+            ;; repaired = new round, moved count, scanned slots
+            ;; reload = round, reloaded slots, stale reads
+            (check (and (= (length installed) 3)
+                        (eq? (car installed) 'mapped)
+                        (pair? (cadr installed))
+                        (equal? (cadr installed) (caddr installed)))
+                   'mapped-root-coverage)
+            (check (and (= (length repaired) 3)
+                        (> (car repaired) (car before))
+                        (> (cadr repaired) 0)
+                        (equal? (caddr repaired) (cadr installed)))
+                   'moving-gc-and-scan)
+            (check (equal? reload (list (car repaired) (cadr installed) 0))
+                   'post-gc-reload)
+            ;; Pair count, pair words, vector slots, vector header, padding.
+            ;; Decode these from the emitted retry writes independently of
+            ;; the grant. The retry may allocate a vector the fast path omits.
+            (check (and (= (length plan) 5)
+                        (let loop ((fields plan))
+                          (or (null? fields)
+                              (and (exact-integer? (car fields))
+                                   (>= (car fields) 0)
+                                   (loop (cdr fields)))))
+                        (or (= (car plan) 0) (> (cadr plan) 0)))
+                   'slow-write-plan)
+            (let ((words (+ (* (car plan) (cadr plan))
+                            (caddr plan) (cadddr plan) (list-ref plan 4))))
+              (check (and (grant-covers? fresh)
+                          (= (car fresh) (car repaired))
+                          (= (cadr fresh) words))
+                     'current-grant)))
+          (check (null? (take 'ready)) 'ready)
+          (check (equal? (take 'claim) '(accepted)) 'first-claim)
+          (check (equal? (take 'claim) '(duplicate)) 'replayed-claim)))
+    (check (null? (take 'tail-entry)) 'tail-entry)
+    (check (equal? (take 'body-entry) (list form)) 'scheme-result)
+    (check (null? events) 'extra-events)
+    #t))
+
+(define (rest-cut-drive form)
+  (let* ((label (vector 'rest-cut-label))
+         (selected (vector 'rest-cut-selected))
+         (duplicate (vector 'rest-cut-duplicate))
+         (keywords (list flag: selected flag: duplicate))
+         (tail (let loop ((i 3999) (out (list selected)))
+                 (if (< i 0) out (loop (- i 1) (cons i out)))))
+         (body-entries 0)
+         (observe (lambda (actual-label actual-key actual-tail)
+                    (set! body-entries (+ body-entries 1))
+                    (let ((expected-tail (if (eq? form 'rest-keyword)
+                                             (append keywords tail) tail)))
+                      (if (not (and (eq? actual-label label)
+                                    (eq? actual-key (if (eq? form 'ordinary) #f selected))))
+                          (error "rest label or keyword identity" form))
+                      (let loop ((xs expected-tail) (ys actual-tail))
+                        (cond ((null? xs)
+                               (if (not (null? ys)) (error "rest tail length" form)))
+                              ((and (pair? ys) (eqv? (car xs) (car ys)))
+                               (loop (cdr xs) (cdr ys)))
+                              (else (error "rest tail value or alias" form))))))))
+    (case form
+      ((ordinary)
+       (apply (lambda (x . xs) (observe x #f xs)) label tail))
+      ((keyword-rest)
+       (apply (lambda (x #!key flag . xs) (observe x flag xs))
+              label (append keywords tail)))
+      ((rest-keyword)
+       ;; This spelling retains keyword arguments in the rest list.
+       ;; Use keyword pairs throughout to preserve DSSSL call semantics.
+       (let ((pairs (list flag: selected flag: duplicate)))
+         (apply (lambda (x #!rest xs #!key flag)
+                  (set! body-entries (+ body-entries 1))
+                  (if (not (and (eq? x label) (eq? flag selected) (equal? xs pairs)))
+                      (error "DSSSL rest result" form)))
+                label pairs)))
+      (else (error "unknown rest cut driver form" form)))
+    (if (not (= body-entries 1)) (error "rest callee body count" body-entries))
+    (write (list 'DEV-REST-BODY-ENTRY form body-entries))
+    (newline)))
+
+(define (rest-cut-self-check)
+  ;; Synthetic traces validate only the oracle, never the handler.
+  (let* ((prefix '((preflight t 4 12000 11999)
+                   (refused t 0 0)
+                   (roots-installed t mapped (label arg result) (label arg result))
+                   (gc-repaired t 5 1 (label arg result))
+                   (roots-reloaded t 5 (label arg result) 0)
+                   (write-plan t 4000 3 1 1 0)
+                   (grant t 5 12002 12002)
+                   (ready t)
+                   (claim t accepted)
+                   (claim t duplicate)
+                   (tail-entry t)
+                   (body-entry t ordinary)))
+         (reject (lambda (trace)
+                   (with-exception-catcher
+                     (lambda (exn) #t)
+                     (lambda () (rest-cut-check 'ordinary 'one-short 't trace) #f))))
+         (with-grant (lambda (grant)
+                       (map (lambda (event)
+                              (if (eq? (car event) 'grant) grant event))
+                            prefix))))
+    (if (not (and (rest-cut-check 'ordinary 'one-short 't prefix)
+                  (rest-cut-check 'keyword-rest 'exact 'k
+                    '((preflight k 4 16 16) (tail-entry k) (body-entry k keyword-rest)))
+                  (reject (append (list (car prefix) '(refused t 1 0)) (cddr prefix)))
+                  (reject (append (list (car prefix) '(refused t 0 1)) (cddr prefix)))
+                  (reject (append (list (car prefix) (cadr prefix)
+                                    '(roots-installed t mapped (label arg result) (label result)))
+                                  (cdddr prefix)))
+                  (reject (append prefix '((tail-entry t))))
+                  (reject (append (list (car prefix) '(refused other 0 0)) (cddr prefix)))
+                  (reject (with-grant '(grant t 5 12002 12001)))
+                  (reject (with-grant '(grant t 5 12000 12002)))))
+        (error "rest trace oracle self-check failed"))
+    (println "DEV-REST-CUT-ORACLE-PASS positives=2 negatives=7")))
diff --git a/tests/smp/gc/rest-parameter-semantics.scm b/tests/smp/gc/rest-parameter-semantics.scm
new file mode 100644
index 00000000..df203801
--- /dev/null
+++ b/tests/smp/gc/rest-parameter-semantics.scm
@@ -0,0 +1,70 @@
+;;; DEV semantic oracle for ordinary and both keyword/rest calling forms.
+;;; Explicit GC here runs after argument binding. Native cut probes must
+;;; establish separately that a short grant reaches GC before binding.
+(define (ensure condition label)
+  (if (not condition) (error "stress-gsi rest semantic mismatch" label)))
+
+(define entries 0)
+(define default-flag (vector 'default))
+
+(define (observe label flag tail)
+  (set! entries (+ entries 1))
+  (##gc)
+  (vector label flag tail))
+
+(define (ordinary label . tail)
+  (observe label #f tail))
+
+(define (keyword-rest label #!key (flag default-flag) . tail)
+  (observe label flag tail))
+
+(define (rest-keyword label #!rest tail #!key (flag default-flag))
+  (observe label flag tail))
+
+(define (expect-result label flag tail invoke)
+  (let* ((before entries)
+         (result (invoke)))
+    (ensure (= entries (+ before 1)) 'single-body-entry)
+    (ensure (eq? (vector-ref result 0) label) 'label)
+    (ensure (eq? (vector-ref result 1) flag) 'keyword-value)
+    (let loop ((expected tail) (actual (vector-ref result 2)))
+      (cond ((null? expected)
+             (ensure (null? actual) 'rest-length))
+            (else
+             (ensure (pair? actual) 'rest-shape)
+             (ensure (eqv? (car expected) (car actual)) 'rest-order-or-alias)
+             (loop (cdr expected) (cdr actual)))))))
+
+(define (expect-rejection predicate invoke)
+  (let* ((before entries)
+         (caught (with-exception-catcher predicate
+                   (lambda () (invoke) #f))))
+    (ensure caught 'exception-class)
+    (ensure (= entries before) 'rejected-before-body)))
+
+(let* ((label (vector 'procedure-label))
+       (selected (vector 'selected))
+       (shadowed (vector 'shadowed))
+       (keyword-args (list flag: selected flag: shadowed))
+       (tail (let loop ((i 3999) (out (list selected)))
+               (if (< i 0) out (loop (- i 1) (cons i out))))))
+  (expect-result label #f '() (lambda () (ordinary label)))
+  (expect-result label #f (list selected)
+    (lambda () (ordinary label selected)))
+  (expect-result label #f tail
+    (lambda () (apply ordinary label tail)))
+  (expect-result label default-flag '()
+    (lambda () (keyword-rest label)))
+  (expect-result label selected (list selected)
+    (lambda () (keyword-rest label flag: selected selected)))
+  (expect-result label selected tail
+    (lambda () (apply keyword-rest label (append keyword-args tail))))
+  (expect-result label selected keyword-args
+    (lambda () (apply rest-keyword label keyword-args)))
+  (expect-rejection wrong-number-of-arguments-exception?
+    (lambda () (apply ordinary '())))
+  (expect-rejection unknown-keyword-argument-exception?
+    (lambda () (keyword-rest label unknown: selected))))
+
+(ensure (= entries 7) 'total-entries)
+(println "DEV-STRESS-GSI-REST-SEMANTICS-PASS entries=" entries)
diff --git a/tests/smp/gc/restore-barrier-probe.h b/tests/smp/gc/restore-barrier-probe.h
new file mode 100644
index 00000000..53c02687
--- /dev/null
+++ b/tests/smp/gc/restore-barrier-probe.h
@@ -0,0 +1,111 @@
+/* Diagnostic-only hooks injected into a separately built producer. The
+ * negative arm never retires, frees or reuses storage while the reader waits.
+ * These hooks are not part of the production runtime or acceptance image. */
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static atomic_int dev_selected, dev_reader_ready, dev_reader_release;
+static atomic_int dev_reader_done, dev_p0_before, dev_p0_inside, dev_p0_after;
+static atomic_int dev_observer_after, dev_probe_done;
+static pthread_t dev_observer;
+
+static int dev_probe_mode(void)
+{
+  const char *mode = getenv("GAMBIT_DEV_RESTORE_BARRIER_PROBE");
+  if (atomic_load(&dev_probe_done)) return 0;
+  if (!mode) return 0;
+  if (strcmp(mode,"positive")==0) return 1;
+  if (strcmp(mode,"negative")==0) return 2;
+  _Exit(77);
+}
+
+static void dev_wait(atomic_int *value, const char *name)
+{
+  int i;
+  for (i=0; i<5000 && !atomic_load(value); i++) usleep(1000);
+  if (!atomic_load(value)) {
+    fprintf(stderr,"DEV-BARRIER-PROBE-TIMEOUT %s\n",name);
+    fflush(stderr);
+    _Exit(78);
+  }
+}
+
+static int dev_pid(___processor_state ps)
+{
+  ___virtual_machine_state vm=___VMSTATE_FROM_PSTATE(ps);
+  return ___PROCESSOR_ID(ps,vm);
+}
+
+static void dev_before_final_read(___processor_state ps)
+{
+  int expected=0;
+  ___virtual_machine_state vm=___VMSTATE_FROM_PSTATE(ps);
+  if (!dev_probe_mode() || vm->processor_count!=2 || dev_pid(ps)!=1) return;
+  if (!atomic_compare_exchange_strong(&dev_selected,&expected,1)) return;
+  atomic_store(&dev_reader_ready,1);
+  dev_wait(&dev_reader_release,"release-reader");
+}
+#define ___GC_TEST_BEFORE_FINAL_RESTORE_READ(slot) dev_before_final_read(___ps)
+
+static void dev_after_restore(___processor_state ps)
+{
+  if (dev_probe_mode() && dev_pid(ps)==1 && atomic_load(&dev_selected))
+    atomic_store(&dev_reader_done,1);
+}
+
+static void *dev_monitor(void *unused)
+{
+  (void)unused;
+  dev_wait(&dev_p0_inside,"inside-production-wait-or-negative-bypass");
+  usleep(50000);
+  atomic_store(&dev_observer_after,atomic_load(&dev_p0_after));
+  atomic_store(&dev_reader_release,1);
+  return 0;
+}
+
+static int dev_before_restore_barrier(___processor_state ps)
+{
+  ___virtual_machine_state vm=___VMSTATE_FROM_PSTATE(ps);
+  int mode=dev_probe_mode();
+  if (!mode || vm->processor_count!=2 || dev_pid(ps)!=0 ||
+      atomic_load(&dev_p0_before)) return 0;
+  dev_wait(&dev_reader_ready,"p1-final-old-read");
+  if (pthread_create(&dev_observer,0,dev_monitor,0)!=0) _Exit(76);
+  atomic_store(&dev_p0_before,1);
+  if (mode==2) {
+    /* The mutant skips only the restore barrier and stops before cleanup. */
+    atomic_store(&dev_p0_inside,1);
+    atomic_store(&dev_p0_after,1);
+    dev_wait(&dev_reader_done,"negative-reader-done-before-cleanup");
+    return 1;
+  }
+  return 0;
+}
+
+/* Called from the real setup.c child-message receive in the diagnostic build. */
+void dev_probe_inside_barrier(___processor_state ps)
+{
+  if (dev_probe_mode()==1 && dev_pid(ps)==0 && atomic_load(&dev_p0_before))
+    atomic_store(&dev_p0_inside,1);
+}
+
+static void dev_after_restore_barrier(___processor_state ps)
+{
+  int mode=dev_probe_mode();
+  if (!mode || dev_pid(ps)!=0 || !atomic_load(&dev_p0_before)) return;
+  atomic_store(&dev_p0_after,1);
+  if (pthread_join(dev_observer,0)!=0) _Exit(75);
+  if (!atomic_load(&dev_reader_done) || atomic_load(&dev_observer_after)!=(mode==2))
+    _Exit(74);
+  fprintf(stderr,"DEV-RESTORE-BARRIER-%s p2 reader-finished=%d observed-after=%d\n",
+          mode==1?"POSITIVE":"NEGATIVE",atomic_load(&dev_reader_done),
+          atomic_load(&dev_observer_after));
+  fflush(stderr);
+  /* The mutant cannot rejoin aligned later barriers. Stop before cleanup. */
+  if (mode==2) _Exit(0);
+  atomic_store(&dev_probe_done,1);
+}
