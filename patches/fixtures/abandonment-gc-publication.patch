+(##define-macro (macro-mutex-unlock! mutex)
+  `(let ((mutex ,mutex))
+
+     (##declare (not interrupts-enabled))
+
+     (##check-heap-limit) ;; prevent GC while mutex is locked
+
+     (macro-lock-mutex! mutex)
+
+     ;; Re-read the queue inside the callee after any inverse drop.
+     (let ((head (macro-btq-leftmost mutex)))
+       (if (##eq? head mutex)
+           (##mutex-unlock-no-waiter! mutex)
+           (##mutex-unlock-out-of-line! mutex head)))))
 
