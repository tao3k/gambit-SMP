+__atomic_load_n(___CAST(___WORD*,&current),__ATOMIC_ACQUIRE)
+#else
+#define ___TICKETLOCK_READ_CURRENT(current) \
+(*___CAST(___VOLATILE ___WORD*,&current))
+#endif
+
