 static __thread ___WORD gc_diag_scan_head;
 static __thread ___SIZE_TS gc_diag_scan_words;
 static __thread int gc_diag_scan_active;
+static __thread ___WORD gc_diag_scan_input[64];
+static __thread int gc_diag_scan_visits;
+static unsigned char gc_diag_visits_lock;
+static struct {
+  ___WORD body;
+  ___virtual_machine_state vm;
+  ___F64 cycle;
+  int visits;
+} gc_diag_visits[4096];
+
+___HIDDEN int gc_scan_visit_observe
+   (___processor_state ___ps, ___WORD *body)
+{
+  ___virtual_machine_state vm = ___VMSTATE_FROM_PSTATE(___ps);
+  unsigned int index = (___CAST(___UWORD,body)>>3) & 4095;
+  int i, visits = -1;
+  while (__atomic_test_and_set(&gc_diag_visits_lock, __ATOMIC_ACQUIRE)) {}
+  for (i=0; i<8; i++, index=(index+1)&4095)
+    {
+      if (gc_diag_visits[index].body == ___CAST(___WORD,body) &&
+          gc_diag_visits[index].vm == vm && gc_diag_visits[index].cycle == nb_gcs)
+        {
+          visits = ++gc_diag_visits[index].visits;
+          break;
+        }
+      if (gc_diag_visits[index].vm == 0 ||
+          (gc_diag_visits[index].vm == vm && gc_diag_visits[index].cycle != nb_gcs))
+        {
+          gc_diag_visits[index].body = ___CAST(___WORD,body);
+          gc_diag_visits[index].vm = vm;
+          gc_diag_visits[index].cycle = nb_gcs;
+          visits = gc_diag_visits[index].visits = 1;
+          break;
+        }
+    }
+  __atomic_clear(&gc_diag_visits_lock, __ATOMIC_RELEASE);
+  return visits;
+}
 
