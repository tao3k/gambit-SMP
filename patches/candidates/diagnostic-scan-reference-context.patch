+                         &count, &port);
+  if (port != MACH_PORT_NULL)
+    mach_port_deallocate(mach_task_self(), port);
+  if (result == KERN_SUCCESS && address <= target &&
+      target-address <= size && sizeof(___WORD) <= size-(target-address) &&
+      (info.protection & VM_PROT_READ) != 0)
+    return;
+
+  fprintf(stderr,
+          "GC-SCAN-REFERENCE-DENY cell=%lx object=%lx scanBody=%lx scanHead=%lx scanWords=%lu scanActive=%d regionResult=%d regionStart=%lx regionSize=%lu\n",
