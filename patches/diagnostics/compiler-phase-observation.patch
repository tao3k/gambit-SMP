+;; Hosted one-module diagnostics. Keep stdout bounded even if the
+;; instrumented compiler never returns. No probe changes a rewrite decision.
+(define compiler-trace? (equal? (getenv "GAMBIT_COMPILER_TRACE" #f) "1"))
+(define compiler-trace-samples 0)
+(define compiler-trace-dense-left 0)
+
+(define (compiler-trace-sample? count)
+  (and (< compiler-trace-samples 128)
+       (> count 0)
+       (= (bitwise-and count (- count 1)) 0)))
+
+(define (compiler-trace-write phase kind first second site)
+  (display "GAMBIT-COMPILER-TRACE\tv1\t")
+  (display phase)
+  (display #\tab)
+  (display kind)
+  (display #\tab)
+  (display first)
+  (display #\tab)
+  (display second)
+  (display #\tab)
+  (write site)
+  (newline)
+  (force-output))
+
+(define (compiler-trace-sample phase kind first second site)
+  (if (< compiler-trace-samples 128)
+      (begin
+        (set! compiler-trace-samples (+ compiler-trace-samples 1))
+        (compiler-trace-write phase kind first second site))))
+
+(define (compiler-trace-phase phase thunk)
+  (if compiler-trace?
+      (begin
+        (compiler-trace-write phase "enter" 0 0 phase)
+        (let ((value (thunk)))
+          (compiler-trace-write phase "return" 0 0 phase)
+          value))
+      (thunk)))
+
+(define (compiler-trace-site name source)
+  (let ((location (locat-filename-and-line (source-locat source))))
+    (list name (path-strip-directory (car location)) (cdr location))))
+
+;; After the sampled 512th expansion returns, record 24 consecutive events.
+;; The next ordinary power-of-two macro sample is 1024.
++(define (compiler-trace-span items limit)
+  (let loop ((items items) (n 0))
+    (if (or (not (pair? items)) (>= n limit))
+        n
+        (loop (cdr items) (+ n 1)))))
+
++(define (compiler-trace-form-site source)
+  (if (source? source)
+      (let ((code (source-code source)))
+        (compiler-trace-site
+         (cond ((and (pair? code) (source? (car code))) (source-code (car code)))
+               ((pair? code) (car code))
+               (else 'atom))
+         source))
+      '(unsourced "?" 0)))
+
++(define (compiler-trace-dense-write phase kind first second site)
+  (if (> compiler-trace-dense-left 0)
+      (begin
+        (set! compiler-trace-dense-left (- compiler-trace-dense-left 1))
+        (compiler-trace-write phase kind first second site)
+        (if (= compiler-trace-dense-left 0)
+            (compiler-trace-write phase "dense-end" compiler-trace-macro-calls 24 site)))))
+
++(define (compiler-trace-splice-begin source exprs combine)
+  (let ((body (begin-body source))
+        (rest (cdr exprs)))
+    (if (> compiler-trace-dense-left 0)
+        (compiler-trace-dense-write
+         "parse" "begin-before"
+         (compiler-trace-span body 4096)
+         (compiler-trace-span rest 4096)
+         (compiler-trace-form-site source)))
+    (let ((queued (combine body rest)))
+      (if (> compiler-trace-dense-left 0)
+          (compiler-trace-dense-write
+           "parse" "begin-after"
+           (compiler-trace-span queued 4096)
+           compiler-trace-macro-calls
+           (if (pair? queued)
+               (compiler-trace-form-site (car queued))
+               '(empty "?" 0))))
+      queued)))
+
 (define (append-lists lst)
 
   (define (append1 lst)
