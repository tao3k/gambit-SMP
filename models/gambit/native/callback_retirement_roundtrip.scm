;;; A successful shrink must not strand the official FFI caller's C frame.
(c-declare "extern int retirement_roundtrip(int target);")
(define (require ok message) (if (not ok) (error message)))
(c-define (retirement-roundtrip target) (int) int "retirement_roundtrip" ""
  (let ((root (make-vector 32 1042)))
    (display "CALLBACK-ROUNDTRIP:ENTER\n")
    (force-output)
    (require (equal? (##current-vm-resize ##startup-processor! target) 0) "shrink failed")
    (display "CALLBACK-ROUNDTRIP:SHRUNK\n")
    (force-output)
    (##gc)
    (require (= (vector-ref root 31) 1042) "callback root corrupted after shrink")
    (display "CALLBACK-ROUNDTRIP:BODY-RETURNING\n")
    (force-output)
    42))
(define invoke (c-lambda (int) int "retirement_roundtrip"))
(define (run-control)
  (require (= (processor-id (current-processor)) 0) "owner must actually run on P0")
  (let* ((population (##current-vm-processor-count))
         (origin (- population 1))
         (worker (make-thread
                  (lambda ()
                    (require (= (processor-id (current-processor)) origin) "wrong callback origin")
                    (let ((result (invoke 1)))
                      (display "CALLBACK-ROUNDTRIP:C-RETURNED\n")
                      (force-output)
                      (require (= result 42) "C callback result corrupted")
                      result)))))
    (require (> population 1) "multiple processors required")
    (##thread-pin! worker (##processor origin))
    (thread-start! worker)
    (require (= (thread-join! worker) 42) "callback did not return to its C caller")
    (require (= (##current-vm-processor-count) 1) "shrink population mismatch")
    (##gc)))
(define owner (make-thread run-control))
(##thread-pin! owner (##processor 0))
(thread-start! owner)
(thread-join! owner)
(display "CALLBACK-ROUNDTRIP:PASS\n")
