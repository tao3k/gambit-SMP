;; Source-preserving driver, executed by the retained gsc. Every original form
;; is retained once and in order. Exception tests and definitions are barriers.
(define fixture "unit-tests/03-number/_num.scm")
(define original (vector-ref (c#read-source fixture #f #f) 1))
(define forms (cdr (##source-strip original)))
(define eligible '(test-eqv test-eq test-equal test-assert test-approximate))
(define output (getenv "GAMBIT_NUMERIC_GENERATED_C"))
(define manifest (open-output-file (string-append output ".forms.tsv")))
(define group-count 0)
(define seen '())
(define (kind form)
  (let ((code (##source-strip form)))
    (if (pair? code) (##source-strip (car code)) 'non-call)))
(define (record entry group)
  (let ((index (car entry)) (form (cdr entry)))
    (display index manifest) (display "\t" manifest)
    (write (kind form) manifest) (display "\t" manifest)
    (display group manifest) (newline manifest)
    (set! seen (cons form seen))))
(define (group-body entries)
  (set! group-count (+ group-count 1))
  (for-each (lambda (entry) (record entry group-count)) entries)
  ;; Gambit rejects uninterned global bindings. Use a fixture-specific prefix;
  ;; the host independently verifies its absence from every original input.
  (let ((name (string->symbol
               (string-append "smp-numeric-35f9489c4e709579-group-"
                              (number->string group-count))))
        (anchor (cdar entries)))
    (list (##sourcify
           `(define (,name) (declare (not inline)) ,@(map cdr entries)) anchor)
          (##sourcify `(,name) anchor))))
(define (partition remaining pending reversed-output)
  (define (flush)
    (append (reverse (group-body (reverse pending))) reversed-output))
  (cond ((null? remaining)
         (reverse (if (null? pending) reversed-output (flush))))
        ((and (memq (kind (cdar remaining)) eligible) (< (length pending) 32))
         (partition (cdr remaining) (cons (car remaining) pending) reversed-output))
        ((pair? pending) (partition remaining '() (flush)))
        (else (record (car remaining) -1)
              (partition (cdr remaining) '() (cons (cdar remaining) reversed-output)))))
(define entries
  (let loop ((rest forms) (index 0))
    (if (null? rest) '()
        (cons (cons index (car rest)) (loop (cdr rest) (+ index 1))))))
(define transformed (partition entries '() '()))
(close-output-port manifest)
(if (not (and (= (length seen) (length forms))
              (let loop ((a forms) (b (reverse seen)))
                (or (null? a) (and (eq? (car a) (car b)) (loop (cdr a) (cdr b)))))))
    (error "original numeric form identity/order changed"))
(define program (##sourcify (cons '##begin transformed) original))
(exit (if (compile-file-to-target fixture
           options: '((module-ref _test) (linker-name "_test.o1"))
           output: output expression: program) 0 1))
