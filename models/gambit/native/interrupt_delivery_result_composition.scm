(include "../#.scm")

(cond-expand
 (enable-smp
  ;; Interpreter declarations are not atomic; this fixture requires compilation.
  (define (extract-pair! first second)
    (declare (not interrupts-enabled))
    (let ((processor (##current-processor-id)))
      (##raise-high-level-interrupt processor first)
      (##raise-high-level-interrupt processor second)
      (let* ((taken-first (##get-next-high-level-interrupt))
             (first-link (##vector-ref taken-first 0))
             (taken-second (##get-next-high-level-interrupt)))
        (vector taken-first first-link taken-second))))

  (define (dispatch-current! request)
    (declare (not interrupts-enabled))
    (##raise-high-level-interrupt (##current-processor-id) request)
    (##other-interrupt!))

  (define (check-path mode exceptional?)
    (let* ((gate (make-mutex))
           (caller (current-thread))
           (calls-a 0)
           (calls-b 0)
           (payload (vector 'root (make-vector 1024 'payload)))
           (target (make-thread
                    (lambda ()
                      (mutex-lock! gate)
                      (mutex-unlock! gate)
                      (if exceptional? (raise 'target-ended) 'target-ended))))
           (result-a
            (make-mutex
             (lambda ()
               (test-eq target (current-thread))
               (set! calls-a (+ calls-a 1))
               payload)))
           (result-b
            (make-mutex
             (lambda ()
               (test-eq caller (current-thread))
               (set! calls-b (+ calls-b 1))
               payload)))
           (request-a (vector '() result-a))
           (request-b (vector '() result-b)))
      (define (end-target!)
        (mutex-unlock! gate)
        (if exceptional?
            (test-error uncaught-exception? (thread-join! target))
            (test-eq 'target-ended (thread-join! target))))
      (mutex-lock! gate)
      (thread-start! target)
      (mutex-specific-set! result-a target)
      (mutex-specific-set! result-b caller)
      (test-assert (mutex-lock! result-a #f target))
      (test-assert (mutex-lock! result-b #f caller))
      (if (eq? mode 'ended-before-extract) (end-target!))
      (let ((extracted (extract-pair! request-a request-b)))
        (test-eq request-a (vector-ref extracted 0))
        (test-equal '() (vector-ref extracted 1))
        (test-eq request-b (vector-ref extracted 2))
        (test-equal '() (vector-ref request-b 0))
        (##gc)
        (if (eq? mode 'ended-before-forward) (end-target!))
        (##thread-intr-propagate! (vector-ref extracted 0))
        (dispatch-current! (vector-ref extracted 2)))
      (##gc)
      (test-equal 1 calls-b)
      (test-eq payload (mutex-specific result-b))
      (test-assert (mutex-lock! result-b))
      (mutex-unlock! result-b)
      (if (eq? mode 'delivered)
          (begin
            (test-assert (mutex-lock! result-a))
            (test-eq payload (mutex-specific result-a))
            (mutex-unlock! result-a)
            (test-equal 1 calls-a)
            (end-target!))
          (begin
            (test-eq 'abandoned (mutex-state result-a))
            (test-error abandoned-mutex-exception? (mutex-lock! result-a))
            (test-eq caller (mutex-state result-a))
            (mutex-unlock! result-a)
            (test-equal 0 calls-a)))
      (let ((unlocked? (##primitive-trylock! target 1 9)))
        (test-assert unlocked?)
        (if unlocked? (##primitive-unlock! target 1 9)))
      (test-equal 1 calls-b)
      (test-eq 'root (vector-ref payload 0))
      (test-equal 'payload (vector-ref (vector-ref payload 1) 1023))))

  (for-each
   (lambda (mode)
     (check-path mode #f)
     (check-path mode #t))
   '(ended-before-extract ended-before-forward delivered)))
 (else (error "SMP required for combined interrupt/result fixture")))
