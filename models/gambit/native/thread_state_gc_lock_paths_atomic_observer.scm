;; Schedule coverage of state snapshots and migration during collective GC.
;; This does not force a particular target-lock ownership or prove retirement.
(load (or (getenv "GAMBIT_SMP_ATOMIC_OBSERVER")
          (error "same-runtime compiled migration observer required")))
(define population (##current-vm-processor-count))
(if (< population 2) (error "requires parallel processors"))
(define rounds (* 8 population))
(define gate (make-mutex))
(mutex-lock! gate)
(define (await-start!)
  (mutex-lock! gate)
  (mutex-unlock! gate))
(define migrate-and-observe smp-atomic-migrate-and-observe)
(define indexes
  (let loop ((i (- population 1)) (xs '()))
    (if (< i 0) xs (loop (- i 1) (cons i xs)))))
(define workers
  (map (lambda (index)
         (make-thread
          (lambda ()
            (let ((payload (make-vector 64 index)))
              (await-start!)
              (do ((round 0 (+ round 1))) ((= round rounds) index)
                (let* ((target (modulo (+ (##current-processor-id) 1) population))
                       (observed (migrate-and-observe target)))
                  (if (not (= target observed))
                      (error "migration changed target" index round target observed)))
                (if (not (= index (vector-ref payload (modulo round 64))))
                    (error "moving payload changed" index round))
                (thread-yield!))))))
       indexes))
(define readers
  (map (lambda (index)
         (make-thread
          (lambda ()
            (await-start!)
            (do ((round 0 (+ round 1))) ((= round rounds) rounds)
              ;; A terminated state is valid if this reader trails the worker.
              (thread-state (list-ref workers (modulo (+ index round) population)))
              (thread-yield!)))))
       indexes))
(define collector
  (make-thread
   (lambda ()
     (await-start!)
     (do ((round 0 (+ round 1))) ((= round (* 2 population)) round)
       (let ((payload (vector round (cons round round))))
         (##gc)
         (if (not (equal? payload (vector round (cons round round))))
             (error "collector payload changed" round)))
       (thread-yield!)))))
(for-each thread-start! workers)
(for-each thread-start! readers)
(thread-start! collector)
(mutex-unlock! gate)
(define (join-with-root-error thread)
  (with-exception-catcher
   (lambda (exc)
     (if (uncaught-exception? exc)
         (raise (uncaught-exception-reason exc))
         (raise exc)))
   (lambda () (thread-join! thread))))
(if (not (equal? indexes (map join-with-root-error workers)))
    (error "worker results changed"))
(if (not (= (* population rounds) (apply + (map join-with-root-error readers))))
    (error "state query count changed"))
(if (not (= (* 2 population) (join-with-root-error collector)))
    (error "GC count changed"))
(display (list 'processors population 'queries (* population rounds)
               'gc-rounds (* 2 population)))
(newline)
(display "NATIVE-OK:thread_state_gc_lock_paths\n")
