;; Diagnostic only: load the original definitions without its final workload.
(define original "unit-tests/06-thread/tfib_stress.scm")
(define forms
  (call-with-input-file original
    (lambda (port)
      (let loop ((forms '()))
        (let ((form (read port)))
          (if (eof-object? form) (reverse forms) (loop (cons form forms))))))))
(define invocation (car (reverse forms)))
(if (not (and (pair? invocation) (eq? (car invocation) 'go)
              (= (length invocation) 3)))
    (error "original TFIB invocation changed"))
(define prefix "tfib-delay-definitions.scm")
(call-with-output-file prefix
  (lambda (port)
    (for-each (lambda (form) (write form port) (newline port))
              (reverse (cdr (reverse forms))))))
(load prefix)
(delete-file prefix)
(define original-short-delay (eval 'short-delay (interaction-environment)))
(define samples (string->number (getenv "GAMBIT_SMP_DELAY_SAMPLES")))
(if (not (and (integer? samples) (> samples 0)))
    (error "positive diagnostic sample count required"))
(define (tfib-calls n)
  (if (< n 2) 1 (+ 1 (tfib-calls (- n 1)) (tfib-calls (- n 2)))))
(define delay-form
  (let loop ((forms forms))
    (let ((form (car forms)))
      (if (and (pair? form) (eq? (car form) 'define)
               (pair? (cadr form)) (eq? (caadr form) 'short-delay))
          (caddr form)
          (loop (cdr forms))))))
(if (not (and (pair? delay-form) (eq? (car delay-form) 'busy-sleep)
              (= (length delay-form) 2) (integer? (cadr delay-form))))
    (error "original delay definition changed"))
(define start-seconds (time->seconds (current-time)))
(let loop ((remaining samples))
  (if (> remaining 0) (begin (original-short-delay) (loop (- remaining 1)))))
(define elapsed (- (time->seconds (current-time)) start-seconds))
(if (< elapsed 0) (error "diagnostic clock moved backwards"))
(define calls (* (caddr invocation) (tfib-calls (cadr invocation))))
(call-with-output-file "observations/tfib-delay.json"
  (lambda (port)
    (display "{\"schema\":\"tfib-delay-cost.v1\",\"samples\":" port)
    (write samples port)
    (display ",\"microseconds\":" port)
    (write (inexact->exact (round (* elapsed 1000000))) port)
    (display ",\"originalCalls\":" port) (write calls port)
    (display ",\"decrementsPerCall\":" port) (write (cadr delay-form) port)
    (display ",\"originalDecrements\":" port) (write (* calls (cadr delay-form)) port)
    (display ",\"processors\":" port) (write (##current-vm-processor-count) port)
    (display ",\"originalStressPassed\":false}" port)))
(write (list 'original-invocation invocation)) (newline)
(write (list 'original-tfib-calls calls)) (newline)
(write (list 'original-delay-decrements (* calls (cadr delay-form)))) (newline)
(write (list 'delay-samples samples 'seconds elapsed)) (newline)
(write (list 'observed-processors (##current-vm-processor-count))) (newline)
(display "DELAY-COST-DIAGNOSTIC-NOT-ORIGINAL-STRESS-PASS\n")
