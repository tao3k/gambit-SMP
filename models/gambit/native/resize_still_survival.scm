;; Isolate resource survival; unpinned requester retirement is tested separately.
(define population (##current-vm-processor-count))
(if (< population 2) (error "requires parallel processors"))
(define victim (- population 1))
(##thread-pin! (current-thread) (##processor 0))
(define worker
  (make-thread
   (lambda ()
     (vector (##current-processor-id)
             (##still-copy (vector 1709 2711 3141))))))
(##thread-pin! worker (##processor victim))
(thread-start! worker)
(define result (thread-join! worker))
(if (not (= (vector-ref result 0) victim)) (error "allocation processor"))
(define object (vector-ref result 1))
(if (not (equal? object '#(1709 2711 3141))) (error "pre-shrink object"))
(display (list 'still-before-shrink 'owner victim 'caller (##current-processor-id)))
(newline)
(force-output)
(##cvmr victim)
(if (not (= (##current-vm-processor-count) victim)) (error "shrink membership"))
(display "still-shrink-returned\n")
(force-output)
(##gc)
(if (not (equal? object '#(1709 2711 3141))) (error "reachable still object lost"))
(display "NATIVE-OK:resize_still_survival\n")
