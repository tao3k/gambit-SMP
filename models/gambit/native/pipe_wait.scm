;; Check shared predicates with endpoints pinned to different processors.
(define (check open-pipe read-one write-one)
  (receive (client server) (open-pipe)
    (let ((worker (make-thread
                    (lambda ()
                      (do ((i 0 (+ i 1))) ((= i 1000) #t)
                        (let ((value (read-one server)))
                          (if (not (equal? value (modulo i 251)))
                              (error "pipe server mismatch" i value))
                          (write-one value server)
                          (force-output server)))))))
      (if (< (##current-vm-processor-count) 2) (error "requires parallel processors"))
      (##thread-pin! (current-thread) (##processor 0))
      (##thread-pin! worker (##processor 1))
      (input-port-timeout-set! client 10)
      (input-port-timeout-set! server 10)
      (thread-start! worker)
      (do ((i 0 (+ i 1))) ((= i 1000))
        (write-one (modulo i 251) client)
        (force-output client)
        (let ((value (read-one client)))
          (if (not (equal? value (modulo i 251))) (error "pipe client mismatch" i value))))
      (if (not (eq? #t (thread-join! worker 12 'timeout))) (error "pipe worker failed"))
      (close-port client)
      (close-port server)
      (##thread-pin! (current-thread) #f))))

(check open-vector-pipe read write)
(check open-string-pipe read (lambda (value port) (write value port) (newline port)))
(check open-u8vector-pipe read-u8 write-u8)
(display "NATIVE-OK:pipe_wait\n")
