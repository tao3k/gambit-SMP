;;; Driver-only observation adapter. Placeholders are bound launch metadata.
(define (smp-read-child port args)
  (if (not (member (car (reverse args)) __SMP_OBSERVED_FILES__))
      (read-line port #f)
      (let ((pid (process-pid port))
            (file (car (reverse args)))
            (sequence 0)
            (all (open-output-string))
            (sink (current-error-port)))
        (define (note tag line)
          (display tag sink)
          (display " __SMP_NONCE__ " sink)
          (display pid sink)
          (display " " sink)
          (display file sink)
          (if line
              (begin
                (display " " sink)
                (display sequence sink)
                (display " " sink)
                (display line sink))
              (newline sink))
          (force-output sink))
        (note "SMP-CHILD" #f)
        (let loop ((seen? #f))
          (let ((line (read-line port #\newline #t)))
            (if (eof-object? line)
                (if seen? (get-output-string all) line)
                (begin
                  (display line all)
                  (if (and (>= (string-length line) 8)
                           (string=? (substring line 0 8) "*** GC: "))
                      (begin
                        (set! sequence (+ sequence 1))
                        (note "SMP-GC" line)))
                  (loop #t))))))))
