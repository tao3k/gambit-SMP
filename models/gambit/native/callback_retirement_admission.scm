;;; Official FFI entry must not retire its still-live origin C frame.
(c-declare "extern int retirement_callback(int target);")
(define (require ok message) (if (not ok) (error message)))
(c-define (retirement-callback target) (int) int "retirement_callback" ""
  (let ((root (make-vector 32 1042)))
    (display "CALLBACK-RETIREMENT:ENTER\n")
    (force-output)
    (let ((result (##current-vm-resize ##startup-processor! target)))
      (display "CALLBACK-RETIREMENT:RETURN\n")
      (force-output)
      (require (and (integer? result) (not (= result 0))) "live C frame retirement was admitted")
      (##gc)
      (require (= (vector-ref root 31) 1042) "callback root corrupted after rejected shrink")
      result)))
(define invoke (c-lambda (int) int "retirement_callback"))
(define (run-control)
  (require (= (processor-id (current-processor)) 0) "owner must actually run on P0")
  (let* ((population (##current-vm-processor-count))
         (origin (- population 1))
         (worker (make-thread
                  (lambda ()
                    (require (= (processor-id (current-processor)) origin) "wrong callback origin")
                    (invoke 1)))))
    (require (> population 1) "multiple processors required")
    (##thread-pin! worker (##processor origin))
    (thread-start! worker)
    (require (not (= (thread-join! worker) 0)) "callback rejection was not returned")
    (require (= (##current-vm-processor-count) population) "rejected shrink changed population")
    (require (equal? (##current-vm-resize ##startup-processor! 1) 0) "post-callback shrink failed")
    (##gc)))
(define owner (make-thread run-control))
(##thread-pin! owner (##processor 0))
(thread-start! owner)
(thread-join! owner)
(display "CALLBACK-RETIREMENT:PASS\n")
