;;; Full upstream TFIB work, observed when each root actually finishes.
(declare (standard-bindings) (block))
(if (not (= (string->number (getenv "GAMBIT_SMP_EXPECTED_PROCESSORS"))
            (##current-vm-processor-count)))
    (error "framework processor population mismatch"))

(define completion-lock (make-mutex))
(define completed 0)
(define (observe-root answer)
  (if (not (= answer 987)) (error "tfib root result mismatch"))
  (mutex-lock! completion-lock)
  (set! completed (+ completed 1))
  (display "TFIB-ROOT-COMPLETE ")
  (display completed)
  (display "/5000 987\n")
  (force-output)
  (mutex-unlock! completion-lock)
  answer)

(define (busy-sleep n) (if (> n 0) (busy-sleep (- n 1)) #f))
(define (short-delay) (busy-sleep 6000))
(define (tfib n)
  (short-delay)
  (if (< n 2)
      1
      (let* ((x (thread-start! (make-thread (lambda () (tfib (- n 2))))))
             (y (tfib (- n 1))))
        (+ (thread-join! x) y))))

(define (range i j)
  (let loop ((j (- j 1)) (lst '()))
    (if (< j i) lst (loop (- j 1) (cons j lst)))))

(define (go n repeat)
  (let ((threads (map (lambda (i)
                        (make-thread (lambda () (observe-root (tfib n)))))
                      (range 0 repeat))))
    (for-each thread-start! threads)
    (map thread-join! threads)))

(define answers (go 15 5000))
(if (not (and (= completed 5000) (= (length answers) 5000)))
    (error "tfib root inventory mismatch"))
(display "TFIB-WORKLOAD-COMPLETE\n")
