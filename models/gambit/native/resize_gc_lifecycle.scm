;; Normal retirement only: failed OS joins require separate fault injection.
(define population (##current-vm-processor-count))
(define rounds population)
(if (< population 2) (error "requires parallel processors"))
(define (resize! count)
  (display (list 'resize-enter (##current-vm-processor-count) count
                 'caller (##current-processor-id)))
  (newline)
  (force-output)
  (##cvmr count)
  (if (not (= count (##current-vm-processor-count)))
      (error "resize membership" count (##current-vm-processor-count)))
  (display (list 'resize-return count))
  (newline)
  (force-output))
(define (payload round)
  (let ((table (make-table test: eq?))
        (keys (make-vector 64)))
    (do ((i 0 (+ i 1))) ((= i 64))
      (let ((key (vector round i)))
        (vector-set! keys i key)
        (table-set! table key (cons round i))))
    (##gc)
    (do ((i 0 (+ i 1))) ((= i 64))
      (if (not (equal? (table-ref table (vector-ref keys i)) (cons round i)))
          (error "lifecycle post-GC payload" round i)))
    round))
(resize! 1)
(do ((round 0 (+ round 1))) ((= round rounds))
  (resize! population)
  (let ((worker (make-thread (lambda () (payload round)))))
    (thread-start! worker)
    (payload round)
    (if (not (= round (thread-join! worker)))
        (error "worker completion" round)))
  (resize! 1)
  (payload round))
(resize! population)
(display "NATIVE-OK:resize_gc_lifecycle\n")
