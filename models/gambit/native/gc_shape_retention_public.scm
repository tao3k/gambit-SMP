;; Strong-object/alias and saved-frame regression, not a physical span witness.
(define (require condition message)
  (if (not condition) (error message)))
(define (positive-environment name)
  (let* ((text (getenv name #f)) (n (and text (string->number text))))
    (require (and n (integer? n) (exact? n) (> n 0)) name)
    n))
(define processors (positive-environment "GAMBIT_SMP_AVAILABLE_CPUS"))
(define width (positive-environment "GAMBIT_SMP_SHAPE_WIDTH"))
(define depth (positive-environment "GAMBIT_SMP_SHAPE_DEPTH"))
(define gate (make-mutex))
(define arrived-cv (make-condition-variable))
(define release-cv (make-condition-variable))
(define arrived 0)
(define release? #f)
(define roots (make-vector processors #f))
(define-type payload identity pair wide big captured)
(define (park!)
  (mutex-lock! gate)
  (set! arrived (+ arrived 1))
  (condition-variable-signal! arrived-cv)
  (let wait ()
    (if (not release?)
        (begin (mutex-unlock! gate release-cv) (mutex-lock! gate) (wait))))
  (mutex-unlock! gate))
(define (keep-frame n object)
  (let ((alias (payload-pair object)))
    (if (= n 0) (begin (park!) 0)
        (let ((answer (keep-frame (- n 1) object)))
          (require (eq? alias (payload-pair object)) "saved-frame alias")
          (+ answer 1)))))
(define (check object identity)
  (let ((pair (payload-pair object)) (wide (payload-wide object)))
    (require (= (payload-identity object) identity) "record identity")
    (require (eq? (cdr pair) pair) "cyclic pair identity")
    (require (= (car pair) identity) "pair value")
    (require (= (vector-length wide) width) "vector length")
    (let loop ((i 0))
      (if (< i width)
          (begin (require (eq? (vector-ref wide i) pair) "vector alias")
                 (loop (+ i 1)))))
    (require (= (payload-big object) (+ (expt 2 width) identity)) "bignum value")
    (require (eq? ((payload-captured object)) pair) "closure root")))
(require (>= processors 2) "requires parallel processors")
(##current-vm-resize ##startup-processor! processors)
(define workers
  (let build ((i 0))
    (if (= i processors) '()
        (let ((thread
               (make-thread
                (lambda ()
                  (let* ((pair (cons i #f)) (wide (make-vector width pair))
                         (object (make-payload i pair wide (+ (expt 2 width) i)
                                               (lambda () pair))))
                    (set-cdr! pair pair)
                    (vector-set! roots i object)
                    (require (= (keep-frame depth object) depth) "frame depth")
                    (check object i)
                    i)))))
          (##thread-pin! thread (##processor i))
          (cons thread (build (+ i 1)))))))
(for-each thread-start! workers)
(mutex-lock! gate)
(let wait ()
  (if (< arrived processors)
      (begin (mutex-unlock! gate arrived-cv) (mutex-lock! gate) (wait))))
(mutex-unlock! gate)
(##gc)
(let check-roots ((i 0))
  (if (< i processors)
      (begin (check (vector-ref roots i) i) (check-roots (+ i 1)))))
(##gc)
(mutex-lock! gate)
(set! release? #t)
(condition-variable-broadcast! release-cv)
(mutex-unlock! gate)
(let join ((rest workers) (i 0))
  (if (pair? rest)
      (begin (require (= (thread-join! (car rest)) i) "worker result")
             (join (cdr rest) (+ i 1)))))
(##current-vm-resize ##startup-processor! 1)
(require (= (##current-vm-processor-count) 1) "processor drain")
(display "GC-SHAPE-RETENTION-PUBLIC:PASS\n")
