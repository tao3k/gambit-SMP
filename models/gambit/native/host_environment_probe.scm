;;; Current-runtime observations only; neither operation is a permission lease.
(define (check value)
  (if (not value) (exit 1)))

(define udp (open-udp))
(check (input-port? udp))
(check (output-port? udp))
(close-port udp)
(println "ENVIRONMENT:udp-open:PASS")

(define process (open-process (list path: "sort" direction: 'input-output)))
(display "c\na\nb\n" process)
(force-output process)
(close-output-port process)
(check (equal? (read-line process) "a"))
(check (equal? (read-line process) "b"))
(check (equal? (read-line process) "c"))
(check (eof-object? (read-line process)))
(check (= (process-status process) 0))
(close-input-port process)
(println "ENVIRONMENT:process-pipe-sort:PASS")
(check (string? (user-name)))
(check (user-info? (user-info (user-name))))
(println "ENVIRONMENT:user-info:PASS")
(println "PROCESSORS:" (##current-vm-processor-count))
