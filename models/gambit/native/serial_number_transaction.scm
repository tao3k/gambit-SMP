;; Actual public API on two pinned processors, not a replay of modeled actions.
(display "NATIVE-START:serial_number_transaction\n")
(force-output)
(if (< (##current-vm-processor-count) 2) (error "requires parallel processors"))
(define size 2048)
(define keys (make-vector size))
(define numbers0 (make-vector size 0))
(define numbers1 (make-vector size 0))
(do ((i 0 (+ i 1))) ((= i size))
  (vector-set! keys i (string-append "serial-key-" (number->string i))))
(define gate (make-mutex))
(mutex-lock! gate)
(define (worker numbers)
  (make-thread
    (lambda ()
      (mutex-lock! gate)
      (mutex-unlock! gate)
      (do ((i 0 (+ i 1))) ((= i size) #t)
        (vector-set! numbers i (object->serial-number (vector-ref keys i)))
        (if (= (modulo i 16) 0) (thread-yield!))))))
(define worker0 (worker numbers0))
(define worker1 (worker numbers1))
(##thread-pin! worker0 (##processor 0))
(##thread-pin! worker1 (##processor 1))
(thread-start! worker0)
(thread-start! worker1)
(mutex-unlock! gate)
(if (not (eq? #t (thread-join! worker0 20 'timeout))) (error "worker 0 did not complete"))
(if (not (eq? #t (thread-join! worker1 20 'timeout))) (error "worker 1 did not complete"))
(do ((i 0 (+ i 1))) ((= i size))
  (let ((a (vector-ref numbers0 i)) (b (vector-ref numbers1 i)))
    (if (not (= a b)) (error "serial number changed across processors" i a b))
    (if (not (= a (object->serial-number (vector-ref keys i))))
        (error "serial number changed after return" i a))
    (if (not (eq? (vector-ref keys i) (serial-number->object a #f)))
        (error "serial number reverse mapping changed" i a))))
(display "NATIVE-OK:serial_number_transaction\n")
