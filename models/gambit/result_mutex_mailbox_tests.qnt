module result_mutex_mailbox_tests {
  import result_mutex_mailbox_handoff.* from "./result_mutex_mailbox_handoff"
  action publish = acquirePublisher.then(publishMailbox).then(releasePublisher)
  action finish = claimAtCheckpoint.then(executeThunk).then(storeResult).then(unlockReply)
    .then(consumeResult).then(dispatcherReturn)
  run runningMailboxDelivers = initRunning.then(publish).then(notifyOnly)
    .then(finish).expect(done and safe and s.claims==1 and s.executions==1)
  run idleWakeThenRestoreDelivers = initIdle.then(publish).then(notifyOnly)
    .then(observeWakeAt(0)).then(restoreTarget).then(finish)
    .expect(done and safe and s.posts==1)
  run publicationCancelsPreparedPark = initParkRace.then(publish)
    .then(notifyOnly).then(cancelParkAt(0)).then(restoreTarget).then(finish)
    .expect(done and safe)
  run migrationMakesOldNotificationHarmless = initMigration.then(publish)
    .then(migrate).then(notifyOnly).then(restoreTarget).then(finish)
    .expect(done and safe and s.flags.contains(0) and not(s.flags.contains(1))
      and s.running==1)
  run maskedIntervalDefersWithoutUnlink = initRunning.then(publish)
    .then(enterMaskedInterval).then(notifyOnly)
    .expect(safe and noLost and s.queued and not(s.active) and s.executions==0)
  run leaveMaskThenDelivery = initRunning.then(publish)
    .then(enterMaskedInterval).then(notifyOnly).then(leaveMaskedInterval)
    .then(finish).expect(done and safe)
  run blockCommitPreservesPending = initRunning.then(publish)
    .then(commitTargetBlock).then(notifyOnly).then(restoreTarget).then(finish)
    .expect(done and safe and s.blockedOnce)
  run detachedFrameIsLastConsumer = initRunning.then(publish).then(notifyOnly)
    .then(claimAtCheckpoint).expect(noLost and safe and not(s.queued)
      and s.active and s.waiting and not(s.replied))
  run noLostAloneDoesNotProveDelivery = initConsumeWakeWithoutDebtCheck
    .then(publish).then(notifyOnly).then(observeWakeAt(0))
    .expect(noLost and not(serviceable) and not(safe) and s.queued and s.waiting)
  run staleLastProcessorIsNotMigrationDestination = initWrongMigrationDestination
    .then(publish).expect(noLost and not(safe) and s.ready==0 and s.desired==1)

  run caughtCallbackReturnsOrdinaryValue = initCaughtCallback.then(publish)
    .then(notifyOnly).then(finish).expect(done and safe and not(s.errorConsumed))
  run targetAbandonBeforeDispatchIsError = initTargetAbandon.then(publish)
    .then(notifyOnly).then(abandonTarget).then(consumeResult)
    .expect(done and safe and s.executions==0 and s.errorConsumed and not(s.stored))
  run targetAbandonAfterEntryIsError = initTargetAbandonAfterEntry.then(publish)
    .then(notifyOnly).then(claimAtCheckpoint).then(executeThunk)
    .then(abandonTarget).then(consumeResult)
    .expect(done and safe and s.executions==1 and s.errorConsumed and not(s.stored))
  run storedResultLocalMovesWithGC = initRunning.then(publish).then(notifyOnly)
    .then(claimAtCheckpoint).then(executeThunk).then(storeResult)
    .then(collectBetweenStoreAndUnlock).then(unlockReply).then(consumeResult)
    .then(dispatcherReturn).expect(done and safe and s.heapEpoch==s.localEpoch)
  run unmappedLocalFailsEvenIfMutexLivesElsewhere = initUnmappedReplyLocal
    .then(publish).then(notifyOnly).then(claimAtCheckpoint).then(executeThunk)
    .then(storeResult).then(collectBetweenStoreAndUnlock)
    .expect(not(safe) and s.stored and s.localEpoch!=s.heapEpoch and not(s.replied))
  run opaqueEscapeDoesNotInventReply = initOpaqueExit.then(publish)
    .then(notifyOnly).then(claimAtCheckpoint).then(executeThunk)
    .expect(safe and opaqueRetained and not(done) and not(s.replied))
  run fakeOpaqueReplyIsRejected = initFakeReplyAfterEscape.then(publish)
    .then(notifyOnly).then(claimAtCheckpoint).then(executeThunk)
    .then(fabricateEscapeReply).expect(not(safe) and s.escaped and s.replied)
  run selectErrorCleansParkBeforeReschedule = initSelectError.then(publish)
    .then(notifyOnly).then(returnSelectError).then(restoreTarget).then(finish)
    .expect(done and safe and s.selectErrorSeen)
  run selectErrorWithoutCleanupRetainsNodeButCannotServe = initSelectErrorSkipsCleanup
    .then(publish).then(notifyOnly).then(returnSelectError)
    .expect(noLost and not(safe) and s.selectErrorSeen and not(serviceable))
  run ignoredAbortEINTRIsNotPersistentWake = initAbortWriteEINTR.then(publish)
    .expect(noLost and not(serviceable) and not(safe) and s.abortWriteFailed)
}
