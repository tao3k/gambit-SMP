module wait_fault_exit_composition_tests {
 import wait_fault_exit_composition.* from "./wait_fault_exit_composition"
 action reachControl=registerCarrier.then(commitNativeWait).then(hardWriteFailure)
 .then(returnNative).then(finishCondvarProtocol).then(finishIdleListProtocol)
 .then(releaseCallerP).then(claimFaultDomain).then(queueControlThread).then(restoreControlThread)
 action callbacksAndGc=gcRound.then(gcRound).then(runExitJobs).then(gcAfterJobs)
 action finishVm=prepareControlledExit.then(invocationBecomesNonreturnable)
 .then(finishInvocationFinalizers).then(collectiveCommit).then(writerFinishes)
 .then(deviceCloseOne).then(deviceCloseOne).then(markVmTerminated).then(releaseVmStorage)
 run devicePathUnlocksBeforeCoordinator=initDevices.then(reachControl)
 .expect(safe and not(s.pLock) and not(s.deviceLock) and s.mapped and s.p0)
 .then(callbacksAndGc).then(finishVm).expect(safe and done)
 run caughtJobErrorSurvivesFollowingGc=initJobsFail.then(reachControl)
 .then(callbacksAndGc).expect(safe and s.jobsFailed and s.errorRoot and s.errorEpoch==s.gc and s.suffixRoot)
 .then(finishVm).expect(safe and done)
 run workerFaultRestoresRealP0Carrier=initWorkerFault.then(reachControl)
 .expect(safe and s.p0 and s.registered and s.mapped)
 .then(callbacksAndGc).then(finishVm).expect(safe and done)
 run pLockCannotCrossCoordinatorClaim=initPStillLocked.then(registerCarrier)
 .then(commitNativeWait).then(hardWriteFailure).then(returnNative)
 .then(finishCondvarProtocol).then(finishIdleListProtocol).then(releaseCallerP)
 .then(claimFaultDomain).expect(not(safe) and s.pLock and s.claims==1)
 run internalReturnPreservesRealDeadline=initOverwriteDeadline.then(registerCarrier)
 .then(commitNativeWait).then(hardWriteFailure).then(returnNative)
 .expect(not(safe) and s.deviceDeadline!=s.originalDeadline)
 run opaqueUnwindRetainsVmAndRequests=initOpaqueRetain.then(reachControl)
 .then(callbacksAndGc).then(retainOpaque)
 .expect(safe and s.retained and s.vmRoot and s.requests==2 and s.markers==1 and not(s.freed))
 run failedJoinKeepsVmScope=initJoinFailureRetain.then(reachControl)
 .then(callbacksAndGc).then(prepareControlledExit).then(invocationBecomesNonreturnable)
 .then(finishInvocationFinalizers).then(collectiveCommit).then(retainJoinFailure)
 .expect(safe and s.retained and s.vmRoot and s.requests==2 and not(s.freed))
 run failedDeviceCloseKeepsGroupOwner=initNativeCloseFailureRetain.then(reachControl)
 .then(callbacksAndGc).then(prepareControlledExit).then(invocationBecomesNonreturnable)
 .then(finishInvocationFinalizers).then(collectiveCommit).then(retainJoinFailure)
 .expect(safe and s.retained and s.deviceGroupOwned and s.pendingDevices==2 and not(s.freed))
}
