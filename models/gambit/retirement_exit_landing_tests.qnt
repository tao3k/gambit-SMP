module retirement_exit_landing_tests {
  import retirement_exit_landing.* from "./retirement_exit_landing"
  action ensureRegistration = if(s.boot == 2) all { s' = s } else registerKernelHelper.then(publishVMHelper)
  action exitCallbacks = exitRequest.then(workerIfNeeded).then(claimExitP0).then(startExitJob).then(requestExitGC).then(gcRound).then(finishExitJob).then(willsIfNeeded).then(enterLanding)
  action workerIfNeeded = if(e2(s.xs) == 1) workerRunBoundary else all { s' = s }
  action willsIfNeeded = if(e1(s.xs) == 4) startExitWill.then(requestExitGC).then(gcRound).then(finishExitWill) else all { s' = s }
  action captureAtSafePoint = yieldCapture.then(closeDonorScheduling).then(saveDonorThread).then(publishThreadAnchor).then(reenterPreparation)
  action copyIfNeeded = if(s.f87) all { s' = s } else materializeCapturedFrames
  action scanPrivateIfNeeded = if(s.f89) scanPrivateChunk.then(returnPrivateScan) else all { s' = s }
  action gcArrivals = if(s.z4 == 1) arriveP0 else arriveA.then(arriveB).then(arriveP0)
  action gcTails = if(s.z4 == 1) tailP0 else z68.then(z69).then(tailP0)
  action gcRound = gcArrivals.then(markStrong).then(copyIfNeeded).then(determineWill).then(publishWeakWork).then(dequeueLastWork)
    .then(scanPrivateIfNeeded).then(returnScanner).then(finishGC).then(gcTails).then(completeGCReturn)
  action prepareFailingEpoch = captureAtSafePoint.then(startA).then(readyA).then(popAndStartB).then(requestGC1).then(gcRound)
    .then(outcomeB).then(requestGC2).then(gcRound).then(settlePreparation).then(decide)
    .then(ackA).then(ackP0).then(ackB).then(commonCompletion).then(rootBridge).then(makeBridgeMarker).then(yieldCompletion).then(requestHelperGC).then(gcRound).then(restoreThreadOnAbort).then(returnBridge).then(closeBridge)
    .then(leaveB).then(leaveA).then(leaveP0).then(consumeResult).then(releaseResult).then(installCallerRoot).then(checkCallerRelocation)
  run combinedAbortAcrossTwoEpochs = initAbortTwice.then(ensureRegistration).then(openEpoch).then(prepareFailingEpoch)
    .expect(s.z2 == 1 and s.z22 == 4 and s.f43 == 3 and s.z4 == 3 and safe)
    .then(serviceYAfterAbort).then(nextEpoch).then(ensureRegistration).then(openEpoch)
    .expect(s.z2 == 2 and s.ack0 == 1 and s.f23 == 13 and s.z8 == 0)
    .then(prepareFailingEpoch).then(serviceYAfterAbort)
    .expect(terminal and safe and s.z22 == 8 and s.z10 == 2 and s.z11 == 2 and s.z12 == 2)
  run abortThenSuccessfulHandoff = initAbortThenCommit.then(ensureRegistration).then(openEpoch).then(prepareFailingEpoch)
    .then(serviceYAfterAbort).then(nextEpoch).then(ensureRegistration).then(openEpoch)
    .then(captureAtSafePoint).then(startA).then(readyA).then(popAndStartB).then(requestGC1).then(gcRound)
    .then(outcomeB).then(requestGC2).then(gcRound).then(cancelYOnSuccess)
    .then(settlePreparation).then(spliceStillRC).then(handoffFrameValues).then(handoffWillLists).then(prepareHandoff).then(decide)
    .then(ackB).then(ackA).then(ackP0).then(commonCompletion).then(rootBridge).then(makeBridgeMarker).then(yieldCompletion).then(requestHelperGC).then(gcRound).then(publishRunnableOnReceiver).then(returnBridge).then(closeBridge)
    .then(leaveA).then(leaveP0).then(leaveB).then(consumeResult).then(releaseResult).then(installCallerRoot).then(checkCallerRelocation)
    .expect(terminal and safe and s.z4 == 1 and s.z22 == 8 and s.f38)
  run registeredCCallerKeepsCurrentValue = initRegisteredCCaller.then(ensureRegistration).then(openEpoch).then(prepareFailingEpoch)
    .expect(s.f79 == 1 and s.f75 and s.f76 == s.z22 and safe)
  run markerAllocationFailureKeepsOuterCall = initMarkerFailureRetry.then(ensureRegistration).then(openEpoch).then(captureAtSafePoint)
    .then(startA).then(readyA).then(popAndStartB).then(requestGC1).then(gcRound)
    .then(outcomeB).then(requestGC2).then(gcRound).then(settlePreparation).then(decide)
    .then(ackA).then(ackB).then(ackP0).then(commonCompletion).then(rootBridge).then(makeBridgeMarker)
    .expect(s.bg == 6 and s.gv and not(s.z60) and safe)
    .then(cleanupBridgeError).then(rootBridge).then(makeBridgeMarker).then(yieldCompletion)
    .then(requestHelperGC).then(gcRound).then(restoreThreadOnAbort).then(returnBridge).then(closeBridge)
    .expect(s.bg == 5 and s.z108 == 1 and s.rr == 1 and safe)
  run caughtSchemeErrorKeepsOuterCall = initCaughtSchemeRetry.then(ensureRegistration).then(openEpoch).then(captureAtSafePoint)
    .then(startA).then(readyA).then(popAndStartB).then(requestGC1).then(gcRound)
    .then(outcomeB).then(requestGC2).then(gcRound).then(settlePreparation).then(decide)
    .then(ackA).then(ackB).then(ackP0).then(commonCompletion).then(rootBridge).then(makeBridgeMarker).then(yieldCompletion)
    .then(helperThrows).expect(s.bg == 6 and s.mk and not(s.z60) and safe)
    .then(matchCaughtReturn).then(cleanupBridgeError).then(rootBridge).then(makeBridgeMarker).then(yieldCompletion)
    .then(requestHelperGC).then(gcRound).then(restoreThreadOnAbort).then(returnBridge).then(closeBridge)
    .expect(s.bg == 5 and s.z108 == 1 and s.rr == 1 and safe)
  run rawShutdownRetainsWithoutSchemeEntry = initRawShutdownRetained.then(registerKernelHelper).then(publishVMHelper)
    .then(stopOSNotifications).then(retainUnsafeShutdown)
    .expect(terminal and safe and s.z2 == 0 and s.bg == 7 and not(s.dead))
  run rawHelperUnwindRetainsMarkerAndRoots = initRawHelperRetained.then(ensureRegistration).then(openEpoch).then(captureAtSafePoint)
    .then(startA).then(readyA).then(popAndStartB).then(requestGC1).then(gcRound)
    .then(outcomeB).then(requestGC2).then(gcRound).then(settlePreparation).then(decide)
    .then(ackA).then(ackB).then(ackP0).then(commonCompletion).then(rootBridge).then(makeBridgeMarker).then(yieldCompletion)
    .then(rawHelperUnwind).expect(terminal and safe and s.q and s.mk and s.z101 and not(s.dead))
  run preparedShutdownKeepsSyncAfterOSStop = initShutdownPrepared.then(ensureRegistration).then(stopOSNotifications).then(openEpoch)
    .then(prepareFailingEpoch).expect(s.z118 and s.z117 and safe and s.bg == 5)
  run workerClosesRunBeforeP0Cleanup = initWorkerExit.then(ensureRegistration).then(exitCallbacks)
    .expect(e13(s.xs) == 4 and e3(s.xs) == 1 and e4(s.xs) == 1 and e1(s.xs) == 7 and safe)
  run jobFailureStillEntersLanding = initJobFailure.then(ensureRegistration).then(exitCallbacks)
    .expect(e3(s.xs) == 1 and e4(s.xs) == 0 and e5(s.xs) and e1(s.xs) == 7 and safe)
  run recursiveExitDoesNotRestartCleanup = initRepeatedExit.then(ensureRegistration).then(exitCallbacks)
    .expect(e10(s.xs) and e16(s.xs) == 42 and e15(s.xs) == 1 and e3(s.xs) == 1 and e4(s.xs) == 0 and safe)
  run unallocatedMarkerIsNotKilled = initRunAllocationFailure.then(finalizeUnallocatedRun)
    .expect(terminal and safe and e14(s.xs) == 0 and e12(s.xs) == 4)
}
